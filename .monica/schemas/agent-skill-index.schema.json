{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tairitsua/Monica/blob/dev/.monica/schemas/agent-skill-index.schema.json",
  "title": "Monica Agent Skill Release Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "channels", "versions", "releases"],
  "properties": {
    "$schema": { "type": "string", "const": "./schemas/agent-skill-index.schema.json" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable", "preview"],
      "properties": {
        "stable": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/releaseId" }] },
        "preview": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/releaseId" }] }
      }
    },
    "versions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/version" },
      "additionalProperties": { "$ref": "#/$defs/releaseId" }
    },
    "releases": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/releaseId" },
      "additionalProperties": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monicaVersion",
        "tag",
        "commit",
        "catalogDigest",
        "skillTreeDigest",
        "skillDigestAlgorithm",
        "skillDigests",
        "manifestDigest",
        "publishedAt",
        "assetBaseUrl",
        "catalogUrl",
        "manifestUrl"
      ],
      "properties": {
        "monicaVersion": { "$ref": "#/$defs/version" },
        "tag": { "$ref": "#/$defs/releaseId" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "catalogDigest": { "$ref": "#/$defs/digest" },
        "skillTreeDigest": { "$ref": "#/$defs/digest" },
        "skillDigestAlgorithm": { "type": "string", "const": "sha256-file-manifest-v1" },
        "skillDigests": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "additionalProperties": { "$ref": "#/$defs/digest" }
        },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "assetBaseUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/Tairitsua/Monica/releases/download/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "catalogUrl": { "type": "string", "format": "uri" },
        "manifestUrl": { "type": "string", "format": "uri" }
      }
    }
  }
}
