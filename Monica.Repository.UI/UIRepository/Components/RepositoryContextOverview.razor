@inject IStringLocalizer<RepositoryUIResource> L
@using System.Globalization

@if (Snapshot is null)
{
    <MudAlert Severity="Severity.Info">@L["Overview:Empty"]</MudAlert>
}
else if (ShowOptionsOnly)
{
    <OptionsTable Options="Snapshot.Options" />
}
else
{
    <div class="overview-grid">
        <div class="metric-card">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Overview:Metrics:Connection"]</MudText>
            <MudText Typo="Typo.h6">@(Snapshot.CanConnect ? L["Overview:Values:Connected"] : L["Overview:Values:Disconnected"])</MudText>
        </div>
        <div class="metric-card">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Overview:Metrics:Pool"]</MudText>
            <MudText Typo="Typo.h6">@PoolUsageText</MudText>
        </div>
        <div class="metric-card">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Overview:Metrics:Pending"]</MudText>
            <MudText Typo="Typo.h6">@(Snapshot.PendingMigrationCount?.ToString() ?? L["Overview:Values:Unknown"])</MudText>
        </div>
        <div class="metric-card">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Overview:Metrics:ProviderType"]</MudText>
            <MudText Typo="Typo.h6">@Snapshot.Registration.ProviderType</MudText>
        </div>
        <div class="metric-card">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Overview:Metrics:MigrationAssembly"]</MudText>
            <MudText Typo="Typo.h6">@DisplayValue(Snapshot.MigrationAssembly)</MudText>
        </div>
    </div>

    <div class="overview-sections">
        <div class="overview-section">
            <div class="section-header">
                <MudText Typo="Typo.subtitle1">@L["Overview:Connection:Title"]</MudText>
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           StartIcon="@(RevealConnectionStrings ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                           OnClick="OnToggleReveal">
                    @(RevealConnectionStrings ? L["Overview:Connection:Hide"] : L["Overview:Connection:Reveal"])
                </MudButton>
            </div>
            <div class="property-grid">
                <div>@L["Overview:Connection:DataSource"]</div>
                <div>@DisplayValue(Snapshot.Connection?.DataSource)</div>
                <div>@L["Overview:Connection:Database"]</div>
                <div>@DisplayValue(Snapshot.Connection?.Database)</div>
                <div>@L["Overview:Connection:ConnectionString"]</div>
                <code>@ConnectionStringText</code>
            </div>
        </div>

        <div class="overview-section">
            <MudText Typo="Typo.subtitle1">@L["Overview:Pool:Title"]</MudText>
            <div class="property-grid">
                <div>@L["Overview:Pool:Pooling"]</div>
                <div>@PoolingText</div>
                <div>@L["Overview:Pool:MaxPoolSize"]</div>
                <div>@MaxPoolSizeText</div>
                <div>@L["Overview:Pool:MinPoolSize"]</div>
                <div>@MinPoolSizeText</div>
            </div>

            @if (SessionSummary is not null)
            {
                <MudProgressLinear Value="@PoolUtilizationPercent"
                                   Color="@PoolUtilizationColor"
                                   Rounded="true" />
                <div class="property-grid">
                    <div>@L["Overview:Pool:DatabaseSessions"]</div>
                    <div>@SessionSummary.DatabaseSessions</div>
                    <div>@L["Overview:Pool:ActiveSessions"]</div>
                    <div>@SessionSummary.ActiveSessions</div>
                    <div>@L["Overview:Pool:IdleSessions"]</div>
                    <div>@SessionSummary.IdleSessions</div>
                    <div>@L["Overview:Pool:IdleInTransactionSessions"]</div>
                    <div>@SessionSummary.IdleInTransactionSessions</div>
                    <div>@L["Overview:Pool:WaitingSessions"]</div>
                    <div>@SessionSummary.WaitingSessions</div>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Overview:Pool:SessionsNote"]</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Overview:Pool:SessionsUnavailable"]</MudText>
            }
        </div>

        <div class="overview-section">
            <MudText Typo="Typo.subtitle1">@L["Overview:Provider:Title"]</MudText>
            <div class="property-grid">
                <div>@L["Overview:Provider:ProviderName"]</div>
                <div>@DisplayValue(Snapshot.ProviderName)</div>
                <div>@L["Overview:Provider:ContextType"]</div>
                <div>@Snapshot.Registration.FullName</div>
                <div>@L["Overview:Provider:Assembly"]</div>
                <div>@Snapshot.Registration.AssemblyName</div>
            </div>
        </div>
    </div>

    @if (Snapshot.HasError)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Snapshot.ErrorMessage</MudAlert>
    }
}

@code {
    [Parameter] public RepositoryDbContextSnapshot? Snapshot { get; set; }

    [Parameter] public RepositoryMigrationStatus? MigrationStatus { get; set; }

    [Parameter] public RepositoryActivityResult? Activity { get; set; }

    [Parameter] public bool RevealConnectionStrings { get; set; }

    [Parameter] public bool ShowOptionsOnly { get; set; }

    [Parameter] public EventCallback OnToggleReveal { get; set; }

    private RepositoryConnectionPoolInfo? Pool => Snapshot?.Connection?.Pool;

    private RepositoryActivitySummary? SessionSummary => Activity?.Summary;

    private string PoolUsageText
    {
        get
        {
            if (Pool is null)
            {
                return DisplayValue(null);
            }

            if (!Pool.PoolingEnabled)
            {
                return L["Overview:Pool:Disabled"];
            }

            return SessionSummary is null
                ? DisplayValue(null)
                : string.Create(CultureInfo.InvariantCulture, $"{SessionSummary.DatabaseSessions} / {Pool.EffectiveMaxPoolSize}");
        }
    }

    private string PoolingText => Pool is null
        ? DisplayValue(null)
        : Pool.PoolingEnabled ? L["Overview:Pool:Enabled"] : L["Overview:Pool:Disabled"];

    private string MaxPoolSizeText => Pool is not { PoolingEnabled: true }
        ? DisplayValue(null)
        : FormatPoolSize(Pool.MaxPoolSize, RepositoryConnectionPoolInfo.DefaultMaxPoolSize);

    private string MinPoolSizeText => Pool is not { PoolingEnabled: true }
        ? DisplayValue(null)
        : FormatPoolSize(Pool.MinPoolSize, RepositoryConnectionPoolInfo.DefaultMinPoolSize);

    private double PoolUtilizationPercent
    {
        get
        {
            var ratio = PoolUtilizationRatio;
            return double.IsNaN(ratio) ? 0 : Math.Clamp(ratio * 100, 0, 100);
        }
    }

    private Color PoolUtilizationColor
    {
        get
        {
            var ratio = PoolUtilizationRatio;
            if (double.IsNaN(ratio))
            {
                return Color.Default;
            }

            return ratio >= 1 ? Color.Error : ratio >= 0.8 ? Color.Warning : Color.Default;
        }
    }

    /// <summary>
    /// Database sessions divided by the effective maximum pool size.
    /// <see cref="double.NaN"/> when the ratio is not computable.
    /// </summary>
    private double PoolUtilizationRatio
    {
        get
        {
            if (SessionSummary is null || Pool is not { PoolingEnabled: true } || Pool.EffectiveMaxPoolSize <= 0)
            {
                return double.NaN;
            }

            return (double)SessionSummary.DatabaseSessions / Pool.EffectiveMaxPoolSize;
        }
    }

    private string FormatPoolSize(int? explicitSize, int defaultSize)
    {
        return explicitSize is { } size
            ? size.ToString(CultureInfo.InvariantCulture)
            : $"{defaultSize.ToString(CultureInfo.InvariantCulture)} {L["Overview:Pool:DefaultSuffix"]}";
    }

    private string ConnectionStringText =>
        RevealConnectionStrings
            ? DisplayValue(Snapshot?.Connection?.RevealedConnectionString ?? Snapshot?.Connection?.MaskedConnectionString)
            : DisplayValue(Snapshot?.Connection?.MaskedConnectionString);

    private string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? L["Common:Values:Unavailable"] : value;
    }
}
