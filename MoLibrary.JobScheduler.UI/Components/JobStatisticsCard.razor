@inject JobSchedulerUIService UIService
@inject NavigationManager NavigationManager

<MudCard Elevation="2">
    <MudCardHeader>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">统计信息</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           OnClick="RefreshAsync"
                           Size="Size.Small"
                           Color="Color.Primary" />
        </MudStack>
    </MudCardHeader>
    <MudCardContent>
        @if (_statistics != null)
        {
            <MudStack Spacing="2">
                <!-- 执行次数 -->
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">总执行次数</MudText>
                    <MudLink OnClick="NavigateToAllInstances" Typo="Typo.body2">
                        @_statistics.TotalExecutions
                    </MudLink>
                </MudStack>

                <!-- 失败次数 -->
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">失败次数</MudText>
                    <MudLink OnClick="NavigateToFailedInstances" Typo="Typo.body2" Color="Color.Error">
                        @_statistics.FailedExecutions
                    </MudLink>
                </MudStack>

                <MudDivider />

                <!-- 平均执行时间 -->
                @if (_statistics.AverageExecutionTime.HasValue)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">平均执行时间</MudText>
                        <MudText Typo="Typo.body2">@FormatTimeSpan(_statistics.AverageExecutionTime.Value)</MudText>
                    </MudStack>
                }

                <!-- 最快执行时间 -->
                @if (_statistics.FastestExecutionTime.HasValue && _statistics.FastestInstanceId != null)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">最快执行时间</MudText>
                        <MudLink OnClick="() => NavigateToInstance(_statistics.FastestInstanceId)" Typo="Typo.body2" Color="Color.Success">
                            @FormatTimeSpan(_statistics.FastestExecutionTime.Value)
                        </MudLink>
                    </MudStack>
                }

                <!-- 最慢执行时间 -->
                @if (_statistics.SlowestExecutionTime.HasValue && _statistics.SlowestInstanceId != null)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">最慢执行时间</MudText>
                        <MudLink OnClick="() => @NavigateToInstance(_statistics.SlowestInstanceId)" Typo="Typo.body2" Color="Color.Warning">
                            @FormatTimeSpan(_statistics.SlowestExecutionTime.Value)
                        </MudLink>
                    </MudStack>
                }

                @if (_statistics.LastExecutionTime.HasValue)
                {
                    <MudDivider />

                    <!-- 最后执行时间 -->
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">最后执行时间</MudText>
                        <MudText Typo="Typo.body2">@_statistics.LastExecutionTime.Value.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                    </MudStack>

                    <!-- 最后执行状态 -->
                    @if (_statistics.LastExecutionState.HasValue)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">最后执行状态</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@GetStateColor(_statistics.LastExecutionState.Value)">
                                @_statistics.LastExecutionState.Value
                            </MudChip>
                        </MudStack>
                    }
                }
            </MudStack>
        }
        else if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.caption">正在加载统计信息...</MudText>
            </MudStack>
        }
        else if (_error != null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string JobKey { get; set; } = null!;

    private JobStatistics? _statistics;
    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (string.IsNullOrEmpty(JobKey))
            return;

        _isLoading = true;
        _error = null;

        try
        {
            var result = await UIService.GetStatisticsAsync(JobKey);
            if (result.Code == ResponseCode.Ok && result.Data != null)
            {
                _statistics = result.Data;
            }
            else
            {
                _error = $"加载失败: {result.Message}";
            }
        }
        catch (Exception ex)
        {
            _error = $"加载失败: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }

        StateHasChanged();
    }

    private string FormatTimeSpan(TimeSpan timeSpan)
    {
        if (timeSpan.TotalHours >= 1)
            return $"{timeSpan.TotalHours:F2}h";
        if (timeSpan.TotalMinutes >= 1)
            return $"{timeSpan.TotalMinutes:F2}m";
        if (timeSpan.TotalSeconds >= 1)
            return $"{timeSpan.TotalSeconds:F2}s";
        return $"{timeSpan.TotalMilliseconds:F0}ms";
    }

    private Color GetStateColor(JobState state)
    {
        return state switch
        {
            JobState.Succeeded => Color.Success,
            JobState.Failed => Color.Error,
            JobState.Terminated => Color.Error,
            JobState.Cancelled => Color.Warning,
            JobState.Processing => Color.Primary,
            _ => Color.Default
        };
    }

    private void NavigateToAllInstances()
    {
        if (string.IsNullOrEmpty(JobKey))
            return;
        NavigationManager.NavigateTo($"/job-scheduler/instances?jobKey={Uri.EscapeDataString(JobKey)}");
    }

    private void NavigateToFailedInstances()
    {
        if (string.IsNullOrEmpty(JobKey))
            return;
        NavigationManager.NavigateTo($"/job-scheduler/instances?jobKey={Uri.EscapeDataString(JobKey)}&state=Failed,Terminated");
    }

    private void NavigateToInstance(string instanceId)
    {
        NavigationManager.NavigateTo($"/job-scheduler/instances/{Uri.EscapeDataString(instanceId)}");
    }
}
