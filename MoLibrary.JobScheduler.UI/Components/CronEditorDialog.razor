@using MoLibrary.JobScheduler.Models
@using MoLibrary.JobScheduler.UI.Services
@inject JobSchedulerUIService UIService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudProgressCircular Indeterminate="true" />
                <MudText>保存中...</MudText>
            </MudStack>
        }
        else
        {
            <CronExpressionEditor @bind-Value="@_cronExpression"
                                  InitialFormat="@_format" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@_isLoading">
            保存
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public JobDefinition JobDefinition { get; set; } = null!;

    private string _cronExpression = string.Empty;
    private CronFormat _format = CronFormat.Quartz;
    private bool _isLoading = false;

    protected override void OnInitialized()
    {
        _cronExpression = JobDefinition?.CronExpression ?? string.Empty;

        // 根据表达式段数判断格式
        var parts = _cronExpression.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        _format = parts.Length == 6 ? CronFormat.Quartz : CronFormat.Standard;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_cronExpression))
        {
            Snackbar.Add("Cron 表达式不能为空", Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            // 更新作业定义
            JobDefinition.CronExpression = _cronExpression;
            var result = await UIService.UpdateJobConfigAsync(JobDefinition);

            if (result.IsOk())
            {
                Snackbar.Add("Cron 表达式已更新", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add($"更新失败: {result.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
