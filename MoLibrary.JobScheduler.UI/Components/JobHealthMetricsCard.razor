@inject JobSchedulerUIService UIService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@using MudBlazor

<MudCard Elevation="2">
    <MudCardHeader>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">健康指标 (最近 @_timeWindowDays 天)</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           OnClick="RefreshAsync"
                           Size="Size.Small"
                           Color="Color.Primary" />
        </MudStack>
    </MudCardHeader>
    <MudCardContent>
        @if (_metrics != null)
        {
            <MudStack Spacing="3">
                <!-- 健康度和执行失败率 -->
                <MudGrid>
                    <MudItem xs="6">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">健康度</MudText>
                                <MudTooltip Text="健康度 = (总执行次数 - 跳过 - 取消) / 总执行次数。反映作业被成功调度执行的比例。">
                                    <MudIcon Icon="@Icons.Material.Filled.Info"
                                             Size="Size.Small"
                                             Color="Color.Info"
                                             Class="ml-1"
                                             Style="font-size: 14px;" />
                                </MudTooltip>
                            </MudStack>
                            <MudText Typo="Typo.h5" Color="@GetHealthScoreColor(_metrics.HealthScore)">
                                @_metrics.HealthScore.ToString("F2")%
                            </MudText>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="6">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">执行失败率</MudText>
                                <MudTooltip Text="执行失败率 = 失败次数 / 实际完成次数。实际完成次数 = 总执行次数 - 跳过 - 取消 - 运行中。反映作业执行代码的失败率。">
                                    <MudIcon Icon="@Icons.Material.Filled.Info"
                                             Size="Size.Small"
                                             Color="Color.Info"
                                             Class="ml-1"
                                             Style="font-size: 14px;" />
                                </MudTooltip>
                            </MudStack>
                            <MudText Typo="Typo.h5" Color="@GetFailureRateColor(_metrics.ExecutionFailureRate)">
                                @_metrics.ExecutionFailureRate.ToString("F2")%
                            </MudText>
                        </MudStack>
                    </MudItem>
                </MudGrid>

                <!-- 健康度进度条 -->
                <MudProgressLinear Color="@GetHealthScoreColor(_metrics.HealthScore)"
                                   Value="@_metrics.HealthScore"
                                   Size="Size.Large"
                                   Rounded="true" />

                <!-- 执行状态统计 -->
                <div class="state-grid-wrapper">
                    <MudGrid>
                        <MudItem xs="6" sm="3">
                            <MudPaper Class="pa-2 state-scheduled">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption">Scheduled</MudText>
                                    <MudText Typo="Typo.h6">@_metrics.ScheduledCount</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudPaper Class="pa-2 state-enqueued">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption">Enqueued</MudText>
                                    <MudText Typo="Typo.h6">@_metrics.EnqueuedCount</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudPaper Class="pa-2 state-processing">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption">Processing</MudText>
                                    <MudText Typo="Typo.h6">@_metrics.ProcessingCount</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudPaper Class="pa-2 state-succeeded">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption">Succeeded</MudText>
                                    <MudText Typo="Typo.h6">@_metrics.SucceededCount</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudPaper Class="pa-2 state-failed">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption">Failed</MudText>
                                    <MudText Typo="Typo.h6">@_metrics.FailedCount</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudPaper Class="pa-2 state-terminated">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption">Terminated</MudText>
                                    <MudText Typo="Typo.h6">@_metrics.TerminatedCount</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudPaper Class="pa-2 state-cancelled">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption">Cancelled</MudText>
                                    <MudText Typo="Typo.h6">@_metrics.CancelledCount</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudPaper Class="pa-2 state-skipped">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption">Skipped</MudText>
                                    <MudText Typo="Typo.h6">@_metrics.SkippedCount</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </div>

                <!-- 总执行次数 -->
                <MudStack Row="true" Justify="Justify.Center">
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                        总执行次数: <strong>@_metrics.TotalExecutions</strong>
                    </MudText>
                </MudStack>

                <!-- 最近失败实例 -->
                @if (_metrics.RecentFailures.Any())
                {
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel Text="最近失败实例" Icon="@Icons.Material.Filled.Error">
                            <MudList T="string" Dense="true">
                                @foreach (var failure in _metrics.RecentFailures)
                                {
                                    <MudListItem T="string" OnClick="@(async () => await OpenInstanceDetailDialog(failure.InstanceId))">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.body2">@failure.InstanceId</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @failure.CreatedAt.ToString("MM-dd HH:mm:ss")
                                            </MudText>
                                        </MudStack>
                                    </MudListItem>
                                }
                            </MudList>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Dense="true" NoIcon="true">
                        在监控时间窗口内无失败记录
                    </MudAlert>
                }
            </MudStack>
        }
        else if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.caption">正在加载健康指标...</MudText>
            </MudStack>
        }
        else if (_error != null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string JobKey { get; set; } = null!;

    private JobHealthMetrics? _metrics;
    private int _timeWindowDays;
    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (string.IsNullOrEmpty(JobKey))
            return;

        _isLoading = true;
        _error = null;

        try
        {
            var result = await UIService.GetHealthMetricsAsync(JobKey);
            if (result.IsFailed(out var error, out var data))
            {
                _error = $"加载失败: {error.Message}";
            }
            else
            {
                _metrics = data;
                _timeWindowDays = (int)(_metrics.MetricsEndTime - _metrics.MetricsStartTime).TotalDays;
            }
        }
        catch (Exception ex)
        {
            _error = $"加载失败: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }

        StateHasChanged();
    }

    private Color GetHealthScoreColor(double healthScore)
    {
        if (healthScore >= 95)
            return Color.Success;
        if (healthScore >= 80)
            return Color.Warning;
        return Color.Error;
    }

    private Color GetFailureRateColor(double failureRate)
    {
        if (failureRate < 5)
            return Color.Success;
        if (failureRate < 20)
            return Color.Warning;
        return Color.Error;
    }

    private async Task OpenInstanceDetailDialog(string instanceId)
    {
        var parameters = new DialogParameters<JobInstanceDetailDialog>
        {
            { x => x.InstanceId, instanceId },
            { x => x.ShowJobDefinitionButton, true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false,
            Position = DialogPosition.Center
        };

        await DialogService.ShowAsync<JobInstanceDetailDialog>("作业实例详情", parameters, options);
    }
}
