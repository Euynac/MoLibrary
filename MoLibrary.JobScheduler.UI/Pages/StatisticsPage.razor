@page "/job-scheduler/statistics"

@using MoLibrary.JobScheduler.Abstractions
@using MoLibrary.JobScheduler.UI.Components.Statistics

@inject JobAnalyticsService AnalyticsService
@inject IJobDefinitionCacheService CacheService
@inject ISnackbar Snackbar

@implements IAsyncDisposable

<PageTitle>任务调度 - 统计分析</PageTitle>

<div class="statistics-page">
    @* Time Range Selector *@
    <TimeRangeSelector Preset="@_preset"
                       PresetChanged="@OnPresetChanged"
                       CustomStartTime="@_customStartTime"
                       CustomStartTimeChanged="@(v => _customStartTime = v)"
                       CustomEndTime="@_customEndTime"
                       CustomEndTimeChanged="@(v => _customEndTime = v)"
                       OnRangeChanged="@LoadDataAsync" />

    @if (_isLoading)
    {
        <div class="loading-container">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">加载统计数据...</MudText>
        </div>
    }
    else if (_loadError != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_loadError
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadDataAsync">重试</MudButton>
        </MudAlert>
    }
    else
    {
        @* Execution Trend Chart *@
        <div class="section">
            <ExecutionTrendChart TrendData="@_trendData" Granularity="@GetGranularity()" />
        </div>

        <MudGrid Spacing="3">
            @* Duration Percentiles *@
            <MudItem xs="12" md="6">
                <DurationPercentilesCard Percentiles="@_percentiles" SlowestInstances="@_slowestInstances" />
            </MudItem>

            @* Top Jobs by Execution Count *@
            <MudItem xs="12" md="6">
                <TopJobsRanking Title="执行次数排行" Rankings="@_topByExecution" />
            </MudItem>

            @* Top Jobs by Failure Count *@
            <MudItem xs="12" md="6">
                <TopJobsRanking Title="失败次数排行" Rankings="@_topByFailure" />
            </MudItem>

            @* Failure Analysis *@
            <MudItem xs="12" md="6">
                <FailureAnalysisPanel Analysis="@_failureAnalysis" />
            </MudItem>
        </MudGrid>
    }
</div>

@code {
    public const string PAGE_URL = "/job-scheduler/statistics";

    private bool _isLoading = true;
    private string? _loadError;

    private TimeRangePreset _preset = TimeRangePreset.Today;
    private DateTime? _customStartTime;
    private DateTime? _customEndTime;

    private List<ExecutionTrendPoint> _trendData = [];
    private DurationPercentiles _percentiles = new();
    private List<SlowestInstance> _slowestInstances = [];
    private List<JobRanking> _topByExecution = [];
    private List<JobRanking> _topByFailure = [];
    private FailureAnalysis? _failureAnalysis;

    private CancellationTokenSource? _cts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _cts = new CancellationTokenSource();
            await LoadDataAsync();
        }
    }

    private async Task OnPresetChanged(TimeRangePreset preset)
    {
        _preset = preset;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _loadError = null;
            StateHasChanged();

            var token = _cts?.Token ?? CancellationToken.None;
            var (startTime, endTime) = GetEffectiveTimeRange();
            var granularity = GetGranularity();

            // Step 1: Single query with projection (no StateHistory/JobArgs loaded)
            if ((await AnalyticsService.GetInstanceStatisticsAsync(startTime, endTime, token)).IsFailed(out var error, out var instances))
            {
                _loadError = error.Message;
                return;
            }

            // Step 2: Get job names for display
            var definitions = await CacheService.GetAllDefinitionsAsync(token);
            var jobNameMap = definitions.ToDictionary(d => d.JobKey, d => d.JobName);

            // Step 3: Pure in-memory calculations (synchronous, no additional DB queries)
            // Use IsFailed pattern consistently for all Res responses
            var errors = new List<string>();

            if (AnalyticsService.CalculateExecutionTrend(instances, startTime, endTime, granularity)
                .IsFailed(out var trendError, out var trend))
            {
                errors.Add($"执行趋势: {trendError.Message}");
            }
            else
            {
                _trendData = trend;
            }

            if (AnalyticsService.CalculateDurationPercentiles(instances)
                .IsFailed(out var percentilesError, out var percentiles))
            {
                errors.Add($"耗时分布: {percentilesError.Message}");
            }
            else
            {
                _percentiles = percentiles;
            }

            if (AnalyticsService.CalculateSlowestInstances(instances, jobNameMap, 10)
                .IsFailed(out var slowestError, out var slowestInstances))
            {
                errors.Add($"最慢实例: {slowestError.Message}");
            }
            else
            {
                _slowestInstances = slowestInstances;
            }

            if (AnalyticsService.CalculateTopJobs(instances, jobNameMap, 10, RankingType.ExecutionCount)
                .IsFailed(out var topExecutionError, out var topExecution))
            {
                errors.Add($"执行排行: {topExecutionError.Message}");
            }
            else
            {
                _topByExecution = topExecution;
            }

            if (AnalyticsService.CalculateTopJobs(instances, jobNameMap, 10, RankingType.FailureCount)
                .IsFailed(out var topFailureError, out var topFailure))
            {
                errors.Add($"失败排行: {topFailureError.Message}");
            }
            else
            {
                _topByFailure = topFailure;
            }

            if (AnalyticsService.CalculateFailureAnalysis(instances, jobNameMap, startTime, endTime)
                .IsFailed(out var failureError, out var failure))
            {
                errors.Add($"失败分析: {failureError.Message}");
            }
            else
            {
                _failureAnalysis = failure;
            }

            // Display partial errors as warnings if any calculation failed
            if (errors.Count > 0)
            {
                var message = $"部分统计数据计算失败:\n{string.Join("\n", errors)}";
                Snackbar.Add(message, Severity.Warning);
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore cancellation
        }
        catch (Exception ex)
        {
            _loadError = $"加载统计数据失败: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private (DateTime start, DateTime end) GetEffectiveTimeRange()
    {
        if (_preset == TimeRangePreset.Custom && _customStartTime.HasValue && _customEndTime.HasValue)
        {
            return (_customStartTime.Value.ToUniversalTime(), _customEndTime.Value.ToUniversalTime());
        }

        var now = DateTime.UtcNow;
        return _preset switch
        {
            TimeRangePreset.Today => (now.Date, now),
            TimeRangePreset.Last24Hours => (now.AddHours(-24), now),
            TimeRangePreset.Last7Days => (now.AddDays(-7), now),
            TimeRangePreset.Last30Days => (now.AddDays(-30), now),
            _ => (now.Date, now)
        };
    }

    private TimeGranularity GetGranularity()
    {
        return _preset switch
        {
            TimeRangePreset.Today => TimeGranularity.Hourly,
            TimeRangePreset.Last24Hours => TimeGranularity.Hourly,
            TimeRangePreset.Last7Days => TimeGranularity.Daily,
            TimeRangePreset.Last30Days => TimeGranularity.Daily,
            TimeRangePreset.Custom => GetCustomGranularity(),
            _ => TimeGranularity.Hourly
        };
    }

    private TimeGranularity GetCustomGranularity()
    {
        if (!_customStartTime.HasValue || !_customEndTime.HasValue)
            return TimeGranularity.Hourly;

        var range = _customEndTime.Value - _customStartTime.Value;
        if (range.TotalDays > 30)
            return TimeGranularity.Weekly;
        if (range.TotalDays > 7)
            return TimeGranularity.Daily;
        return TimeGranularity.Hourly;
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();

        await ValueTask.CompletedTask;
    }
}
