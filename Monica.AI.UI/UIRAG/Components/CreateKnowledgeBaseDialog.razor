@using Monica.AI.KnowledgeBase.Models
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIRAG.Models
@inject IStringLocalizer<AIResource> L

<MudDialog>
    <DialogContent>
        <MudTextField T="string"
                      Value="@Name"
                      ValueChanged="OnNameChangedAsync"
                      Label="@L["RAG:Manage:CreateDialog:Name"]"
                      Placeholder="@L["RAG:Manage:CreateDialog:NamePlaceholder"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Error="@(!string.IsNullOrWhiteSpace(NameValidationMessage))"
                      ErrorText="@NameValidationMessage"
                      Class="mb-4" />

        <MudTextField T="string"
                      Value="@Id"
                      ValueChanged="OnIdChangedAsync"
                      Label="@L["RAG:Manage:CreateDialog:Id"]"
                      Placeholder="@L["RAG:Manage:CreateDialog:IdPlaceholder"]"
                      HelperText="@IdHelperText"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      MaxLength="@KnowledgeBaseIdPolicy.MaxLength"
                      Disabled="@IsIdReadOnly"
                      Error="@(!string.IsNullOrWhiteSpace(IdValidationMessage))"
                      ErrorText="@IdValidationMessage"
                      Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="@Description"
                      Label="@L["RAG:Manage:CreateDialog:Description"]"
                      Placeholder="@L["RAG:Manage:CreateDialog:DescPlaceholder"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!CanSubmit)">
            @(SubmitText ?? L["Common:Create"].Value)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string? InitialId { get; set; }
    [Parameter] public string? InitialName { get; set; }
    [Parameter] public string? InitialDescription { get; set; }
    [Parameter] public string? SubmitText { get; set; }
    [Parameter] public bool IsIdReadOnly { get; set; }

    public string Id { get; set; } = string.Empty;
    public string Name { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    private bool _initialized;
    private bool _hasManualIdEdit;

    private string? NameValidationMessage
        => string.IsNullOrWhiteSpace(Name)
            ? L["Common:Validation:Required"].Value
            : null;

    private string? IdValidationMessage
    {
        get
        {
            if (IsIdReadOnly)
            {
                return null;
            }

            if (string.IsNullOrWhiteSpace(Id))
            {
                return L["Common:Validation:Required"].Value;
            }

            return KnowledgeBaseIdPolicy.IsValid(Id)
                ? null
                : L["RAG:Manage:CreateDialog:IdInvalid"].Value;
        }
    }

    private string IdHelperText
        => IsIdReadOnly
            ? L["RAG:Manage:CreateDialog:IdReadOnlyHelper"].Value
            : L["RAG:Manage:CreateDialog:IdHelper"].Value;

    private bool CanSubmit
        => string.IsNullOrWhiteSpace(NameValidationMessage)
           && string.IsNullOrWhiteSpace(IdValidationMessage);

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            return;
        }

        Id = InitialId ?? string.Empty;
        Name = InitialName ?? string.Empty;
        Description = InitialDescription ?? string.Empty;
        _hasManualIdEdit = !string.IsNullOrWhiteSpace(InitialId);

        if (!IsIdReadOnly && string.IsNullOrWhiteSpace(Id))
        {
            Id = KnowledgeBaseIdPolicy.CreateCandidate(Name);
        }

        _initialized = true;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private Task OnNameChangedAsync(string value)
    {
        Name = value;
        if (!IsIdReadOnly && !_hasManualIdEdit)
        {
            Id = KnowledgeBaseIdPolicy.CreateCandidate(value);
        }

        return Task.CompletedTask;
    }

    private Task OnIdChangedAsync(string value)
    {
        _hasManualIdEdit = true;
        Id = KnowledgeBaseIdPolicy.CreateCandidate(value);
        return Task.CompletedTask;
    }

    private void Submit()
    {
        if (!CanSubmit)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(new KnowledgeBaseDialogResult
        {
            Id = Id,
            Name = Name.Trim(),
            Description = string.IsNullOrWhiteSpace(Description) ? null : Description.Trim()
        }));
    }
}
