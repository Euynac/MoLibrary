@using System.Text
@using System.Web
@using Microsoft.Extensions.Localization
@using Monica.AI.KnowledgeBase.Models
@using Monica.AI.RAG.Models
@using Monica.AI.UI.Localization
@implements IAsyncDisposable
@inject IStringLocalizer<AIResource> L
@inject IJSRuntime JSRuntime

<MudDialog>
    <DialogContent>
        <div class="chunk-viewer-root" @ref="_viewerRoot">
            <div class="chunk-viewer-header">
                <div class="chunk-viewer-title-block">
                    <MudText Typo="Typo.h6">@DocumentName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["RAG:ChunkViewer:Info", ChunkCount, StatusText]
                    </MudText>
                </div>

                @if (HasMatchedChunk)
                {
                    <MudChip T="string"
                             Color="Color.Warning"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Class="chunk-viewer-match-chip">
                        @L["RAG:ChunkViewer:MatchedBadge"]
                    </MudChip>
                }
            </div>

            <div class="chunk-viewer-content" data-chunk-scroll-root="true">
                @if (string.IsNullOrWhiteSpace(OriginalText))
                {
                    <div class="empty-state">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["RAG:ChunkViewer:NoContent"]
                        </MudText>
                    </div>
                }
                else if (UseMarkdownRendering)
                {
                    <div class="markdown-preview-content">
                        <RAGChunkMarkdown Value="@OriginalText"
                                          ScopeKey="@SourceGroupKey"
                                          DocumentRelativePath="@DocumentPath"
                                          Chunks="@Chunks"
                                          MatchedChunkIndex="@MatchedChunkIndex" />
                    </div>
                }
                else
                {
                    <div class="original-text">
                        @((MarkupString)BuildHighlightedHtml())
                    </div>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Common:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string DocumentName { get; set; } = string.Empty;

    [Parameter]
    public string DocumentPath { get; set; } = string.Empty;

    [Parameter]
    public string OriginalText { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ChunkHighlight> Chunks { get; set; } = Array.Empty<ChunkHighlight>();

    [Parameter]
    public int? MatchedChunkIndex { get; set; }

    [Parameter]
    public string StatusText { get; set; } = string.Empty;

    [Parameter]
    public string SourceKind { get; set; } = KnowledgeDocumentSourceKinds.Unknown;

    [Parameter]
    public string? SourceGroupKey { get; set; }

    private readonly List<ChunkHighlight> OrderedChunks = [];
    private ElementReference _viewerRoot;
    private IJSObjectReference? _jsModule;
    private string _lastAppliedSignature = string.Empty;

    private int ChunkCount => OrderedChunks.Count;

    private bool HasMatchedChunk =>
        MatchedChunkIndex.HasValue && OrderedChunks.Any(chunk => chunk.Index == MatchedChunkIndex.Value);

    private bool UseMarkdownRendering =>
        string.Equals(SourceKind, KnowledgeDocumentSourceKinds.Markdown, StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        OrderedChunks.Clear();
        OrderedChunks.AddRange(Chunks.OrderBy(chunk => chunk.Start).ThenBy(chunk => chunk.Index));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HasMatchedChunk)
        {
            return;
        }

        await EnsureJsModuleAsync();
        if (_jsModule is null)
        {
            return;
        }

        var signature = BuildScrollSignature();
        if (string.Equals(signature, _lastAppliedSignature, StringComparison.Ordinal))
        {
            return;
        }

        _lastAppliedSignature = signature;

        try
        {
            await _jsModule.InvokeVoidAsync("scrollToMatchedChunk", _viewerRoot);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task EnsureJsModuleAsync()
    {
        if (_jsModule is not null)
        {
            return;
        }

        try
        {
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Monica.AI.UI/UIRAG/Components/ChunkViewerDialog.razor.js");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private void Close() => MudDialog.Close();

    private string BuildScrollSignature()
    {
        return string.Join(
            "|",
            MatchedChunkIndex?.ToString() ?? string.Empty,
            OriginalText.Length,
            ChunkCount,
            SourceKind,
            SourceGroupKey ?? string.Empty,
            DocumentPath);
    }

    private string BuildHighlightedHtml()
    {
        if (string.IsNullOrEmpty(OriginalText))
        {
            return string.Empty;
        }

        if (OrderedChunks.Count == 0)
        {
            return HttpUtility.HtmlEncode(OriginalText);
        }

        var boundaries = new SortedSet<int> { 0, OriginalText.Length };
        foreach (var chunk in OrderedChunks)
        {
            boundaries.Add(Math.Clamp(chunk.Start, 0, OriginalText.Length));
            boundaries.Add(Math.Clamp(chunk.End, 0, OriginalText.Length));
        }

        var points = boundaries.ToArray();
        var html = new StringBuilder();

        for (var index = 0; index < points.Length - 1; index++)
        {
            var segmentStart = points[index];
            var segmentEnd = points[index + 1];
            if (segmentEnd <= segmentStart)
            {
                continue;
            }

            var segmentText = OriginalText[segmentStart..segmentEnd];
            var activeChunks = OrderedChunks
                .Where(chunk => chunk.Start < segmentEnd && chunk.End > segmentStart)
                .ToList();

            if (activeChunks.Count == 0)
            {
                html.Append(HttpUtility.HtmlEncode(segmentText));
                continue;
            }

            var metadata = BuildChunkMetadata(activeChunks);
            html.Append("<span");
            html.Append($" class=\"{BuildChunkClass(activeChunks, isBlock: false)}\"");
            html.Append(" data-rag-chunk=\"true\"");
            html.Append($" data-rag-chunk-ids=\"{HttpUtility.HtmlAttributeEncode(string.Join(",", activeChunks.Select(chunk => chunk.Index)))}\"");
            html.Append($" data-rag-chunk-label=\"{HttpUtility.HtmlAttributeEncode(metadata)}\"");
            html.Append($" title=\"{HttpUtility.HtmlAttributeEncode(metadata)}\"");

            if (ContainsMatchedChunk(activeChunks))
            {
                html.Append(" data-rag-chunk-target=\"true\"");
            }

            html.Append(">");
            html.Append(HttpUtility.HtmlEncode(segmentText));
            html.Append("</span>");
        }

        return html.ToString();
    }

    private bool ContainsMatchedChunk(IReadOnlyList<ChunkHighlight> chunks)
        => MatchedChunkIndex.HasValue && chunks.Any(chunk => chunk.Index == MatchedChunkIndex.Value);

    private string BuildChunkClass(IReadOnlyList<ChunkHighlight> chunks, bool isBlock)
    {
        var classes = new List<string>
        {
            "rag-chunk",
            isBlock ? "rag-chunk--block" : "rag-chunk--inline"
        };

        if (chunks.Count > 1)
        {
            classes.Add("rag-chunk--overlap");
        }

        if (ContainsMatchedChunk(chunks))
        {
            classes.Add("rag-chunk--matched");
        }

        return string.Join(" ", classes);
    }

    private string BuildChunkMetadata(IReadOnlyList<ChunkHighlight> chunks)
    {
        var chunkLabel = chunks.Count == 1
            ? L["RAG:ChunkViewer:ChunkNumber", chunks[0].Index].Value
            : L["RAG:ChunkViewer:ChunkNumbers", string.Join(", ", chunks.Select(chunk => chunk.Index))].Value;

        var sections = chunks
            .Select(chunk => chunk.Section)
            .Where(section => !string.IsNullOrWhiteSpace(section))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (sections.Count > 0)
        {
            chunkLabel = $"{chunkLabel} · {L["RAG:ChunkViewer:Section", string.Join(" / ", sections)]}";
        }

        if (ContainsMatchedChunk(chunks))
        {
            chunkLabel = $"{chunkLabel} · {L["RAG:ChunkViewer:MatchedBadge"]}";
        }

        return chunkLabel;
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is null)
        {
            return;
        }

        try
        {
            await _jsModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}
