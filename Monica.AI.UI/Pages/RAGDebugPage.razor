@attribute [Route(PAGE_URL)]
@rendermode InteractiveServer
@using Monica.AI.KnowledgeBase.Facades
@using Monica.AI.RAG.Models
@using Monica.AI.RAG.Facades
@using Monica.AI.UI.Localization
@using Monica.Core.Results;
@using Microsoft.Extensions.Localization
@using KnowledgeBaseModel = Monica.AI.KnowledgeBase.Models.KnowledgeBase
@inject RAGSearchFacade SearchFacade
@inject RAGIndexingFacade IndexingFacade
@inject KnowledgeBaseFacade KnowledgeBaseFacade
@inject EmbeddingModelFacade EmbeddingService
@inject IAIProviderFactory ProviderFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<AIResource> L

<div class="rag-debug-shell">
    <aside class="rag-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-title-group">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" Class="sidebar-title-icon" />
                <MudText Typo="Typo.subtitle1" Class="sidebar-title">@L["RAG:Debug:KBSidebar:Title"]</MudText>
            </div>
        </div>

        <div class="kb-selection-actions">
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAllKBs">
                @L["RAG:Debug:KBSidebar:SelectAll"]
            </MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="DeselectAllKBs">
                @L["RAG:Debug:KBSidebar:DeselectAll"]
            </MudButton>
        </div>

        <div class="kb-list">
            @foreach (var kb in _knowledgeBases)
            {
                <div class="kb-item">
                    <MudCheckBox T="bool"
                                 Value="@_selectedKbIds.Contains(kb.Id)"
                                 ValueChanged="@((bool isChecked) => OnKBCheckChanged(kb.Id, isChecked))"
                                 Dense="true"
                                 Class="kb-checkbox">
                        <div class="kb-info">
                            <MudText Typo="Typo.body2" Class="kb-name">@kb.Name</MudText>
                            @if (!string.IsNullOrWhiteSpace(kb.Description))
                            {
                                <MudText Typo="Typo.caption" Class="kb-description">
                                    @kb.Description
                                </MudText>
                            }
                            <MudText Typo="Typo.caption" Class="kb-stats">
                                @L["RAG:Debug:KBSidebar:Stats", kb.DocumentCount, kb.ChunkCount]
                            </MudText>
                            @if (HasEmbeddingBinding(kb))
                            {
                                <MudText Typo="Typo.caption" Class="kb-embedding-model">
                                    @GetKnowledgeBaseModelDisplay(kb)
                                </MudText>
                            }
                        </div>
                    </MudCheckBox>
                </div>
            }
        </div>
    </aside>

    <main class="rag-main-panel">
        <Monica.AI.UI.UIRAG.Components.EmbeddingModelSelector
            AvailableModels="@_embeddingModels"
            SelectedModelKey="@_selectedEmbeddingModelKey"
            SelectedModelKeyChanged="@OnEmbeddingModelChanged" />

        @if (_showEmbeddingWarning)
        {
            <Monica.AI.UI.UIRAG.Components.EmbeddingModelWarning
                CurrentModelId="@GetModelDisplayByKey(_selectedEmbeddingModelKey)"
                KnowledgeBaseModelId="@_mismatchedKbModelDisplay"
                AdditionalMessage="@_embeddingWarningMessage"
                Show="true" />
        }

        <div class="search-controls">
            <div class="search-input-group">
                <MudText Typo="Typo.caption" Class="search-label">@L["RAG:Search:QueryLabel"]</MudText>
                <MudTextField @bind-Value="_searchQuery"
                              Placeholder="@L["RAG:Search:Placeholder"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="search-input"
                              OnKeyDown="HandleSearchKeyDown" />
            </div>

            <div class="search-options">
                <div class="topk-group">
                    <MudText Typo="Typo.caption" Class="search-label">@L["RAG:Search:TopK"]</MudText>
                    <MudSelect T="int" @bind-Value="_topK"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="topk-select">
                        <MudSelectItem T="int" Value="3">3</MudSelectItem>
                        <MudSelectItem T="int" Value="5">5</MudSelectItem>
                        <MudSelectItem T="int" Value="10">10</MudSelectItem>
                        <MudSelectItem T="int" Value="20">20</MudSelectItem>
                    </MudSelect>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="HandleSearch"
                           Disabled="@(_isSearching || string.IsNullOrWhiteSpace(_searchQuery) || !_selectedKbIds.Any())">
                    @(_isSearching ? L["RAG:Search:Searching"] : L["RAG:Search:Go"])
                </MudButton>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_searchErrorMessage))
        {
            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Outlined"
                      Dense="true"
                      Class="search-error">
                @_searchErrorMessage
            </MudAlert>
        }

        @if (_searchResults.Count > 0)
        {
            <MudText Typo="Typo.caption" Class="results-count">
                @L["RAG:Search:ResultsCount", _searchResults.Count]
            </MudText>
            <div class="search-results">
                @foreach (var result in _searchResults)
                {
                    <SearchResultCard Result="@result" OnClick="@(() => ShowChunkViewer(result))" />
                }
            </div>
        }
        else if (_hasSearched && !_isSearching && string.IsNullOrWhiteSpace(_searchErrorMessage))
        {
            <MudText Typo="Typo.body2" Class="no-results">
                @L["RAG:Search:NoResults"]
            </MudText>
        }
    </main>
</div>

@code {
    public const string PAGE_URL = "/ai/rag/debug";

    private IReadOnlyList<KnowledgeBaseModel> _knowledgeBases = [];
    private IReadOnlyList<EmbeddingModelOption> _embeddingModels = [];
    private IReadOnlyList<TextSearchResult> _searchResults = [];
    private HashSet<string> _selectedKbIds = [];
    private string _searchQuery = string.Empty;
    private int _topK = 5;
    private bool _isSearching;
    private bool _hasSearched;
    private string _selectedEmbeddingModelKey = string.Empty;
    private bool _showEmbeddingWarning;
    private string _mismatchedKbModelDisplay = string.Empty;
    private string _embeddingWarningMessage = string.Empty;
    private string _searchErrorMessage = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var kbResult = await KnowledgeBaseFacade.GetAllAsync();
            if (!kbResult.IsFailed(out var error, out var kbs))
            {
                _knowledgeBases = kbs;
                _selectedKbIds = kbs.Select(kb => kb.Id).ToHashSet();
            }
            else
            {
                Snackbar.Add(error.Message!, Severity.Error);
            }

            var modelsResult = await EmbeddingService.GetEmbeddingModelsAsync();
            if (!modelsResult.IsFailed(out error, out var models))
            {
                _embeddingModels = models;
            }

            RefreshEmbeddingModelSelection();
            CheckEmbeddingModelMismatch();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectAllKBs()
    {
        _selectedKbIds = _knowledgeBases.Select(kb => kb.Id).ToHashSet();
        RefreshEmbeddingModelSelection();
        CheckEmbeddingModelMismatch();
        StateHasChanged();
    }

    private void DeselectAllKBs()
    {
        _selectedKbIds.Clear();
        RefreshEmbeddingModelSelection();
        CheckEmbeddingModelMismatch();
        StateHasChanged();
    }

    private void OnKBCheckChanged(string kbId, bool isChecked)
    {
        if (isChecked)
            _selectedKbIds.Add(kbId);
        else
            _selectedKbIds.Remove(kbId);

        RefreshEmbeddingModelSelection();
        CheckEmbeddingModelMismatch();
        StateHasChanged();
    }

    private async Task OnEmbeddingModelChanged(string modelKey)
    {
        _selectedEmbeddingModelKey = modelKey;
        CheckEmbeddingModelMismatch();
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshEmbeddingModelSelection()
    {
        if (TryGetCheckedKnowledgeBaseEmbeddingModelKey(out var autoSelectedModelKey))
        {
            _selectedEmbeddingModelKey = autoSelectedModelKey;
        }
    }

    private void CheckEmbeddingModelMismatch()
    {
        if (string.IsNullOrEmpty(_selectedEmbeddingModelKey) || !_selectedKbIds.Any())
        {
            _showEmbeddingWarning = false;
            _embeddingWarningMessage = string.Empty;
            _mismatchedKbModelDisplay = string.Empty;
            return;
        }

        var mismatchedKBs = new List<string>();
        _mismatchedKbModelDisplay = string.Empty;
        foreach (var kbId in _selectedKbIds)
        {
            var kb = _knowledgeBases.FirstOrDefault(k => k.Id == kbId);
            if (kb is null || !HasEmbeddingBinding(kb))
            {
                continue;
            }

            if (!string.Equals(GetKnowledgeBaseModelKey(kb), _selectedEmbeddingModelKey, StringComparison.OrdinalIgnoreCase))
            {
                mismatchedKBs.Add(kb.Name);
                _mismatchedKbModelDisplay = GetKnowledgeBaseModelDisplay(kb);
            }
        }

        if (mismatchedKBs.Any())
        {
            _showEmbeddingWarning = true;
            _embeddingWarningMessage = L["RAG:EmbeddingModel:Warning:SearchMismatch", string.Join(", ", mismatchedKBs)];
        }
        else
        {
            _showEmbeddingWarning = false;
            _embeddingWarningMessage = string.Empty;
        }
    }

    private bool TryGetCheckedKnowledgeBaseEmbeddingModelKey(out string modelKey)
    {
        modelKey = string.Empty;
        if (!_selectedKbIds.Any() || _embeddingModels.Count == 0)
        {
            return false;
        }

        string? resolvedModelKey = null;
        foreach (var kbId in _selectedKbIds)
        {
            var kb = _knowledgeBases.FirstOrDefault(k =>
                string.Equals(k.Id, kbId, StringComparison.OrdinalIgnoreCase));
            if (kb is null || !HasEmbeddingBinding(kb))
            {
                return false;
            }

            var knowledgeBaseModelKey = GetKnowledgeBaseModelKey(kb);
            if (!HasAvailableEmbeddingModel(knowledgeBaseModelKey))
            {
                return false;
            }

            if (resolvedModelKey is null)
            {
                resolvedModelKey = knowledgeBaseModelKey;
                continue;
            }

            if (!string.Equals(resolvedModelKey, knowledgeBaseModelKey, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }

        if (string.IsNullOrWhiteSpace(resolvedModelKey))
        {
            return false;
        }

        modelKey = resolvedModelKey;
        return true;
    }

    private async Task HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) || !_selectedKbIds.Any()) return;

        _isSearching = true;
        _hasSearched = true;
        _searchErrorMessage = string.Empty;
        StateHasChanged();

        var result = await SearchFacade.SearchAsync(
            _searchQuery,
            _selectedKbIds,
            _topK,
            BuildSearchEmbeddingOverride());
        if (!result.IsFailed(out var error, out var results))
        {
            _searchResults = results;
            _searchErrorMessage = string.Empty;
        }
        else
        {
            _searchResults = [];
            _searchErrorMessage = error.Message ?? string.Empty;
            Snackbar.Add(error.Message!, Severity.Error);
        }

        _isSearching = false;
        StateHasChanged();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleSearch();
    }

    private async Task ShowChunkViewer(TextSearchResult result)
    {
        if (string.IsNullOrEmpty(result.DocumentId))
        {
            Snackbar.Add(L["RAG:Search:Result:MissingDocumentId"], Severity.Warning);
            return;
        }

        var kbId = result.KnowledgeBaseId;
        if (string.IsNullOrEmpty(kbId))
        {
            Snackbar.Add(L["RAG:Search:Result:MissingKnowledgeBase"], Severity.Warning);
            return;
        }

        var chunksResult = await IndexingFacade.GetDocumentChunksAsync(kbId, result.DocumentId);
        if (chunksResult.IsFailed(out var error, out var view))
        {
            Snackbar.Add(error.Message!, Severity.Error);
            return;
        }

        var knowledgeBase = _knowledgeBases.FirstOrDefault(kb =>
            string.Equals(kb.Id, kbId, StringComparison.OrdinalIgnoreCase));
        var statusText = knowledgeBase is null
            ? L["RAG:ChunkViewer:Indexed", DateTime.Now.ToString("yyyy-MM-dd")].Value
            : L["RAG:ChunkViewer:SourceKnowledgeBase", knowledgeBase.Name].Value;

        var parameters = new DialogParameters
        {
            { nameof(ChunkViewerDialog.DocumentName), result.SourceName ?? L["RAG:Search:Result:UnknownSource"].Value },
            { nameof(ChunkViewerDialog.DocumentPath), view.DocumentPath },
            { nameof(ChunkViewerDialog.OriginalText), view.OriginalText },
            { nameof(ChunkViewerDialog.Chunks), view.Chunks },
            { nameof(ChunkViewerDialog.MatchedChunkIndex), result.ChunkIndex },
            { nameof(ChunkViewerDialog.StatusText), statusText },
            { nameof(ChunkViewerDialog.SourceKind), view.SourceKind },
            { nameof(ChunkViewerDialog.SourceGroupKey), view.SourceGroupKey }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<ChunkViewerDialog>(
            L["RAG:ChunkViewer:Title"].Value,
            parameters,
            options);
    }

    private static bool HasEmbeddingBinding(KnowledgeBaseModel kb)
        => !string.IsNullOrWhiteSpace(kb.EmbeddingProviderId)
           && !string.IsNullOrWhiteSpace(kb.EmbeddingModelName);

    private static string GetKnowledgeBaseModelKey(KnowledgeBaseModel kb)
    {
        if (!HasEmbeddingBinding(kb))
        {
            return string.Empty;
        }

        return EmbeddingModelOption.ToModelKey(kb.EmbeddingProviderId!, kb.EmbeddingModelName!);
    }

    private string GetKnowledgeBaseModelDisplay(KnowledgeBaseModel kb)
    {
        if (!HasEmbeddingBinding(kb))
        {
            return string.Empty;
        }

        var providerLabel = _embeddingModels
            .FirstOrDefault(m => string.Equals(m.ProviderId, kb.EmbeddingProviderId, StringComparison.OrdinalIgnoreCase))
            ?.ProviderDisplayName ?? GetProviderDisplayLabel(kb.EmbeddingProviderId, kb.EmbeddingModelName);

        return $"{kb.EmbeddingModelName} ({providerLabel})";
    }

    private bool HasAvailableEmbeddingModel(string modelKey)
        => _embeddingModels.Any(m =>
            string.Equals(m.ModelKey, modelKey, StringComparison.OrdinalIgnoreCase));

    private string GetModelDisplayByKey(string modelKey)
    {
        var model = _embeddingModels.FirstOrDefault(m =>
            string.Equals(m.ModelKey, modelKey, StringComparison.OrdinalIgnoreCase));
        if (model is not null)
        {
            return $"{model.ModelName} ({model.ProviderDisplayName})";
        }

        if (!EmbeddingModelOption.TryParseModelKey(modelKey, out var providerId, out var modelName))
        {
            return modelKey;
        }

        return $"{modelName} ({GetProviderDisplayLabel(providerId, modelName)})";
    }

    private string GetProviderDisplayLabel(string? providerId, string? modelName = null)
    {
        if (string.IsNullOrWhiteSpace(providerId))
        {
            return string.Empty;
        }

        var model = _embeddingModels.FirstOrDefault(m =>
            string.Equals(m.ProviderId, providerId, StringComparison.OrdinalIgnoreCase)
            && (string.IsNullOrWhiteSpace(modelName)
                || string.Equals(m.ModelName, modelName, StringComparison.OrdinalIgnoreCase)));
        if (model is not null)
        {
            return model.ProviderDisplayName;
        }

        if (!string.IsNullOrWhiteSpace(modelName))
        {
            var candidates = _embeddingModels
                .Where(m => string.Equals(m.ModelName, modelName, StringComparison.OrdinalIgnoreCase))
                .Select(m => m.ProviderDisplayName)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (candidates.Count == 1)
            {
                return candidates[0];
            }
        }

        var provider = ProviderFactory.GetProvider(providerId);
        if (provider is not null)
        {
            return provider.DisplayName;
        }

        return providerId.Trim();
    }

    private RAGSearchEmbeddingOverride? BuildSearchEmbeddingOverride()
    {
        if (!EmbeddingModelOption.TryParseModelKey(_selectedEmbeddingModelKey, out var providerId, out var modelName))
        {
            return null;
        }

        return new RAGSearchEmbeddingOverride(providerId, modelName);
    }
}
