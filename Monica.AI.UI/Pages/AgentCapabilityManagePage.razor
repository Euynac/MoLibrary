@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using System.Text.Json
@using Monica.AI.AgentCapabilities.Models
@using Monica.AI.Facades
@using Monica.AI.Mcp.Models
@using Monica.AI.UI.Localization
@using Monica.Core.Results
@rendermode InteractiveServer
@inject AgentCapabilityFacade CapabilityFacade
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<AIResource> L
@inject IJSRuntime JSRuntime

<PageTitle>@L["Capabilities:Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="capability-page pa-4">
    <div class="page-header">
        <div>
            <MudText Typo="Typo.h4">@L["Capabilities:Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Capabilities:Subtitle"]</MudText>
        </div>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">
                @L["Capabilities:Refresh"]
            </MudButton>
        </MudStack>
    </div>

    @if (_isLoading)
    {
        <div class="loading-area">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_management is null)
    {
        <MudAlert Severity="Severity.Info">@L["Capabilities:Empty"]</MudAlert>
    }
    else
    {
        <MudTabs ActivePanelIndex="@_activeTabIndex"
                 ActivePanelIndexChanged="SetActiveTab"
                 Rounded="true"
                 Border="true"
                 Elevation="0"
                 Class="capability-tabs">
            <MudTabPanel Text="@L["Capabilities:Tabs:Skills"]" Icon="@Icons.Material.Filled.AutoAwesome">
                @RenderFileSkillSourceStatus()
                @RenderCapabilityCatalog(
                    AgentCapabilityKind.Skill,
                    _management.Skills,
                    _management.AreSkillsEnabled,
                    L["Capabilities:Global:Skills"])
            </MudTabPanel>
            <MudTabPanel Text="@L["Capabilities:Tabs:Mcp"]" Icon="@Icons.Material.Filled.AccountTree">
                @RenderCapabilityCatalog(
                    AgentCapabilityKind.Mcp,
                    _management.McpEntries,
                    _management.AreMcpToolsEnabled,
                    L["Capabilities:Global:Mcp"])
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    public const string PAGE_URL = "/ai/capabilities";

    private AgentCapabilityManagementInfo? _management;
    private AgentCapabilityEntryInfo? _selectedEntry;
    private McpConnectivityTestResult? _lastConnectivityResult;
    private string? _query;
    private bool _isLoading;
    private bool _isTestingMcp;
    private int _activeTabIndex;

    private IReadOnlyList<AgentCapabilityEntryInfo> CurrentEntries => _activeTabIndex == 0
        ? _management?.Skills ?? []
        : _management?.McpEntries ?? [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await CapabilityFacade.GetManagementInfoAsync();
        if (result.IsFailed(out var error, out var management))
        {
            AddErrorSnackbar(error.Message);
            _management = null;
        }
        else
        {
            _management = management;
            EnsureSelectedEntry();
        }

        _isLoading = false;
        StateHasChanged();
    }

    private RenderFragment RenderCapabilityCatalog(
        AgentCapabilityKind kind,
        IReadOnlyList<AgentCapabilityEntryInfo> entries,
        bool catalogEnabled,
        string catalogLabel)
    {
        return @<div class="catalog-layout">
            <div class="catalog-toolbar">
                <MudTextField T="string"
                              Value="@_query"
                              ValueChanged="SetQuery"
                              Placeholder="@L["Capabilities:Search"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Class="search-box" />
                @if (kind == AgentCapabilityKind.Mcp)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="ShowAddMcpProfileDialogAsync">
                        @L["Capabilities:Mcp:Add"]
                    </MudButton>
                }
                <MudSwitch T="bool"
                           Value="@catalogEnabled"
                           ValueChanged="@((bool enabled) => SetCatalogEnabledAsync(kind, enabled))"
                           Color="Color.Primary"
                           Label="@catalogLabel" />
            </div>

            <div class="catalog-content">
                <div class="entry-list">
                    @foreach (var entry in FilterEntries(entries))
                    {
                        <button type="button"
                                class="@GetEntryButtonClass(entry)"
                                @onclick="@(() => SelectEntry(entry))">
                            <span class="entry-main">
                                <MudIcon Icon="@GetEntryIcon(entry)" Size="Size.Small" />
                                <span class="entry-text">
                                    <span class="entry-name">@entry.Name</span>
                                    <span class="entry-description">@entry.Description</span>
                                </span>
                            </span>
                            <span class="entry-meta">
                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(entry)" Variant="Variant.Outlined">
                                    @GetStatusText(entry)
                                </MudChip>
                                @if (entry.SourceKind == AgentCapabilitySourceKind.ExternalFile)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                        @L["Capabilities:Skill:External"]
                                    </MudChip>
                                }
                                @if (entry.CanExposeAsMcpServer)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@(entry.IsMcpServerExposureEnabled ? Color.Secondary : Color.Default)"
                                             Variant="Variant.Outlined">
                                        @(entry.IsMcpServerExposureEnabled
                                            ? L["Capabilities:Skill:McpServerEnabled"]
                                            : L["Capabilities:Skill:McpServerAvailable"])
                                    </MudChip>
                                }
                                @if (entry.McpSourceKind == McpCatalogSourceKind.SkillServer)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                                        @L["Capabilities:Mcp:Source:SkillServer"]
                                    </MudChip>
                                }
                                <span>@entry.Tools.Count @L["Capabilities:Tools"]</span>
                            </span>
                        </button>
                    }
                </div>

                <div class="entry-detail">
                    @if (_selectedEntry is null || _selectedEntry.Kind != kind)
                    {
                        <MudAlert Severity="Severity.Info">@L["Capabilities:SelectPrompt"]</MudAlert>
                    }
                    else
                    {
                        @RenderEntryDetail(_selectedEntry)
                    }
                </div>
            </div>
        </div>;
    }

    private RenderFragment RenderFileSkillSourceStatus()
    {
        if (_management?.FileSkillSources.Count is not > 0)
        {
            return @<text></text>;
        }

        return @<div class="skill-source-status">
            <div class="skill-source-header">
                <div>
                    <MudText Typo="Typo.subtitle1">@L["Capabilities:Skill:Sources:Title"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["Capabilities:Skill:Sources:Summary", GetLoadedFileSkillCount(), _management.FileSkillSources.Count]
                    </MudText>
                </div>
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(_management.FileSkillSources.Any(static source => source.HasIssues) ? Color.Warning : Color.Success)"
                         Variant="Variant.Outlined">
                    @(_management.FileSkillSources.Any(static source => source.HasIssues)
                        ? L["Capabilities:Skill:Sources:HasIssues"]
                        : L["Capabilities:Skill:Sources:Healthy"])
                </MudChip>
            </div>

            <MudExpansionPanels Elevation="0" Dense="true" Class="skill-source-panels">
                @foreach (var source in _management.FileSkillSources)
                {
                    <MudExpansionPanel Text="@GetFileSkillSourceTitle(source)" Icon="@Icons.Material.Filled.FolderOpen">
                        <div class="skill-source-body">
                            <div class="skill-source-chips">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                    @L["Capabilities:Skill:Sources:Loaded", source.LoadedSkillCount]
                                </MudChip>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(source.HasScriptRunner ? Color.Success : Color.Warning)"
                                         Variant="Variant.Outlined">
                                    @(source.UsesSubprocessRunner
                                        ? L["Capabilities:Skill:Sources:SubprocessRunner"]
                                        : source.HasScriptRunner
                                            ? L["Capabilities:Skill:Sources:CustomRunner"]
                                            : L["Capabilities:Skill:Sources:NoRunner"])
                                </MudChip>
                            </div>

                            @if (source.Issues.Count > 0)
                            {
                                @RenderIssueList(source.Issues)
                            }

                            <div class="skill-path-list">
                                @foreach (var path in source.Paths)
                                {
                                    <div class="skill-path-row">
                                        <div class="skill-path-main">
                                            <MudIcon Icon="@(path.Exists ? Icons.Material.Filled.Folder : Icons.Material.Filled.FolderOff)"
                                                     Size="Size.Small"
                                                     Color="@(path.Exists ? Color.Primary : Color.Warning)" />
                                            <div class="skill-path-text">
                                                <MudText Typo="Typo.body2">@path.Path</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @L["Capabilities:Skill:Sources:PathLoaded", path.LoadedSkillCount]
                                                </MudText>
                                            </div>
                                        </div>
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="@(path.Issues.Count == 0 ? Color.Success : Color.Warning)"
                                                 Variant="Variant.Outlined">
                                            @(path.Issues.Count == 0
                                                ? L["Capabilities:Skill:Sources:PathOk"]
                                                : L["Capabilities:Skill:Sources:IssueCount", path.Issues.Count])
                                        </MudChip>
                                    </div>

                                    @if (path.LoadedSkillNames.Count > 0)
                                    {
                                        <div class="skill-name-list">
                                            @foreach (var skillName in path.LoadedSkillNames)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@skillName</MudChip>
                                            }
                                        </div>
                                    }

                                    @if (path.Issues.Count > 0)
                                    {
                                        @RenderIssueList(path.Issues)
                                    }
                                }
                            </div>
                        </div>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>;
    }

    private RenderFragment RenderEntryDetail(AgentCapabilityEntryInfo entry)
    {
        return @<div class="detail-panel">
            <div class="detail-header">
                <div>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@GetEntryIcon(entry)" Color="@GetKindColor(entry.Kind)" />
                        <MudText Typo="Typo.h5">@entry.Title</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@entry.Description</MudText>
                </div>
                <MudSwitch T="bool"
                           Value="@entry.IsEntryEnabled"
                           ValueChanged="@((bool enabled) => SetEntryEnabledAsync(entry, enabled))"
                           Color="Color.Primary"
                           Label="@L["Capabilities:Enabled"]" />
            </div>

            @if (!entry.IsEnabled && !string.IsNullOrWhiteSpace(entry.DisabledReason))
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@FormatDisabledReason(entry.DisabledReason)</MudAlert>
            }

            <MudStack Row="true" Spacing="1" Class="detail-chips">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@entry.Kind</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@entry.Tools.Count @L["Capabilities:Tools"]</MudChip>
                @if (entry.Resources.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@entry.Resources.Count @L["Capabilities:Resources"]</MudChip>
                }
                @if (entry.SourceKind == AgentCapabilitySourceKind.ExternalFile)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                        @L["Capabilities:Skill:External"]
                    </MudChip>
                }
                @if (entry.CanExposeAsMcpServer)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                        @L["Capabilities:Skill:McpCapable"]
                    </MudChip>
                }
                @if (entry.McpSourceKind is not null)
                {
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(entry.McpSourceKind == McpCatalogSourceKind.SkillServer ? Color.Secondary : Color.Default)"
                             Variant="Variant.Outlined">
                        @GetMcpSourceKindText(entry.McpSourceKind.Value)
                    </MudChip>
                }
                @if (entry.McpTransportKind is not null)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@entry.McpTransportKind</MudChip>
                }
                @if (entry.McpExternalProfile is not null)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@entry.McpExternalProfile.TransportMode</MudChip>
                }
                @if (entry.IsUserManaged)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                        @L["Capabilities:Mcp:UserManaged"]
                    </MudChip>
                }
            </MudStack>

            @if (entry.SourceKind == AgentCapabilitySourceKind.ExternalFile
                 && !string.IsNullOrWhiteSpace(entry.SourcePath))
            {
                <div class="capability-source-summary">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Capabilities:Skill:SourcePath"]</MudText>
                    <MudText Typo="Typo.body2">@entry.SourcePath</MudText>
                </div>
            }

            @if (entry.CanExposeAsMcpServer)
            {
                <div class="skill-mcp-summary">
                    <div class="skill-mcp-main">
                        <MudIcon Icon="@Icons.Material.Filled.SettingsEthernet" Color="Color.Secondary" Size="Size.Small" />
                        <div>
                            <MudText Typo="Typo.subtitle2">@L["Capabilities:Skill:McpServerTitle"]</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["Capabilities:Skill:McpServerDescription", entry.SkillMcpServerName ?? entry.Name]
                            </MudText>
                        </div>
                    </div>
                    <MudSwitch T="bool"
                               Value="@entry.IsMcpServerExposureEnabled"
                               ValueChanged="@((bool enabled) => SetSkillMcpServerEnabledAsync(entry, enabled))"
                               Color="Color.Secondary"
                               Label="@L["Capabilities:Skill:McpServerToggle"]" />
                    @if (entry.McpServerExposureRequiresRestart)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="restart-hint">
                            @L["Capabilities:Skill:McpServerRestartHint"]
                        </MudAlert>
                    }
                </div>
            }

            @if (entry.McpExternalProfile is not null)
            {
                <div class="capability-source-summary">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Capabilities:Mcp:Endpoint"]</MudText>
                    <MudText Typo="Typo.body2">@entry.McpExternalProfile.Endpoint</MudText>
                    @if (entry.McpExternalProfile.Headers.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["Capabilities:Mcp:Headers", entry.McpExternalProfile.Headers.Count]
                        </MudText>
                    }
                </div>
            }
            else if (entry.Kind == AgentCapabilityKind.Mcp
                     && !string.IsNullOrWhiteSpace(entry.McpEndpointPath))
            {
                <div class="capability-source-summary">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Capabilities:Mcp:Endpoint"]</MudText>
                    <MudText Typo="Typo.body2">@(entry.McpDisplayUrl ?? entry.McpEndpointPath)</MudText>
                </div>
            }

            @if (entry.Kind == AgentCapabilityKind.Mcp)
            {
                <div class="mcp-probe-row">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.NetworkPing"
                               Disabled="@_isTestingMcp"
                               OnClick="@(() => TestMcpAsync(entry))">
                        @if (_isTestingMcp)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        }
                        @L["Capabilities:Mcp:Test"]
                    </MudButton>
                    <MudTooltip Text="@GetCopyMcpConfigTooltip(entry)">
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   Disabled="@(!CanCopyMcpConfig(entry))"
                                   OnClick="@(() => CopyMcpConfigAsync(entry))">
                            @L["Capabilities:Mcp:CopyConfig"]
                        </MudButton>
                    </MudTooltip>
                    @if (entry.IsUserManaged)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => ShowEditMcpProfileDialogAsync(entry))">
                            @L["Common:Edit"]
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="@(() => DeleteMcpProfileAsync(entry))">
                            @L["Common:Delete"]
                        </MudButton>
                    }
                    @if (_lastConnectivityResult?.Name == entry.Name)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(_lastConnectivityResult.Success ? Color.Success : Color.Error)"
                                 Variant="Variant.Outlined">
                            @FormatConnectivityMessage(_lastConnectivityResult)
                        </MudChip>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(entry.Content))
            {
                <MudExpansionPanels Elevation="0" Dense="true">
                    <MudExpansionPanel Text="@L["Capabilities:Content"]" Icon="@Icons.Material.Filled.Article">
                        <pre class="content-block">@entry.Content</pre>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }

            <MudText Typo="Typo.h6" Class="section-title">@L["Capabilities:Sections:Tools"]</MudText>
            @if (entry.Tools.Count == 0)
            {
                <MudAlert Severity="Severity.Info">@L["Capabilities:NoTools"]</MudAlert>
            }
            else
            {
                <MudTable T="AgentCapabilityToolInfo" Items="@entry.Tools" Dense="true" Hover="true" Elevation="0" Class="tool-table">
                    <HeaderContent>
                        <MudTh>@L["Capabilities:Tool:Name"]</MudTh>
                        <MudTh>@L["Capabilities:Tool:Description"]</MudTh>
                        <MudTh>@L["Capabilities:Tool:Parameters"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["Capabilities:Tool:Name"]">
                            <MudText Typo="Typo.body2">@context.Name</MudText>
                        </MudTd>
                        <MudTd DataLabel="@L["Capabilities:Tool:Description"]">
                            <MudText Typo="Typo.body2">@context.Description</MudText>
                        </MudTd>
                        <MudTd DataLabel="@L["Capabilities:Tool:Parameters"]">
                            @if (context.Parameters.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Capabilities:Tool:NoParameters"]</MudText>
                            }
                            else
                            {
                                <div class="parameter-list">
                                    @foreach (var parameter in context.Parameters)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @parameter.Name: @parameter.Type@(parameter.IsRequired ? " *" : "")
                                        </MudChip>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(context.ParametersSchemaJson))
                            {
                                <MudExpansionPanels Elevation="0" Dense="true" Class="schema-panel">
                                    <MudExpansionPanel Text="@L["Capabilities:Tool:Schema"]" Icon="@Icons.Material.Filled.DataObject">
                                        <pre class="schema-block">@context.ParametersSchemaJson</pre>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            @if (entry.Resources.Count > 0)
            {
                <MudText Typo="Typo.h6" Class="section-title">@L["Capabilities:Sections:Resources"]</MudText>
                <div class="resource-list">
                    @foreach (var resource in entry.Resources)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @resource.Name
                        </MudChip>
                    }
                </div>
            }
        </div>;
    }

    private RenderFragment RenderIssueList(IReadOnlyList<string> issues)
    {
        return @<MudAlert Severity="Severity.Warning" Dense="true" Class="skill-source-issues">
            <ul>
                @foreach (var issue in issues)
                {
                    <li>@issue</li>
                }
            </ul>
        </MudAlert>;
    }

    private int GetLoadedFileSkillCount()
    {
        return _management?.FileSkillSources.Sum(static source => source.LoadedSkillCount) ?? 0;
    }

    private string GetFileSkillSourceTitle(AgentCapabilityFileSkillSourceStatusInfo source)
    {
        var firstPath = source.ConfiguredPaths.FirstOrDefault() ?? L["Capabilities:Skill:Sources:UnknownPath"];
        return source.ConfiguredPaths.Count <= 1
            ? firstPath
            : L["Capabilities:Skill:Sources:PathGroup", firstPath, source.ConfiguredPaths.Count - 1];
    }

    private void SetActiveTab(int index)
    {
        _activeTabIndex = index;
        _lastConnectivityResult = null;
        EnsureSelectedEntry();
    }

    private void SetQuery(string value)
    {
        _query = value;
    }

    private IReadOnlyList<AgentCapabilityEntryInfo> FilterEntries(IReadOnlyList<AgentCapabilityEntryInfo> entries)
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            return entries;
        }

        var query = _query.Trim();
        return entries
            .Where(entry =>
                entry.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                || entry.Description.Contains(query, StringComparison.OrdinalIgnoreCase)
                || entry.Tools.Any(tool => tool.Name.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private void SelectEntry(AgentCapabilityEntryInfo entry)
    {
        _selectedEntry = entry;
        _lastConnectivityResult = null;
    }

    private void EnsureSelectedEntry()
    {
        var entries = CurrentEntries;
        if (entries.Count == 0)
        {
            _selectedEntry = null;
            return;
        }

        if (_selectedEntry is not null
            && entries.Any(entry => entry.Key == _selectedEntry.Key))
        {
            _selectedEntry = entries.First(entry => entry.Key == _selectedEntry.Key);
            return;
        }

        _selectedEntry = entries[0];
    }

    private async Task SetCatalogEnabledAsync(AgentCapabilityKind kind, bool enabled)
    {
        var result = await CapabilityFacade.SetCatalogEnabledAsync(kind, enabled);
        await ApplyManagementResultAsync(result);
    }

    private async Task SetEntryEnabledAsync(AgentCapabilityEntryInfo entry, bool enabled)
    {
        var result = await CapabilityFacade.SetEntryEnabledAsync(entry.Kind, entry.Name, enabled);
        await ApplyManagementResultAsync(result);
    }

    private async Task SetSkillMcpServerEnabledAsync(AgentCapabilityEntryInfo entry, bool enabled)
    {
        var result = await CapabilityFacade.SetSkillMcpServerEnabledAsync(entry.Name, enabled);
        await ApplyManagementResultAsync(result);
    }

    private async Task ShowAddMcpProfileDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<ExternalMcpProfileDialog>(
            L["Capabilities:Mcp:Dialog:AddTitle"],
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var dialogResult = await dialog.Result;
        if (dialogResult is not { Canceled: false, Data: ExternalMcpClientProfile profile })
        {
            return;
        }

        var result = await CapabilityFacade.SaveExternalMcpProfileAsync(profile);
        if (result.IsFailed(out var error, out var management))
        {
            AddErrorSnackbar(error.Message);
            return;
        }

        _management = management;
        SelectEntryByName(profile.Name);
        Snackbar.Add(L["Common:Success"], Severity.Success);
    }

    private async Task ShowEditMcpProfileDialogAsync(AgentCapabilityEntryInfo entry)
    {
        if (entry.McpExternalProfile is null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(ExternalMcpProfileDialog.Profile), entry.McpExternalProfile },
            { nameof(ExternalMcpProfileDialog.IsEdit), true },
            { nameof(ExternalMcpProfileDialog.SubmitText), L["Common:Actions:Save"].Value }
        };

        var dialog = await DialogService.ShowAsync<ExternalMcpProfileDialog>(
            L["Capabilities:Mcp:Dialog:EditTitle"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var dialogResult = await dialog.Result;
        if (dialogResult is not { Canceled: false, Data: ExternalMcpClientProfile profile })
        {
            return;
        }

        var result = await CapabilityFacade.SaveExternalMcpProfileAsync(profile);
        if (result.IsFailed(out var error, out var management))
        {
            AddErrorSnackbar(error.Message);
            return;
        }

        _management = management;
        SelectEntryByName(profile.Name);
        Snackbar.Add(L["Common:Success"], Severity.Success);
    }

    private async Task DeleteMcpProfileAsync(AgentCapabilityEntryInfo entry)
    {
        if (!entry.IsUserManaged)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["Common:Confirm"],
            L["Capabilities:Mcp:DeleteConfirm", entry.Name],
            yesText: L["Common:Delete"],
            cancelText: L["Common:Cancel"]);

        if (confirmed != true)
        {
            return;
        }

        var result = await CapabilityFacade.DeleteExternalMcpProfileAsync(entry.Name);
        if (result.IsFailed(out var error, out var management))
        {
            AddErrorSnackbar(error.Message);
            return;
        }

        _management = management;
        EnsureSelectedEntry();
        Snackbar.Add(L["Common:Success"], Severity.Success);
    }

    private async Task ApplyManagementResultAsync(Core.Results.Res<AgentCapabilityManagementInfo> result)
    {
        if (result.IsFailed(out var error, out var management))
        {
            AddErrorSnackbar(error.Message);
            return;
        }

        _management = management;
        EnsureSelectedEntry();
        await InvokeAsync(StateHasChanged);
    }

    private void SelectEntryByName(string name)
    {
        _selectedEntry = CurrentEntries.FirstOrDefault(entry =>
            string.Equals(entry.Name, name, StringComparison.OrdinalIgnoreCase));
        EnsureSelectedEntry();
    }

    private async Task TestMcpAsync(AgentCapabilityEntryInfo entry)
    {
        if (_isTestingMcp)
        {
            return;
        }

        _isTestingMcp = true;
        _lastConnectivityResult = null;
        StateHasChanged();

        var result = await CapabilityFacade.TestMcpConnectivityAsync(entry.Name);
        if (result.IsFailed(out var error, out var connectivity))
        {
            AddErrorSnackbar(error.Message);
        }
        else
        {
            _lastConnectivityResult = connectivity;
            Snackbar.Add(FormatConnectivityMessage(connectivity), connectivity.Success ? Severity.Success : Severity.Error);
        }

        _isTestingMcp = false;
        StateHasChanged();
    }

    private string GetEntryButtonClass(AgentCapabilityEntryInfo entry)
    {
        var selected = entry.Key == _selectedEntry?.Key ? " selected" : "";
        var disabled = entry.IsEnabled ? "" : " disabled";
        return $"entry-button{selected}{disabled}";
    }

    private static string GetEntryIcon(AgentCapabilityEntryInfo entry)
    {
        return entry.Kind == AgentCapabilityKind.Skill
            ? Icons.Material.Filled.AutoAwesome
            : Icons.Material.Filled.AccountTree;
    }

    private static Color GetKindColor(AgentCapabilityKind kind)
    {
        return kind == AgentCapabilityKind.Skill ? Color.Primary : Color.Secondary;
    }

    private static Color GetStatusColor(AgentCapabilityEntryInfo entry)
    {
        return entry.IsEnabled ? Color.Success : Color.Warning;
    }

    private string GetStatusText(AgentCapabilityEntryInfo entry)
    {
        return entry.IsEnabled ? L["Capabilities:Status:Enabled"] : L["Capabilities:Status:Disabled"];
    }

    private string FormatDisabledReason(string disabledReason)
    {
        if (SkillCapabilityMessageCode.DisabledReason.TryParseRequiredModulesMissing(disabledReason, out var missingModules))
        {
            return L["Capabilities:Skill:DisabledReason:RequiredModulesMissing", missingModules];
        }

        return disabledReason switch
        {
            SkillCapabilityMessageCode.DisabledReason.ImplementationDisabled => L["Capabilities:Skill:DisabledReason:ImplementationDisabled"],
            SkillCapabilityMessageCode.DisabledReason.ReadOnlyFileAccessNoRoots => L["Capabilities:Skill:DisabledReason:ReadOnlyFileAccessNoRoots"],
            SkillCapabilityMessageCode.DisabledReason.CatalogDisabled => L["Capabilities:Skill:DisabledReason:CatalogDisabled"],
            SkillCapabilityMessageCode.DisabledReason.EntryDisabled => L["Capabilities:Skill:DisabledReason:EntryDisabled"],
            McpCapabilityMessageCode.DisabledReason.SkillMcpExposureDisabled => L["Capabilities:Mcp:DisabledReason:SkillMcpExposureDisabled"],
            McpCapabilityMessageCode.DisabledReason.SkillServerNotAgentTool => L["Capabilities:Mcp:DisabledReason:SkillServerNotAgentTool"],
            McpCapabilityMessageCode.DisabledReason.NotAgentTool => L["Capabilities:Mcp:DisabledReason:NotAgentTool"],
            McpCapabilityMessageCode.DisabledReason.CatalogDisabled => L["Capabilities:Mcp:DisabledReason:CatalogDisabled"],
            McpCapabilityMessageCode.DisabledReason.EntryDisabled => L["Capabilities:Mcp:DisabledReason:EntryDisabled"],
            _ => disabledReason
        };
    }

    private string FormatConnectivityMessage(McpConnectivityTestResult result)
    {
        return result.Message switch
        {
            McpCapabilityMessageCode.Connectivity.ConnectedToEndpoint => L["Capabilities:Mcp:Connectivity:ConnectedToEndpoint", result.ToolCount],
            McpCapabilityMessageCode.Connectivity.ConnectedAndListedTools => L["Capabilities:Mcp:Connectivity:ConnectedAndListedTools", result.ToolCount],
            McpCapabilityMessageCode.Connectivity.LocalHttpDisplayUrlMissing => L["Capabilities:Mcp:Connectivity:LocalHttpDisplayUrlMissing", result.ToolCount],
            McpCapabilityMessageCode.Connectivity.LocalStdioInProcessReady => L["Capabilities:Mcp:Connectivity:LocalStdioInProcessReady", result.ToolCount],
            _ => result.Message
        };
    }

    private string GetMcpSourceKindText(McpCatalogSourceKind sourceKind)
    {
        return sourceKind switch
        {
            McpCatalogSourceKind.LocalServer => L["Capabilities:Mcp:Source:LocalServer"],
            McpCatalogSourceKind.SkillServer => L["Capabilities:Mcp:Source:SkillServer"],
            McpCatalogSourceKind.ExternalClient => L["Capabilities:Mcp:Source:ExternalClient"],
            _ => sourceKind.ToString()
        };
    }

    private bool CanCopyMcpConfig(AgentCapabilityEntryInfo entry)
    {
        return entry.McpExternalProfile is not null
               || !string.IsNullOrWhiteSpace(entry.McpDisplayUrl)
               || !string.IsNullOrWhiteSpace(entry.McpEndpointPath);
    }

    private string GetCopyMcpConfigTooltip(AgentCapabilityEntryInfo entry)
    {
        return CanCopyMcpConfig(entry)
            ? L["Capabilities:Mcp:CopyConfigTooltip"]
            : L["Capabilities:Mcp:CopyConfigUnavailable"];
    }

    private async Task CopyMcpConfigAsync(AgentCapabilityEntryInfo entry)
    {
        if (!CanCopyMcpConfig(entry))
        {
            return;
        }

        var endpoint = entry.McpExternalProfile?.Endpoint
                       ?? entry.McpDisplayUrl
                       ?? entry.McpEndpointPath
                       ?? string.Empty;
        var server = new Dictionary<string, object?>
        {
            ["type"] = "http",
            ["url"] = endpoint
        };

        if (entry.McpExternalProfile?.Headers.Count > 0)
        {
            server["headers"] = entry.McpExternalProfile.Headers;
        }

        var payload = new Dictionary<string, object?>
        {
            ["mcpServers"] = new Dictionary<string, object?>
            {
                [entry.Name] = server
            }
        };

        var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        var copied = await JSRuntime.InvokeAsync<bool>("MoClipboard.copyText", json);
        Snackbar.Add(
            copied ? L["Capabilities:Mcp:CopyConfigSuccess"] : L["Capabilities:Mcp:CopyConfigFailed"],
            copied ? Severity.Success : Severity.Error);
    }

    private void AddErrorSnackbar(string? message)
    {
        Snackbar.Add(string.IsNullOrWhiteSpace(message) ? L["Error:Generic"] : message, Severity.Error);
    }
}
