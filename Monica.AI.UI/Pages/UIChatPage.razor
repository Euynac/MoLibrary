@page "/ai-chat"
@rendermode InteractiveServer
@using Monica.AI.UI.Localization
@using Monica.Core.Results;
@using Microsoft.Extensions.Localization
@using Monica.AI.Facades
@using Monica.AI.Models
@using Monica.AI.RAG.Facades
@using Monica.AI.UI.UIChat.Models
@using Monica.AI.UI.UIChat.State
@using Monica.AI.UI.UIChat.Support
@using Monica.UI.Shell.Support
@using Monica.Modules
@implements IDisposable
@inject ChatFacade ChatService
@inject ChatSessionCoordinator StateManager
@inject ChatSessionStore SessionStorage
@inject ProviderFacade ProviderUIService
@inject IOptions<ModuleAIUIOption> Options
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject RAGFacade RagFacade
@inject IStringLocalizer<AIResource> L
@inject IBrowserStorage BrowserStorage

<HeadContent>
    <link href="_content/Monica.AI.UI/css/ai-chat-page.css" rel="stylesheet" />
</HeadContent>

<div class="ai-chat-shell">
    @if (_options.ShowSessionList)
    {
        <aside class="ai-sidebar">
            <SessionList
                Sessions="@_sessionStorage.Sessions"
                CurrentSessionId="@_sessionStorage.CurrentSessionId"
                OnNewSession="@HandleNewSession"
                OnSelectSession="@HandleSelectSession"
                OnDeleteSession="@HandleDeleteSession" />
        </aside>
    }

    <main class="ai-main">
        <header class="ai-topbar">
            <div class="topbar-left">
                @if (_options.ShowProviderSelector)
                {
                    <ProviderSelector
                        Providers="@_state.Providers"
                        SelectedProviderId="@_state.CurrentProviderId"
                        SelectedModelName="@_state.CurrentModelName"
                        SelectedProviderIdChanged="@HandleProviderChanged" />
                }
            </div>
            <div class="topbar-right">
                <MudTooltip Text="@(_state.ToolDebugEnabled
                                      ? L["Chat:ToolCalls:DisableDebug"]
                                      : L["Chat:ToolCalls:EnableDebug"])">
                    <MudIconButton Icon="@Icons.Material.Filled.BugReport"
                                   Class="@($"tool-debug-button {(_state.ToolDebugEnabled ? "active" : "")}")"
                                   OnClick="ToggleToolDebugAsync" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Class="settings-button"
                               OnClick="OpenPromptSettingsAsync" />
            </div>
        </header>

        <ChatContainer Parameters="@BuildChatContainerParameters()" />
    </main>
</div>

@code {
    public const string PAGE_URL = "/ai-chat";

    private ModuleAIUIOption _options = null!;
    private ChatSessionStore _sessionStorage = null!;
    private ChatPageState _state = null!;

    protected override void OnInitialized()
    {
        _options = Options.Value;
        _sessionStorage = SessionStorage;
        _state = new ChatPageState
        {
            Providers = ChatProviderResolver.GetChatProviders(ChatService.GetProviders())
        };

        InitializeDefaultProvider();
        InitializeRAG();
        SubscribeToEvents();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPersistedPreferences();
            await LoadKnowledgeBases();
            await EnsureSessionExists();
            UpdateCurrentSession();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void InitializeDefaultProvider()
    {
        var defaultProvider = ChatProviderResolver.GetPreferredChatProvider(
            _state.Providers,
            ChatService.GetDefaultProvider()?.ProviderId);
        if (defaultProvider == null)
        {
            _state.DefaultProviderId = null;
            _state.DefaultModelName = null;
            _state.CurrentProviderName = string.Empty;
            _state.CurrentProviderModels = [];
            _state.SupportsReasoning = false;
            HandlePageError(L["Provider:NoChatProvider"], showSnackbar: false);
            return;
        }

        _state.ClearError();
        _state.DefaultProviderId = defaultProvider.ProviderId;
        _state.DefaultModelName = ChatProviderResolver.GetPreferredChatModel(defaultProvider, defaultProvider.DefaultModel);
        _state.CurrentProviderName = defaultProvider.DisplayName;
        _state.CurrentProviderModels = ChatProviderResolver.GetChatModels(defaultProvider);
        _state.SupportsReasoning = ChatProviderResolver.GetReasoningSupport(
            _state.Providers, defaultProvider.ProviderId, _state.DefaultModelName);
    }

    private void InitializeRAG()
    {
        _state.SelectedKnowledgeBaseIds = new List<string>(_options.DefaultKnowledgeBaseIds);
    }

    private void SubscribeToEvents()
    {
        _sessionStorage.CurrentSessionChanged += OnCurrentSessionChanged;
        _sessionStorage.SessionsChanged += OnSessionsChanged;
    }

    private async Task LoadPersistedPreferences()
    {
        var savedProviderId = await BrowserStorage.GetDefaultProviderAsync();
        var savedModelName = await BrowserStorage.GetDefaultModelAsync();
        _state.ToolDebugEnabled = await BrowserStorage.GetToolDebugEnabledAsync();

        if (!string.IsNullOrEmpty(savedProviderId))
        {
            var provider = ChatProviderResolver.FindProvider(_state.Providers, savedProviderId);
            if (provider != null)
            {
                ApplyProviderSelection(provider, savedModelName);
            }
            else
            {
                await ClearInvalidPreferences();
            }
        }
    }

    private void ApplyProviderSelection(AIProviderInfo provider, string? savedModelName)
    {
        _state.DefaultProviderId = provider.ProviderId;
        _state.CurrentProviderName = provider.DisplayName;
        _state.CurrentProviderModels = ChatProviderResolver.GetChatModels(provider);

        if (ChatProviderResolver.IsChatModelValid(provider, savedModelName))
        {
            _state.DefaultModelName = savedModelName;
        }
        else
        {
            _state.DefaultModelName = ChatProviderResolver.GetPreferredChatModel(provider, provider.DefaultModel);
            if (!string.IsNullOrEmpty(savedModelName))
            {
                _ = BrowserStorage.RemoveAsync("ai-chat:default-model");
            }
        }

        _state.SupportsReasoning = ChatProviderResolver.GetReasoningSupport(
            _state.Providers, _state.DefaultProviderId, _state.DefaultModelName);
    }

    private async Task ClearInvalidPreferences()
    {
        await BrowserStorage.RemoveAsync("ai-chat:default-provider");
        await BrowserStorage.RemoveAsync("ai-chat:default-model");
    }

    private async Task LoadKnowledgeBases()
    {
        if (_options.ShowKnowledgeBaseSelector)
        {
            var knowledgeBaseResult = await RagFacade.GetKnowledgeBasesAsync();
            if (knowledgeBaseResult.IsFailed(out var error, out var knowledgeBases))
            {
                HandlePageError(error.Message ?? L["Error:Generic"], showSnackbar: false);
                _state.KnowledgeBases = [];
                return;
            }

            _state.KnowledgeBases = knowledgeBases;
        }
    }

    private async Task EnsureSessionExists()
    {
        if (_sessionStorage.Sessions.Count == 0)
        {
            _ = await TryCreateSessionAsync();
        }
        else
        {
            _sessionStorage.CurrentSessionId = _sessionStorage.Sessions.First().SessionId;
        }
    }

    private void OnCurrentSessionChanged()
    {
        UpdateCurrentSession();
        InvokeAsync(StateHasChanged);
    }

    private void OnSessionsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentSession()
    {
        var currentSession = _sessionStorage.GetSession(_sessionStorage.CurrentSessionId ?? string.Empty);
        _state.CurrentSession = currentSession;

        // Update UI-specific provider info if session has provider
        if (currentSession != null)
        {
            var provider = ChatProviderResolver.FindProvider(_state.Providers, currentSession.ProviderId);
            if (provider != null)
            {
                _state.CurrentProviderName = provider.DisplayName;
                _state.CurrentProviderModels = ChatProviderResolver.GetChatModels(provider);
            }
        }
    }

    // Provider/Model handlers
    private async Task HandleProviderChanged(string providerId)
    {
        var provider = ChatProviderResolver.FindProvider(_state.Providers, providerId);
        if (provider == null) return;

        var resolvedModelName = ChatProviderResolver.GetPreferredChatModel(provider, provider.DefaultModel);

        _state.DefaultProviderId = providerId;
        _state.DefaultModelName = resolvedModelName;
        _state.CurrentProviderName = provider.DisplayName;
        _state.CurrentProviderModels = ChatProviderResolver.GetChatModels(provider);
        _state.SupportsReasoning = ChatProviderResolver.GetReasoningSupport(
            _state.Providers, providerId, resolvedModelName);

        await BrowserStorage.SaveDefaultProviderAsync(providerId);
        if (!string.IsNullOrEmpty(resolvedModelName))
        {
            await BrowserStorage.SaveDefaultModelAsync(resolvedModelName);
        }
        else
        {
            await BrowserStorage.RemoveAsync("ai-chat:default-model");
        }

        var currentSession = _sessionStorage.GetSession(_sessionStorage.CurrentSessionId ?? string.Empty);
        if (currentSession != null)
        {
            currentSession.ProviderId = providerId;
            currentSession.ModelName = resolvedModelName;
        }

        StateHasChanged();
    }

    private async Task HandleModelChanged(string modelName)
    {
        _state.DefaultModelName = modelName;
        await BrowserStorage.SaveDefaultModelAsync(modelName);

        var currentSession = _sessionStorage.GetSession(_sessionStorage.CurrentSessionId ?? string.Empty);
        if (currentSession != null)
        {
            currentSession.ModelName = modelName;
        }

        _state.SupportsReasoning = ChatProviderResolver.GetReasoningSupport(
            _state.Providers, _state.CurrentProviderId, modelName);

        StateHasChanged();
    }

    // Session handlers
    private async Task HandleNewSession()
    {
        _state.ClearError();
        _ = await TryCreateSessionAsync();
        UpdateCurrentSession();
    }

    private void HandleSelectSession(string sessionId)
    {
        _state.ClearError();
        _sessionStorage.CurrentSessionId = sessionId;
    }

    private async Task HandleDeleteSession(string sessionId)
    {
        var deletingCurrentSession = string.Equals(
            sessionId,
            _sessionStorage.CurrentSessionId,
            StringComparison.Ordinal);
        _sessionStorage.RemoveSession(sessionId);

        if (deletingCurrentSession)
        {
            if (_sessionStorage.Sessions.Count == 0)
            {
                _ = await TryCreateSessionAsync();
            }
            else
            {
                _sessionStorage.CurrentSessionId = _sessionStorage.Sessions.First().SessionId;
            }
        }

        UpdateCurrentSession();
    }

    // Message handlers
    private async Task HandleSendMessage(string message)
    {
        if (string.IsNullOrWhiteSpace(message) || _state.IsSending) return;

        _state.ClearError();
        _state.LastMessage = message;

        var sessionId = await EnsureCurrentSession();
        if (string.IsNullOrWhiteSpace(sessionId))
        {
            return;
        }

        var resolvedSessionId = sessionId!;
        AddUserMessageAndUpdateTitle(resolvedSessionId, message);
        StateManager.UpdateReasoning(resolvedSessionId, _state.ReasoningEnabled);

        await SendMessageAsync(resolvedSessionId, message);
    }

    private async Task<string?> EnsureCurrentSession()
    {
        var sessionId = _sessionStorage.CurrentSessionId;
        if (string.IsNullOrEmpty(sessionId))
        {
            var session = await TryCreateSessionAsync();
            if (session == null)
            {
                return null;
            }

            sessionId = session.SessionId;
        }
        return sessionId;
    }

    private async Task<ChatSession?> TryCreateSessionAsync()
    {
        if (string.IsNullOrWhiteSpace(_state.CurrentProviderId))
        {
            HandlePageError(L["Provider:NoChatProvider"]);
            return null;
        }

        var createResult = await ChatService.CreateSessionAsync(
            _state.CurrentProviderId,
            _state.CurrentModelName,
            knowledgeBaseIds: ChatProviderResolver.GetKnowledgeBaseIds(_state.SelectedKnowledgeBaseIds));

        if (createResult.IsFailed(out var error, out var state))
        {
            HandlePageError(error.Message ?? L["Error:Generic"]);
            return null;
        }

        _sessionStorage.AddSession(state);
        _sessionStorage.CurrentSessionId = state.SessionId;
        _state.ClearError();
        return state;
    }

    private void HandlePageError(string message, bool canRetry = false, bool showSnackbar = true)
    {
        _state.IsSending = false;
        _state.StreamingContent = null;
        _state.SetError(message, canRetry);

        if (showSnackbar)
        {
            Snackbar.Add(message, Severity.Error);
        }

        StateHasChanged();
    }

    private void AddUserMessageAndUpdateTitle(string sessionId, string message)
    {
        StateManager.AddUserMessage(sessionId, message);
        var currentSession = _sessionStorage.GetSession(sessionId);
        if (currentSession != null && currentSession.Messages.Count == 1)
        {
            var title = ChatProviderResolver.GenerateSessionTitle(message);
            StateManager.UpdateTitle(sessionId, title);
        }
    }

    private async Task SendMessageAsync(string sessionId, string message)
    {
        _state.IsSending = true;
        _state.SetupCancellationToken(_options.RequestTimeoutMs);
        StateHasChanged();

        try
        {
            var session = _sessionStorage.GetSession(sessionId);
            if (session is null)
            {
                HandlePageError(L["Error:Generic"]);
                return;
            }

            _state.StreamingContent = ChatService.SendMessageStreamingAsync(
                session, message, _state.CancellationToken);
            UpdateCurrentSession();
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            HandleSendError(L["Error:RequestCancelled"]);
        }
        catch (HttpRequestException ex)
        {
            HandleSendError($"{L["Error:NetworkError"]}: {ex.Message}");
        }
        catch (Exception ex)
        {
            HandleSendError($"{L["Error:Generic"]}: {ex.Message}");
        }
    }

    private void HandleSendError(string error)
    {
        _state.IsSending = false;
        _state.StreamingContent = null;
        _state.SetError(error, canRetry: true);
        Snackbar.Add(error, Severity.Error);
        StateHasChanged();
    }

    private void HandleStreamComplete(string content)
    {
        _state.IsSending = false;
        _state.StreamingContent = null;
        _state.CancellationTokenSource?.Dispose();
        _state.CancellationTokenSource = null;
        UpdateCurrentSession();
        StateHasChanged();
    }

    private void HandleStreamError(string error)
    {
        _state.IsSending = false;
        _state.StreamingContent = null;
        _state.SetError(error, canRetry: true);
        Snackbar.Add(error, Severity.Error);
        StateHasChanged();
    }

    private async Task HandleCancel()
    {
        if (_state.CancellationTokenSource != null && !_state.CancellationTokenSource.IsCancellationRequested)
        {
            await _state.CancellationTokenSource.CancelAsync();
            Snackbar.Add(L["Chat:Status:GenerationStopped"], Severity.Info);
        }

        _state.IsSending = false;
        _state.StreamingContent = null;
        StateHasChanged();
    }

    private async Task HandleRetry()
    {
        if (!string.IsNullOrEmpty(_state.LastMessage))
        {
            _state.ClearError();
            await HandleSendMessage(_state.LastMessage);
        }
    }

    private void HandleEditMessage((AIChatMessage Message, string NewContent) args)
    {
        if (string.IsNullOrWhiteSpace(args.NewContent) || _state.IsSending) return;

        _state.ClearError();
        _state.LastMessage = args.NewContent;
        _state.IsSending = true;
        _state.SetupCancellationToken(_options.RequestTimeoutMs);

        StateManager.UpdateReasoning(_sessionStorage.CurrentSessionId!, _state.ReasoningEnabled);
        var session = _sessionStorage.GetSession(_sessionStorage.CurrentSessionId!);
        if (session is null)
        {
            HandlePageError(L["Error:Generic"]);
            return;
        }

        _state.StreamingContent = ChatService.EditMessageAsync(
            session,
            args.Message.Id,
            args.NewContent,
            _state.CancellationToken);

        UpdateCurrentSession();
        StateHasChanged();
    }

    private void HandleRetryMessage(AIChatMessage message)
    {
        if (_state.IsSending) return;

        _state.ClearError();
        _state.IsSending = true;
        _state.SetupCancellationToken(_options.RequestTimeoutMs);

        StateManager.UpdateReasoning(_sessionStorage.CurrentSessionId!, _state.ReasoningEnabled);
        var session = _sessionStorage.GetSession(_sessionStorage.CurrentSessionId!);
        if (session is null)
        {
            HandlePageError(L["Error:Generic"]);
            return;
        }

        _state.StreamingContent = ChatService.RetryMessageAsync(
            session,
            message.Id,
            _state.CancellationToken);

        UpdateCurrentSession();
        StateHasChanged();
    }

    private void HandleErrorDismissed()
    {
        _state.ClearError();
    }

    // Settings and feature handlers
    private async Task OpenPromptSettingsAsync()
    {
        var provider = ChatProviderResolver.FindProvider(_state.Providers, _state.CurrentProviderId)
                       ?? _state.Providers.FirstOrDefault();
        if (provider == null)
        {
            Snackbar.Add(L["Provider:NotFound"], Severity.Warning);
            return;
        }

        var session = _sessionStorage.GetSession(_sessionStorage.CurrentSessionId ?? string.Empty);
        var hasStarted = session?.Messages.Count > 0;
        var currentPrompt = hasStarted ? session?.SystemPrompt : provider.SystemPrompt;

        var parameters = new DialogParameters
        {
            [nameof(ProviderSystemPromptDialog.ProviderName)] = provider.DisplayName,
            [nameof(ProviderSystemPromptDialog.SystemPrompt)] = currentPrompt,
            [nameof(ProviderSystemPromptDialog.IsReadOnly)] = hasStarted
        };

        var dialog = await DialogService.ShowAsync<ProviderSystemPromptDialog>(
            L["Provider:Settings:SystemPrompt"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is not { Canceled: false } || hasStarted) return;

        var prompt = result.Data as string;
        var updateResult = ProviderUIService.UpdateProviderSystemPrompt(provider.ProviderId, prompt);
        if (updateResult.IsFailed(out var error))
        {
            Snackbar.Add($"{L["Provider:Settings:UpdateFailed"]}: {error.Message}", Severity.Error);
            return;
        }

        if (session != null && session.Messages.Count == 0)
        {
            session.SystemPrompt = prompt;
        }

        _state.Providers = ChatProviderResolver.GetChatProviders(ChatService.GetProviders());
        Snackbar.Add(L["Provider:Settings:UpdateSuccess"], Severity.Success);
        StateHasChanged();
    }

    private void HandleReasoningEnabledChanged(bool enabled)
    {
        _state.ReasoningEnabled = enabled;
    }

    private void HandleKbSelectionChanged(List<string> selectedIds)
    {
        _state.SelectedKnowledgeBaseIds = selectedIds;

        var currentSession = _state.CurrentSession
            ?? _sessionStorage.GetSession(_sessionStorage.CurrentSessionId ?? string.Empty);

        if (currentSession is null)
        {
            return;
        }

        currentSession.ActiveKnowledgeBaseIds = ChatProviderResolver.GetKnowledgeBaseIds(selectedIds);
        UpdateCurrentSession();
    }

    private async Task ToggleToolDebugAsync()
    {
        _state.ToolDebugEnabled = !_state.ToolDebugEnabled;
        await BrowserStorage.SaveToolDebugEnabledAsync(_state.ToolDebugEnabled);
        StateHasChanged();
    }

    // Helper to build ChatContainer parameters
    private ChatContainerParameters BuildChatContainerParameters()
    {
        return new ChatContainerParameters
        {
            Messages = _state.CurrentMessages,
            StreamingContent = _state.StreamingContent,
            IsSending = _state.IsSending,
            ShowRetry = _state.CanRetry,
            ProviderName = _state.CurrentProviderName,
            ModelName = _state.CurrentModelName,
            ShowProviderInfo = !_options.ShowProviderSelector,
            AvailableModels = _state.CurrentProviderModels,
            ErrorMessage = _state.ErrorMessage,
            CancellationToken = _state.CancellationToken,
            EnableMarkdown = _options.EnableMarkdown,
            EnableAutoScroll = _options.EnableAutoScroll,
            SupportsReasoning = _state.SupportsReasoning,
            ReasoningEnabled = _state.ReasoningEnabled,
            ToolDebugEnabled = _state.ToolDebugEnabled,
            KnowledgeBases = _state.KnowledgeBases,
            SelectedKnowledgeBaseIds = _state.SelectedKnowledgeBaseIds,
            OnSendMessage = EventCallback.Factory.Create<string>(this, HandleSendMessage),
            OnStreamComplete = EventCallback.Factory.Create<string>(this, HandleStreamComplete),
            OnStreamError = EventCallback.Factory.Create<string>(this, HandleStreamError),
            OnCancel = EventCallback.Factory.Create(this, HandleCancel),
            OnRetry = EventCallback.Factory.Create(this, HandleRetry),
            OnErrorDismissed = EventCallback.Factory.Create(this, HandleErrorDismissed),
            OnEditMessage = EventCallback.Factory.Create<(AIChatMessage, string)>(this, HandleEditMessage),
            OnRetryMessage = EventCallback.Factory.Create<AIChatMessage>(this, HandleRetryMessage),
            OnModelChanged = EventCallback.Factory.Create<string>(this, HandleModelChanged),
            ReasoningEnabledChanged = EventCallback.Factory.Create<bool>(this, HandleReasoningEnabledChanged),
            SelectedKnowledgeBaseIdsChanged = EventCallback.Factory.Create<List<string>>(this, HandleKbSelectionChanged)
        };
    }

    public void Dispose()
    {
        _sessionStorage.CurrentSessionChanged -= OnCurrentSessionChanged;
        _sessionStorage.SessionsChanged -= OnSessionsChanged;
        _state?.Dispose();
    }
}
