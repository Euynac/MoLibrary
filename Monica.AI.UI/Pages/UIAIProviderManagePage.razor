@page "/ai-providers"
@using Monica.Tool.MoResponse
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@rendermode InteractiveServer
@inject AIProviderUIService ProviderUIService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<AIResource> L

<PageTitle>@L["ProviderManage:Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="ai-provider-page pa-4">
    <div class="page-header">
        <MudText Typo="Typo.h4">@L["ProviderManage:Title"]</MudText>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadProvidersAsync">
                @L["ProviderManage:Refresh"]
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlayCircle"
                       OnClick="TestAllAsync"
                       Disabled="@(!_providers.Any() || _isTestingAll)">
                @L["ProviderManage:TestAll"]
            </MudButton>
        </MudStack>
    </div>

    @if (_isLoading)
    {
        <div class="loading-area">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (!_providers.Any())
    {
        <MudAlert Severity="Severity.Info">@L["ProviderManage:NoProviders"]</MudAlert>
    }
    else
    {
        <MudGrid Class="provider-grid">
            @foreach (var provider in _providers)
            {
                var testState = GetTestState(provider.ProviderId);
                <MudItem xs="12" md="12" lg="6" xl="6" @key="provider.ProviderId">
                    <ProviderManageCard Provider="@provider"
                                        Models="@GetModels(provider)"
                                        IsTesting="@testState.IsRunning"
                                        TestSuccess="@testState.Success"
                                        TestMessage="@testState.Message"
                                        TestedAt="@testState.TestedAt"
                                        OnTest="TestProviderAsync"
                                        OnTestModel="TestModelAsync"
                                        OnProbeEmbedding="ProbeEmbeddingAsync"
                                        ModelTestingProvider="IsModelTesting"
                                        OnEditPrompt="OpenProviderPromptAsync"
                                        RemoteModels="@GetRemoteModels(provider.ProviderId)"
                                        IsFetchingRemoteModels="@IsFetchingRemoteModels(provider.ProviderId)"
                                        RemoteModelsFetchError="@GetRemoteModelsFetchError(provider.ProviderId)"
                                        OnFetchRemoteModels="FetchRemoteModelsAsync" />
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    public const string PAGE_URL = "/ai-providers";

    private IReadOnlyList<AIProviderInfo> _providers = [];
    private bool _isLoading;
    private bool _isTestingAll;
    private readonly Dictionary<string, ProviderTestState> _testStates = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _modelTesting = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, RemoteModelState> _remoteModelStates = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadProvidersAsync();
        }
    }

    private async Task LoadProvidersAsync()
    {
        _isLoading = true;
        StateHasChanged();

        await Task.Yield();
        try
        {
            _providers = ProviderUIService.GetProviders();
        }
        catch (Exception ex)
        {
            _providers = [];
            Snackbar.Add($"{L["ProviderManage:LoadFailed"]}: {ex.Message}", Severity.Error);
        }

        foreach (var provider in _providers)
        {
            _ = GetTestState(provider.ProviderId);
        }

        _isLoading = false;
        StateHasChanged();
    }

    private IReadOnlyList<AIModelInfo> GetModels(AIProviderInfo provider)
    {
        return provider.SupportedModels ?? [];
    }

    private ProviderTestState GetTestState(string providerId)
    {
        if (!_testStates.TryGetValue(providerId, out var state))
        {
            state = new ProviderTestState();
            _testStates[providerId] = state;
        }

        return state;
    }

    private bool IsModelTesting(string providerId, string modelName)
    {
        return _modelTesting.Contains(GetModelKey(providerId, modelName));
    }

    private async Task TestProviderAsync(string providerId)
    {
        var state = GetTestState(providerId);
        if (state.IsRunning)
        {
            return;
        }

        state.IsRunning = true;
        state.Message = null;
        state.Success = null;
        StateHasChanged();

        var result = await ProviderUIService.TestProviderAsync(providerId);
        if (result.IsFailed(out var error))
        {
            state.Success = false;
            state.Message = error.Message;
            Snackbar.Add($"{L["ProviderManage:TestFailed"]}: {error.Message}", Severity.Error);
        }
        else
        {
            state.Success = true;
            state.Message = L["ProviderManage:TestSuccess"];
            Snackbar.Add(L["ProviderManage:TestSuccessMessage"], Severity.Success);
        }

        state.TestedAt = DateTimeOffset.UtcNow;
        state.IsRunning = false;
        StateHasChanged();
    }

    private async Task TestAllAsync()
    {
        if (_isTestingAll)
        {
            return;
        }

        _isTestingAll = true;
        StateHasChanged();

        foreach (var provider in _providers)
        {
            await TestProviderAsync(provider.ProviderId);
        }

        _isTestingAll = false;
        StateHasChanged();
    }

    private async Task TestModelAsync((string ProviderId, AIModelInfo Model) request)
    {
        if (request.Model is not LLMModelInfo)
        {
            Snackbar.Add(L["ProviderManage:OnlyLLMSupported"], Severity.Info);
            return;
        }

        var key = GetModelKey(request.ProviderId, request.Model.ModelName);
        if (!_modelTesting.Add(key))
        {
            return;
        }

        StateHasChanged();

        var result = await ProviderUIService.TestModelAsync(request.ProviderId, request.Model.ModelName);
        if (result.IsFailed(out var error))
        {
            Snackbar.Add($"{L["ProviderManage:ModelTestFailed"]}: {error.Message}", Severity.Error);
        }
        else
        {
            Snackbar.Add(L["ProviderManage:ModelTestSuccess"], Severity.Success);
        }

        _modelTesting.Remove(key);
        StateHasChanged();
    }

    private async Task ProbeEmbeddingAsync((string ProviderId, AIModelInfo Model) request)
    {
        if (request.Model is not EmbeddingModelInfo)
        {
            Snackbar.Add("仅 Embedding 模型支持维度探测", Severity.Info);
            return;
        }

        var key = GetModelKey(request.ProviderId, request.Model.ModelName);
        if (!_modelTesting.Add(key)) return;

        StateHasChanged();

        var result = await ProviderUIService.ProbeEmbeddingDimensionsAsync(
            request.ProviderId, request.Model.ModelName);
        if (result.IsFailed(out var error))
        {
            Snackbar.Add($"{L["ProviderManage:DimensionDetectFailed"]}: {error.Message}", Severity.Error);
        }
        else
        {
            Snackbar.Add(L["ProviderManage:DimensionDetectSuccess", result.Data], Severity.Success);
        }

        _modelTesting.Remove(key);
        StateHasChanged();
    }

    private async Task OpenProviderPromptAsync(AIProviderInfo provider)
    {
        var parameters = new DialogParameters
        {
            [nameof(ProviderSystemPromptDialog.ProviderName)] = provider.DisplayName,
            [nameof(ProviderSystemPromptDialog.SystemPrompt)] = provider.SystemPrompt,
            [nameof(ProviderSystemPromptDialog.IsReadOnly)] = false
        };

        var dialog = await DialogService.ShowAsync<ProviderSystemPromptDialog>(
            L["Provider:Settings:SystemPrompt"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result.Canceled)
        {
            return;
        }

        var prompt = result.Data as string;
        var updateResult = ProviderUIService.UpdateProviderSystemPrompt(provider.ProviderId, prompt);
        if (updateResult.IsFailed(out var error))
        {
            Snackbar.Add($"{L["ProviderManage:UpdatePromptFailed"]}: {error.Message}", Severity.Error);
            return;
        }

        Snackbar.Add(L["Provider:Settings:UpdateSuccess"], Severity.Success);
        await LoadProvidersAsync();
    }

    private static string GetModelKey(string providerId, string modelName)
    {
        return $"{providerId}:{modelName}";
    }

    private sealed class ProviderTestState
    {
        public bool IsRunning { get; set; }
        public bool? Success { get; set; }
        public string? Message { get; set; }
        public DateTimeOffset? TestedAt { get; set; }
    }

    private IReadOnlyList<AIRemoteModelInfo>? GetRemoteModels(string providerId)
    {
        return _remoteModelStates.TryGetValue(providerId, out var state) ? state.Models : null;
    }

    private bool IsFetchingRemoteModels(string providerId)
    {
        return _remoteModelStates.TryGetValue(providerId, out var state) && state.IsFetching;
    }

    private string? GetRemoteModelsFetchError(string providerId)
    {
        return _remoteModelStates.TryGetValue(providerId, out var state) ? state.Error : null;
    }

    private async Task FetchRemoteModelsAsync(string providerId)
    {
        if (!_remoteModelStates.TryGetValue(providerId, out var state))
        {
            state = new RemoteModelState();
            _remoteModelStates[providerId] = state;
        }

        if (state.IsFetching) return;

        state.IsFetching = true;
        state.Error = null;
        StateHasChanged();

        var result = await ProviderUIService.FetchRemoteModelsAsync(providerId);
        if (result.IsFailed(out var error))
        {
            state.Error = error.Message;
            state.Models = null;
            Snackbar.Add($"{L["ProviderManage:GetRemoteModelsFailed"]}: {error.Message}", Severity.Warning);
        }
        else
        {
            state.Models = result.Data;
            state.Error = null;
            Snackbar.Add($"已获取 {result.Data?.Count ?? 0} 个远程模型", Severity.Success);
        }

        state.IsFetching = false;
        StateHasChanged();
    }

    private sealed class RemoteModelState
    {
        public bool IsFetching { get; set; }
        public IReadOnlyList<AIRemoteModelInfo>? Models { get; set; }
        public string? Error { get; set; }
    }
}
