@attribute [Route(PAGE_URL)]
@implements IDisposable
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIRAG.Components
@using Monica.AI.UI.UIRAG.State
@using Monica.UI.Localization
@inject IStringLocalizer<AIResource> L
@inject IStringLocalizer<SharedResource> Shared

<PageTitle>@L["RAG:Navigation:Manage"]</PageTitle>

<div class="rag-manage-page">
    <RAGManageKnowledgeBasePanel PageState="PageState" />

    <div class="kb-detail-panel">
        @if (PageState.IsInitialLoading)
        {
            <div class="detail-loading-state">
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="Color.Primary"
                         Class="loading-phase-chip">
                    @Shared["ModuleSystem:SystemOverview:States:Initializing"]
                </MudChip>
                <MudText Typo="Typo.h6" Class="loading-title">@L["RAG:Navigation:Manage"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="loading-phase-text">
                    @PageState.LoadingPhaseText
                </MudText>
                <MudProgressLinear Value="@PageState.LoadingProgressValue"
                                   Color="Color.Primary"
                                   Rounded="true"
                                   Class="loading-progress" />
            </div>
        }
        else if (PageState.SelectedKnowledgeBase is { } selectedKnowledgeBase)
        {
            @if (PageState.IsSelectionLoading)
            {
                <div class="detail-loading-state">
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Color="Color.Primary"
                             Class="loading-phase-chip">
                        @Shared["ModuleSystem:SystemOverview:States:Initializing"]
                    </MudChip>
                    <MudText Typo="Typo.h6" Class="loading-title">@selectedKnowledgeBase.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="loading-phase-text">
                        @PageState.LoadingPhaseText
                    </MudText>
                    <MudProgressLinear Value="@PageState.LoadingProgressValue"
                                       Color="Color.Primary"
                                       Rounded="true"
                                       Class="loading-progress" />
                </div>
            }
            else
            {
                <div class="detail-content">
                    <div class="embedding-model-section">
                        <EmbeddingModelSelector AvailableModels="@PageState.AvailableModels"
                                                SelectedModelKey="@PageState.CurrentEmbeddingModelKey"
                                                SelectedModelKeyChanged="@PageState.ChangeEmbeddingModelAsync" />

                        @if (PageState.AvailableModels.Count == 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="embedding-empty-warning">
                                @L["RAG:EmbeddingModel:NotConfigured"]
                            </MudAlert>
                        }
                    </div>

                    @if (RAGManagePageState.HasEmbeddingBinding(selectedKnowledgeBase)
                        && !string.IsNullOrWhiteSpace(PageState.CurrentEmbeddingModelKey)
                        && !string.Equals(
                            PageState.CurrentEmbeddingModelKey,
                            PageState.GetKnowledgeBaseModelKey(selectedKnowledgeBase),
                            StringComparison.OrdinalIgnoreCase))
                    {
                        <EmbeddingModelWarning CurrentModelId="@PageState.GetModelDisplayByKey(PageState.CurrentEmbeddingModelKey)"
                                               KnowledgeBaseModelId="@PageState.GetKnowledgeBaseModelDisplay(selectedKnowledgeBase)" />
                    }

                    <div class="kb-header">
                        <div class="kb-header-info">
                            <MudText Typo="Typo.h5">@selectedKnowledgeBase.Name</MudText>
                            @if (!string.IsNullOrEmpty(selectedKnowledgeBase.Description))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@selectedKnowledgeBase.Description</MudText>
                            }
                        </div>
                        <div class="kb-badges">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="Color.Default"
                                     Icon="@Icons.Material.Filled.Description">
                                @selectedKnowledgeBase.DocumentCount @L["RAG:KnowledgeBase:DocumentCount"]
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="Color.Default"
                                     Icon="@Icons.Material.Filled.GridView">
                                @selectedKnowledgeBase.ChunkCount @L["RAG:KnowledgeBase:ChunkCount"]
                            </MudChip>
                            @if (RAGManagePageState.HasEmbeddingBinding(selectedKnowledgeBase))
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Info"
                                         Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.Memory"
                                         Class="kb-header-model-chip">
                                    @selectedKnowledgeBase.EmbeddingModelName
                                </MudChip>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Secondary"
                                         Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.Hub"
                                         Class="kb-header-provider-chip">
                                    @PageState.GetProviderDisplayLabel(
                                        selectedKnowledgeBase.EmbeddingProviderId,
                                        selectedKnowledgeBase.EmbeddingModelName)
                                </MudChip>
                            }
                        </div>
                    </div>

                    @if (PageState.ShouldShowMissingVectorWarning)
                    {
                        <MudAlert Severity="Severity.Warning"
                                  Variant="Variant.Outlined"
                                  Class="vector-warning-alert">
                            <div class="vector-warning-content">
                                <div class="vector-warning-copy">
                                    <MudText Typo="Typo.subtitle2" Class="vector-warning-title">
                                        @L["RAG:VectorValidation:MissingVectors:Title"]
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="vector-warning-message">
                                        @PageState.GetMissingVectorWarningMessage()
                                    </MudText>
                                </div>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Refresh"
                                           Class="vector-warning-action"
                                           OnClick="@PageState.ReindexSelectedKnowledgeBaseAsync"
                                           Disabled="@(!PageState.CanReindexSelectedKnowledgeBase)">
                                    @L["RAG:VectorValidation:MissingVectors:Action"]
                                </MudButton>
                            </div>
                        </MudAlert>
                    }

                    <RAGManageDocumentQueueSection PageState="PageState" />
                    <RAGManageIndexingActions PageState="PageState" />
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <MudText Typo="Typo.h6" Color="Color.Secondary">
                    @L["RAG:KnowledgeBase:SelectPrompt"]
                </MudText>
            </div>
        }
    </div>
</div>
