@page "/ai/rag/manage"
@implements IDisposable
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.RAG.Models
@using Monica.AI.UI.Models
@using Monica.Tool.MoResponse
@inject IStringLocalizer<AIResource> L
@inject RAGUIService RAGService
@inject IEmbeddingModelManagementUIService EmbeddingService
@inject IAIProviderFactory ProviderFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@L["RAG:Navigation:Manage"]</PageTitle>

<div class="rag-manage-page">
    <div class="kb-list-panel">
        <div class="panel-header">
            <div class="panel-title-group">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" Class="panel-title-icon" />
                <MudText Typo="Typo.subtitle1" Class="panel-title">@L["RAG:KnowledgeBase:Title"]</MudText>
            </div>
        </div>

        <div class="panel-actions">
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@ShowCreateKBDialog">
                @L["Common:Create"]
            </MudButton>
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Edit"
                       Disabled="@(_selectedKB is null)"
                       OnClick="@ShowEditKBDialog">
                @L["Common:Edit"]
            </MudButton>
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="@(_selectedKB is null)"
                       OnClick="@DeleteSelectedKnowledgeBase">
                @L["Common:Delete"]
            </MudButton>
        </div>

        <div class="kb-list">
            @foreach (var kb in _knowledgeBases)
            {
                <div class="kb-card @(_selectedKB?.Id == kb.Id ? "selected" : "")"
                     @onclick="@(() => OnKBSelected(kb))">
                    <div class="kb-card-content">
                        <MudText Typo="Typo.body1" Class="kb-name">@kb.Name</MudText>
                        @if (!string.IsNullOrEmpty(kb.Description))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="kb-description">
                                @kb.Description
                            </MudText>
                        }
                        <MudText Typo="Typo.caption" Class="kb-stats">
                            @L["RAG:Debug:KBSidebar:Stats", kb.DocumentCount, kb.ChunkCount]
                        </MudText>
                        @if (HasEmbeddingBinding(kb))
                        {
                            <MudText Typo="Typo.caption" Class="kb-embedding-model">
                                @GetKnowledgeBaseModelDisplay(kb)
                            </MudText>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_knowledgeBases.Count == 0)
        {
            <div class="kb-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L["RAG:KnowledgeBase:EmptyHint"]
                </MudText>
            </div>
        }
    </div>

    <div class="kb-detail-panel">
        @if (_selectedKB != null)
        {
            <div class="detail-content">
                <!-- Embedding Model Selector -->
                <div class="embedding-model-section">
                    <EmbeddingModelSelector AvailableModels="@_availableModels"
                                            SelectedModelKey="@_currentEmbeddingModelKey"
                                            SelectedModelKeyChanged="@OnEmbeddingModelChanged" />

                    @if (_availableModels.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="embedding-empty-warning">
                            @L["RAG:EmbeddingModel:NotConfigured"]
                        </MudAlert>
                    }
                </div>

                <!-- Embedding Model Warning -->
                @if (HasEmbeddingBinding(_selectedKB)
                    && !string.IsNullOrWhiteSpace(_currentEmbeddingModelKey)
                    && !string.Equals(_currentEmbeddingModelKey, GetKnowledgeBaseModelKey(_selectedKB), StringComparison.OrdinalIgnoreCase))
                {
                    <EmbeddingModelWarning CurrentModelId="@GetModelDisplayByKey(_currentEmbeddingModelKey)"
                                           KnowledgeBaseModelId="@GetKnowledgeBaseModelDisplay(_selectedKB)" />
                }

                <!-- KB Detail Header -->
                <div class="kb-header">
                    <div class="kb-header-info">
                        <MudText Typo="Typo.h5">@_selectedKB.Name</MudText>
                        @if (!string.IsNullOrEmpty(_selectedKB.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_selectedKB.Description</MudText>
                        }
                    </div>
                    <div class="kb-badges">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Color="Color.Default"
                                 Icon="@Icons.Material.Filled.Description">
                            @_selectedKB.DocumentCount @L["RAG:KnowledgeBase:DocumentCount"]
                        </MudChip>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Color="Color.Default"
                                 Icon="@Icons.Material.Filled.GridView">
                            @_selectedKB.ChunkCount @L["RAG:KnowledgeBase:ChunkCount"]
                        </MudChip>
                        @if (HasEmbeddingBinding(_selectedKB))
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Info"
                                     Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.Memory"
                                     Class="kb-header-model-chip">
                                @_selectedKB.EmbeddingModelName
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Secondary"
                                     Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.Hub"
                                     Class="kb-header-provider-chip">
                                @GetProviderDisplayLabel(_selectedKB.EmbeddingProviderId, _selectedKB.EmbeddingModelName)
                            </MudChip>
                        }
                    </div>
                </div>

                <!-- Document Queue Table -->
                <div class="document-queue-section">
                    <div class="queue-header">
                        <div class="queue-title-row">
                            <MudIcon Icon="@Icons.Material.Filled.QueuePlayNext" Size="Size.Small" Class="queue-title-icon" />
                            <div class="queue-title-copy">
                                <MudText Typo="Typo.subtitle1" Class="queue-title">@L["RAG:DocumentQueue:Title"]</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="queue-meta">
                                    @_documentQueue.Count @L["RAG:KnowledgeBase:DocumentCount"]
                                </MudText>
                            </div>
                        </div>
                        <div class="queue-controls">
                            <MudText Typo="Typo.caption" Class="parallel-label">
                                @L["RAG:ParallelIndexing:Label"]
                            </MudText>
                            <MudNumericField T="int"
                                             @bind-Value="@_parallelCount"
                                             Min="1"
                                             Max="10"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="parallel-input" />
                             <MudButton Variant="Variant.Filled"
                                        Color="Color.Primary"
                                        Size="Size.Small"
                                        StartIcon="@Icons.Material.Filled.PlayArrow"
                                        OnClick="@StartBatchIndexing"
                                        Class="queue-start-button"
                                        Disabled="@(!CanStartBatchIndexing())">
                                 @L["RAG:ParallelIndexing:Start"]
                             </MudButton>
                             <MudButton Variant="Variant.Outlined"
                                        Color="Color.Warning"
                                        Size="Size.Small"
                                        StartIcon="@Icons.Material.Filled.StopCircle"
                                        OnClick="@CancelBatchIndexing"
                                        Class="queue-cancel-button"
                                        Disabled="@(!CanCancelBatchIndexing())">
                                 @L["Common:Cancel"]
                             </MudButton>
                        </div>
                    </div>

                    <div class="queue-table-wrapper">
                        <MudTable T="DocumentQueueItem"
                                  Items="@_documentQueue"
                                  Dense="true"
                                  Hover="true"
                                  Class="document-queue-table">
                            <HeaderContent>
                                <MudTh>@L["RAG:DocumentQueue:Column:Name"]</MudTh>
                                <MudTh>@L["RAG:DocumentQueue:Column:Status"]</MudTh>
                                <MudTh>@L["RAG:DocumentQueue:Column:Chunks"]</MudTh>
                                <MudTh>@L["RAG:DocumentQueue:Column:Actions"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["RAG:DocumentQueue:Column:Name"]">@context.Name</MudTd>
                                <MudTd DataLabel="@L["RAG:DocumentQueue:Column:Status"]">
                                    @switch (context.Status)
                                    {
                                        case DocumentStatus.Pending:
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                                @L["RAG:DocumentQueue:Status:Pending"]
                                            </MudChip>
                                            break;
                                        case DocumentStatus.Indexing:
                                            <div class="indexing-status">
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                                    @L["RAG:DocumentQueue:Status:Indexing"]
                                                </MudChip>
                                                <MudProgressLinear Value="@context.Progress" Color="Color.Info" Size="Size.Small" />
                                            </div>
                                            break;
                                        case DocumentStatus.Done:
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                                @L["RAG:DocumentQueue:Status:Done"]
                                            </MudChip>
                                            break;
                                        case DocumentStatus.Error:
                                            <MudChip T="string" Size="Size.Small" Color="Color.Error" title="@context.ErrorMessage">
                                                @L["RAG:DocumentQueue:Status:Error"]
                                            </MudChip>
                                            break;
                                    }
                                </MudTd>
                                <MudTd DataLabel="@L["RAG:DocumentQueue:Column:Chunks"]">@context.ChunkCount</MudTd>
                                <MudTd DataLabel="@L["RAG:DocumentQueue:Column:Actions"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ShowChunkViewer(context))"
                                                   title="@L["RAG:DocumentQueue:Actions:ViewChunks"]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ReindexDocument(context))"
                                                   Disabled="@(context.Status == DocumentStatus.Indexing)"
                                                   title="@L["RAG:DocumentQueue:Actions:Reindex"]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteDocument(context))"
                                                   Disabled="@(context.Status == DocumentStatus.Indexing)"
                                                   title="@L["RAG:DocumentQueue:Actions:Delete"]" />
                                     @if (context.Status == DocumentStatus.Error && !string.IsNullOrWhiteSpace(context.ErrorMessage))
                                     {
                                         <MudIconButton Icon="@Icons.Material.Filled.ErrorOutline"
                                                        Size="Size.Small"
                                                        Color="Color.Warning"
                                                        OnClick="@(() => ShowIndexingError(context))"
                                                        title="@L["Common:Error"]" />
                                     }
                                 </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </div>

                <!-- Indexing Actions -->
                <div class="indexing-actions-grid">
                    <!-- Markdown Group Card -->
                    <div class="indexing-card">
                        <div class="indexing-card-title">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle2">@L["RAG:Indexing:Title"]</MudText>
                        </div>
                        <div class="markdown-group-section">
                            <MudSelect T="string"
                                       @bind-Value="@_selectedMarkdownGroup"
                                       Label="@L["RAG:Indexing:MarkdownGroup"]"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       FullWidth="true">
                                @foreach (var group in _markdownGroups)
                                {
                                    <MudSelectItem T="string" Value="@group">@group</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.FolderOpen"
                                       OnClick="@ShowDocumentSelectionDialog"
                                       Disabled="@string.IsNullOrEmpty(_selectedMarkdownGroup)"
                                       FullWidth="true">
                                @L["RAG:DocumentSelection:Title"]
                            </MudButton>
                        </div>
                    </div>

                    <!-- Upload Document Card -->
                    <div class="indexing-card">
                        <div class="indexing-card-title">
                            <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle2">@L["RAG:Indexing:UploadFile"]</MudText>
                        </div>
                        <MudFileUpload T="IBrowserFile"
                                       Accept=".txt,.md,.pdf"
                                       FilesChanged="@OnFileSelected"
                                       MaximumFileCount="1"
                                       Class="upload-file-input">
                            <CustomContent Context="upload">
                                <div class="upload-drop-zone" @onclick="upload.OpenFilePickerAsync">
                                    <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" Class="upload-icon" />
                                    <MudText Typo="Typo.body2" Class="upload-hint-primary">@L["RAG:Indexing:ClickToUpload"]</MudText>
                                    <MudText Typo="Typo.caption" Class="upload-hint-secondary">.md, .txt, .pdf</MudText>
                                </div>
                            </CustomContent>
                        </MudFileUpload>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <MudText Typo="Typo.h6" Color="Color.Secondary">
                    @L["RAG:KnowledgeBase:SelectPrompt"]
                </MudText>
            </div>
        }
    </div>
</div>

@code {
    public const string PAGE_URL = "/ai/rag/manage";

    private List<KnowledgeBase> _knowledgeBases = new();
    private KnowledgeBase? _selectedKB;
    private string _currentEmbeddingModelKey = string.Empty;
    private List<EmbeddingModelOption> _availableModels = new();
    private List<DocumentQueueItem> _documentQueue = new();
    private int _parallelCount = 5;
    private List<string> _markdownGroups = new();
    private string? _selectedMarkdownGroup;
    private const int QueueRefreshIntervalMs = 700;
    private static readonly TimeSpan ProgressQueueRefreshInterval = TimeSpan.FromSeconds(1);
    private CancellationTokenSource? _queuePollingCts;
    private Task? _queuePollingTask;
    private string? _batchStartInFlightKbId;
    private DateTimeOffset _lastProgressQueueRefreshAtUtc = DateTimeOffset.MinValue;
    private int _progressQueueRefreshInFlight;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadEmbeddingModelsAsync();
            await LoadKnowledgeBasesAsync();
            await LoadMarkdownGroupsAsync();

            if (_selectedKB is not null)
            {
                await LoadDocumentQueueAsync();
                EnsureQueuePolling();
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadEmbeddingModelsAsync()
    {
        if ((await EmbeddingService.GetEmbeddingModelsAsync()).IsFailed(out var error, out var models))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            return;
        }

        _availableModels = models.ToList();

        if (_availableModels.Count == 0)
        {
            _currentEmbeddingModelKey = string.Empty;
            Snackbar.Add(L["RAG:EmbeddingModel:NotConfigured"], Severity.Warning);
        }
    }

    private async Task LoadKnowledgeBasesAsync()
    {
        if ((await RAGService.GetKnowledgeBasesAsync()).IsFailed(out var error, out var kbs))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            return;
        }
        _knowledgeBases = kbs.ToList();
    }

    private async Task LoadMarkdownGroupsAsync()
    {
        if ((await RAGService.GetMarkdownGroupsAsync()).IsFailed(out var error, out var groups))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            return;
        }
        _markdownGroups = groups.Select(g => g.Key).ToList();
    }

    private async Task OnKBSelected(KnowledgeBase? kb)
    {
        if (!string.Equals(_batchStartInFlightKbId, kb?.Id, StringComparison.OrdinalIgnoreCase))
        {
            // Batch-start marker is bound to one KB and must not leak across selections.
            ClearBatchStartInFlight();
        }

        _selectedKB = kb;
        if (kb is not null)
        {
            // Load KB's embedding model
            if ((await EmbeddingService.GetKnowledgeBaseEmbeddingModelAsync(kb.Id)).IsFailed(out var error, out var model))
            {
                Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            }
            else if (model != null)
            {
                _currentEmbeddingModelKey = model.ModelKey;
            }
            else if (HasEmbeddingBinding(kb))
            {
                _currentEmbeddingModelKey = GetKnowledgeBaseModelKey(kb);
            }
            else
            {
                _currentEmbeddingModelKey = string.Empty;
            }

            // Load document queue for this KB
            await LoadDocumentQueueAsync();
            EnsureQueuePolling();
        }
        else
        {
            _currentEmbeddingModelKey = string.Empty;
            _documentQueue.Clear();
            ClearBatchStartInFlight();
            StopQueuePolling();
        }
    }

    private async Task DeleteKnowledgeBase(KnowledgeBase kb)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["Common:Confirm"],
            $"Are you sure you want to delete knowledge base '{kb.Name}'? This will remove all indexed documents.",
            yesText: L["Common:Delete"],
            cancelText: L["Common:Cancel"]);

        if (confirmed != true) return;

        if ((await RAGService.DeleteKnowledgeBaseAsync(kb.Id)).IsFailed(out var error))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
        }
        else
        {
            Snackbar.Add(L["Common:Success"], Severity.Success);
            if (_selectedKB?.Id == kb.Id)
            {
                _selectedKB = null;
                ClearBatchStartInFlight();
            }
            await LoadKnowledgeBasesAsync();
        }
    }

    private async Task DeleteSelectedKnowledgeBase()
    {
        if (_selectedKB is null)
        {
            return;
        }

        await DeleteKnowledgeBase(_selectedKB);
    }

    private async Task LoadDocumentQueueAsync(bool ensurePolling = true)
    {
        if (_selectedKB == null) return;

        if ((await RAGService.GetDocumentQueueAsync(_selectedKB.Id)).IsFailed(out var error, out var queue))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            _documentQueue.Clear();
        }
        else
        {
            _documentQueue = queue.ToList();
        }

        if (ensurePolling)
        {
            EnsureQueuePolling();
        }
    }

    private async Task OnEmbeddingModelChanged(string modelKey)
    {
        if (_selectedKB == null) return;

        if (!EmbeddingModelOption.TryParseModelKey(modelKey, out var providerId, out var modelName))
        {
            Snackbar.Add($"{L["Common:Error"]}: invalid embedding model key.", Severity.Error);
            return;
        }

        var previousModelKey = GetKnowledgeBaseModelKey(_selectedKB);
        if (string.Equals(previousModelKey, modelKey, StringComparison.OrdinalIgnoreCase)) return;

        var requiresReindexWarning = HasIndexedContent(_selectedKB)
            && !string.IsNullOrWhiteSpace(previousModelKey);

        if (requiresReindexWarning)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                L["RAG:EmbeddingModel:ReindexConfirm:Title"],
                L["RAG:EmbeddingModel:ReindexConfirm:Message", _selectedKB.Name],
                yesText: L["RAG:EmbeddingModel:ReindexConfirm:Continue"],
                cancelText: L["Common:Cancel"]);

            if (confirmed != true)
            {
                _currentEmbeddingModelKey = previousModelKey;
                return;
            }
        }

        _currentEmbeddingModelKey = modelKey;

        if ((await EmbeddingService.SetKnowledgeBaseEmbeddingModelAsync(
                _selectedKB.Id,
                providerId,
                modelName,
                clearIndex: true)).IsFailed(out var error))
        {
            _currentEmbeddingModelKey = previousModelKey;
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            return;
        }

        await RefreshSelectedKnowledgeBaseAsync();

        if (_selectedKB is not null)
        {
            await LoadDocumentQueueAsync();
        }

        if (requiresReindexWarning)
        {
            Snackbar.Add(L["RAG:EmbeddingModel:ReindexRequired"], Severity.Warning);
        }
        else
        {
            Snackbar.Add(L["Common:Success"], Severity.Success);
        }
    }

    private async Task ShowCreateKBDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateKnowledgeBaseDialog>(
            L["RAG:Manage:CreateDialog:Title"],
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ValueTuple<string, string> data })
        {
            var (name, description) = data;
            if ((await RAGService.CreateKnowledgeBaseAsync(name, description)).IsFailed(out var error))
            {
                Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add(L["Common:Success"], Severity.Success);
                await LoadKnowledgeBasesAsync();
            }
        }
    }

    private async Task ShowEditKBDialog()
    {
        if (_selectedKB is null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(CreateKnowledgeBaseDialog.InitialName), _selectedKB.Name },
            { nameof(CreateKnowledgeBaseDialog.InitialDescription), _selectedKB.Description },
            { nameof(CreateKnowledgeBaseDialog.SubmitText), L["Common:Actions:Save"].Value }
        };

        var dialog = await DialogService.ShowAsync<CreateKnowledgeBaseDialog>(
            L["Common:Edit"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: ValueTuple<string, string> data })
        {
            return;
        }

        var (name, description) = data;
        if ((await RAGService.UpdateKnowledgeBaseAsync(_selectedKB.Id, name, description)).IsFailed(out var error))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            return;
        }

        Snackbar.Add(L["Common:Success"], Severity.Success);
        await RefreshSelectedKnowledgeBaseAsync();
    }

    private async Task StartBatchIndexing()
    {
        if (_selectedKB == null) return;

        var selectedKbId = _selectedKB.Id;

        var pendingDocs = _documentQueue.Where(d => d.Status == DocumentStatus.Pending).ToList();
        if (pendingDocs.Count == 0)
        {
            Snackbar.Add(L["RAG:ParallelIndexing:NoPendingDocuments"], Severity.Warning);
            return;
        }

        _batchStartInFlightKbId = selectedKbId;
        EnsureQueuePolling();
        await InvokeAsync(StateHasChanged);
        var progress = new Progress<IndexingProgress>(OnBatchIndexingProgress);
        var indexingTask = RAGService.StartBatchIndexingAsync(
            selectedKbId,
            _parallelCount,
            progress);

        try
        {
            var result = await indexingTask;
            if (result.IsFailed(out var error))
            {
                if (IsCancellationMessage(error.Message))
                {
                    Snackbar.Add(L["Error:RequestCancelled"], Severity.Warning);
                }
                else
                {
                    Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
                    await DialogService.ShowMessageBoxAsync(
                        L["Common:Error"],
                        error.Message ?? L["Common:Error"].Value,
                        yesText: L["Common:Close"]);
                }
            }
            else
            {
                Snackbar.Add(L["Common:Success"], Severity.Success);
            }
        }
        finally
        {
            if (_selectedKB is not null
                && string.Equals(_batchStartInFlightKbId, _selectedKB.Id, StringComparison.OrdinalIgnoreCase))
            {
                _batchStartInFlightKbId = null;
            }

            await RefreshSelectedKnowledgeBaseAsync();
            await LoadDocumentQueueAsync(ensurePolling: false);
            EnsureQueuePolling();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CancelBatchIndexing()
    {
        if (_selectedKB is null)
        {
            return;
        }

        var cancelResult = await RAGService.CancelBatchIndexingAsync(_selectedKB.Id);
        if (cancelResult.IsFailed(out var error))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            return;
        }

        ClearBatchStartInFlight();
        EnsureQueuePolling();
        Snackbar.Add(cancelResult.Message ?? L["Error:RequestCancelled"].Value, Severity.Warning);
        await LoadDocumentQueueAsync();
        await RefreshSelectedKnowledgeBaseAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowChunkViewer(DocumentQueueItem document)
    {
        if (_selectedKB == null) return;

        // Get document chunks from service
        var result = await RAGService.GetDocumentChunksAsync(_selectedKB.Id, document.Id);
        if (result.IsFailed(out var error, out var data))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            return;
        }

        var (originalText, chunks) = data;

        // Determine status text for display
        var statusText = document.Status switch
        {
            DocumentStatus.Done => L["RAG:ChunkViewer:Indexed", document.IndexedAt?.ToString("yyyy-MM-dd") ?? ""].Value,
            DocumentStatus.Pending => L["RAG:ChunkViewer:PendingIndexing"].Value,
            _ => document.Status.ToString()
        };

        // Open dialog with chunk data
        var parameters = new DialogParameters
        {
            { nameof(ChunkViewerDialog.DocumentName), document.Name },
            { nameof(ChunkViewerDialog.OriginalText), originalText },
            { nameof(ChunkViewerDialog.Chunks), chunks },
            { nameof(ChunkViewerDialog.MatchedChunkIndex), (int?)null }, // Will be used in Phase 7 for search results
            { nameof(ChunkViewerDialog.StatusText), statusText }
        };

        await DialogService.ShowAsync<ChunkViewerDialog>(
            L["RAG:ChunkViewer:Title"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private async Task ReindexDocument(DocumentQueueItem document)
    {
        if (_selectedKB == null) return;

        if ((await RAGService.ReindexDocumentAsync(_selectedKB.Id, document.Id)).IsFailed(out var error))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
        }
        else
        {
            Snackbar.Add(L["Common:Success"], Severity.Success);
            await LoadDocumentQueueAsync();
        }
    }

    private async Task DeleteDocument(DocumentQueueItem document)
    {
        if (_selectedKB == null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["Common:Confirm"],
            L["RAG:DocumentQueue:DeleteConfirm", document.Name],
            yesText: L["Common:Delete"],
            cancelText: L["Common:Cancel"]);

        if (confirmed != true) return;

        if ((await RAGService.RemoveDocumentAsync(_selectedKB.Id, document.Id)).IsFailed(out var error))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
        }
        else
        {
            Snackbar.Add(L["Common:Success"], Severity.Success);
            await LoadDocumentQueueAsync();
        }
    }

    private async Task ShowIndexingError(DocumentQueueItem document)
    {
        var message = string.IsNullOrWhiteSpace(document.ErrorMessage)
            ? L["Common:Error"].Value
            : document.ErrorMessage;

        await DialogService.ShowMessageBoxAsync(
            L["Common:Error"],
            $"{document.Name}\n\n{message}",
            yesText: L["Common:Close"]);
    }

    private async Task ShowDocumentSelectionDialog()
    {
        if (_selectedKB == null || string.IsNullOrEmpty(_selectedMarkdownGroup)) return;

        // Get available documents from the selected markdown group
        if ((await RAGService.GetAvailableDocumentsAsync(_selectedMarkdownGroup)).IsFailed(out var error, out var documents))
        {
            Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            return;
        }

        // Get already indexed document IDs
        var indexedIds = _documentQueue
            .Where(d => d.Status == DocumentStatus.Done)
            .Select(d => d.Id)
            .ToHashSet();

        var parameters = new DialogParameters
        {
            { nameof(DocumentSelectionDialog.AvailableDocuments), documents.ToList() },
            { nameof(DocumentSelectionDialog.IndexedDocumentIds), indexedIds }
        };

        var dialog = await DialogService.ShowAsync<DocumentSelectionDialog>(
            L["RAG:DocumentSelection:Title"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<string> selectedDocIds })
        {
            if ((await RAGService.AddDocumentsToQueueAsync(_selectedKB.Id, selectedDocIds)).IsFailed(out var addError))
            {
                Snackbar.Add($"{L["Common:Error"]}: {addError.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add(L["Common:Success"], Severity.Success);
                await LoadDocumentQueueAsync();
            }
        }
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        if (_selectedKB == null) return;

        try
        {
            // Read file content (limit to 10MB)
            const long maxFileSize = 10 * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                Snackbar.Add(L["RAG:Indexing:FileTooLarge"], Severity.Error);
                return;
            }

            using var stream = file.OpenReadStream(maxFileSize);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            if ((await RAGService.UploadAndIndexDocumentAsync(_selectedKB.Id, file.Name, content)).IsFailed(out var error))
            {
                Snackbar.Add($"{L["Common:Error"]}: {error.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add(L["Common:Success"], Severity.Success);
                await RefreshSelectedKnowledgeBaseAsync();
                await LoadDocumentQueueAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Common:Error"]}: {ex.Message}", Severity.Error);
        }
    }

    private static bool HasEmbeddingBinding(KnowledgeBase kb)
        => !string.IsNullOrWhiteSpace(kb.EmbeddingProviderId)
           && !string.IsNullOrWhiteSpace(kb.EmbeddingModelName);

    private bool HasIndexedContent(KnowledgeBase kb)
    {
        if (kb.DocumentCount > 0 || kb.ChunkCount > 0)
        {
            return true;
        }

        return _documentQueue.Any(item =>
            item.Status == DocumentStatus.Done || item.ChunkCount > 0);
    }

    private async Task RefreshSelectedKnowledgeBaseAsync()
    {
        if (_selectedKB is null)
        {
            ClearBatchStartInFlight();
            return;
        }

        var selectedKbId = _selectedKB.Id;
        await LoadKnowledgeBasesAsync();
        _selectedKB = _knowledgeBases.FirstOrDefault(k => k.Id == selectedKbId);

        if (_selectedKB is null)
        {
            _currentEmbeddingModelKey = string.Empty;
            _documentQueue.Clear();
            return;
        }

        _currentEmbeddingModelKey = HasEmbeddingBinding(_selectedKB)
            ? GetKnowledgeBaseModelKey(_selectedKB)
            : string.Empty;
    }

    private bool HasActiveQueueWork()
    {
        return IsBatchIndexingRunning();
    }

    private bool IsBatchIndexingRunning()
    {
        if (_selectedKB is null)
        {
            return false;
        }

        if (string.Equals(_batchStartInFlightKbId, _selectedKB.Id, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var hasActiveServerBatch = RAGService.IsBatchIndexingActive(_selectedKB.Id);
        var hasInFlightQueueRows = _documentQueue.Any(d => d.Status == DocumentStatus.Indexing);

        return hasActiveServerBatch || hasInFlightQueueRows;
    }

    private bool CanStartBatchIndexing()
    {
        if (_selectedKB is null)
        {
            return false;
        }

        var hasPending = _documentQueue.Any(d => d.Status == DocumentStatus.Pending);
        return hasPending && !IsBatchIndexingRunning();
    }

    private bool CanCancelBatchIndexing()
    {
        if (_selectedKB is null)
        {
            return false;
        }

        return IsBatchIndexingRunning();
    }

    private static bool IsCancellationMessage(string? message)
        => !string.IsNullOrWhiteSpace(message)
           && message.Contains("cancel", StringComparison.OrdinalIgnoreCase);

    private void OnBatchIndexingProgress(IndexingProgress progress)
    {
        _ = InvokeAsync(RefreshQueueFromProgressAsync);
    }

    private async Task RefreshQueueFromProgressAsync()
    {
        var now = DateTimeOffset.UtcNow;
        if (now - _lastProgressQueueRefreshAtUtc < ProgressQueueRefreshInterval)
        {
            StateHasChanged();
            return;
        }

        if (Interlocked.Exchange(ref _progressQueueRefreshInFlight, 1) == 1)
        {
            return;
        }

        try
        {
            _lastProgressQueueRefreshAtUtc = now;
            await LoadDocumentQueueAsync(ensurePolling: false);
            StateHasChanged();
        }
        finally
        {
            Interlocked.Exchange(ref _progressQueueRefreshInFlight, 0);
        }
    }

    private void ClearBatchStartInFlight()
    {
        _batchStartInFlightKbId = null;
    }

    private void EnsureQueuePolling()
    {
        if (!HasActiveQueueWork())
        {
            StopQueuePolling();
            return;
        }

        if (_queuePollingTask is { IsCompleted: false })
        {
            return;
        }

        _queuePollingCts = new CancellationTokenSource();
        _queuePollingTask = RunQueuePollingAsync(_queuePollingCts.Token);
    }

    private async Task RunQueuePollingAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                if (_selectedKB is null)
                {
                    break;
                }

                await LoadDocumentQueueAsync(ensurePolling: false);
                await InvokeAsync(StateHasChanged);

                if (!HasActiveQueueWork())
                {
                    break;
                }

                await Task.Delay(QueueRefreshIntervalMs, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore cancellation while component is disposed or polling is switched.
        }
        finally
        {
            if (_queuePollingCts?.Token == cancellationToken)
            {
                _queuePollingCts.Dispose();
                _queuePollingCts = null;
                _queuePollingTask = null;
            }
        }
    }

    private void StopQueuePolling()
    {
        var cts = _queuePollingCts;
        if (cts is null)
        {
            return;
        }

        _queuePollingCts = null;
        _queuePollingTask = null;

        if (!cts.IsCancellationRequested)
        {
            cts.Cancel();
        }

        cts.Dispose();
    }

    public void Dispose()
    {
        ClearBatchStartInFlight();
        StopQueuePolling();
    }

    private static string GetKnowledgeBaseModelKey(KnowledgeBase kb)
    {
        if (!HasEmbeddingBinding(kb))
        {
            return string.Empty;
        }

        return EmbeddingModelOption.ToModelKey(
            kb.EmbeddingProviderId!,
            kb.EmbeddingModelName!);
    }

    private string GetProviderDisplayLabel(string? providerId, string? modelName = null)
    {
        if (string.IsNullOrWhiteSpace(providerId))
        {
            return string.Empty;
        }

        var model = _availableModels.FirstOrDefault(m =>
            string.Equals(m.ProviderId, providerId, StringComparison.OrdinalIgnoreCase)
            && (string.IsNullOrWhiteSpace(modelName)
                || string.Equals(m.ModelName, modelName, StringComparison.OrdinalIgnoreCase)));

        if (model is not null)
        {
            return model.ProviderDisplayName;
        }

        if (!string.IsNullOrWhiteSpace(modelName))
        {
            var modelCandidates = _availableModels
                .Where(m => string.Equals(m.ModelName, modelName, StringComparison.OrdinalIgnoreCase))
                .Select(m => m.ProviderDisplayName)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (modelCandidates.Count == 1)
            {
                return modelCandidates[0];
            }
        }

        var provider = ProviderFactory.GetProvider(providerId);
        if (provider is not null)
        {
            return provider.DisplayName;
        }

        return providerId.Trim();
    }

    private string GetKnowledgeBaseModelDisplay(KnowledgeBase kb)
    {
        if (!HasEmbeddingBinding(kb))
        {
            return string.Empty;
        }

        return $"{kb.EmbeddingModelName} ({GetProviderDisplayLabel(kb.EmbeddingProviderId, kb.EmbeddingModelName)})";
    }

    private string GetModelDisplayByKey(string modelKey)
    {
        var model = _availableModels.FirstOrDefault(m =>
            string.Equals(m.ModelKey, modelKey, StringComparison.OrdinalIgnoreCase));

        if (model is not null)
        {
            return $"{model.ModelName} ({model.ProviderDisplayName})";
        }

        if (!EmbeddingModelOption.TryParseModelKey(modelKey, out var providerId, out var modelName))
        {
            return modelKey;
        }

        return $"{modelName} ({GetProviderDisplayLabel(providerId, modelName)})";
    }
}

