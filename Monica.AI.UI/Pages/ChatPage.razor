@attribute [Route(PAGE_URL)]
@rendermode InteractiveServer
@implements IDisposable

<HeadContent>
    <link href="_content/Monica.AI.UI/css/ai-chat-page.css" rel="stylesheet" />
</HeadContent>

<div class="ai-chat-shell">
    @if (PageState.ShowSessionList)
    {
        <aside class="ai-sidebar">
            <SessionList
                Sessions="@PageState.Sessions"
                CurrentSessionId="@PageState.CurrentSessionId"
                OnNewSession="@PageState.CreateNewSessionAsync"
                OnSelectSession="@PageState.SelectSession"
                OnDeleteSession="@PageState.DeleteSessionAsync" />
        </aside>
    }

    <main class="ai-main">
        <header class="ai-topbar">
            <div class="topbar-left">
                @if (PageState.ShowProviderSelector)
                {
                    <ProviderSelector
                        Providers="@PageState.Providers"
                        SelectedProviderId="@PageState.CurrentProviderId"
                        SelectedModelName="@PageState.CurrentModelName"
                        SelectedProviderIdChanged="@PageState.ChangeProviderAsync" />
                }
            </div>
            <div class="topbar-right">
                <MudTooltip Text="@PageState.GetToolDebugTooltip()">
                    <MudIconButton Icon="@Icons.Material.Filled.BugReport"
                                   Class="@($"tool-debug-button {(PageState.ToolDebugEnabled ? "active" : "")}")"
                                   OnClick="PageState.ToggleToolDebugAsync" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Class="settings-button"
                               OnClick="PageState.OpenPromptSettingsAsync" />
            </div>
        </header>

        <ChatContainer Parameters="@PageState.BuildChatContainerParameters()" />
    </main>
</div>
