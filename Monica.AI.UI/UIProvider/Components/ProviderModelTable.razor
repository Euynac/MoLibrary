@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L

<div class="model-table">
    <MudTable T="AIModelInfo"
              Items="@Models"
              Dense="true"
              Hover="true"
              Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>@L["ProviderManage:ModelTable:Columns:Model"]</MudTh>
            <MudTh>@L["ProviderManage:ModelTable:Columns:Type"]</MudTh>
            <MudTh>@L["ProviderManage:ModelTable:Columns:Capabilities"]</MudTh>
            <MudTh>@L["ProviderManage:ModelTable:Columns:Cost"]</MudTh>
            <MudTh>@L["ProviderManage:ModelTable:Columns:Metadata"]</MudTh>
            <MudTh Class="col-action">@L["ProviderManage:ModelTable:Columns:Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["ProviderManage:ModelTable:Columns:Model"]">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2">@context.ModelName</MudText>
                        @if (!string.IsNullOrWhiteSpace(context.Description))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                        }
                    </MudStack>
                    @if (RemoteModels != null)
                    {
                        @if (IsModelInRemoteList(context.ModelName))
                        {
                            <MudTooltip Text="@L["ProviderManage:ModelTable:RemoteStatus:Verified"]">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="@L["ProviderManage:ModelTable:RemoteStatus:Missing"]">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" />
                            </MudTooltip>
                        }
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="@L["ProviderManage:ModelTable:Columns:Type"]">
                <MudText Typo="Typo.body2">@GetModelType(context)</MudText>
            </MudTd>
            <MudTd DataLabel="@L["ProviderManage:ModelTable:Columns:Capabilities"]">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    @switch (context)
                    {
                        case LLMModelInfo llm:
                        {
                            if (llm.SupportsImage)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Image">@L["ProviderManage:ModelTable:Capabilities:Image"]</MudChip>
                            }
                            if (llm.SupportsReasoning)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.Psychology">@L["ProviderManage:ModelTable:Capabilities:Reasoning"]</MudChip>
                            }

                            break;
                        }
                        case ImageModelInfo image:
                        {
                            if (image.SupportsEditing)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.Edit">@L["ProviderManage:ModelTable:Capabilities:Editing"]</MudChip>
                            }

                            break;
                        }
                        case TextToSpeechModelInfo tts:
                        {
                            if (tts.SupportsStreaming)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Stream">@L["ProviderManage:ModelTable:Capabilities:Streaming"]</MudChip>
                            }

                            break;
                        }
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="@L["ProviderManage:ModelTable:Columns:Cost"]">
                @if (context is LLMModelInfo llmCost)
                {
                    var isFree = llmCost.InputCostPerMillionTokens <= 0
                        && llmCost.OutputCostPerMillionTokens <= 0
                        && llmCost.CachedInputCostPerMillionTokens <= 0;

                    if (isFree)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Success">@L["ProviderManage:ModelTable:Cost:Free"]</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption">@FormatCostLine(L["ProviderManage:ModelTable:Cost:Input"], llmCost.InputCostPerMillionTokens)</MudText>
                            <MudText Typo="Typo.caption">@FormatCostLine(L["ProviderManage:ModelTable:Cost:Output"], llmCost.OutputCostPerMillionTokens)</MudText>
                            <MudText Typo="Typo.caption">@FormatCostLine(L["ProviderManage:ModelTable:Cost:Cached"], llmCost.CachedInputCostPerMillionTokens)</MudText>
                        </MudStack>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption">—</MudText>
                }
            </MudTd>
            <MudTd DataLabel="@L["ProviderManage:ModelTable:Columns:Metadata"]">
                @if (context is LLMModelInfo llmMeta)
                {
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption">@L["ProviderManage:ModelTable:Metadata:Context", FormatOptional(llmMeta.ContextWindow)]</MudText>
                        <MudText Typo="Typo.caption">@L["ProviderManage:ModelTable:Metadata:MaxOutput", FormatOptional(llmMeta.MaxOutputTokens)]</MudText>
                    </MudStack>
                }
                else if (context is ImageModelInfo imageMeta)
                {
                    <MudText Typo="Typo.caption">@L["ProviderManage:ModelTable:Metadata:MaxSize", FormatOptional(imageMeta.MaxImageSize)]</MudText>
                }
                else if (context is EmbeddingModelInfo embedding)
                {
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption">@L["ProviderManage:ModelTable:Metadata:Dimensions", embedding.Dimensions?.ToString() ?? L["ProviderManage:ModelTable:Unknown"].Value]</MudText>
                        @if (embedding.Dimensions == null)
                        {
                            <MudTooltip Text="@L["ProviderManage:ModelTable:Metadata:DimensionProbeHint"]">
                                <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Warning" />
                            </MudTooltip>
                        }
                    </MudStack>
                }
                else if (context is TextToSpeechModelInfo ttsMeta)
                {
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption">@L["ProviderManage:ModelTable:Metadata:Voices", FormatVoiceSummary(ttsMeta.Voices)]</MudText>
                    </MudStack>
                }
            </MudTd>
            <MudTd DataLabel="@L["ProviderManage:ModelTable:Columns:Actions"]" Class="col-action">
                @if (context is LLMModelInfo)
                {
                    var isTesting = IsModelTesting?.Invoke(context) ?? false;
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PlayCircle"
                               Disabled="@(isTesting || DisableActions)"
                               OnClick="() => OnTestModel.InvokeAsync(context)">
                        @(isTesting ? L["ProviderManage:ModelTable:Actions:Testing"] : L["ProviderManage:ModelTable:Actions:Test"])
                    </MudButton>
                }
                else if (context is EmbeddingModelInfo)
                {
                    var isProbing = IsModelTesting?.Invoke(context) ?? false;
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Radar"
                               Disabled="@(isProbing || DisableActions)"
                               OnClick="() => OnProbeEmbedding.InvokeAsync(context)">
                        @(isProbing ? L["ProviderManage:ModelTable:Actions:Probing"] : L["ProviderManage:ModelTable:Actions:ProbeDimensions"])
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.caption">—</MudText>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Medium" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ProviderManage:ModelTable:Empty"]</MudText>
            </MudStack>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    [Parameter] public IReadOnlyList<AIModelInfo> Models { get; set; } = [];
    [Parameter] public IReadOnlyList<AIRemoteModelInfo>? RemoteModels { get; set; }
    [Parameter] public EventCallback<AIModelInfo> OnTestModel { get; set; }
    [Parameter] public EventCallback<AIModelInfo> OnProbeEmbedding { get; set; }
    [Parameter] public Func<AIModelInfo, bool>? IsModelTesting { get; set; }
    [Parameter] public bool DisableActions { get; set; }

    private HashSet<string>? _remoteModelIds;
    private IReadOnlyList<AIRemoteModelInfo>? _lastRemoteModels;

    private bool IsModelInRemoteList(string modelName)
    {
        if (RemoteModels == null) return true;
        if (_remoteModelIds == null || !ReferenceEquals(RemoteModels, _lastRemoteModels))
        {
            _lastRemoteModels = RemoteModels;
            _remoteModelIds = new HashSet<string>(
                RemoteModels.Select(rm => rm.ModelId), StringComparer.OrdinalIgnoreCase);
        }
        return _remoteModelIds.Contains(modelName);
    }

    private string GetModelType(AIModelInfo model)
    {
        return model switch
        {
            LLMModelInfo => L["ProviderManage:ModelTable:Types:LLM"],
            ImageModelInfo => L["ProviderManage:ModelTable:Types:Image"],
            EmbeddingModelInfo => L["ProviderManage:ModelTable:Types:Embedding"],
            TextToSpeechModelInfo => L["ProviderManage:ModelTable:Types:TTS"],
            _ => L["ProviderManage:ModelTable:Unknown"]
        };
    }

    private string FormatCostLine(string label, decimal value)
    {
        return L["ProviderManage:ModelTable:Cost:PerMillion", label, FormatCostValue(value)];
    }

    private static string FormatCostValue(decimal value)
    {
        return $"${value:0.####}";
    }

    private static string FormatOptional(int? value)
    {
        return value?.ToString() ?? "—";
    }

    private string FormatVoiceSummary(IReadOnlyList<string>? voices)
    {
        if (voices == null || voices.Count == 0)
        {
            return "—";
        }

        return L["ProviderManage:ModelTable:Metadata:VoiceCount", voices.Count];
    }
}
