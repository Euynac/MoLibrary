@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L

<MudDialog Class="prompt-dialog">
    <DialogContent>
        <MudText Typo="Typo.h6">@L["Provider:Settings:Title"]</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="prompt-subtitle">
            @ProviderName
        </MudText>

        <MudTextField T="string"
                      @bind-Value="_prompt"
                      Variant="Variant.Outlined"
                      Lines="6"
                      Sizing="InputSizing.Auto"
                      MaxLines="12"
                      Disabled="@IsReadOnly"
                      Class="prompt-input" />

        @if (IsReadOnly)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @L["Provider:Settings:ReadOnlyMessage"]
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @L["Provider:Settings:NewSessionMessage"]
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@L["Common:Actions:Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@IsReadOnly">
            @L["Common:Actions:Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public string ProviderName { get; set; } = "Provider";
    [Parameter] public string? SystemPrompt { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }

    private string _prompt = string.Empty;

    protected override void OnParametersSet()
    {
        _prompt = SystemPrompt ?? string.Empty;
    }

    private void Save()
    {
        Dialog.Close(DialogResult.Ok(_prompt));
    }

    private void Cancel()
    {
        Dialog.Cancel();
    }
}
