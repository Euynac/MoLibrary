@using Microsoft.Extensions.Localization
@using Monica.AI.Providers
@using Monica.AI.Providers.OpenAI
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L

<MudPaper Class="provider-card" Elevation="2">
    <div class="provider-card-inner">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@GetProviderIcon(Provider)" Size="Size.Medium" />
                <MudText Typo="Typo.h6">@Provider.DisplayName</MudText>
                @if (Provider.IsDefault)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">默认</MudChip>
                }
            </MudStack>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Size="Size.Small"
                               OnClick="HandleEditPrompt"
                               Class="config-button" />
                <MudButton Variant="Variant.Outlined" OnClick="HandleTest" Disabled="@(!CanRunConnectivityActions || IsTesting)">
                    @if (IsTesting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    测试
                </MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(Provider.Description))
        {
            <MudText Typo="Typo.body2" Class="provider-description">@Provider.Description</MudText>
        }

        @if (Provider.ConfigurationErrors is { Count: > 0 })
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="provider-warning">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption">@L["ProviderManage:Card:ConfigurationErrorTitle"]</MudText>
                    @foreach (var error in Provider.ConfigurationErrors)
                    {
                        <MudText Typo="Typo.caption">@error</MudText>
                    }
                </MudStack>
            </MudAlert>
        }

        @if (!Provider.IsValid)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="provider-warning">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption">@L["ProviderManage:Card:InvalidModelsHint"]</MudText>
                    @if (Provider.InvalidModels is { Count: > 0 })
                    {
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.caption">@L["ProviderManage:Card:InvalidModelsLabel"]</MudText>
                            @foreach (var model in Provider.InvalidModels)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@model</MudChip>
                            }
                        </MudStack>
                    }
                    else if (Provider.ConfigurationErrors is not { Count: > 0 })
                    {
                        <MudText Typo="Typo.caption">@L["ProviderManage:Card:NoSupportedModels"]</MudText>
                    }
                </MudStack>
            </MudAlert>
        }

        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-2">
            <MudChip T="string" Size="Size.Small" Color="@GetTestStatusColor()">@GetTestStatusText()</MudChip>
            @if (!Provider.IsValid)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["ProviderManage:Card:Status:Invalid"]</MudChip>
            }
            @if (TestedAt.HasValue)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@TestedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
            }
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(TestMessage))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="test-message">@TestMessage</MudText>
        }

        <MudDivider Class="my-3" />

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="Color.Secondary">默认模型</MudText>
                <MudText Typo="Typo.body2">@FormatValue(Provider.DefaultModel)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="Color.Secondary">模型数量</MudText>
                <MudText Typo="Typo.body2">@Models.Count</MudText>
            </MudItem>
            @if (TryGetOpenAIApiMode(out var openAIApiMode))
            {
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ProviderManage:Card:ApiModeLabel"]</MudText>
                    <MudText Typo="Typo.body2">@GetOpenAIApiModeText(openAIApiMode)</MudText>
                </MudItem>
            }
        </MudGrid>

        <div class="prompt-block">
            <MudText Typo="Typo.caption" Color="Color.Secondary">默认系统提示词</MudText>
            @if (string.IsNullOrWhiteSpace(Provider.SystemPrompt))
            {
                <MudText Typo="Typo.body2">—</MudText>
            }
            else
            {
                <MudTooltip Text="@Provider.SystemPrompt">
                    <MudText Typo="Typo.body2" Class="prompt-preview">@GetPromptPreview(Provider.SystemPrompt)</MudText>
                </MudTooltip>
            }
        </div>

        <MudExpansionPanels Class="provider-expand" Elevation="0" Dense="true">
            <MudExpansionPanel Icon="@Icons.Material.Filled.Category">
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body2">模型详情</MudText>
                        @if (RemoteModels != null)
                        {
                            var unconfiguredCount = GetUnconfiguredRemoteModels().Count;
                            @if (unconfiguredCount > 0)
                            {
                                <MudTooltip Text="@($"{unconfiguredCount} 个可用模型未配置")">
                                    <MudBadge Content="@unconfiguredCount" Color="Color.Info" Overlap="true">
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                                    </MudBadge>
                                </MudTooltip>
                            }
                        }
                        else if (!Provider.SupportsRemoteModelListing)
                        {
                            <MudTooltip Text="此 Provider 不支持获取可用模型列表">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" />
                            </MudTooltip>
                        }
                        else if (RemoteModelsFetchError != null)
                        {
                            <MudTooltip Text="@($"获取模型列表失败: {RemoteModelsFetchError}")">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" />
                            </MudTooltip>
                        }
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudStack Spacing="2">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
                            @if (Provider.SupportsRemoteModelListing)
                            {
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.CloudDownload"
                                           OnClick="HandleFetchRemoteModels"
                                           Disabled="@(IsFetchingRemoteModels || !CanRunConnectivityActions)">
                                    @if (IsFetchingRemoteModels)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                    }
                                    @(RemoteModels != null ? "刷新远程模型" : "获取远程模型")
                                </MudButton>
                            }
                        </MudStack>

                        <ProviderModelTable Models="@Models"
                                            RemoteModels="@RemoteModels"
                                            OnTestModel="HandleTestModel"
                                            OnProbeEmbedding="HandleProbeEmbedding"
                                            IsModelTesting="IsModelTesting"
                                            DisableActions="@(!Provider.IsValid)" />

                        @if (RemoteModels != null)
                        {
                            var unconfigured = GetUnconfiguredRemoteModels();
                            @if (unconfigured.Count > 0)
                            {
                                <MudDivider Class="my-1" />
                                <MudStack Spacing="1">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                                        <MudText Typo="Typo.caption" Color="Color.Info">可用但未配置的模型 (@unconfigured.Count)</MudText>
                                    </MudStack>
                                    <div class="unconfigured-models">
                                        @foreach (var rm in unconfigured)
                                        {
                                            var displayName = rm.Metadata?.GetValueOrDefault("DisplayName");
                                            <MudTooltip Text="@(!string.IsNullOrEmpty(displayName) ? displayName : rm.ModelId)">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@rm.ModelId</MudChip>
                                            </MudTooltip>
                                        }
                                    </div>
                                </MudStack>
                            }
                        }
                        else if (!Provider.SupportsRemoteModelListing)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                                此 Provider 不支持获取可用模型列表，无法验证已配置模型的有效性。
                            </MudAlert>
                        }
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </div>
</MudPaper>

@code {
    [Parameter] public AIProviderInfo Provider { get; set; } = null!;
    [Parameter] public IReadOnlyList<AIModelInfo> Models { get; set; } = [];
    [Parameter] public bool IsTesting { get; set; }
    [Parameter] public bool? TestSuccess { get; set; }
    [Parameter] public string? TestMessage { get; set; }
    [Parameter] public DateTimeOffset? TestedAt { get; set; }
    [Parameter] public EventCallback<string> OnTest { get; set; }
    [Parameter] public EventCallback<(string ProviderId, AIModelInfo Model)> OnTestModel { get; set; }
    [Parameter] public EventCallback<(string ProviderId, AIModelInfo Model)> OnProbeEmbedding { get; set; }
    [Parameter] public Func<string, string, bool>? ModelTestingProvider { get; set; }
    [Parameter] public EventCallback<AIProviderInfo> OnEditPrompt { get; set; }
    [Parameter] public IReadOnlyList<AIRemoteModelInfo>? RemoteModels { get; set; }
    [Parameter] public bool IsFetchingRemoteModels { get; set; }
    [Parameter] public string? RemoteModelsFetchError { get; set; }
    [Parameter] public EventCallback<string> OnFetchRemoteModels { get; set; }
    private bool CanRunConnectivityActions => Provider.IsValid;

    private async Task HandleTest()
    {
        await OnTest.InvokeAsync(Provider.ProviderId);
    }

    private async Task HandleEditPrompt()
    {
        await OnEditPrompt.InvokeAsync(Provider);
    }

    private async Task HandleFetchRemoteModels()
    {
        await OnFetchRemoteModels.InvokeAsync(Provider.ProviderId);
    }

    private List<AIRemoteModelInfo> GetUnconfiguredRemoteModels()
    {
        if (RemoteModels == null) return [];
        var configuredNames = new HashSet<string>(
            Models.Select(m => m.ModelName), StringComparer.OrdinalIgnoreCase);
        return RemoteModels.Where(rm => !configuredNames.Contains(rm.ModelId)).ToList();
    }

    private async Task HandleTestModel(AIModelInfo model)
    {
        await OnTestModel.InvokeAsync((Provider.ProviderId, model));
    }

    private async Task HandleProbeEmbedding(AIModelInfo model)
    {
        await OnProbeEmbedding.InvokeAsync((Provider.ProviderId, model));
    }

    private bool IsModelTesting(AIModelInfo model)
    {
        return ModelTestingProvider?.Invoke(Provider.ProviderId, model.ModelName) ?? false;
    }

    private static string GetProviderIcon(AIProviderInfo provider)
    {
        return provider.ProviderType switch
        {
            "OpenAI" => Icons.Material.Filled.Psychology,
            "Anthropic" => Icons.Material.Filled.AutoAwesome,
            "Fake" => Icons.Material.Filled.Memory,
            _ => Icons.Material.Filled.SmartToy
        };
    }

    private Color GetTestStatusColor()
    {
        if (Provider.Status == AIProviderStatus.ConfigurationError)
        {
            return Color.Warning;
        }

        if (IsTesting)
        {
            return Color.Info;
        }

        return TestSuccess switch
        {
            true => Color.Success,
            false => Color.Error,
            _ => Color.Default
        };
    }

    private string GetTestStatusText()
    {
        if (Provider.Status == AIProviderStatus.ConfigurationError)
        {
            return L["ProviderManage:Card:Status:ConfigurationError"];
        }

        if (!Provider.IsValid)
        {
            return L["ProviderManage:Card:Status:InvalidConfiguration"];
        }

        if (IsTesting)
        {
            return L["ProviderManage:Card:Status:Testing"];
        }

        return TestSuccess switch
        {
            true => L["ProviderManage:Card:Status:Available"],
            false => L["ProviderManage:Card:Status:Failed"],
            _ => L["ProviderManage:Card:Status:NotTested"]
        };
    }

    private static string FormatValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

    private bool TryGetOpenAIApiMode(out OpenAIProviderApiMode apiMode)
    {
        apiMode = default;

        if (!string.Equals(Provider.ProviderType, "OpenAI", StringComparison.Ordinal)
            || Provider.Metadata is not { } metadata
            || !metadata.TryGetValue(OpenAIProvider.ApiModeMetadataKey, out var rawApiMode))
        {
            return false;
        }

        return Enum.TryParse(rawApiMode, ignoreCase: true, out apiMode);
    }

    private string GetOpenAIApiModeText(OpenAIProviderApiMode apiMode)
    {
        return apiMode switch
        {
            OpenAIProviderApiMode.Responses => L["ProviderManage:Card:ApiMode:Responses"],
            OpenAIProviderApiMode.Chat => L["ProviderManage:Card:ApiMode:Chat"],
            _ => apiMode.ToString()
        };
    }

    private static string GetPromptPreview(string? prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt))
        {
            return "—";
        }

        var trimmed = prompt.Trim();
        return trimmed.Length > 80 ? trimmed[..80] + "..." : trimmed;
    }
}
