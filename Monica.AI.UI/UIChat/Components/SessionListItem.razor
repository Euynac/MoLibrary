@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L

<div class="session-item-wrapper">
    <MudListItem T="string"
                 Class="@($"session-item {(IsSelected ? "selected" : "")}")"
                 OnClick="@HandleClick">
        <ChildContent>
            <div class="session-content">
                <div class="session-info">
                    <MudText Typo="Typo.body2" Class="session-title">@Session.Title</MudText>
                    <MudText Typo="Typo.caption" Class="session-time">
                        @GetTimeDisplay()
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               Class="delete-button"
                               OnClick="@HandleDelete" />
            </div>
        </ChildContent>
    </MudListItem>
</div>

@code {
    [Parameter] public required ChatSession Session { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private async Task HandleClick()
    {
        await OnClick.InvokeAsync();
    }

    private async Task HandleDelete(MouseEventArgs e)
    {
        await OnDelete.InvokeAsync();
    }

    private string GetTimeDisplay()
    {
        var diff = DateTimeOffset.UtcNow - Session.UpdatedAt;
        return diff.TotalMinutes < 1 ? L["Session:JustNow"] :
               diff.TotalMinutes < 60 ? L["Session:MinutesAgo", (int)diff.TotalMinutes] :
               diff.TotalHours < 24 ? L["Session:HoursAgo", (int)diff.TotalHours] :
               diff.TotalDays < 7 ? L["Session:DaysAgo", (int)diff.TotalDays] :
               Session.UpdatedAt.ToLocalTime().ToString("MM-dd");
    }
}
