@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIChat.State
@using Monica.UI.Shared.Components.Markdown
@inject IStringLocalizer<AIResource> L

<div class="message-wrapper assistant-message">
    <MudStack Row="true" Spacing="2" Class="message-content-stack">
        <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="message-avatar">
            <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
        </MudAvatar>
        <div class="message-content assistant-bubble">
            @if (!string.IsNullOrEmpty(State.Reasoning))
            {
                <div class="reasoning-section @(State.IsReasoning ? "reasoning-active" : "")">
                    @if (State.IsReasoning)
                    {
                        <div class="reasoning-header">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="reasoning-label">@L["Chat:Reasoning:Thinking"]</MudText>
                            <span class="reasoning-pulse"></span>
                        </div>
                        <div class="reasoning-body">
                            <MudText Typo="Typo.body2" Class="reasoning-text">@State.Reasoning</MudText>
                        </div>
                    }
                    else
                    {
                        <div class="reasoning-header reasoning-header-clickable" @onclick="ToggleReasoningExpanded">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="reasoning-label">
                                @L["Chat:Reasoning:Duration", State.ReasoningDurationSeconds]
                            </MudText>
                            <MudIcon Icon="@(_reasoningExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                     Size="Size.Small" Class="reasoning-chevron" />
                        </div>
                        @if (_reasoningExpanded)
                        {
                            <div class="reasoning-body">
                                <MudText Typo="Typo.body2" Class="reasoning-text">@State.Reasoning</MudText>
                            </div>
                        }
                    }
                </div>
            }

            @if (State.ToolCalls.Count > 0)
            {
                <ToolCallIndicator ActiveToolCalls="@State.ToolCalls" EnableDebugMode="@ToolDebugEnabled" />
            }

            @if (EnableMarkdown && !string.IsNullOrEmpty(State.Content))
            {
                <MoMarkdown Value="@State.Content" EnableMermaid="true" />
            }
            else if (!string.IsNullOrEmpty(State.Content))
            {
                <MudText Typo="Typo.body1" Class="message-text">@State.Content</MudText>
            }
            else if (State.IsStreaming && string.IsNullOrEmpty(State.Reasoning))
            {
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="160px" />
            }

            @if (State.IsStreaming && !string.IsNullOrEmpty(State.Content))
            {
                <span class="typing-indicator"></span>
            }
        </div>
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired] public required ChatStreamingState State { get; set; }
    [Parameter] public bool EnableMarkdown { get; set; } = true;
    [Parameter] public bool ToolDebugEnabled { get; set; }

    private bool _reasoningExpanded;

    private void ToggleReasoningExpanded() => _reasoningExpanded = !_reasoningExpanded;
}
