@using System.Windows.Input
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.UI.Shared.Components.Markdown
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<AIResource> L

<div class="message-wrapper @(IsUser ? "user-message" : "assistant-message")">
    <MudStack Row="true" Spacing="2" Class="message-content-stack">
        @if (!IsUser)
        {
            <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="message-avatar">
                <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
            </MudAvatar>
        }

        @if (IsUser)
        {
            @* User message - show bubble and actions only when NOT editing *@
            @if (!_isEditing)
            {
                <div class="user-message-container">
                    @* Action buttons outside bubble, top-left *@
                    <div class="user-actions">
                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                                       OnClick="@HandleCopy" Class="user-action-button" title="Copy" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                       OnClick="@HandleStartEdit" Class="user-action-button" title="Edit" />
                    </div>

                    @* The bubble itself *@
                    <div class="message-content user-bubble">
                        <MudText Typo="Typo.body1" Class="message-text">
                            <AgentCapabilityReferenceText Text="@Message.Content" />
                        </MudText>
                        <div class="message-meta">
                            <MudText Typo="Typo.caption" Class="message-time">
                                @Message.CreatedAt.ToLocalTime().ToString("HH:mm")
                            </MudText>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            @* AI message - keep current structure with actions inside *@
            <div class="message-content assistant-bubble">
                @if (!string.IsNullOrEmpty(Message.ReasoningContent))
                {
                    <div class="reasoning-section">
                        <div class="reasoning-header reasoning-header-clickable"
                             @onclick="ToggleReasoningExpanded">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="reasoning-label">
                                @if (Message.ReasoningDurationSeconds.HasValue)
                                {
                                    @($"Thought for {Message.ReasoningDurationSeconds.Value:F1} seconds")
                                }
                                else
                                {
                                    @("Reasoning")
                                }
                            </MudText>
                            <MudIcon Icon="@(_reasoningExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                     Size="Size.Small" Class="reasoning-chevron" />
                        </div>
                        @if (_reasoningExpanded)
                        {
                            <div class="reasoning-body">
                                <MudText Typo="Typo.body2" Class="reasoning-text">@Message.ReasoningContent</MudText>
                            </div>
                        }
                    </div>
                }
                <ToolCallDetail ToolCalls="@Message.ToolCalls"
                                EnableDebugMode="@ToolDebugEnabled" />
                @if (EnableMarkdown)
                {
                    <MoMarkdown Value="@Message.Content"
                                EnableMermaid="true"
                                Props="@_assistantMarkdownProps" />
                }
                else
                {
                    <MudText Typo="Typo.body1" Class="message-text">@Message.Content</MudText>
                }
                <div class="message-meta">
                    <MudText Typo="Typo.caption" Class="message-time">
                        @Message.CreatedAt.ToLocalTime().ToString("HH:mm")
                    </MudText>
                    @if (Message.Usage != null)
                    {
                        <MudText Typo="Typo.caption" Class="message-tokens">
                            @Message.Usage.TotalTokens tokens
                        </MudText>
                    }
                    <div class="message-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                       OnClick="@HandleCopy" Class="action-button" title="Copy" />
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                       OnClick="@HandleRetry" Class="action-button" title="Retry" />
                    </div>
                </div>
            </div>
        }

        @if (IsUser)
        {
            <MudAvatar Size="Size.Small" Color="Color.Primary" Class="message-avatar">
                <MudIcon Icon="@Icons.Material.Filled.Person" />
            </MudAvatar>
        }
    </MudStack>

    @* Edit mode: Separate input box below message *@
    @if (_isEditing)
    {
        <div class="edit-overlay">
            <MudTextField T="string" @bind-Value="_editContent"
                          Variant="Variant.Outlined"
                          Sizing="InputSizing.Auto" Lines="3" MaxLines="10"
                          Class="edit-input" />
            <div class="edit-buttons">
                <MudButton Variant="Variant.Text" OnClick="@HandleCancelEdit">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="@HandleSaveEdit" Disabled="@string.IsNullOrWhiteSpace(_editContent)">
                    Update
                </MudButton>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public required AIChatMessage Message { get; set; }
    [Parameter] public bool EnableMarkdown { get; set; } = true;
    [Parameter] public bool ToolDebugEnabled { get; set; }
    [Parameter] public EventCallback<(AIChatMessage Message, string NewContent)> OnEdit { get; set; }
    [Parameter] public EventCallback<AIChatMessage> OnRetry { get; set; }

    private bool IsUser => Message.Role == AIChatRole.User;
    private bool _isEditing;
    private string _editContent = string.Empty;
    private bool _reasoningExpanded;
    private readonly MudMarkdownProps _assistantMarkdownProps = new();
    private ICommand? _assistantMarkdownLinkCommand;

    protected override void OnInitialized()
    {
        _assistantMarkdownLinkCommand = new AsyncCommand(HandleMarkdownLinkClickAsync);
        _assistantMarkdownProps.Link.Command = _assistantMarkdownLinkCommand;
    }

    private async Task HandleCopy()
    {
        var success = await JSRuntime.InvokeAsync<bool>("MoClipboard.copyText", Message.Content);
        Snackbar.Add(success ? "Copied to clipboard" : "Failed to copy",
                     success ? Severity.Success : Severity.Error);
    }

    private void HandleStartEdit()
    {
        _editContent = Message.Content;
        _isEditing = true;
    }

    private void HandleCancelEdit()
    {
        _isEditing = false;
        _editContent = string.Empty;
    }

    private async Task HandleSaveEdit()
    {
        if (string.IsNullOrWhiteSpace(_editContent))
        {
            Snackbar.Add("Message cannot be empty", Severity.Warning);
            return;
        }

        _isEditing = false;
        await OnEdit.InvokeAsync((Message, _editContent));
        _editContent = string.Empty;
    }

    private async Task HandleRetry()
    {
        await OnRetry.InvokeAsync(Message);
    }

    private void ToggleReasoningExpanded()
    {
        _reasoningExpanded = !_reasoningExpanded;
    }

    private async Task HandleMarkdownLinkClickAsync(object? parameter)
    {
        try
        {
            if (parameter is not string targetUrl || string.IsNullOrWhiteSpace(targetUrl))
            {
                return;
            }

            if (TryResolveMarkdownSourcePath(targetUrl, out var sourcePath))
            {
                var parameters = new DialogParameters
                {
                    [nameof(ChatSourcePreviewDialog.SourcePath)] = sourcePath
                };

                await DialogService.ShowAsync<ChatSourcePreviewDialog>(
                    L["Chat:SourcePreview:Title"],
                    parameters,
                    new DialogOptions
                    {
                        CloseButton = true,
                        FullWidth = true,
                        MaxWidth = MaxWidth.Large
                    });
                return;
            }

            if (IsExternalUrl(targetUrl))
            {
                await JSRuntime.InvokeVoidAsync("open", targetUrl, "_blank");
                return;
            }

            NavigationManager.NavigateTo(targetUrl);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Chat:SourcePreview:OpenFailed"]}: {ex.Message}", Severity.Error);
        }
    }

    private static bool TryResolveMarkdownSourcePath(string rawUrl, out string sourcePath)
    {
        sourcePath = string.Empty;
        if (string.IsNullOrWhiteSpace(rawUrl))
        {
            return false;
        }

        var trimmedUrl = rawUrl.Trim();
        if (trimmedUrl.StartsWith('#'))
        {
            return false;
        }

        if (Uri.TryCreate(trimmedUrl, UriKind.Absolute, out var absoluteUri))
        {
            if (!string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
                && !string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            var absolutePath = Uri.UnescapeDataString(absoluteUri.AbsolutePath);
            if (!absolutePath.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            sourcePath = NormalizeSourcePath(absolutePath);
            return !string.IsNullOrWhiteSpace(sourcePath);
        }

        var withoutFragment = trimmedUrl.Split(['#', '?'], 2)[0];
        if (!withoutFragment.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        sourcePath = NormalizeSourcePath(withoutFragment);
        return !string.IsNullOrWhiteSpace(sourcePath);
    }

    private static bool IsExternalUrl(string targetUrl)
        => Uri.TryCreate(targetUrl, UriKind.Absolute, out var absoluteUri)
           && (string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
               || string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase));

    private static string NormalizeSourcePath(string value)
        => Uri.UnescapeDataString(value.Replace('\\', '/')).Trim().TrimStart('/');

    private sealed class AsyncCommand(Func<object?, Task> executeAsync) : ICommand
    {
        public event EventHandler? CanExecuteChanged
        {
            add { }
            remove { }
        }

        public bool CanExecute(object? parameter) => true;

        public async void Execute(object? parameter)
        {
            try
            {
                await executeAsync(parameter);
            }
            catch
            {
            }
        }
    }
}
