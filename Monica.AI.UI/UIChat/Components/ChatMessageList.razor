@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIChat.State
@using Monica.AI.UI.UIChat.Support
@implements IAsyncDisposable
@inject IStringLocalizer<AIResource> L

<div class="message-list" @ref="_messageListRef">
    @if (Messages.Count == 0 && StreamingState == null)
    {
        <div class="welcome-panel">
            <div class="welcome-icon">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Large" Color="Color.Primary" />
            </div>
            <MudText Typo="Typo.h5">@L["Chat:Welcome:Title"]</MudText>
            <MudText Typo="Typo.body2" Class="welcome-subtitle">
                @L["Chat:Welcome:Subtitle"]
            </MudText>
            <div class="welcome-grid">
                <MudPaper Class="welcome-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">@L["Chat:Welcome:Cards:UI:Title"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Chat:Welcome:Cards:UI:Subtitle"]</MudText>
                </MudPaper>
                <MudPaper Class="welcome-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">@L["Chat:Welcome:Cards:Docs:Title"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Chat:Welcome:Cards:Docs:Subtitle"]</MudText>
                </MudPaper>
                <MudPaper Class="welcome-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">@L["Chat:Welcome:Cards:Error:Title"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Chat:Welcome:Cards:Error:Subtitle"]</MudText>
                </MudPaper>
                <MudPaper Class="welcome-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">@L["Chat:Welcome:Cards:Script:Title"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Chat:Welcome:Cards:Script:Subtitle"]</MudText>
                </MudPaper>
            </div>
        </div>
    }
    else
    {
        @foreach (var message in Messages)
        {
            @if (message.Kind == AIChatMessageKind.Error)
            {
                <ChatErrorMessageItem Message="@message" OnRetry="@OnRetryMessage" />
            }
            else
            {
                <ChatMessageItem Message="@message" EnableMarkdown="@EnableMarkdown"
                                 ToolDebugEnabled="@ToolDebugEnabled"
                                 OnEdit="@OnEditMessage" OnRetry="@OnRetryMessage" />
            }
        }

        @if (StreamingState != null)
        {
            <StreamingMessageItem
                State="@StreamingState"
                EnableMarkdown="@EnableMarkdown"
                ToolDebugEnabled="@ToolDebugEnabled" />
        }
    }
</div>

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    [Parameter] public IReadOnlyList<AIChatMessage> Messages { get; set; } = [];
    [Parameter] public ChatStreamingState? StreamingState { get; set; }
    [Parameter] public bool EnableMarkdown { get; set; } = true;
    [Parameter] public bool ToolDebugEnabled { get; set; }
    [Parameter] public bool EnableAutoScroll { get; set; } = true;
    [Parameter] public EventCallback<(AIChatMessage Message, string NewContent)> OnEditMessage { get; set; }
    [Parameter] public EventCallback<AIChatMessage> OnRetryMessage { get; set; }

    private ElementReference _messageListRef;
    private ChatMessageListInteropSession? _interopSession;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_disposed && firstRender && EnableAutoScroll)
        {
            _interopSession = new ChatMessageListInteropSession(JSRuntime);
            await _interopSession.InitializeAsync(_messageListRef);
        }
    }

    /// <summary>
    /// Scroll to the bottom of the message list
    /// </summary>
    public async Task ScrollToBottomAsync()
    {
        if (!_disposed && _interopSession is not null)
        {
            await _interopSession.ScrollToBottomAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var interopSession = _interopSession;
        _interopSession = null;
        if (interopSession is not null)
        {
            await interopSession.DisposeAsync();
        }
    }
}
