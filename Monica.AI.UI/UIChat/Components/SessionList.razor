@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L

<div class="session-list">
    <div class="session-header">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="new-chat-button"
                   Disabled="@IsLoading"
                   OnClick="@HandleNewSession">
            @L["Session:NewChat"]
        </MudButton>
    </div>

    <div class="session-subtitle-row">
        <MudText Typo="Typo.caption">@L["Session:RecentSessions"]</MudText>
        @if (!IsLoading && Sessions.Count > 0)
        {
            <MudTooltip Text="@L["Chat:History:Clear:Action"]">
                <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                               Size="Size.Small"
                               Color="Color.Error"
                               aria-label="@L["Chat:History:Clear:Action"]"
                               OnClick="@HandleClearSessions" />
            </MudTooltip>
        }
    </div>

    <div class="session-list-content" aria-busy="@IsLoading.ToString().ToLowerInvariant()">
        @if (IsLoading)
        {
            <div class="session-loading" role="status">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.body2">@L["Chat:History:Loading"]</MudText>
            </div>
        }
        else if (Sessions.Count == 0)
        {
            <div class="empty-sessions">
                <MudText Typo="Typo.body2" Color="Color.Default">@L["Session:NoConversations"]</MudText>
            </div>
        }
        else
        {
            <MudList T="string"
                     Dense="true"
                     Class="session-list-items"
                     SelectedValue="@CurrentSessionId"
                     SelectedValueChanged="@HandleSelectSession">
                @foreach (var session in Sessions)
                {
                    <SessionListItem
                        Session="@session"
                        OnDelete="@(() => HandleDeleteSession(session.SessionId))" />
                }
            </MudList>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ChatSessionSummary> Sessions { get; set; } = [];
    [Parameter] public string? CurrentSessionId { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnNewSession { get; set; }
    [Parameter] public EventCallback<string> OnSelectSession { get; set; }
    [Parameter] public EventCallback<string> OnDeleteSession { get; set; }
    [Parameter] public EventCallback OnClearSessions { get; set; }

    private async Task HandleNewSession()
    {
        await OnNewSession.InvokeAsync();
    }

    private async Task HandleSelectSession(string? sessionId)
    {
        if (!IsLoading && sessionId is not null && sessionId != CurrentSessionId)
        {
            await OnSelectSession.InvokeAsync(sessionId);
        }
    }

    private async Task HandleDeleteSession(string sessionId)
    {
        await OnDeleteSession.InvokeAsync(sessionId);
    }

    private async Task HandleClearSessions()
    {
        await OnClearSessions.InvokeAsync();
    }
}
