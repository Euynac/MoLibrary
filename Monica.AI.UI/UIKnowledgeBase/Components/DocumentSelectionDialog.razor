@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.Markdown.Models
@inject IStringLocalizer<AIResource> L

<MudDialog>
    <DialogContent>
        <div class="document-selection-content">
            <div class="selection-header">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L["RAG:DocumentSelection:Selected", SelectedDocuments.Count]
                </MudText>
                <div class="selection-actions">
                    <MudButton Size="Size.Small"
                               OnClick="SelectAll"
                               Disabled="@(SelectedDocuments.Count == AvailableDocuments.Count)">
                        @L["RAG:DocumentSelection:SelectAll"]
                    </MudButton>
                    <MudButton Size="Size.Small"
                               OnClick="DeselectAll"
                               Disabled="@(SelectedDocuments.Count == 0)">
                        @L["RAG:DocumentSelection:DeselectAll"]
                    </MudButton>
                </div>
            </div>

            <MudDivider Class="my-3" />

            <div class="document-list">
                @foreach (var doc in AvailableDocuments)
                {
                    <div class="document-item">
                        <MudCheckBox T="bool"
                                     Value="@SelectedDocuments.Contains(doc.RelativePath)"
                                     ValueChanged="@((bool value) => ToggleDocument(doc.RelativePath, value))"
                                     Color="Color.Primary"
                                     Dense="true" />
                        <div class="document-info">
                            <MudText Typo="Typo.body2">@doc.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @doc.RelativePath
                            </MudText>
                        </div>
                        @if (ExistingDocumentIds.Contains(doc.RelativePath))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                @L["KnowledgeBase:DocumentImport:AlreadyAdded"]
                            </MudChip>
                        }
                    </div>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(SelectedDocuments.Count == 0)">
            @L["KnowledgeBase:DocumentImport:Add"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public List<MarkdownDocument> AvailableDocuments { get; set; } = new();

    [Parameter]
    public HashSet<string> ExistingDocumentIds { get; set; } = new();

    private HashSet<string> SelectedDocuments { get; set; } = new();

    private async Task ToggleDocument(string documentId, bool isChecked)
    {
        if (isChecked)
        {
            if (!SelectedDocuments.Contains(documentId))
                SelectedDocuments.Add(documentId);
        }
        else
        {
            SelectedDocuments.Remove(documentId);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectAll()
    {
        SelectedDocuments = AvailableDocuments.Select(d => d.RelativePath).ToHashSet();
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeselectAll()
    {
        SelectedDocuments.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(SelectedDocuments.ToList()));
    }
}
