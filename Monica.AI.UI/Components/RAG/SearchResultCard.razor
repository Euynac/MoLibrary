@using Monica.AI.RAG.Models

<div class="result-card-wrapper" @onclick="HandleClick">
    <div class="result-card">
        <!-- Score header row with badge + progress bar -->
        <div class="result-score-row">
            <span class="score-badge score-badge--@GetScoreLevel()">
                @($"{(Result.Score ?? 0) * 100:F0}%")
            </span>
            <div class="score-bar-track">
                <div class="score-bar-fill score-bar-fill--@GetScoreLevel()"
                     style="width: @($"{(Result.Score ?? 0) * 100:F0}%")"></div>
            </div>
        </div>

        <!-- Content area -->
        <div class="result-body">
            <div class="result-meta">
                <span class="result-source-name">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="source-icon" />
                    @(Result.SourceName ?? "Unknown")
                </span>
                @if (!string.IsNullOrEmpty(Result.SectionPath))
                {
                    <span class="meta-separator">·</span>
                    <span class="result-section">@Result.SectionPath</span>
                }
                <span class="meta-separator">·</span>
                <span class="result-view-link">View in document</span>
            </div>

            <p class="result-text">@Result.Text</p>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TextSearchResult Result { get; set; } = null!;

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetScoreLevel() => Result.Score switch
    {
        >= 0.8f => "high",
        >= 0.5f => "mid",
        _ => "low"
    };

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }
}
