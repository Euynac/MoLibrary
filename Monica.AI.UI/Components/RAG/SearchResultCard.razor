@using Monica.AI.RAG.Models

<div class="result-card-wrapper" @onclick="HandleClick">
    <MudPaper Class="result-card" Elevation="0">
        <div class="result-progress-header">
            <MudProgressLinear Value="@((Result.Score ?? 0) * 100)"
                               Color="@GetScoreColor()"
                               Size="Size.Small"
                               Class="score-progress" />
            <MudText Typo="Typo.caption" Class="score-text">
                @($"{Result.Score ?? 0:P0}")
            </MudText>
        </div>

        <div class="result-header">
            <div class="result-source">
                <MudText Typo="Typo.body2" Class="source-name">
                    @(Result.SourceName ?? "Unknown")
                </MudText>
                @if (!string.IsNullOrEmpty(Result.SectionPath))
                {
                    <MudText Typo="Typo.caption" Class="section-path">
                        @Result.SectionPath
                    </MudText>
                }
            </div>
        </div>

        <MudText Typo="Typo.body2" Class="result-content">
            @Result.Text
        </MudText>

        @if (!string.IsNullOrEmpty(Result.SourceLink))
        {
            <MudText Typo="Typo.caption" Class="result-link">
                @Result.SourceLink
            </MudText>
        }
    </MudPaper>
</div>

@code {
    [Parameter, EditorRequired]
    public TextSearchResult Result { get; set; } = null!;

    [Parameter]
    public EventCallback OnClick { get; set; }

    private Color GetScoreColor() => Result.Score switch
    {
        >= 0.8 => Color.Success,
        >= 0.5 => Color.Warning,
        _ => Color.Default
    };

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }
}
