@using Monica.AI.RAG.Models

@if (KnowledgeBases is { Count: > 0 })
{
    <MudTooltip Text="@GetTooltipText()">
        <MudBadge Content="@SelectedIds.Count" Color="Color.Info"
                  Visible="@(SelectedIds.Count > 0)" Overlap="true">
            <MudIconButton Icon="@Icons.Material.Filled.MenuBook"
                           Class="@($"kb-selector-button {(SelectedIds.Count > 0 ? "active" : "")}")"
                           OnClick="@TogglePopover" />
        </MudBadge>
    </MudTooltip>

    <MudPopover Open="@_popoverOpen" AnchorOrigin="Origin.TopCenter"
                TransformOrigin="Origin.BottomCenter" Class="kb-popover">
        <MudPaper Elevation="4" Class="kb-popover-content">
            <MudText Typo="Typo.subtitle2" Class="kb-popover-title">
                Knowledge Bases
            </MudText>
            <MudDivider />
            <div class="kb-list">
                @foreach (var kb in KnowledgeBases)
                {
                    var isSelected = SelectedIds.Contains(kb.Id);
                    <div class="kb-item @(isSelected ? "selected" : "")"
                         @onclick="() => ToggleKb(kb.Id)">
                        <MudCheckBox T="bool" Value="@isSelected" Dense="true"
                                     Color="Color.Info" ReadOnly="true" />
                        <div class="kb-item-info">
                            <MudText Typo="Typo.body2">@kb.Name</MudText>
                            @if (!string.IsNullOrEmpty(kb.Description))
                            {
                                <MudText Typo="Typo.caption" Class="kb-description">
                                    @kb.Description
                                </MudText>
                            }
                        </div>
                    </div>
                }
            </div>
        </MudPaper>
    </MudPopover>
}

@code {
    [Parameter] public IReadOnlyList<KnowledgeBase> KnowledgeBases { get; set; } = [];
    [Parameter] public List<string> SelectedIds { get; set; } = [];
    [Parameter] public EventCallback<List<string>> SelectedIdsChanged { get; set; }

    private bool _popoverOpen;

    private void TogglePopover() => _popoverOpen = !_popoverOpen;

    private async Task ToggleKb(string kbId)
    {
        var newList = new List<string>(SelectedIds);
        if (newList.Contains(kbId))
            newList.Remove(kbId);
        else
            newList.Add(kbId);

        SelectedIds = newList;
        await SelectedIdsChanged.InvokeAsync(newList);
    }

    private string GetTooltipText()
        => SelectedIds.Count > 0
            ? $"{SelectedIds.Count} knowledge base(s) selected"
            : "Select knowledge bases";
}
