@implements IAsyncDisposable

<div class="message-wrapper assistant-message">
    <MudStack Row="true" Spacing="2" Class="message-content-stack">
        <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="message-avatar">
            <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
        </MudAvatar>
        <div class="message-content assistant-bubble">
            @if (_hasError)
            {
                <div class="stream-error">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Color="Color.Error" />
                    <MudText Typo="Typo.body2" Color="Color.Error">@_errorMessage</MudText>
                </div>
            }
            else
            {
                @if (EnableMarkdown && !string.IsNullOrEmpty(_content))
                {
                    <MudMarkdown Value="@_content" />
                }
                else if (!string.IsNullOrEmpty(_content))
                {
                    <MudText Typo="Typo.body1" Class="message-text">@_content</MudText>
                }
                else if (_isStreaming)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="160px" />
                }
                @if (_isStreaming && !string.IsNullOrEmpty(_content))
                {
                    <span class="typing-indicator"></span>
                }
            }
        </div>
    </MudStack>
</div>

@code {
    [Parameter] public IAsyncEnumerable<ChatResponseUpdate>? StreamingContent { get; set; }
    [Parameter] public EventCallback<string> OnStreamComplete { get; set; }
    [Parameter] public EventCallback<string> OnStreamError { get; set; }
    [Parameter] public CancellationToken ExternalCancellationToken { get; set; }
    [Parameter] public bool EnableMarkdown { get; set; } = true;

    private string _content = string.Empty;
    private bool _isStreaming = true;
    private bool _hasError;
    private string? _errorMessage;
    private CancellationTokenSource? _cts;
    private bool _hasStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && StreamingContent != null && !_hasStarted)
        {
            _hasStarted = true;
            _cts = new CancellationTokenSource();
            // Use Task.Run to ensure fire-and-forget is properly tracked
            _ = Task.Run(ConsumeStreamAsync);
        }
    }

    private async Task ConsumeStreamAsync()
    {
        if (StreamingContent == null) return;

        using var linkedCts = CancellationTokenSource.CreateLinkedTokenSource(
            _cts!.Token,
            ExternalCancellationToken);

        try
        {
            await foreach (var update in StreamingContent.WithCancellation(linkedCts.Token))
            {
                if (!string.IsNullOrEmpty(update.Text))
                {
                    _content += update.Text;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Cancellation is normal behavior - preserve partial content
        }
        catch (HttpRequestException ex)
        {
            await HandleStreamError($"Network error: {ex.Message}");
        }
        catch (TimeoutException ex)
        {
            await HandleStreamError($"Request timed out: {ex.Message}");
        }
        catch (Exception ex)
        {
            await HandleStreamError($"Error: {ex.Message}");
        }
        finally
        {
            _isStreaming = false;
            await InvokeAsync(StateHasChanged);
            await InvokeAsync(() => OnStreamComplete.InvokeAsync(_content));
        }
    }

    private async Task HandleStreamError(string message)
    {
        _hasError = true;
        _errorMessage = message;
        await InvokeAsync(StateHasChanged);
        await InvokeAsync(() => OnStreamError.InvokeAsync(message));
    }

    /// <summary>
    /// Cancel the ongoing stream
    /// </summary>
    public async Task CancelAsync()
    {
        if (_cts != null && !_cts.IsCancellationRequested)
        {
            await _cts.CancelAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts != null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = null;
        }
    }
}
