@using Monica.AI.Models
@implements IAsyncDisposable

<div class="message-list" @ref="_messageListRef">
    @if (Messages.Count == 0 && StreamingContent == null)
    {
        <div class="welcome-panel">
            <div class="welcome-icon">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Large" Color="Color.Primary" />
            </div>
            <MudText Typo="Typo.h5">今天想聊点什么？</MudText>
            <MudText Typo="Typo.body2" Class="welcome-subtitle">
                支持多个 Provider，直接提问代码、写作或分析任务。
            </MudText>
            <div class="welcome-grid">
                <MudPaper Class="welcome-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">优化前端交互</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">给出按钮与动效建议</MudText>
                </MudPaper>
                <MudPaper Class="welcome-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">生成接口文档</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">根据 API 设计输出说明</MudText>
                </MudPaper>
                <MudPaper Class="welcome-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">分析一段错误</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">定位日志与异常原因</MudText>
                </MudPaper>
                <MudPaper Class="welcome-card" Elevation="0">
                    <MudText Typo="Typo.subtitle2">写一段脚本</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">自动化常见开发任务</MudText>
                </MudPaper>
            </div>
        </div>
    }
    else
    {
        @foreach (var message in Messages)
        {
            <ChatMessageItem Message="@message" EnableMarkdown="@EnableMarkdown"
                             OnEdit="@OnEditMessage" OnRetry="@OnRetryMessage" />
        }

        @if (StreamingContent != null)
        {
            <StreamingMessageItem
                @ref="_streamingItemRef"
                StreamingContent="@StreamingContent"
                EnableMarkdown="@EnableMarkdown"
                ExternalCancellationToken="@CancellationToken"
                OnStreamComplete="@HandleStreamComplete"
                OnStreamError="@HandleStreamError" />
        }
    }
</div>

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    [Parameter] public IReadOnlyList<AIChatMessage> Messages { get; set; } = [];
    [Parameter] public IAsyncEnumerable<ChatResponseUpdate>? StreamingContent { get; set; }
    [Parameter] public bool EnableMarkdown { get; set; } = true;
    [Parameter] public bool EnableAutoScroll { get; set; } = true;
    [Parameter] public CancellationToken CancellationToken { get; set; }
    [Parameter] public EventCallback<string> OnStreamComplete { get; set; }
    [Parameter] public EventCallback<string> OnStreamError { get; set; }
    [Parameter] public EventCallback<(AIChatMessage Message, string NewContent)> OnEditMessage { get; set; }
    [Parameter] public EventCallback<AIChatMessage> OnRetryMessage { get; set; }

    private ElementReference _messageListRef;
    private StreamingMessageItem? _streamingItemRef;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _autoScrollInstance;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && EnableAutoScroll)
        {
            await InitializeAutoScrollAsync();
        }
    }

    private async Task InitializeAutoScrollAsync()
    {
        try
        {
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Monica.AI.UI/Components/Chat/ChatMessageList.razor.js");

            _autoScrollInstance = await _jsModule.InvokeAsync<IJSObjectReference>(
                "initAutoScroll",
                _messageListRef);
        }
        catch (JSException)
        {
            // JS interop may fail during prerendering, ignore silently
        }
    }

    private async Task HandleStreamComplete(string content)
    {
        await OnStreamComplete.InvokeAsync(content);
    }

    private async Task HandleStreamError(string error)
    {
        await OnStreamError.InvokeAsync(error);
    }

    /// <summary>
    /// Cancel the ongoing stream
    /// </summary>
    public async Task CancelStreamAsync()
    {
        if (_streamingItemRef != null)
        {
            await _streamingItemRef.CancelAsync();
        }
    }

    /// <summary>
    /// Scroll to the bottom of the message list
    /// </summary>
    public async Task ScrollToBottomAsync()
    {
        if (_jsModule != null && _autoScrollInstance != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("scrollToBottom", _autoScrollInstance);
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected, ignore
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null && _autoScrollInstance != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("disposeAutoScroll", _autoScrollInstance);
                await _autoScrollInstance.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected, ignore
            }
        }

        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected, ignore
            }
        }
    }
}
