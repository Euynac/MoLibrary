@using Microsoft.Extensions.Localization
@using ModelContextProtocol.Client
@using Monica.AI.Facades
@using Monica.AI.Mcp.Models
@using Monica.AI.UI.Localization
@using Monica.Core.Results
@inject AgentCapabilityFacade CapabilityFacade
@inject ISnackbar Snackbar
@inject IStringLocalizer<AIResource> L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField T="string"
                              Value="@Name"
                              ValueChanged="OnNameChanged"
                              Label="@L["Capabilities:Mcp:Dialog:Name"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Disabled="@IsEdit"
                              Required="true"
                              RequiredError="@L["Common:Validation:Required"]" />

                <MudTextField T="string"
                              @bind-Value="@Description"
                              Label="@L["Capabilities:Mcp:Dialog:Description"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="2"
                              Required="true"
                              RequiredError="@L["Common:Validation:Required"]" />

                <MudTextField T="string"
                              @bind-Value="@Endpoint"
                              Label="@L["Capabilities:Mcp:Dialog:Endpoint"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Required="true"
                              RequiredError="@L["Common:Validation:Required"]"
                              Error="@(!string.IsNullOrWhiteSpace(EndpointValidationMessage))"
                              ErrorText="@EndpointValidationMessage" />

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="7">
                        <MudSelect T="HttpTransportMode"
                                   @bind-Value="@TransportMode"
                                   Label="@L["Capabilities:Mcp:Dialog:TransportMode"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="HttpTransportMode" Value="HttpTransportMode.AutoDetect">AutoDetect</MudSelectItem>
                            <MudSelectItem T="HttpTransportMode" Value="HttpTransportMode.StreamableHttp">StreamableHttp</MudSelectItem>
                            <MudSelectItem T="HttpTransportMode" Value="HttpTransportMode.Sse">Sse</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudNumericField T="int"
                                         @bind-Value="@ConnectionTimeoutSeconds"
                                         Label="@L["Capabilities:Mcp:Dialog:Timeout"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1"
                                         Max="300" />
                    </MudItem>
                </MudGrid>

                <MudSwitch T="bool"
                           @bind-Value="@IsAgentToolEnabled"
                           Color="Color.Primary"
                           Label="@L["Capabilities:Mcp:Dialog:ExposeTools"]" />

                <div class="headers-section">
                    <div class="headers-title-row">
                        <MudText Typo="Typo.subtitle2">@L["Capabilities:Mcp:Dialog:Headers"]</MudText>
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddHeader">
                            @L["Capabilities:Mcp:Dialog:AddHeader"]
                        </MudButton>
                    </div>

                    @if (_headers.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["Capabilities:Mcp:Dialog:NoHeaders"]
                        </MudText>
                    }
                    else
                    {
                        <div class="headers-list">
                            @foreach (var header in _headers)
                            {
                                <div class="header-row">
                                    <MudTextField T="string"
                                                  @bind-Value="@header.Name"
                                                  Label="@L["Capabilities:Mcp:Dialog:HeaderName"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true" />
                                    <MudTextField T="string"
                                                  @bind-Value="@header.Value"
                                                  Label="@L["Capabilities:Mcp:Dialog:HeaderValue"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  InputType="InputType.Password" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RemoveHeader(header))" />
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (_lastTestResult is not null)
                {
                    <MudAlert Severity="@(_lastTestResult.Success ? Severity.Success : Severity.Error)" Dense="true">
                        @_lastTestResult.Message
                    </MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common:Cancel"]</MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.NetworkPing"
                   Disabled="@(_isTesting || !CanSubmit)"
                   OnClick="TestAsync">
            @if (_isTesting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            @L["Capabilities:Mcp:Test"]
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(!CanSubmit)"
                   OnClick="Submit">
            @(SubmitText ?? L["Common:Actions:Save"].Value)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ExternalMcpClientProfile? Profile { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public string? SubmitText { get; set; }

    private MudForm? _form;
    private readonly List<HeaderRow> _headers = [];
    private McpConnectivityTestResult? _lastTestResult;
    private bool _initialized;
    private bool _isTesting;

    private string Name { get; set; } = string.Empty;
    private string Description { get; set; } = string.Empty;
    private string Endpoint { get; set; } = string.Empty;
    private HttpTransportMode TransportMode { get; set; } = HttpTransportMode.AutoDetect;
    private int ConnectionTimeoutSeconds { get; set; } = 30;
    private bool IsAgentToolEnabled { get; set; } = true;

    private string? EndpointValidationMessage
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Endpoint))
            {
                return null;
            }

            return Uri.TryCreate(Endpoint.Trim(), UriKind.Absolute, out var uri)
                   && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? null
                : L["Capabilities:Mcp:Dialog:EndpointInvalid"].Value;
        }
    }

    private bool CanSubmit
        => !string.IsNullOrWhiteSpace(Name)
           && !string.IsNullOrWhiteSpace(Description)
           && !string.IsNullOrWhiteSpace(Endpoint)
           && string.IsNullOrWhiteSpace(EndpointValidationMessage)
           && _headers.All(static header => !string.IsNullOrWhiteSpace(header.Name));

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            return;
        }

        if (Profile is not null)
        {
            Name = Profile.Name;
            Description = Profile.Description;
            Endpoint = Profile.Endpoint;
            TransportMode = Profile.TransportMode;
            ConnectionTimeoutSeconds = Profile.ConnectionTimeoutSeconds;
            IsAgentToolEnabled = Profile.IsAgentToolEnabled;
            _headers.AddRange(Profile.Headers.Select(static header => new HeaderRow(header.Key, header.Value)));
        }

        _initialized = true;
    }

    private Task OnNameChanged(string value)
    {
        Name = value.Trim();
        return Task.CompletedTask;
    }

    private void AddHeader()
    {
        _headers.Add(new HeaderRow());
    }

    private void RemoveHeader(HeaderRow header)
    {
        _headers.Remove(header);
    }

    private async Task TestAsync()
    {
        if (_isTesting || !CanSubmit)
        {
            return;
        }

        _isTesting = true;
        _lastTestResult = null;

        var result = await CapabilityFacade.TestExternalMcpProfileAsync(CreateProfile());
        if (result.IsFailed(out var error, out var connectivity))
        {
            AddErrorSnackbar(error.Message);
        }
        else
        {
            _lastTestResult = connectivity;
            Snackbar.Add(connectivity.Message, connectivity.Success ? Severity.Success : Severity.Error);
        }

        _isTesting = false;
    }

    private void Submit()
    {
        if (!CanSubmit)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(CreateProfile()));
    }

    private ExternalMcpClientProfile CreateProfile()
    {
        return new ExternalMcpClientProfile
        {
            Name = Name,
            Description = Description,
            Endpoint = Endpoint,
            TransportMode = TransportMode,
            ConnectionTimeoutSeconds = ConnectionTimeoutSeconds,
            Headers = _headers
                .Where(static header => !string.IsNullOrWhiteSpace(header.Name))
                .GroupBy(static header => header.Name.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    static group => group.Key,
                    static group => group.Last().Value?.Trim() ?? string.Empty,
                    StringComparer.OrdinalIgnoreCase),
            IsAgentToolEnabled = IsAgentToolEnabled,
            Origin = ExternalMcpClientProfileOrigin.User
        }.Normalize(ExternalMcpClientProfileOrigin.User);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void AddErrorSnackbar(string? message)
    {
        Snackbar.Add(string.IsNullOrWhiteSpace(message) ? L["Error:Generic"] : message, Severity.Error);
    }

    private sealed class HeaderRow(string name = "", string value = "")
    {
        public string Name { get; set; } = name;

        public string Value { get; set; } = value;
    }
}
