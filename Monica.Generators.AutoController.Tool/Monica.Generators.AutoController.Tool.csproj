<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>rpc-metadata-gen</AssemblyName>
  </PropertyGroup>

  <!-- Tool Package Configuration -->
  <PropertyGroup>
    <PackageId>Monica.Generators.AutoController.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rpc-metadata-gen</ToolCommandName>
    <PackageDescription>RPC Metadata Generator Tool for extracting metadata from Source Generator output in Monica framework.</PackageDescription>
  </PropertyGroup>

  <!-- Single-file publish configuration -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.template.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
