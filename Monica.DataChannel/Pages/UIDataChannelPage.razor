@attribute [Route(PAGE_URL)]
@using Monica.DataChannel.UIDataChannel.Models
@inject DataChannelFacade DataChannelService
@inject IDialogService DialogService
@inject IStringLocalizer<DataChannelResource> L
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>@L["Pages:DataChannelManage:Title"]</PageTitle>

<div class="data-channel-page mo-page-shell mo-page-shell--full-width">
    <header class="data-channel-header">
        <div class="data-channel-header__identity">
            <span class="data-channel-header__icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.DataObject" />
            </span>
            <div class="data-channel-header__copy">
                <MudText Typo="Typo.overline" Color="Color.Primary">@L["Console:Eyebrow"]</MudText>
                <MudText Typo="Typo.h4" Class="data-channel-title">@L["Console:Title"]</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Console:Subtitle"]</MudText>
            </div>
        </div>

        <div class="data-channel-header__actions">
            <MudButton StartIcon="@Icons.Material.Filled.ErrorOutline"
                       Variant="Variant.Outlined"
                       Color="Color.Error"
                       Disabled="@(_loading || _exceptionSummary is null)"
                       OnClick="OpenExceptionSummaryAsync">
                @L["Console:Actions:ExceptionEvidence"]
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Refresh"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@_loading"
                       OnClick="RefreshAsync">
                @L["Common:Actions:Refresh"]
            </MudButton>
        </div>
    </header>

    @if (_loading)
    {
        <section class="data-channel-state" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6">@L["Console:States:Loading"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Console:States:LoadingDescription"]</MudText>
        </section>
    }
    else
    {
        @if (_exceptionSummary is not null)
        {
            <section class="channel-summary" aria-label="@L["Console:Summary:AriaLabel"]">
                <article class="channel-summary__item">
                    <span class="channel-summary__icon channel-summary__icon--primary" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Hub" />
                    </span>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Console:Summary:TotalChannels"]</MudText>
                        <MudText Typo="Typo.h5" Class="channel-summary__value">@_exceptionSummary.TotalChannels</MudText>
                    </div>
                </article>
                <article class="channel-summary__item">
                    <span class="channel-summary__icon channel-summary__icon--success" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    </span>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Console:Summary:HealthyChannels"]</MudText>
                        <MudText Typo="Typo.h5" Class="channel-summary__value">@HealthyChannelCount</MudText>
                    </div>
                </article>
                <article class="channel-summary__item">
                    <span class="channel-summary__icon channel-summary__icon--error" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Error" />
                    </span>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Console:Summary:ChannelsWithExceptions"]</MudText>
                        <MudText Typo="Typo.h5" Class="channel-summary__value">@_exceptionSummary.ChannelsWithExceptions</MudText>
                    </div>
                </article>
                <article class="channel-summary__item">
                    <span class="channel-summary__icon channel-summary__icon--warning" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.History" />
                    </span>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Console:Summary:ExceptionHistory"]</MudText>
                        <MudText Typo="Typo.h5" Class="channel-summary__value">@_exceptionSummary.TotalHistoricalExceptions</MudText>
                    </div>
                </article>
            </section>
        }

        <section class="channel-directory" aria-labelledby="channel-directory-title">
            <div class="channel-directory__heading">
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Primary">@L["Console:Directory:Eyebrow"]</MudText>
                    <MudText Typo="Typo.h5" id="channel-directory-title">@L["Console:Directory:Title"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Console:Directory:Description"]</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                    @L["Console:Directory:ChannelCount", _channels.Count]
                </MudChip>
            </div>

            @if (_channels.Count > 0)
            {
                <div class="channel-grid">
                    @foreach (var channel in _channels)
                    {
                        <ChannelStatusCard Channel="channel"
                                           OnReInitialize="ReInitializeChannelAsync"
                                           OnViewExceptions="ViewChannelExceptionsAsync"
                                           OnClearExceptions="ClearChannelExceptionsAsync" />
                    }
                </div>
            }
            else
            {
                <div class="data-channel-empty">
                    <MudIcon Icon="@Icons.Material.Filled.PowerOff" Size="Size.Large" Color="Color.Default" />
                    <MudText Typo="Typo.h6">@L["Console:States:Empty"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Console:States:EmptyDescription"]</MudText>
                </div>
            }
        </section>
    }
</div>

@code {
    public const string PAGE_URL = "/datachannel-manage";

    private bool _loading = true;
    private bool _disposed;
    private List<DataChannelStatusInfo> _channels = [];
    private DataChannelExceptionSummaryInfo? _exceptionSummary;

    private int HealthyChannelCount => _channels.Count(channel =>
        channel.IsInitialized && !channel.IsNotAvailable && !channel.HasExceptions);

    protected override Task OnInitializedAsync()
    {
        return LoadDataAsync();
    }

    private async Task LoadDataAsync(bool announceSuccess = false)
    {
        if (_disposed || _loading && _channels.Count > 0)
        {
            return;
        }

        _loading = true;
        try
        {
            var channelsResult = await DataChannelService.GetChannelsStatusAsync();
            if (_disposed)
            {
                return;
            }

            if (channelsResult.IsFailed(out var channelsError, out var channels))
            {
                Snackbar.Add(L["Console:Messages:LoadChannelsFailed", channelsError], Severity.Error);
            }
            else
            {
                _channels = channels ?? [];
            }

            var summaryResult = await DataChannelService.GetExceptionSummaryAsync();
            if (_disposed)
            {
                return;
            }

            if (summaryResult.IsFailed(out var summaryError, out var summary))
            {
                Snackbar.Add(L["Console:Messages:LoadSummaryFailed", summaryError], Severity.Error);
            }
            else
            {
                _exceptionSummary = summary;
            }

            if (announceSuccess)
            {
                Snackbar.Add(L["Console:Messages:Refreshed"], Severity.Success);
            }
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add(L["Console:Messages:LoadFailed", ex.Message], Severity.Error);
            }
        }
        finally
        {
            if (!_disposed)
            {
                _loading = false;
            }
        }
    }

    private Task RefreshAsync() => LoadDataAsync(announceSuccess: true);

    private async Task OpenExceptionSummaryAsync()
    {
        var summary = await GetExceptionSummaryAsync();
        if (_disposed || summary is null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(ExceptionSummaryDialog.ExceptionSummary)] = summary,
            [nameof(ExceptionSummaryDialog.OnViewChannelExceptions)] = new Func<string, Task>(ViewChannelExceptionsAsync),
            [nameof(ExceptionSummaryDialog.OnClearChannelExceptions)] = new Func<string, Task>(ClearChannelExceptionsAsync),
            [nameof(ExceptionSummaryDialog.OnGetRefreshData)] = new Func<Task<DataChannelExceptionSummaryInfo?>>(GetExceptionSummaryAsync)
        };

        var dialog = await DialogService.ShowAsync<ExceptionSummaryDialog>(
            L["Exceptions:Summary:Title"],
            parameters,
            CreateEvidenceDialogOptions());
        var result = await dialog.Result;
        if (!_disposed && result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task<DataChannelExceptionSummaryInfo?> GetExceptionSummaryAsync()
    {
        try
        {
            var result = await DataChannelService.GetExceptionSummaryAsync();
            if (_disposed)
            {
                return null;
            }

            if (result.IsFailed(out var error, out var summary))
            {
                Snackbar.Add(L["Console:Messages:LoadSummaryFailed", error], Severity.Error);
                return null;
            }

            _exceptionSummary = summary;
            return summary;
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add(L["Console:Messages:LoadSummaryException", ex.Message], Severity.Error);
            }

            return null;
        }
    }

    private async Task ReInitializeChannelAsync(string channelId)
    {
        try
        {
            var result = await DataChannelService.ReInitializeChannelAsync(channelId);
            if (_disposed)
            {
                return;
            }

            if (result.IsFailed(out var error))
            {
                Snackbar.Add(L["Console:Messages:ReinitializeFailed", error], Severity.Error);
                return;
            }

            Snackbar.Add(L["Console:Messages:ReinitializeSucceeded", channelId], Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add(L["Console:Messages:ReinitializeException", ex.Message], Severity.Error);
            }
        }
    }

    private async Task ViewChannelExceptionsAsync(string channelId)
    {
        try
        {
            var result = await DataChannelService.GetChannelExceptionsAsync(channelId);
            if (_disposed)
            {
                return;
            }

            if (result.IsFailed(out var error, out var exceptions))
            {
                Snackbar.Add(L["Console:Messages:LoadExceptionsFailed", error], Severity.Error);
                return;
            }

            var parameters = new DialogParameters
            {
                [nameof(ExceptionDetailsDialog.ChannelId)] = channelId,
                [nameof(ExceptionDetailsDialog.ExceptionInfo)] = exceptions
            };

            var dialog = await DialogService.ShowAsync<ExceptionDetailsDialog>(
                L["Exceptions:Details:DialogTitle", channelId],
                parameters,
                CreateEvidenceDialogOptions());
            await dialog.Result;
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add(L["Console:Messages:LoadExceptionsException", ex.Message], Severity.Error);
            }
        }
    }

    private async Task ClearChannelExceptionsAsync(string channelId)
    {
        try
        {
            var result = await DataChannelService.ClearChannelExceptionsAsync(channelId);
            if (_disposed)
            {
                return;
            }

            if (result.IsFailed(out var error))
            {
                Snackbar.Add(L["Console:Messages:ClearExceptionsFailed", error], Severity.Error);
                return;
            }

            Snackbar.Add(L["Console:Messages:ClearExceptionsSucceeded", channelId], Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add(L["Console:Messages:ClearExceptionsException", ex.Message], Severity.Error);
            }
        }
    }

    private static DialogOptions CreateEvidenceDialogOptions() => new()
    {
        MaxWidth = MaxWidth.ExtraLarge,
        FullWidth = true,
        CloseButton = true,
        BackdropClick = true
    };

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        return ValueTask.CompletedTask;
    }
}
