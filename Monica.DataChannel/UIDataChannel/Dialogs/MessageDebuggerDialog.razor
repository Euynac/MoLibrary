@using Monica.DataChannel.Middlewares
@using Monica.DataChannel.Pipeline
@inject IStringLocalizer<DataChannelResource> L
@implements IAsyncDisposable

<MudDialog>
    <DialogContent>
        <div class="debugger-console">
            <section class="debugger-controls" aria-label="@L["Debugger:Controls:AriaLabel"]">
                <div class="debugger-controls__field debugger-controls__field--query">
                    <MudTextField @bind-Value="_filterKeyword"
                                  T="string"
                                  Label="@L["Debugger:Fields:FilterKeyword"]"
                                  Placeholder="@L["Debugger:Fields:FilterPlaceholder"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Disabled="@_isListening" />
                </div>
                <div class="debugger-controls__field">
                    <MudNumericField @bind-Value="_maxQueueSize"
                                     T="int"
                                     Label="@L["Debugger:Fields:QueueLength"]"
                                     Min="1"
                                     Max="1000"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Disabled="@_isListening" />
                </div>
                <MudButton Color="@(_isListening ? Color.Error : Color.Primary)"
                           Variant="Variant.Filled"
                           StartIcon="@(_isListening ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)"
                           OnClick="ToggleListeningAsync">
                    @(_isListening ? L["Debugger:Actions:Stop"] : L["Debugger:Actions:Start"])
                </MudButton>
            </section>

            <section class="debugger-stream" aria-labelledby="debugger-stream-title">
                <header class="debugger-stream__header">
                    <div>
                        <MudText Typo="Typo.overline" Color="@(_isListening ? Color.Success : Color.Secondary)">
                            @(_isListening ? L["Debugger:States:Listening"] : L["Debugger:States:Paused"])
                        </MudText>
                        <MudText Typo="Typo.h6" id="debugger-stream-title">@L["Debugger:CapturedMessages"]</MudText>
                    </div>
                    <div class="debugger-stream__tools">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Color="@(_isListening ? Color.Success : Color.Default)">
                            @L["Debugger:MessageCount", _messages.Count]
                        </MudChip>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ClearAll"
                                   OnClick="ClearMessages"
                                   Disabled="@(_messages.Count == 0)">
                            @L["Common:Actions:Clear"]
                        </MudButton>
                    </div>
                </header>

                @if (_messages.Count == 0)
                {
                    <div class="debugger-empty">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" />
                        <MudText Typo="Typo.subtitle1">@L["Debugger:States:NoMessages"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Debugger:States:NoMessagesDescription"]</MudText>
                    </div>
                }
                else
                {
                    <div class="debugger-message-list">
                        @foreach (var message in _messages.OrderByDescending(item => item.Timestamp))
                        {
                            var isExpanded = _expandedMessages.Contains(message);
                            <article class="debugger-message">
                                <button type="button"
                                        class="debugger-message__summary"
                                        @onclick="@(() => ToggleMessageExpansion(message))"
                                        aria-expanded="@isExpanded">
                                    <span class="debugger-message__direction debugger-message__direction--@GetSourceTone(message.Source)">
                                        <MudIcon Icon="@GetSourceIcon(message.Source)" Size="Size.Small" />
                                        <span>@GetSourceLabel(message.Source)</span>
                                    </span>
                                    <span class="debugger-message__type">@message.MessageType</span>
                                    <time class="debugger-message__time">@message.Timestamp.ToString("HH:mm:ss.fff")</time>
                                    @if (message.Metadata?.Count > 0)
                                    {
                                        <span class="debugger-message__metadata" title="@L["Debugger:MetadataAvailable"]">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                        </span>
                                    }
                                    <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                             Size="Size.Small" />
                                </button>

                                @if (!isExpanded)
                                {
                                    <p class="debugger-message__preview">@GetMessagePreview(message.FormattedContent)</p>
                                }
                                else
                                {
                                    <div class="debugger-message__details">
                                        <MudTabs Elevation="0" Rounded="true" Outlined="true" ApplyEffectsToContainer="true">
                                            <MudTabPanel Text="@L["Debugger:Tabs:FormattedContent"]" PanelClass="pa-0">
                                                <pre class="debugger-message__payload">@message.FormattedContent</pre>
                                            </MudTabPanel>
                                            @if (message.Metadata?.Count > 0)
                                            {
                                                <MudTabPanel Text="@L["Debugger:Tabs:Metadata"]" PanelClass="pa-3">
                                                    <MetadataDisplay Metadata="message.Metadata" />
                                                </MudTabPanel>
                                            }
                                        </MudTabs>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [Parameter, EditorRequired]
    public MessageDebuggerMiddleware Middleware { get; set; } = null!;

    private readonly CancellationTokenSource _lifetimeCts = new();
    private readonly HashSet<MessageDebuggerMiddleware.DebugMessage> _expandedMessages = [];
    private CancellationTokenSource? _refreshCts;
    private Task? _refreshTask;
    private string _filterKeyword = string.Empty;
    private int _maxQueueSize = 100;
    private bool _isListening;
    private bool _disposed;
    private List<MessageDebuggerMiddleware.DebugMessage> _messages = [];

    protected override void OnInitialized()
    {
        _filterKeyword = Middleware.FilterKeyword;
        _maxQueueSize = Middleware.MaxQueueSize;
        _isListening = Middleware.IsActive;
        RefreshMessages();
        if (_isListening)
        {
            StartRefreshLoop();
        }
    }

    private async Task ToggleListeningAsync()
    {
        if (_disposed)
        {
            return;
        }

        _isListening = !_isListening;
        if (_isListening)
        {
            Middleware.FilterKeyword = _filterKeyword;
            Middleware.MaxQueueSize = _maxQueueSize;
            Middleware.IsActive = true;
            RefreshMessages();
            StartRefreshLoop();
            return;
        }

        Middleware.IsActive = false;
        await StopRefreshLoopAsync();
    }

    private void StartRefreshLoop()
    {
        if (_disposed || _refreshTask is { IsCompleted: false })
        {
            return;
        }

        _refreshCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        _refreshTask = RefreshLoopAsync(_refreshCts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    if (_disposed)
                    {
                        return;
                    }

                    RefreshMessages();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Closing the dialog and pausing capture are normal cancellation paths.
        }
    }

    private async Task StopRefreshLoopAsync()
    {
        var refreshCts = _refreshCts;
        var refreshTask = _refreshTask;
        _refreshCts = null;
        _refreshTask = null;
        if (refreshCts is null)
        {
            return;
        }

        refreshCts.Cancel();
        if (refreshTask is not null)
        {
            await refreshTask;
        }

        refreshCts.Dispose();
    }

    private void RefreshMessages()
    {
        _messages = Middleware.GetDebugMessages();
    }

    private void ClearMessages()
    {
        Middleware.ClearDebugMessages();
        _messages = [];
        _expandedMessages.Clear();
    }

    private void ToggleMessageExpansion(MessageDebuggerMiddleware.DebugMessage message)
    {
        if (!_expandedMessages.Add(message))
        {
            _expandedMessages.Remove(message);
        }
    }

    private string GetMessagePreview(string content)
    {
        if (string.IsNullOrEmpty(content))
        {
            return L["Debugger:Values:EmptyMessage"];
        }

        var firstLine = content.Split('\n').FirstOrDefault() ?? content;
        return firstLine.Length > 120 ? $"{firstLine[..120]}…" : firstLine;
    }

    private string GetSourceLabel(ChannelSide source) => source == ChannelSide.Inner
        ? L["Debugger:Sources:Ingress"]
        : L["Debugger:Sources:Egress"];

    private static string GetSourceTone(ChannelSide source) => source == ChannelSide.Inner ? "ingress" : "egress";

    private static string GetSourceIcon(ChannelSide source) => source == ChannelSide.Inner
        ? Icons.Material.Filled.SouthEast
        : Icons.Material.Filled.NorthEast;

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _lifetimeCts.Cancel();
        await StopRefreshLoopAsync();
        _lifetimeCts.Dispose();
    }
}
