@using Monica.DataChannel.UIDataChannel.Models
@inject IStringLocalizer<DataChannelResource> L

<MudDialog>
    <TitleContent>
        <div class="exception-details-title">
            <span class="exception-details-title__icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
            </span>
            <div>
                <MudText Typo="Typo.h6">@L["Exceptions:Details:Title"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@ChannelId</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (ExceptionInfo is not null)
        {
            <div class="exception-details-dialog">
                <section class="exception-details-strip" aria-label="@L["Exceptions:Details:SummaryAriaLabel"]">
                    <article>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Exceptions:Columns:PipelineId"]</MudText>
                        <MudText Typo="Typo.subtitle1" Class="exception-identity">@ExceptionInfo.PipelineId</MudText>
                    </article>
                    <article>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Exceptions:Columns:CurrentCount"]</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Error">@ExceptionInfo.CurrentExceptions</MudText>
                    </article>
                    <article>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Exceptions:Columns:HistoricalCount"]</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Warning">@ExceptionInfo.TotalExceptions</MudText>
                    </article>
                    <article>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Exceptions:Columns:PoolSize"]</MudText>
                        <MudText Typo="Typo.h6">@ExceptionInfo.MaxPoolSize</MudText>
                    </article>
                </section>

                @if (ExceptionInfo.Exceptions.Count > 0)
                {
                    <div class="exception-records">
                        <MudDataGrid Items="ExceptionInfo.Exceptions"
                                     Filterable="true"
                                     SortMode="SortMode.Multiple"
                                     Hover="true"
                                     Dense="true"
                                     ReadOnly="true">
                            <Columns>
                                <PropertyColumn Property="item => item.Timestamp" Title="@L["Exceptions:Columns:Timestamp"]" Format="yyyy-MM-dd HH:mm:ss" />
                                <PropertyColumn Property="item => item.SourceType" Title="@L["Exceptions:Columns:SourceType"]" />
                                <PropertyColumn Property="item => item.ExceptionType" Title="@L["Exceptions:Columns:ExceptionType"]" />
                                <PropertyColumn Property="item => item.Message" Title="@L["Exceptions:Columns:Message"]" />
                                <PropertyColumn Property="item => item.Description" Title="@L["Exceptions:Columns:Description"]" />
                                <TemplateColumn Title="@L["Common:Columns:Actions"]">
                                    <CellTemplate>
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Text"
                                                   Color="Color.Info"
                                                   StartIcon="@Icons.Material.Filled.Info"
                                                   OnClick="@(() => SelectException(context.Item))">
                                            @L["Common:Actions:Details"]
                                        </MudButton>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </div>

                    @if (_selectedException is not null)
                    {
                        <section class="exception-inspector" aria-labelledby="exception-inspector-title">
                            <header class="exception-inspector__header">
                                <div>
                                    <MudText Typo="Typo.overline" Color="Color.Error">@L["Exceptions:Details:InspectorEyebrow"]</MudText>
                                    <MudText Typo="Typo.h6" id="exception-inspector-title">@L["Exceptions:Details:InspectorTitle"]</MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               OnClick="ClearSelection"
                                               aria-label="@L["Common:Actions:Close"]" />
                            </header>

                            <dl class="exception-facts">
                                <div>
                                    <dt>@L["Exceptions:Columns:Timestamp"]</dt>
                                    <dd>@_selectedException.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                                </div>
                                <div>
                                    <dt>@L["Exceptions:Columns:SourceType"]</dt>
                                    <dd>@_selectedException.SourceType</dd>
                                </div>
                                <div>
                                    <dt>@L["Exceptions:Columns:ExceptionType"]</dt>
                                    <dd>@_selectedException.ExceptionType</dd>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_selectedException.SourceDescription))
                                {
                                    <div>
                                        <dt>@L["Exceptions:Details:SourceDescription"]</dt>
                                        <dd>@_selectedException.SourceDescription</dd>
                                    </div>
                                }
                            </dl>

                            @if (!string.IsNullOrWhiteSpace(_selectedException.Description))
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                    @_selectedException.Description
                                </MudAlert>
                            }

                            <section class="exception-message">
                                <MudText Typo="Typo.subtitle2">@L["Exceptions:Details:MessageTitle"]</MudText>
                                <p>@_selectedException.Message</p>
                            </section>

                            @if (!string.IsNullOrWhiteSpace(_selectedException.StackTrace))
                            {
                                <section class="exception-stack">
                                    <MudText Typo="Typo.subtitle2">@L["Exceptions:Details:StackTraceTitle"]</MudText>
                                    <StackTraceViewer Message="@_selectedException.StackTrace" />
                                </section>
                            }
                        </section>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @L["Exceptions:Details:Empty"]
                    </MudAlert>
                }
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [Parameter, EditorRequired]
    public string ChannelId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public DataChannelExceptionInfo ExceptionInfo { get; set; } = null!;

    private ExceptionDetailInfo? _selectedException;

    private void SelectException(ExceptionDetailInfo exception)
    {
        _selectedException = exception;
    }

    private void ClearSelection()
    {
        _selectedException = null;
    }
}
