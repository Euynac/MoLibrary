@using Monica.DataChannel.UIDataChannel.Models
@inject IStringLocalizer<DataChannelResource> L

<MudDialog>
    <TitleContent>
        <div class="exception-dialog-title">
            <span class="exception-dialog-title__icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Analytics" />
            </span>
            <div>
                <MudText Typo="Typo.h6">@L["Exceptions:Summary:Title"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Exceptions:Summary:Subtitle"]</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (ExceptionSummary is not null)
        {
            <div class="exception-summary-dialog">
                <section class="exception-summary-strip" aria-label="@L["Exceptions:Summary:AriaLabel"]">
                    <article>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Console:Summary:TotalChannels"]</MudText>
                        <MudText Typo="Typo.h5">@ExceptionSummary.TotalChannels</MudText>
                    </article>
                    <article>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Console:Summary:ChannelsWithExceptions"]</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Error">@ExceptionSummary.ChannelsWithExceptions</MudText>
                    </article>
                    <article>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Exceptions:Summary:ActiveExceptions"]</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Warning">@ExceptionSummary.TotalCurrentExceptions</MudText>
                    </article>
                    <article>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Console:Summary:ExceptionHistory"]</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Info">@ExceptionSummary.TotalHistoricalExceptions</MudText>
                    </article>
                </section>

                @if (ExceptionSummary.ChannelSummaries.Count > 0)
                {
                    <section class="exception-directory" aria-labelledby="exception-directory-title">
                        <header class="exception-directory__header">
                            <div>
                                <MudText Typo="Typo.overline" Color="Color.Error">@L["Exceptions:Summary:DirectoryEyebrow"]</MudText>
                                <MudText Typo="Typo.h6" id="exception-directory-title">@L["Exceptions:Summary:DirectoryTitle"]</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">
                                @L["Exceptions:Summary:DirectoryCount", ExceptionSummary.ChannelSummaries.Count]
                            </MudChip>
                        </header>

                        <div class="exception-table">
                            <MudDataGrid Items="ExceptionSummary.ChannelSummaries"
                                         Filterable="true"
                                         SortMode="SortMode.Multiple"
                                         Hover="true"
                                         Dense="true"
                                         ReadOnly="true">
                                <Columns>
                                    <PropertyColumn Property="item => item.ChannelId" Title="@L["Exceptions:Columns:ChannelId"]" />
                                    <PropertyColumn Property="item => item.PipelineId" Title="@L["Exceptions:Columns:PipelineId"]" />
                                    <TemplateColumn Title="@L["Exceptions:Columns:Status"]">
                                        <CellTemplate>
                                            <MudChip T="string"
                                                     Color="@(context.Item.HasExceptions ? Color.Error : Color.Success)"
                                                     Size="Size.Small"
                                                     Variant="Variant.Outlined"
                                                     Icon="@(context.Item.HasExceptions ? Icons.Material.Filled.Error : Icons.Material.Filled.CheckCircle)">
                                                @(context.Item.HasExceptions ? L["Exceptions:States:Active"] : L["Exceptions:States:Healthy"])
                                            </MudChip>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Property="item => item.CurrentExceptionCount" Title="@L["Exceptions:Columns:CurrentCount"]" />
                                    <PropertyColumn Property="item => item.TotalExceptionCount" Title="@L["Exceptions:Columns:HistoricalCount"]" />
                                    <PropertyColumn Property="item => item.MaxPoolSize" Title="@L["Exceptions:Columns:PoolSize"]" />
                                    <TemplateColumn Title="@L["Exceptions:Columns:Latest"]">
                                        <CellTemplate>
                                            <span class="exception-table__timestamp">
                                                @(context.Item.LatestException?.ToString("yyyy-MM-dd HH:mm:ss") ?? L["Common:Values:None"])
                                            </span>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Exceptions:Columns:PoolUsage"]">
                                        <CellTemplate>
                                            @{ var usage = GetPoolUsage(context.Item); }
                                            <div class="exception-usage">
                                                <MudProgressLinear Color="@GetUsageColor(usage)" Value="@usage" />
                                                <span>@usage.ToString("F1")%</span>
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Common:Columns:Actions"]">
                                        <CellTemplate>
                                            <div class="exception-table__actions">
                                                <MudTooltip Text="@L["Channel:Actions:ViewExceptions"]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                                   Color="Color.Info"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => ViewChannelAsync(context.Item.ChannelId))"
                                                                   aria-label="@L["Channel:Actions:ViewExceptions"]" />
                                                </MudTooltip>
                                                @if (context.Item.HasExceptions)
                                                {
                                                    <MudTooltip Text="@L["Channel:Actions:ClearExceptions"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.ClearAll"
                                                                       Color="Color.Error"
                                                                       Size="Size.Small"
                                                                       OnClick="@(() => ClearChannelAsync(context.Item.ChannelId))"
                                                                       aria-label="@L["Channel:Actions:ClearExceptions"]" />
                                                    </MudTooltip>
                                                }
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        </div>
                    </section>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @L["Exceptions:Summary:NoChannels"]
                    </MudAlert>
                }
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [Parameter, EditorRequired]
    public DataChannelExceptionSummaryInfo ExceptionSummary { get; set; } = null!;

    [Parameter]
    public Func<string, Task>? OnViewChannelExceptions { get; set; }

    [Parameter]
    public Func<string, Task>? OnClearChannelExceptions { get; set; }

    [Parameter]
    public Func<Task<DataChannelExceptionSummaryInfo?>>? OnGetRefreshData { get; set; }

    private Task ViewChannelAsync(string channelId) =>
        OnViewChannelExceptions?.Invoke(channelId) ?? Task.CompletedTask;

    private async Task ClearChannelAsync(string channelId)
    {
        if (OnClearChannelExceptions is null)
        {
            return;
        }

        await OnClearChannelExceptions(channelId);
        if (OnGetRefreshData is not null && await OnGetRefreshData() is { } refreshedData)
        {
            ExceptionSummary = refreshedData;
        }
    }

    private static double GetPoolUsage(DataChannelExceptionSummaryItem item) => item.MaxPoolSize > 0
        ? Math.Clamp((double)item.CurrentExceptionCount / item.MaxPoolSize * 100, 0, 100)
        : 0;

    private static Color GetUsageColor(double usage) => usage switch
    {
        >= 80 => Color.Error,
        >= 50 => Color.Warning,
        > 0 => Color.Info,
        _ => Color.Success
    };
}
