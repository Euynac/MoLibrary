@using Monica.DataChannel.Middlewares
@using Monica.DataChannel.UIDataChannel.Abstractions
@using Monica.DataChannel.UIDataChannel.Models
@inject DataChannelFacade DataChannelService
@inject IDialogService DialogService
@inject IStringLocalizer<DataChannelResource> L
@inject IEnumerable<IDataChannelMiddlewareRowAction> MiddlewareRowActions
@inject ISnackbar Snackbar
@implements IDisposable

<article class="channel-card mo-card-surface" data-mo-card-tone="@GetCardTone()">
    <header class="channel-card__header">
        <div class="channel-card__identity">
            <span class="channel-card__state-icon" aria-hidden="true">
                <MudIcon Icon="@GetChannelIcon()" Color="@GetChannelColor()" />
            </span>
            <div class="channel-card__copy">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["Channel:IdentityLabel"]</MudText>
                <MudText Typo="Typo.h6" Class="channel-title">@Channel.Id</MudText>
            </div>
        </div>

        <div class="channel-card__status">
            <MudChip T="string"
                     Color="@GetChannelColor()"
                     Variant="Variant.Outlined"
                     Size="Size.Small"
                     Icon="@GetChannelIcon()">
                @GetChannelStateLabel()
            </MudChip>
            @if (Channel.HasExceptions)
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small">
                    @L["Channel:ExceptionCount", Channel.ExceptionCount]
                </MudChip>
            }
            @if (_isReinitializing)
            {
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         AriaLabel="@L["Channel:Actions:OpenMenu", Channel.Id]">
                    <MudMenuItem OnClick="ReinitializeAsync"
                                 Icon="@Icons.Material.Filled.Refresh">
                        @L["Channel:Actions:Reinitialize"]
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => OnViewExceptions.InvokeAsync(Channel.Id))"
                                 Icon="@Icons.Material.Filled.ErrorOutline">
                        @L["Channel:Actions:ViewExceptions"]
                    </MudMenuItem>
                    @if (Channel.HasExceptions)
                    {
                        <MudMenuItem OnClick="@(() => OnClearExceptions.InvokeAsync(Channel.Id))"
                                     Icon="@Icons.Material.Filled.ClearAll">
                            @L["Channel:Actions:ClearExceptions"]
                        </MudMenuItem>
                    }
                </MudMenu>
            }
        </div>
    </header>

    @if (_isReinitializing)
    {
        <div class="channel-card__busy" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <div>
                <MudText Typo="Typo.subtitle1">@L["Channel:States:Reinitializing"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Channel:States:ReinitializingDescription"]</MudText>
            </div>
        </div>
    }
    else
    {
        <section class="endpoint-flow" aria-label="@L["Channel:Flow:AriaLabel", Channel.Id]">
            <div class="endpoint-flow__node">
                <span class="endpoint-flow__icon endpoint-flow__icon--inner" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Input" Size="Size.Small" />
                </span>
                <div class="endpoint-flow__copy">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Channel:Flow:Ingress"]</MudText>
                    <MudText Typo="Typo.subtitle2" Class="endpoint-flow__name">@Channel.InnerEndpoint.Name</MudText>
                </div>
            </div>
            <div class="endpoint-flow__route" aria-hidden="true">
                <span></span>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                    @L["Channel:Flow:MiddlewareCount", Channel.Middlewares.Count]
                </MudChip>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            </div>
            <div class="endpoint-flow__node endpoint-flow__node--outbound">
                <span class="endpoint-flow__icon endpoint-flow__icon--outer" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Output" Size="Size.Small" />
                </span>
                <div class="endpoint-flow__copy">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Channel:Flow:Egress"]</MudText>
                    <MudText Typo="Typo.subtitle2" Class="endpoint-flow__name">@Channel.OuterEndpoint.Name</MudText>
                </div>
            </div>
        </section>

        <div class="channel-evidence">
            <MudExpansionPanels Elevation="0" Dense="true" Class="channel-evidence__panels">
                <MudExpansionPanel Text="@L["Channel:Sections:EndpointConfiguration"]"
                                   Icon="@Icons.Material.Filled.Cable">
                    <div class="endpoint-config-grid">
                        <section>
                            <MudText Typo="Typo.overline" Color="Color.Info">@L["Channel:Flow:Ingress"]</MudText>
                            <MetadataDisplay Metadata="Channel.InnerEndpoint.Metadata" />
                        </section>
                        <section>
                            <MudText Typo="Typo.overline" Color="Color.Success">@L["Channel:Flow:Egress"]</MudText>
                            <MetadataDisplay Metadata="Channel.OuterEndpoint.Metadata" />
                        </section>
                    </div>
                </MudExpansionPanel>

                @if (Channel.Middlewares.Count > 0)
                {
                    <MudExpansionPanel Text="@L["Channel:Sections:Pipeline", Channel.Middlewares.Count]"
                                       Icon="@Icons.Material.Filled.AccountTree">
                        <div class="middleware-list">
                            @foreach (var middleware in Channel.Middlewares)
                            {
                                <section class="middleware-row">
                                    <div class="middleware-row__summary">
                                        <span class="middleware-row__icon" aria-hidden="true">
                                            <MudIcon Icon="@GetComponentIcon(middleware.Type)"
                                                     Size="Size.Small"
                                                     Color="@GetComponentColor(middleware.Type)" />
                                        </span>
                                        <div class="middleware-row__copy">
                                            <MudText Typo="Typo.subtitle2" Class="middleware-name">@middleware.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetComponentTypeDisplayName(middleware.Type)</MudText>
                                        </div>
                                        <div class="middleware-row__actions">
                                            @if (middleware.Type == PipelineComponentKind.InfoDisplayMiddleware && middleware.InfoDictionary?.Count > 0)
                                            {
                                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                                    @L["Channel:Info:ItemCount", middleware.InfoDictionary.Count]
                                                </MudChip>
                                            }
                                            @if (middleware.Name == nameof(MessageDebuggerMiddleware))
                                            {
                                                <MudTooltip Text="@L["Debugger:Actions:Open"]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.BugReport"
                                                                   Color="Color.Primary"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => OpenMessageDebuggerAsync(Channel.Id, middleware))"
                                                                   aria-label="@L["Debugger:Actions:Open"]" />
                                                </MudTooltip>
                                            }
                                            @foreach (var action in GetMiddlewareRowActions(middleware))
                                            {
                                                <MudTooltip Text="@action.Tooltip">
                                                    <MudIconButton Icon="@action.Icon"
                                                                   Color="@action.Color"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => action.ExecuteAsync(Channel.Id, middleware))"
                                                                   aria-label="@action.Tooltip" />
                                                </MudTooltip>
                                            }
                                        </div>
                                    </div>

                                    @if (middleware.Type == PipelineComponentKind.InfoDisplayMiddleware && middleware.InfoDictionary?.Count > 0)
                                    {
                                        <dl class="middleware-facts">
                                            @foreach (var entry in middleware.InfoDictionary)
                                            {
                                                <div class="middleware-facts__row">
                                                    <dt>@entry.Key</dt>
                                                    <dd>@FormatInfoValue(entry.Value)</dd>
                                                </div>
                                            }
                                        </dl>
                                    }
                                    else
                                    {
                                        <MetadataDisplay Metadata="middleware.Metadata" />
                                    }
                                </section>
                            }
                        </div>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>

        @if (Channel.HasExceptions)
        {
            <footer class="channel-exception" aria-label="@L["Channel:Exceptions:AriaLabel"]">
                <span class="channel-exception__icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" />
                </span>
                <div>
                    <MudText Typo="Typo.subtitle2">@L["Channel:Exceptions:Active", Channel.ExceptionCount]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Channel:Exceptions:Historical", Channel.TotalExceptionCount]</MudText>
                </div>
                <MudSpacer />
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="@(() => OnViewExceptions.InvokeAsync(Channel.Id))">
                    @L["Channel:Actions:Inspect"]
                </MudButton>
            </footer>
        }
    }
</article>

@code {
    [Parameter, EditorRequired]
    public DataChannelStatusInfo Channel { get; set; } = null!;

    [Parameter]
    public EventCallback<string> OnReInitialize { get; set; }

    [Parameter]
    public EventCallback<string> OnViewExceptions { get; set; }

    [Parameter]
    public EventCallback<string> OnClearExceptions { get; set; }

    private bool _isReinitializing;
    private bool _disposed;

    private IEnumerable<IDataChannelMiddlewareRowAction> GetMiddlewareRowActions(PipelineComponentInfo middleware) =>
        MiddlewareRowActions
            .Where(action => action.IsVisible(Channel.Id, middleware))
            .OrderBy(action => action.Order);

    private async Task ReinitializeAsync()
    {
        if (_isReinitializing || _disposed)
        {
            return;
        }

        _isReinitializing = true;
        try
        {
            await OnReInitialize.InvokeAsync(Channel.Id);
        }
        finally
        {
            if (!_disposed)
            {
                _isReinitializing = false;
            }
        }
    }

    private string GetCardTone() => Channel switch
    {
        { IsNotAvailable: true } => "error",
        { HasExceptions: true } => "warning",
        { IsInitializing: true } => "info",
        { IsInitialized: true } => "success",
        _ => "neutral"
    };

    private string GetChannelIcon() => Channel switch
    {
        { IsNotAvailable: true } => Icons.Material.Filled.Cancel,
        { HasExceptions: true } => Icons.Material.Filled.Error,
        { IsInitializing: true } => Icons.Material.Filled.Sync,
        { IsInitialized: true } => Icons.Material.Filled.CheckCircle,
        _ => Icons.Material.Filled.RadioButtonUnchecked
    };

    private Color GetChannelColor() => Channel switch
    {
        { IsNotAvailable: true } => Color.Error,
        { HasExceptions: true } => Color.Warning,
        { IsInitializing: true } => Color.Info,
        { IsInitialized: true } => Color.Success,
        _ => Color.Default
    };

    private string GetChannelStateLabel() => Channel switch
    {
        { IsNotAvailable: true } => L["Channel:States:Unavailable"],
        { HasExceptions: true } => L["Channel:States:Degraded"],
        { IsInitializing: true } => L["Channel:States:Initializing"],
        { IsInitialized: true } => L["Channel:States:Ready"],
        _ => L["Channel:States:NotInitialized"]
    };

    private static string GetComponentIcon(PipelineComponentKind type) => type switch
    {
        PipelineComponentKind.Endpoint => Icons.Material.Filled.Adjust,
        PipelineComponentKind.TransformMiddleware => Icons.Material.Filled.Transform,
        PipelineComponentKind.MonitorMiddleware => Icons.Material.Filled.MonitorHeart,
        PipelineComponentKind.EndpointMiddleware => Icons.Material.Filled.Router,
        PipelineComponentKind.InfoDisplayMiddleware => Icons.Material.Filled.QueryStats,
        _ => Icons.Material.Filled.Extension
    };

    private static Color GetComponentColor(PipelineComponentKind type) => type switch
    {
        PipelineComponentKind.Endpoint => Color.Primary,
        PipelineComponentKind.TransformMiddleware => Color.Secondary,
        PipelineComponentKind.MonitorMiddleware => Color.Info,
        PipelineComponentKind.EndpointMiddleware => Color.Warning,
        PipelineComponentKind.InfoDisplayMiddleware => Color.Success,
        _ => Color.Default
    };

    private string GetComponentTypeDisplayName(PipelineComponentKind type) => type switch
    {
        PipelineComponentKind.Endpoint => L["Pipeline:ComponentKinds:Endpoint"],
        PipelineComponentKind.TransformMiddleware => L["Pipeline:ComponentKinds:Transform"],
        PipelineComponentKind.MonitorMiddleware => L["Pipeline:ComponentKinds:Monitor"],
        PipelineComponentKind.EndpointMiddleware => L["Pipeline:ComponentKinds:EndpointMiddleware"],
        PipelineComponentKind.InfoDisplayMiddleware => L["Pipeline:ComponentKinds:Information"],
        PipelineComponentKind.BaseMiddleware => L["Pipeline:ComponentKinds:Base"],
        _ => L["Pipeline:ComponentKinds:Unknown"]
    };

    private string FormatInfoValue(object? value) => value switch
    {
        long number => number.ToString("N0", System.Globalization.CultureInfo.CurrentCulture),
        int number => number.ToString("N0", System.Globalization.CultureInfo.CurrentCulture),
        double number => number.ToString("N2", System.Globalization.CultureInfo.CurrentCulture),
        float number => number.ToString("N2", System.Globalization.CultureInfo.CurrentCulture),
        decimal number => number.ToString("N2", System.Globalization.CultureInfo.CurrentCulture),
        DateTime dateTime => dateTime.ToString("yyyy-MM-dd HH:mm:ss", System.Globalization.CultureInfo.CurrentCulture),
        bool boolean => boolean ? L["Common:Values:Yes"] : L["Common:Values:No"],
        null => L["Common:Values:Empty"],
        _ => value.ToString() ?? L["Common:Values:Unknown"]
    };

    private async Task OpenMessageDebuggerAsync(string channelId, PipelineComponentInfo middleware)
    {
        var debugger = await GetMessageDebuggerMiddlewareAsync(channelId, middleware.Name);
        if (_disposed || debugger is null)
        {
            return;
        }

        var parameters = new DialogParameters<MessageDebuggerDialog>
        {
            { dialog => dialog.Middleware, debugger }
        };

        await DialogService.ShowAsync<MessageDebuggerDialog>(
            L["Debugger:DialogTitle", channelId],
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = true,
                BackdropClick = false
            });
    }

    private async Task<MessageDebuggerMiddleware?> GetMessageDebuggerMiddlewareAsync(
        string channelId,
        string middlewareName)
    {
        try
        {
            var result = await DataChannelService.GetMiddlewareAsync<MessageDebuggerMiddleware>(channelId, middlewareName);
            if (_disposed)
            {
                return null;
            }

            if (result.IsFailed(out var error, out var middleware))
            {
                Snackbar.Add(L["Debugger:Messages:LoadFailed", error], Severity.Error);
                return null;
            }

            return middleware;
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add(L["Debugger:Messages:LoadException", ex.Message], Severity.Error);
            }

            return null;
        }
    }

    public void Dispose()
    {
        _disposed = true;
    }
}
