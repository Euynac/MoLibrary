@using System.Text.Json
@using System.Text.Json.Serialization
@inject IStringLocalizer<DataChannelResource> L

@if (_items.Count > 0)
{
    <dl class="metadata-list">
        @foreach (var item in _items)
        {
            <div class="metadata-row">
                <dt>@item.Key</dt>
                <dd>
                    @if (item.IsComplexValue)
                    {
                        <div class="metadata-complex">
                            <MudExpansionPanels Elevation="0" Dense="true">
                                <MudExpansionPanel Text="@L["Metadata:ComplexValue"]"
                                                   Icon="@Icons.Material.Filled.DataObject">
                                    <pre class="metadata-code">@item.Value</pre>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        </div>
                    }
                    else
                    {
                        <span class="metadata-value">@item.Value</span>
                    }
                </dd>
            </div>
        }
    </dl>
}
else
{
    <div class="metadata-empty">
        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Metadata:Empty"]</MudText>
    </div>
}

@code {
    [Parameter]
    public object? Metadata { get; set; }

    private IReadOnlyList<MetadataItem> _items = [];

    protected override void OnParametersSet()
    {
        _items = ProcessMetadata();
    }

    private IReadOnlyList<MetadataItem> ProcessMetadata()
    {
        if (Metadata is null)
        {
            return [];
        }

        try
        {
            var json = JsonSerializer.Serialize(PreprocessEnums(Metadata), new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
            });

            return ExtractMetadataItems(JsonSerializer.Deserialize<JsonElement>(json));
        }
        catch (Exception)
        {
            return
            [
                new MetadataItem(
                    L["Metadata:RawData"],
                    Metadata.ToString() ?? L["Common:Values:Empty"],
                    false)
            ];
        }
    }

    private object? PreprocessEnums(object? value)
    {
        if (value is null)
        {
            return null;
        }

        var type = value.GetType();
        if (type.IsEnum || Nullable.GetUnderlyingType(type)?.IsEnum == true)
        {
            return value.ToString();
        }

        if (type.IsPrimitive || value is string or DateTime or decimal or Guid)
        {
            return value;
        }

        if (value is System.Collections.IEnumerable enumerable && value is not string)
        {
            return enumerable.Cast<object?>().Select(PreprocessEnums).ToList();
        }

        if (!type.IsClass && !type.IsValueType)
        {
            return value;
        }

        var result = new Dictionary<string, object?>();
        foreach (var property in type.GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance))
        {
            if (!property.CanRead)
            {
                continue;
            }

            try
            {
                result[property.Name] = PreprocessEnums(property.GetValue(value));
            }
            catch
            {
                result[property.Name] = L["Metadata:Unreadable"];
            }
        }

        return result;
    }

    private IReadOnlyList<MetadataItem> ExtractMetadataItems(JsonElement element, string keyPrefix = "")
    {
        var items = new List<MetadataItem>();
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                var key = string.IsNullOrEmpty(keyPrefix) ? property.Name : $"{keyPrefix}.{property.Name}";
                if (property.Value.ValueKind is JsonValueKind.Object or JsonValueKind.Array)
                {
                    items.Add(new MetadataItem(key, SerializeElement(property.Value), true));
                }
                else
                {
                    items.Add(new MetadataItem(key, FormatPrimitive(property.Value), false));
                }
            }

            return items;
        }

        if (element.ValueKind == JsonValueKind.Array)
        {
            items.Add(new MetadataItem(
                string.IsNullOrEmpty(keyPrefix) ? L["Metadata:ArrayData"] : keyPrefix,
                SerializeElement(element),
                true));
            return items;
        }

        items.Add(new MetadataItem(
            string.IsNullOrEmpty(keyPrefix) ? L["Metadata:Value"] : keyPrefix,
            FormatPrimitive(element),
            false));
        return items;
    }

    private static string SerializeElement(JsonElement element) => JsonSerializer.Serialize(element, new JsonSerializerOptions
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });

    private static string FormatPrimitive(JsonElement element) => element.ValueKind switch
    {
        JsonValueKind.String => element.GetString() ?? string.Empty,
        JsonValueKind.Number => element.GetRawText(),
        JsonValueKind.True => "true",
        JsonValueKind.False => "false",
        JsonValueKind.Null => "null",
        _ => element.ToString()
    };

    private sealed record MetadataItem(string Key, string Value, bool IsComplexValue);
}
