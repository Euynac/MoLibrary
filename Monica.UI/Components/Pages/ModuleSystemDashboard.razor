@attribute [Route(MODULE_SYSTEM_DASHBOARD_URL)]
@using Microsoft.Extensions.Localization
@using Monica.Core.Module.Dashboard.Interfaces
@using Monica.Core.Module.Dashboard.Models
@using Monica.Core.Module.Models
@using Monica.Core.Module.TypeFinder
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.Components
@inject IModuleSystemStatusService StatusService
@inject ISnackbar SnackBar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ModuleSystem:Dashboard:Title"]</PageTitle>

<div class="dashboard-page-shell">
    <MudContainer MaxWidth="MaxWidth.False">
        <MudPaper Class="pa-6 mb-6" Elevation="2">
            <MudText Typo="Typo.h3" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="mr-3" />
                @L["ModuleSystem:Dashboard:Title"]
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                @L["ModuleSystem:Dashboard:Description"]
            </MudText>
        </MudPaper>

        <MudTabs ActivePanelIndex="@activeTabIndex"
                 ActivePanelIndexChanged="@OnActivePanelIndexChanged"
                 Elevation="4"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 Class="mb-6">
            <MudTabPanel Text="@L["ModuleSystem:Dashboard:Tabs:SystemOverview"]" Icon="@Icons.Material.Filled.Assessment">
                <div class="tab-content-panel">
                    <SystemOverview SystemStatus="systemStatus" HealthCheckData="healthCheck" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["ModuleSystem:Dashboard:Tabs:PerformanceMonitoring"]" Icon="@Icons.Material.Filled.Speed">
                <div class="tab-content-panel">
                    <PerformanceMonitoring SystemPerformance="systemPerformance" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["ModuleSystem:Dashboard:Tabs:ModuleManagement"]" Icon="@Icons.Material.Filled.ViewModule">
                <div class="tab-content-panel">
                    <ModuleManagement RegistrationInfo="registrationInfo"
                                      OnRefresh="RefreshData"
                                      OnModuleDetailClicked="ViewModuleDetail" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["ModuleSystem:Dashboard:Tabs:AssemblyAnalysis"]" Icon="@Icons.Material.Filled.Hub">
                <div class="tab-content-panel">
                    <AssemblyAnalysis AssemblyAnalysisData="assemblyAnalysis" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["ModuleSystem:Dashboard:Tabs:Dependencies"]" Icon="@Icons.Material.Filled.AccountTree">
                <div class="tab-content-panel">
                    <DependencyGraph DependencyGraphData="dependencyGraph" />
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudContainer>
</div>

<!-- 模块详情对话框 -->
<ModuleDetailDialog IsVisible="showModuleDetail"
                   IsVisibleChanged="OnModuleDetailVisibilityChanged"
                   SelectedModuleDetail="selectedModuleDetail" />


@code {
    public const string MODULE_SYSTEM_DASHBOARD_URL = "/module-system-dashboard";
    private ModuleSystemStatus? systemStatus;
    private ModuleSystemPerformance? systemPerformance;
    private ModuleSystemHealthCheck? healthCheck;
    private ModuleRegistrationInfo? registrationInfo;
    private TypeFinderAssemblyAnalysis? assemblyAnalysis;
    private ModuleDependencyGraph? dependencyGraph;
    private ModuleDetailInfo? selectedModuleDetail;
    private bool showModuleDetail = false;
    private int activeTabIndex;

    private const int AssemblyAnalysisTabIndex = 3;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshData();
        }
    }
    /// <summary>
    /// 刷新数据
    /// </summary>
    /// <returns></returns>
    private Task RefreshData()
    {
        try
        {
            systemStatus = StatusService.GetSystemStatus();
            systemPerformance = StatusService.GetSystemPerformance();
            healthCheck = StatusService.GetHealthCheck();
            registrationInfo = StatusService.GetRegistrationInfo();
            dependencyGraph = StatusService.GetDependencyGraph();
            assemblyAnalysis = null;

            SnackBar.Add(L["ModuleSystem:Dashboard:Messages:DataRefreshed"], Severity.Success);
        }
        catch (Exception ex)
        {
            SnackBar.Add($"{L["ModuleSystem:Dashboard:Messages:RefreshFailed"]}: {ex.Message}", Severity.Error);
        }

        if (activeTabIndex == AssemblyAnalysisTabIndex)
        {
            return LoadAssemblyAnalysis();
        }

        return Task.CompletedTask;
    }

    private Task OnActivePanelIndexChanged(int tabIndex)
    {
        activeTabIndex = tabIndex;
        return tabIndex == AssemblyAnalysisTabIndex
            ? LoadAssemblyAnalysis()
            : Task.CompletedTask;
    }

    private Task LoadAssemblyAnalysis()
    {
        if (assemblyAnalysis != null)
        {
            return Task.CompletedTask;
        }

        try
        {
            assemblyAnalysis = StatusService.GetAssemblyAnalysis();
        }
        catch (Exception ex)
        {
            SnackBar.Add($"{L["ModuleSystem:Dashboard:Messages:RefreshFailed"]}: {ex.Message}", Severity.Error);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// 查看模块详情
    /// </summary>
    /// <param name="moduleKey">模块键</param>
    /// <returns></returns>
    private Task ViewModuleDetail(ModuleKey moduleKey)
    {
        try
        {
            selectedModuleDetail = StatusService.GetModuleDetail(moduleKey);
            if (selectedModuleDetail != null)
            {
                showModuleDetail = true;
            }
            else
            {
                SnackBar.Add(L["ModuleSystem:Dashboard:Messages:ModuleDetailNotFound"], Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            SnackBar.Add($"{L["ModuleSystem:Dashboard:Messages:GetModuleDetailFailed"]}: {ex.Message}", Severity.Error);
        }

        return Task.CompletedTask;
    }

    private Task OnModuleDetailVisibilityChanged(bool isVisible)
    {
        showModuleDetail = isVisible;

        if (!isVisible)
        {
            selectedModuleDetail = null;
        }

        return Task.CompletedTask;
    }
} 
