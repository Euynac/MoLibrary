@using MudBlazor.Utilities
@using Monica.UI.Services
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject MoThemeService ThemeService

<div class="mo-markdown-mermaid-block">
    @if (_renderError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
            @_renderError
        </MudAlert>
    }

    <div @ref="_containerRef"
         class="@GetSurfaceClass()"
         aria-label="Mermaid diagram"></div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Definition { get; set; } = string.Empty;

    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private string? _renderError;
    private bool _shouldRenderDiagram = true;
    private string _lastDefinition = string.Empty;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(_lastDefinition, Definition, StringComparison.Ordinal))
        {
            _lastDefinition = Definition;
            _shouldRenderDiagram = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Monica.UI/js/mo-markdown-mermaid.js");
        }

        if (!_shouldRenderDiagram)
        {
            return;
        }

        try
        {
            _renderError = null;
            await _module.InvokeVoidAsync("renderMermaid", _containerRef, Definition, BuildThemePayload());
        }
        catch (JSException ex)
        {
            _renderError = ex.Message;
            await ClearDiagramAsync();
        }
        catch (InvalidOperationException ex)
        {
            _renderError = ex.Message;
            await ClearDiagramAsync();
        }
        finally
        {
            _shouldRenderDiagram = false;

            if (_renderError is not null)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async void OnThemeChanged()
    {
        _shouldRenderDiagram = true;
        await InvokeAsync(StateHasChanged);
    }

    private MermaidThemePayload BuildThemePayload()
    {
        var palette = ThemeService.IsDarkMode
            ? ThemeService.CurrentTheme.PaletteDark
            : ThemeService.CurrentTheme.PaletteLight;

        return new MermaidThemePayload(
            ThemeService.CurrentThemeName,
            ThemeService.IsDarkMode,
            palette.Primary.ToString(),
            palette.Secondary.ToString(),
            palette.Surface.ToString(),
            palette.BackgroundGray.ToString(),
            palette.TextPrimary.ToString(),
            palette.TextSecondary.ToString(),
            palette.Info.ToString(),
            palette.Success.ToString(),
            palette.Warning.ToString(),
            palette.Error.ToString(),
            ThemeService.CurrentTheme.Typography.Default.FontFamily);
    }

    private async Task ClearDiagramAsync()
    {
        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync("clearMermaid", _containerRef);
    }

    private string GetSurfaceClass()
    {
        return new CssBuilder("mo-markdown-mermaid-surface")
            .AddClass("has-error", _renderError is not null)
            .Build();
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record MermaidThemePayload(
        string ThemeName,
        bool IsDarkMode,
        string Primary,
        string Secondary,
        string Surface,
        string Background,
        string TextPrimary,
        string TextSecondary,
        string Info,
        string Success,
        string Warning,
        string Error,
        string[]? FontFamily);
}
