@using System.Reflection
@using Microsoft.Extensions.Options
@using Monica.UI.Modules
@inject IOptions<ModuleUICoreOption> Options

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />  
    @* <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" /> *@
    <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
    @* <link href="_content/MudBlazor/MudBlazor.min.css?v=@(Metadata.Version)" rel="stylesheet" /> *@

    @if(Options.Value.EnableMarkdown)
    {
        <link href=@Assets["_content/MudBlazor.Markdown/MudBlazor.Markdown.min.css"] rel="stylesheet" />
    }
    
    <!-- Monica 主题 CSS -->
    <link href=@Assets["_content/Monica.UI/css/mo-theme-main.css"] rel="stylesheet" />
    
	<!-- 巨坑：支持消费应用的 CSS isolation 最终是打包成了bundle(可以通过编译目录下的YourProject.staticwebassets.runtime.json)，所以要根据入口程序集名称获取 -->
    <link href="@(Assembly.GetEntryAssembly()?.GetName().Name).styles.css" rel="stylesheet" />
  
    <link rel="icon" type="image/ico" href="@Assets["_content/Monica.UI/favicon.ico"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <!-- D3.js for data visualization -->
    <script src=@Assets["_content/Monica.UI/lib/d3.min.js"]></script>
</head>

<body>
    <MoRouter @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>
    <script src=@Assets["_content/Monica.UI/js/mo-clipboard.js"]></script>
    @* <script src="_content/MudBlazor/MudBlazor.min.js?v=@Metadata.Version"></script> *@
    @if(Options.Value.EnableMarkdown)
    {
        <script src=@Assets["_content/MudBlazor.Markdown/MudBlazor.Markdown.min.js"]></script>
    }
</body>

</html>
