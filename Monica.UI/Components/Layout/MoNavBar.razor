@using Microsoft.Extensions.Options
@using Monica.UI.Modules
@using Monica.UI.UICore.Interfaces
@using Monica.UI.UICore.Models
@using Monica.UI.Localization
@using Microsoft.Extensions.Localization
@inject IUIComponentRegistry UIRegistry
@inject IOptions<ModuleUICoreOption> Options
@inject IStringLocalizer<SharedResource> L
@inject IStringLocalizer<UIRegistryResource> RegistryL

<nav class="mo-navbar">
    <MoNavBarBrand />

    <div class="navbar-nav">
        @foreach (var category in VisibleCategories)
        {
            <MoNavBarDropdown Category="@category"
                            Items="@GetItemsInCategory(category)" />
        }

        @if (HasMoreCategories)
        {
            <MoNavBarMore Categories="@MoreCategories" />
        }
    </div>

    <MoNavBarActions />
</nav>

@code {
    private Dictionary<string, List<UINavItem>> _categorizedNavItems = new();

    private int MaxVisibleCategories => Options.Value.MaxVisibleCategories;

    protected override void OnInitialized()
    {
        var allNavItems = UIRegistry.GetNavItems();
        _categorizedNavItems = allNavItems
            .GroupBy(item => {
                var category = item.Category ?? L["ModuleSystem:Common:Labels:Uncategorized"];
                return GetLocalizedText(category, item.CategoryKey);
            })
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private string GetLocalizedText(string text, string? key)
    {
        if (!string.IsNullOrEmpty(key))
        {
            return RegistryL[key];
        }
        return text;  // Fallback to plain text
    }

    private IEnumerable<string> VisibleCategories =>
        _categorizedNavItems.Keys.Take(MaxVisibleCategories);

    private bool HasMoreCategories =>
        _categorizedNavItems.Count > MaxVisibleCategories;

    private Dictionary<string, List<UINavItem>> MoreCategories =>
        _categorizedNavItems
            .Skip(MaxVisibleCategories)
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

    private List<UINavItem> GetItemsInCategory(string category) =>
        _categorizedNavItems.TryGetValue(category, out var items) ? items : new();
}
