@using Monica.UI.Components.Pages
@using Monica.UI.Components.Layout
@using Monica.UI.UICore.Interfaces
@inject IUIComponentRegistry UIRegistry

<Router AppAssembly="@typeof(MoRouter).Assembly" 
        AdditionalAssemblies="@UIRegistry.GetAdditionalAssemblies()"
        NotFoundPage="@typeof(PageNotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="@typeof(MoMainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
