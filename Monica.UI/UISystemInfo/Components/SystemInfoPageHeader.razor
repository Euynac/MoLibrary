@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@inject IStringLocalizer<SystemInfoResource> L

<header class="system-info-masthead">
    <div class="system-info-masthead__copy">
        <p class="system-info-masthead__eyebrow">
            <span aria-hidden="true"></span>
            @L["Page:Eyebrow"]
        </p>
        <h1>@L["Page:Title"]</h1>
        <p>@L["Page:Summary"]</p>
    </div>

    <div class="system-info-masthead__actions">
        @if (EnableRestart)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       Disabled="@RestartRequested"
                       OnClick="RestartRequestedCallback">
                @L["Page:Actions:Restart"]
            </MudButton>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsRefreshing"
                   OnClick="RefreshRequested">
            @L["Page:Actions:Refresh"]
        </MudButton>
    </div>
</header>

@code {
    [Parameter] public bool EnableRestart { get; set; }
    [Parameter] public bool IsRefreshing { get; set; }
    [Parameter] public bool RestartRequested { get; set; }
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public EventCallback RestartRequestedCallback { get; set; }
}
