@attribute [Route(DIFF_HIGHLIGHT_URL)]

@using Monica.Core.Results;
@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.UIDiffHighlight.Components
@using Monica.UI.UIDiffHighlight.Facades
@using Monica.UI.UIDiffHighlight.Models
@using Monica.UI.UIDiffHighlight.State

@inject DiffHighlightFacade DiffHighlightFacade
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["DiffHighlightPage:PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Compare" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h4">@L["DiffHighlightPage:Title"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L["DiffHighlightPage:Description"]
                </MudText>
            </div>
        </MudStack>

        <MudExpansionPanels>
            <MudExpansionPanel Text="@L["DiffHighlightPage:ConfigOptions"]" Icon="@Icons.Material.Filled.Settings">
                <div class="pa-2">
                    <MudGrid>
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="EDiffHighlightMode" @bind-Value="_state.Options.Mode" Label="@L["DiffHighlightPage:CompareMode"]">
                                <MudSelectItem T="EDiffHighlightMode" Value="EDiffHighlightMode.Line">@L["DiffHighlightPage:Modes:Line"]</MudSelectItem>
                                <MudSelectItem T="EDiffHighlightMode" Value="EDiffHighlightMode.Character">@L["DiffHighlightPage:Modes:Character"]</MudSelectItem>
                                <MudSelectItem T="EDiffHighlightMode" Value="EDiffHighlightMode.Mixed">@L["DiffHighlightPage:Modes:Mixed"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="EDiffOutputFormat" @bind-Value="_state.Options.OutputFormat" Label="@L["DiffHighlightPage:OutputFormat"]">
                                <MudSelectItem T="EDiffOutputFormat" Value="EDiffOutputFormat.Html">@L["DiffHighlightPage:Formats:Html"]</MudSelectItem>
                                <MudSelectItem T="EDiffOutputFormat" Value="EDiffOutputFormat.Markdown">@L["DiffHighlightPage:Formats:Markdown"]</MudSelectItem>
                                <MudSelectItem T="EDiffOutputFormat" Value="EDiffOutputFormat.PlainText">@L["DiffHighlightPage:Formats:PlainText"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="int" @bind-Value="_state.Options.ContextLines" Label="@L["DiffHighlightPage:ContextLines"]" Min="0" Max="20" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="int" @bind-Value="_state.Options.MaxCharacterDiffLength" Label="@L["DiffHighlightPage:MaxCharacterDiffLength"]" Min="100" Max="10000" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudSwitch T="bool" @bind-Value="_state.Options.IgnoreWhitespace" Label="@L["DiffHighlightPage:IgnoreWhitespace"]" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudSwitch T="bool" @bind-Value="_state.Options.IgnoreCase" Label="@L["DiffHighlightPage:IgnoreCase"]" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudSwitch T="bool" @bind-Value="_state.AutoRefresh" Label="@L["DiffHighlightPage:AutoRefresh"]" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudButton Variant="Variant.Outlined"
                                      StartIcon="@Icons.Material.Filled.Refresh"
                                      OnClick="LoadSampleDataAsync"
                                      Size="Size.Small">
                                @L["DiffHighlightPage:LoadSample"]
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </div>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" lg="6">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 500px;">
                <MudStack>
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" />
                        @L["DiffHighlightPage:OriginalText"]
                    </MudText>
                    <MudTextField T="string"
                                 Value="@_state.OriginText"
                                 ValueChanged="@OnOriginTextChanged"
                                 Lines="18"
                                 Variant="Variant.Outlined"
                                 Class="diff-text-input"
                                 Placeholder="@L["DiffHighlightPage:OriginalTextPlaceholder"]"
                                 Immediate="true" />
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="6">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 500px;">
                <MudStack>
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-2" />
                        @L["DiffHighlightPage:NewText"]
                    </MudText>
                    <MudTextField T="string"
                                 Value="@_state.NewText"
                                 ValueChanged="@OnNewTextChanged"
                                 Lines="18"
                                 Variant="Variant.Outlined"
                                 Class="diff-text-input"
                                 Placeholder="@L["DiffHighlightPage:NewTextPlaceholder"]"
                                 Immediate="true" />
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="2" Class="mt-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-4 pb-2">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Compare" Size="Size.Small" Class="mr-2" />
                @L["DiffHighlightPage:DiffResult"]
            </MudText>
            <MudSpacer />
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                    Color="@GetFormatChipColor()" Icon="@GetFormatIcon()">
                @_state.Options.OutputFormat
            </MudChip>
            <MudButton Variant="Variant.Filled"
                      Color="Color.Primary"
                      StartIcon="@Icons.Material.Filled.Refresh"
                      OnClick="RefreshDiffAsync"
                      Disabled="_state.IsRefreshing">
                @if (_state.IsRefreshing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <text>@L["DiffHighlightPage:Comparing"]</text>
                }
                else
                {
                    <text>@L["DiffHighlightPage:ManualRefresh"]</text>
                }
            </MudButton>
        </MudStack>
        
        @if (_state.Options.OutputFormat == EDiffOutputFormat.Html)
        {
            <DiffViewer @ref="DiffViewerRef"
                       OriginText="@_state.OriginText" 
                       NewText="@_state.NewText" 
                       Options="@_state.Options"
                       AutoRefresh="@_state.AutoRefresh" />
        }
        else
        {
            <div class="pa-4">
                @if (_state.DiffResult != null)
                {
                    @if (_state.Options.OutputFormat == EDiffOutputFormat.Markdown)
                    {
                        <MudPaper Elevation="1" Class="pa-3 markdown-viewer">
                            <pre style="white-space: pre-wrap; font-family: 'Cascadia Code', monospace;">@_state.DiffResult.HighlightedContent</pre>
                        </MudPaper>
                    }
                    else if (_state.Options.OutputFormat == EDiffOutputFormat.PlainText)
                    {
                        <MudPaper Elevation="1" Class="pa-3 plaintext-viewer">
                            <pre style="white-space: pre-wrap; font-family: 'Cascadia Code', monospace;">@_state.DiffResult.HighlightedContent</pre>
                        </MudPaper>
                    }
                }
                else if (_state.IsRefreshing)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info">@L["DiffHighlightPage:EnterTextAndRefresh"]</MudAlert>
                }
            </div>
        }
    </MudPaper>
</MudContainer>

@code {
    public const string DIFF_HIGHLIGHT_URL = "/diff-highlight-debug";

    private readonly DiffHighlightPageState _state = new();
    private DiffViewer? DiffViewerRef { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSampleDataAsync();
        }
    }

    private CancellationTokenSource? _debounceTokenSource;

    private async Task OnOriginTextChanged(string value)
    {
        _state.SetOriginText(value);
        await OnTextChanged();
    }

    private async Task OnNewTextChanged(string value)
    {
        _state.SetNewText(value);
        await OnTextChanged();
    }

    private async Task OnTextChanged()
    {
        if (!_state.AutoRefresh) return;
        
        // Cancel the previous debounce task.
        _debounceTokenSource?.Cancel();
        _debounceTokenSource = new CancellationTokenSource();
        
        try
        {
            var totalChars = _state.GetTotalCharacterCount();
            
            // Delay for 300ms only if it exceeds 100,000 characters, otherwise no delay
            if (totalChars > 100000)
            {
                await Task.Delay(300, _debounceTokenSource.Token);
            }
            
            // Trigger automatic refresh
            await RefreshDiffAsync();
        }
        catch (OperationCanceledException)
        {
            // Debounce cancellation is expected and can be ignored.
        }
    }

    private async Task RefreshDiffAsync()
    {
        _state.BeginRefresh();
        StateHasChanged();

        try
        {
            if (_state.Options.OutputFormat == EDiffOutputFormat.Html && DiffViewerRef != null)
            {
                await DiffViewerRef.RefreshDiffAsync();
            }
            else
            {
                var result = await DiffHighlightFacade.HighlightAsync(
                    _state.OriginText,
                    _state.NewText,
                    _state.Options);

                if (result.IsFailed(out var error, out var data))
                {
                    Snackbar.Add($"{L["DiffHighlightPage:ComparisonFailed"]}: {error}", Severity.Error);
                    _state.CompleteRefresh(diffResult: null);
                }
                else
                {
                    _state.CompleteRefresh(data);
                }
            }
        }
        finally
        {
            if (_state.IsRefreshing)
            {
                _state.CompleteRefresh(_state.DiffResult);
            }

            StateHasChanged();
        }
    }

    private Color GetFormatChipColor()
    {
        return _state.Options.OutputFormat switch
        {
            EDiffOutputFormat.Html => Color.Primary,
            EDiffOutputFormat.Markdown => Color.Secondary,
            EDiffOutputFormat.PlainText => Color.Tertiary,
            _ => Color.Default
        };
    }

    private string GetFormatIcon()
    {
        return _state.Options.OutputFormat switch
        {
            EDiffOutputFormat.Html => Icons.Material.Filled.Code,
            EDiffOutputFormat.Markdown => Icons.Material.Filled.Notes,
            EDiffOutputFormat.PlainText => Icons.Material.Filled.TextFields,
            _ => Icons.Material.Filled.Help
        };
    }

    private async Task LoadSampleDataAsync()
    {
        _state.LoadSampleData();

        StateHasChanged();
        await Task.Delay(100);
        
        await RefreshDiffAsync();
    }
}
