@attribute [Route(PAGE_URL)]
@layout MainLayout
@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["PageNotFound:PageTitle"]</PageTitle>

<MudAlert Severity="Severity.Error">
    <MudText Typo="Typo.h6">@L["PageNotFound:Title"]</MudText>
    <MudText>@L["PageNotFound:Message"]</MudText>
</MudAlert>

@code {
    public const string PAGE_URL = "/not-found";
}
