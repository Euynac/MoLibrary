@attribute [Route(PAGE_URL)]
@using System.Globalization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using Monica.Core.Results
@using Monica.Modules
@using Monica.UI.Localization
@using Monica.UI.UISystemInfo.Components
@using Monica.UI.UISystemInfo.Models
@using Monica.UI.UISystemInfo.Support
@inject SystemInfoService SystemInfoService
@inject ISnackbar Snackbar
@inject IOptions<ModuleSystemInfoUIOption> SystemInfoUIOptions
@inject IStringLocalizer<SystemInfoResource> L

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <!-- Header -->
    <MudPaper Class="pa-4 mb-4" Style="background: linear-gradient(45deg, #6A1B9A 30%, #9C27B0 90%); color: white;">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight: 500; margin: 0;">@L["Page:Header:Title"]</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton StartIcon="@Icons.Material.Filled.Refresh"
                           Color="Color.Inherit"
                           Variant="Variant.Outlined"
                           OnClick="RefreshSystemInfo"
                           Size="Size.Medium"
                           Style="border-color: white; color: white;">
                    @L["Page:Header:Refresh"]
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="pa-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Color="Color.Primary">@L["Page:States:LoadingTitle"]</MudText>
        </MudStack>
    }
    else if (_systemInfo != null)
    {
        <MudGrid Spacing="3">
            @if (SystemInfoUIOptions.Value.CustomLinks.Any(link => link.Enabled))
            {
                <MudItem xs="12">
                    <SystemInfoCustomLinkPanel Links="@SystemInfoUIOptions.Value.CustomLinks" />
                </MudItem>
            }

            <!-- Basic information card -->
            <MudItem xs="12" md="6" lg="4">
                <MudCard Style="height: 100%; display: flex; flex-direction: column;" Elevation="2">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Primary" />
                                <MudText Typo="Typo.h6" Style="font-weight: 500;">@L["Page:BasicInfo:Title"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="flex: 1; padding-top: 8px;">
                        <MudStack Spacing="3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Color="Color.Success" />
                                <MudText><strong>@L["Page:BasicInfo:BuildTime"]:</strong></MudText>
                            </MudStack>
                            <MudText Class="ml-6" Style="color: #666;">@FormatDateTime(_systemInfo.BuildTime)</MudText>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Info" />
                                <MudText><strong>@L["Page:BasicInfo:LocalTime"]:</strong></MudText>
                            </MudStack>
                            <MudText Class="ml-6" Style="color: #666;">@FormatDateTime(_systemInfo.LocalTime)</MudText>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" Color="Color.Warning" />
                                <MudText><strong>@L["Page:BasicInfo:UtcTime"]:</strong></MudText>
                            </MudStack>
                            <MudText Class="ml-6" Style="color: #666;">@FormatDateTime(_systemInfo.UtcTime)</MudText>

                            @if (!string.IsNullOrEmpty(_systemInfo.ProductVersion))
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText><strong>@L["Page:BasicInfo:ProductVersion"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@_systemInfo.ProductVersion</MudText>
                            }

                            @if (_systemInfo.ProcessStartTime.HasValue)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Success" />
                                    <MudText><strong>@L["Page:BasicInfo:ProcessStartTime"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@FormatDateTime(_systemInfo.ProcessStartTime.Value)</MudText>
                                <MudText Class="ml-6" Style="color: #888; font-size: 0.875rem;">
                                    @L["Page:BasicInfo:RunningFor", FormatUptime(_systemInfo.ProcessStartTime.Value)]
                                </MudText>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Environment information card -->
            @if (_systemInfo.EnvironmentInfo != null)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Style="height: 100%; display: flex; flex-direction: column;" Elevation="2">
                        <MudCardHeader Class="pb-2">
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Primary" />
                                    <MudText Typo="Typo.h6" Style="font-weight: 500;">@L["Page:EnvironmentInfo:Title"]</MudText>
                                </MudStack>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Style="flex: 1; padding-top: 8px;">
                            <MudStack Spacing="3">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Size="Size.Small" Color="Color.Success" />
                                    <MudText><strong>@L["Page:EnvironmentInfo:MachineName"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@_systemInfo.EnvironmentInfo.MachineName</MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Info" />
                                    <MudText><strong>@L["Page:EnvironmentInfo:UserName"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@_systemInfo.EnvironmentInfo.UserName</MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Warning" />
                                    <MudText><strong>@L["Page:EnvironmentInfo:ProcessId"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@_systemInfo.EnvironmentInfo.ProcessId</MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Architecture" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText><strong>@L["Page:EnvironmentInfo:Is64BitOperatingSystem"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@FormatBoolean(_systemInfo.EnvironmentInfo.Is64BitOperatingSystem)</MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" Color="Color.Tertiary" />
                                    <MudText><strong>@L["Page:EnvironmentInfo:WorkingSet"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@FormatScaledBytes(_systemInfo.EnvironmentInfo.WorkingSet)</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- File information card -->
                @if (_systemInfo.FileInfo != null)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MudCard Style="height: 100%; display: flex; flex-direction: column;" Elevation="2">
                            <MudCardHeader Class="pb-2">
                                <CardHeaderContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Primary" />
                                        <MudText Typo="Typo.h6" Style="font-weight: 500;">@L["Page:FileInfo:Title"]</MudText>
                                    </MudStack>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Style="flex: 1; padding-top: 8px;">
                                <MudStack Spacing="3">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Small" Color="Color.Success" />
                                        <MudText><strong>@L["Page:FileInfo:ProductName"]:</strong></MudText>
                                    </MudStack>
                                    <MudText Class="ml-6" Style="color: #666;">@_systemInfo.FileInfo.ProductName</MudText>

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" Color="Color.Info" />
                                        <MudText><strong>@L["Page:FileInfo:ProductVersion"]:</strong></MudText>
                                    </MudStack>
                                    <MudText Class="ml-6" Style="color: #666;">@_systemInfo.FileInfo.ProductVersion</MudText>

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" Color="Color.Warning" />
                                        <MudText><strong>@L["Page:FileInfo:FileVersion"]:</strong></MudText>
                                    </MudStack>
                                    <MudText Class="ml-6" Style="color: #666;">@_systemInfo.FileInfo.FileVersion</MudText>

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Secondary" />
                                        <MudText><strong>@L["Page:FileInfo:CompanyName"]:</strong></MudText>
                                    </MudStack>
                                    <MudText Class="ml-6" Style="color: #666;">@_systemInfo.FileInfo.CompanyName</MudText>

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Copyright" Size="Size.Small" Color="Color.Tertiary" />
                                        <MudText><strong>@L["Page:FileInfo:Copyright"]:</strong></MudText>
                                    </MudStack>
                                    <MudText Class="ml-6" Style="color: #666;">@_systemInfo.FileInfo.LegalCopyright</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }

                <!-- System details card -->
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Style="height: 100%; display: flex; flex-direction: column;" Elevation="2">
                        <MudCardHeader Class="pb-2">
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" />
                                    <MudText Typo="Typo.h6" Style="font-weight: 500;">@L["Page:SystemDetails:Title"]</MudText>
                                </MudStack>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Style="flex: 1; padding-top: 8px;">
                            <MudStack Spacing="3">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.DeveloperMode" Size="Size.Small" Color="Color.Success" />
                                    <MudText><strong>@L["Page:SystemDetails:DotNetVersion"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@_systemInfo.EnvironmentInfo.Version?.ToString()</MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Size="Size.Small" Color="Color.Info" />
                                    <MudText><strong>@L["Page:SystemDetails:OperatingSystem"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@_systemInfo.EnvironmentInfo.OSVersion?.ToString()</MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Color="Color.Warning" />
                                    <MudText><strong>@L["Page:SystemDetails:CurrentDirectory"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666; word-break: break-all;">@_systemInfo.EnvironmentInfo.CurrentDirectory</MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText><strong>@L["Page:SystemDetails:SystemPageSize"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@FormatByteCount(_systemInfo.EnvironmentInfo.SystemPageSize)</MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" Color="Color.Tertiary" />
                                    <MudText><strong>@L["Page:SystemDetails:UserInteractive"]:</strong></MudText>
                                </MudStack>
                                <MudText Class="ml-6" Style="color: #666;">@FormatBoolean(_systemInfo.EnvironmentInfo.UserInteractive)</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudAlert Severity="Severity.Error" Class="ma-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Error" />
                <MudText>@L["Page:States:LoadFailedAlert"]</MudText>
            </MudStack>
        </MudAlert>
    }
</MudContainer>

@code {
    public const string PAGE_URL = "/system-info";

    private bool _loading = true;
    private SystemInfoResponse? _systemInfo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSystemInfoAsync();
        }
    }

    private async Task<bool> LoadSystemInfoAsync()
    {
        _loading = true;
        StateHasChanged();

        var isSuccess = false;

        try
        {
            if ((await SystemInfoService.GetSystemInfoAsync(simple: false)).IsFailed(out var error, out var data))
            {
                Snackbar.Add(L["Page:Messages:LoadFailed", error.Message ?? string.Empty].Value, Severity.Error);
            }
            else
            {
                _systemInfo = data;
                isSuccess = true;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Page:Messages:LoadError", ex.Message].Value, Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }

        return isSuccess;
    }

    private async Task RefreshSystemInfo()
    {
        if (await LoadSystemInfoAsync())
        {
            Snackbar.Add(L["Page:Messages:RefreshSucceeded"].Value, Severity.Success);
        }
    }

    private string FormatDateTime(DateTime value)
    {
        return value.ToString("G", CultureInfo.CurrentCulture);
    }

    private string FormatBoolean(bool value)
    {
        return L[value ? "Shared:Common:Yes" : "Shared:Common:No"].Value;
    }

    private string FormatScaledBytes(long bytes)
    {
        const int scale = 1024;
        string[] unitKeys = ["Bytes", "Kilobytes", "Megabytes", "Gigabytes", "Terabytes"];
        double value = bytes;
        var order = 0;

        while (Math.Abs(value) >= scale && order < unitKeys.Length - 1)
        {
            order++;
            value /= scale;
        }

        return $"{value.ToString("0.##", CultureInfo.CurrentCulture)} {L[$"Shared:Units:{unitKeys[order]}"].Value}";
    }

    private string FormatByteCount(long bytes)
    {
        return $"{bytes.ToString("N0", CultureInfo.CurrentCulture)} {L["Shared:Units:Bytes"].Value}";
    }

    private string FormatUptime(DateTime startTime)
    {
        var uptime = DateTime.Now - startTime;
        if (uptime < TimeSpan.Zero)
        {
            uptime = TimeSpan.Zero;
        }

        List<string> parts = [];

        AppendDurationPart(parts, uptime.Days, "Shared:Duration:DaySingular", "Shared:Duration:DayPlural");
        AppendDurationPart(parts, uptime.Hours, "Shared:Duration:HourSingular", "Shared:Duration:HourPlural");
        AppendDurationPart(parts, uptime.Minutes, "Shared:Duration:MinuteSingular", "Shared:Duration:MinutePlural");

        var secondValue = uptime.Milliseconds == 0
            ? uptime.Seconds
            : uptime.Seconds + uptime.Milliseconds / 1000d;

        AppendDurationPart(parts, secondValue, "Shared:Duration:SecondSingular", "Shared:Duration:SecondPlural");

        if (parts.Count == 0)
        {
            return L["Shared:Duration:ZeroSeconds"].Value;
        }

        return string.Join(L["Shared:Duration:Separator"].Value, parts);
    }

    private void AppendDurationPart(List<string> parts, int value, string singularKey, string pluralKey)
    {
        if (value <= 0)
        {
            return;
        }

        parts.Add(L[value == 1 ? singularKey : pluralKey, value].Value);
    }

    private void AppendDurationPart(List<string> parts, double value, string singularKey, string pluralKey)
    {
        if (value <= 0)
        {
            return;
        }

        parts.Add(L[Math.Abs(value - 1d) < 0.0001d ? singularKey : pluralKey, value].Value);
    }
}
