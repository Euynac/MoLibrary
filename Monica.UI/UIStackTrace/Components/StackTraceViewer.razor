@using Monica.UI.UIStackTrace.Models
@using Monica.UI.UIStackTrace.Services
@using Microsoft.JSInterop
@using MudBlazor
@inject StackTraceParserService ParserService
@inject IJSRuntime JS

<div class="stack-trace-container">
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="copy-button-wrapper">
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                           Size="Size.Small"
                           OnClick="CopyToClipboard"
                           Title="复制堆栈信息" />
        </div>
    }
    @if (_parseResult?.Success == true && _parseResult.Lines.Count > 0)
    {
        @foreach (var (line, level) in GetLinesWithLevel(_parseResult.Lines))
        {
            @if (line.LineType == StackLineType.ExceptionHeader)
            {
                <div class="exception-header" style="@GetInnerExceptionIndentForLevel(level)">
                    <span class="exception-type">@line.ExceptionType:</span>
                    <span class="exception-message">@line.Message</span>
                </div>
            }
            else if (line.LineType == StackLineType.StackFrame)
            {
                <div class="stack-frame" style="@GetInnerExceptionIndentForLevel(level)">
                    <!-- "at" 关键字: 加粗 + Color.Info -->
                    <span class="at-keyword">at</span>

                    <!-- 命名空间、类名、方法名 -->
                    @if (!string.IsNullOrEmpty(line.Namespace))
                    {
                        <span class="namespace-part">@line.Namespace.</span>
                    }
                    @if (!string.IsNullOrEmpty(line.ClassName))
                    {
                        <span class="classname-part">@line.ClassName.</span>
                    }
                    @if (!string.IsNullOrEmpty(line.MethodName))
                    {
                        <!-- 最后一个方法名: 加粗 + Color.Warning -->
                        <span class="method-name">@line.MethodName</span>
                    }

                    <!-- 方法参数 -->
                    @if (!string.IsNullOrEmpty(line.Parameters))
                    {
                        <span class="param-bracket">(</span>
                        @if (line.ParsedParameters.Count > 0)
                        {
                            @for (int i = 0; i < line.ParsedParameters.Count; i++)
                            {
                                if (i > 0)
                                {
                                    <span class="param-separator">,</span>
                                    <span class="param-space"> </span>
                                }
                                <!-- 参数类型: 加粗 -->
                                <span class="param-type">@line.ParsedParameters[i].Type</span>
                                @if (!string.IsNullOrEmpty(line.ParsedParameters[i].Name))
                                {
                                    <span class="param-space"> </span>
                                    <!-- 参数名: 不加粗 -->
                                    <span class="param-name">@line.ParsedParameters[i].Name</span>
                                }
                            }
                        }
                        <span class="param-bracket">)</span>
                    }

                    <!-- 文件信息 -->
                    @if (!string.IsNullOrEmpty(line.FilePath))
                    {
                        <span class="in-keyword"> in </span>
                        @if (line.FilePath.Length > line.FileName?.Length)
                        {
                            <span class="file-path-dir">@line.FilePath.Substring(0, line.FilePath.Length - (line.FileName?.Length ?? 0))</span>
                        }
                        @if (!string.IsNullOrEmpty(line.FileName))
                        {
                            <!-- 文件名: 加粗 + Color.Warning -->
                            <span class="file-name">@line.FileName</span>
                        }
                    }

                    <!-- 行号: 加粗 + Color.Error -->
                    @if (line.LineNumber.HasValue)
                    {
                        <span class="line-info">:line</span>
                        <span class="line-number"> @line.LineNumber</span>
                    }
                </div>
            }
            else if (line.LineType == StackLineType.InnerException)
            {
                <div class="inner-exception-header" style="@GetInnerExceptionIndentForLevel(level)">
                    <span class="inner-exception-label">@line.RawContent</span>
                </div>
            }
            else if (line.LineType == StackLineType.PlainText)
            {
                <div class="plain-text-line" style="@GetInnerExceptionIndentForLevel(level)">
                    @if (IsEndOfInnerException(line.RawContent))
                    {
                        <span class="inner-exception-end">@line.RawContent</span>
                    }
                    else
                    {
                        @line.RawContent
                    }
                </div>
            }
            else if (line.LineType == StackLineType.ParseError)
            {
                <div class="parse-error">
                    <span class="error-icon">⚠</span>
                    <span class="error-message">@line.ErrorMessage</span>
                </div>
            }
        }
    }
    else if (_parseResult?.Success == false)
    {
        <!-- 解析失败，显示错误提示和原始文本 -->
        <div class="parse-error">
            <span class="error-icon">⚠</span>
            <span class="error-message">@_parseResult.ErrorMessage</span>
        </div>
        <div class="fallback-text">
            <pre>@_parseResult.OriginalText</pre>
        </div>
    }
    else
    {
        <div class="empty-message">暂无堆栈信息</div>
    }
</div>

@code {
    /// <summary>
    /// 堆栈信息文本
    /// </summary>
    [Parameter]
    public string? Message { get; set; }

    private ParseResult? _parseResult;

    /// <summary>
    /// 组件参数变化时调用
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Message))
        {
            _parseResult = ParserService.Parse(Message);
        }
        else
        {
            _parseResult = new ParseResult { Success = false, ErrorMessage = "未提供堆栈信息" };
        }
    }

    /// <summary>
    /// 获取行及其对应的嵌套层级
    /// </summary>
    private IEnumerable<(StackTraceLine line, int level)> GetLinesWithLevel(List<StackTraceLine> lines)
    {
        int level = 0;
        foreach (var line in lines)
        {
            if (line.LineType == StackLineType.InnerException)
            {
                level++;
                yield return (line, level - 1);
            }
            else if (line.LineType == StackLineType.PlainText && line.RawContent?.Contains("--- End of inner exception") == true)
            {
                yield return (line, level);
                if (level > 0)
                {
                    level--;
                }
            }
            else
            {
                yield return (line, level);
            }
        }
    }

    /// <summary>
    /// 获取指定层级的内部异常缩进样式
    /// </summary>
    private string GetInnerExceptionIndentForLevel(int level)
    {
        if (level <= 0)
            return "";

        return $"margin-left: {level * 16}px; border-left: 2px dashed var(--mud-palette-warning);";
    }

    /// <summary>
    /// 检查是否为内部异常结束标记
    /// </summary>
    private bool IsEndOfInnerException(string? content)
    {
        return content?.Contains("--- End of inner exception") == true;
    }

    /// <summary>
    /// 复制堆栈信息到剪贴板
    /// </summary>
    private async Task CopyToClipboard()
    {
        if (!string.IsNullOrEmpty(Message))
        {
            await JS.InvokeAsync<bool>("MoClipboard.copyText", Message);
        }
    }
}
