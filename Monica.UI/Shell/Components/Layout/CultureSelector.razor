@using System.Globalization
@using Microsoft.Extensions.Localization
@using Monica.Core.Localization.Models
@using Monica.UI.Localization
@using Monica.UI.Shell.Support
@inject NavigationManager NavigationManager
@inject LocalizationProfile LocalizationProfile
@inject IJSRuntime JSRuntime
@inject IBrowserStorage BrowserStorage
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<MudMenu Icon="@Icons.Material.Filled.Language"
         Color="Color.Primary"
         Size="Size.Medium"
         AnchorOrigin="Origin.BottomCenter"
         TransformOrigin="Origin.TopCenter"
         ListClass="mo-appbar-menu-list"
         Class="action-button"
         title="@L["Layout:LanguageTooltip"]">
    @foreach (var culture in LocalizationProfile.SupportedCultures)
    {
        var displayName = LocalizationProfile.GetDisplayName(culture);
        var isCurrentCulture = string.Equals(
            CultureInfo.CurrentUICulture.Name,
            culture,
            StringComparison.OrdinalIgnoreCase);

        <MudMenuItem OnClick="@(() => ChangeCultureAsync(culture))"
                     Class="@(isCurrentCulture ? "active" : null)"
                     Icon="@(isCurrentCulture ? Icons.Material.Filled.Check : null)">
            @displayName
        </MudMenuItem>
    }
</MudMenu>

@code {
    private const string StorageKey = "culture:preference";
    private IJSObjectReference? _cultureHelperModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load JS module
            _cultureHelperModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Monica.UI/js/culture-helper.js");

            // Load culture preference from localStorage
            var storedCulture = await BrowserStorage.GetAsync<string?>(StorageKey, null);
            var culture = LocalizationProfile.ResolveCulture(storedCulture);

            if (!string.Equals(storedCulture, culture, StringComparison.Ordinal))
            {
                await BrowserStorage.SetAsync(StorageKey, culture);
            }

            // Keep the server-side request-culture cookie aligned with the canonical browser preference.
            var cookieCulture = await _cultureHelperModule.InvokeAsync<string?>(
                "getCultureFromCookie", LocalizationProfile.CookieName);
            if (!string.Equals(cookieCulture, culture, StringComparison.Ordinal))
            {
                await _cultureHelperModule.InvokeVoidAsync(
                    "setCultureCookie", culture, LocalizationProfile.CookieName);
            }
        }
    }

    private async Task ChangeCultureAsync(string culture)
    {
        if (_cultureHelperModule == null)
        {
            return;
        }

        // 1. Save to localStorage (source of truth)
        await BrowserStorage.SetAsync(StorageKey, culture);

        // 2. Set cookie for server-side middleware
        await _cultureHelperModule.InvokeVoidAsync(
            "setCultureCookie", culture, LocalizationProfile.CookieName);

        // 3. Reload page to apply culture change
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_cultureHelperModule != null)
        {
            try
            {
                await _cultureHelperModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already disconnected
            }
        }
    }
}
