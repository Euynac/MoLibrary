@using System.Globalization
@using Microsoft.Extensions.Localization
@using Monica.Core.Localization.Models
@using Monica.UI.Localization
@using Monica.UI.Shell.Support
@inject NavigationManager NavigationManager
@inject LocalizationProfile LocalizationProfile
@inject IJSRuntime JSRuntime
@inject IBrowserStorage BrowserStorage
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<MudMenu Icon="@Icons.Material.Filled.Language"
         Color="Color.Primary"
         Size="Size.Medium"
         AnchorOrigin="Origin.BottomCenter"
         TransformOrigin="Origin.TopCenter"
         ListClass="mo-appbar-menu-list"
         Class="action-button"
         title="@L["Layout:LanguageTooltip"]">
    @foreach (var culture in LocalizationProfile.SupportedCultures)
    {
        var displayName = LocalizationProfile.GetDisplayName(culture);
        var isCurrentCulture = string.Equals(
            CultureInfo.CurrentUICulture.Name,
            culture,
            StringComparison.OrdinalIgnoreCase);

        <MudMenuItem OnClick="@(() => ChangeCultureAsync(culture))"
                     Class="@(isCurrentCulture ? "active" : null)"
                     Icon="@(isCurrentCulture ? Icons.Material.Filled.Check : null)">
            @displayName
        </MudMenuItem>
    }
</MudMenu>

@code {
    private const string STORAGE_KEY = "culture:preference";
    private const string CULTURE_MODULE_PATH = "./_content/Monica.UI/js/culture-helper.js";
    private JsModuleSession? _cultureInterop;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _cultureInterop = new JsModuleSession(JSRuntime, CULTURE_MODULE_PATH);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed || _cultureInterop is not { } cultureInterop)
        {
            return;
        }

        try
        {
            var storedCulture = await BrowserStorage.GetAsync<string?>(STORAGE_KEY, null);
            if (_disposed)
            {
                return;
            }

            var culture = LocalizationProfile.ResolveCulture(storedCulture);
            if (!string.Equals(storedCulture, culture, StringComparison.Ordinal))
            {
                await BrowserStorage.SetAsync(STORAGE_KEY, culture);
            }

            if (_disposed)
            {
                return;
            }

            var cookieCulture = await cultureInterop.InvokeAsync<string?>(
                "getCultureFromCookie",
                LocalizationProfile.CookieName);
            if (!string.Equals(cookieCulture, culture, StringComparison.Ordinal))
            {
                await cultureInterop.InvokeVoidAsync(
                    "setCultureCookie",
                    culture,
                    LocalizationProfile.CookieName);
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit ended before culture synchronization completed.
        }
        catch (ObjectDisposedException) when (_disposed)
        {
            // Component disposal won the race with first-render initialization.
        }
    }

    private async Task ChangeCultureAsync(string culture)
    {
        if (_disposed || _cultureInterop is not { } cultureInterop)
        {
            return;
        }

        var resolvedCulture = LocalizationProfile.ResolveCulture(culture);
        await BrowserStorage.SetAsync(STORAGE_KEY, resolvedCulture);
        if (_disposed)
        {
            return;
        }

        try
        {
            await cultureInterop.InvokeVoidAsync(
                "setCultureCookie",
                resolvedCulture,
                LocalizationProfile.CookieName);
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (ObjectDisposedException) when (_disposed)
        {
            return;
        }

        if (!_disposed)
        {
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var cultureInterop = _cultureInterop;
        _cultureInterop = null;
        if (cultureInterop is not null)
        {
            await cultureInterop.DisposeAsync();
        }
    }
}
