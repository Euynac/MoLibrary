@using System.Globalization
@using Microsoft.Extensions.Options
@using Microsoft.Extensions.Localization
@using Monica.Modules
@using Monica.UI.Localization
@using Monica.UI.Shell.Support
@inject NavigationManager NavigationManager
@inject IOptions<ModuleLocalizationOption> LocalizationOptions
@inject IJSRuntime JSRuntime
@inject IBrowserStorage BrowserStorage
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<MudMenu Icon="@Icons.Material.Filled.Language"
         Color="Color.Primary"
         Size="Size.Medium"
         AnchorOrigin="Origin.BottomCenter"
         TransformOrigin="Origin.TopCenter"
         Class="action-button"
         title="@L["Layout:LanguageTooltip"]">
    @foreach (var culture in LocalizationOptions.Value.SupportedCultures)
    {
        var displayName = LocalizationOptions.Value.CultureDisplayNames.TryGetValue(culture, out var name)
            ? name
            : new CultureInfo(culture).NativeName;
        var isCurrentCulture = CultureInfo.CurrentUICulture.Name == culture;

        <MudMenuItem OnClick="@(() => ChangeCultureAsync(culture))"
                     Icon="@(isCurrentCulture ? Icons.Material.Filled.Check : null)">
            @displayName
        </MudMenuItem>
    }
</MudMenu>

@code {
    private const string StorageKey = "culture:preference";
    private IJSObjectReference? _cultureHelperModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load JS module
            _cultureHelperModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Monica.UI/js/culture-helper.js");

            // Load culture preference from localStorage
            var storedCulture = await BrowserStorage.GetAsync<string?>(StorageKey, null);

            if (storedCulture != null && LocalizationOptions.Value.SupportedCultures.Contains(storedCulture))
            {
                // Ensure cookie is in sync with localStorage
                var cookieCulture = await _cultureHelperModule.InvokeAsync<string?>(
                    "getCultureFromCookie", LocalizationOptions.Value.CookieName);

                if (cookieCulture != storedCulture)
                {
                    // Sync cookie with localStorage
                    await _cultureHelperModule.InvokeVoidAsync(
                        "setCultureCookie", storedCulture, LocalizationOptions.Value.CookieName);
                }
            }
            else if (storedCulture == null)
            {
                // First visit - save default culture to localStorage
                var defaultCulture = LocalizationOptions.Value.DefaultCulture;
                await BrowserStorage.SetAsync(StorageKey, defaultCulture);
                await _cultureHelperModule.InvokeVoidAsync(
                    "setCultureCookie", defaultCulture, LocalizationOptions.Value.CookieName);
            }
        }
    }

    private async Task ChangeCultureAsync(string culture)
    {
        if (_cultureHelperModule == null)
        {
            return;
        }

        // 1. Save to localStorage (source of truth)
        await BrowserStorage.SetAsync(StorageKey, culture);

        // 2. Set cookie for server-side middleware
        await _cultureHelperModule.InvokeVoidAsync(
            "setCultureCookie", culture, LocalizationOptions.Value.CookieName);

        // 3. Reload page to apply culture change
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_cultureHelperModule != null)
        {
            try
            {
                await _cultureHelperModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already disconnected
            }
        }
    }
}
