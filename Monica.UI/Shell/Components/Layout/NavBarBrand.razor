@using Microsoft.Extensions.Options
@using Monica.Modules
@inject IOptions<ModuleShellUIOption> Options

<a class="navbar-brand" href="/system-info" aria-label="@Options.Value.GetAppName()">
    <div class="brand-logo">
        <img class="brand-logo-image"
             src="/_content/Monica.UI/favicon.ico"
             alt=""
             width="40"
             height="40" />
    </div>
    <div class="brand-text">
        <div class="brand-name">@Options.Value.GetAppName()</div>
        <div class="brand-version-container">
            @if (!string.IsNullOrWhiteSpace(Options.Value.GetAppId()))
            {
                <span class="brand-appid">@Options.Value.GetAppId()</span>
            }
            <span class="brand-version">@Options.Value.GetAppVersion()</span>
        </div>
    </div>
</a>
