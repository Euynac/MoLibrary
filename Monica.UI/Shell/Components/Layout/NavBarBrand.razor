@using Microsoft.Extensions.Options
@using Monica.Modules
@inject IOptions<ModuleShellUIOption> Options
@inject NavigationManager NavigationManager

<div class="navbar-brand" @onclick="NavigateToHome">
    <div class="brand-logo">
        <img class="brand-logo-image"
             src="/_content/Monica.UI/favicon.ico"
             alt=""
             width="40"
             height="40" />
    </div>
    <div class="brand-text">
        <div class="brand-name">@Options.Value.UIAppBarName</div>
        <div class="brand-version">@Options.Value.UIAppVersion</div>
    </div>
</div>

@code {
    private void NavigateToHome()
    {
        NavigationManager.NavigateTo("/system-info");
    }
}
