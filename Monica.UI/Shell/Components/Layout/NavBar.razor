<nav class="mo-navbar">
    <NavBarBrand />

    <div class="navbar-nav navbar-nav-desktop" @ref="_desktopNavRef">
        @foreach (var category in VisibleCategories)
        {
            <NavBarDropdown Category="@category.Key"
                            Items="@category.Value" />
        }

        @if (HasMoreCategories)
        {
            <NavBarMore Categories="@MoreCategories" />
        }
    </div>

    <div class="navbar-nav navbar-nav-compact">
        @if (HasAnyCategories)
        {
            <NavBarMore Categories="@AllCategories" CompactMode="true" />
        }
    </div>

    <NavBarActions />

    <div class="navbar-measurements" @ref="_measurementRailRef" aria-hidden="true">
        @foreach (var category in OrderedCategories)
        {
            <div class="navbar-measure-item" data-nav-measure="category">
                <button class="navbar-measure-link" type="button">
                    <span>@category.Key</span>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown"
                             Size="Size.Small"
                             Class="navbar-measure-icon" />
                </button>
            </div>
        }

        <div class="navbar-measure-item" data-nav-measure="more">
            <button class="navbar-measure-link" type="button">
                <span>@L["NavBar:More"]</span>
                <MudIcon Icon="@Icons.Material.Filled.MoreHoriz"
                         Size="Size.Small"
                         Class="navbar-measure-icon" />
            </button>
        </div>
    </div>
</nav>
