@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.Shell.Models
@using Monica.UI.Shell.Support
@inject IStringLocalizer<SharedResource> L
@inject IStringLocalizer<UIRegistryResource> RegistryL

@{
    var orderedCategories = GetOrderedCategories();
}

<div class="@RootCssClass">
    <MudMenu ActivationEvent="MudBlazor.MouseEvent.MouseOver"
             AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight"
             PopoverClass="@GetMorePopoverClass()"
             ListClass="mo-nav-menu-list">
        <ActivatorContent Context="menu">
            <button class="navbar-link"
                    type="button"
                    @onclick="menu.ToggleAsync">
                @L["NavBar:More"]
                <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" />
            </button>
        </ActivatorContent>

        <ChildContent>
            @for (var categoryIndex = 0; categoryIndex < orderedCategories.Count; categoryIndex++)
            {
                var category = orderedCategories[categoryIndex];
                var openSubmenuToLeft = CompactMode || categoryIndex == orderedCategories.Count - 1;

                <MudMenu ActivationEvent="MudBlazor.MouseEvent.MouseOver"
                         Label="@category.Key"
                         AnchorOrigin="@(openSubmenuToLeft ? Origin.TopLeft : Origin.TopRight)"
                         TransformOrigin="@(openSubmenuToLeft ? Origin.TopRight : Origin.TopLeft)"
                         PopoverClass="@GetCategoryPopoverClass()"
                         ListClass="mo-nav-menu-list">
                    <ChildContent>
                        @foreach (var item in category.Value.OrderBy(i => i.Order))
                        {
                            <MudMenuItem Href="@item.Href"
                                         Icon="@item.Icon"
                                         Class="@NavigationRouteMatcher.GetActiveClass(NavigationManager, item)">
                                @item.ResolveDisplayText(RegistryL)
                            </MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            }
        </ChildContent>
    </MudMenu>
</div>
