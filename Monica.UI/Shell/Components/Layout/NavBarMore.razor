@using Microsoft.Extensions.Localization
@using Monica.Core.Localization.Abstractions
@using Monica.UI.Localization
@using Monica.UI.Shell.Models
@using Monica.UI.Shell.Support
@inject IStringLocalizer<SharedResource> L
@inject ILocalizationCatalog LocalizationCatalog

<div class="@RootCssClass">
    <MudMenu AriaLabel="@L["NavBar:More"]"
             Class="navbar-menu navbar-link"
             ActivationEvent="@MouseEvent.MouseOver"
             AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight"
             PopoverClass="@MorePopoverCssClass"
             ListClass="mo-appbar-menu-list">
        <ActivatorContent Context="menu">
            <span class="mo-navbar-menu-activator-content" @onclick="menu.OpenAsync">
                <span>@L["NavBar:More"]</span>
                <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" />
            </span>
        </ActivatorContent>
        <ChildContent>
            <div class="more-menu-header">@L["NavBar:MoreModules"]</div>
            @foreach (var category in Categories)
            {
                <MudMenu Label="@category.DisplayName"
                         AriaLabel="@category.DisplayName"
                         EndIcon="@Icons.Material.Filled.ChevronRight"
                         Class="more-category-item"
                         PopoverClass="@FlyoutPopoverCssClass"
                         ListClass="mo-appbar-menu-list"
                         data-navigation-category-id="@category.Id.Value">
                    <div class="flyout-menu-header">@category.DisplayName</div>
                    @foreach (var item in category.Items)
                    {
                        <MudMenuItem Href="@item.Href"
                                     Icon="@item.Icon"
                                     Class="@NavigationRouteMatcher.GetActiveClass(CurrentRoute, item.Href)">
                            @item.ResolveText(LocalizationCatalog)
                        </MudMenuItem>
                    }
                </MudMenu>
            }
        </ChildContent>
    </MudMenu>
</div>

@code {
    [Parameter] public IReadOnlyList<NavigationGroup> Categories { get; set; } = [];
    [Parameter] public string CurrentRoute { get; set; } = string.Empty;
    [Parameter] public bool CompactMode { get; set; }

    private string RootCssClass => CompactMode ? "navbar-more navbar-more-compact" : "navbar-more";

    private string MorePopoverCssClass => CompactMode
        ? "dropdown-menu more-menu more-menu-scrollable mo-navbar-menu-popover mo-navbar-more-popover mo-navbar-menu-popover-compact"
        : "dropdown-menu more-menu more-menu-scrollable mo-navbar-menu-popover mo-navbar-more-popover";

    private string FlyoutPopoverCssClass => CompactMode
        ? "flyout-menu mo-navbar-menu-popover mo-navbar-flyout-popover mo-navbar-menu-popover-compact"
        : "flyout-menu mo-navbar-menu-popover mo-navbar-flyout-popover";
}
