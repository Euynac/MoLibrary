@using Microsoft.Extensions.Options
@using Microsoft.Extensions.Localization
@using Monica.Modules
@using Monica.UI.Localization
@using Monica.UI.Shell.State
@inject UserContextState UserContext
@inject IOptions<ModuleShellUIOption> Options
@inject IStringLocalizer<SharedResource> L

<div class="navbar-actions">
    @if (Options.Value.EnableNavBarSearch && Options.Value.NavBarSearchAction is not null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Search"
                       Color="Color.Default"
                       Size="Size.Medium"
                       Class="action-button action-button--secondary"
                       OnClick="OpenSearchAsync"
                       aria-label="@L["Layout:SearchTooltip"]"
                       title="@L["Layout:SearchTooltip"]" />
    }

    @if (Options.Value.NavBarNotificationsAction is not null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                       Color="Color.Default"
                       Size="Size.Medium"
                       Class="action-button action-button--secondary"
                       OnClick="OpenNotificationsAsync"
                       aria-label="@L["Layout:NotificationsTooltip"]"
                       title="@L["Layout:NotificationsTooltip"]" />
    }

    <ThemeSelector />

    @if (Options.Value.ShowLanguageSwitcher)
    {
        <CultureSelector />
    }
    @if (HasUserActions)
    {
        <MudMenu AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 ListClass="mo-appbar-menu-list"
                 Class="user-menu">
            <ActivatorContent Context="menu">
                <MudButton Variant="Variant.Text"
                           Class="user-button"
                           StartIcon="@Icons.Material.Filled.AccountCircle"
                           OnClick="@(() => menu.ToggleAsync())">
                    <span class="user-name">@UserContext.UserName</span>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                @if (Options.Value.UserProfileAction is not null)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="OpenProfileAsync">
                        @L["Layout:UserMenu:Profile"]
                    </MudMenuItem>
                }
                @if (Options.Value.UserSettingsAction is not null)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="OpenSettingsAsync">
                        @L["Layout:UserMenu:Settings"]
                    </MudMenuItem>
                }
                @if (HasAccountActions && Options.Value.UserLogoutAction is not null)
                {
                    <MudDivider />
                }
                @if (Options.Value.UserLogoutAction is not null)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">
                        @L["Layout:UserMenu:Logout"]
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
    }
    else
    {
        <div class="user-identity" aria-label="@UserContext.UserName">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" />
            <span class="user-name">@UserContext.UserName</span>
        </div>
    }
</div>

@code {
    private bool HasUserActions =>
        Options.Value.UserProfileAction is not null ||
        Options.Value.UserSettingsAction is not null ||
        Options.Value.UserLogoutAction is not null;

    private bool HasAccountActions =>
        Options.Value.UserProfileAction is not null ||
        Options.Value.UserSettingsAction is not null;

    private Task OpenSearchAsync() => Options.Value.NavBarSearchAction?.Invoke() ?? Task.CompletedTask;

    private Task OpenNotificationsAsync() => Options.Value.NavBarNotificationsAction?.Invoke() ?? Task.CompletedTask;

    private Task OpenProfileAsync() => Options.Value.UserProfileAction?.Invoke() ?? Task.CompletedTask;

    private Task OpenSettingsAsync() => Options.Value.UserSettingsAction?.Invoke() ?? Task.CompletedTask;

    private Task LogoutAsync() => Options.Value.UserLogoutAction?.Invoke() ?? Task.CompletedTask;
}
