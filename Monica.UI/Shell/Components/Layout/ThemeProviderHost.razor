@inject ThemeState ThemeService
@inject IBrowserStorage BrowserStorage
@inject IJSRuntime JSRuntime
@using Monica.UI.Shell.State
@using Monica.UI.Shell.Support
@using Monica.UI.Theming
@implements IAsyncDisposable

<MudThemeProvider Theme="@ThemeService.CurrentTheme" IsDarkMode="@ThemeService.IsDarkMode" />

<div class="@ThemeService.GetThemeCssClass()" data-theme="@ThemeService.GetThemeDataAttribute()">
    @ChildContent
</div>

@code {
    private const string THEME_MODULE_PATH = "./_content/Monica.UI/js/theme-helper.js";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly SemaphoreSlim _themeChangeGate = new(1, 1);
    private readonly List<Task> _pendingThemeChanges = [];
    private readonly object _disposeSync = new();
    private JsModuleSession? _themeInterop;
    private Task? _disposeTask;
    private bool _acceptThemeChanges;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _themeInterop = new JsModuleSession(JSRuntime, THEME_MODULE_PATH);
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed || _themeInterop is not { } themeInterop)
        {
            return;
        }

        var themeData = await BrowserStorage.GetAsync<ThemeData?>("theme:data", null);
        if (_disposed)
        {
            return;
        }

        if (themeData is not null)
        {
            await InvokeAsync(() => ThemeService.SetTheme(themeData.ThemeKind, themeData.IsDarkMode));
        }
        else
        {
            await PersistCurrentThemeAsync();
        }

        if (_disposed)
        {
            return;
        }

        try
        {
            await themeInterop.InvokeVoidAsync(
                "setDocumentTheme",
                ThemeService.GetThemeDataAttribute());
            _acceptThemeChanges = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit ended while the initial document theme was being applied.
        }
        catch (ObjectDisposedException) when (_disposed)
        {
            // Component disposal won the race with first-render initialization.
        }
    }

    private void OnThemeChanged()
    {
        lock (_disposeSync)
        {
            if (_disposed || !_acceptThemeChanges)
            {
                return;
            }

            _pendingThemeChanges.Add(InvokeAsync(ApplyThemeChangeAsync));
        }
    }

    private async Task ApplyThemeChangeAsync()
    {
        await _themeChangeGate.WaitAsync();
        try
        {
            if (_disposed)
            {
                return;
            }

            await PersistCurrentThemeAsync();

            if (_disposed || _themeInterop is not { } themeInterop)
            {
                return;
            }

            try
            {
                await themeInterop.InvokeVoidAsync(
                    "setDocumentTheme",
                    ThemeService.GetThemeDataAttribute());
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit ended while a theme selection was being applied.
                return;
            }
            catch (ObjectDisposedException) when (_disposed)
            {
                return;
            }

            if (!_disposed)
            {
                StateHasChanged();
            }
        }
        finally
        {
            _themeChangeGate.Release();
        }
    }

    private Task PersistCurrentThemeAsync()
    {
        return BrowserStorage.SetAsync("theme:data", new ThemeData(
            ThemeService.CurrentThemeKind, ThemeService.IsDarkMode));
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync)
        {
            return new ValueTask(_disposeTask ??= BeginDispose());
        }
    }

    private Task BeginDispose()
    {
        _disposed = true;
        _acceptThemeChanges = false;
        ThemeService.OnThemeChanged -= OnThemeChanged;
        var pendingThemeChanges = _pendingThemeChanges.ToArray();
        var themeInterop = _themeInterop;
        _themeInterop = null;
        return DisposeCoreAsync(pendingThemeChanges, themeInterop);
    }

    private static async Task DisposeCoreAsync(
        IReadOnlyList<Task> pendingThemeChanges,
        JsModuleSession? themeInterop)
    {
        try
        {
            await Task.WhenAll(pendingThemeChanges);
        }
        catch (JSDisconnectedException)
        {
            // Circuit already disconnected.
        }
        catch (ObjectDisposedException)
        {
            // A pending renderer callback observed component disposal.
        }
        finally
        {
            if (themeInterop is not null)
            {
                await themeInterop.DisposeAsync();
            }
        }
    }

    private record ThemeData(MonicaThemeKind ThemeKind, bool IsDarkMode);
}
