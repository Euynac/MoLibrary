@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.Shell.Models
@using Monica.UI.Shell.Support
@inject IStringLocalizer<UIRegistryResource> RegistryL
@inject NavigationManager NavigationManager

<div class="navbar-item">
    <MudMenu ActivationEvent="MudBlazor.MouseEvent.MouseOver"
             AnchorOrigin="Origin.BottomLeft"
             TransformOrigin="Origin.TopLeft"
             PopoverClass="mo-nav-menu-popover"
             ListClass="mo-nav-menu-list">
        <ActivatorContent Context="menu">
            <button class="navbar-link"
                    type="button"
                    @onclick="menu.ToggleAsync">
                @Category
                <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
            </button>
        </ActivatorContent>

        <ChildContent>
            @foreach (var item in Items.OrderBy(i => i.Order))
            {
                <MudMenuItem Href="@item.Href"
                             Icon="@item.Icon"
                             Class="@NavigationRouteMatcher.GetActiveClass(NavigationManager, item)">
                    @item.ResolveDisplayText(RegistryL)
                </MudMenuItem>
            }
        </ChildContent>
    </MudMenu>
</div>

@code {
    [Parameter] public string Category { get; set; } = string.Empty;
    [Parameter] public List<NavigationItem> Items { get; set; } = new();
}
