@using Monica.Core.Localization.Abstractions
@using Monica.UI.Shell.Models
@inject ILocalizationCatalog LocalizationCatalog

<div class="navbar-item" data-navigation-category-id="@CategoryId.Value">
    <MudMenu Label="@Category"
             AriaLabel="@Category"
             EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
             Variant="Variant.Text"
             Class="navbar-menu"
             AnchorOrigin="Origin.BottomLeft"
             TransformOrigin="Origin.TopLeft"
             Dense="true"
             ListClass="mo-appbar-menu-list">
        @foreach (var item in Items)
        {
            <MudMenuItem Href="@item.Href" Icon="@item.Icon">
                @item.ResolveText(LocalizationCatalog)
            </MudMenuItem>
        }
    </MudMenu>
</div>

@code {
    [Parameter] public string Category { get; set; } = string.Empty;
    [Parameter] public NavigationCategoryId CategoryId { get; set; } = default!;
    [Parameter] public IReadOnlyList<NavigationItem> Items { get; set; } = [];
}
