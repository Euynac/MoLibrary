@typeparam TItem

<MudMenu @ref="_menu"
         Class="mo-context-menu-root"
         PopoverClass="mo-context-menu-popover"
         ListClass="mo-context-menu-list"
         PositionAtCursor="true"
         PopoverFixed="true"
         Dense="true"
         DropShadow="false"
         Modal="true"
         OpenChanged="HandleOpenChangedAsync">
    <MoContextMenuItems TItem="TItem"
                        Items="Items"
                        ContextItem="ContextItem"
                        OnItemSelected="HandleItemSelectedAsync" />
</MudMenu>

@code {
    [Parameter] public List<ContextMenuItem<TItem>> Items { get; set; } = [];
    [Parameter] public bool Visible { get; set; }
    [Parameter] public double InitialX { get; set; }
    [Parameter] public double InitialY { get; set; }
    [Parameter] public TItem? ContextItem { get; set; }
    [Parameter] public EventCallback<ContextMenuItem<TItem>> OnItemClick { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private MudMenu? _menu;
    private double _renderedX = double.NaN;
    private double _renderedY = double.NaN;
    private bool _menuOpen;
    private bool _repositioning;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_menu is null)
        {
            return;
        }

        if (!Visible)
        {
            if (_menuOpen)
            {
                await _menu.CloseMenuAsync();
            }

            return;
        }

        var positionChanged = _renderedX != InitialX || _renderedY != InitialY;
        if (_menuOpen && positionChanged)
        {
            _repositioning = true;
            await _menu.CloseMenuAsync();
        }

        if (!_menuOpen || positionChanged)
        {
            _renderedX = InitialX;
            _renderedY = InitialY;
            await _menu.OpenMenuAsync(new MouseEventArgs
            {
                PageX = InitialX,
                PageY = InitialY,
                ClientX = InitialX,
                ClientY = InitialY,
                Button = 2
            });
        }

        _repositioning = false;
    }

    private async Task HandleOpenChangedAsync(bool isOpen)
    {
        _menuOpen = isOpen;
        if (!isOpen && Visible && !_repositioning)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleItemSelectedAsync(ContextMenuItem<TItem> item)
    {
        await OnItemClick.InvokeAsync(item);
        await OnClose.InvokeAsync();
    }
}
