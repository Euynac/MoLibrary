@using MudBlazor
@using Monica.UI.Localization
@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Modularity.Models
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<SharedResource> L

<MudDialog Visible="IsVisible" VisibleChanged="OnVisibleChanged" Options="@DIALOG_OPTIONS">
    <DialogContent>
        @if (SelectedModuleDetail != null)
        {
            <div class="module-detail-header mb-4">
                <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.ViewModule" Class="mr-2" />
                    @SelectedModuleDetail.BasicInfo.ModuleTypeName
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                    @SelectedModuleDetail.BasicInfo.ModuleFullTypeName
                </MudText>
            </div>
            
            <MudTabs Elevation="2"
                     Rounded="true"
                     ApplyEffectsToContainer="true"
                     ActivePanelIndex="@((int)_activeTab)"
                     ActivePanelIndexChanged="OnActiveTabChanged">
                <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:BasicInfo"]" Icon="@Icons.Material.Filled.Info">
                    <div class="tab-content">
                        <MudGrid Spacing="3" Class="mt-4">
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle2">@L["ModuleSystem:ModuleDetail:Labels:ModuleKey"]</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @(SelectedModuleDetail.BasicInfo.ModuleKey?.ToString() ?? L["ModuleSystem:ModuleDetail:States:Unknown"])
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Numbers" Color="Color.Info" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle2">@L["ModuleSystem:ModuleDetail:Labels:RegistrationOrder"]</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @SelectedModuleDetail.BasicInfo.Order.ToString()
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle2">@L["ModuleSystem:ModuleDetail:Labels:SerialPhaseDuration"]</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @ModulePerformanceDisplayText.Duration(L, SelectedModuleDetail.BasicInfo.SerialPhaseDurationMs)
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@(SelectedModuleDetail.BasicInfo.IsDisabled ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                                               Color="@(SelectedModuleDetail.BasicInfo.IsDisabled ? Color.Warning : Color.Success)"
                                               Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle2">@L["ModuleSystem:ModuleDetail:Labels:ModuleStatus"]</MudText>
                                    </div>
                                    <MudChip T="string" Color="@(SelectedModuleDetail.BasicInfo.IsDisabled ? Color.Warning : Color.Success)" Size="Size.Small">
                                        @(SelectedModuleDetail.BasicInfo.IsDisabled ? L["ModuleSystem:ModuleDetail:States:Disabled"] : L["ModuleSystem:ModuleDetail:States:Enabled"])
                                    </MudChip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@GetCapabilityIcon(SelectedModuleDetail.ConfigInfo)"
                                                 Color="@GetCapabilityColor(SelectedModuleDetail.ConfigInfo)"
                                                 Size="Size.Small"
                                                 Class="mr-2" />
                                        <MudText Typo="Typo.subtitle2">@L["ModuleSystem:ModuleDetail:Labels:ModuleCapability"]</MudText>
                                    </div>
                                    <MudChip T="string"
                                             Color="@GetCapabilityColor(SelectedModuleDetail.ConfigInfo)"
                                             Variant="Variant.Outlined"
                                             Size="Size.Small"
                                             Icon="@GetCapabilityIcon(SelectedModuleDetail.ConfigInfo)">
                                        @GetCapabilityLabel(SelectedModuleDetail.ConfigInfo)
                                    </MudChip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@GetHostRequirementIcon(SelectedModuleDetail.ConfigInfo)"
                                                 Color="@GetHostRequirementColor(SelectedModuleDetail.ConfigInfo)"
                                                 Size="Size.Small"
                                                 Class="mr-2" />
                                        <MudText Typo="Typo.subtitle2">@L["ModuleSystem:ModuleDetail:Labels:HostRequirement"]</MudText>
                                    </div>
                                    <MudChip T="string"
                                             Color="@GetHostRequirementColor(SelectedModuleDetail.ConfigInfo)"
                                             Variant="@(SelectedModuleDetail.ConfigInfo.RequiresWebHost ? Variant.Filled : Variant.Outlined)"
                                             Size="Size.Small"
                                             Icon="@GetHostRequirementIcon(SelectedModuleDetail.ConfigInfo)">
                                        @GetHostRequirementLabel(SelectedModuleDetail.ConfigInfo)
                                    </MudChip>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                                        @GetHostRequirementDescription(SelectedModuleDetail.ConfigInfo)
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:PerformanceInfo"]" Icon="@Icons.Material.Filled.Speed">
                    <div class="tab-content">
                        <div class="module-performance-detail">
                            <div class="module-performance-detail__summary">
                                <article>
                                    <small>@L["ModuleSystem:ModuleDetail:Labels:SerialPhaseDuration"]</small>
                                    <strong>@ModulePerformanceDisplayText.Duration(L, SelectedModuleDetail.PerformanceInfo.SerialDurationMs)</strong>
                                </article>
                                <article>
                                    <small>@L["ModuleSystem:StartupWork:Labels:WorkItemCount"]</small>
                                    <strong>@SelectedModuleDetail.PerformanceInfo.StartupWorkItems.Count</strong>
                                </article>
                                <article>
                                    <small>@L["ModuleSystem:StartupWork:Labels:AggregateExecutionDuration"]</small>
                                    <strong>@ModulePerformanceDisplayText.Duration(L, GetTotalExecutionDuration(SelectedModuleDetail.PerformanceInfo.StartupWorkItems))</strong>
                                </article>
                                <article>
                                    <small>@L["ModuleSystem:StartupWork:Labels:AggregateQueueDuration"]</small>
                                    <strong>@ModulePerformanceDisplayText.Duration(L, GetTotalQueueDuration(SelectedModuleDetail.PerformanceInfo.StartupWorkItems))</strong>
                                </article>
                            </div>

                            <ModulePerformanceWorkTable
                                WorkItems="@ModulePerformanceDashboardViewFactory.CreateWorkItems(SelectedModuleDetail.PerformanceInfo.StartupWorkItems)"
                                ShowModuleColumn="false" />
                            <ModulePerformanceCallbackTable Executions="SelectedModuleDetail.PerformanceInfo.PhaseExecutions" />
                        </div>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:DependencyInfo"]" Icon="@Icons.Material.Filled.AccountTree">
                    <div class="tab-content">
                        <MudGrid Spacing="3" Class="mt-4">
                            <MudItem xs="12" sm="4">
                                <MudPaper Class="pa-4 dependency-stat-card" Elevation="2">
                                    <div class="text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.DirectionsRun" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                                        <MudText Typo="Typo.h4" Color="Color.Primary">@SelectedModuleDetail.DependencyInfo.DirectDependencies.Count</MudText>
                                        <MudText Typo="Typo.subtitle1">@L["ModuleSystem:ModuleDetail:Labels:DirectDependencies"]</MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudPaper Class="pa-4 dependency-stat-card" Elevation="2">
                                    <div class="text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                                        <MudText Typo="Typo.h4" Color="Color.Info">@SelectedModuleDetail.DependencyInfo.AllDependencies.Count</MudText>
                                        <MudText Typo="Typo.subtitle1">@L["ModuleSystem:ModuleDetail:Labels:TotalDependencies"]</MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudPaper Class="pa-4 dependency-stat-card" Elevation="2">
                                    <div class="text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.CallMade" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                                        <MudText Typo="Typo.h4" Color="Color.Success">@SelectedModuleDetail.DependencyInfo.DependedByModules.Count</MudText>
                                        <MudText Typo="Typo.subtitle1">@L["ModuleSystem:ModuleDetail:Labels:DependedByCount"]</MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>

                            @if (SelectedModuleDetail.DependencyInfo.DirectDependencies.Any())
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.DirectionsRun" Class="mr-2" />
                                        @L["ModuleSystem:ModuleDetail:Labels:DirectDependencyList"]
                                    </MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="module-detail__chip-list">
                                        @foreach (var dep in SelectedModuleDetail.DependencyInfo.DirectDependencies)
                                        {
                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                                <span class="module-detail__identifier">@dep.ToString()</span>
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudItem>
                            }

                            @if (GetTransitiveDependencies().Any())
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-2" />
                                        @L["ModuleSystem:ModuleDetail:Labels:TransitiveDependencyList"]
                                    </MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="module-detail__chip-list">
                                        @foreach (var dep in GetTransitiveDependencies())
                                        {
                                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                                <span class="module-detail__identifier">@dep.ToString()</span>
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudItem>
                            }

                            @if (SelectedModuleDetail.DependencyInfo.DependedByModules.Any())
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.CallMade" Class="mr-2" />
                                        @L["ModuleSystem:ModuleDetail:Labels:DependedByModuleList"]
                                    </MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="module-detail__chip-list">
                                        @foreach (var dep in SelectedModuleDetail.DependencyInfo.DependedByModules)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">
                                                <span class="module-detail__identifier">@dep.ToString()</span>
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudItem>
                            }

                            @if (SelectedModuleDetail.DependencyInfo.IsPartOfCycle)
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                                        <div class="module-detail__message-row">
                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Medium" Class="mr-2" />
                                            <div>
                                                <MudText Typo="Typo.subtitle1">@L["ModuleSystem:ModuleDetail:Messages:CircularDependencyDetected"]</MudText>
                                                <MudText Typo="Typo.body2">
                                                    @L["ModuleSystem:ModuleDetail:Messages:CircularPath"]: @string.Join(" → ", SelectedModuleDetail.DependencyInfo.CyclePath)
                                                </MudText>
                                            </div>
                                        </div>
                                    </MudAlert>
                                </MudItem>
                            }
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:ConfigOptions"]" Icon="@Icons.Material.Filled.Settings">
                    <div class="tab-content">
                        @if (SelectedModuleDetail.ConfigInfo.ConfiguredOptions.Any())
                        {
                            <MudStack Spacing="3">
                                @foreach (var configuredOption in SelectedModuleDetail.ConfigInfo.ConfiguredOptions)
                                {
                                    <ModuleOptionDisplay OptionType="@configuredOption.OptionType"
                                                       OptionInstance="@configuredOption.OptionInstance"
                                                       OptionKindText="@L["ModuleSystem:ModuleDetail:Labels:ModuleOption"]"
                                                       OptionKindColor="Color.Primary" />
                                }
                            </MudStack>
                        }
                        else
                        {
                            <ModuleOptionDisplay />
                        }
                    </div>
                </MudTabPanel>

                @if (SelectedModuleDetail.Errors.Any())
                {
                    <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:ErrorInfo"]" Icon="@Icons.Material.Filled.Error">
                        <div class="tab-content">
                            <MudStack Spacing="3" Class="mt-4">
                                @foreach (var error in SelectedModuleDetail.Errors)
                                {
                                    <MudAlert Severity="Severity.Error">
                                        <div class="module-detail__error-row">
                                            <div>
                                                <MudText Typo="Typo.subtitle2">@error.ErrorType</MudText>
                                                <MudText Typo="Typo.body2">@error.ErrorMessage</MudText>
                                            </div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @error.ErrorTime.ToString("HH:mm:ss")
                                            </MudText>
                                        </div>
                                    </MudAlert>
                                }
                            </MudStack>
                        </div>
                    </MudTabPanel>
                }
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="OnClose" StartIcon="@Icons.Material.Filled.Close">
            @L["ModuleSystem:ModuleDetail:Labels:Close"]
        </MudButton>
    </DialogActions>
</MudDialog>


@code {
    private static readonly DialogOptions DIALOG_OPTIONS = new()
    {
        CloseButton = true,
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Large
    };

    private ModuleDetailTab _activeTab;
    private ModuleKey? _displayedModuleKey;
    private bool _wasVisible;

    /// <summary>
    /// Whether to display the dialog box
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>
    /// Whether to display dialog change events
    /// </summary>
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// Selected module details
    /// </summary>
    [Parameter] public ModuleDetailInfo? SelectedModuleDetail { get; set; }

    /// <summary>
    /// Gets the tab selected when the dialog opens for a module.
    /// </summary>
    [Parameter]
    public ModuleDetailTab InitialTab { get; set; } = ModuleDetailTab.Basic;

    protected override void OnParametersSet()
    {
        var moduleKey = SelectedModuleDetail?.BasicInfo.ModuleKey;
        if (IsVisible && (!_wasVisible || !Equals(moduleKey, _displayedModuleKey)))
        {
            _activeTab = InitialTab;
            _displayedModuleKey = moduleKey;
        }

        _wasVisible = IsVisible;
    }

    /// <summary>
    /// Close dialog
    /// </summary>
    /// <returns></returns>
    private Task OnClose() => SetVisibilityAsync(false);

    private Task OnVisibleChanged(bool isVisible) => SetVisibilityAsync(isVisible);

    private void OnActiveTabChanged(int tabIndex)
    {
        if (Enum.IsDefined(typeof(ModuleDetailTab), tabIndex))
        {
            _activeTab = (ModuleDetailTab)tabIndex;
        }
    }

    private async Task SetVisibilityAsync(bool isVisible)
    {
        if (IsVisible == isVisible)
        {
            return;
        }

        IsVisible = isVisible;
        await IsVisibleChanged.InvokeAsync(isVisible);
    }

    /// <summary>
    /// Get transitive dependency list
    /// </summary>
    /// <returns></returns>
    private IEnumerable<ModuleKey> GetTransitiveDependencies()
    {
        if (SelectedModuleDetail?.DependencyInfo == null) return [];

        var transitive = new HashSet<ModuleKey>(SelectedModuleDetail.DependencyInfo.AllDependencies);
        transitive.ExceptWith(SelectedModuleDetail.DependencyInfo.DirectDependencies);
        return transitive;
    }

    private static double GetTotalExecutionDuration(IEnumerable<ModuleStartupWorkPerformanceInfo> workItems)
        => workItems.Sum(static item => item.ExecutionDurationMs);

    private static double GetTotalQueueDuration(IEnumerable<ModuleStartupWorkPerformanceInfo> workItems)
        => workItems.Sum(static item => item.QueueDurationMs);

    /// <summary>
    /// Gets the localized capability label for the selected module.
    /// </summary>
    private string GetCapabilityLabel(ModuleConfigInfo configInfo)
    {
        return configInfo.IsWebModule
            ? L["ModuleSystem:ModuleDetail:States:WebModule"]
            : L["ModuleSystem:ModuleDetail:States:NonWebModule"];
    }

    /// <summary>
    /// Gets the localized host requirement label for the selected module.
    /// </summary>
    private string GetHostRequirementLabel(ModuleConfigInfo configInfo)
    {
        if (!configInfo.IsWebModule)
        {
            return L["ModuleSystem:ModuleDetail:States:NoWebHostRequirement"];
        }

        return configInfo.RequiresWebHost
            ? L["ModuleSystem:ModuleDetail:States:WebHostRequired"]
            : L["ModuleSystem:ModuleDetail:States:WebHostOptional"];
    }

    /// <summary>
    /// Gets a short host requirement description for the selected module.
    /// </summary>
    private string GetHostRequirementDescription(ModuleConfigInfo configInfo)
    {
        if (!configInfo.IsWebModule)
        {
            return L["ModuleSystem:ModuleDetail:Messages:NoWebHostRequirementDescription"];
        }

        if (!configInfo.RequiresWebHost)
        {
            return L["ModuleSystem:ModuleDetail:Messages:WebHostOptionalDescription"];
        }

        return string.IsNullOrWhiteSpace(configInfo.WebHostRequirementReason)
            ? L["ModuleSystem:ModuleDetail:Messages:WebHostRequiredDescription"]
            : configInfo.WebHostRequirementReason;
    }

    /// <summary>
    /// Gets the capability icon for the selected module.
    /// </summary>
    private static string GetCapabilityIcon(ModuleConfigInfo configInfo) => configInfo.IsWebModule
        ? Icons.Material.Filled.Language
        : Icons.Material.Filled.Memory;

    /// <summary>
    /// Gets the host requirement icon for the selected module.
    /// </summary>
    private static string GetHostRequirementIcon(ModuleConfigInfo configInfo)
    {
        if (!configInfo.IsWebModule)
        {
            return Icons.Material.Filled.Storage;
        }

        return configInfo.RequiresWebHost
            ? Icons.Material.Filled.WebAsset
            : Icons.Material.Filled.CloudDone;
    }

    /// <summary>
    /// Gets the capability chip color for the selected module.
    /// </summary>
    private static Color GetCapabilityColor(ModuleConfigInfo configInfo) => configInfo.IsWebModule ? Color.Info : Color.Default;

    /// <summary>
    /// Gets the host requirement chip color for the selected module.
    /// </summary>
    private static Color GetHostRequirementColor(ModuleConfigInfo configInfo)
    {
        if (!configInfo.IsWebModule)
        {
            return Color.Secondary;
        }

        return configInfo.RequiresWebHost ? Color.Warning : Color.Success;
    }
}
