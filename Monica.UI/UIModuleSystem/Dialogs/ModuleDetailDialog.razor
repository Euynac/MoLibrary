@using MudBlazor
@using Monica.UI.Localization
@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Modularity.Models
@inject IStringLocalizer<SharedResource> L

<MudDialog Visible="IsVisible" VisibleChanged="OnVisibleChanged" Options="DialogOptions">
    <DialogContent>
        @if (SelectedModuleDetail != null)
        {
            <div class="module-detail-header mb-4">
                <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.ViewModule" Class="mr-2" />
                    @SelectedModuleDetail.BasicInfo.ModuleTypeName
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                    @SelectedModuleDetail.BasicInfo.ModuleFullTypeName
                </MudText>
            </div>
            
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:BasicInfo"]" Icon="@Icons.Material.Filled.Info">
                    <div class="tab-content">
                        <MudGrid Spacing="3" Class="mt-4">
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["ModuleSystem:ModuleDetail:Labels:ModuleKey"]</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @(SelectedModuleDetail.BasicInfo.ModuleKey?.ToString() ?? L["ModuleSystem:ModuleDetail:States:Unknown"])
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Numbers" Color="Color.Info" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["ModuleSystem:ModuleDetail:Labels:RegistrationOrder"]</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @SelectedModuleDetail.BasicInfo.Order.ToString()
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["ModuleSystem:ModuleDetail:Labels:InitializationTime"]</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @($"{SelectedModuleDetail.BasicInfo.InitializationTimeMs}ms")
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@(SelectedModuleDetail.BasicInfo.IsDisabled ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                                               Color="@(SelectedModuleDetail.BasicInfo.IsDisabled ? Color.Warning : Color.Success)"
                                               Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["ModuleSystem:ModuleDetail:Labels:ModuleStatus"]</MudText>
                                    </div>
                                    <MudChip T="string" Color="@(SelectedModuleDetail.BasicInfo.IsDisabled ? Color.Warning : Color.Success)" Size="Size.Small">
                                        @(SelectedModuleDetail.BasicInfo.IsDisabled ? L["ModuleSystem:ModuleDetail:States:Disabled"] : L["ModuleSystem:ModuleDetail:States:Enabled"])
                                    </MudChip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@GetCapabilityIcon(SelectedModuleDetail.ConfigInfo)"
                                                 Color="@GetCapabilityColor(SelectedModuleDetail.ConfigInfo)"
                                                 Size="Size.Small"
                                                 Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["ModuleSystem:ModuleDetail:Labels:ModuleCapability"]</MudText>
                                    </div>
                                    <MudChip T="string"
                                             Color="@GetCapabilityColor(SelectedModuleDetail.ConfigInfo)"
                                             Variant="Variant.Outlined"
                                             Size="Size.Small"
                                             Icon="@GetCapabilityIcon(SelectedModuleDetail.ConfigInfo)">
                                        @GetCapabilityLabel(SelectedModuleDetail.ConfigInfo)
                                    </MudChip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@GetRuntimeModeIcon(SelectedModuleDetail.ConfigInfo)"
                                                 Color="@GetRuntimeModeColor(SelectedModuleDetail.ConfigInfo)"
                                                 Size="Size.Small"
                                                 Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["ModuleSystem:ModuleDetail:Labels:RuntimeMode"]</MudText>
                                    </div>
                                    <MudChip T="string"
                                             Color="@GetRuntimeModeColor(SelectedModuleDetail.ConfigInfo)"
                                             Variant="@(SelectedModuleDetail.ConfigInfo.IsDowngradedFromWebModule ? Variant.Filled : Variant.Outlined)"
                                             Size="Size.Small"
                                             Icon="@GetRuntimeModeIcon(SelectedModuleDetail.ConfigInfo)">
                                        @GetRuntimeModeLabel(SelectedModuleDetail.ConfigInfo)
                                    </MudChip>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                                        @GetRuntimeModeDescription(SelectedModuleDetail.ConfigInfo)
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:PerformanceInfo"]" Icon="@Icons.Material.Filled.Speed">
                    <div class="tab-content">
                        <MudGrid Spacing="3" Class="mt-4">
                            <MudItem xs="12">
                                <MudPaper Class="pa-4 detail-card" Elevation="2">
                                    <div class="d-flex align-center mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Primary" Size="Size.Medium" Class="mr-2" />
                                        <MudText Typo="Typo.h6">@L["ModuleSystem:ModuleDetail:Labels:TotalDuration"]</MudText>
                                    </div>
                                    <MudText Typo="Typo.h4" Color="Color.Primary">
                                        @($"{SelectedModuleDetail.PerformanceInfo.TotalDurationMs}ms")
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            @if (SelectedModuleDetail.PerformanceInfo.PhaseDurations.Any())
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="mb-3">@L["ModuleSystem:ModuleDetail:Labels:PhaseDetails"]</MudText>
                                    <MudStack Spacing="2">
                                        @foreach (var phase in SelectedModuleDetail.PerformanceInfo.PhaseDurations)
                                        {
                                            <MudPaper Class="pa-3 phase-card" Elevation="1">
                                                <div class="d-flex justify-space-between align-center">
                                                    <div class="d-flex align-center">
                                                        <MudIcon Icon="@GetPhaseIcon(phase.Key)" Color="Color.Secondary" Size="Size.Small" Class="mr-2" />
                                                        <MudText Typo="Typo.subtitle1">@phase.Key.ToString()</MudText>
                                                    </div>
                                                    <div class="text-right">
                                                        <MudText Typo="Typo.body1" Color="Color.Secondary">@($"{phase.Value}ms")</MudText>
                                                        <MudProgressLinear Color="@GetPhaseColor(phase.Key)" 
                                                                         Value="@GetPhasePercentage(phase.Value)" 
                                                                         Class="mt-1" 
                                                                         Style="width: 100px; height: 4px;" />
                                                    </div>
                                                </div>
                                            </MudPaper>
                                        }
                                    </MudStack>
                                </MudItem>
                            }
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:DependencyInfo"]" Icon="@Icons.Material.Filled.AccountTree">
                    <div class="tab-content">
                        <MudGrid Spacing="3" Class="mt-4">
                            <MudItem xs="12" sm="4">
                                <MudPaper Class="pa-4 dependency-stat-card" Elevation="2">
                                    <div class="text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.DirectionsRun" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                                        <MudText Typo="Typo.h4" Color="Color.Primary">@SelectedModuleDetail.DependencyInfo.DirectDependencies.Count</MudText>
                                        <MudText Typo="Typo.subtitle1">@L["ModuleSystem:ModuleDetail:Labels:DirectDependencies"]</MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudPaper Class="pa-4 dependency-stat-card" Elevation="2">
                                    <div class="text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                                        <MudText Typo="Typo.h4" Color="Color.Info">@SelectedModuleDetail.DependencyInfo.AllDependencies.Count</MudText>
                                        <MudText Typo="Typo.subtitle1">@L["ModuleSystem:ModuleDetail:Labels:TotalDependencies"]</MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudPaper Class="pa-4 dependency-stat-card" Elevation="2">
                                    <div class="text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.CallMade" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                                        <MudText Typo="Typo.h4" Color="Color.Success">@SelectedModuleDetail.DependencyInfo.DependedByModules.Count</MudText>
                                        <MudText Typo="Typo.subtitle1">@L["ModuleSystem:ModuleDetail:Labels:DependedByCount"]</MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>

                            @if (SelectedModuleDetail.DependencyInfo.DirectDependencies.Any())
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.DirectionsRun" Class="mr-2" />
                                        @L["ModuleSystem:ModuleDetail:Labels:DirectDependencyList"]
                                    </MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @foreach (var dep in SelectedModuleDetail.DependencyInfo.DirectDependencies)
                                        {
                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                                @dep.ToString()
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudItem>
                            }

                            @if (GetTransitiveDependencies().Any())
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-2" />
                                        @L["ModuleSystem:ModuleDetail:Labels:TransitiveDependencyList"]
                                    </MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @foreach (var dep in GetTransitiveDependencies())
                                        {
                                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                                @dep.ToString()
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudItem>
                            }

                            @if (SelectedModuleDetail.DependencyInfo.DependedByModules.Any())
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.CallMade" Class="mr-2" />
                                        @L["ModuleSystem:ModuleDetail:Labels:DependedByModuleList"]
                                    </MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @foreach (var dep in SelectedModuleDetail.DependencyInfo.DependedByModules)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">
                                                @dep.ToString()
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudItem>
                            }

                            @if (SelectedModuleDetail.DependencyInfo.IsPartOfCycle)
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Medium" Class="mr-2" />
                                            <div>
                                                <MudText Typo="Typo.subtitle1">@L["ModuleSystem:ModuleDetail:Messages:CircularDependencyDetected"]</MudText>
                                                <MudText Typo="Typo.body2">
                                                    @L["ModuleSystem:ModuleDetail:Messages:CircularPath"]: @string.Join(" → ", SelectedModuleDetail.DependencyInfo.CyclePath)
                                                </MudText>
                                            </div>
                                        </div>
                                    </MudAlert>
                                </MudItem>
                            }
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:ConfigOptions"]" Icon="@Icons.Material.Filled.Settings">
                    <div class="tab-content">
                        @if (SelectedModuleDetail.ConfigInfo.ConfiguredOptions.Any())
                        {
                            <MudStack Spacing="3">
                                @foreach (var configuredOption in SelectedModuleDetail.ConfigInfo.ConfiguredOptions)
                                {
                                    <ModuleOptionDisplay OptionType="@configuredOption.OptionType"
                                                       OptionInstance="@configuredOption.OptionInstance"
                                                       OptionKindText="@(configuredOption.IsExtraOption ? L["ModuleSystem:ModuleDetail:Labels:ExtraOption"] : L["ModuleSystem:ModuleDetail:Labels:ModuleOption"])"
                                                       OptionKindColor="@(configuredOption.IsExtraOption ? Color.Tertiary : Color.Primary)" />
                                }
                            </MudStack>
                        }
                        else
                        {
                            <ModuleOptionDisplay />
                        }
                    </div>
                </MudTabPanel>

                @if (SelectedModuleDetail.Errors.Any())
                {
                    <MudTabPanel Text="@L["ModuleSystem:ModuleDetail:Tabs:ErrorInfo"]" Icon="@Icons.Material.Filled.Error">
                        <div class="tab-content">
                            <MudStack Spacing="3" Class="mt-4">
                                @foreach (var error in SelectedModuleDetail.Errors)
                                {
                                    <MudAlert Severity="Severity.Error">
                                        <div class="d-flex align-center justify-space-between">
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@error.ErrorType</MudText>
                                                <MudText Typo="Typo.body2">@error.ErrorMessage</MudText>
                                            </div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @error.ErrorTime.ToString("HH:mm:ss")
                                            </MudText>
                                        </div>
                                    </MudAlert>
                                }
                            </MudStack>
                        </div>
                    </MudTabPanel>
                }
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="OnClose" StartIcon="@Icons.Material.Filled.Close">
            @L["ModuleSystem:ModuleDetail:Labels:Close"]
        </MudButton>
    </DialogActions>
</MudDialog>


@code {
    /// <summary>
    /// Whether to display the dialog box
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>
    /// Whether to display dialog change events
    /// </summary>
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// Selected module details
    /// </summary>
    [Parameter] public ModuleDetailInfo? SelectedModuleDetail { get; set; }

    /// <summary>
    /// Dialog options
    /// </summary>
    private DialogOptions DialogOptions = new()
    {
        CloseButton = true,
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Large
    };

    /// <summary>
    /// Close dialog
    /// </summary>
    /// <returns></returns>
    private Task OnClose() => SetVisibilityAsync(false);

    private Task OnVisibleChanged(bool isVisible) => SetVisibilityAsync(isVisible);

    private async Task SetVisibilityAsync(bool isVisible)
    {
        if (IsVisible == isVisible)
        {
            return;
        }

        IsVisible = isVisible;
        await IsVisibleChanged.InvokeAsync(isVisible);
    }

    /// <summary>
    /// Get transitive dependency list
    /// </summary>
    /// <returns></returns>
    private IEnumerable<ModuleKey> GetTransitiveDependencies()
    {
        if (SelectedModuleDetail?.DependencyInfo == null) return [];

        var transitive = new HashSet<ModuleKey>(SelectedModuleDetail.DependencyInfo.AllDependencies);
        transitive.ExceptWith(SelectedModuleDetail.DependencyInfo.DirectDependencies);
        return transitive;
    }

    /// <summary>
    /// Get stage icon
    /// </summary>
    /// <param name="phase">Phase</param>
    /// <returns></returns>
    private string GetPhaseIcon(ModulePhase phase) => phase switch
    {
        ModulePhase.ConfigureBuilder => Icons.Material.Filled.AppRegistration,
        ModulePhase.InitFinalConfigures => Icons.Material.Filled.Settings,
		ModulePhase.ConfigureServices => Icons.Material.Filled.FirstPage,
        ModulePhase.PostConfigureServices => Icons.Material.Filled.LastPage,
        ModulePhase.ClaimDependencies => Icons.Material.Filled.AccountTree,

        _ => Icons.Material.Filled.PlayArrow
    };

    /// <summary>
    /// Get stage color
    /// </summary>
    /// <param name="phase">Phase</param>
    /// <returns></returns>
    private Color GetPhaseColor(ModulePhase phase) => phase switch
    {
        ModulePhase.ConfigureBuilder => Color.Primary,
        ModulePhase.InitFinalConfigures => Color.Secondary,
        ModulePhase.ConfigureServices => Color.Info,
        ModulePhase.PostConfigureServices => Color.Success,
        ModulePhase.ClaimDependencies => Color.Warning,
        _ => Color.Default
    };

    /// <summary>
    /// Get stage percentage
    /// </summary>
    /// <param name="duration">Duration</param>
    /// <returns></returns>
    private double GetPhasePercentage(long duration)
    {
        if (SelectedModuleDetail?.PerformanceInfo == null) return 0;
        
        var totalDuration = SelectedModuleDetail.PerformanceInfo.PhaseDurations.Values.Sum();
        return totalDuration > 0 ? (double)duration / totalDuration * 100 : 0;
    }

    /// <summary>
    /// Gets the localized capability label for the selected module.
    /// </summary>
    private string GetCapabilityLabel(ModuleConfigInfo configInfo)
    {
        return configInfo.IsWebModule
            ? L["ModuleSystem:ModuleDetail:States:WebModule"]
            : L["ModuleSystem:ModuleDetail:States:NonWebModule"];
    }

    /// <summary>
    /// Gets the localized runtime mode label for the selected module.
    /// </summary>
    private string GetRuntimeModeLabel(ModuleConfigInfo configInfo)
    {
        if (configInfo.IsDowngradedFromWebModule)
        {
            return L["ModuleSystem:ModuleDetail:States:Downgraded"];
        }

        return configInfo.IsWebModule
            ? L["ModuleSystem:ModuleDetail:States:WebRuntime"]
            : L["ModuleSystem:ModuleDetail:States:NonWebRuntime"];
    }

    /// <summary>
    /// Gets a short runtime description for the selected module.
    /// </summary>
    private string GetRuntimeModeDescription(ModuleConfigInfo configInfo)
    {
        if (configInfo.IsDowngradedFromWebModule)
        {
            return L["ModuleSystem:ModuleDetail:Messages:DowngradedRuntimeDescription"];
        }

        return configInfo.IsWebModule
            ? L["ModuleSystem:ModuleDetail:Messages:WebRuntimeDescription"]
            : L["ModuleSystem:ModuleDetail:Messages:NonWebRuntimeDescription"];
    }

    /// <summary>
    /// Gets the capability icon for the selected module.
    /// </summary>
    private static string GetCapabilityIcon(ModuleConfigInfo configInfo) => configInfo.IsWebModule
        ? Icons.Material.Filled.Language
        : Icons.Material.Filled.Memory;

    /// <summary>
    /// Gets the runtime mode icon for the selected module.
    /// </summary>
    private static string GetRuntimeModeIcon(ModuleConfigInfo configInfo)
    {
        if (configInfo.IsDowngradedFromWebModule)
        {
            return Icons.Material.Filled.ArrowDownward;
        }

        return configInfo.IsWebModule
            ? Icons.Material.Filled.CloudDone
            : Icons.Material.Filled.Storage;
    }

    /// <summary>
    /// Gets the capability chip color for the selected module.
    /// </summary>
    private static Color GetCapabilityColor(ModuleConfigInfo configInfo) => configInfo.IsWebModule ? Color.Info : Color.Default;

    /// <summary>
    /// Gets the runtime mode chip color for the selected module.
    /// </summary>
    private static Color GetRuntimeModeColor(ModuleConfigInfo configInfo)
    {
        if (configInfo.IsDowngradedFromWebModule)
        {
            return Color.Warning;
        }

        return configInfo.IsWebModule ? Color.Success : Color.Secondary;
    }
}
