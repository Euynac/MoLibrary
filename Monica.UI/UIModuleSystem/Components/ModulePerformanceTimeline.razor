@using Monica.Core.Modularity.Models
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<SharedResource> L

<section class="performance-timeline" aria-labelledby="performance-timeline-title">
    <header class="performance-timeline__header">
        <div>
            <MudText id="performance-timeline-title" Typo="Typo.h6">@L["ModuleSystem:PerformanceMonitoring:Labels:MilestoneTimeline"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:MilestoneTimelineDescription"]</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.Route" Color="Color.Primary" />
    </header>

    @if (CriticalPath is not null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Bolt">
            <div class="performance-timeline__critical-path">
                <span>
                    @L[
                        "ModuleSystem:PerformanceMonitoring:Messages:CriticalPath",
                        ModulePerformanceDisplayText.Deadline(L, CriticalPath.Checkpoint),
                        CriticalPath.ReleasingModuleTypeName,
                        CriticalPath.ReleasingWorkName,
                        FormatDuration(CriticalPath.WaitDurationMs)]
                </span>
                @if (CriticalPath.ReleasingModuleKey is { } moduleKey)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Inherit"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               OnClick="() => OpenModuleAsync(moduleKey)">
                        @L["ModuleSystem:PerformanceMonitoring:Actions:InspectModule"]
                    </MudButton>
                }
            </div>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
            @L["ModuleSystem:PerformanceMonitoring:Messages:NoBlockingCriticalPath"]
        </MudAlert>
    }

    @if (Milestones.Count == 0)
    {
        <div class="performance-timeline__empty">
            <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Secondary" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:NoMilestones"]</MudText>
        </div>
    }
    else
    {
        <ol class="performance-timeline__milestones">
            @foreach (var milestone in Milestones.OrderBy(static milestone => milestone.Sequence))
            {
                <li>
                    <span class="performance-timeline__marker" aria-hidden="true">@milestone.Sequence</span>
                    <div class="performance-timeline__milestone-content">
                        <div>
                            <strong>@ModulePerformanceDisplayText.Milestone(L, milestone.Name)</strong>
                            <span>@L["ModuleSystem:PerformanceMonitoring:Formats:Offset", milestone.OffsetMs]</span>
                        </div>
                        @if (milestone.HasPreviousMilestone)
                        {
                            <div class="performance-timeline__interval">
                                <small>@L["ModuleSystem:PerformanceMonitoring:Formats:ElapsedSincePrevious", milestone.ElapsedSincePreviousMs]</small>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(milestone.IsHostOwnedGap ? Color.Warning : Color.Info)"
                                         Variant="Variant.Outlined">
                                    @(milestone.IsHostOwnedGap
                                        ? L["ModuleSystem:PerformanceMonitoring:States:HostOwnedGap"]
                                        : L["ModuleSystem:PerformanceMonitoring:States:MonicaCompositionInterval"])
                                </MudChip>
                            </div>
                        }
                    </div>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ModuleCompositionMilestoneView> Milestones { get; set; } = [];

    [Parameter]
    public ModuleCriticalPathView? CriticalPath { get; set; }

    [Parameter]
    public EventCallback<ModuleKey> ModuleSelected { get; set; }

    private Task OpenModuleAsync(ModuleKey moduleKey) => ModuleSelected.InvokeAsync(moduleKey);

    private string FormatDuration(double durationMs)
        => L["ModuleSystem:PerformanceMonitoring:Formats:Duration", durationMs];
}
