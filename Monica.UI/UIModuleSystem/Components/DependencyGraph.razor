@using MudBlazor
@using Microsoft.JSInterop
@using Monica.UI.Localization
@using Monica.UI.Shared.Components.ContextMenu
@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Modularity.Models
@using Monica.UI.UIModuleSystem.State
@implements IAsyncDisposable
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<div class="dependency-graph-container">
    @if (DependencyGraphData != null)
    {
        <MudGrid Spacing="4" Class="mb-4">
            <DependencyGraphOverview DependencyGraphData="DependencyGraphData"
                                     RelatedNodeId="@_state.RelatedNodeId"
                                     RelatedNode="FindNode(_state.RelatedNodeId)"
                                     OnClearRelatedFilter="ClearRelatedFilterClick" />

            <DependencyGraphFilters SelectedLayout="@_state.SelectedLayout"
                                    SelectedLayoutChanged="OnLayoutChanged"
                                    SearchText="@_state.SearchText"
                                    SearchTextChanged="OnSearchTextChanged"
                                    SelectedEdgeFilter="@_state.SelectedEdgeFilter"
                                    SelectedEdgeFilterChanged="OnEdgeFilterChanged"
                                    SelectedTypeFilters="@_state.SelectedTypeFilters"
                                    SelectedTypeFiltersChanged="OnSelectedTypeFiltersChanged"
                                    SelectAllTypeFilters="SelectAllTypeFilters"
                                    ClearTypeFilters="ClearTypeFilters"
                                    ZoomIn="ZoomIn"
                                    ZoomOut="ZoomOut"
                                    ResetZoom="ResetZoom" />

            <DependencyGraphCanvas OnBackgroundClick="OnBackgroundClick"
                                   OnExportGraph="ExportGraph" />

            <DependencyGraphLegend />
            <DependencyGraphNodeDetails />
        </MudGrid>
    }
    else
    {
        <MudGrid Spacing="4" Class="mb-4">
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" md="@(i == 2 ? 12 : 6)">
                    <MudCard Class="modern-card">
                        <MudCardContent Class="pa-4 d-flex align-center justify-center" Style="@(i == 2 ? "min-height: 600px;" : "min-height: 300px;")">
                            <div class="text-center">
                                <MudProgressCircular Indeterminate="true" Class="mb-3" />
                                <MudText Color="Color.Secondary">@GetLoadingText(i)</MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</div>

<DependencyGraphContextMenu Items="@_state.ContextMenuItems"
                            Visible="@_state.ContextMenuOpen"
                            InitialX="@_state.ContextMenuX"
                            InitialY="@_state.ContextMenuY"
                            ContextItem="@_state.ContextMenuNode"
                            OnItemClick="@OnContextMenuItemClick"
                            OnClose="@CloseContextMenu" />

@code {
    private IJSObjectReference? jsModule;
    private DotNetObjectReference<DependencyGraph>? dotNetRef;
    private ModuleDependencyGraph? renderedGraphData;
    private readonly DependencyGraphState _state = new();

    /// <summary>
    /// Dependency graph data
    /// </summary>
    [Parameter] public ModuleDependencyGraph? DependencyGraphData { get; set; }

    /// <summary>
    /// Invoked when the user requests the module detail dialog for a node.
    /// </summary>
    [Parameter] public EventCallback<ModuleKey> OnModuleDetailClicked { get; set; }

    /// <summary>
    /// JavaScript runtime
    /// </summary>
    [Inject] public IJSRuntime JSRuntime { get; set; } = default!;

    /// <summary>
    /// After component initialization
    /// </summary>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (DependencyGraphData == null)
        {
            return;
        }

        if (jsModule == null)
        {
            jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/_content/Monica.UI/js/module-dependency-graph.js");
        }

        dotNetRef ??= DotNetObjectReference.Create(this);

        if (!ReferenceEquals(renderedGraphData, DependencyGraphData))
        {
            await InitializeGraph();
            renderedGraphData = DependencyGraphData;
        }
    }

    /// <summary>
    /// Initialize chart
    /// </summary>
    /// <returns></returns>
    private async Task InitializeGraph()
    {
        if (jsModule == null || DependencyGraphData == null) return;

        string Text(string key) => L[key].Value;

        var nodes = DependencyGraphData.Nodes.Select(n => new
        {
            id = n.Module.ToString(),
            label = n.ModuleName,
            isPartOfCycle = n.IsPartOfCycle,
            isDisabled = !n.IsEnabled,
            isUIModule = n.IsUIModule,
            isThirdPartyModule = n.IsThirdPartyModule,
            categoryKey = GetModuleCategoryKey(n),
            moduleCategory = GetModuleCategoryLabel(n),
            directDependencyCount = n.DirectDependencyCount,
            transitiveDependencyCount = Math.Max(0, n.TotalDependencyCount - n.DirectDependencyCount),
            dependentModuleCount = n.DependentModuleCount,
            statusText = n.IsEnabled
                ? Text("ModuleSystem:DependencyGraph:States:Enabled")
                : Text("ModuleSystem:DependencyGraph:States:Disabled")
        }).ToArray();

        var edges = DependencyGraphData.Edges.Select(e => new
        {
            source = e.SourceModule.ToString(),
            target = e.TargetModule.ToString(),
            dependencyType = e.DependencyType.ToString(),
            isPartOfCycle = e.IsPartOfCycle
        }).ToArray();

        var texts = new
        {
            labels = new
            {
                directDependencies = Text("ModuleSystem:DependencyGraph:Labels:DirectDependency"),
                transitiveDependencies = Text("ModuleSystem:DependencyGraph:Labels:TransitiveDependency"),
                dependedBy = Text("ModuleSystem:DependencyGraph:Labels:DependedBy"),
                circularDependency = Text("ModuleSystem:DependencyGraph:Labels:CircularDependency"),
                moduleStatus = Text("ModuleSystem:DependencyGraph:Labels:ModuleStatus"),
                moduleCategory = Text("ModuleSystem:DependencyGraph:Labels:ModuleCategory")
            },
            states = new
            {
                yes = Text("ModuleSystem:DependencyGraph:States:Yes"),
                no = Text("ModuleSystem:DependencyGraph:States:No")
            },
            messages = new
            {
                hoverToViewDetails = Text("ModuleSystem:DependencyGraph:Messages:HoverToViewDetails")
            }
        };

        await jsModule.InvokeVoidAsync("initializeDependencyGraph", "dependency-graph-container", nodes, edges, texts, dotNetRef);
        await jsModule.InvokeVoidAsync("changeLayout", _state.SelectedLayout);
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// layout change event
    /// </summary>
    /// <param name="layout">Layout type</param>
    /// <returns></returns>
    private async Task OnLayoutChanged(string layout)
    {
        _state.SetLayout(layout);
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("changeLayout", layout);
            await jsModule.InvokeVoidAsync("resetZoom");
        }
    }

    /// <summary>
    /// filter change event
    /// </summary>
    /// <param name="filter">Filter type</param>
    /// <returns></returns>
    private async Task OnEdgeFilterChanged(string filter)
    {
        _state.SetEdgeFilter(filter);
        await ApplyCurrentGraphFilters();
    }

    private async Task OnSelectedTypeFiltersChanged(IReadOnlyCollection<string>? filters)
    {
        _state.SetTypeFilters(filters);
        await ApplyCurrentGraphFilters();
    }

    private Task SelectAllTypeFilters()
    {
        _state.SelectAllTypeFilters();
        return ApplyCurrentGraphFilters();
    }

    private Task ClearTypeFilters()
    {
        _state.ClearTypeFilters();
        return ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Search text change event.
    /// </summary>
    private async Task OnSearchTextChanged(string value)
    {
        _state.SetSearchText(value);
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Enlarge chart
    /// </summary>
    /// <returns></returns>
    private async Task ZoomIn()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("zoomIn");
        }
    }

    /// <summary>
    /// Zoom out chart
    /// </summary>
    /// <returns></returns>
    private async Task ZoomOut()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("zoomOut");
        }
    }

    /// <summary>
    /// reset view
    /// </summary>
    /// <returns></returns>
    private async Task ResetZoom()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("resetZoom");
        }
    }

    /// <summary>
    /// Export pictures
    /// </summary>
    /// <returns></returns>
    private async Task ExportGraph()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("exportGraph", "dependency-graph.png");
        }
    }

    /// <summary>
    /// Applies the current graph filters to the JS graph instance.
    /// </summary>
    private async Task ApplyCurrentGraphFilters()
    {
        if (jsModule == null)
        {
            return;
        }

        await jsModule.InvokeVoidAsync("applyFilter", _state.CreateFilterPayload());
    }

    /// <summary>
    /// Get loading text
    /// </summary>
    /// <param name="index">Index</param>
    /// <returns>Load text</returns>
    private string GetLoadingText(int index) => index switch
    {
        0 => L["ModuleSystem:DependencyGraph:Loading:DependencyOverview"],
        1 => L["ModuleSystem:DependencyGraph:Loading:GraphControls"],
        2 => L["ModuleSystem:DependencyGraph:Loading:DependencyGraph"],
        3 => L["ModuleSystem:DependencyGraph:Loading:Legend"],
        4 => L["ModuleSystem:DependencyGraph:Loading:NodeDetails"],
        _ => L["ModuleSystem:DependencyGraph:Loading:Default"]
    };

    /// <summary>
    /// Gets the localized module category label used by the graph.
    /// </summary>
    /// <param name="node">The dependency graph node.</param>
    /// <returns>The localized category label.</returns>
    private string GetModuleCategoryLabel(ModuleDependencyNode node)
    {
        if (node.IsThirdPartyModule)
        {
            return L["ModuleSystem:DependencyGraph:Labels:ThirdPartyModule"].Value;
        }

        if (node.IsUIModule)
        {
            return L["ModuleSystem:DependencyGraph:Labels:UIModule"].Value;
        }

        return L["ModuleSystem:DependencyGraph:Labels:BuiltInModule"].Value;
    }

    /// <summary>
    /// Gets the category key used for JS-side filtering.
    /// </summary>
    private static string GetModuleCategoryKey(ModuleDependencyNode node)
    {
        if (node.IsThirdPartyModule)
        {
            return "third-party";
        }

        if (node.IsUIModule)
        {
            return "ui";
        }

        return "built-in";
    }

    /// <summary>
    /// Handles node click events coming from the graph.
    /// </summary>
    [JSInvokable]
    public async Task OnNodeClick(string nodeId)
    {
        var node = FindNode(nodeId);
        if (node is null || !OnModuleDetailClicked.HasDelegate)
        {
            return;
        }

        await OnModuleDetailClicked.InvokeAsync(node.Module);
    }

    /// <summary>
    /// Handles node right-click events coming from the graph.
    /// </summary>
    [JSInvokable]
    public void OnNodeRightClick(string nodeId, double x, double y)
    {
        var node = FindNode(nodeId);
        if (node is null)
        {
            return;
        }

        _state.OpenContextMenu(node, x, y, BuildContextMenuItems(node));
        StateHasChanged();
    }

    /// <summary>
    /// Handles background clicks from the SVG graph.
    /// </summary>
    [JSInvokable]
    public void OnSvgBackgroundClick()
    {
        if (!_state.ContextMenuOpen)
        {
            return;
        }

        _state.CloseContextMenu();
        StateHasChanged();
    }

    /// <summary>
    /// Handles background clicks from the host container.
    /// </summary>
    private void OnBackgroundClick()
    {
        if (!_state.ContextMenuOpen)
        {
            return;
        }

        _state.CloseContextMenu();
        StateHasChanged();
    }

    /// <summary>
    /// Closes the context menu.
    /// </summary>
    private void CloseContextMenu()
    {
        _state.CloseContextMenu();
    }

    /// <summary>
    /// Closes the related-node filter alert.
    /// </summary>
    private Task ClearRelatedFilterClick()
    {
        _state.SetRelatedNode(null);
        return ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Handles root context-menu item clicks.
    /// </summary>
    private Task OnContextMenuItemClick(ContextMenuItem<ModuleDependencyNode> item)
    {
        _state.CloseContextMenu();
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Builds the context menu for a graph node.
    /// </summary>
    private List<ContextMenuItem<ModuleDependencyNode>> BuildContextMenuItems(ModuleDependencyNode node)
    {
        var builder = ContextMenuBuilder<ModuleDependencyNode>.Create()
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:Details"].Value, Icons.Material.Filled.Info, ShowContextDetailsAsync)
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:FocusNode"].Value, Icons.Material.Filled.CenterFocusStrong, FocusOnNodeAsync)
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:FilterByType"].Value, Icons.Material.Filled.FilterAlt, FilterByTypeAsync);

        if (!string.IsNullOrEmpty(_state.RelatedNodeId))
        {
            if (_state.RelatedNodeId == node.Module.ToString())
            {
                builder.AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:ClearRelatedFilter"].Value, Icons.Material.Filled.Clear, ClearRelatedFilterAsync);
            }
            else
            {
                builder.AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:ShowOtherRelatedNodes"].Value, Icons.Material.Filled.AccountTree, ShowRelatedNodesAsync);
            }
        }
        else
        {
            builder.AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:ShowRelatedNodes"].Value, Icons.Material.Filled.AccountTree, ShowRelatedNodesAsync);
        }

        builder
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:ClearAllFilters"].Value, Icons.Material.Filled.ClearAll, ClearAllFiltersAsync)
            .AddDivider()
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:CopyModuleName"].Value, Icons.Material.Filled.ContentCopy, CopyModuleNameAsync);

        return builder.Build();
    }

    /// <summary>
    /// Opens the detail dialog for the context-menu node.
    /// </summary>
    private async Task ShowContextDetailsAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? _state.ContextMenuNode;
        if (targetNode is null || !OnModuleDetailClicked.HasDelegate)
        {
            return;
        }

        await OnModuleDetailClicked.InvokeAsync(targetNode.Module);
    }

    /// <summary>
    /// Focuses the requested node in the graph.
    /// </summary>
    private async Task FocusOnNodeAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? _state.ContextMenuNode;
        if (targetNode is null || jsModule == null)
        {
            return;
        }

        await jsModule.InvokeVoidAsync("focusOnNode", targetNode.Module.ToString());
    }

    /// <summary>
    /// Filters the graph to the selected node category.
    /// </summary>
    private async Task FilterByTypeAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? _state.ContextMenuNode;
        if (targetNode is null)
        {
            return;
        }

        _state.SetTypeFilters([GetModuleCategoryKey(targetNode)]);
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Clears all active graph filters.
    /// </summary>
    private async Task ClearAllFiltersAsync(ModuleDependencyNode? node)
    {
        _state.ClearAllFilters();
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Shows all nodes connected to the selected node.
    /// </summary>
    private async Task ShowRelatedNodesAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? _state.ContextMenuNode;
        if (targetNode is null)
        {
            return;
        }

        _state.SetRelatedNode(targetNode.Module.ToString());
        await ApplyCurrentGraphFilters();

        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("focusOnNode", targetNode.Module.ToString());
        }

        Snackbar.Add(L["ModuleSystem:DependencyGraph:Messages:ShowingRelatedNodes", targetNode.ModuleName], Severity.Info);
    }

    /// <summary>
    /// Clears the related-node filter.
    /// </summary>
    private Task ClearRelatedFilterAsync(ModuleDependencyNode? node)
    {
        _state.SetRelatedNode(null);
        return ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Copies the module name to the clipboard.
    /// </summary>
    private async Task CopyModuleNameAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? _state.ContextMenuNode;
        if (targetNode is null)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", targetNode.Module.ToString());
        Snackbar.Add(L["ModuleSystem:DependencyGraph:Messages:CopiedToClipboard"], Severity.Success);
    }

    /// <summary>
    /// Finds a graph node by its module key string.
    /// </summary>
    private ModuleDependencyNode? FindNode(string? nodeId)
    {
        if (DependencyGraphData == null || string.IsNullOrWhiteSpace(nodeId))
        {
            return null;
        }

        return DependencyGraphData.Nodes.FirstOrDefault(node => node.Module.ToString() == nodeId);
    }

    /// <summary>
    /// Resource release
    /// </summary>
    /// <returns></returns>
    public async ValueTask DisposeAsync()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("disposeGraph");
            await jsModule.DisposeAsync();
        }

        dotNetRef?.Dispose();
    }
}
