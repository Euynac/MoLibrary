@using MudBlazor
@using Microsoft.JSInterop
@using Monica.UI.Localization
@using Monica.UI.Components.ContextMenu
@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Dashboard.Models
@using Monica.Core.Modularity.Models
@implements IAsyncDisposable
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<div class="dependency-graph-container">
    @if (DependencyGraphData != null)
    {
        @if (!string.IsNullOrEmpty(relatedNodeId))
        {
            var relatedNode = FindNode(relatedNodeId);
            <MudAlert Severity="Severity.Info" Class="mb-3" CloseIconClicked="ClearRelatedFilterClick">
                @L["ModuleSystem:DependencyGraph:Messages:ShowingRelatedNodes", relatedNode?.ModuleName ?? relatedNodeId]
            </MudAlert>
        }

        <MudGrid Spacing="4" Class="mb-4">
            <!-- 依赖关系概览 -->
            <MudItem xs="12" md="4">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:DependencyGraph:Labels:DependencyOverview"]</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="3">
                            <MudPaper Class="pa-4 overview-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Primary">@L["ModuleSystem:DependencyGraph:Labels:TotalNodes"]</MudText>
                                        <MudText Typo="Typo.h5" Color="Color.Primary">@DependencyGraphData.Nodes.Count.ToString()</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" Size="Size.Large" />
                                </div>
                            </MudPaper>
                            <MudPaper Class="pa-4 overview-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Info">@L["ModuleSystem:DependencyGraph:Labels:TotalDependencies"]</MudText>
                                        <MudText Typo="Typo.h5" Color="Color.Info">@DependencyGraphData.Edges.Count.ToString()</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.Link" Color="Color.Info" Size="Size.Large" />
                                </div>
                            </MudPaper>
                            <MudPaper Class="pa-4 overview-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="@(DependencyGraphData.HasCircularDependencies ? Color.Warning : Color.Success)">@L["ModuleSystem:DependencyGraph:Labels:CircularDependencies"]</MudText>
                                        <MudText Typo="Typo.h5" Color="@(DependencyGraphData.HasCircularDependencies ? Color.Warning : Color.Success)">@(DependencyGraphData.HasCircularDependencies ? L["ModuleSystem:DependencyGraph:States:Exists"] : L["ModuleSystem:DependencyGraph:States:None"])</MudText>
                                    </div>
                                    @if (DependencyGraphData.HasCircularDependencies)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Large" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                                    }
                                </div>
                            </MudPaper>
                            <MudPaper Class="pa-4 overview-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@L["ModuleSystem:DependencyGraph:Labels:DependencyLayers"]</MudText>
                                        <MudText Typo="Typo.h5" Color="Color.Secondary">@DependencyGraphData.ModuleLayers.Count.ToString()</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.Layers" Color="Color.Secondary" Size="Size.Large" />
                                </div>
                            </MudPaper>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- 图表控制 -->
            <MudItem xs="12" md="8">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:DependencyGraph:Labels:GraphControls"]</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-4">
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="selectedLayout" Label="@L["ModuleSystem:DependencyGraph:Labels:LayoutAlgorithm"]"
                                         ValueChanged="OnLayoutChanged" Variant="Variant.Outlined"
                                         AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="@("force")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.ScatterPlot" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Layouts:Force"]
                                        </div>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@("hierarchical")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Layouts:Hierarchical"]
                                        </div>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@("circular")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Circle" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Layouts:Circular"]
                                        </div>
                                    </MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="selectedEdgeFilter" Label="@L["ModuleSystem:DependencyGraph:Labels:Filter"]"
                                         ValueChanged="OnEdgeFilterChanged" Variant="Variant.Outlined"
                                         AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="@("all")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Filters:ShowAll"]
                                        </div>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@("direct")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.DirectionsRun" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Filters:DirectOnly"]
                                        </div>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@("cycle")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Filters:CycleOnly"]
                                        </div>
                                    </MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="selectedTypeFilter" Label="@L["ModuleSystem:DependencyGraph:Labels:TypeFilter"]"
                                         ValueChanged="OnTypeFilterChanged" Variant="Variant.Outlined"
                                         AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="@("all")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Types:All"]
                                        </div>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@("built-in")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.SettingsInputComponent" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Types:BuiltIn"]
                                        </div>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@("ui")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Web" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Types:UI"]
                                        </div>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@("third-party")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Extension" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Types:ThirdParty"]
                                        </div>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@("disabled")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Block" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Types:Disabled"]
                                        </div>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@("cycle")">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.SyncProblem" Class="mr-2" />
                                            @L["ModuleSystem:DependencyGraph:Types:Circular"]
                                        </div>
                                    </MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Value="searchText"
                                              ValueChanged="OnSearchTextChanged"
                                              Label="@L["ModuleSystem:DependencyGraph:Labels:Search"]"
                                              Placeholder="@L["ModuleSystem:DependencyGraph:Labels:SearchPlaceholder"]"
                                              Variant="Variant.Outlined"
                                              Immediate="true"
                                              Clearable="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search" />
                            </MudItem>
                        </MudGrid>
                        <MudDivider Class="my-4" />
                        <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                     Size="Size.Small"
                                     StartIcon="@Icons.Material.Filled.ZoomIn"
                                     OnClick="ZoomIn">
                                @L["ModuleSystem:DependencyGraph:Labels:ZoomIn"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                     Size="Size.Small"
                                     StartIcon="@Icons.Material.Filled.ZoomOut"
                                     OnClick="ZoomOut">
                                @L["ModuleSystem:DependencyGraph:Labels:ZoomOut"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                     Size="Size.Small"
                                     StartIcon="@Icons.Material.Filled.CenterFocusStrong"
                                     OnClick="ResetZoom">
                                @L["ModuleSystem:DependencyGraph:Labels:ResetView"]
                            </MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- 依赖关系图 -->
            <MudItem xs="12">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Color="Color.Primary" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:DependencyGraph:Labels:DependencyGraph"]</MudText>
                            </div>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Variant="Variant.Filled"
                                     Color="Color.Primary"
                                     Size="Size.Small"
                                     StartIcon="@Icons.Material.Filled.Download"
                                     OnClick="ExportGraph">
                                @L["ModuleSystem:DependencyGraph:Labels:ExportImage"]
                            </MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <div class="dependency-graph-host"
                             @onclick="OnBackgroundClick"
                             @oncontextmenu:preventDefault="true">
                            <MudPaper id="dependency-graph-container"
                                      Class="dependency-graph-canvas"
                                      Style="height: 600px; width: 100%;"
                                      Elevation="2">
                                <!-- 图表将在这里渲染 -->
                            </MudPaper>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- 图例 -->
            <MudItem xs="12" md="6">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Info" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:DependencyGraph:Labels:Legend"]</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="4">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3">@L["ModuleSystem:DependencyGraph:Labels:NodeTypes"]</MudText>
                                <MudStack Spacing="2">
                                    <div class="legend-item">
                                        <div class="legend-circle legend-circle-built-in"></div>
                                        <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:BuiltInModule"]</MudText>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-circle legend-circle-ui"></div>
                                        <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:UIModule"]</MudText>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-circle legend-circle-third-party"></div>
                                        <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:ThirdPartyModule"]</MudText>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-circle legend-circle-disabled"></div>
                                        <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:DisabledModule"]</MudText>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-circle legend-circle-cycle"></div>
                                        <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:CircularDependencyModule"]</MudText>
                                    </div>
                                </MudStack>
                            </div>
                            <MudDivider />
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-3">@L["ModuleSystem:DependencyGraph:Labels:EdgeTypes"]</MudText>
                                <MudStack Spacing="2">
                                    <div class="d-flex align-center">
                                        <div class="legend-line" style="background-color: #81C784; width: 30px; height: 3px; margin-right: 12px;"></div>
                                        <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:DirectDependency"]</MudText>
                                    </div>
                                    <div class="d-flex align-center">
                                        <div class="legend-line" style="background-color: #BA68C8; width: 30px; height: 3px; margin-right: 12px; border-top: 2px dashed #BA68C8; background: none;"></div>
                                        <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:TransitiveDependency"]</MudText>
                                    </div>
                                    <div class="d-flex align-center">
                                        <div class="legend-line" style="background-color: #FF8A65; width: 30px; height: 3px; margin-right: 12px;"></div>
                                        <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:CircularDependency"]</MudText>
                                    </div>
                                </MudStack>
                            </div>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- 节点详情 -->
            <MudItem xs="12" md="6">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Secondary" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:DependencyGraph:Labels:NodeDetails"]</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-4">
                        <div class="node-detail-content" style="min-height: 200px;">
                            <div class="d-flex align-center justify-center" style="height: 100%; color: var(--mud-palette-text-secondary);">
                                <div class="text-center">
                                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @L["ModuleSystem:DependencyGraph:Messages:HoverToViewDetails"]
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudGrid Spacing="4" Class="mb-4">
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" md="@(i == 2 ? 12 : 6)">
                    <MudCard Class="modern-card">
                        <MudCardContent Class="pa-4 d-flex align-center justify-center" Style="@(i == 2 ? "min-height: 600px;" : "min-height: 300px;")">
                            <div class="text-center">
                                <MudProgressCircular Indeterminate="true" Class="mb-3" />
                                <MudText Color="Color.Secondary">@GetLoadingText(i)</MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</div>

<MoContextMenu TItem="ModuleDependencyNode"
               Items="@contextMenuItems"
               Visible="@contextMenuOpen"
               InitialX="@contextMenuX"
               InitialY="@contextMenuY"
               ContextItem="@contextMenuNode"
               OnItemClick="@OnContextMenuItemClick"
               OnClose="@CloseContextMenu" />

@code {
    private IJSObjectReference? jsModule;
    private DotNetObjectReference<DependencyGraph>? dotNetRef;
    private ModuleDependencyGraph? renderedGraphData;
    private string selectedLayout = "force";
    private string selectedEdgeFilter = "all";
    private string selectedTypeFilter = "all";
    private string searchText = string.Empty;
    private string? relatedNodeId;
    private bool contextMenuOpen;
    private double contextMenuX;
    private double contextMenuY;
    private ModuleDependencyNode? contextMenuNode;
    private List<ContextMenuItem<ModuleDependencyNode>> contextMenuItems = [];

    /// <summary>
    /// 依赖关系图数据
    /// </summary>
    [Parameter] public ModuleDependencyGraph? DependencyGraphData { get; set; }

    /// <summary>
    /// Invoked when the user requests the module detail dialog for a node.
    /// </summary>
    [Parameter] public EventCallback<ModuleKey> OnModuleDetailClicked { get; set; }

    /// <summary>
    /// JavaScript运行时
    /// </summary>
    [Inject] public IJSRuntime JSRuntime { get; set; } = default!;

    /// <summary>
    /// 组件初始化后
    /// </summary>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (DependencyGraphData == null)
        {
            return;
        }

        if (jsModule == null)
        {
            jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/_content/Monica.UI/js/module-dependency-graph.js");
        }

        dotNetRef ??= DotNetObjectReference.Create(this);

        if (!ReferenceEquals(renderedGraphData, DependencyGraphData))
        {
            await InitializeGraph();
            renderedGraphData = DependencyGraphData;
        }
    }

    /// <summary>
    /// 初始化图表
    /// </summary>
    /// <returns></returns>
    private async Task InitializeGraph()
    {
        if (jsModule == null || DependencyGraphData == null) return;

        string Text(string key) => L[key].Value;

        var nodes = DependencyGraphData.Nodes.Select(n => new
        {
            id = n.Module.ToString(),
            label = n.ModuleName,
            isPartOfCycle = n.IsPartOfCycle,
            isDisabled = !n.IsEnabled,
            isUIModule = n.IsUIModule,
            isThirdPartyModule = n.IsThirdPartyModule,
            categoryKey = GetModuleCategoryKey(n),
            moduleCategory = GetModuleCategoryLabel(n),
            directDependencyCount = n.DirectDependencyCount,
            transitiveDependencyCount = Math.Max(0, n.TotalDependencyCount - n.DirectDependencyCount),
            dependentModuleCount = n.DependentModuleCount,
            statusText = n.IsEnabled
                ? Text("ModuleSystem:DependencyGraph:States:Enabled")
                : Text("ModuleSystem:DependencyGraph:States:Disabled")
        }).ToArray();

        var edges = DependencyGraphData.Edges.Select(e => new
        {
            source = e.SourceModule.ToString(),
            target = e.TargetModule.ToString(),
            dependencyType = e.DependencyType.ToString(),
            isPartOfCycle = e.IsPartOfCycle
        }).ToArray();

        var texts = new
        {
            labels = new
            {
                directDependencies = Text("ModuleSystem:DependencyGraph:Labels:DirectDependency"),
                transitiveDependencies = Text("ModuleSystem:DependencyGraph:Labels:TransitiveDependency"),
                dependedBy = Text("ModuleSystem:DependencyGraph:Labels:DependedBy"),
                circularDependency = Text("ModuleSystem:DependencyGraph:Labels:CircularDependency"),
                moduleStatus = Text("ModuleSystem:DependencyGraph:Labels:ModuleStatus"),
                moduleCategory = Text("ModuleSystem:DependencyGraph:Labels:ModuleCategory")
            },
            states = new
            {
                yes = Text("ModuleSystem:DependencyGraph:States:Yes"),
                no = Text("ModuleSystem:DependencyGraph:States:No")
            },
            messages = new
            {
                hoverToViewDetails = Text("ModuleSystem:DependencyGraph:Messages:HoverToViewDetails")
            }
        };

        await jsModule.InvokeVoidAsync("initializeDependencyGraph", "dependency-graph-container", nodes, edges, texts, dotNetRef);
        await jsModule.InvokeVoidAsync("changeLayout", selectedLayout);
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// 布局改变事件
    /// </summary>
    /// <param name="layout">布局类型</param>
    /// <returns></returns>
    private async Task OnLayoutChanged(string layout)
    {
        selectedLayout = layout;
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("changeLayout", layout);
            await jsModule.InvokeVoidAsync("resetZoom");
        }
    }

    /// <summary>
    /// 过滤器改变事件
    /// </summary>
    /// <param name="filter">过滤器类型</param>
    /// <returns></returns>
    private async Task OnEdgeFilterChanged(string filter)
    {
        selectedEdgeFilter = filter;
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Type filter change event.
    /// </summary>
    private async Task OnTypeFilterChanged(string filter)
    {
        selectedTypeFilter = filter;
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Search text change event.
    /// </summary>
    private async Task OnSearchTextChanged(string value)
    {
        searchText = value;
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// 放大图表
    /// </summary>
    /// <returns></returns>
    private async Task ZoomIn()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("zoomIn");
        }
    }

    /// <summary>
    /// 缩小图表
    /// </summary>
    /// <returns></returns>
    private async Task ZoomOut()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("zoomOut");
        }
    }

    /// <summary>
    /// 重置视图
    /// </summary>
    /// <returns></returns>
    private async Task ResetZoom()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("resetZoom");
        }
    }

    /// <summary>
    /// 导出图片
    /// </summary>
    /// <returns></returns>
    private async Task ExportGraph()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("exportGraph", "dependency-graph.png");
        }
    }

    /// <summary>
    /// Applies the current graph filters to the JS graph instance.
    /// </summary>
    private async Task ApplyCurrentGraphFilters()
    {
        if (jsModule == null)
        {
            return;
        }

        await jsModule.InvokeVoidAsync("applyFilter", new
        {
            edgeFilter = selectedEdgeFilter,
            typeFilter = selectedTypeFilter,
            searchText,
            relatedNodeId
        });
    }

    /// <summary>
    /// 获取加载文本
    /// </summary>
    /// <param name="index">索引</param>
    /// <returns>加载文本</returns>
    private string GetLoadingText(int index) => index switch
    {
        0 => L["ModuleSystem:DependencyGraph:Loading:DependencyOverview"],
        1 => L["ModuleSystem:DependencyGraph:Loading:GraphControls"],
        2 => L["ModuleSystem:DependencyGraph:Loading:DependencyGraph"],
        3 => L["ModuleSystem:DependencyGraph:Loading:Legend"],
        4 => L["ModuleSystem:DependencyGraph:Loading:NodeDetails"],
        _ => L["ModuleSystem:DependencyGraph:Loading:Default"]
    };

    /// <summary>
    /// Gets the localized module category label used by the graph.
    /// </summary>
    /// <param name="node">The dependency graph node.</param>
    /// <returns>The localized category label.</returns>
    private string GetModuleCategoryLabel(ModuleDependencyNode node)
    {
        if (node.IsThirdPartyModule)
        {
            return L["ModuleSystem:DependencyGraph:Labels:ThirdPartyModule"].Value;
        }

        if (node.IsUIModule)
        {
            return L["ModuleSystem:DependencyGraph:Labels:UIModule"].Value;
        }

        return L["ModuleSystem:DependencyGraph:Labels:BuiltInModule"].Value;
    }

    /// <summary>
    /// Gets the category key used for JS-side filtering.
    /// </summary>
    private static string GetModuleCategoryKey(ModuleDependencyNode node)
    {
        if (node.IsThirdPartyModule)
        {
            return "third-party";
        }

        if (node.IsUIModule)
        {
            return "ui";
        }

        return "built-in";
    }

    /// <summary>
    /// Handles node click events coming from the graph.
    /// </summary>
    [JSInvokable]
    public async Task OnNodeClick(string nodeId)
    {
        var node = FindNode(nodeId);
        if (node is null || !OnModuleDetailClicked.HasDelegate)
        {
            return;
        }

        await OnModuleDetailClicked.InvokeAsync(node.Module);
    }

    /// <summary>
    /// Handles node right-click events coming from the graph.
    /// </summary>
    [JSInvokable]
    public void OnNodeRightClick(string nodeId, double x, double y)
    {
        var node = FindNode(nodeId);
        if (node is null)
        {
            return;
        }

        contextMenuNode = node;
        contextMenuX = x;
        contextMenuY = y;
        contextMenuItems = BuildContextMenuItems(node);
        contextMenuOpen = true;
        StateHasChanged();
    }

    /// <summary>
    /// Handles background clicks from the SVG graph.
    /// </summary>
    [JSInvokable]
    public void OnSvgBackgroundClick()
    {
        if (!contextMenuOpen)
        {
            return;
        }

        contextMenuOpen = false;
        StateHasChanged();
    }

    /// <summary>
    /// Handles background clicks from the host container.
    /// </summary>
    private void OnBackgroundClick()
    {
        if (!contextMenuOpen)
        {
            return;
        }

        contextMenuOpen = false;
        StateHasChanged();
    }

    /// <summary>
    /// Closes the context menu.
    /// </summary>
    private void CloseContextMenu()
    {
        contextMenuOpen = false;
    }

    /// <summary>
    /// Closes the related-node filter alert.
    /// </summary>
    private Task ClearRelatedFilterClick()
    {
        relatedNodeId = null;
        return ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Handles root context-menu item clicks.
    /// </summary>
    private Task OnContextMenuItemClick(ContextMenuItem<ModuleDependencyNode> item)
    {
        contextMenuOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Builds the context menu for a graph node.
    /// </summary>
    private List<ContextMenuItem<ModuleDependencyNode>> BuildContextMenuItems(ModuleDependencyNode node)
    {
        var builder = ContextMenuBuilder<ModuleDependencyNode>.Create()
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:Details"].Value, Icons.Material.Filled.Info, ShowContextDetailsAsync)
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:FocusNode"].Value, Icons.Material.Filled.CenterFocusStrong, FocusOnNodeAsync)
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:FilterByType"].Value, Icons.Material.Filled.FilterAlt, FilterByTypeAsync);

        if (!string.IsNullOrEmpty(relatedNodeId))
        {
            if (relatedNodeId == node.Module.ToString())
            {
                builder.AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:ClearRelatedFilter"].Value, Icons.Material.Filled.Clear, ClearRelatedFilterAsync);
            }
            else
            {
                builder.AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:ShowOtherRelatedNodes"].Value, Icons.Material.Filled.AccountTree, ShowRelatedNodesAsync);
            }
        }
        else
        {
            builder.AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:ShowRelatedNodes"].Value, Icons.Material.Filled.AccountTree, ShowRelatedNodesAsync);
        }

        builder
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:ClearAllFilters"].Value, Icons.Material.Filled.ClearAll, ClearAllFiltersAsync)
            .AddDivider()
            .AddItem(L["ModuleSystem:DependencyGraph:ContextMenu:CopyModuleName"].Value, Icons.Material.Filled.ContentCopy, CopyModuleNameAsync);

        return builder.Build();
    }

    /// <summary>
    /// Opens the detail dialog for the context-menu node.
    /// </summary>
    private async Task ShowContextDetailsAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? contextMenuNode;
        if (targetNode is null || !OnModuleDetailClicked.HasDelegate)
        {
            return;
        }

        await OnModuleDetailClicked.InvokeAsync(targetNode.Module);
    }

    /// <summary>
    /// Focuses the requested node in the graph.
    /// </summary>
    private async Task FocusOnNodeAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? contextMenuNode;
        if (targetNode is null || jsModule == null)
        {
            return;
        }

        await jsModule.InvokeVoidAsync("focusOnNode", targetNode.Module.ToString());
    }

    /// <summary>
    /// Filters the graph to the selected node category.
    /// </summary>
    private async Task FilterByTypeAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? contextMenuNode;
        if (targetNode is null)
        {
            return;
        }

        selectedTypeFilter = GetModuleCategoryKey(targetNode);
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Clears all active graph filters.
    /// </summary>
    private async Task ClearAllFiltersAsync(ModuleDependencyNode? node)
    {
        searchText = string.Empty;
        selectedTypeFilter = "all";
        selectedEdgeFilter = "all";
        relatedNodeId = null;
        await ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Shows all nodes connected to the selected node.
    /// </summary>
    private async Task ShowRelatedNodesAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? contextMenuNode;
        if (targetNode is null)
        {
            return;
        }

        relatedNodeId = targetNode.Module.ToString();
        await ApplyCurrentGraphFilters();

        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("focusOnNode", targetNode.Module.ToString());
        }

        Snackbar.Add(L["ModuleSystem:DependencyGraph:Messages:ShowingRelatedNodes", targetNode.ModuleName], Severity.Info);
    }

    /// <summary>
    /// Clears the related-node filter.
    /// </summary>
    private Task ClearRelatedFilterAsync(ModuleDependencyNode? node)
    {
        relatedNodeId = null;
        return ApplyCurrentGraphFilters();
    }

    /// <summary>
    /// Copies the module name to the clipboard.
    /// </summary>
    private async Task CopyModuleNameAsync(ModuleDependencyNode? node)
    {
        var targetNode = node ?? contextMenuNode;
        if (targetNode is null)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", targetNode.Module.ToString());
        Snackbar.Add(L["ModuleSystem:DependencyGraph:Messages:CopiedToClipboard"], Severity.Success);
    }

    /// <summary>
    /// Finds a graph node by its module key string.
    /// </summary>
    private ModuleDependencyNode? FindNode(string? nodeId)
    {
        if (DependencyGraphData == null || string.IsNullOrWhiteSpace(nodeId))
        {
            return null;
        }

        return DependencyGraphData.Nodes.FirstOrDefault(node => node.Module.ToString() == nodeId);
    }

    /// <summary>
    /// 资源释放
    /// </summary>
    /// <returns></returns>
    public async ValueTask DisposeAsync()
    {
        if (jsModule != null)
        {
            await jsModule.InvokeVoidAsync("disposeGraph");
            await jsModule.DisposeAsync();
        }

        dotNetRef?.Dispose();
    }
}
