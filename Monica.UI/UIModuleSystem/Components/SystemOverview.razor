@using MudBlazor
@using Monica.UI.Localization
@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@inject IStringLocalizer<SharedResource> L

<div class="system-overview-container">
    @if (SystemStatus != null)
    {
        <MudGrid Spacing="4" Class="mb-4">
            <!-- System status overview -->            <MudItem xs="12" sm="6" md="3">
                <div class="overview-summary-item">
                    <MudCard Class="status-card modern-card">
                        <MudCardContent Class="pa-4">
                            <div class="card-header d-flex align-center mb-4">
                                <MudIcon Icon="@GetStatusIcon(SystemStatus.State)"
                                       Color="@GetStatusColor(SystemStatus.State)"
                                       Size="Size.Large"
                                       Class="mr-3" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:SystemOverview:Labels:SystemStatus"]</MudText>
                            </div>
                            <div class="card-content">
                                <MudText Typo="Typo.h4" Class="mb-3" Color="@GetStatusColor(SystemStatus.State)">
                                    @GetStatusText(SystemStatus.State)
                                </MudText>
                                <MudProgressLinear Color="@GetStatusColor(SystemStatus.State)" 
                                                 Value="@(SystemStatus.IsInitialized ? 100 : 0)" 
                                                 Class="mb-2" 
                                                 Size="Size.Medium" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @(SystemStatus.IsInitialized ? L["ModuleSystem:SystemOverview:Messages:SystemInitialized"] : L["ModuleSystem:SystemOverview:Messages:SystemInitializing"])
                                </MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </div>
            </MudItem>

            <!-- Module Statistics -->            <MudItem xs="12" sm="6" md="3">
                <div class="overview-summary-item">
                    <MudCard Class="stats-card modern-card">
                        <MudCardContent Class="pa-4">
                            <div class="card-header d-flex align-center mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.Apps"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       Class="mr-3" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:SystemOverview:Labels:ModuleStatistics"]</MudText>
                            </div>
                            <div class="card-content">
                                <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-3">
                                    @SystemStatus.TotalModules
                                </MudText>
                                <MudStack Row="true" Spacing="1" Class="mb-2">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                        @SystemStatus.EnabledModules
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                        <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Class="mr-1" />
                                        @SystemStatus.DisabledModules
                                    </MudChip>
                                </MudStack>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @L["ModuleSystem:SystemOverview:Labels:TotalModules"]
                                </MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </div>
            </MudItem>

            <!-- initialization time -->            <MudItem xs="12" sm="6" md="3">
                <div class="overview-summary-item">
                    <MudCard Class="performance-card modern-card">
                        <MudCardContent Class="pa-4">
                            <div class="card-header d-flex align-center mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.Timer"
                                       Color="Color.Warning"
                                       Size="Size.Large"
                                       Class="mr-3" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:SystemOverview:Labels:InitializationTime"]</MudText>
                            </div>
                            <div class="card-content">
                                <MudText Typo="Typo.h4" Color="Color.Warning" Class="mb-3">
                                    @(SystemStatus.TotalInitializationTimeMs)ms
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                    @L["ModuleSystem:SystemOverview:Labels:StartTime"]: @(SystemStatus.StartTime?.ToString("HH:mm:ss") ?? L["ModuleSystem:SystemOverview:Labels:Unknown"])
                                </MudText>
                                <MudProgressLinear Color="Color.Warning" 
                                                 Value="@GetInitTimeProgress(SystemStatus.TotalInitializationTimeMs)" 
                                                 Class="mb-2"
                                                 Size="Size.Medium" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @GetInitTimeDescription(SystemStatus.TotalInitializationTimeMs)
                                </MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </div>
            </MudItem>

            <!-- health status -->            <MudItem xs="12" sm="6" md="3">
                <div class="overview-summary-item">
                    <MudCard Class="health-card modern-card">
                        <MudCardContent Class="pa-4">
                            <div class="card-header d-flex align-center mb-4">
                                <MudIcon Icon="@GetHealthIcon()"
                                       Color="@GetHealthColor()"
                                       Size="Size.Large"
                                       Class="mr-3" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:SystemOverview:Labels:HealthStatus"]</MudText>
                            </div>
                            <div class="card-content">
                                <MudText Typo="Typo.h4" Color="@GetHealthColor()" Class="mb-3">
                                    @GetHealthText()
                                </MudText>
                                <div class="mb-2">
                                    @if (HasHealthIssues())
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                                            @L["ModuleSystem:SystemOverview:Messages:HasIssues"]
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                            @L["ModuleSystem:SystemOverview:Messages:RunningNormally"]
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @GetHealthDescription()
                                </MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </div>
            </MudItem>
        </MudGrid>

        <SystemHealthDiagnostics HealthCheckData="HealthCheckData" />
    }
    else
    {
        <MudGrid Spacing="4" Class="mb-4">
            @for (int i = 0; i < 4; i++)
            {
                <MudItem xs="12" sm="6" md="3">
                    <div class="overview-summary-item">
                        <MudCard Class="modern-card">
                            <MudCardContent Class="pa-4 d-flex align-center justify-center" Style="min-height: 200px;">
                                <div class="text-center">
                                    <MudProgressCircular Indeterminate="true" Class="mb-3" />
                                    <MudText Color="Color.Secondary">@L["ModuleSystem:SystemOverview:Labels:Loading"]</MudText>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
</div>

@code {
    /// <summary>
    /// System status data
    /// </summary>
    [Parameter] public ModuleSystemStatus? SystemStatus { get; set; }

    /// <summary>
    /// health check data
    /// </summary>
    [Parameter] public ModuleSystemHealthCheck? HealthCheckData { get; set; }

    /// <summary>
    /// Get status icon
    /// </summary>
    /// <param name="state">System status</param>
    /// <returns>Icon name</returns>
    private string GetStatusIcon(ModuleSystemState state) => state switch
    {
        ModuleSystemState.NotInitialized => Icons.Material.Filled.HourglassEmpty,
        ModuleSystemState.Initializing => Icons.Material.Filled.HourglassFull,
        ModuleSystemState.Initialized => Icons.Material.Filled.CheckCircle,
        ModuleSystemState.Failed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.HelpOutline
    };

    /// <summary>
    /// Get status color
    /// </summary>
    /// <param name="state">System status</param>
    /// <returns>Color</returns>
    private Color GetStatusColor(ModuleSystemState state) => state switch
    {
        ModuleSystemState.NotInitialized => Color.Dark,
        ModuleSystemState.Initializing => Color.Warning,
        ModuleSystemState.Initialized => Color.Success,
        ModuleSystemState.Failed => Color.Error,
        _ => Color.Default
    };

    /// <summary>
    /// Get status text
    /// </summary>
    /// <param name="state">System status</param>
    /// <returns>Status text</returns>
    private string GetStatusText(ModuleSystemState state) => state switch
    {
        ModuleSystemState.NotInitialized => L["ModuleSystem:SystemOverview:States:NotInitialized"],
        ModuleSystemState.Initializing => L["ModuleSystem:SystemOverview:States:Initializing"],
        ModuleSystemState.Initialized => L["ModuleSystem:SystemOverview:States:Initialized"],
        ModuleSystemState.Failed => L["ModuleSystem:SystemOverview:States:Failed"],
        _ => L["ModuleSystem:SystemOverview:States:Unknown"]
    };

    /// <summary>
    /// Get health status icon
    /// </summary>
    /// <returns>Icon name</returns>
    private string GetHealthIcon()
    {
        if (HealthCheckData != null)
        {
            return GetHealthStatusIcon(HealthCheckData.OverallHealth);
        }

        return SystemStatus?.HasRegistrationErrors == true || SystemStatus?.HasCircularDependencies == true
            ? Icons.Material.Filled.Error
            : Icons.Material.Filled.CheckCircle;
    }

    /// <summary>
    /// Get health status color
    /// </summary>
    /// <returns>Color</returns>
    private Color GetHealthColor()
    {
        if (HealthCheckData != null)
        {
            return GetHealthStatusColor(HealthCheckData.OverallHealth);
        }

        return SystemStatus?.HasRegistrationErrors == true || SystemStatus?.HasCircularDependencies == true
            ? Color.Error
            : Color.Success;
    }

    /// <summary>
    /// Get health status text
    /// </summary>
    /// <returns>Health status text</returns>
    private string GetHealthText()
    {
        if (HealthCheckData != null)
        {
            return GetHealthStatusText(HealthCheckData.OverallHealth);
        }

        return SystemStatus?.HasRegistrationErrors == true || SystemStatus?.HasCircularDependencies == true
            ? L["ModuleSystem:SystemOverview:Messages:HasIssues"]
            : L["ModuleSystem:SystemOverview:Messages:Healthy"];
    }

    private string GetHealthDescription()
    {
        if (HealthCheckData != null)
        {
            return HasHealthIssues()
                ? L["ModuleSystem:SystemOverview:Messages:HasIssues"]
                : L["ModuleSystem:SystemOverview:Messages:SystemHealthy"];
        }

        if (SystemStatus?.HasRegistrationErrors == true)
        {
            return L["ModuleSystem:SystemOverview:Messages:RegistrationErrors"];
        }

        if (SystemStatus?.HasCircularDependencies == true)
        {
            return L["ModuleSystem:SystemOverview:Messages:CircularDependencies"];
        }

        return L["ModuleSystem:SystemOverview:Messages:SystemHealthy"];
    }

    private bool HasHealthIssues()
    {
        if (HealthCheckData != null)
        {
            return HealthCheckData.OverallHealth != HealthStatus.Healthy;
        }

        return SystemStatus?.HasRegistrationErrors == true || SystemStatus?.HasCircularDependencies == true;
    }

    private string GetHealthStatusIcon(HealthStatus status) => status switch
    {
        HealthStatus.Healthy => Icons.Material.Filled.CheckCircle,
        HealthStatus.Warning => Icons.Material.Filled.Warning,
        HealthStatus.Unhealthy => Icons.Material.Filled.Error,
        HealthStatus.Critical => Icons.Material.Filled.Dangerous,
        _ => Icons.Material.Filled.HelpOutline
    };

    private Color GetHealthStatusColor(HealthStatus status) => status switch
    {
        HealthStatus.Healthy => Color.Success,
        HealthStatus.Warning => Color.Warning,
        HealthStatus.Unhealthy => Color.Error,
        HealthStatus.Critical => Color.Error,
        _ => Color.Default
    };

    private string GetHealthStatusText(HealthStatus status) => status switch
    {
        HealthStatus.Healthy => L["ModuleSystem:HealthCheck:States:Healthy"],
        HealthStatus.Warning => L["ModuleSystem:HealthCheck:States:Warning"],
        HealthStatus.Unhealthy => L["ModuleSystem:HealthCheck:States:Unhealthy"],
        HealthStatus.Critical => L["ModuleSystem:HealthCheck:States:Critical"],
        _ => L["ModuleSystem:HealthCheck:States:Unknown"]
    };

    /// <summary>
    /// Get initialization time progress
    /// </summary>
    /// <param name="totalTimeMs">Total initialization time (milliseconds)</param>
    /// <returns>Progress value</returns>
    private double GetInitTimeProgress(long totalTimeMs)
    {
        if (totalTimeMs == 0) return 0;
        return SystemStatus?.IsInitialized == true ? 100 : (SystemStatus?.TotalInitializationTimeMs ?? 0) / totalTimeMs * 100;
    }

    /// <summary>
    /// Get initialization time description
    /// </summary>
    /// <param name="totalTimeMs">Total initialization time (milliseconds)</param>
    /// <returns>Description text</returns>
    private string GetInitTimeDescription(long totalTimeMs)
    {
        if (totalTimeMs == 0) return L["ModuleSystem:SystemOverview:Messages:SystemStarting"];
        if (SystemStatus?.IsInitialized == true) return L["ModuleSystem:SystemOverview:Messages:SystemInitialized"];
        return string.Format(L["ModuleSystem:SystemOverview:Messages:SystemRunning"], totalTimeMs);
    }
}
