@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@inject IStringLocalizer<SharedResource> L

<MudItem xs="12" md="6" Class="dependency-graph-side-card">
    <MudCard Class="modern-card dependency-graph-side-card__card">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Info" Class="mr-2" />
                    <MudText Typo="Typo.h6">@L["ModuleSystem:DependencyGraph:Labels:Legend"]</MudText>
                </div>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent Class="pa-4 dependency-graph-side-card__content">
            <MudStack Spacing="4" Class="dependency-graph-side-card__stack">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="mb-3">@L["ModuleSystem:DependencyGraph:Labels:NodeTypes"]</MudText>
                    <MudStack Spacing="2">
                        <div class="legend-item">
                            <div class="legend-circle legend-circle-built-in"></div>
                            <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:BuiltInModule"]</MudText>
                        </div>
                        <div class="legend-item">
                            <div class="legend-circle legend-circle-ui"></div>
                            <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:UIModule"]</MudText>
                        </div>
                        <div class="legend-item">
                            <div class="legend-circle legend-circle-third-party"></div>
                            <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:ThirdPartyModule"]</MudText>
                        </div>
                        <div class="legend-item">
                            <div class="legend-circle legend-circle-disabled"></div>
                            <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:DisabledModule"]</MudText>
                        </div>
                        <div class="legend-item">
                            <div class="legend-circle legend-circle-cycle"></div>
                            <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:CircularDependencyModule"]</MudText>
                        </div>
                    </MudStack>
                </div>
                <MudDivider />
                <div>
                    <MudText Typo="Typo.subtitle1" Class="mb-3">@L["ModuleSystem:DependencyGraph:Labels:EdgeTypes"]</MudText>
                    <MudStack Spacing="2">
                        <div class="legend-edge-item">
                            <div class="legend-line legend-line-direct"></div>
                            <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:DirectDependency"]</MudText>
                        </div>
                        <div class="legend-edge-item">
                            <div class="legend-line legend-line-transitive"></div>
                            <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:TransitiveDependency"]</MudText>
                        </div>
                        <div class="legend-edge-item">
                            <div class="legend-line legend-line-cycle"></div>
                            <MudText Typo="Typo.body2">@L["ModuleSystem:DependencyGraph:Labels:CircularDependency"]</MudText>
                        </div>
                    </MudStack>
                </div>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudItem>
