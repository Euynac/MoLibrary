@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<SharedResource> L

<section class="performance-phases" aria-labelledby="performance-phases-title">
    <header class="performance-phases__header">
        <div>
            <MudText id="performance-phases-title" Typo="Typo.h6">@L["ModuleSystem:PerformanceMonitoring:Labels:CompositionPhaseElapsed"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:CompositionPhaseElapsedDescription"]</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.Analytics" Color="Color.Tertiary" />
    </header>

    @if (Phases.Count == 0)
    {
        <div class="performance-phases__empty">
            <MudIcon Icon="@Icons.Material.Filled.Analytics" Color="Color.Secondary" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:NoPhasePerformanceData"]</MudText>
        </div>
    }
    else
    {
        <div class="performance-phases__table-scroll" role="region" aria-label="@L["ModuleSystem:PerformanceMonitoring:Labels:CompositionPhaseElapsed"]" tabindex="0">
            <div class="performance-phases__table-content">
                <MudTable T="ModuleSystemPhaseView"
                          Items="@Phases.OrderBy(static phase => phase.Sequence)"
                          Dense="true"
                          Hover="true"
                          Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:Order"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:PhaseName"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:StartedAt"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:Duration"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:EndToEndShare"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:Order"]">@context.Sequence</MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:PhaseName"]">
                            @ModulePerformanceDisplayText.Phase(L, context.Name)
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:StartedAt"]">@FormatOffset(context.StartedOffsetMs)</MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:Duration"]"><strong>@FormatDuration(context.DurationMs)</strong></MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:EndToEndShare"]">
                            <div class="performance-phases__share">
                                <MudProgressLinear Value="@context.EndToEndPercentage"
                                                   Color="Color.Tertiary"
                                                   Size="Size.Small" />
                                <span>@FormatPercentage(context.EndToEndPercentage)</span>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ModuleSystemPhaseView> Phases { get; set; } = [];

    private string FormatDuration(double durationMs)
        => L["ModuleSystem:PerformanceMonitoring:Formats:Duration", durationMs];

    private string FormatOffset(double offsetMs)
        => L["ModuleSystem:PerformanceMonitoring:Formats:Offset", offsetMs];

    private string FormatPercentage(double percentage)
        => L["ModuleSystem:PerformanceMonitoring:Formats:Percentage", percentage];
}
