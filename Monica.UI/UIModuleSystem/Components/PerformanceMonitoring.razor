@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Modularity.Models
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<SharedResource> L

<div class="performance-monitoring">
    @if (SystemPerformance is null)
    {
        <div class="performance-monitoring__loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Loading:Diagnostics"]</MudText>
        </div>
    }
    else
    {
        var dashboard = ModulePerformanceDashboardViewFactory.Create(SystemPerformance);

        <ModulePerformanceSummary Summary="dashboard.Summary" />
        <ModulePerformanceTimeline Milestones="dashboard.Milestones"
                                   CriticalPath="dashboard.CriticalPath"
                                   ModuleSelected="ModuleSelected" />
        <ModulePerformanceCheckpoints Barriers="dashboard.StartupWorkBarriers" />
        <ModulePerformanceWorkTable WorkItems="dashboard.StartupWorkItems" ModuleSelected="ModuleSelected" />
        <ModulePerformanceSerialTable Modules="dashboard.SerialModules" ModuleSelected="ModuleSelected" />
        <ModulePerformancePhaseTable Phases="dashboard.SystemPhases" />
    }
</div>

@code {
    /// <summary>
    /// Gets the current immutable module composition performance snapshot.
    /// </summary>
    [Parameter]
    public ModuleSystemPerformance? SystemPerformance { get; set; }

    /// <summary>
    /// Gets the callback used to inspect a module directly from a performance diagnostic.
    /// </summary>
    [Parameter]
    public EventCallback<ModuleKey> ModuleSelected { get; set; }
}
