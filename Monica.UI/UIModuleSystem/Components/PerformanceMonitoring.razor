@using MudBlazor
@using Monica.UI.Localization
@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Dashboard.Models
@inject IStringLocalizer<SharedResource> L

<div class="performance-monitoring-container">
    @if (SystemPerformance != null)
    {
        <MudGrid Spacing="4" Class="mb-4">
            <!-- Performance overview -->            <MudItem xs="12" md="6">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Primary" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:PerformanceMonitoring:Labels:PerformanceOverview"]</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-4">
                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <MudPaper Class="pa-4 performance-metric-card" Elevation="2">
                                    <div class="d-flex justify-space-between align-center">
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Color="Color.Primary">@L["ModuleSystem:PerformanceMonitoring:Labels:TotalInitTime"]</MudText>
                                            <MudText Typo="Typo.h5" Color="Color.Primary">@($"{SystemPerformance.TotalSystemInitializationTimeMs}ms")</MudText>
                                        </div>
                                        <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Primary" Size="Size.Large" />
                                    </div>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12">
                                <MudPaper Class="pa-4 performance-metric-card" Elevation="2">
                                    <div class="d-flex justify-space-between align-center">
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Color="Color.Info">@L["ModuleSystem:PerformanceMonitoring:Labels:TotalSystemPhaseDuration"]</MudText>
                                            <MudText Typo="Typo.h5" Color="Color.Info">@($"{SystemPerformance.TotalSystemPhaseDurationMs}ms")</MudText>
                                        </div>
                                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Info" Size="Size.Large" />
                                    </div>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12">
                                <MudPaper Class="pa-4 performance-metric-card" Elevation="2">
                                    <div class="d-flex justify-space-between align-center">
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Color="Color.Success">@L["ModuleSystem:PerformanceMonitoring:Labels:TotalModulePhaseDuration"]</MudText>
                                            <MudText Typo="Typo.h5" Color="Color.Success">@($"{SystemPerformance.TotalModulePhaseDurationMs}ms")</MudText>
                                        </div>
                                        <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Success" Size="Size.Large" />
                                    </div>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12">
                                <MudPaper Class="pa-4 performance-metric-card" Elevation="2">
                                    <div class="d-flex justify-space-between align-center">
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Color="Color.Warning">@L["ModuleSystem:PerformanceMonitoring:Labels:TotalModulePhaseExecutions"]</MudText>
                                            <MudText Typo="Typo.h5" Color="Color.Warning">@SystemPerformance.TotalModulePhaseExecutions.ToString()</MudText>
                                        </div>
                                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Warning" Size="Size.Large" />
                                    </div>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- slowest module -->            <MudItem xs="12" md="6">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Error" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:PerformanceMonitoring:Labels:SlowestModules"]</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-4">
                        @if (SystemPerformance.SlowestModules.Any())
                        {
                            <MudStack Spacing="3">
                                @foreach (var (module, index) in SystemPerformance.SlowestModules.Take(5).Select((m, i) => (m, i)))
                                {
                                    <MudPaper Class="pa-4 slowest-module-card" Elevation="2">
                                        <div class="d-flex align-center justify-space-between">
                                            <div class="d-flex align-center">
                                                <MudAvatar Color="@GetRankColor(index)" Size="Size.Medium" Class="mr-3">
                                                    <MudText Typo="Typo.subtitle1" Style="font-weight: bold;">@(index + 1)</MudText>
                                                </MudAvatar>
                                                <div>
                                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@module.ModuleTypeName</MudText>
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@(module.ModuleKey?.ToString() ?? "Unknown")</MudText>
                                                </div>
                                            </div>
                                            <div class="text-right">
                                                <MudText Typo="Typo.h6" Color="@GetRankColor(index)">@($"{module.TotalDurationMs}ms")</MudText>
                                                <MudProgressLinear Value="@GetPercentage(module.TotalDurationMs)" 
                                                                 Color="@GetRankColor(index)" 
                                                                 Class="mt-2" 
                                                                 Size="Size.Medium" 
                                                                 Style="width: 100px;" />
                                            </div>
                                        </div>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <div class="d-flex align-center justify-center" style="min-height: 200px;">
                                <div class="text-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                                    <MudText Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:NoPerformanceData"]</MudText>
                                </div>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- stage performance -->            <MudItem xs="12">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Analytics" Color="Color.Tertiary" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:PerformanceMonitoring:Labels:PhasePerformanceAnalysis"]</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        @if (SystemPerformance.PhasePerformances.Any())
                        {
                            <MudDataGrid Items="@SystemPerformance.PhasePerformances" 
                                       SortMode="SortMode.Multiple" 
                                       Filterable="true" 
                                       Hideable="true"
                                       Dense="true"
                                       T="PhasePerformanceInfo"
                                       Style="min-height: 400px;">
                                <Columns>
                                    <PropertyColumn Property="x => x.Order" Title="@L["ModuleSystem:PerformanceMonitoring:Labels:Order"]" />
                                    <PropertyColumn Property="x => x.PhaseName" Title="@L["ModuleSystem:PerformanceMonitoring:Labels:PhaseName"]" />
                                    <PropertyColumn Property="x => x.DurationMs" Title="@L["ModuleSystem:PerformanceMonitoring:Labels:Duration"]" />
                                    <TemplateColumn Title="@L["ModuleSystem:PerformanceMonitoring:Labels:PerformanceRatio"]">
                                        <CellTemplate>
                                            @{
                                                var maxDuration = SystemPerformance.PhasePerformances.Max(p => p.DurationMs);
                                                var percentage = maxDuration > 0 ? (double)context.Item.DurationMs / maxDuration * 100 : 0;
                                            }
                                            <div class="d-flex align-center">
                                                <MudProgressLinear Color="@GetPerformanceColor(percentage)" 
                                                                 Value="@percentage" 
                                                                 Class="mr-2" 
                                                                 Style="width: 120px; height: 8px;" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@($"{percentage:F1}%")</MudText>
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["ModuleSystem:PerformanceMonitoring:Labels:Status"]">
                                        <CellTemplate>
                                            @{
                                                var maxDuration = SystemPerformance.PhasePerformances.Max(p => p.DurationMs);
                                                var percentage = maxDuration > 0 ? (double)context.Item.DurationMs / maxDuration * 100 : 0;
                                            }
                                            <MudChip T="string" Color="@GetPerformanceColor(percentage)" Size="Size.Small">
                                                @GetPerformanceText(percentage)
                                            </MudChip>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        }
                        else
                        {
                            <div class="d-flex align-center justify-center" style="min-height: 400px;">
                                <div class="text-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                                    <MudText Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:NoPhasePerformanceData"]</MudText>
                                </div>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudGrid Spacing="4" Class="mb-4">
            <MudItem xs="12" md="6">
                <MudCard Class="modern-card">
                    <MudCardContent Class="pa-4 d-flex align-center justify-center" Style="min-height: 300px;">
                        <div class="text-center">
                            <MudProgressCircular Indeterminate="true" Class="mb-3" />
                            <MudText Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Loading:PerformanceOverview"]</MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Class="modern-card">
                    <MudCardContent Class="pa-4 d-flex align-center justify-center" Style="min-height: 300px;">
                        <div class="text-center">
                            <MudProgressCircular Indeterminate="true" Class="mb-3" />
                            <MudText Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Loading:SlowestModules"]</MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12">
                <MudCard Class="modern-card">
                    <MudCardContent Class="pa-4 d-flex align-center justify-center" Style="min-height: 400px;">
                        <div class="text-center">
                            <MudProgressCircular Indeterminate="true" Class="mb-3" />
                            <MudText Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Loading:PhasePerformanceData"]</MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</div>

@code {
    /// <summary>
    /// System performance data
    /// </summary>
    [Parameter] public ModuleSystemPerformance? SystemPerformance { get; set; }

    /// <summary>
    /// Get ranking color
    /// </summary>
    /// <param name="index">Ranking index</param>
    /// <returns>Color</returns>
    private Color GetRankColor(int index) => index switch
    {
        0 => Color.Error,
        1 => Color.Warning,
        2 => Color.Info,
        _ => Color.Default
    };

    /// <summary>
    /// Get percentage
    /// </summary>
    /// <param name="duration">Duration</param>
    /// <returns>Percentage</returns>
    private double GetPercentage(long duration)
    {
        if (SystemPerformance?.SlowestModules == null || !SystemPerformance.SlowestModules.Any())
            return 0;

        var maxDuration = SystemPerformance.SlowestModules.Max(m => m.TotalDurationMs);
        return maxDuration > 0 ? (double)duration / maxDuration * 100 : 0;
    }

    /// <summary>
    /// Get performance colors
    /// </summary>
    /// <param name="percentage">Percentage</param>
    /// <returns>Color</returns>
    private Color GetPerformanceColor(double percentage) => percentage switch
    {
        >= 80 => Color.Error,
        >= 60 => Color.Warning,
        >= 40 => Color.Info,
        _ => Color.Success
    };

    /// <summary>
    /// Get performance text
    /// </summary>
    /// <param name="percentage">Percentage</param>
    /// <returns>Performance text</returns>
    private string GetPerformanceText(double percentage) => percentage switch
    {
        >= 80 => L["ModuleSystem:PerformanceMonitoring:States:Slow"],
        >= 60 => L["ModuleSystem:PerformanceMonitoring:States:Medium"],
        >= 40 => L["ModuleSystem:PerformanceMonitoring:States:Good"],
        _ => L["ModuleSystem:PerformanceMonitoring:States:Excellent"]
    };
}