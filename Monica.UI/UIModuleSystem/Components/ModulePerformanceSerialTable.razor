@using Monica.Core.Modularity.Models
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<SharedResource> L

<section class="performance-serial" aria-labelledby="performance-serial-title">
    <header class="performance-serial__header">
        <div>
            <MudText id="performance-serial-title" Typo="Typo.h6">@L["ModuleSystem:PerformanceMonitoring:Labels:SerialModuleCallbacks"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:SerialModuleCallbacksDescription"]</MudText>
        </div>
        <div class="performance-serial__sort">
            <MudSelect T="string"
                       Label="@L["ModuleSystem:PerformanceMonitoring:Labels:SortBy"]"
                       Value="@_sortBy"
                       ValueChanged="SetSortBy"
                       Dense="true"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@SORT_AGGREGATE">@L["ModuleSystem:PerformanceMonitoring:Labels:SerialTotal"]</MudSelectItem>
                <MudSelectItem T="string" Value="@SORT_SLOWEST_PHASE">@L["ModuleSystem:PerformanceMonitoring:Labels:SlowestPhaseDuration"]</MudSelectItem>
                <MudSelectItem T="string" Value="@SORT_MODULE">@L["ModuleSystem:PerformanceMonitoring:Labels:Module"]</MudSelectItem>
            </MudSelect>
            <MudTooltip Text="@(_descending ? L["ModuleSystem:PerformanceMonitoring:Actions:SortAscending"] : L["ModuleSystem:PerformanceMonitoring:Actions:SortDescending"])">
                <MudIconButton Icon="@(_descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                               Color="Color.Primary"
                               OnClick="ToggleSortDirection" />
            </MudTooltip>
        </div>
    </header>

    @if (Modules.Count == 0)
    {
        <div class="performance-serial__empty">
            <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Secondary" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:NoPerformanceData"]</MudText>
        </div>
    }
    else
    {
        <div class="performance-serial__table-scroll" role="region" aria-label="@L["ModuleSystem:PerformanceMonitoring:Labels:SerialModuleCallbacks"]" tabindex="0">
            <div class="performance-serial__table-content">
                <MudTable T="ModuleSerialCallbackView"
                          Items="@SortedModules"
                          Dense="true"
                          Hover="true"
                          Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:Module"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:SerialTotal"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:SlowestPhase"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:SlowestPhaseDuration"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:CallbackCount"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:ScheduledWorkCount"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:Module"]">
                            @if (context.ModuleKey is { } moduleKey)
                            {
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="() => OpenModuleAsync(moduleKey)">
                                    @context.ModuleTypeName
                                </MudButton>
                            }
                            else
                            {
                                <span class="performance-serial__identifier">@context.ModuleTypeName</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:SerialTotal"]">
                            <strong>@FormatDuration(context.AggregateDurationMs)</strong>
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:SlowestPhase"]">
                            @(context.SlowestPhase is null
                                ? L["ModuleSystem:PerformanceMonitoring:States:None"]
                                : ModulePerformanceDisplayText.Phase(L, context.SlowestPhase))
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:SlowestPhaseDuration"]">
                            @FormatDuration(context.SlowestPhaseDurationMs)
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:CallbackCount"]">@context.CallbackCount</MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:ScheduledWorkCount"]">@context.WorkItemCount</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </div>
    }
</section>

@code {
    private const string SORT_AGGREGATE = "aggregate";
    private const string SORT_SLOWEST_PHASE = "slowest-phase";
    private const string SORT_MODULE = "module";

    private string _sortBy = SORT_AGGREGATE;
    private bool _descending = true;

    [Parameter, EditorRequired]
    public IReadOnlyList<ModuleSerialCallbackView> Modules { get; set; } = [];

    [Parameter]
    public EventCallback<ModuleKey> ModuleSelected { get; set; }

    private IEnumerable<ModuleSerialCallbackView> SortedModules
    {
        get
        {
            IOrderedEnumerable<ModuleSerialCallbackView> sorted = _sortBy switch
            {
                SORT_SLOWEST_PHASE => _descending
                    ? Modules.OrderByDescending(static module => module.SlowestPhaseDurationMs)
                    : Modules.OrderBy(static module => module.SlowestPhaseDurationMs),
                SORT_MODULE => _descending
                    ? Modules.OrderByDescending(static module => module.ModuleTypeName, StringComparer.OrdinalIgnoreCase)
                    : Modules.OrderBy(static module => module.ModuleTypeName, StringComparer.OrdinalIgnoreCase),
                _ => _descending
                    ? Modules.OrderByDescending(static module => module.AggregateDurationMs)
                    : Modules.OrderBy(static module => module.AggregateDurationMs)
            };

            return sorted.ThenBy(static module => module.ModuleOrder);
        }
    }

    private void SetSortBy(string sortBy) => _sortBy = sortBy;

    private void ToggleSortDirection() => _descending = !_descending;

    private Task OpenModuleAsync(ModuleKey moduleKey) => ModuleSelected.InvokeAsync(moduleKey);

    private string FormatDuration(double durationMs)
        => L["ModuleSystem:PerformanceMonitoring:Formats:Duration", durationMs];
}
