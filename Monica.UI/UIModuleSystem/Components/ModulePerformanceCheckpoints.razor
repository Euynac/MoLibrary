@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<SharedResource> L

<section class="performance-checkpoints" aria-labelledby="performance-checkpoints-title">
    <header class="performance-checkpoints__header">
        <div>
            <MudText id="performance-checkpoints-title" Typo="Typo.h6">@L["ModuleSystem:PerformanceMonitoring:Labels:ParallelWorkBarriers"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:ParallelWorkBarriersDescription"]</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" />
    </header>

    @if (Barriers.Count == 0)
    {
        <div class="performance-checkpoints__empty">
            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Color="Color.Secondary" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:NoBarriers"]</MudText>
        </div>
    }
    else
    {
        <div class="performance-checkpoints__grid">
            @foreach (var barrier in Barriers)
            {
                <article class="performance-checkpoints__item @GetBarrierClass(barrier)">
                    <div class="performance-checkpoints__item-header">
                        <strong>@ModulePerformanceDisplayText.Barrier(L, barrier.Barrier)</strong>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(barrier.PendingWorkItems.Count > 0 ? Color.Warning : Color.Success)"
                                 Variant="Variant.Outlined">
                            @ModulePerformanceDisplayText.Duration(L, barrier.WaitDurationMs)
                        </MudChip>
                    </div>

                    <dl class="performance-checkpoints__facts">
                        <div>
                            <dt>@L["ModuleSystem:PerformanceMonitoring:Labels:DueWorkItems"]</dt>
                            <dd>@barrier.DueWorkItemNames.Count</dd>
                        </div>
                        <div>
                            <dt>@L["ModuleSystem:PerformanceMonitoring:Labels:PendingAtEntry"]</dt>
                            <dd>@barrier.PendingWorkItems.Count</dd>
                        </div>
                        <div>
                            <dt>@L["ModuleSystem:PerformanceMonitoring:Labels:BarrierEntered"]</dt>
                            <dd>@ModulePerformanceDisplayText.Offset(L, barrier.EnteredOffsetMs)</dd>
                        </div>
                        <div>
                            <dt>@L["ModuleSystem:PerformanceMonitoring:Labels:BarrierReleased"]</dt>
                            <dd>@ModulePerformanceDisplayText.Offset(L, barrier.ReleasedOffsetMs)</dd>
                        </div>
                    </dl>

                    <div class="performance-checkpoints__releaser">
                        <small>@L["ModuleSystem:PerformanceMonitoring:Labels:BarrierReleaser"]</small>
                        <strong>@(barrier.ReleasingWorkItemName ?? L["ModuleSystem:PerformanceMonitoring:States:None"])</strong>
                    </div>

                    @if (barrier.DueWorkItemNames.Count > 0)
                    {
                        <div class="performance-checkpoints__due">
                            <small>@L["ModuleSystem:PerformanceMonitoring:Labels:DueWorkItems"]</small>
                            <div>
                                @foreach (var workName in barrier.DueWorkItemNames)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@workName</MudChip>
                                }
                            </div>
                        </div>
                    }

                    @if (barrier.PendingWorkItems.Count > 0)
                    {
                        <div class="performance-checkpoints__pending">
                            <small>@L["ModuleSystem:PerformanceMonitoring:Labels:PendingWorkItems"]</small>
                            <div>
                                @foreach (var pending in barrier.PendingWorkItems)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                        @L[
                                            "ModuleSystem:PerformanceMonitoring:Formats:PendingWorkItem",
                                            pending.WorkItemName,
                                            pending.RemainingDurationMs]
                                    </MudChip>
                                }
                            </div>
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ModuleStartupWorkBarrierView> Barriers { get; set; } = [];

    private static string GetBarrierClass(ModuleStartupWorkBarrierView barrier)
        => barrier.PendingWorkItems.Count > 0
            ? "performance-checkpoints__item--blocked"
            : "performance-checkpoints__item--clear";

}
