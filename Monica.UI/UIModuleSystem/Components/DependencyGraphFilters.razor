@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@inject IStringLocalizer<SharedResource> L

<MudItem xs="12" md="8">
    <MudCard Class="modern-card">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" Class="mr-2" />
                    <MudText Typo="Typo.h6">@L["ModuleSystem:DependencyGraph:Labels:GraphControls"]</MudText>
                </div>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent Class="pa-4">
            <MudGrid Spacing="4">
                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Value="SelectedLayout"
                               Label="@L["ModuleSystem:DependencyGraph:Labels:LayoutAlgorithm"]"
                               ValueChanged="SelectedLayoutChanged"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("force")">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.ScatterPlot" Class="mr-2" />
                                @L["ModuleSystem:DependencyGraph:Layouts:Force"]
                            </div>
                        </MudSelectItem>
                        <MudSelectItem Value="@("hierarchical")">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-2" />
                                @L["ModuleSystem:DependencyGraph:Layouts:Hierarchical"]
                            </div>
                        </MudSelectItem>
                        <MudSelectItem Value="@("circular")">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Class="mr-2" />
                                @L["ModuleSystem:DependencyGraph:Layouts:Circular"]
                            </div>
                        </MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudTextField T="string"
                                  Value="SearchText"
                                  ValueChanged="SearchTextChanged"
                                  Label="@L["ModuleSystem:DependencyGraph:Labels:Search"]"
                                  Placeholder="@L["ModuleSystem:DependencyGraph:Labels:SearchPlaceholder"]"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Clearable="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12">
                    <div class="graph-filter-group">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            @L["ModuleSystem:DependencyGraph:Labels:Filter"]
                        </MudText>
                        <MudChipSet T="string"
                                    SelectedValue="SelectedEdgeFilter"
                                    SelectedValueChanged="OnEdgeFilterChipChanged"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    CheckMark="true"
                                    Class="dependency-filter-chipset">
                            <MudChip T="string"
                                     Value="@("all")"
                                     Size="Size.Small"
                                     Variant="@GetFilterChipVariant(SelectedEdgeFilter, "all")"
                                     Color="@GetEdgeFilterColor("all")"
                                     Icon="@Icons.Material.Filled.Visibility">
                                @L["ModuleSystem:DependencyGraph:Filters:ShowAll"]
                            </MudChip>
                            <MudChip T="string"
                                     Value="@("direct")"
                                     Size="Size.Small"
                                     Variant="@GetFilterChipVariant(SelectedEdgeFilter, "direct")"
                                     Color="@GetEdgeFilterColor("direct")"
                                     Icon="@Icons.Material.Filled.DirectionsRun">
                                @L["ModuleSystem:DependencyGraph:Filters:DirectOnly"]
                            </MudChip>
                            <MudChip T="string"
                                     Value="@("cycle")"
                                     Size="Size.Small"
                                     Variant="@GetFilterChipVariant(SelectedEdgeFilter, "cycle")"
                                     Color="@GetEdgeFilterColor("cycle")"
                                     Icon="@Icons.Material.Filled.Warning">
                                @L["ModuleSystem:DependencyGraph:Filters:CycleOnly"]
                            </MudChip>
                        </MudChipSet>
                    </div>
                </MudItem>
                <MudItem xs="12">
                    <div class="graph-filter-group">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            @L["ModuleSystem:DependencyGraph:Labels:TypeFilter"]
                        </MudText>
                        <div class="graph-filter-actions">
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       OnClick="SelectAllTypeFilters">
                                @L["ModuleSystem:DependencyGraph:Actions:SelectAll"]
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Secondary"
                                       OnClick="ClearTypeFilters">
                                @L["ModuleSystem:DependencyGraph:Actions:Clear"]
                            </MudButton>
                        </div>
                        <MudChipSet T="string"
                                    SelectedValues="SelectedTypeFilters"
                                    SelectedValuesChanged="SelectedTypeFiltersChanged"
                                    SelectionMode="SelectionMode.MultiSelection"
                                    CheckMark="true"
                                    Class="dependency-filter-chipset">
                            <MudChip T="string"
                                     Value="@("built-in")"
                                     Size="Size.Small"
                                     Variant="@GetFilterChipVariant(SelectedTypeFilters, "built-in")"
                                     Color="@GetTypeFilterColor("built-in")"
                                     Icon="@Icons.Material.Filled.SettingsInputComponent">
                                @L["ModuleSystem:DependencyGraph:Types:BuiltIn"]
                            </MudChip>
                            <MudChip T="string"
                                     Value="@("ui")"
                                     Size="Size.Small"
                                     Variant="@GetFilterChipVariant(SelectedTypeFilters, "ui")"
                                     Color="@GetTypeFilterColor("ui")"
                                     Icon="@Icons.Material.Filled.Web">
                                @L["ModuleSystem:DependencyGraph:Types:UI"]
                            </MudChip>
                            <MudChip T="string"
                                     Value="@("third-party")"
                                     Size="Size.Small"
                                     Variant="@GetFilterChipVariant(SelectedTypeFilters, "third-party")"
                                     Color="@GetTypeFilterColor("third-party")"
                                     Icon="@Icons.Material.Filled.Extension">
                                @L["ModuleSystem:DependencyGraph:Types:ThirdParty"]
                            </MudChip>
                            <MudChip T="string"
                                     Value="@("disabled")"
                                     Size="Size.Small"
                                     Variant="@GetFilterChipVariant(SelectedTypeFilters, "disabled")"
                                     Color="@GetTypeFilterColor("disabled")"
                                     Icon="@Icons.Material.Filled.Block">
                                @L["ModuleSystem:DependencyGraph:Types:Disabled"]
                            </MudChip>
                            <MudChip T="string"
                                     Value="@("cycle")"
                                     Size="Size.Small"
                                     Variant="@GetFilterChipVariant(SelectedTypeFilters, "cycle")"
                                     Color="@GetTypeFilterColor("cycle")"
                                     Icon="@Icons.Material.Filled.SyncProblem">
                                @L["ModuleSystem:DependencyGraph:Types:Circular"]
                            </MudChip>
                        </MudChipSet>
                    </div>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-4" />
            <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ZoomIn"
                           OnClick="ZoomIn">
                    @L["ModuleSystem:DependencyGraph:Labels:ZoomIn"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ZoomOut"
                           OnClick="ZoomOut">
                    @L["ModuleSystem:DependencyGraph:Labels:ZoomOut"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.CenterFocusStrong"
                           OnClick="ResetZoom">
                    @L["ModuleSystem:DependencyGraph:Labels:ResetView"]
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudItem>

@code {
    [Parameter]
    public required string SelectedLayout { get; set; }

    [Parameter]
    public EventCallback<string> SelectedLayoutChanged { get; set; }

    [Parameter]
    public required string SearchText { get; set; }

    [Parameter]
    public EventCallback<string> SearchTextChanged { get; set; }

    [Parameter]
    public required string SelectedEdgeFilter { get; set; }

    [Parameter]
    public EventCallback<string> SelectedEdgeFilterChanged { get; set; }

    [Parameter]
    public required IReadOnlyCollection<string> SelectedTypeFilters { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyCollection<string>?> SelectedTypeFiltersChanged { get; set; }

    [Parameter]
    public EventCallback SelectAllTypeFilters { get; set; }

    [Parameter]
    public EventCallback ClearTypeFilters { get; set; }

    [Parameter]
    public EventCallback ZoomIn { get; set; }

    [Parameter]
    public EventCallback ZoomOut { get; set; }

    [Parameter]
    public EventCallback ResetZoom { get; set; }

    private Task OnEdgeFilterChipChanged(string? filter)
    {
        return SelectedEdgeFilterChanged.InvokeAsync(filter ?? "all");
    }

    private static Variant GetFilterChipVariant(string? selectedValue, string chipValue)
    {
        return string.Equals(selectedValue, chipValue, StringComparison.Ordinal)
            ? Variant.Filled
            : Variant.Outlined;
    }

    private static Variant GetFilterChipVariant(IReadOnlyCollection<string>? selectedValues, string chipValue)
    {
        return selectedValues?.Contains(chipValue) == true
            ? Variant.Filled
            : Variant.Outlined;
    }

    private static Color GetEdgeFilterColor(string filter) => filter switch
    {
        "all" => Color.Primary,
        "direct" => Color.Success,
        "cycle" => Color.Error,
        _ => Color.Default
    };

    private static Color GetTypeFilterColor(string filter) => filter switch
    {
        "built-in" => Color.Primary,
        "ui" => Color.Info,
        "third-party" => Color.Success,
        "disabled" => Color.Default,
        "cycle" => Color.Error,
        _ => Color.Default
    };
}
