@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Modularity.Models
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<SharedResource> L

<section class="performance-work" aria-labelledby="@_titleId">
    <header class="performance-work__header">
        <div>
            <MudText id="@_titleId" Typo="Typo.h6">@L["ModuleSystem:PerformanceMonitoring:Labels:ParallelStartupWork"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:ParallelStartupWorkDescription"]</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Success" />
    </header>

    @if (WorkItems.Count == 0)
    {
        <div class="performance-work__empty">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Secondary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle2">@L["ModuleSystem:StartupWork:Messages:NoWorkTitle"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:StartupWork:Messages:NoWorkDescription"]</MudText>
            </div>
        </div>
    }
    else
    {
        <div class="performance-work__table-scroll" role="region" aria-label="@L["ModuleSystem:PerformanceMonitoring:Labels:ParallelStartupWork"]" tabindex="0">
            <div class="performance-work__table-content">
                <MudTable T="ModuleStartupWorkItemView"
                          Items="@WorkItems"
                          Dense="true"
                          Hover="true"
                          Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        @if (ShowModuleColumn)
                        {
                            <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:Module"]</MudTh>
                        }
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:WorkItem"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:ScheduledIn"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:StartupBarrier"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:Queue"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:Execution"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:StartupImpact"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:Status"]</MudTh>
                        <MudTh>@L["ModuleSystem:PerformanceMonitoring:Labels:Details"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @if (ShowModuleColumn)
                        {
                            <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:Module"]">
                                @if (context.ModuleKey is { } moduleKey)
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="() => OpenModuleAsync(moduleKey)">
                                        @context.ModuleTypeName
                                    </MudButton>
                                }
                                else
                                {
                                    <span class="performance-work__identifier">@context.ModuleTypeName</span>
                                }
                            </MudTd>
                        }
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:WorkItem"]">
                            <span class="performance-work__identifier">@context.Name</span>
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:ScheduledIn"]">
                            <span class="performance-work__identifier">@context.OriginPhase</span>
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:StartupBarrier"]">
                            @ModulePerformanceDisplayText.Barrier(L, context.Barrier)
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:Queue"]">
                            @ModulePerformanceDisplayText.Duration(L, context.QueueDurationMs)
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:Execution"]">
                            <strong>@ModulePerformanceDisplayText.Duration(L, context.ExecutionDurationMs)</strong>
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:StartupImpact"]">
                            <MudChip T="string"
                                     Color="@GetImpactColor(context)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small">
                                @GetImpactText(context)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:Status"]">
                            <MudChip T="string"
                                     Color="@GetStatusColor(context.Status)"
                                     Size="Size.Small"
                                     Icon="@GetStatusIcon(context.Status)">
                                @ModulePerformanceDisplayText.WorkStatus(L, context.Status)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="@L["ModuleSystem:PerformanceMonitoring:Labels:Details"]">
                            <span class="performance-work__details">@GetDetails(context)</span>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </div>
    }
</section>

@code {
    private readonly string _titleId = $"performance-work-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public IReadOnlyList<ModuleStartupWorkItemView> WorkItems { get; set; } = [];

    [Parameter]
    public bool ShowModuleColumn { get; set; } = true;

    [Parameter]
    public EventCallback<ModuleKey> ModuleSelected { get; set; }

    private Task OpenModuleAsync(ModuleKey moduleKey) => ModuleSelected.InvokeAsync(moduleKey);

    private string GetDetails(ModuleStartupWorkItemView item)
    {
        if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
        {
            return item.ErrorMessage;
        }

        if (item.RemainingAtBarrierMs is { } remaining)
        {
            return L["ModuleSystem:PerformanceMonitoring:Messages:RemainingAtBarrier", remaining];
        }

        return L["ModuleSystem:PerformanceMonitoring:States:None"];
    }

    private string GetImpactText(ModuleStartupWorkItemView item)
    {
        return item.Impact switch
        {
            ModuleStartupWorkImpact.DoesNotBlockStartup =>
                L["ModuleSystem:PerformanceMonitoring:States:DoesNotBlockStartup"],
            ModuleStartupWorkImpact.PendingBeforeBarrier =>
                L["ModuleSystem:PerformanceMonitoring:States:PendingBeforeBarrier"],
            ModuleStartupWorkImpact.BlockedBarrier =>
                L["ModuleSystem:PerformanceMonitoring:States:BlockedBarrier"],
            ModuleStartupWorkImpact.CompletedBeforeBarrier =>
                L["ModuleSystem:PerformanceMonitoring:States:CompletedBeforeBarrier"],
            _ => L["ModuleSystem:PerformanceMonitoring:States:None"]
        };
    }

    private static Color GetImpactColor(ModuleStartupWorkItemView item) => item.Impact switch
    {
        ModuleStartupWorkImpact.DoesNotBlockStartup => Color.Info,
        ModuleStartupWorkImpact.PendingBeforeBarrier => Color.Info,
        ModuleStartupWorkImpact.BlockedBarrier => Color.Warning,
        ModuleStartupWorkImpact.CompletedBeforeBarrier => Color.Success,
        _ => Color.Default
    };

    private static Color GetStatusColor(ModuleStartupWorkStatus status) => status switch
    {
        ModuleStartupWorkStatus.Queued => Color.Default,
        ModuleStartupWorkStatus.Running => Color.Info,
        ModuleStartupWorkStatus.Succeeded => Color.Success,
        ModuleStartupWorkStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private static string GetStatusIcon(ModuleStartupWorkStatus status) => status switch
    {
        ModuleStartupWorkStatus.Queued => Icons.Material.Filled.HourglassEmpty,
        ModuleStartupWorkStatus.Running => Icons.Material.Filled.Sync,
        ModuleStartupWorkStatus.Succeeded => Icons.Material.Filled.CheckCircle,
        ModuleStartupWorkStatus.Failed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.HelpOutline
    };
}
