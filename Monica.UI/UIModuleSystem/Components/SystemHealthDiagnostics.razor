@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@using MudBlazor
@inject IStringLocalizer<SharedResource> L

@if (HealthCheckData != null)
{
    <div class="health-diagnostics">
        <MudGrid Spacing="4">
            <MudItem xs="12">
                <MudCard Class="diagnostic-card">
                    <MudCardContent Class="pa-4">
                        <div class="section-header">
                            <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Info" Class="mr-2" />
                            <MudText Typo="Typo.h6">@L["ModuleSystem:HealthCheck:Labels:PerformanceMetrics"]</MudText>
                        </div>

                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6" md="3">
                                <MudPaper Class="metric-card pa-4" Elevation="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ModuleSystem:HealthCheck:Labels:AverageInitTime"]</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Primary">@($"{HealthCheckData.PerformanceMetrics.AverageModuleInitTimeMs:F2}ms")</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudPaper Class="metric-card pa-4" Elevation="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ModuleSystem:HealthCheck:Labels:SlowestModuleTime"]</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Warning">@($"{HealthCheckData.PerformanceMetrics.SlowestModuleInitTimeMs}ms")</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudPaper Class="metric-card pa-4" Elevation="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ModuleSystem:HealthCheck:Labels:EfficiencyScore"]</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Success">@($"{HealthCheckData.PerformanceMetrics.InitializationEfficiencyScore}/100")</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudPaper Class="metric-card pa-4" Elevation="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ModuleSystem:HealthCheck:Labels:MemoryUsage"]</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Info">@GetMemoryUsageText()</MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="6">
                <div class="diagnostic-list-card">
                    <MudCard Class="diagnostic-card" Style="height:100%;">
                        <MudCardContent Class="pa-4" Style="height:100%;">
                            <div class="diagnostic-card-content">
                                <div class="section-header">
                                    <MudIcon Icon="@Icons.Material.Filled.BugReport" Color="Color.Error" Class="mr-2" />
                                    <MudText Typo="Typo.h6">@L["ModuleSystem:HealthCheck:Labels:DiscoveredIssues"]</MudText>
                                </div>

                                <div class="diagnostic-body">
                                    @if (HealthCheckData.Issues.Any())
                                    {
                                        <div class="diagnostic-list">
                                            <MudStack Spacing="2">
                                                @foreach (var issue in HealthCheckData.Issues)
                                                {
                                                    <MudPaper Class="signal-item pa-3" Elevation="1">
                                                        <div class="signal-item-header">
                                                            <div class="signal-item-title">
                                                                <MudIcon Icon="@GetIssueSeverityIcon(issue.Severity)"
                                                                         Color="@GetIssueSeverityColor(issue.Severity)"
                                                                         Size="Size.Medium"
                                                                         Class="mr-2" />
                                                                <MudText Typo="Typo.subtitle1">@issue.Title</MudText>
                                                            </div>
                                                            <MudChip T="string" Color="@GetIssueSeverityColor(issue.Severity)" Size="Size.Small">
                                                                @GetIssueSeverityText(issue.Severity)
                                                            </MudChip>
                                                        </div>
                                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@issue.Description</MudText>
                                                    </MudPaper>
                                                }
                                            </MudStack>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="empty-state-panel">
                                            <MudIcon Icon="@Icons.Material.Filled.Verified"
                                                     Size="Size.Large"
                                                     Color="Color.Success"
                                                     Class="empty-state-icon" />
                                            <MudText Typo="Typo.h6">@L["ModuleSystem:HealthCheck:Messages:NoIssuesFound"]</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                @L["ModuleSystem:SystemOverview:Messages:RunningNormally"]
                                            </MudText>
                                        </div>
                                    }
                                </div>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </div>
            </MudItem>

            <MudItem xs="12" lg="6">
                <div class="diagnostic-list-card">
                    <MudCard Class="diagnostic-card" Style="height:100%;">
                        <MudCardContent Class="pa-4" Style="height:100%;">
                            <div class="diagnostic-card-content">
                                <div class="section-header">
                                    <MudIcon Icon="@Icons.Material.Filled.Checklist" Color="Color.Success" Class="mr-2" />
                                    <MudText Typo="Typo.h6">@L["ModuleSystem:HealthCheck:Labels:CheckItems"]</MudText>
                                </div>

                                <div class="diagnostic-body">
                                    @if (HealthCheckData.HealthCheckItems.Any())
                                    {
                                        <div class="diagnostic-list">
                                            <MudStack Spacing="2">
                                                @foreach (var item in HealthCheckData.HealthCheckItems)
                                                {
                                                    <MudPaper Class="signal-item pa-3" Elevation="1">
                                                        <div class="signal-item-header">
                                                            <div class="signal-item-title">
                                                                <MudIcon Icon="@GetHealthStatusIcon(item.Status)"
                                                                         Color="@GetHealthStatusColor(item.Status)"
                                                                         Size="Size.Medium"
                                                                         Class="mr-2" />
                                                                <MudText Typo="Typo.subtitle1">@item.Name</MudText>
                                                            </div>
                                                            <MudChip T="string" Color="@GetHealthStatusColor(item.Status)" Size="Size.Small">
                                                                @GetHealthStatusText(item.Status)
                                                            </MudChip>
                                                        </div>
                                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Details</MudText>
                                                    </MudPaper>
                                                }
                                            </MudStack>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                                            @L["ModuleSystem:HealthCheck:Messages:NoCheckItems"]
                                        </MudAlert>
                                    }
                                </div>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </div>
            </MudItem>
        </MudGrid>
    </div>
}

@code {
    [Parameter] public ModuleSystemHealthCheck? HealthCheckData { get; set; }

    private string GetMemoryUsageText()
    {
        var memoryUsage = HealthCheckData?.PerformanceMetrics.MemoryUsageBytes;
        return memoryUsage.HasValue
            ? $"{memoryUsage.Value / 1024d / 1024d:F2}MB"
            : L["ModuleSystem:SystemOverview:Labels:Unknown"];
    }

    private string GetHealthStatusIcon(HealthStatus status) => status switch
    {
        HealthStatus.Healthy => Icons.Material.Filled.CheckCircle,
        HealthStatus.Warning => Icons.Material.Filled.Warning,
        HealthStatus.Unhealthy => Icons.Material.Filled.Error,
        HealthStatus.Critical => Icons.Material.Filled.Dangerous,
        _ => Icons.Material.Filled.HelpOutline
    };

    private Color GetHealthStatusColor(HealthStatus status) => status switch
    {
        HealthStatus.Healthy => Color.Success,
        HealthStatus.Warning => Color.Warning,
        HealthStatus.Unhealthy => Color.Error,
        HealthStatus.Critical => Color.Error,
        _ => Color.Default
    };

    private string GetHealthStatusText(HealthStatus status) => status switch
    {
        HealthStatus.Healthy => L["ModuleSystem:HealthCheck:States:Healthy"],
        HealthStatus.Warning => L["ModuleSystem:HealthCheck:States:Warning"],
        HealthStatus.Unhealthy => L["ModuleSystem:HealthCheck:States:Unhealthy"],
        HealthStatus.Critical => L["ModuleSystem:HealthCheck:States:Critical"],
        _ => L["ModuleSystem:HealthCheck:States:Unknown"]
    };

    private string GetIssueSeverityIcon(IssueSeverity severity) => severity switch
    {
        IssueSeverity.Information => Icons.Material.Filled.Info,
        IssueSeverity.Low => Icons.Material.Filled.Warning,
        IssueSeverity.Medium => Icons.Material.Filled.PriorityHigh,
        IssueSeverity.High => Icons.Material.Filled.Error,
        IssueSeverity.Critical => Icons.Material.Filled.Dangerous,
        _ => Icons.Material.Filled.HelpOutline
    };

    private Color GetIssueSeverityColor(IssueSeverity severity) => severity switch
    {
        IssueSeverity.Information => Color.Info,
        IssueSeverity.Low => Color.Warning,
        IssueSeverity.Medium => Color.Warning,
        IssueSeverity.High => Color.Error,
        IssueSeverity.Critical => Color.Error,
        _ => Color.Default
    };

    private string GetIssueSeverityText(IssueSeverity severity) => severity switch
    {
        IssueSeverity.Information => L["ModuleSystem:HealthCheck:Severities:Information"],
        IssueSeverity.Low => L["ModuleSystem:HealthCheck:Severities:Low"],
        IssueSeverity.Medium => L["ModuleSystem:HealthCheck:Severities:Medium"],
        IssueSeverity.High => L["ModuleSystem:HealthCheck:Severities:High"],
        IssueSeverity.Critical => L["ModuleSystem:HealthCheck:Severities:Critical"],
        _ => L["ModuleSystem:HealthCheck:States:Unknown"]
    };
}
