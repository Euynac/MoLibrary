@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@inject IStringLocalizer<SharedResource> L

<MudItem xs="12" md="6" Class="dependency-graph-side-card">
    <MudCard Class="modern-card dependency-graph-side-card__card">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Secondary" Class="mr-2" />
                    <MudText Typo="Typo.h6">@L["ModuleSystem:DependencyGraph:Labels:NodeDetails"]</MudText>
                </div>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent Class="pa-4 dependency-graph-side-card__content">
            <div class="node-detail-content">
                <div class="node-detail-placeholder">
                    <div class="node-detail-placeholder__body">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Secondary" Class="node-detail-placeholder__icon" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            @L["ModuleSystem:DependencyGraph:Messages:HoverToViewDetails"]
                        </MudText>
                    </div>
                </div>
            </div>
        </MudCardContent>
    </MudCard>
</MudItem>
