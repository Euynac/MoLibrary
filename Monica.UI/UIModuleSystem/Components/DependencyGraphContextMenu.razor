@using Monica.Core.Modularity.Dashboard.Models
@using Monica.UI.Shared.Components.ContextMenu

<MoContextMenu TItem="ModuleDependencyNode"
               Items="Items"
               Visible="Visible"
               InitialX="InitialX"
               InitialY="InitialY"
               ContextItem="ContextItem"
               OnItemClick="OnItemClick"
               OnClose="OnClose" />

@code {
    [Parameter]
    public List<ContextMenuItem<ModuleDependencyNode>> Items { get; set; } = [];

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public double InitialX { get; set; }

    [Parameter]
    public double InitialY { get; set; }

    [Parameter]
    public ModuleDependencyNode? ContextItem { get; set; }

    [Parameter]
    public EventCallback<ContextMenuItem<ModuleDependencyNode>> OnItemClick { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }
}
