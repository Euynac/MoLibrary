@using MudBlazor
@using Monica.UI.Localization
@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Modularity.Models
@inject IStringLocalizer<SharedResource> L

<div class="module-management-container">
    @if (RegistrationInfo != null)
    {
        <MudGrid Spacing="4" Class="mb-4">
            <!-- Module Statistics -->            <MudItem xs="12" md="4" Class="module-management-equal-card">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Analytics" Color="Color.Primary" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:ModuleManagement:Statistics"]</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="3">
                            <MudPaper Class="pa-4 modern-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Primary">@L["ModuleSystem:ModuleManagement:Labels:TotalModules"]</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Primary">@RegistrationInfo.Statistics.TotalModules.ToString()</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.Apps" Color="Color.Primary" Size="Size.Large" />
                                </div>
                            </MudPaper>
                            <MudPaper Class="pa-4 modern-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Success">@L["ModuleSystem:ModuleManagement:Labels:EnabledModules"]</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Success">@RegistrationInfo.Statistics.EnabledModules.ToString()</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                                </div>
                            </MudPaper>
                            <MudPaper Class="pa-4 modern-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Warning">@L["ModuleSystem:ModuleManagement:Labels:DisabledModules"]</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Warning">@RegistrationInfo.Statistics.DisabledModules.ToString()</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Warning" Size="Size.Large" />
                                </div>
                            </MudPaper>
                            <MudPaper Class="pa-4 modern-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Info">@L["ModuleSystem:ModuleManagement:Labels:WebModules"]</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Info">@GetWebModuleCount().ToString()</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Info" Size="Size.Large" />
                                </div>
                            </MudPaper>
                            <MudPaper Class="pa-4 modern-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@L["ModuleSystem:ModuleManagement:Labels:WebHostRequiredModules"]</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Secondary">@GetWebHostRequiredModuleCount().ToString()</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.WebAsset" Color="Color.Secondary" Size="Size.Large" />
                                </div>
                            </MudPaper>
                            <MudPaper Class="pa-4 modern-stat-card" Elevation="2">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Info">@L["ModuleSystem:ModuleManagement:Labels:TotalSerialPhaseDuration"]</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Info">@($"{RegistrationInfo.Statistics.TotalSerialPhaseDurationMs}ms")</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Info" Size="Size.Large" />
                                </div>
                            </MudPaper>
                            <!-- Module distribution chart -->                            <MudPaper Class="pa-4 modern-stat-card" Elevation="2">
                                <MudText Typo="Typo.subtitle1" Class="mb-3">@L["ModuleSystem:ModuleManagement:Labels:ModuleDistribution"]</MudText>
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.body2">@L["ModuleSystem:ModuleManagement:Labels:EnabledModules"]</MudText>
                                    <MudText Typo="Typo.body2">@($"{GetPercentage(RegistrationInfo.Statistics.EnabledModules, RegistrationInfo.Statistics.TotalModules):F1}%")</MudText>
                                </div>
                                <MudProgressLinear Color="Color.Success" 
                                                 Value="@GetPercentage(RegistrationInfo.Statistics.EnabledModules, RegistrationInfo.Statistics.TotalModules)" 
                                                 Class="mb-2" 
                                                 Size="Size.Medium" />
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.body2">@L["ModuleSystem:ModuleManagement:Labels:DisabledModules"]</MudText>
                                    <MudText Typo="Typo.body2">@($"{GetPercentage(RegistrationInfo.Statistics.DisabledModules, RegistrationInfo.Statistics.TotalModules):F1}%")</MudText>
                                </div>
                                <MudProgressLinear Color="Color.Warning" 
                                                 Value="@GetPercentage(RegistrationInfo.Statistics.DisabledModules, RegistrationInfo.Statistics.TotalModules)" 
                                                 Size="Size.Medium" />
                            </MudPaper>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Module list -->            <MudItem xs="12" md="8" Class="module-management-equal-card">
                <MudCard Class="modern-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.ViewModule" Color="Color.Primary" Class="mr-2" />
                                <MudText Typo="Typo.h6">@L["ModuleSystem:ModuleManagement:ModuleList"]</MudText>
                            </div>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Variant="Variant.Filled"
                                     Color="Color.Primary"
                                     Size="Size.Small"
                                     StartIcon="@Icons.Material.Filled.Refresh"
                                     OnClick="OnRefreshClicked">
                                @L["ModuleSystem:ModuleManagement:Refresh"]
                            </MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <MudDataGrid Items="@GetAllModules()"
                                   SortMode="SortMode.Multiple" 
                                   Filterable="true" 
                                   Hideable="true"
                                   Dense="true"
                                   RowsPerPage="@DefaultPageSize"
                                   T="ModuleBasicInfo"
                                   Style="min-height: 500px;">
                            <Columns>
                                <PropertyColumn Property="x => x.ModuleTypeName" Title="@L["ModuleSystem:ModuleManagement:Labels:ModuleName"]" />
                                <TemplateColumn Title="@L["ModuleSystem:ModuleManagement:Labels:Status"]">
                                    <CellTemplate>
                                        <MudChip T="string" Color="@(context.Item.IsDisabled ? Color.Warning : Color.Success)"
                                               Size="Size.Small"
                                               Icon="@(context.Item.IsDisabled ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)">
                                            @(context.Item.IsDisabled ? L["ModuleSystem:ModuleManagement:States:Disabled"] : L["ModuleSystem:ModuleManagement:States:Enabled"])
                                        </MudChip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["ModuleSystem:ModuleManagement:Labels:HostRequirement"]">
                                    <CellTemplate>
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudChip T="string"
                                                     Color="@GetCapabilityColor(context.Item)"
                                                     Variant="Variant.Outlined"
                                                     Size="Size.Small"
                                                     Icon="@GetCapabilityIcon(context.Item)">
                                                @GetCapabilityLabel(context.Item)
                                            </MudChip>
                                            <MudChip T="string"
                                                     Color="@GetHostRequirementColor(context.Item)"
                                                     Size="Size.Small"
                                                     Variant="@(context.Item.RequiresWebHost ? Variant.Filled : Variant.Outlined)"
                                                     Icon="@GetHostRequirementIcon(context.Item)">
                                                @GetHostRequirementLabel(context.Item)
                                            </MudChip>
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Order" Title="@L["ModuleSystem:ModuleManagement:Labels:Order"]" />
                                <TemplateColumn Title="@L["ModuleSystem:ModuleManagement:Labels:SerialPhaseDuration"]">
                                    <CellTemplate>
                                        <div class="d-flex align-center">
                                            <MudText Typo="Typo.body2" Class="mr-2">@($"{context.Item.SerialPhaseDurationMs}ms")</MudText>
                                            <MudProgressLinear Color="@GetSerialPhaseDurationColor(context.Item.SerialPhaseDurationMs)"
                                                             Value="@GetSerialPhaseDurationPercentage(context.Item.SerialPhaseDurationMs)"
                                                             Style="width: 80px; height: 8px;" />
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["ModuleSystem:ModuleManagement:Labels:Dependencies"]">
                                    <CellTemplate>
                                        <MudBadge Content="@context.Item.Dependencies.Count" 
                                                Color="@(context.Item.Dependencies.Count > 0 ? Color.Info : Color.Default)" 
                                                Overlap="true" 
                                                Bordered="true">
                                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                                        </MudBadge>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["ModuleSystem:ModuleManagement:Labels:Actions"]">
                                    <CellTemplate>
                                        @if (context.Item.ModuleKey.HasValue)
                                        {
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Info"
                                                       OnClick="@(() => OnModuleDetailClicked.InvokeAsync(context.Item.ModuleKey!.Value))">
                                                @L["ModuleSystem:ModuleManagement:Details"]
                                            </MudButton>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="ModuleBasicInfo" PageSizeOptions="PageSizeOptions" />
                            </PagerContent>
                        </MudDataGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudGrid Spacing="4" Class="mb-4">
            <MudItem xs="12" md="4" Class="module-management-equal-card">
                <MudCard Class="modern-card">
                    <MudCardContent Class="pa-4 d-flex align-center justify-center" Style="min-height: 400px;">
                        <div class="text-center">
                            <MudProgressCircular Indeterminate="true" Class="mb-3" />
                            <MudText Color="Color.Secondary">@L["ModuleSystem:ModuleManagement:Loading:Statistics"]</MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="8" Class="module-management-equal-card">
                <MudCard Class="modern-card">
                    <MudCardContent Class="pa-4 d-flex align-center justify-center" Style="min-height: 400px;">
                        <div class="text-center">
                            <MudProgressCircular Indeterminate="true" Class="mb-3" />
                            <MudText Color="Color.Secondary">@L["ModuleSystem:ModuleManagement:Loading:List"]</MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</div>


@code {
    private const int DefaultPageSize = 10;
    private static readonly int[] PageSizeOptions = [10, 20, 50, 100];

    /// <summary>
    /// Module registration information
    /// </summary>
    [Parameter] public ModuleRegistrationOverview? RegistrationInfo { get; set; }

    /// <summary>
    /// Refresh data event
    /// </summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    /// <summary>
    /// View module details events
    /// </summary>
    [Parameter] public EventCallback<ModuleKey> OnModuleDetailClicked { get; set; }

    /// <summary>
    /// Handle refresh button click event
    /// </summary>
    /// <returns></returns>
    private async Task OnRefreshClicked()
    {
        await OnRefresh.InvokeAsync();
    }

    /// <summary>
    /// Get percentage
    /// </summary>
    /// <param name="value">value</param>
    /// <param name="total">Total</param>
    /// <returns>Percentage</returns>
    private double GetPercentage(int value, int total)
    {
        return total > 0 ? (double)value / total * 100 : 0;
    }

    /// <summary>
    /// Gets all modules in the current registration snapshot.
    /// </summary>
    private IEnumerable<ModuleBasicInfo> GetAllModules()
    {
        if (RegistrationInfo == null)
        {
            return [];
        }

        return RegistrationInfo.EnabledModules.Concat(RegistrationInfo.DisabledModules);
    }

    /// <summary>
    /// Gets the count of modules that can participate in the web lifecycle.
    /// </summary>
    private int GetWebModuleCount() => GetAllModules().Count(module => module.IsWebModule);

    /// <summary>
    /// Gets the count of modules that require an ASP.NET Core host adapter.
    /// </summary>
    private int GetWebHostRequiredModuleCount() => GetAllModules().Count(module => module.RequiresWebHost);

    /// <summary>
    /// Gets the color for a serial module phase duration.
    /// </summary>
    /// <param name="timeMs">Time in milliseconds</param>
    /// <returns>Color</returns>
    private Color GetSerialPhaseDurationColor(long timeMs) => timeMs switch
    {
        <= 100 => Color.Success,
        <= 500 => Color.Info,
        <= 1000 => Color.Warning,
        _ => Color.Error
    };

    /// <summary>
    /// Gets the serial module phase duration relative to the slowest module.
    /// </summary>
    /// <param name="timeMs">Time in milliseconds</param>
    /// <returns>Percentage</returns>
    private double GetSerialPhaseDurationPercentage(long timeMs)
    {
        if (RegistrationInfo == null) return 0;
        
        var allModules = GetAllModules();
        var maxTime = allModules.Max(m => m.SerialPhaseDurationMs);
        
        return maxTime > 0 ? (double)timeMs / maxTime * 100 : 0;
    }

    /// <summary>
    /// Gets the capability label for a module.
    /// </summary>
    private string GetCapabilityLabel(ModuleBasicInfo module)
    {
        return module.IsWebModule
            ? L["ModuleSystem:ModuleManagement:States:WebModule"]
            : L["ModuleSystem:ModuleManagement:States:NonWebModule"];
    }

    /// <summary>
    /// Gets the host requirement label for a module.
    /// </summary>
    private string GetHostRequirementLabel(ModuleBasicInfo module)
    {
        if (!module.IsWebModule)
        {
            return L["ModuleSystem:ModuleManagement:States:NoWebHostRequirement"];
        }

        return module.RequiresWebHost
            ? L["ModuleSystem:ModuleManagement:States:WebHostRequired"]
            : L["ModuleSystem:ModuleManagement:States:WebHostOptional"];
    }

    /// <summary>
    /// Gets the capability chip color.
    /// </summary>
    private static Color GetCapabilityColor(ModuleBasicInfo module) => module.IsWebModule ? Color.Info : Color.Default;

    /// <summary>
    /// Gets the host requirement chip color.
    /// </summary>
    private static Color GetHostRequirementColor(ModuleBasicInfo module)
    {
        if (!module.IsWebModule)
        {
            return Color.Secondary;
        }

        return module.RequiresWebHost ? Color.Warning : Color.Success;
    }

    /// <summary>
    /// Gets the capability chip icon.
    /// </summary>
    private static string GetCapabilityIcon(ModuleBasicInfo module) => module.IsWebModule
        ? Icons.Material.Filled.Language
        : Icons.Material.Filled.Memory;

    /// <summary>
    /// Gets the host requirement chip icon.
    /// </summary>
    private static string GetHostRequirementIcon(ModuleBasicInfo module)
    {
        if (!module.IsWebModule)
        {
            return Icons.Material.Filled.Storage;
        }

        return module.RequiresWebHost
            ? Icons.Material.Filled.WebAsset
            : Icons.Material.Filled.CloudDone;
    }
}
