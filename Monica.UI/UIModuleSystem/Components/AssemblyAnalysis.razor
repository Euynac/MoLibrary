@using Microsoft.Extensions.Localization
@using Monica.Core.Module.TypeFinder
@using Monica.UI.Localization
@using MudBlazor
@inject IStringLocalizer<SharedResource> L

<div class="assembly-analysis-container">
    @if (AssemblyAnalysisData is null)
    {
        <MudCard Class="modern-card">
            <MudCardContent Class="loading-state">
                <MudProgressCircular Indeterminate="true" Class="mb-4" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Loading"]</MudText>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4" xl="2">
                <MudCard Class="modern-card summary-card">
                    <MudCardContent Class="pa-4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Summary:EntryAssembly"]</MudText>
                        <MudText Typo="Typo.h6">@GetTextOrUnavailable(AssemblyAnalysisData.EntryAssembly?.Name)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@GetTextOrUnavailable(AssemblyAnalysisData.EntryAssembly?.Version)</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" xl="2">
                <MudCard Class="modern-card summary-card">
                    <MudCardContent Class="pa-4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Summary:ScanAssemblies"]</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">@AssemblyAnalysisData.ScanAssemblies.Count</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Summary:AssembliesReadyForScanning"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" xl="2">
                <MudCard Class="modern-card summary-card">
                    <MudCardContent Class="pa-4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Summary:LoadedAssemblies"]</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Info">@AssemblyAnalysisData.LoadedAssemblies.Count</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Summary:AssembliesInCurrentDomain"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="6" xl="3">
                <MudCard Class="modern-card summary-card">
                    <MudCardContent Class="pa-4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Summary:DependencyLibraries"]</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Success">@AssemblyAnalysisData.DependencyLibraries.Count</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Format(L["ModuleSystem:AssemblyAnalysis:Summary:ProjectLibraries"], AssemblyAnalysisData.DependencyLibraries.Count(item => item.IsProject))</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="6" xl="3">
                <MudCard Class="modern-card summary-card">
                    <MudCardContent Class="pa-4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Summary:MissingRuntimeDlls"]</MudText>
                        <MudText Typo="Typo.h4" Color="@GetMissingDllColor(GetMissingDllCount())">@GetMissingDllCount()</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Summary:MissingDllHint"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudCard Class="modern-card detail-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            @RenderSectionTitle(Icons.Material.Filled.Tune, L["ModuleSystem:AssemblyAnalysis:Configuration:Title"], L["ModuleSystem:AssemblyAnalysis:Help:Configuration"])
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="2">
                            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                                @string.Format(L["ModuleSystem:AssemblyAnalysis:Configuration:GeneratedAt"], AssemblyAnalysisData.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))
                            </MudAlert>

                            <div class="info-group">
                                <MudText Typo="Typo.subtitle2">@L["ModuleSystem:AssemblyAnalysis:Configuration:DefaultProjectAssemblies"]</MudText>
                                <MudChip T="string" Color="@(AssemblyAnalysisData.Configuration.UseDefaultProjectAssemblies ? Color.Success : Color.Warning)" Variant="Variant.Filled" Size="Size.Small">
                                    @(AssemblyAnalysisData.Configuration.UseDefaultProjectAssemblies ? L["ModuleSystem:AssemblyAnalysis:States:Enabled"] : L["ModuleSystem:AssemblyAnalysis:States:Disabled"])
                                </MudChip>
                            </div>

                            <div class="info-group">
                                <MudText Typo="Typo.subtitle2">@L["ModuleSystem:AssemblyAnalysis:Configuration:AddPatterns"]</MudText>
                                @if (AssemblyAnalysisData.Configuration.AddPatterns.Count > 0)
                                {
                                    <div class="chip-list">
                                        @foreach (var pattern in AssemblyAnalysisData.Configuration.AddPatterns)
                                        {
                                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@pattern</MudChip>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Configuration:NoAddPatterns"]</MudText>
                                }
                            </div>

                            <div class="info-group">
                                <MudText Typo="Typo.subtitle2">@L["ModuleSystem:AssemblyAnalysis:Configuration:ExcludePatterns"]</MudText>
                                @if (AssemblyAnalysisData.Configuration.ExcludePatterns.Count > 0)
                                {
                                    <div class="chip-list">
                                        @foreach (var pattern in AssemblyAnalysisData.Configuration.ExcludePatterns)
                                        {
                                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">@pattern</MudChip>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:AssemblyAnalysis:Configuration:NoExcludePatterns"]</MudText>
                                }
                            </div>

                            <div class="info-group">
                                <MudText Typo="Typo.subtitle2">@L["ModuleSystem:AssemblyAnalysis:Configuration:ManualAssemblies"]</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@string.Format(L["ModuleSystem:AssemblyAnalysis:Configuration:ManualAssemblyCount"], AssemblyAnalysisData.ManuallyAddedAssemblies.Count)</MudText>
                            </div>

                            <div class="info-group">
                                <MudText Typo="Typo.subtitle2">@L["ModuleSystem:AssemblyAnalysis:Configuration:EntryAssemblyLocation"]</MudText>
                                <MudText Typo="Typo.body2" Class="value-text">@GetTextOrUnavailable(AssemblyAnalysisData.EntryAssembly?.Location)</MudText>
                            </div>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="8">
                <MudCard Class="modern-card detail-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            @RenderSectionTitle(Icons.Material.Filled.Rule, L["ModuleSystem:AssemblyAnalysis:PatternEffects:Title"], L["ModuleSystem:AssemblyAnalysis:Help:PatternEffects"])
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-4 pattern-content">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["ModuleSystem:AssemblyAnalysis:PatternEffects:AddPatterns"]</MudText>
                                @if (AssemblyAnalysisData.AddPatternMatches.Count > 0)
                                {
                                    <MudTable T="TypeFinderPatternMatchInfo" Items="AssemblyAnalysisData.AddPatternMatches" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="@DefaultTableRowsPerPage">
                                        <HeaderContent>
                                            <MudTh>@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Pattern"]</MudTh>
                                            <MudTh>@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Matches"]</MudTh>
                                            <MudTh>@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Affected"]</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Pattern"]">@context.Pattern</MudTd>
                                            <MudTd DataLabel="@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Matches"]" Class="value-text">@JoinOrNone(context.MatchedAssemblyNames)</MudTd>
                                            <MudTd DataLabel="@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Affected"]" Class="value-text">@JoinOrNone(context.AffectedAssemblyNames)</MudTd>
                                        </RowTemplate>
                                        <PagerContent>
                                            <MudTablePager PageSizeOptions="@TablePageSizeOptions" />
                                        </PagerContent>
                                    </MudTable>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">@L["ModuleSystem:AssemblyAnalysis:PatternEffects:NoAddPatternEffects"]</MudAlert>
                                }
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["ModuleSystem:AssemblyAnalysis:PatternEffects:ExcludePatterns"]</MudText>
                                @if (AssemblyAnalysisData.ExcludePatternMatches.Count > 0)
                                {
                                    <MudTable T="TypeFinderPatternMatchInfo" Items="AssemblyAnalysisData.ExcludePatternMatches" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="@DefaultTableRowsPerPage">
                                        <HeaderContent>
                                            <MudTh>@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Pattern"]</MudTh>
                                            <MudTh>@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Matches"]</MudTh>
                                            <MudTh>@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Affected"]</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Pattern"]">@context.Pattern</MudTd>
                                            <MudTd DataLabel="@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Matches"]" Class="value-text">@JoinOrNone(context.MatchedAssemblyNames)</MudTd>
                                            <MudTd DataLabel="@L["ModuleSystem:AssemblyAnalysis:PatternEffects:Affected"]" Class="value-text">@JoinOrNone(context.AffectedAssemblyNames)</MudTd>
                                        </RowTemplate>
                                        <PagerContent>
                                            <MudTablePager PageSizeOptions="@TablePageSizeOptions" />
                                        </PagerContent>
                                    </MudTable>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">@L["ModuleSystem:AssemblyAnalysis:PatternEffects:NoExcludePatternEffects"]</MudAlert>
                                }
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12">
                <MudCard Class="modern-card detail-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            @RenderSectionTitle(Icons.Material.Filled.Search, L["ModuleSystem:AssemblyAnalysis:ScanAssemblies:Title"], L["ModuleSystem:AssemblyAnalysis:Help:ScanAssemblies"])
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="grid-card-content">
                        <MudDataGrid T="TypeFinderAssemblyInfo" Items="AssemblyAnalysisData.ScanAssemblies" Dense="true" Filterable="true" Hideable="true">
                            <Columns>
                                <TemplateColumn T="TypeFinderAssemblyInfo"
                                                Title="@L["ModuleSystem:AssemblyAnalysis:Columns:AssemblyName"]"
                                                Sortable="true"
                                                SortBy="@(x => x.Name)">
                                    <CellTemplate>
                                        @RenderAssemblyNameCell(context.Item.Name, GetScanAssemblyStatusIcons(context.Item))
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Version" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:Version"]" />
                                <PropertyColumn Property="x => x.Location" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:Location"]" />
                                <PropertyColumn Property="x => x.LoadError" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:LoadError"]" />
                            </Columns>
                        </MudDataGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12">
                <MudCard Class="modern-card detail-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            @RenderSectionTitle(Icons.Material.Filled.Inventory2, L["ModuleSystem:AssemblyAnalysis:ManualAssemblies:Title"], L["ModuleSystem:AssemblyAnalysis:Help:ManualAssemblies"])
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="grid-card-content">
                        @if (AssemblyAnalysisData.ManuallyAddedAssemblies.Count > 0)
                        {
                            <MudDataGrid T="TypeFinderConfiguredAssemblyInfo" Items="AssemblyAnalysisData.ManuallyAddedAssemblies" Dense="true" Filterable="true" Hideable="true">
                                <Columns>
                                    <PropertyColumn Property="x => x.Name" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:AssemblyName"]" />
                                    <PropertyColumn Property="x => x.FullName" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:FullName"]" />
                                    <PropertyColumn Property="x => x.Location" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:Location"]" />
                                    <TemplateColumn T="TypeFinderConfiguredAssemblyInfo" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:ScanStatus"]">
                                        <CellTemplate>
                                            <MudChip T="string" Color="@(context.Item.IsInScanSet ? Color.Success : Color.Default)" Size="Size.Small">
                                                @(context.Item.IsInScanSet ? L["ModuleSystem:AssemblyAnalysis:States:InScanSet"] : L["ModuleSystem:AssemblyAnalysis:States:NotInScanSet"])
                                            </MudChip>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        }
                        else
                        {
                            <div class="empty-state">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                                <MudText Typo="Typo.body2">@L["ModuleSystem:AssemblyAnalysis:ManualAssemblies:Empty"]</MudText>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12">
                <MudCard Class="modern-card detail-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            @RenderSectionTitle(Icons.Material.Filled.Memory, L["ModuleSystem:AssemblyAnalysis:LoadedAssemblies:Title"], L["ModuleSystem:AssemblyAnalysis:Help:LoadedAssemblies"])
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="grid-card-content">
                        <MudDataGrid T="TypeFinderAssemblyInfo" Items="AssemblyAnalysisData.LoadedAssemblies" Dense="true" Filterable="true" Hideable="true" RowsPerPage="@DefaultGridRowsPerPage">
                            <Columns>
                                <TemplateColumn T="TypeFinderAssemblyInfo"
                                                Title="@L["ModuleSystem:AssemblyAnalysis:Columns:AssemblyName"]"
                                                Sortable="true"
                                                SortBy="@(x => x.Name)">
                                    <CellTemplate>
                                        @RenderAssemblyNameCell(context.Item.Name, GetLoadedAssemblyStatusIcons(context.Item))
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Version" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:Version"]" />
                                <PropertyColumn Property="x => x.Location" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:Location"]" />
                                <PropertyColumn Property="x => x.LoadError" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:LoadError"]" />
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="TypeFinderAssemblyInfo" PageSizeOptions="@GridPageSizeOptions" />
                            </PagerContent>
                        </MudDataGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12">
                <MudCard Class="modern-card detail-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            @RenderSectionTitle(Icons.Material.Filled.Link, L["ModuleSystem:AssemblyAnalysis:ReferencedAssemblies:Title"], L["ModuleSystem:AssemblyAnalysis:Help:ReferencedAssemblies"])
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="grid-card-content">
                        <MudDataGrid T="TypeFinderReferencedAssemblyInfo" Items="AssemblyAnalysisData.ReferencedAssemblies" Dense="true" Filterable="true" Hideable="true" RowsPerPage="@DefaultGridRowsPerPage">
                            <Columns>
                                <TemplateColumn T="TypeFinderReferencedAssemblyInfo"
                                                Title="@L["ModuleSystem:AssemblyAnalysis:Columns:AssemblyName"]"
                                                Sortable="true"
                                                SortBy="@(x => x.Name)">
                                    <CellTemplate>
                                        @RenderAssemblyNameCell(context.Item.Name, GetReferencedAssemblyStatusIcons(context.Item))
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Version" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:Version"]" />
                                <PropertyColumn Property="x => x.FullName" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:FullName"]" />
                                <PropertyColumn Property="x => x.LoadError" Title="@L["ModuleSystem:AssemblyAnalysis:Columns:LoadError"]" />
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="TypeFinderReferencedAssemblyInfo" PageSizeOptions="@GridPageSizeOptions" />
                            </PagerContent>
                        </MudDataGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12">
                <MudCard Class="modern-card detail-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            @RenderSectionTitle(Icons.Material.Filled.LibraryBooks, L["ModuleSystem:AssemblyAnalysis:DependencyLibraries:Title"], L["ModuleSystem:AssemblyAnalysis:Help:DependencyLibraries"])
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="grid-card-content">
                        <MudDataGrid T="TypeFinderDependencyLibraryInfo" Items="AssemblyAnalysisData.DependencyLibraries" Dense="true" Filterable="true" Hideable="true" RowsPerPage="@DefaultGridRowsPerPage">
                            <Columns>
                                <PropertyColumn Property="x => x.LibraryName"
                                                Title="@L["ModuleSystem:AssemblyAnalysis:Columns:LibraryName"]"
                                                HeaderClass="dependency-library-name-column"
                                                CellClass="dependency-library-name-column" />
                                <PropertyColumn Property="x => x.LibraryType"
                                                Title="@L["ModuleSystem:AssemblyAnalysis:Columns:LibraryType"]"
                                                HeaderClass="dependency-library-type-column"
                                                CellClass="dependency-library-type-column" />
                                <TemplateColumn T="TypeFinderDependencyLibraryInfo"
                                                Title="@L["ModuleSystem:AssemblyAnalysis:Columns:AssemblyName"]"
                                                Sortable="true"
                                                SortBy="@(x => x.AssemblyName)"
                                                HeaderClass="dependency-assembly-name-column"
                                                CellClass="dependency-assembly-name-column">
                                    <CellTemplate>
                                        @RenderAssemblyNameCell(context.Item.AssemblyName, GetDependencyLibraryStatusIcons(context.Item))
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn T="TypeFinderDependencyLibraryInfo"
                                                Title="@L["ModuleSystem:AssemblyAnalysis:Columns:Version"]"
                                                Sortable="true"
                                                SortBy="@(x => x.AssemblyVersion)"
                                                HeaderClass="dependency-version-column"
                                                CellClass="dependency-version-column">
                                    <CellTemplate>
                                        @GetTextOrUnavailable(context.Item.AssemblyVersion)
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn T="TypeFinderDependencyLibraryInfo"
                                                Title="@L["ModuleSystem:AssemblyAnalysis:Columns:RuntimeDllPath"]"
                                                Sortable="true"
                                                SortBy="@(x => x.RuntimeDllPath)"
                                                HeaderClass="dependency-runtime-path-column"
                                                CellClass="dependency-runtime-path-column">
                                    <CellTemplate>
                                        @RenderRuntimeDllPathCell(context.Item)
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.LoadError"
                                                Title="@L["ModuleSystem:AssemblyAnalysis:Columns:LoadError"]"
                                                HeaderClass="dependency-load-error-column"
                                                CellClass="dependency-load-error-column" />
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="TypeFinderDependencyLibraryInfo" PageSizeOptions="@GridPageSizeOptions" />
                            </PagerContent>
                        </MudDataGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</div>

@code {
    private const int DefaultGridRowsPerPage = 10;
    private const int DefaultTableRowsPerPage = 5;
    private static readonly int[] GridPageSizeOptions = new[] { 10, 25, 50 };
    private static readonly int[] TablePageSizeOptions = new[] { 5, 10, 25 };

    [Parameter] public TypeFinderAssemblyAnalysis? AssemblyAnalysisData { get; set; }

    private string JoinOrNone(IReadOnlyCollection<string> values)
    {
        return values.Count > 0
            ? string.Join(", ", values)
            : L["ModuleSystem:AssemblyAnalysis:Common:None"];
    }

    private string GetTextOrUnavailable(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? L["ModuleSystem:AssemblyAnalysis:Common:Unavailable"]
            : value;
    }

    private IReadOnlyList<StatusIcon> GetScanAssemblyStatusIcons(TypeFinderAssemblyInfo assembly)
    {
        var statusIcons = new List<StatusIcon>(2);

        if (assembly.IsEntryAssembly)
        {
            statusIcons.Add(CreateEntryAssemblyStatusIcon());
        }

        if (!string.IsNullOrWhiteSpace(assembly.LoadError))
        {
            statusIcons.Add(CreateLoadErrorStatusIcon(assembly.LoadError));
        }

        return statusIcons;
    }

    private IReadOnlyList<StatusIcon> GetLoadedAssemblyStatusIcons(TypeFinderAssemblyInfo assembly)
    {
        var statusIcons = new List<StatusIcon>(2);

        if (assembly.IsDynamic)
        {
            statusIcons.Add(CreateDynamicAssemblyStatusIcon());
        }

        if (assembly.IsInScanSet)
        {
            statusIcons.Add(CreateInScanSetStatusIcon());
        }

        if (!string.IsNullOrWhiteSpace(assembly.LoadError))
        {
            statusIcons.Add(CreateLoadErrorStatusIcon(assembly.LoadError));
        }

        return statusIcons;
    }

    private IReadOnlyList<StatusIcon> GetReferencedAssemblyStatusIcons(TypeFinderReferencedAssemblyInfo assembly)
    {
        var statusIcons = new List<StatusIcon>(2);

        if (!assembly.IsLoaded)
        {
            statusIcons.Add(CreateNotLoadedStatusIcon());
        }

        if (assembly.IsInScanSet)
        {
            statusIcons.Add(CreateInScanSetStatusIcon());
        }

        if (!string.IsNullOrWhiteSpace(assembly.LoadError))
        {
            statusIcons.Add(CreateLoadErrorStatusIcon(assembly.LoadError));
        }

        return statusIcons;
    }

    private IReadOnlyList<StatusIcon> GetDependencyLibraryStatusIcons(TypeFinderDependencyLibraryInfo library)
    {
        var statusIcons = new List<StatusIcon>(2);

        statusIcons.Add(library.IsLoaded ? CreateLoadedStatusIcon() : CreateNotLoadedStatusIcon());

        if (library.IsInScanSet)
        {
            statusIcons.Add(CreateInScanSetStatusIcon());
        }

        if (!string.IsNullOrWhiteSpace(library.LoadError))
        {
            statusIcons.Add(CreateLoadErrorStatusIcon(library.LoadError));
        }

        return statusIcons;
    }

    private int GetMissingDllCount()
    {
        return AssemblyAnalysisData?.DependencyLibraries.Count(item => !item.RuntimeDllExists) ?? 0;
    }

    private Color GetMissingDllColor(int missingDllCount)
    {
        return missingDllCount > 0 ? Color.Error : Color.Success;
    }

    private RenderFragment RenderSectionTitle(string icon, string title, string helpText) => @<div class="section-title">
        <MudIcon Icon="@icon" Color="Color.Primary" />
        <span class="section-title-text">
            <MudText Typo="Typo.h6">@title</MudText>
        </span>
        <MudTooltip Text="@helpText" Placement="Placement.Right">
            <span class="section-help-icon" tabindex="0">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
            </span>
        </MudTooltip>
    </div>;

    private RenderFragment RenderAssemblyNameCell(string? name, IReadOnlyList<StatusIcon> statusIcons)
    {
        var displayName = GetTextOrUnavailable(name);

        return @<div class="assembly-name-cell">
            <span class="assembly-name-text" title="@displayName" aria-label="@displayName">@displayName</span>
            @if (statusIcons.Count > 0)
            {
                <div class="inline-status-icon-list">
                    @foreach (var statusIcon in statusIcons)
                    {
                        <MudTooltip Text="@statusIcon.Text" Placement="Placement.Top">
                            <span class="status-icon-trigger" tabindex="0" aria-label="@statusIcon.Text">
                                <MudIcon Icon="@statusIcon.Icon" Color="@statusIcon.Color" Size="Size.Small" />
                            </span>
                        </MudTooltip>
                    }
                </div>
            }
        </div>;
    }

    private RenderFragment RenderRuntimeDllPathCell(TypeFinderDependencyLibraryInfo library)
    {
        var displayPath = GetTextOrUnavailable(library.RuntimeDllPath);
        var runtimeIcon = library.RuntimeDllExists
            ? new StatusIcon(
                $"{L["ModuleSystem:AssemblyAnalysis:Columns:RuntimeDll"]}: {L["ModuleSystem:AssemblyAnalysis:States:Exists"]}",
                Icons.Material.Filled.InsertDriveFile,
                Color.Success)
            : new StatusIcon(
                $"{L["ModuleSystem:AssemblyAnalysis:Columns:RuntimeDll"]}: {L["ModuleSystem:AssemblyAnalysis:States:Missing"]}",
                Icons.Material.Filled.HideSource,
                Color.Error);

        return @<div class="status-text-cell">
            <MudTooltip Text="@runtimeIcon.Text" Placement="Placement.Top">
                <span class="status-icon-trigger" tabindex="0" aria-label="@runtimeIcon.Text">
                    <MudIcon Icon="@runtimeIcon.Icon" Color="@runtimeIcon.Color" Size="Size.Small" />
                </span>
            </MudTooltip>
            <span class="status-text-value" title="@displayPath" aria-label="@displayPath">@displayPath</span>
        </div>;
    }

    private StatusIcon CreateEntryAssemblyStatusIcon()
    {
        return new StatusIcon(L["ModuleSystem:AssemblyAnalysis:States:EntryAssembly"], Icons.Material.Filled.Adjust, Color.Primary);
    }

    private StatusIcon CreateDynamicAssemblyStatusIcon()
    {
        return new StatusIcon(L["ModuleSystem:AssemblyAnalysis:States:Dynamic"], Icons.Material.Filled.DynamicFeed, Color.Warning);
    }

    private StatusIcon CreateInScanSetStatusIcon()
    {
        return new StatusIcon(L["ModuleSystem:AssemblyAnalysis:States:InScanSet"], Icons.Material.Filled.CheckCircle, Color.Success);
    }

    private StatusIcon CreateLoadedStatusIcon()
    {
        return new StatusIcon(L["ModuleSystem:AssemblyAnalysis:States:Loaded"], Icons.Material.Filled.Memory, Color.Info);
    }

    private StatusIcon CreateNotLoadedStatusIcon()
    {
        return new StatusIcon(L["ModuleSystem:AssemblyAnalysis:States:NotLoaded"], Icons.Material.Filled.RemoveCircle, Color.Default);
    }

    private StatusIcon CreateLoadErrorStatusIcon(string loadError)
    {
        return new StatusIcon(
            $"{L["ModuleSystem:AssemblyAnalysis:Columns:LoadError"]}: {loadError}",
            Icons.Material.Filled.WarningAmber,
            Color.Warning);
    }

    private sealed record StatusIcon(string Text, string Icon, Color Color);
}
