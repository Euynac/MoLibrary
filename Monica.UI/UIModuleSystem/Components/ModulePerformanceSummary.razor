@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<SharedResource> L

<section class="performance-summary" aria-labelledby="performance-summary-title">
    <header class="performance-summary__header">
        <div>
            <MudText id="performance-summary-title" Typo="Typo.h5">@L["ModuleSystem:PerformanceMonitoring:Labels:DiagnosticsTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:DiagnosticsDescription"]</MudText>
        </div>
        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.AccountTree">
            @L["ModuleSystem:PerformanceMonitoring:Messages:WorkItemCount", Summary.WorkItemCount]
        </MudChip>
    </header>

    <div class="performance-summary__breakdowns">
        <article class="performance-summary__breakdown performance-summary__breakdown--initialization">
            @BreakdownHeader(
                Icons.Material.Filled.Timer,
                L["ModuleSystem:PerformanceMonitoring:Labels:ModuleSystemInitializationElapsed"],
                Summary.Initialization.TotalDurationMs)
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["ModuleSystem:PerformanceMonitoring:Messages:InitializationBreakdownDescription"]
            </MudText>
            <div class="performance-summary__breakdown-rows">
                @BreakdownRow(
                    "performance-summary__breakdown-row--primary",
                    L["ModuleSystem:PerformanceMonitoring:Labels:MonicaFrameworkElapsed"],
                    Summary.Initialization.MonicaFrameworkDurationMs,
                    Summary.Initialization.MonicaFrameworkPercentage,
                    Color.Primary)
                @BreakdownRow(
                    "performance-summary__breakdown-row--info",
                    L["ModuleSystem:PerformanceMonitoring:Labels:ApplicationConfigurationElapsed"],
                    Summary.Initialization.ApplicationConfigurationDurationMs,
                    Summary.Initialization.ApplicationConfigurationPercentage,
                    Color.Info)
                @BreakdownRow(
                    "performance-summary__breakdown-row--warning",
                    L["ModuleSystem:PerformanceMonitoring:Labels:HostOwnedElapsed"],
                    Summary.Initialization.HostOwnedDurationMs,
                    Summary.Initialization.HostOwnedPercentage,
                    Color.Warning)
            </div>
        </article>

        <article class="performance-summary__breakdown performance-summary__breakdown--registration">
            @BreakdownHeader(
                Icons.Material.Filled.AppRegistration,
                L["ModuleSystem:PerformanceMonitoring:Labels:ServiceRegistrationElapsed"],
                Summary.ServiceRegistration.TotalDurationMs)
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["ModuleSystem:PerformanceMonitoring:Messages:ServiceRegistrationBreakdownDescription"]
            </MudText>
            <div class="performance-summary__breakdown-rows">
                @BreakdownRow(
                    "performance-summary__breakdown-row--primary",
                    L["ModuleSystem:PerformanceMonitoring:Labels:ApplicationConfigurationElapsed"],
                    Summary.ServiceRegistration.ApplicationConfigurationDurationMs,
                    Summary.ServiceRegistration.ApplicationConfigurationPercentage,
                    Color.Primary)
                @BreakdownRow(
                    "performance-summary__breakdown-row--info",
                    L["ModuleSystem:PerformanceMonitoring:Labels:SerialModuleCallbacks"],
                    Summary.ServiceRegistration.SerialModuleCallbackDurationMs,
                    Summary.ServiceRegistration.SerialModuleCallbackPercentage,
                    Color.Info,
                    L["ModuleSystem:PerformanceMonitoring:Messages:SerialCallbackCount", Summary.ServiceRegistrationCallbackCount])
                @BreakdownRow(
                    "performance-summary__breakdown-row--warning",
                    L["ModuleSystem:PerformanceMonitoring:Labels:BlockingBarrierWait"],
                    Summary.ServiceRegistration.BlockingWaitDurationMs,
                    Summary.ServiceRegistration.BlockingWaitPercentage,
                    Color.Warning)
                @BreakdownRow(
                    "performance-summary__breakdown-row--secondary",
                    L["ModuleSystem:PerformanceMonitoring:Labels:MonicaOrchestration"],
                    Summary.ServiceRegistration.OrchestrationDurationMs,
                    Summary.ServiceRegistration.OrchestrationPercentage,
                    Color.Secondary)
            </div>
        </article>
    </div>

    <section class="performance-summary__parallel" aria-labelledby="performance-summary-parallel-title">
        <header>
            <div>
                <MudText id="performance-summary-parallel-title" Typo="Typo.h6">@L["ModuleSystem:PerformanceMonitoring:Labels:ParallelActivity"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ModuleSystem:PerformanceMonitoring:Messages:ParallelActivityDescription"]</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.Schema" Color="Color.Success" />
        </header>

        <div class="performance-summary__parallel-metrics">
            @ParallelMetric(
                "performance-summary__parallel-metric--success",
                L["ModuleSystem:PerformanceMonitoring:Labels:ParallelWorkActiveSpan"],
                Summary.ParallelActivity.ActiveSpanMs)
            @ParallelMetric(
                "performance-summary__parallel-metric--info",
                L["ModuleSystem:PerformanceMonitoring:Labels:AggregateWorkerExecution"],
                Summary.ParallelActivity.AggregateExecutionMs)
            @ParallelMetric(
                "performance-summary__parallel-metric--secondary",
                L["ModuleSystem:PerformanceMonitoring:Labels:AggregateWorkerQueue"],
                Summary.ParallelActivity.AggregateQueueMs)
        </div>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            @L["ModuleSystem:PerformanceMonitoring:Messages:ParallelMetricsOverlap"]
        </MudAlert>
    </section>
</section>

@code {
    [Parameter, EditorRequired]
    public ModulePerformanceSummaryView Summary { get; set; } = default!;

    private RenderFragment BreakdownHeader(string icon, string label, double durationMs) => @<header class="performance-summary__breakdown-header">
        <span class="performance-summary__breakdown-icon">
            <MudIcon Icon="@icon" Size="Size.Large" />
        </span>
        <span>
            <small>@label</small>
            <strong>@ModulePerformanceDisplayText.Duration(L, durationMs)</strong>
        </span>
    </header>;

    private RenderFragment BreakdownRow(
        string modifier,
        string label,
        double durationMs,
        double percentage,
        Color color,
        string? detail = null) => @<div class="performance-summary__breakdown-row @modifier">
        <div class="performance-summary__breakdown-label">
            <span>@label</span>
            <strong>@ModulePerformanceDisplayText.Duration(L, durationMs)</strong>
        </div>
        <div class="performance-summary__bar">
            <MudProgressLinear Value="@percentage" Color="@color" Size="Size.Medium" />
            <span>@ModulePerformanceDisplayText.Percentage(L, percentage)</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(detail))
        {
            <small>@detail</small>
        }
    </div>;

    private RenderFragment ParallelMetric(string modifier, string label, double durationMs) => @<article class="performance-summary__parallel-metric @modifier">
        <small>@label</small>
        <strong>@ModulePerformanceDisplayText.Duration(L, durationMs)</strong>
    </article>;
}
