@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@inject IStringLocalizer<SharedResource> L

<MudItem xs="12">
    <MudCard Class="modern-card">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Color="Color.Primary" Class="mr-2" />
                    <MudText Typo="Typo.h6">@L["ModuleSystem:DependencyGraph:Labels:DependencyGraph"]</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="HandleExportGraphAsync">
                    @L["ModuleSystem:DependencyGraph:Labels:ExportImage"]
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent Class="pa-0">
            <div class="dependency-graph-host"
                 @onclick="HandleBackgroundClickAsync"
                 @oncontextmenu:preventDefault="true">
                <MudPaper id="dependency-graph-container"
                          Class="dependency-graph-canvas"
                          Style="height: 600px; width: 100%;"
                          Elevation="2">
                </MudPaper>
            </div>
        </MudCardContent>
    </MudCard>
</MudItem>

@code {
    [Parameter]
    public EventCallback OnBackgroundClick { get; set; }

    [Parameter]
    public EventCallback OnExportGraph { get; set; }

    private Task HandleBackgroundClickAsync()
    {
        return OnBackgroundClick.InvokeAsync();
    }

    private Task HandleExportGraphAsync()
    {
        return OnExportGraph.InvokeAsync();
    }
}
