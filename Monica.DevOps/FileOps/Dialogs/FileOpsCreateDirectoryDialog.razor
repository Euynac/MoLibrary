@using Monica.DevOps.Localization
@using Monica.DevOps.FileOps.Models
@inject IStringLocalizer<FileOpsResource> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField T="string"
                          Label="@L["CreateDirectoryDialog:CurrentPath"]"
                          Value="@ParentPath"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="true" />

            <MudTextField T="string"
                          Label="@L["CreateDirectoryDialog:DirectoryName"]"
                          HelperText="@L["CreateDirectoryDialog:DirectoryNameHelper"]"
                          @bind-Value="_directoryName"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">
            @L["Common:Cancel"]
        </MudButton>
        <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="Color.Primary">
            @L["CreateDirectoryDialog:Confirm"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public string ParentPath { get; set; } = string.Empty;

    private string _directoryName = string.Empty;

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private void Confirm()
    {
        MudDialog?.Close(DialogResult.Ok(new FileOpsCreateDirectoryRequest
        {
            ParentPath = ParentPath,
            DirectoryName = _directoryName
        }));
    }
}
