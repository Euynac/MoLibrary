@attribute [Route(PAGE_URL)]
@using Monica.DevOps.Git.Models

<PageTitle>@L["GitDashboard:PageTitle"]</PageTitle>

<div class="git-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="git-page__container">
        <div class="git-page__content">
            <header class="git-header">
                <div class="git-header__eyebrow"><span aria-hidden="true"></span><span>@L["GitDashboard:Eyebrow"]</span></div>
                <div class="git-header__heading-row">
                    <div>
                        <MudText Typo="Typo.h3" HtmlTag="h1">@L["GitDashboard:Title"]</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="git-header__description">@L["GitDashboard:Description"]</MudText>
                    </div>
                    <div class="git-header__actions">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="@_isLoading">@L["GitDashboard:Actions:Refresh"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" OnClick="SyncAllAsync" Disabled="@(IsBusy || _repositories.Count == 0)">@L["GitDashboard:Actions:SyncAll"]</MudButton>
                    </div>
                </div>
            </header>

            <section class="git-pulse" aria-label="@L["GitDashboard:Summary:AriaLabel"]">
                <article class="git-pulse__item git-pulse__item--primary"><MudIcon Icon="@Icons.Material.Filled.AccountTree" /><span><small>@L["GitDashboard:Summary:Repositories"]</small><strong>@_repositories.Count</strong></span></article>
                <article class="git-pulse__item git-pulse__item--success"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /><span><small>@L["GitDashboard:Summary:Ready"]</small><strong>@_repositories.Count(repository => repository.State == GitRepositorySyncState.Ready)</strong></span></article>
                <article class="git-pulse__item git-pulse__item--warning"><MudIcon Icon="@Icons.Material.Filled.EditNote" /><span><small>@L["GitDashboard:Summary:Dirty"]</small><strong>@_repositories.Count(repository => repository.IsDirty)</strong></span></article>
                <article class="git-pulse__item git-pulse__item--info"><MudIcon Icon="@Icons.Material.Filled.Key" /><span><small>@L["GitDashboard:Summary:Credentials"]</small><strong>@_credentials.Count</strong></span></article>
            </section>

            @if (OwnershipFailureRepository is { } ownershipFailure)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="git-ownership-alert">
                    <MudText Typo="Typo.subtitle2">@L["GitDashboard:Ownership:Title", ownershipFailure.Id]</MudText>
                    <MudText Typo="Typo.body2">@L["GitDashboard:Ownership:Description", ownershipFailure.ResolvedLocalPath]</MudText>
                    <MudText Typo="Typo.caption">@ownershipFailure.LastError</MudText>
                </MudAlert>
            }

            <div class="git-primary-layout">
                <section class="git-surface git-surface--repositories">
                    <MudPaper Elevation="0" Outlined="true">
                        <div class="git-section-heading"><span class="git-section-heading__icon git-section-heading__icon--primary"><MudIcon Icon="@Icons.Material.Filled.Source" /></span><span><MudText Typo="Typo.h6">@L["GitDashboard:Sections:Repositories"]</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@L["GitDashboard:Sections:RepositoriesDescription"]</MudText></span></div>
                        <div class="git-table">
                            <MudTable T="GitRepositoryStatus" Items="@_repositories" Dense="true" Hover="true" Loading="@IsBusy" Elevation="0">
                                <HeaderContent>
                                    <MudTh>@L["GitDashboard:Columns:Id"]</MudTh><MudTh>@L["GitDashboard:Columns:Provider"]</MudTh><MudTh>@L["GitDashboard:Columns:Branch"]</MudTh><MudTh>@L["GitDashboard:Columns:State"]</MudTh><MudTh>@L["GitDashboard:Columns:Commit"]</MudTh><MudTh>@L["GitDashboard:Columns:Size"]</MudTh><MudTh>@L["GitDashboard:Columns:Updated"]</MudTh><MudTh>@L["GitDashboard:Columns:Actions"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@(L["GitDashboard:Columns:Id"])"><strong>@context.Id</strong></MudTd>
                                    <MudTd DataLabel="@(L["GitDashboard:Columns:Provider"])">@GetDisplay(context.Provider)</MudTd>
                                    <MudTd DataLabel="@(L["GitDashboard:Columns:Branch"])">@GetDisplay(context.ResolvedBranch ?? context.ConfiguredBranch)</MudTd>
                                    <MudTd DataLabel="@(L["GitDashboard:Columns:State"])">
                                        <MudChip T="string" Color="@GetStateColor(context.State)" Variant="Variant.Outlined" Size="Size.Small">@GetStateText(context.State)</MudChip>
                                        @if (context.State == GitRepositorySyncState.Syncing) { <MudProgressLinear Color="Color.Info" Indeterminate="@IsProgressIndeterminate(context)" Value="@GetProgressValue(context)" /><MudText Typo="Typo.caption">@GetProgressText(context)</MudText> }
                                    </MudTd>
                                    <MudTd DataLabel="@(L["GitDashboard:Columns:Commit"])"><code>@ShortSha(context.CurrentCommit)</code></MudTd>
                                    <MudTd DataLabel="@(L["GitDashboard:Columns:Size"])">@FormatBytes(context.WorkingDirectorySizeBytes)</MudTd>
                                    <MudTd DataLabel="@(L["GitDashboard:Columns:Updated"])">@FormatDate(context.LastSyncAtUtc)</MudTd>
                                    <MudTd DataLabel="@(L["GitDashboard:Columns:Actions"])"><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SelectRepository(context.Id))">@L["GitDashboard:Actions:Select"]</MudButton></MudTd>
                                </RowTemplate>
                                <NoRecordsContent><MudText Typo="Typo.body2">@L["GitDashboard:Messages:NoRepositories"]</MudText></NoRecordsContent>
                            </MudTable>
                        </div>
                    </MudPaper>
                </section>

                <aside class="git-surface git-surface--details">
                    <MudPaper Elevation="0" Outlined="true">
                        <div class="git-section-heading"><span class="git-section-heading__icon git-section-heading__icon--info"><MudIcon Icon="@Icons.Material.Filled.FactCheck" /></span><span><MudText Typo="Typo.h6">@L["GitDashboard:Sections:Details"]</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@L["GitDashboard:Sections:DetailsDescription"]</MudText></span></div>
                        @if (_selectedRepository is not { } selectedRepository)
                        { <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["GitDashboard:Messages:NoSelection"]</MudAlert> }
                        else
                        {
                            <div class="git-detail-actions"><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync" OnClick="@(() => SyncRepositoryAsync(selectedRepository.Id))" Disabled="@IsBusy">@L["GitDashboard:Actions:Sync"]</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteRepositoryAsync(selectedRepository.Id))" Disabled="@IsBusy">@L["GitDashboard:Actions:DeleteLocal"]</MudButton></div>
                            <dl class="git-detail-list">
                                <div><dt>@L["GitDashboard:Labels:RemoteUrl"]</dt><dd>@selectedRepository.RemoteUrl</dd></div>
                                <div><dt>@L["GitDashboard:Labels:ResolvedLocalPath"]</dt><dd>@selectedRepository.ResolvedLocalPath</dd></div>
                                <div><dt>@L["GitDashboard:Labels:ResolvedBranch"]</dt><dd>@GetDisplay(selectedRepository.ResolvedBranch)</dd></div>
                                <div><dt>@L["GitDashboard:Labels:Credential"]</dt><dd>@GetDisplay(selectedRepository.CredentialId)</dd></div>
                                <div><dt>@L["GitDashboard:Labels:Available"]</dt><dd>@BoolText(selectedRepository.IsAvailable)</dd></div>
                                <div><dt>@L["GitDashboard:Labels:Dirty"]</dt><dd>@BoolText(selectedRepository.IsDirty)</dd></div>
                                <div><dt>@L["GitDashboard:Labels:CurrentCommit"]</dt><dd><code>@GetDisplay(selectedRepository.CurrentCommit)</code></dd></div>
                                <div><dt>@L["GitDashboard:Labels:LastSync"]</dt><dd>@FormatDate(selectedRepository.LastSyncAtUtc)</dd></div>
                            </dl>
                            @if (selectedRepository.State == GitRepositorySyncState.Syncing) { <MudProgressLinear Color="Color.Info" Indeterminate="@IsProgressIndeterminate(selectedRepository)" Value="@GetProgressValue(selectedRepository)" /><MudText Typo="Typo.caption">@GetProgressText(selectedRepository)</MudText> }
                            @if (!string.IsNullOrWhiteSpace(selectedRepository.LastSyncMessage)) { <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">@selectedRepository.LastSyncMessage</MudAlert> }
                            @if (!string.IsNullOrWhiteSpace(selectedRepository.LastError)) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@selectedRepository.LastError</MudAlert> }
                        }
                    </MudPaper>
                </aside>
            </div>

            <div class="git-secondary-layout">
                <section class="git-surface"><MudPaper Elevation="0" Outlined="true"><div class="git-section-heading"><span class="git-section-heading__icon git-section-heading__icon--warning"><MudIcon Icon="@Icons.Material.Filled.Key" /></span><span><MudText Typo="Typo.h6">@L["GitDashboard:Sections:Credentials"]</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@L["GitDashboard:Sections:CredentialsDescription"]</MudText></span></div><div class="git-table"><MudTable T="GitCredentialInfo" Items="@_credentials" Dense="true" Hover="true" Elevation="0"><HeaderContent><MudTh>@L["GitDashboard:Columns:CredentialId"]</MudTh><MudTh>@L["GitDashboard:Columns:Type"]</MudTh><MudTh>@L["GitDashboard:Columns:UserName"]</MudTh><MudTh>@L["GitDashboard:Columns:HasSecret"]</MudTh></HeaderContent><RowTemplate><MudTd DataLabel="@(L["GitDashboard:Columns:CredentialId"])">@context.Id</MudTd><MudTd DataLabel="@(L["GitDashboard:Columns:Type"])">@context.AuthenticationType</MudTd><MudTd DataLabel="@(L["GitDashboard:Columns:UserName"])">@GetDisplay(context.UserName)</MudTd><MudTd DataLabel="@(L["GitDashboard:Columns:HasSecret"])">@BoolText(context.HasSecret)</MudTd></RowTemplate><NoRecordsContent><MudText Typo="Typo.body2">@L["GitDashboard:Messages:NoCredentials"]</MudText></NoRecordsContent></MudTable></div></MudPaper></section>
                <section class="git-surface"><MudPaper Elevation="0" Outlined="true"><div class="git-section-heading"><span class="git-section-heading__icon git-section-heading__icon--tertiary"><MudIcon Icon="@Icons.Material.Filled.Extension" /></span><span><MudText Typo="Typo.h6">@L["GitDashboard:Sections:Resolvers"]</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@L["GitDashboard:Sections:ResolversDescription"]</MudText></span></div><div class="git-table"><MudTable T="GitCredentialResolverInfo" Items="@_resolvers" Dense="true" Hover="true" Elevation="0"><HeaderContent><MudTh>@L["GitDashboard:Columns:Resolver"]</MudTh><MudTh>@L["GitDashboard:Columns:Type"]</MudTh><MudTh>@L["GitDashboard:Columns:Order"]</MudTh></HeaderContent><RowTemplate><MudTd DataLabel="@(L["GitDashboard:Columns:Resolver"])">@context.DisplayName</MudTd><MudTd DataLabel="@(L["GitDashboard:Columns:Type"])">@context.ImplementationType</MudTd><MudTd DataLabel="@(L["GitDashboard:Columns:Order"])">@context.Order</MudTd></RowTemplate><NoRecordsContent><MudText Typo="Typo.body2">@L["GitDashboard:Messages:NoResolvers"]</MudText></NoRecordsContent></MudTable></div></MudPaper></section>
            </div>
        </div>
    </MudContainer>
</div>
