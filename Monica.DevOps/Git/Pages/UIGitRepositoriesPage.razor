@attribute [Route(PAGE_URL)]
@using Monica.DevOps.Git.Models

<PageTitle>@L["GitDashboard:PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">@L["GitDashboard:Title"]</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshAsync"
                       Disabled="@_isLoading">
                @L["GitDashboard:Actions:Refresh"]
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Sync"
                       OnClick="SyncAllAsync"
                       Disabled="@(IsBusy || _repositories.Count == 0)">
                @L["GitDashboard:Actions:SyncAll"]
            </MudButton>
        </MudStack>
    </MudStack>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L["GitDashboard:Sections:Repositories"]</MudText>

                <MudTable T="GitRepositoryStatus" Items="@_repositories" Dense="true" Hover="true" Loading="@IsBusy">
                    <HeaderContent>
                        <MudTh>@L["GitDashboard:Columns:Id"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Provider"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Branch"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:State"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Commit"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Size"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Updated"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Id"])">@context.Id</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Provider"])">@GetDisplay(context.Provider)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Branch"])">@GetDisplay(context.ResolvedBranch ?? context.ConfiguredBranch)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:State"])">
                            <MudStack Spacing="1">
                                <MudChip T="string" Color="@GetStateColor(context.State)" Variant="Variant.Outlined" Label="true">
                                    @GetStateText(context.State)
                                </MudChip>

                                @if (context.State == GitRepositorySyncState.Syncing)
                                {
                                    <MudProgressLinear Color="Color.Info"
                                                       Indeterminate="@IsProgressIndeterminate(context)"
                                                       Value="@GetProgressValue(context)" />
                                    <MudText Typo="Typo.caption">@GetProgressText(context)</MudText>
                                }
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Commit"])">@ShortSha(context.CurrentCommit)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Size"])">@FormatBytes(context.WorkingDirectorySizeBytes)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Updated"])">@FormatDate(context.LastSyncAtUtc)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Actions"])">
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SelectRepository(context.Id))">
                                @L["GitDashboard:Actions:Select"]
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">@L["GitDashboard:Messages:NoRepositories"]</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L["GitDashboard:Sections:Details"]</MudText>

                @if (_selectedRepository is not { } selectedRepository)
                {
                    <MudAlert Severity="Severity.Info">@L["GitDashboard:Messages:NoSelection"]</MudAlert>
                }
                else
                {
                    <MudStack Spacing="2">
                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Sync"
                                       OnClick="@(() => SyncRepositoryAsync(selectedRepository.Id))"
                                       Disabled="@IsBusy">
                                @L["GitDashboard:Actions:Sync"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => DeleteRepositoryAsync(selectedRepository.Id))"
                                       Disabled="@IsBusy">
                                @L["GitDashboard:Actions:DeleteLocal"]
                            </MudButton>
                        </MudStack>

                        <MudText><strong>@L["GitDashboard:Labels:RemoteUrl"]:</strong> @selectedRepository.RemoteUrl</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:LocalPath"]:</strong> @selectedRepository.LocalPath</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:ResolvedLocalPath"]:</strong> @selectedRepository.ResolvedLocalPath</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:ConfiguredBranch"]:</strong> @GetDisplay(selectedRepository.ConfiguredBranch)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:ResolvedBranch"]:</strong> @GetDisplay(selectedRepository.ResolvedBranch)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:Credential"]:</strong> @GetDisplay(selectedRepository.CredentialId)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:Available"]:</strong> @BoolText(selectedRepository.IsAvailable)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:Dirty"]:</strong> @BoolText(selectedRepository.IsDirty)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:CurrentCommit"]:</strong> @GetDisplay(selectedRepository.CurrentCommit)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:WorkingDirectorySize"]:</strong> @FormatBytes(selectedRepository.WorkingDirectorySizeBytes)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:LastSync"]:</strong> @FormatDate(selectedRepository.LastSyncAtUtc)</MudText>

                        @if (selectedRepository.State == GitRepositorySyncState.Syncing)
                        {
                            <MudStack Spacing="1">
                                <MudText><strong>@L["GitDashboard:Labels:Progress"]:</strong> @GetProgressText(selectedRepository)</MudText>
                                <MudProgressLinear Color="Color.Info"
                                                   Indeterminate="@IsProgressIndeterminate(selectedRepository)"
                                                   Value="@GetProgressValue(selectedRepository)" />
                            </MudStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(selectedRepository.LastSyncMessage))
                        {
                            <MudAlert Severity="Severity.Info">
                                <strong>@L["GitDashboard:Labels:LastMessage"]:</strong> @selectedRepository.LastSyncMessage
                            </MudAlert>
                        }

                        @if (!string.IsNullOrWhiteSpace(selectedRepository.LastError))
                        {
                            <MudAlert Severity="Severity.Error">
                                <strong>@L["GitDashboard:Labels:LastError"]:</strong> @selectedRepository.LastError
                            </MudAlert>
                        }
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L["GitDashboard:Sections:Credentials"]</MudText>

                <MudTable T="GitCredentialInfo" Items="@_credentials" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>@L["GitDashboard:Columns:CredentialId"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Type"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:UserName"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:HasSecret"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:CredentialId"])">@context.Id</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Type"])">@context.AuthenticationType</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:UserName"])">@GetDisplay(context.UserName)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:HasSecret"])">@BoolText(context.HasSecret)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">@L["GitDashboard:Messages:NoCredentials"]</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L["GitDashboard:Sections:Resolvers"]</MudText>

                <MudTable T="GitCredentialResolverInfo" Items="@_resolvers" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>@L["GitDashboard:Columns:Resolver"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Type"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Order"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Resolver"])">@context.DisplayName</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Type"])">@context.ImplementationType</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Order"])">@context.Order</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">@L["GitDashboard:Messages:NoResolvers"]</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
