<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="..\common.xml" />

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateStaticWebAssetsManifest>true</GenerateStaticWebAssetsManifest>
    <PackageDescription>DevOps and infrastructure operation modules for Monica framework, including K8S management APIs and UI components.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monica.Core\Monica.Core.csproj" />
    <ProjectReference Include="..\Monica.UI\Monica.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\Localization\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Pages\UIFileOpsPage.razor" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="FileOps\Pages\UIFileOpsPage.razor" />
  </ItemGroup>

</Project>
