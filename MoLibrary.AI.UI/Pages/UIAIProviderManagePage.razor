@page "/ai-providers"
@using MoLibrary.Tool.MoResponse
@rendermode InteractiveServer
@inject AIProviderUIService ProviderUIService
@inject ISnackbar Snackbar

<PageTitle>AI Provider 管理</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="ai-provider-page pa-4">
    <div class="page-header">
        <MudText Typo="Typo.h4">AI Provider 管理</MudText>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadProvidersAsync">
                刷新
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlayCircle"
                       OnClick="TestAllAsync"
                       Disabled="@(!_providers.Any() || _isTestingAll)">
                测试全部
            </MudButton>
        </MudStack>
    </div>

    @if (_isLoading)
    {
        <div class="loading-area">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (!_providers.Any())
    {
        <MudAlert Severity="Severity.Info">未发现已配置的 AI Provider</MudAlert>
    }
    else
    {
        <MudGrid Class="provider-grid">
            @foreach (var provider in _providers)
            {
                var testState = GetTestState(provider.ProviderId);
                <MudItem xs="12" md="12" lg="6" xl="6" @key="provider.ProviderId">
                    <ProviderManageCard Provider="@provider"
                                        Models="@GetModels(provider)"
                                        IsTesting="@testState.IsRunning"
                                        TestSuccess="@testState.Success"
                                        TestMessage="@testState.Message"
                                        TestedAt="@testState.TestedAt"
                                        OnTest="TestProviderAsync"
                                        OnTestModel="TestModelAsync"
                                        ModelTestingProvider="IsModelTesting" />
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    public const string PAGE_URL = "/ai-providers";

    private IReadOnlyList<AIProviderInfo> _providers = [];
    private bool _isLoading;
    private bool _isTestingAll;
    private readonly Dictionary<string, ProviderTestState> _testStates = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _modelTesting = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadProvidersAsync();
        }
    }

    private async Task LoadProvidersAsync()
    {
        _isLoading = true;
        StateHasChanged();

        await Task.Yield();
        try
        {
            _providers = ProviderUIService.GetProviders();
        }
        catch (Exception ex)
        {
            _providers = [];
            Snackbar.Add($"加载 Provider 失败: {ex.Message}", Severity.Error);
        }

        foreach (var provider in _providers)
        {
            _ = GetTestState(provider.ProviderId);
        }

        _isLoading = false;
        StateHasChanged();
    }

    private IReadOnlyList<AIModelInfo> GetModels(AIProviderInfo provider)
    {
        return provider.SupportedModels ?? [];
    }

    private ProviderTestState GetTestState(string providerId)
    {
        if (!_testStates.TryGetValue(providerId, out var state))
        {
            state = new ProviderTestState();
            _testStates[providerId] = state;
        }

        return state;
    }

    private bool IsModelTesting(string providerId, string modelName)
    {
        return _modelTesting.Contains(GetModelKey(providerId, modelName));
    }

    private async Task TestProviderAsync(string providerId)
    {
        var state = GetTestState(providerId);
        if (state.IsRunning)
        {
            return;
        }

        state.IsRunning = true;
        state.Message = null;
        state.Success = null;
        StateHasChanged();

        var result = await ProviderUIService.TestProviderAsync(providerId);
        if (result.IsFailed(out var error))
        {
            state.Success = false;
            state.Message = error.Message;
            Snackbar.Add($"Provider 测试失败: {error.Message}", Severity.Error);
        }
        else
        {
            state.Success = true;
            state.Message = "连接成功";
            Snackbar.Add("Provider 测试成功", Severity.Success);
        }

        state.TestedAt = DateTimeOffset.UtcNow;
        state.IsRunning = false;
        StateHasChanged();
    }

    private async Task TestAllAsync()
    {
        if (_isTestingAll)
        {
            return;
        }

        _isTestingAll = true;
        StateHasChanged();

        foreach (var provider in _providers)
        {
            await TestProviderAsync(provider.ProviderId);
        }

        _isTestingAll = false;
        StateHasChanged();
    }

    private async Task TestModelAsync((string ProviderId, AIModelInfo Model) request)
    {
        if (request.Model is not LLMModelInfo)
        {
            Snackbar.Add("当前仅支持测试 LLM 模型", Severity.Info);
            return;
        }

        var key = GetModelKey(request.ProviderId, request.Model.ModelName);
        if (!_modelTesting.Add(key))
        {
            return;
        }

        StateHasChanged();

        var result = await ProviderUIService.TestModelAsync(request.ProviderId, request.Model.ModelName);
        if (result.IsFailed(out var error))
        {
            Snackbar.Add($"模型测试失败: {error.Message}", Severity.Error);
        }
        else
        {
            Snackbar.Add("模型测试成功", Severity.Success);
        }

        _modelTesting.Remove(key);
        StateHasChanged();
    }

    private static string GetModelKey(string providerId, string modelName)
    {
        return $"{providerId}:{modelName}";
    }

    private sealed class ProviderTestState
    {
        public bool IsRunning { get; set; }
        public bool? Success { get; set; }
        public string? Message { get; set; }
        public DateTimeOffset? TestedAt { get; set; }
    }
}
