@using MoLibrary.AI.Models
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<div class="message-wrapper @(IsUser ? "user-message" : "assistant-message")">
    <MudStack Row="true" Spacing="2" Class="message-content-stack">
        @if (!IsUser)
        {
            <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="message-avatar">
                <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
            </MudAvatar>
        }

        @if (IsUser)
        {
            @* User message - show bubble and actions only when NOT editing *@
            @if (!_isEditing)
            {
                <div class="user-message-container">
                    @* Action buttons outside bubble, top-left *@
                    <div class="user-actions">
                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                                       OnClick="@HandleCopy" Class="user-action-button" title="Copy" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                       OnClick="@HandleStartEdit" Class="user-action-button" title="Edit" />
                    </div>

                    @* The bubble itself *@
                    <div class="message-content user-bubble">
                        <MudText Typo="Typo.body1" Class="message-text">@Message.Content</MudText>
                        <div class="message-meta">
                            <MudText Typo="Typo.caption" Class="message-time">
                                @Message.CreatedAt.ToLocalTime().ToString("HH:mm")
                            </MudText>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            @* AI message - keep current structure with actions inside *@
            <div class="message-content assistant-bubble">
                @if (EnableMarkdown)
                {
                    <MudMarkdown Value="@Message.Content" />
                }
                else
                {
                    <MudText Typo="Typo.body1" Class="message-text">@Message.Content</MudText>
                }
                <div class="message-meta">
                    <MudText Typo="Typo.caption" Class="message-time">
                        @Message.CreatedAt.ToLocalTime().ToString("HH:mm")
                    </MudText>
                    @if (Message.Usage != null)
                    {
                        <MudText Typo="Typo.caption" Class="message-tokens">
                            @Message.Usage.TotalTokens tokens
                        </MudText>
                    }
                    <div class="message-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                       OnClick="@HandleCopy" Class="action-button" title="Copy" />
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                       OnClick="@HandleRetry" Class="action-button" title="Retry" />
                    </div>
                </div>
            </div>
        }

        @if (IsUser)
        {
            <MudAvatar Size="Size.Small" Color="Color.Primary" Class="message-avatar">
                <MudIcon Icon="@Icons.Material.Filled.Person" />
            </MudAvatar>
        }
    </MudStack>

    @* Edit mode: Separate input box below message *@
    @if (_isEditing)
    {
        <div class="edit-overlay">
            <MudTextField T="string" @bind-Value="_editContent"
                          Variant="Variant.Outlined"
                          AutoGrow="true" Lines="3" MaxLines="10"
                          Class="edit-input" />
            <div class="edit-buttons">
                <MudButton Variant="Variant.Text" OnClick="@HandleCancelEdit">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="@HandleSaveEdit" Disabled="@string.IsNullOrWhiteSpace(_editContent)">
                    Update
                </MudButton>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public required AIChatMessage Message { get; set; }
    [Parameter] public bool EnableMarkdown { get; set; } = true;
    [Parameter] public EventCallback<(AIChatMessage Message, string NewContent)> OnEdit { get; set; }
    [Parameter] public EventCallback<AIChatMessage> OnRetry { get; set; }

    private bool IsUser => Message.Role == AIChatRole.User;
    private bool _isEditing;
    private string _editContent = string.Empty;

    private async Task HandleCopy()
    {
        var success = await JSRuntime.InvokeAsync<bool>("MoClipboard.copyText", Message.Content);
        Snackbar.Add(success ? "Copied to clipboard" : "Failed to copy",
                     success ? Severity.Success : Severity.Error);
    }

    private void HandleStartEdit()
    {
        _editContent = Message.Content;
        _isEditing = true;
    }

    private void HandleCancelEdit()
    {
        _isEditing = false;
        _editContent = string.Empty;
    }

    private async Task HandleSaveEdit()
    {
        if (string.IsNullOrWhiteSpace(_editContent))
        {
            Snackbar.Add("Message cannot be empty", Severity.Warning);
            return;
        }

        _isEditing = false;
        await OnEdit.InvokeAsync((Message, _editContent));
        _editContent = string.Empty;
    }

    private async Task HandleRetry()
    {
        await OnRetry.InvokeAsync(Message);
    }
}
