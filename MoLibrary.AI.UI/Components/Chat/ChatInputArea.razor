<div class="input-area">
    <MudPaper Elevation="2" Class="input-container">
        <MudTextField @ref="_textFieldRef"
                      T="string"
                      @bind-Value="_inputText"
                      Placeholder="@Placeholder"
                      Variant="Variant.Text"
                      Lines="1"
                      AutoGrow="true"
                      MaxLines="6"
                      Disabled="@IsSending"
                      Immediate="true"
                      Class="input-field"
                      OnKeyDown="@HandleKeyDown" />
        @if (IsSending)
        {
            <MudTooltip Text="Stop generating">
                <MudIconButton Icon="@Icons.Material.Filled.Stop"
                               Color="Color.Error"
                               OnClick="@HandleCancel"
                               Class="cancel-button" />
            </MudTooltip>
        }
        else
        {
            <MudTooltip Text="Send message">
                <MudIconButton Icon="@Icons.Material.Filled.Send"
                               Color="Color.Primary"
                               Disabled="@string.IsNullOrWhiteSpace(_inputText)"
                               OnClick="@HandleSend"
                               Class="send-button" />
            </MudTooltip>
        }
    </MudPaper>
    @if (ShowProviderInfo && !string.IsNullOrEmpty(ProviderName))
    {
        <MudText Typo="Typo.caption" Class="provider-info">
            Current: @ProviderName
        </MudText>
    }
</div>

@code {
    [Parameter] public string Placeholder { get; set; } = "Type a message...";
    [Parameter] public bool IsSending { get; set; }
    [Parameter] public string? ProviderName { get; set; }
    [Parameter] public bool ShowProviderInfo { get; set; } = true;
    [Parameter] public EventCallback<string> OnSend { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _inputText = string.Empty;
    private MudTextField<string>? _textFieldRef;

    private async Task HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || IsSending) return;

        var message = _inputText.Trim();
        _inputText = string.Empty;

        await OnSend.InvokeAsync(message);
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Enter to send, Shift+Enter for new line
        if (e is { Key: "Enter", ShiftKey: false })
        {
            await HandleSend();
        }
    }

    public async Task FocusAsync()
    {
        if (_textFieldRef != null)
        {
            await _textFieldRef.FocusAsync();
        }
    }
}
