<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- Source Generator Package Configuration -->
	<PropertyGroup>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<DevelopmentDependency>true</DevelopmentDependency>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<IncludeSymbols>false</IncludeSymbols>
		<PackageDescription>Analyzer-only source generator for request-owned HTTP controllers and RPC clients in Monica applications.</PackageDescription>
		<PackageReleaseNotes>Replaces handler-owned routes and RPC metadata snapshots with request-owned ApiEndpoint contracts. Generates controllers and HTTP/local RPC clients incrementally without build tasks or source-tree writes.</PackageReleaseNotes>
		<PackageTags>monica;dotnet;roslyn;source-generator;aspnetcore;rpc;api-controller;cqrs</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" ExcludeAssets="analyzers" />
	</ItemGroup>

	<!-- Pack as analyzer -->
	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<!-- Roslyn release tracking inputs are analyzer-development metadata, not consumer AdditionalFiles. -->
	<ItemGroup>
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>
</Project>
