@using Monica.Profiling.RuntimeMetrics.Models
<MudGrid Spacing="3">
    @* Trend statistical summary *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">趋势统计</MudText>
            @if (TrendData?.DataPoints.Count > 0)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="6" md="3">
                        <div class="text-center">
                            <MudText Typo="Typo.h5" Color="Color.Primary">@TrendData.AverageHeapSizeMB.ToString("F1")MB</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">平均堆大小</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <div class="text-center">
                            <MudText Typo="Typo.h5" Color="Color.Warning">@TrendData.MaxHeapSizeMB.ToString("F1")MB</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">最大堆大小</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <div class="text-center">
                            <MudText Typo="Typo.h5" Color="Color.Info">@ProfilingDisplayFormatter.FormatBytesPerSecond(TrendData.AverageAllocationRate)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">平均分配速率</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <div class="text-center">
                            <MudText Typo="Typo.h5" Color="Color.Success">@TrendData.DataPoints.Count</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">数据点</MudText>
                        </div>
                    </MudItem>
                </MudGrid>
            }
            else if (!IsLoading)
            {
                <MudAlert Severity="Severity.Info">暂无趋势数据，请等待数据采集...</MudAlert>
            }
        </MudPaper>
    </MudItem>

    @* Heap size trend chart *@
    <MudItem xs="12" lg="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">堆大小趋势 (MB)</MudText>
            @if (TrendData?.DataPoints.Count > 1)
            {
                <div class="chart-container">
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@heapSizeSeries"
                              ChartLabels="@timeLabels"
                              Width="100%"
                              Height="300px"
                              ChartOptions="@heapChartOptions" />
                </div>
            }
            else
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" />
            }
        </MudPaper>
    </MudItem>

    @* Allocation rate trend graph *@
    <MudItem xs="12" lg="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">分配速率趋势 (MB/s)</MudText>
            @if (TrendData?.DataPoints.Count > 1)
            {
                <div class="chart-container">
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@allocationSeries"
                              ChartLabels="@timeLabels"
                              Width="100%"
                              Height="300px"
                              ChartOptions="@allocChartOptions" />
                </div>
            }
            else
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" />
            }
        </MudPaper>
    </MudItem>

    @* Trends across generations *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">各代堆大小分布 (最新)</MudText>
            @if (TrendData?.DataPoints.Count > 0)
            {
                var latest = TrendData.DataPoints[^1];
                var genData = new double[]
                {
                    latest.Gen0SizeBytes / 1024 / 1024,
                    latest.Gen1SizeBytes / 1024 / 1024,
                    latest.Gen2SizeBytes / 1024 / 1024,
                    latest.LohSizeBytes / 1024 / 1024
                };
                var genLabels = new[] { "Gen 0", "Gen 1", "Gen 2", "LOH" };

                <MudChart ChartType="ChartType.Bar"
                          ChartSeries="@(new List<ChartSeries<double>> { new() { Name = "大小 (MB)", Data = genData } })"
                          ChartLabels="@genLabels"
                          Width="100%"
                          Height="250px"
                          ChartOptions="@genChartOptions" />
            }
            else
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="250px" />
            }
        </MudPaper>
    </MudItem>

    @* Recent data table *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">最近数据点</MudText>
            @if (TrendData?.DataPoints.Count > 0)
            {
                <MudSimpleTable Dense="true" Hover="true" FixedHeader="true" Style="max-height: 300px; overflow-y: auto;">
                    <thead>
                        <tr>
                            <th>时间</th>
                            <th>堆大小</th>
                            <th>分配速率</th>
                            <th>GC 时间%</th>
                            <th>碎片化%</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in TrendData.DataPoints.TakeLast(20).Reverse())
                        {
                            <tr>
                                <td>@ProfilingDisplayFormatter.FormatLocalTime(point.Timestamp)</td>
                                <td>@point.GcHeapSizeMB.ToString("F1") MB</td>
                                <td>@ProfilingDisplayFormatter.FormatBytesPerSecond(point.AllocationRateBps)</td>
                                <td>
                                    <span class="@ProfilingSeverityColorResolver.GetGcTimeClass(point.TimeInGcPercent)">
                                        @point.TimeInGcPercent.ToString("F1")%
                                    </span>
                                </td>
                                <td>@point.GcFragmentation.ToString("F1")%</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info">暂无数据</MudAlert>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public RuntimeMetricsTrend? TrendData { get; set; }

    [Parameter] public bool IsLoading { get; set; }

    private List<ChartSeries<double>> heapSizeSeries = [];
    private List<ChartSeries<double>> allocationSeries = [];
    private string[] timeLabels = [];

    private ChartOptions heapChartOptions = new();
    private ChartOptions allocChartOptions = new();
    private ChartOptions genChartOptions = new();

    protected override void OnParametersSet()
    {
        UpdateChartData();
    }

    private void UpdateChartData()
    {
        if (TrendData?.DataPoints == null || TrendData.DataPoints.Count < 2)
        {
            return;
        }

        // Sampling to reduce chart data points (display up to 50 points)
        var step = Math.Max(1, TrendData.DataPoints.Count / 50);
        var sampledData = TrendData.DataPoints
            .Where((_, i) => i % step == 0 || i == TrendData.DataPoints.Count - 1)
            .ToList();

        timeLabels = sampledData
            .Select(p => p.Timestamp.ToLocalTime().ToString("HH:mm"))
            .ToArray();

        heapSizeSeries =
        [
            new ChartSeries<double>
            {
                Name = "堆大小",
                Data = sampledData.Select(p => p.GcHeapSizeMB).ToArray()
            }
        ];

        allocationSeries =
        [
            new ChartSeries<double>
            {
                Name = "分配速率",
                Data = sampledData.Select(p => p.AllocationRateBps / 1024 / 1024).ToArray()
            }
        ];
    }

}
