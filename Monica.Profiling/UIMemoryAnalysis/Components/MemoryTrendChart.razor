@using Monica.Profiling.RuntimeMetrics.Models
@inject IStringLocalizer<MemoryAnalysisResource> L

<section class="memory-trend-layout">
    <div class="memory-trend-summary" aria-label="@L["Trend:SummaryAriaLabel"]">
        <div><strong class="mud-primary-text">@(TrendData?.AverageHeapSizeMB.ToString("F1") ?? "—") MB</strong><span>@L["Trend:Summary:AverageHeap"]</span></div>
        <div><strong class="mud-warning-text">@(TrendData?.MaxHeapSizeMB.ToString("F1") ?? "—") MB</strong><span>@L["Trend:Summary:MaximumHeap"]</span></div>
        <div><strong class="mud-info-text">@(TrendData is null ? "—" : ProfilingDisplayFormatter.FormatBytesPerSecond(TrendData.AverageAllocationRate))</strong><span>@L["Trend:Summary:AverageAllocation"]</span></div>
        <div><strong class="mud-success-text">@(TrendData?.DataPoints.Count ?? 0)</strong><span>@L["Trend:Summary:Samples"]</span></div>
    </div>

    @if (TrendData?.DataPoints.Count == 0 && !IsLoading)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Trend:Waiting"]</MudAlert>
    }

    <div class="memory-trend-charts">
        <article class="memory-trend-panel">
            <header><MudText Typo="Typo.overline" Class="memory-trend-eyebrow">@L["Trend:Heap:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Trend:Heap:Title"]</MudText></header>
            @if (TrendData?.DataPoints.Count > 1)
            {
                <div class="memory-chart-scroll"><MudChart ChartType="ChartType.Line" ChartSeries="@_heapSizeSeries" ChartLabels="@_timeLabels" Width="100%" Height="300px" ChartOptions="@_heapChartOptions" /></div>
            }
            else
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" />
            }
        </article>

        <article class="memory-trend-panel">
            <header><MudText Typo="Typo.overline" Class="memory-trend-eyebrow">@L["Trend:Allocation:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Trend:Allocation:Title"]</MudText></header>
            @if (TrendData?.DataPoints.Count > 1)
            {
                <div class="memory-chart-scroll"><MudChart ChartType="ChartType.Line" ChartSeries="@_allocationSeries" ChartLabels="@_timeLabels" Width="100%" Height="300px" ChartOptions="@_allocationChartOptions" /></div>
            }
            else
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" />
            }
        </article>
    </div>

    <article class="memory-trend-panel">
        <header><MudText Typo="Typo.overline" Class="memory-trend-eyebrow">@L["Trend:Generations:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Trend:Generations:Title"]</MudText></header>
        @if (TrendData?.DataPoints.Count > 0)
        {
            var latest = TrendData.DataPoints[^1];
            var generationData = new[]
            {
                latest.Gen0SizeBytes / 1024d / 1024d,
                latest.Gen1SizeBytes / 1024d / 1024d,
                latest.Gen2SizeBytes / 1024d / 1024d,
                latest.LohSizeBytes / 1024d / 1024d
            };
            <div class="memory-chart-scroll">
                <MudChart ChartType="ChartType.Bar"
                          ChartSeries="@(new List<ChartSeries<double>> { new() { Name = L["Trend:Series:Size"], Data = generationData } })"
                          ChartLabels="@(new[] { "Gen 0", "Gen 1", "Gen 2", "LOH" })"
                          Width="100%"
                          Height="240px"
                          ChartOptions="@_generationChartOptions" />
            </div>
        }
        else
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="220px" />
        }
    </article>

    <article class="memory-trend-panel">
        <header class="memory-trend-panel__split-header">
            <div><MudText Typo="Typo.overline" Class="memory-trend-eyebrow">@L["Trend:Recent:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Trend:Recent:Title"]</MudText></div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Trend:Recent:Count", Math.Min(TrendData?.DataPoints.Count ?? 0, 20)]</MudChip>
        </header>
        @if (TrendData?.DataPoints.Count > 0)
        {
            <div class="memory-table-scroll">
                <MudSimpleTable Dense="true" Hover="true" FixedHeader="true">
                    <thead><tr><th>@L["Trend:Recent:Columns:Time"]</th><th>@L["Trend:Recent:Columns:Heap"]</th><th>@L["Trend:Recent:Columns:Allocation"]</th><th>@L["Trend:Recent:Columns:GcTime"]</th><th>@L["Trend:Recent:Columns:Fragmentation"]</th></tr></thead>
                    <tbody>
                        @foreach (var point in TrendData.DataPoints.TakeLast(20).Reverse())
                        {
                            <tr>
                                <td class="diagnostic-value">@ProfilingDisplayFormatter.FormatLocalTime(point.Timestamp)</td>
                                <td>@point.GcHeapSizeMB.ToString("F1") MB</td>
                                <td>@ProfilingDisplayFormatter.FormatBytesPerSecond(point.AllocationRateBps)</td>
                                <td><span class="@ProfilingSeverityColorResolver.GetGcTimeClass(point.TimeInGcPercent)">@point.TimeInGcPercent.ToString("F1")%</span></td>
                                <td>@point.GcFragmentation.ToString("F1")%</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Trend:Recent:Empty"]</MudAlert>
        }
    </article>
</section>

@code {
    [Parameter] public RuntimeMetricsTrend? TrendData { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private List<ChartSeries<double>> _heapSizeSeries = [];
    private List<ChartSeries<double>> _allocationSeries = [];
    private string[] _timeLabels = [];
    private readonly ChartOptions _heapChartOptions = new();
    private readonly ChartOptions _allocationChartOptions = new();
    private readonly ChartOptions _generationChartOptions = new();

    protected override void OnParametersSet() => UpdateChartData();

    private void UpdateChartData()
    {
        if (TrendData?.DataPoints is not { Count: >= 2 } dataPoints)
        {
            _heapSizeSeries = [];
            _allocationSeries = [];
            _timeLabels = [];
            return;
        }

        var step = Math.Max(1, dataPoints.Count / 50);
        var sampledData = dataPoints.Where((_, index) => index % step == 0 || index == dataPoints.Count - 1).ToList();
        _timeLabels = sampledData.Select(point => ProfilingDisplayFormatter.FormatLocalTime(point.Timestamp)).ToArray();
        _heapSizeSeries = [new ChartSeries<double> { Name = L["Trend:Series:Heap"], Data = sampledData.Select(point => point.GcHeapSizeMB).ToArray() }];
        _allocationSeries = [new ChartSeries<double> { Name = L["Trend:Series:Allocation"], Data = sampledData.Select(point => point.AllocationRateBps / 1024d / 1024d).ToArray() }];
    }
}
