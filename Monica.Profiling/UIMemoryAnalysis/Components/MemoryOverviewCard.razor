@using Monica.Profiling.MemoryDiagnostics.Models
@inject IStringLocalizer<MemoryAnalysisResource> L

<section class="memory-overview">
    <div class="memory-overview__metrics" aria-label="@L["Overview:MetricsAriaLabel"]">
        <article class="memory-metric memory-metric--primary">
            <span class="memory-metric__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Storage" /></span>
            <div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Overview:WorkingSet"]</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary">@LoadingOr(ProfilingDisplayFormatter.FormatBytes(Snapshot?.WorkingSetBytes ?? 0))</MudText>
            </div>
        </article>
        <article class="memory-metric memory-metric--info">
            <span class="memory-metric__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Memory" /></span>
            <div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Overview:ManagedHeap"]</MudText>
                <MudText Typo="Typo.h5" Color="Color.Info">@LoadingOr(ProfilingDisplayFormatter.FormatBytes(Snapshot?.GcHeapSizeBytes ?? 0))</MudText>
            </div>
        </article>
        <article class="memory-metric memory-metric--success">
            <span class="memory-metric__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Commit" /></span>
            <div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Overview:Committed"]</MudText>
                <MudText Typo="Typo.h5" Color="Color.Success">@LoadingOr(ProfilingDisplayFormatter.FormatBytes(Snapshot?.CommittedBytes ?? 0))</MudText>
            </div>
        </article>
        <article class="memory-metric memory-metric--warning">
            <span class="memory-metric__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.DataUsage" /></span>
            <div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Overview:ManagedMemory"]</MudText>
                <MudText Typo="Typo.h5" Color="Color.Warning">@LoadingOr(ProfilingDisplayFormatter.FormatBytes(Snapshot?.TotalManagedMemory ?? 0))</MudText>
            </div>
        </article>
    </div>

    <div class="memory-overview__detail-grid">
        <article class="memory-evidence-panel">
            <header class="memory-evidence-panel__header">
                <MudText Typo="Typo.overline" Class="memory-section-eyebrow">@L["Overview:Collections:Eyebrow"]</MudText>
                <MudText Typo="Typo.h6">@L["Overview:Collections:Title"]</MudText>
            </header>
            <div class="generation-strip">
                <div><strong>@(Snapshot?.Gen0Collections ?? 0)</strong><span>Gen 0</span></div>
                <div><strong>@(Snapshot?.Gen1Collections ?? 0)</strong><span>Gen 1</span></div>
                <div><strong>@(Snapshot?.Gen2Collections ?? 0)</strong><span>Gen 2</span></div>
            </div>
        </article>

        <article class="memory-evidence-panel">
            <header class="memory-evidence-panel__header">
                <MudText Typo="Typo.overline" Class="memory-section-eyebrow">@L["Overview:Configuration:Eyebrow"]</MudText>
                <MudText Typo="Typo.h6">@L["Overview:Configuration:Title"]</MudText>
            </header>
            <dl class="memory-definition-list">
                <div>
                    <dt>@L["Overview:Configuration:GcType"]</dt>
                    <dd><MudChip T="string" Size="Size.Small" Color="@(Snapshot?.IsServerGC == true ? Color.Success : Color.Info)">@(Snapshot?.IsServerGC == true ? L["Overview:Configuration:ServerGc"] : L["Overview:Configuration:WorkstationGc"])</MudChip></dd>
                </div>
                <div>
                    <dt>@L["Overview:Configuration:LatencyMode"]</dt>
                    <dd>@(Snapshot?.LatencyModeDisplayName ?? L["Common:Unavailable"])</dd>
                </div>
                <div>
                    <dt>@L["Overview:Snapshot:CapturedAt"]</dt>
                    <dd class="diagnostic-value">@(Snapshot is null ? L["Common:Unavailable"] : ProfilingDisplayFormatter.FormatLocalTime(Snapshot.Timestamp))</dd>
                </div>
                <div>
                    <dt>@L["Overview:Snapshot:MaxGeneration"]</dt>
                    <dd>@GC.MaxGeneration</dd>
                </div>
            </dl>
        </article>
    </div>
</section>

@code {
    [Parameter] public MemorySnapshot? Snapshot { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private string LoadingOr(string value) => IsLoading ? L["Common:LoadingValue"] : value;
}
