@using Monica.Profiling.MemoryDiagnostics.Models
<MudGrid Spacing="3">
    @* Main memory indicators *@
    <MudItem xs="12" md="6" lg="3">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">工作集</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary">
                        @(IsLoading ? "..." : ProfilingDisplayFormatter.FormatBytes(Snapshot?.WorkingSetBytes ?? 0))
                    </MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" Size="Size.Large"/>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6" lg="3"> 
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">托管堆</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Info">
                        @(IsLoading ? "..." : ProfilingDisplayFormatter.FormatBytes(Snapshot?.GcHeapSizeBytes ?? 0))
                    </MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Info" Size="Size.Large"/>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6" lg="3">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">已提交</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success">
                        @(IsLoading ? "..." : ProfilingDisplayFormatter.FormatBytes(Snapshot?.CommittedBytes ?? 0))
                    </MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Commit" Color="Color.Success" Size="Size.Large"/>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6" lg="3">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">托管内存</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Warning">
                        @(IsLoading ? "..." : ProfilingDisplayFormatter.FormatBytes(Snapshot?.TotalManagedMemory ?? 0))
                    </MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.DataUsage" Color="Color.Warning" Size="Size.Large"/>
            </div>
        </MudPaper>
    </MudItem>

    @* GC collection times *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">GC 回收次数</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="4">
                    <div class="text-center">
                        <MudText Typo="Typo.h4" Color="Color.Primary">@(Snapshot?.Gen0Collections ?? 0)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Gen 0</MudText>
                    </div>
                </MudItem>
                <MudItem xs="4">
                    <div class="text-center">
                        <MudText Typo="Typo.h4" Color="Color.Info">@(Snapshot?.Gen1Collections ?? 0)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Gen 1</MudText>
                    </div>
                </MudItem>
                <MudItem xs="4">
                    <div class="text-center">
                        <MudText Typo="Typo.h4" Color="Color.Warning">@(Snapshot?.Gen2Collections ?? 0)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Gen 2</MudText>
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>

    @* GC mode information *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">GC 模式</MudText>
            <MudStack Spacing="2">
                <div class="d-flex justify-space-between">
                    <MudText>GC 类型</MudText>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(Snapshot?.IsServerGC == true ? Color.Success : Color.Info)">
                        @(Snapshot?.IsServerGC == true ? "Server GC" : "Workstation GC")
                    </MudChip>
                </div>
                <div class="d-flex justify-space-between">
                    <MudText>延迟模式</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">
                        @(Snapshot?.LatencyModeDisplayName ?? "N/A")
                    </MudChip>
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>

    @* snapshot time *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">快照信息</MudText>
            <MudStack Spacing="2">
                <div class="d-flex justify-space-between">
                    <MudText>采集时间</MudText>
                    <MudText Color="Color.Secondary">
                        @(Snapshot is null ? "N/A" : ProfilingDisplayFormatter.FormatLocalTime(Snapshot.Timestamp))
                    </MudText>
                </div>
                <div class="d-flex justify-space-between">
                    <MudText>最大代数</MudText>
                    <MudText Color="Color.Secondary">@GC.MaxGeneration</MudText>
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
[Parameter] public MemorySnapshot? Snapshot { get; set; }
[Parameter] public bool IsLoading { get; set; }
}
