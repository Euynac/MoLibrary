@using Monica.Modules
@inject IStringLocalizer<MemoryAnalysisResource> L

<section class="diagnostic-actions-layout">
    <article class="diagnostic-action diagnostic-action--warning">
        <header class="diagnostic-action__header">
            <span class="diagnostic-action__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.CleaningServices" /></span>
            <div><MudText Typo="Typo.overline" Class="diagnostic-action__eyebrow">@L["Diagnostics:ManualGc:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Diagnostics:ManualGc:Title"]</MudText></div>
        </header>
        @if (Options?.AllowManualGC == true)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Diagnostics:ManualGc:Description"]</MudText>
            <div class="diagnostic-action__controls">
                <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary">
                    <MudButton OnClick="@(() => OnForceGC.InvokeAsync(0))" Disabled="IsLoading">Gen 0</MudButton>
                    <MudButton OnClick="@(() => OnForceGC.InvokeAsync(1))" Disabled="IsLoading">Gen 1</MudButton>
                    <MudButton OnClick="@(() => OnForceGC.InvokeAsync(2))" Disabled="IsLoading">Gen 2</MudButton>
                </MudButtonGroup>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="@(() => OnForceGC.InvokeAsync(-1))" Disabled="IsLoading" StartIcon="@Icons.Material.Filled.DeleteSweep">
                    @L["Diagnostics:FullCollection"]
                </MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L["Diagnostics:ManualGc:Disabled"]</MudAlert>
        }
    </article>

    <article class="diagnostic-action diagnostic-action--info">
        <header class="diagnostic-action__header">
            <span class="diagnostic-action__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Download" /></span>
            <div><MudText Typo="Typo.overline" Class="diagnostic-action__eyebrow">@L["Diagnostics:Dump:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Diagnostics:Dump:Title"]</MudText></div>
        </header>
        @if (Options?.AllowGcDump == true)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Diagnostics:Dump:Description"]</MudText>
            <div class="diagnostic-command"><span>@L["Diagnostics:Dump:Requirement"]</span><code>dotnet tool install -g dotnet-gcdump</code></div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnCreateDump" Disabled="IsLoading" StartIcon="@Icons.Material.Filled.SaveAlt">
                @L["Diagnostics:Dump:Action"]
            </MudButton>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L["Diagnostics:Dump:Disabled"]</MudAlert>
        }
    </article>

    <article class="diagnostic-guidance">
        <header class="diagnostic-action__header">
            <span class="diagnostic-action__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Lightbulb" /></span>
            <div><MudText Typo="Typo.overline" Class="diagnostic-action__eyebrow">@L["Diagnostics:Guidance:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Diagnostics:Guidance:Title"]</MudText></div>
        </header>
        <MudExpansionPanels Elevation="0">
            <MudExpansionPanel Text="@L["Diagnostics:Guidance:Signals:Title"]">
                <ul class="diagnostic-guidance__list">
                    <li><strong>@L["Diagnostics:Guidance:Signals:GrowingHeap:Title"]</strong><span>@L["Diagnostics:Guidance:Signals:GrowingHeap:Description"]</span></li>
                    <li><strong>@L["Diagnostics:Guidance:Signals:Gen2:Title"]</strong><span>@L["Diagnostics:Guidance:Signals:Gen2:Description"]</span></li>
                    <li><strong>@L["Diagnostics:Guidance:Signals:Pinned:Title"]</strong><span>@L["Diagnostics:Guidance:Signals:Pinned:Description"]</span></li>
                    <li><strong>@L["Diagnostics:Guidance:Signals:Finalizers:Title"]</strong><span>@L["Diagnostics:Guidance:Signals:Finalizers:Description"]</span></li>
                </ul>
            </MudExpansionPanel>
            <MudExpansionPanel Text="@L["Diagnostics:Guidance:Causes:Title"]">
                <ul class="diagnostic-guidance__list">
                    <li><strong>@L["Diagnostics:Guidance:Causes:Events:Title"]</strong><span>@L["Diagnostics:Guidance:Causes:Events:Description"]</span></li>
                    <li><strong>@L["Diagnostics:Guidance:Causes:Statics:Title"]</strong><span>@L["Diagnostics:Guidance:Causes:Statics:Description"]</span></li>
                    <li><strong>@L["Diagnostics:Guidance:Causes:Caches:Title"]</strong><span>@L["Diagnostics:Guidance:Causes:Caches:Description"]</span></li>
                    <li><strong>@L["Diagnostics:Guidance:Causes:Disposal:Title"]</strong><span>@L["Diagnostics:Guidance:Causes:Disposal:Description"]</span></li>
                </ul>
            </MudExpansionPanel>
            <MudExpansionPanel Text="@L["Diagnostics:Guidance:Tools:Title"]">
                <ul class="diagnostic-guidance__list">
                    <li><strong>Visual Studio</strong><span>@L["Diagnostics:Guidance:Tools:VisualStudio"]</span></li>
                    <li><strong>PerfView</strong><span>@L["Diagnostics:Guidance:Tools:PerfView"]</span></li>
                    <li><strong>dotMemory</strong><span>@L["Diagnostics:Guidance:Tools:DotMemory"]</span></li>
                    <li><strong>dotnet-dump / dotnet-gcdump</strong><span>@L["Diagnostics:Guidance:Tools:Dotnet"]</span></li>
                </ul>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </article>
</section>

@code {
    [Parameter] public ModuleMemoryAnalysisUIOption? Options { get; set; }
    [Parameter] public EventCallback<int> OnForceGC { get; set; }
    [Parameter] public EventCallback OnCreateDump { get; set; }
    [Parameter] public bool IsLoading { get; set; }
}
