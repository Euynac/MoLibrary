@using Monica.Profiling.TypeAllocation.Models
@inject TypeAllocationPanelStateFactory StateFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<MemoryAnalysisResource> L
@implements IDisposable

<section class="allocation-panel">
    <header class="allocation-header">
        <div class="allocation-header__identity">
            <span class="allocation-header__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Category" /></span>
            <div><MudText Typo="Typo.overline" Class="allocation-eyebrow">@L["Allocation:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Allocation:Title"]</MudText></div>
        </div>

        <div class="allocation-header__actions">
            @if (!State.IsCollecting)
            {
                <MudSelect T="AllocationSamplingMode" @bind-Value="State.SelectedMode" Label="@L["Allocation:SamplingMode"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="AllocationSamplingMode.Low">@L["Allocation:Modes:LowWithRate"]</MudSelectItem>
                    <MudSelectItem Value="AllocationSamplingMode.High">@L["Allocation:Modes:HighWithRate"]</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartCollection" Disabled="IsLoading" StartIcon="@Icons.Material.Filled.PlayArrow">@L["Allocation:Actions:Start"]</MudButton>
            }
            else
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Sensors">@L["Allocation:Collecting", GetModeDisplayName(State.CurrentMode)]</MudChip>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="StopCollection" Disabled="IsLoading" StartIcon="@Icons.Material.Filled.Stop">@L["Allocation:Actions:Stop"]</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="TakeHeapSnapshot" Disabled="@(IsLoading || State.IsSnapshotting)" StartIcon="@Icons.Material.Filled.CameraAlt">
                @(State.IsSnapshotting ? L["Allocation:Actions:Snapshotting"] : L["Allocation:Actions:Snapshot"])
            </MudButton>
            <MudTooltip Text="@L["Allocation:Actions:Refresh"]"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshData" Disabled="IsLoading" /></MudTooltip>
            <MudTooltip Text="@L["Allocation:Actions:Reset"]"><MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" OnClick="ResetData" Disabled="@(IsLoading || State.IsCollecting)" Color="Color.Warning" /></MudTooltip>
        </div>
    </header>

    @if (State.Snapshot is not null)
    {
        <div class="allocation-summary" aria-label="@L["Allocation:SummaryAriaLabel"]">
            <div><strong class="mud-primary-text">@State.Snapshot.UniqueTypeCount</strong><span>@L["Allocation:Summary:UniqueTypes"]</span></div>
            <div><strong class="mud-info-text">@ProfilingDisplayFormatter.FormatCount(State.Snapshot.TotalAllocationCount)</strong><span>@L["Allocation:Summary:Allocations"]</span></div>
            <div><strong class="mud-warning-text">@ProfilingDisplayFormatter.FormatBytes(State.Snapshot.TotalBytes)</strong><span>@L["Allocation:Summary:Bytes"]</span></div>
            <div><strong class="mud-success-text">@State.Snapshot.Duration.ToString(@"mm\:ss")</strong><span>@L["Allocation:Summary:Duration"]</span></div>
        </div>

        @if (State.Snapshot.DataSource != TypeAllocationDataSource.None)
        {
            <MudAlert Severity="@(State.Snapshot.DataSource == TypeAllocationDataSource.HeapSnapshot ? Severity.Info : Severity.Success)" Variant="Variant.Outlined" Dense="true">
                @L[State.Snapshot.DataSource == TypeAllocationDataSource.HeapSnapshot ? "Allocation:Sources:HeapSnapshot" : "Allocation:Sources:Live", ProfilingDisplayFormatter.FormatLocalTime(State.Snapshot.Timestamp)]
            </MudAlert>
        }
    }

    <article class="allocation-table-panel">
        <header class="allocation-table-panel__header">
            <div><MudText Typo="Typo.overline" Class="allocation-eyebrow">@L["Allocation:Ranking:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Allocation:Ranking:Title"]</MudText></div>
            <div class="allocation-table-panel__controls">
                <MudTooltip Text="@(State.ShowFullTypeName ? L["Allocation:Actions:ShowShortNames"] : L["Allocation:Actions:ShowFullNames"])">
                    <MudToggleIconButton @bind-Toggled="State.ShowFullTypeName" Icon="@Icons.Material.Filled.ShortText" ToggledIcon="@Icons.Material.Filled.Subject" ToggledColor="Color.Primary" />
                </MudTooltip>
                <MudNumericField T="int" @bind-Value="State.TopN" Label="@L["Allocation:Ranking:Limit"]" Min="5" Max="200" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
        </header>

        @if (State.Snapshot?.Types.Count > 0)
        {
            <div class="allocation-table-scroll">
                <MudSimpleTable Dense="true" Hover="true" FixedHeader="true">
                    <thead><tr><th>#</th><th>@L["Allocation:Ranking:Columns:Type"]</th><th class="number-cell">@L["Allocation:Ranking:Columns:Instances"]</th><th class="number-cell">@L["Allocation:Ranking:Columns:TotalSize"]</th><th class="number-cell">@L["Allocation:Ranking:Columns:AverageSize"]</th><th class="number-cell">@L["Allocation:Ranking:Columns:Share"]</th><th>LOH</th></tr></thead>
                    <tbody>
                        @{ var rank = 1; }
                        @foreach (var type in State.Snapshot.Types.Take(State.TopN))
                        {
                            <tr>
                                <td>@rank</td>
                                <td class="type-name-cell"><MudTooltip Text="@type.TypeName" Placement="Placement.Right"><span class="diagnostic-value">@(State.ShowFullTypeName ? type.TypeName : type.ShortTypeName)</span></MudTooltip></td>
                                <td class="number-cell">@ProfilingDisplayFormatter.FormatCount(type.AllocationCount)</td>
                                <td class="number-cell">@ProfilingDisplayFormatter.FormatBytes(type.TotalBytes)</td>
                                <td class="number-cell">@ProfilingDisplayFormatter.FormatBytes((long)type.AverageSize)</td>
                                <td class="number-cell"><div class="allocation-share"><MudProgressLinear Value="@type.BytesPercentage" Color="@ProfilingSeverityColorResolver.GetPercentageColor(type.BytesPercentage)" Size="Size.Small" /><span>@type.BytesPercentage.ToString("F1")%</span></div></td>
                                <td>@if (type.IsLargeObjectHeap) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">LOH</MudChip> }</td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
        else if (!State.IsCollecting && State.Snapshot?.DataSource == TypeAllocationDataSource.None)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Allocation:Ranking:Empty"]</MudAlert>
        }
        else if (State.IsCollecting && State.Snapshot?.Types.Count == 0)
        {
            <div class="allocation-loading"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><MudText>@L["Allocation:Ranking:Collecting"]</MudText></div>
        }
    </article>

    @if (State.Snapshot?.DroppedEventCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L["Allocation:DroppedEvents", State.Snapshot.DroppedEventCount]</MudAlert>
    }

    <MudExpansionPanels Elevation="0">
        <MudExpansionPanel Text="@L["Allocation:Guidance:Title"]">
            <div class="allocation-guidance">
                <div><strong>@L["Allocation:Guidance:Live:Title"]</strong><span>@L["Allocation:Guidance:Live:Description"]</span></div>
                <div><strong>@L["Allocation:Guidance:Low:Title"]</strong><span>@L["Allocation:Guidance:Low:Description"]</span></div>
                <div><strong>@L["Allocation:Guidance:High:Title"]</strong><span>@L["Allocation:Guidance:High:Description"]</span></div>
                <div><strong>@L["Allocation:Guidance:Snapshot:Title"]</strong><span>@L["Allocation:Guidance:Snapshot:Description"]</span></div>
            </div>
        </MudExpansionPanel>
    </MudExpansionPanels>
</section>

@code {
    [Parameter] public bool IsLoading { get; set; }
    private TypeAllocationPanelState State { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        State = StateFactory.Create();
        State.StateChanged += HandleStateChanged;
        var result = await State.InitializeAsync();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? L["Allocation:Messages:LoadFailed"], Severity.Error);
        }
    }

    private void RefreshData() => ShowResult(State.RefreshData(), "Allocation:Messages:RefreshFailed");

    private Task StartCollection()
    {
        var result = State.StartCollection();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? L["Allocation:Messages:StartFailed"], Severity.Error);
        }
        else
        {
            Snackbar.Add(L["Allocation:Messages:Started", GetModeDisplayName(State.SelectedMode)], Severity.Success);
        }

        return Task.CompletedTask;
    }

    private void StopCollection()
    {
        var result = State.StopCollection();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? L["Allocation:Messages:StopFailed"], Severity.Error);
        }
        else
        {
            Snackbar.Add(L["Allocation:Messages:Stopped"], Severity.Success);
        }
    }

    private async Task TakeHeapSnapshot()
    {
        Snackbar.Add(L["Allocation:Messages:SnapshotStarting"], Severity.Info);
        var result = await State.TakeHeapSnapshotAsync();
        if (result.IsFailed(out var error, out var snapshot))
        {
            Snackbar.Add(error.Message ?? L["Allocation:Messages:SnapshotFailed"], Severity.Error);
            return;
        }

        Snackbar.Add(L["Allocation:Messages:SnapshotCompleted", snapshot!.UniqueTypeCount], Severity.Success);
    }

    private void ResetData()
    {
        var result = State.ResetData();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? L["Allocation:Messages:ResetFailed"], Severity.Error);
            return;
        }

        Snackbar.Add(L["Allocation:Messages:Reset"], Severity.Info);
    }

    private void ShowResult(Res result, string fallbackKey)
    {
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? L[fallbackKey], Severity.Error);
        }
    }

    private string GetModeDisplayName(AllocationSamplingMode mode) => mode switch
    {
        AllocationSamplingMode.Low => L["Allocation:Modes:Low"],
        AllocationSamplingMode.High => L["Allocation:Modes:High"],
        _ => L["Common:Unknown"]
    };

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.StateChanged -= HandleStateChanged;
        State.Dispose();
    }
}
