@using Monica.Profiling.MemoryDiagnostics.Models
@inject IStringLocalizer<MemoryAnalysisResource> L

<section class="gc-statistics-layout">
    <article class="gc-statistics-panel">
        <header class="gc-statistics-panel__header">
            <MudText Typo="Typo.overline" Class="gc-statistics-eyebrow">@L["Gc:LastCollection:Eyebrow"]</MudText>
            <MudText Typo="Typo.h6">@L["Gc:LastCollection:Title"]</MudText>
        </header>
        @if (GCInfo is not null)
        {
            <dl class="gc-definition-list">
                <div><dt>@L["Gc:Labels:Index"]</dt><dd class="diagnostic-value">@GCInfo.GCIndex</dd></div>
                <div><dt>@L["Gc:Labels:Generation"]</dt><dd><MudChip T="string" Size="Size.Small" Color="@ProfilingSeverityColorResolver.GetGenerationColor(GCInfo.Generation)">Gen @GCInfo.Generation</MudChip></dd></div>
                <div>
                    <dt>@L["Gc:Labels:Type"]</dt>
                    <dd class="gc-chip-row">
                        @if (GCInfo.WasConcurrent)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["Gc:Types:Concurrent"]</MudChip>
                        }
                        @if (GCInfo.WasCompacting)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Gc:Types:Compacting"]</MudChip>
                        }
                        @if (!GCInfo.WasConcurrent && !GCInfo.WasCompacting)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["Gc:Types:Blocking"]</MudChip>
                        }
                    </dd>
                </div>
                <div><dt>@L["Gc:Labels:PauseDuration"]</dt><dd class="diagnostic-value">@L["Common:Milliseconds", GCInfo.PauseDuration.TotalMilliseconds.ToString("F2")]</dd></div>
                <div class="gc-definition-list__wide">
                    <dt>@L["Gc:Labels:TimeShare"]</dt>
                    <dd class="gc-progress-value">
                        <MudProgressLinear Color="@ProfilingSeverityColorResolver.GetGcTimeColor(GCInfo.PauseTimePercentage)" Value="@GCInfo.PauseTimePercentage" Max="100" />
                        <span>@GCInfo.PauseTimePercentage.ToString("F2")%</span>
                    </dd>
                </div>
            </dl>
        }
        else if (!IsLoading)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Gc:LastCollection:Empty"]</MudAlert>
        }
    </article>

    <article class="gc-statistics-panel">
        <header class="gc-statistics-panel__header">
            <MudText Typo="Typo.overline" Class="gc-statistics-eyebrow">@L["Gc:Heap:Eyebrow"]</MudText>
            <MudText Typo="Typo.h6">@L["Gc:Heap:Title"]</MudText>
        </header>
        @if (GCInfo is not null)
        {
            <dl class="gc-definition-list">
                <div><dt>@L["Gc:Labels:HeapSize"]</dt><dd>@ProfilingDisplayFormatter.FormatBytes(GCInfo.HeapSizeBytes)</dd></div>
                <div>
                    <dt>@L["Gc:Labels:Fragmentation"]</dt>
                    <dd class="gc-chip-row">@ProfilingDisplayFormatter.FormatBytes(GCInfo.FragmentedBytes)<MudChip T="string" Size="Size.Small" Color="@ProfilingSeverityColorResolver.GetFragmentationColor(GCInfo.FragmentationPercent)">@GCInfo.FragmentationPercent.ToString("F1")%</MudChip></dd>
                </div>
                <div><dt>@L["Gc:Labels:Committed"]</dt><dd>@ProfilingDisplayFormatter.FormatBytes(GCInfo.CommittedBytes)</dd></div>
                <div><dt>@L["Gc:Labels:Promoted"]</dt><dd>@ProfilingDisplayFormatter.FormatBytes(GCInfo.PromotedBytes)</dd></div>
                <div><dt>@L["Gc:Labels:PinnedObjects"]</dt><dd>@GCInfo.PinnedObjectsCount</dd></div>
                <div><dt>@L["Gc:Labels:FinalizationPending"]</dt><dd class="@(GCInfo.FinalizationPendingCount > 100 ? "mud-error-text" : null)">@GCInfo.FinalizationPendingCount</dd></div>
            </dl>
        }
    </article>

    <article class="gc-statistics-panel">
        <header class="gc-statistics-panel__header">
            <MudText Typo="Typo.overline" Class="gc-statistics-eyebrow">@L["Gc:SystemMemory:Eyebrow"]</MudText>
            <MudText Typo="Typo.h6">@L["Gc:SystemMemory:Title"]</MudText>
        </header>
        @if (GCInfo is not null && GCInfo.TotalAvailableMemoryBytes > 0)
        {
            var memoryUsagePercent = (double)GCInfo.MemoryLoadBytes / GCInfo.TotalAvailableMemoryBytes * 100;
            <dl class="gc-definition-list">
                <div><dt>@L["Gc:Labels:AvailableMemory"]</dt><dd>@ProfilingDisplayFormatter.FormatBytes(GCInfo.TotalAvailableMemoryBytes)</dd></div>
                <div><dt>@L["Gc:Labels:MemoryLoad"]</dt><dd>@ProfilingDisplayFormatter.FormatBytes(GCInfo.MemoryLoadBytes)</dd></div>
                <div class="gc-definition-list__wide"><dt>@L["Gc:Labels:MemoryLoadShare"]</dt><dd><MudProgressLinear Color="@ProfilingSeverityColorResolver.GetMemoryLoadColor(memoryUsagePercent)" Value="@memoryUsagePercent" Max="100" /></dd></div>
                <div><dt>@L["Gc:Labels:HighMemoryThreshold"]</dt><dd>@ProfilingDisplayFormatter.FormatBytes(GCInfo.HighMemoryLoadThresholdBytes)</dd></div>
            </dl>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Gc:SystemMemory:Unavailable"]</MudAlert>
        }
    </article>

    <article class="gc-statistics-panel gc-statistics-panel--generations">
        <header class="gc-statistics-panel__header">
            <MudText Typo="Typo.overline" Class="gc-statistics-eyebrow">@L["Gc:Generations:Eyebrow"]</MudText>
            <MudText Typo="Typo.h6">@L["Gc:Generations:Title"]</MudText>
        </header>
        @if (GCInfo?.GenerationDetails?.Length > 0)
        {
            <div class="gc-table-scroll">
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr><th>@L["Gc:Generations:Columns:Generation"]</th><th>@L["Gc:Generations:Columns:Before"]</th><th>@L["Gc:Generations:Columns:After"]</th><th>@L["Gc:Generations:Columns:Collected"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var generation in GCInfo.GenerationDetails)
                        {
                            <tr>
                                <td><MudChip T="string" Size="Size.Small" Color="@ProfilingSeverityColorResolver.GetGenerationColor(generation.Generation)">@generation.GenerationName</MudChip></td>
                                <td>@ProfilingDisplayFormatter.FormatBytes(generation.SizeBeforeBytes)</td>
                                <td>@ProfilingDisplayFormatter.FormatBytes(generation.SizeAfterBytes)</td>
                                <td><span class="@(generation.CollectedBytes > 0 ? "mud-success-text" : null)">@(generation.CollectedBytes > 0 ? ProfilingDisplayFormatter.FormatBytes(generation.CollectedBytes) : "—")</span></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Gc:Generations:Empty"]</MudAlert>
        }
    </article>
</section>

@code {
    [Parameter] public GcDetails? GCInfo { get; set; }
    [Parameter] public bool IsLoading { get; set; }
}
