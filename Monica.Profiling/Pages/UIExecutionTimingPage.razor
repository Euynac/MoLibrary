@attribute [Route(PAGE_URL)]
@using Monica.Profiling.ExecutionTiming.Models
@inject ExecutionTimingPageStateFactory PageStateFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<ExecutionTimingResource> L
@implements IAsyncDisposable

<PageTitle>@L["Pages:ExecutionTiming:Title"]</PageTitle>

<div class="execution-timing-page">
    <header class="execution-timing-header">
        <div class="execution-timing-header__identity">
            <span class="execution-timing-header__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Timer" /></span>
            <div>
                <MudText Typo="Typo.overline" Class="execution-timing-eyebrow">@L["Page:Eyebrow"]</MudText>
                <MudText Typo="Typo.h4">@L["Pages:ExecutionTiming:Title"]</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Page:Subtitle"]</MudText>
            </div>
        </div>
        <div class="execution-timing-header__actions">
            <MudChip T="string" Size="Size.Small" Color="@(PageState.AutoRefresh ? Color.Success : Color.Default)" Icon="@(PageState.AutoRefresh ? Icons.Material.Filled.Sensors : Icons.Material.Filled.Pause)">
                @(PageState.AutoRefresh ? L["Page:Status:Live"] : L["Page:Status:Paused"])
            </MudChip>
            <MudSwitch T="bool" Value="PageState.AutoRefresh" ValueChanged="SetAutoRefresh" Color="Color.Primary" Label="@L["Page:Actions:AutoRefresh"]" />
            <MudTooltip Text="@L["Page:Actions:Refresh"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Variant="Variant.Outlined" OnClick="RefreshDataAsync" Disabled="PageState.IsLoading" />
            </MudTooltip>
        </div>
    </header>

    <main class="execution-timing-content">
        <section class="timing-summary" aria-label="@L["Summary:AriaLabel"]">
            <article><span>@L["Summary:Running"]</span><strong class="mud-success-text">@PageState.RunningOperations.Count</strong></article>
            <article><span>@L["Summary:Operations"]</span><strong class="mud-primary-text">@PageState.Statistics.Count</strong></article>
            <article><span>@L["Summary:Samples"]</span><strong class="mud-info-text">@PageState.Statistics.Sum(item => item.ExecutionCount)</strong></article>
            <article><span>@L["Summary:Average"]</span><strong class="mud-warning-text">@FormatAverageDuration()</strong></article>
        </section>

        <section class="timing-panel timing-panel--running">
            <header class="timing-panel__header">
                <div><MudText Typo="Typo.overline" Class="execution-timing-eyebrow">@L["Running:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Running:Title"]</MudText></div>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Common:Count", PageState.RunningOperations.Count]</MudChip>
            </header>
            @if (PageState.RunningOperations.Count > 0)
            {
                <div class="timing-table-scroll">
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead><tr><th>@L["Columns:Name"]</th><th>@L["Columns:Description"]</th><th>@L["Columns:StartedAt"]</th><th class="number-cell">@L["Columns:CurrentDuration"]</th><th class="number-cell">@L["Columns:RunningFor"]</th></tr></thead>
                        <tbody>
                            @foreach (var operation in PageState.RunningOperations)
                            {
                                <tr><td class="diagnostic-value">@operation.DisplayName</td><td>@(operation.Description ?? L["Common:Unavailable"])</td><td>@ExecutionTimingDisplayFormatter.FormatDateTime(operation.StartedAt)</td><td class="number-cell diagnostic-value mud-success-text">@ExecutionTimingDisplayFormatter.FormatDuration(operation.GetCurrentElapsedMs())</td><td class="number-cell">@ExecutionTimingDisplayFormatter.FormatRunningDuration(operation)</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
            else
            {
                <div class="timing-empty"><MudIcon Icon="@Icons.Material.Outlined.HourglassEmpty" /><span>@L["Running:Empty"]</span></div>
            }
        </section>

        <section class="timing-panel">
            <header class="timing-panel__header">
                <div><MudText Typo="Typo.overline" Class="execution-timing-eyebrow">@L["Statistics:Eyebrow"]</MudText><MudText Typo="Typo.h6">@L["Statistics:Title"]</MudText></div>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@L["Common:Count", PageState.Statistics.Count]</MudChip>
            </header>
            @if (PageState.Statistics.Count > 0)
            {
                <div class="timing-table-scroll">
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead><tr><th>@L["Columns:Name"]</th><th class="number-cell">@L["Columns:Executions"]</th><th class="number-cell">@L["Columns:AverageDuration"]</th><th class="number-cell">@L["Columns:LastDuration"]</th><th class="number-cell">@L["Columns:Rate"]</th><th class="number-cell">@L["Columns:AverageMemory"]</th><th class="number-cell">@L["Columns:LastMemory"]</th><th>@L["Columns:LastRecordedAt"]</th></tr></thead>
                        <tbody>
                            @foreach (var statistics in PageState.Statistics)
                            {
                                <tr><td class="diagnostic-value">@statistics.DisplayName</td><td class="number-cell">@statistics.ExecutionCount</td><td class="number-cell diagnostic-value mud-warning-text">@ExecutionTimingDisplayFormatter.FormatDuration(statistics.AverageDurationMs)</td><td class="number-cell diagnostic-value">@ExecutionTimingDisplayFormatter.FormatDuration(statistics.LastDurationMs)</td><td class="number-cell">@ExecutionTimingDisplayFormatter.FormatRatePerMinute(statistics)</td><td class="number-cell">@ExecutionTimingDisplayFormatter.FormatMemory(statistics.AverageMemoryBytes)</td><td class="number-cell">@ExecutionTimingDisplayFormatter.FormatMemory(statistics.LastMemoryBytes)</td><td>@ExecutionTimingDisplayFormatter.FormatDateTime(statistics.LastRecordedAt)</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
            else
            {
                <div class="timing-empty"><MudIcon Icon="@Icons.Material.Outlined.QueryStats" /><span>@L["Statistics:Empty"]</span></div>
            }
        </section>
    </main>
</div>

@code {
    public const string PAGE_URL = "/execution-timing";
    private ExecutionTimingPageState PageState { get; set; } = null!;
    private bool _disposed;

    protected override void OnInitialized() => PageState = PageStateFactory.Create();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        PageState.StateChanged += HandleStateChanged;
        var result = await PageState.InitializeAsync();
        if (!_disposed && result.IsFailed(out var error)) Snackbar.Add(error.Message ?? L["Page:Messages:RefreshFailed"], Severity.Error);
    }

    private async Task RefreshDataAsync()
    {
        var result = await PageState.RefreshAsync();
        if (!_disposed && result.IsFailed(out var error)) Snackbar.Add(error.Message ?? L["Page:Messages:RefreshFailed"], Severity.Error);
    }

    private Task SetAutoRefresh(bool value) => PageState.SetAutoRefreshAsync(value);
    private string FormatAverageDuration() => PageState.Statistics.Count == 0 ? L["Common:Unavailable"] : ExecutionTimingDisplayFormatter.FormatDuration(PageState.Statistics.Average(item => item.AverageDurationMs));
    private void HandleStateChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        PageState.StateChanged -= HandleStateChanged;
        await PageState.DisposeAsync();
    }
}
