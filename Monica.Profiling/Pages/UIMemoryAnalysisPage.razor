@attribute [Route(PAGE_URL)]
@using Monica.Modules
@using Monica.Profiling.UIMemoryAnalysis.Components
@inject IServiceProvider ServiceProvider
@inject ISnackbar Snackbar
@inject IStringLocalizer<MemoryAnalysisResource> L
@inject IStringLocalizer<ProfilingResource> ProfilingL
@implements IAsyncDisposable

<PageTitle>@(_pageState is null ? ProfilingL["Unavailable:MemoryAnalysis:PageTitle"] : L["Pages:MemoryAnalysis:Title"])</PageTitle>

<div class="memory-analysis-page">
    @if (_pageState is null)
    {
        <ProfilingModuleUnavailable HeadingId="memory-analysis-unavailable-title"
                                    Icon="@Icons.Material.Filled.Memory"
                                    Eyebrow="@ProfilingL["Unavailable:Eyebrow"]"
                                    Title="@ProfilingL["Unavailable:MemoryAnalysis:Title"]"
                                    Description="@ProfilingL["Unavailable:MemoryAnalysis:Description"]" />
    }
    else
    {
        <header class="memory-analysis-header">
            <div class="memory-analysis-header__identity">
                <span class="memory-analysis-header__icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Memory" />
                </span>
                <div class="memory-analysis-header__copy">
                    <MudText Typo="Typo.overline" Class="memory-analysis-eyebrow">@L["Page:Eyebrow"]</MudText>
                    <MudText Typo="Typo.h4">@L["Pages:MemoryAnalysis:Title"]</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Page:Subtitle"]</MudText>
                </div>
            </div>

            <div class="memory-analysis-header__actions">
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(_pageState.AutoRefresh ? Color.Success : Color.Default)"
                         Icon="@(_pageState.AutoRefresh ? Icons.Material.Filled.Sensors : Icons.Material.Filled.Pause)">
                    @(_pageState.AutoRefresh ? L["Page:Status:Live"] : L["Page:Status:Paused"])
                </MudChip>
                <MudSwitch T="bool"
                           Value="@_pageState.AutoRefresh"
                           ValueChanged="SetAutoRefresh"
                           Color="Color.Primary"
                           Label="@L["Page:Actions:AutoRefresh"]" />
                <MudTooltip Text="@L["Page:Actions:Refresh"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Primary"
                                   Variant="Variant.Outlined"
                                   OnClick="RefreshDataAsync"
                                   Disabled="_pageState.IsLoading" />
                </MudTooltip>
            </div>
        </header>

        <section class="memory-analysis-workspace">
            <MudTabs Rounded="true"
                     Color="Color.Primary"
                     ApplyEffectsToContainer="true"
                     TabPanelsClass="memory-analysis-tab-panel"
                     @bind-ActivePanelIndex="_pageState.ActiveTabIndex">
                <MudTabPanel Text="@L["Tabs:Overview"]" Icon="@Icons.Material.Filled.Memory">
                    <MemoryOverviewCard Snapshot="_pageState.CurrentSnapshot" IsLoading="_pageState.IsLoading" />
                </MudTabPanel>

                <MudTabPanel Text="@L["Tabs:GcStatistics"]" Icon="@Icons.Material.Filled.Analytics">
                    <GCStatisticsCard GCInfo="_pageState.CurrentGcDetails" IsLoading="_pageState.IsLoading" />
                </MudTabPanel>

                <MudTabPanel Text="@L["Tabs:Trend"]" Icon="@Icons.Material.Filled.Timeline">
                    <MemoryTrendChart TrendData="_pageState.TrendData" IsLoading="_pageState.IsLoading" />
                </MudTabPanel>

                @if (_pageState.IsTypeAllocationTabEnabled)
                {
                    <MudTabPanel Text="@L["Tabs:Allocation"]" Icon="@Icons.Material.Filled.Category">
                        <TypeAllocationCard IsLoading="_pageState.IsLoading" />
                    </MudTabPanel>
                }

                <MudTabPanel Text="@L["Tabs:Diagnostics"]" Icon="@Icons.Material.Filled.Build">
                    <DiagnosticActionsCard Options="_pageState.Options"
                                           OnForceGC="HandleForceGcAsync"
                                           OnCreateDump="HandleCreateDumpAsync"
                                           IsLoading="_pageState.IsLoading" />
                </MudTabPanel>
            </MudTabs>
        </section>
    }
</div>

@code {
    public const string PAGE_URL = "/memory-analysis";
    private MemoryAnalysisPageState? _pageState;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _pageState = ServiceProvider.GetService<MemoryAnalysisPageStateFactory>()?.Create();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _pageState is null)
        {
            return;
        }

        _pageState.StateChanged += HandleStateChanged;
        var result = await _pageState.InitializeAsync();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? L["Page:Messages:RefreshFailed"], Severity.Error);
        }
    }

    private async Task RefreshDataAsync()
    {
        if (_pageState is null)
        {
            return;
        }

        var result = await _pageState.RefreshAsync();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? L["Page:Messages:RefreshFailed"], Severity.Error);
        }
    }

    private Task SetAutoRefresh(bool value) => _pageState?.SetAutoRefreshAsync(value) ?? Task.CompletedTask;

    private async Task HandleForceGcAsync(int generation)
    {
        if (_pageState is null)
        {
            return;
        }

        var result = await _pageState.ForceGarbageCollectionAsync(generation);
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? L["Page:Messages:GcFailed"], Severity.Error);
            return;
        }

        Snackbar.Add(
            L["Page:Messages:GcCompleted", generation < 0 ? L["Diagnostics:FullCollection"] : $"Gen {generation}"],
            Severity.Success);
    }

    private async Task HandleCreateDumpAsync()
    {
        if (_pageState is null)
        {
            return;
        }

        Snackbar.Add(L["Page:Messages:DumpStarting"], Severity.Info);

        var result = await _pageState.CreateGcDumpAsync();
        if (result.IsFailed(out var error, out var dumpPath))
        {
            Snackbar.Add(error.Message ?? L["Page:Messages:OperationFailed"], Severity.Error);
            return;
        }

        Snackbar.Add(L["Page:Messages:DumpCreated", dumpPath], Severity.Success);
    }

    private void HandleStateChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_pageState is null)
        {
            return;
        }

        _pageState.StateChanged -= HandleStateChanged;
        await _pageState.DisposeAsync();
    }
}
