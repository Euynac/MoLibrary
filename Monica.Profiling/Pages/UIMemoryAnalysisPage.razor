@attribute [Route(PAGE_URL)]
@using Monica.Modules
@using Monica.Profiling.UIMemoryAnalysis.Components
@inject MemoryAnalysisPageState PageState
@inject IOptions<ModuleMemoryAnalysisUIOption> Options
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>内存分析</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">内存分析</MudText>
        <div class="d-flex gap-2 align-center">
            <MudSwitch T="bool"
                       Value="@PageState.AutoRefresh"
                       ValueChanged="SetAutoRefresh"
                       Color="Color.Primary"
                       Label="自动刷新"/>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary"
                           OnClick="RefreshDataAsync"
                           Disabled="PageState.IsLoading"/>
        </div>
    </div>

    <MudTabs Elevation="4" Rounded="true" Color="Color.Primary"
             @bind-ActivePanelIndex="PageState.ActiveTabIndex">
        <MudTabPanel Text="内存概览" Icon="@Icons.Material.Filled.Memory">
            <div class="pa-4">
                <MemoryOverviewCard Snapshot="PageState.CurrentSnapshot" IsLoading="PageState.IsLoading"/>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="GC 统计" Icon="@Icons.Material.Filled.Analytics">
            <div class="pa-4">
                <GCStatisticsCard GCInfo="PageState.CurrentGcDetails" IsLoading="PageState.IsLoading"/>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="内存趋势" Icon="@Icons.Material.Filled.Timeline">
            <div class="pa-4">
                <MemoryTrendChart TrendData="PageState.TrendData" IsLoading="PageState.IsLoading"/>
            </div>
        </MudTabPanel>

        @if (PageState.IsTypeAllocationTabEnabled)
        {
            <MudTabPanel Text="类型分配" Icon="@Icons.Material.Filled.Category">
                <div class="pa-4">
                    <TypeAllocationCard IsLoading="PageState.IsLoading"/>
                </div>
            </MudTabPanel>
        }

        <MudTabPanel Text="诊断操作" Icon="@Icons.Material.Filled.Build">
            <div class="pa-4">
                <DiagnosticActionsCard Options="Options.Value"
                                       OnForceGC="HandleForceGcAsync"
                                       OnCreateDump="HandleCreateDumpAsync"
                                       IsLoading="PageState.IsLoading"/>
            </div>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    public const string PAGE_URL = "/memory-analysis";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        PageState.StateChanged += HandleStateChanged;
        var result = await PageState.InitializeAsync();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? "刷新数据失败", Severity.Error);
        }
    }

    private async Task RefreshDataAsync()
    {
        var result = await PageState.RefreshAsync();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? "刷新数据失败", Severity.Error);
        }
    }

    private Task SetAutoRefresh(bool value)
    {
        PageState.SetAutoRefresh(value);
        return Task.CompletedTask;
    }

    private async Task HandleForceGcAsync(int generation)
    {
        var result = await PageState.ForceGarbageCollectionAsync(generation);
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? "GC 执行失败", Severity.Error);
            return;
        }

        Snackbar.Add(
            $"GC 已完成 (Generation: {(generation < 0 ? "Full" : generation.ToString())})",
            Severity.Success);
    }

    private async Task HandleCreateDumpAsync()
    {
        Snackbar.Add("正在创建 GC Dump，请稍候...", Severity.Info);

        var result = await PageState.CreateGcDumpAsync();
        if (result.IsFailed(out var error, out var dumpPath))
        {
            Snackbar.Add(error.Message ?? "操作失败", Severity.Error);
            return;
        }

        Snackbar.Add($"GC Dump 已创建: {dumpPath}", Severity.Success);
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        PageState.StateChanged -= HandleStateChanged;
        PageState.Dispose();
    }
}
