@attribute [Route(PAGE_URL)]
@using Monica.Profiling.UIProfiling.Components
@inject ProfilingMonitorPageState PageState
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>快速监控</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Large" Color="Color.Primary"/>
            <MudText Typo="Typo.h4">快速监控</MudText>
        </div>
        <div class="d-flex gap-2 align-center">
            <MudChip T="string" Size="Size.Small" Color="@(PageState.AutoRefresh ? Color.Success : Color.Default)">
                @(PageState.AutoRefresh ? "实时" : "已暂停")
            </MudChip>
            <MudSwitch T="bool"
                       Value="@PageState.AutoRefresh"
                       ValueChanged="SetAutoRefresh"
                       Color="Color.Primary"
                       Label="自动刷新"/>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary"
                           OnClick="RefreshDataAsync"
                           Disabled="PageState.IsLoading"/>
        </div>
    </div>

    <div class="mb-4">
        <QuickMonitorCard DataPoint="PageState.CurrentDataPoint"
                          PreviousDataPoint="PageState.PreviousDataPoint"
                          IsLoading="PageState.IsLoading"/>
    </div>

    <QuickMonitorTrendChart TrendData="PageState.TrendData" IsLoading="PageState.IsLoading"/>
</MudContainer>

@code {
    public const string PAGE_URL = "/quick-monitor";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        PageState.StateChanged += HandleStateChanged;
        var result = await PageState.InitializeAsync();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? "刷新数据失败", Severity.Error);
        }
    }

    private async Task RefreshDataAsync()
    {
        var result = await PageState.RefreshAsync();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(error.Message ?? "刷新数据失败", Severity.Error);
        }
    }

    private Task SetAutoRefresh(bool value)
    {
        PageState.SetAutoRefresh(value);
        return Task.CompletedTask;
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        PageState.StateChanged -= HandleStateChanged;
        PageState.Dispose();
    }
}
