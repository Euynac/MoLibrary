<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<PackageDescription>Performance profiling and diagnostics for Monica framework with ETW/EventPipe allocation tracking and heap snapshot analysis using Microsoft.Diagnostics tools.</PackageDescription>
	</PropertyGroup>

	<ItemGroup>
		<!-- For ETW/EventPipe allocation tracking -->
		<PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.2" />
		<!-- For heap snapshot analysis -->
		<PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.0.726301"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Monica.Core\Monica.Core.csproj"/>
		<ProjectReference Include="..\Monica.Tool\Monica.Tool.csproj"/>
		<ProjectReference Include="..\Monica.UI\Monica.UI.csproj"/>
	</ItemGroup>

</Project>
