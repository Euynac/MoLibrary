@using Monica.Profiling.RuntimeMetrics.Models
@inject IStringLocalizer<RuntimeMetricsResource> L

<section class="runtime-vitals" aria-label="@L["Vitals:AriaLabel"]">
    <article class="runtime-vital runtime-vital--cpu">
        <span class="runtime-vital__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Speed" /></span>
        <div class="runtime-vital__copy">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Vitals:Cpu"]</MudText>
            <MudText Typo="Typo.h5" Color="@ProfilingSeverityColorResolver.GetCpuColor(DataPoint?.CpuUsagePercent ?? 0)">
                @LoadingOr($"{DataPoint?.CpuUsagePercent ?? 0:F1}%")
            </MudText>
        </div>
        <div class="runtime-vital__progress">
            <MudProgressLinear Color="@ProfilingSeverityColorResolver.GetCpuColor(DataPoint?.CpuUsagePercent ?? 0)"
                               Value="@(DataPoint?.CpuUsagePercent ?? 0)" />
        </div>
    </article>

    <article class="runtime-vital runtime-vital--primary">
        <span class="runtime-vital__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Storage" /></span>
        <div class="runtime-vital__copy">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Vitals:WorkingSet"]</MudText>
            <MudText Typo="Typo.h5" Color="Color.Primary">@LoadingOr($"{DataPoint?.WorkingSetMB ?? 0:F1} MB")</MudText>
        </div>
        @if (PreviousDataPoint is not null && DataPoint is not null)
        {
            var delta = DataPoint.WorkingSetMB - PreviousDataPoint.WorkingSetMB;
            <span class="runtime-vital__delta @(delta >= 0 ? "is-rising" : "is-falling")">
                <MudIcon Icon="@(delta >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)" Size="Size.Small" />
                @L["Vitals:Delta", delta >= 0 ? "+" : string.Empty, delta.ToString("F1"), "MB"]
            </span>
        }
    </article>

    <article class="runtime-vital runtime-vital--info">
        <span class="runtime-vital__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.AccountTree" /></span>
        <div class="runtime-vital__copy">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Vitals:Threads"]</MudText>
            <MudText Typo="Typo.h5" Color="Color.Info">@LoadingOr((DataPoint?.ThreadCount ?? 0).ToString())</MudText>
        </div>
    </article>

    <article class="runtime-vital runtime-vital--gc">
        <span class="runtime-vital__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.CleaningServices" /></span>
        <div class="runtime-vital__copy">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Vitals:GcTime"]</MudText>
            <MudText Typo="Typo.h5" Color="@ProfilingSeverityColorResolver.GetGcTimeColor(DataPoint?.TimeInGcPercent ?? 0)">
                @LoadingOr($"{DataPoint?.TimeInGcPercent ?? 0:F1}%")
            </MudText>
        </div>
        <div class="runtime-vital__progress">
            <MudProgressLinear Color="@ProfilingSeverityColorResolver.GetGcTimeColor(DataPoint?.TimeInGcPercent ?? 0)"
                               Value="@Math.Min(DataPoint?.TimeInGcPercent ?? 0, 100)" />
        </div>
    </article>

    <article class="runtime-vital runtime-vital--warning">
        <span class="runtime-vital__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.DataUsage" /></span>
        <div class="runtime-vital__copy">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Vitals:AllocationRate"]</MudText>
            <MudText Typo="Typo.h5" Color="Color.Warning">
                @LoadingOr(ProfilingDisplayFormatter.FormatBytesPerSecond(DataPoint?.AllocationRateBps ?? 0))
            </MudText>
        </div>
    </article>

    <article class="runtime-vital runtime-vital--success">
        <span class="runtime-vital__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Memory" /></span>
        <div class="runtime-vital__copy">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Vitals:GcHeap"]</MudText>
            <MudText Typo="Typo.h5" Color="Color.Success">@LoadingOr($"{DataPoint?.GcHeapSizeMB ?? 0:F1} MB")</MudText>
        </div>
        @if (PreviousDataPoint is not null && DataPoint is not null)
        {
            var delta = DataPoint.GcHeapSizeMB - PreviousDataPoint.GcHeapSizeMB;
            <span class="runtime-vital__delta @(delta >= 0 ? "is-rising" : "is-falling")">
                <MudIcon Icon="@(delta >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)" Size="Size.Small" />
                @L["Vitals:Delta", delta >= 0 ? "+" : string.Empty, delta.ToString("F1"), "MB"]
            </span>
        }
    </article>
</section>

@code {
    [Parameter] public RuntimeMetricsPoint? DataPoint { get; set; }
    [Parameter] public RuntimeMetricsPoint? PreviousDataPoint { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private string LoadingOr(string value) => IsLoading ? L["Common:LoadingValue"] : value;
}
