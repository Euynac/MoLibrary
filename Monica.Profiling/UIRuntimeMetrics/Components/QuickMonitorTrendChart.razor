@using Monica.Profiling.RuntimeMetrics.Models
@* Quick Monitoring Trend Graph - Shows CPU and Memory Trends *@
<MudGrid Spacing="3">
    @* Trend chart *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.h6">实时趋势</MudText>
                <MudChipSet T="string" SelectedValuesChanged="OnMetricSelectionChanged" SelectionMode="SelectionMode.MultiSelection">
                    <MudChip T="string" Value="@("cpu")" Default="true" Color="Color.Primary">CPU %</MudChip>
                    <MudChip T="string" Value="@("memory")" Default="true" Color="Color.Success">内存 MB</MudChip>
                </MudChipSet>
            </div>
            @if (TrendData?.DataPoints.Count > 1)
            {
                <div class="chart-container">
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@chartSeries"
                              ChartLabels="@timeLabels"
                              Width="100%"
                              Height="500px"
                              ChartOptions="@chartOptions"/>
                </div>
            }
            else if (!IsLoading)
            {
                <MudAlert Severity="Severity.Info">暂无趋势数据，请等待数据采集...</MudAlert>
            }
            else
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px"/>
            }
        </MudPaper>
    </MudItem>

    @* Recent data table *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">最近数据 (最新10条)</MudText>
            @if (TrendData?.DataPoints.Count > 0)
            {
                <MudSimpleTable Dense="true" Hover="true" FixedHeader="true" Style="max-height: 300px; overflow-y: auto;">
                    <thead>
                    <tr>
                        <th>时间</th>
                        <th>CPU %</th>
                        <th>工作集</th>
                        <th>GC 堆</th>
                        <th>线程数</th>
                        <th>GC 时间%</th>
                        <th>分配速率</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var point in TrendData.DataPoints.TakeLast(10).Reverse())
                    {
                        <tr>
                            <td>@ProfilingDisplayFormatter.FormatLocalTime(point.Timestamp)</td>
                            <td>
                                <span class="@ProfilingSeverityColorResolver.GetCpuClass(point.CpuUsagePercent)">
                                    @point.CpuUsagePercent.ToString("F1")%
                                </span>
                            </td>
                            <td>@point.WorkingSetMB.ToString("F1") MB</td>
                            <td>@point.GcHeapSizeMB.ToString("F1") MB</td>
                            <td>@point.ThreadCount</td>
                            <td>
                                <span class="@ProfilingSeverityColorResolver.GetGcTimeClass(point.TimeInGcPercent)">
                                    @point.TimeInGcPercent.ToString("F1")%
                                </span>
                            </td>
                            <td>@ProfilingDisplayFormatter.FormatBytesPerSecond(point.AllocationRateBps)</td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info">暂无数据</MudAlert>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public RuntimeMetricsTrend? TrendData { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private List<ChartSeries<double>> chartSeries = [];
    private string[] timeLabels = [];
    private bool showCpu = true;
    private bool showMemory = true;

    private ChartOptions chartOptions = new();

    protected override void OnParametersSet()
    {
        UpdateChartData();
    }

    private void OnMetricSelectionChanged(IReadOnlyCollection<string> selectedValues)
    {
        showCpu = selectedValues.Contains("cpu");
        showMemory = selectedValues.Contains("memory");
        UpdateChartData();
    }

    private void UpdateChartData()
    {
        if (TrendData?.DataPoints == null || TrendData.DataPoints.Count < 2)
            return;

        // Sampling to reduce chart data points (display up to 50 points)
        var step = Math.Max(1, TrendData.DataPoints.Count / 50);
        var sampledData = TrendData.DataPoints
            .Where((_, i) => i % step == 0 || i == TrendData.DataPoints.Count - 1)
            .ToList();

        timeLabels = sampledData
            .Select(p => ProfilingDisplayFormatter.FormatLocalTime(p.Timestamp))
            .ToArray();

        chartSeries = [];

        if (showCpu)
        {
            chartSeries.Add(new ChartSeries<double>
            {
                Name = "CPU %",
                Data = sampledData.Select(p => p.CpuUsagePercent).ToArray()
            });
        }

        if (showMemory)
        {
            chartSeries.Add(new ChartSeries<double>
            {
                Name = "工作集 MB",
                Data = sampledData.Select(p => p.WorkingSetMB).ToArray()
            });
        }
    }

}
