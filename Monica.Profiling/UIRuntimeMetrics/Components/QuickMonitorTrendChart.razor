@using Monica.Profiling.RuntimeMetrics.Models
@inject IStringLocalizer<RuntimeMetricsResource> L

<section class="runtime-trend-layout">
    <article class="runtime-trend-panel runtime-trend-panel--chart">
        <header class="runtime-trend-panel__header">
            <div>
                <MudText Typo="Typo.overline" Class="runtime-trend-eyebrow">@L["Trend:Eyebrow"]</MudText>
                <MudText Typo="Typo.h6">@L["Trend:Title"]</MudText>
            </div>
            <MudChipSet T="string"
                        SelectedValuesChanged="OnMetricSelectionChanged"
                        SelectionMode="SelectionMode.MultiSelection">
                <MudChip T="string" Value="@("cpu")" Default="true" Color="Color.Primary">@L["Trend:Metrics:Cpu"]</MudChip>
                <MudChip T="string" Value="@("memory")" Default="true" Color="Color.Success">@L["Trend:Metrics:Memory"]</MudChip>
            </MudChipSet>
        </header>

        @if (TrendData?.DataPoints.Count > 1)
        {
            <div class="runtime-trend-chart" aria-label="@L["Trend:ChartAriaLabel"]">
                <MudChart ChartType="ChartType.Line"
                          ChartSeries="@_chartSeries"
                          ChartLabels="@_timeLabels"
                          Width="100%"
                          Height="360px"
                          ChartOptions="@_chartOptions" />
            </div>
        }
        else if (!IsLoading)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Trend:Waiting"]</MudAlert>
        }
        else
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" />
        }
    </article>

    <article class="runtime-trend-panel runtime-trend-panel--table">
        <header class="runtime-trend-panel__header">
            <div>
                <MudText Typo="Typo.overline" Class="runtime-trend-eyebrow">@L["Recent:Eyebrow"]</MudText>
                <MudText Typo="Typo.h6">@L["Recent:Title"]</MudText>
            </div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                @L["Recent:Count", Math.Min(TrendData?.DataPoints.Count ?? 0, 10)]
            </MudChip>
        </header>

        @if (TrendData?.DataPoints.Count > 0)
        {
            <div class="runtime-table-scroll">
                <MudSimpleTable Dense="true" Hover="true" FixedHeader="true">
                    <thead>
                        <tr>
                            <th>@L["Recent:Columns:Time"]</th>
                            <th>@L["Recent:Columns:Cpu"]</th>
                            <th>@L["Recent:Columns:WorkingSet"]</th>
                            <th>@L["Recent:Columns:GcHeap"]</th>
                            <th>@L["Recent:Columns:Threads"]</th>
                            <th>@L["Recent:Columns:GcTime"]</th>
                            <th>@L["Recent:Columns:AllocationRate"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in TrendData.DataPoints.TakeLast(10).Reverse())
                        {
                            <tr>
                                <td class="diagnostic-value">@ProfilingDisplayFormatter.FormatLocalTime(point.Timestamp)</td>
                                <td><span class="@ProfilingSeverityColorResolver.GetCpuClass(point.CpuUsagePercent)">@point.CpuUsagePercent.ToString("F1")%</span></td>
                                <td>@point.WorkingSetMB.ToString("F1") MB</td>
                                <td>@point.GcHeapSizeMB.ToString("F1") MB</td>
                                <td>@point.ThreadCount</td>
                                <td><span class="@ProfilingSeverityColorResolver.GetGcTimeClass(point.TimeInGcPercent)">@point.TimeInGcPercent.ToString("F1")%</span></td>
                                <td>@ProfilingDisplayFormatter.FormatBytesPerSecond(point.AllocationRateBps)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Recent:Empty"]</MudAlert>
        }
    </article>
</section>

@code {
    [Parameter] public RuntimeMetricsTrend? TrendData { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private List<ChartSeries<double>> _chartSeries = [];
    private string[] _timeLabels = [];
    private bool _showCpu = true;
    private bool _showMemory = true;
    private readonly ChartOptions _chartOptions = new();

    protected override void OnParametersSet() => UpdateChartData();

    private void OnMetricSelectionChanged(IReadOnlyCollection<string> selectedValues)
    {
        _showCpu = selectedValues.Contains("cpu");
        _showMemory = selectedValues.Contains("memory");
        UpdateChartData();
    }

    private void UpdateChartData()
    {
        if (TrendData?.DataPoints is not { Count: >= 2 } dataPoints)
        {
            _chartSeries = [];
            _timeLabels = [];
            return;
        }

        var step = Math.Max(1, dataPoints.Count / 50);
        var sampledData = dataPoints
            .Where((_, index) => index % step == 0 || index == dataPoints.Count - 1)
            .ToList();

        _timeLabels = sampledData
            .Select(point => ProfilingDisplayFormatter.FormatLocalTime(point.Timestamp))
            .ToArray();

        _chartSeries = [];
        if (_showCpu)
        {
            _chartSeries.Add(new ChartSeries<double>
            {
                Name = L["Trend:Series:Cpu"],
                Data = sampledData.Select(point => point.CpuUsagePercent).ToArray()
            });
        }

        if (_showMemory)
        {
            _chartSeries.Add(new ChartSeries<double>
            {
                Name = L["Trend:Series:WorkingSet"],
                Data = sampledData.Select(point => point.WorkingSetMB).ToArray()
            });
        }
    }
}
