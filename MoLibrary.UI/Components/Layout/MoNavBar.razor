@using Microsoft.Extensions.Options
@using MoLibrary.UI.Modules
@using MoLibrary.UI.UICore.Interfaces
@using MoLibrary.UI.UICore.Models
@inject IUIComponentRegistry UIRegistry
@inject IOptions<ModuleUICoreOption> Options

<nav class="mo-navbar">
    <MoNavBarBrand />

    <div class="navbar-nav">
        @foreach (var category in VisibleCategories)
        {
            <MoNavBarDropdown Category="@category"
                            Items="@GetItemsInCategory(category)" />
        }

        @if (HasMoreCategories)
        {
            <MoNavBarMore Categories="@MoreCategories" />
        }
    </div>

    <MoNavBarActions />
</nav>

@code {
    private Dictionary<string, List<UINavItem>> _categorizedNavItems = new();
    private int _maxVisibleCategories = 4; // 可配置

    protected override void OnInitialized()
    {
        var allNavItems = UIRegistry.GetNavItems();
        _categorizedNavItems = allNavItems
            .GroupBy(item => item.Category ?? "未分类")
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private IEnumerable<string> VisibleCategories =>
        _categorizedNavItems.Keys.Take(_maxVisibleCategories);

    private bool HasMoreCategories =>
        _categorizedNavItems.Count > _maxVisibleCategories;

    private Dictionary<string, List<UINavItem>> MoreCategories =>
        _categorizedNavItems
            .Skip(_maxVisibleCategories)
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

    private List<UINavItem> GetItemsInCategory(string category) =>
        _categorizedNavItems.TryGetValue(category, out var items) ? items : new();
}
