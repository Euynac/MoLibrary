@using MoLibrary.UI.UICore.Models

<div class="navbar-more"
     @onmouseenter="OnMouseEnter"
     @onmouseleave="OnMouseLeave">

    <button class="navbar-link">
        更多
        <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" />
    </button>

    @if (_isDropdownOpen)
    {
        <div class="dropdown-menu more-menu">
            <div class="more-menu-header">
                <span>更多模块</span>
            </div>
            @foreach (var category in Categories.OrderBy(c => c.Key))
            {
                <div class="more-category-item"
                     @onmouseenter="() => OnCategoryHover(category.Key)"
                     @onmouseleave="OnCategoryLeave">

                    <div class="category-header">
                        <span>@category.Key</span>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </div>

                    @if (_activeFlyoutCategory == category.Key)
                    {
                        <div class="flyout-menu">
                            <div class="flyout-menu-header">
                                <span>@category.Key</span>
                            </div>
                            @foreach (var item in category.Value.OrderBy(i => i.Order))
                            {
                                <MudNavLink Href="@item.Href"
                                           Class="flyout-item"
                                           Match="@item.NavLinkMatch">
                                    @if (!string.IsNullOrEmpty(item.Icon))
                                    {
                                        <MudIcon Icon="@item.Icon" Size="Size.Small" Class="item-icon" />
                                    }
                                    <span>@item.Text</span>
                                </MudNavLink>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Dictionary<string, List<UINavItem>> Categories { get; set; } = new();

    private bool _isDropdownOpen = false;
    private string? _activeFlyoutCategory = null;

    private void OnMouseEnter()
    {
        _isDropdownOpen = true;
        StateHasChanged();
    }

    private void OnMouseLeave()
    {
        _isDropdownOpen = false;
        _activeFlyoutCategory = null;
        StateHasChanged();
    }

    private void OnCategoryHover(string category)
    {
        _activeFlyoutCategory = category;
        StateHasChanged();
    }

    private void OnCategoryLeave()
    {
        // 不立即清除，允许鼠标移动到侧滑菜单
    }
}
