<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Monica.Guide</AssemblyName>
    <!-- Clear the solution-wide single-TargetFramework pin so the multi-target dispatch runs;
         Windows comes first so a plain Windows dev run keeps the native folder picker. -->
    <TargetFramework />
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- Restore and compile the windows TFM on Linux/macOS CI too (reference packs come
         from NuGet); only executing the windows build requires a Windows host. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- WPF's OpenFolderDialog is the modern Explorer folder picker: typed-path address
         bar plus the Quick Access navigation tree, without any third-party package. -->
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- The WinForms SDK supplied System.IO implicitly; WPF does not, so keep it. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Monica.Guide.Engine/Monica.Guide.Engine.csproj" />
  </ItemGroup>

</Project>
