@inherits LayoutComponentBase
@implements IDisposable

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-row">
                <span class="monica-mark" aria-hidden="true">
                    <i class="mark-plane mark-plane-violet"></i>
                    <i class="mark-plane mark-plane-ink"></i>
                    <i class="mark-cut"></i>
                </span>
                <div class="brand-text">
                    <div class="brand-name">Monica Guide</div>
                </div>
            </div>
            <span class="release-stamp" title="@GuideAppInfo.CurrentVersion">@ProductVersion</span>
        </div>
        <nav class="nav">
            <NavLink class="nav-item" ActiveClass="active" href="" Match="NavLinkMatch.All">
                <span>@Session.T("dashboard")</span>
            </NavLink>
            <NavLink class="nav-item" ActiveClass="active" href="workspaces">
                <span>@Session.T("workspaces")</span>
            </NavLink>
            <NavLink class="nav-item" ActiveClass="active" href="install">
                <span>@Session.T("install")</span>
            </NavLink>
            <NavLink class="nav-item" ActiveClass="active" href="update">
                <span>@Session.T("update")</span>
            </NavLink>
            <NavLink class="nav-item" ActiveClass="active" href="uninstall">
                <span>@Session.T("uninstall")</span>
            </NavLink>
        </nav>
        <div class="sidebar-footer">
            <div class="footer-tools">
                <button class="tool-btn" @onclick="Session.ToggleLanguage">
                    <Icon Name="globe" Size="14"/>
                    @LanguageSwitchLabel
                </button>
                <button class="tool-btn" @onclick="ToggleTheme">
                    <Icon Name="@ThemeIcon" Size="14"/>
                    @ThemeLabel
                </button>
            </div>
            <div class="sidebar-note">
                <Icon Name="shield" Size="14"/>
                <span>127.0.0.1 · /s/token</span>
            </div>
        </div>
    </aside>
    <main class="content">
        @Body
    </main>
</div>

@code {
    [Inject]
    private SetupSession Session { get; set; } = default!;

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    // The informational version carries the full commit hash; the sidebar shows the
    // short form and the tooltip keeps the complete identity.
    private string ProductVersion => ShortVersion(GuideAppInfo.CurrentVersion);

    private static string ShortVersion(string version)
    {
        var metadata = version.IndexOf('+');
        return metadata > 0 && version.Length > metadata + 9
            ? $"{version[..(metadata + 9)]}…"
            : version;
    }

    private string LanguageSwitchLabel => Session.Language == "zh-CN" ? "EN" : "中文";

    private string ThemeIcon { get; set; } = "moon";

    private string ThemeLabel { get; set; } = "Dark";

    protected override void OnInitialized() => Session.LanguageChanged += OnLanguageChanged;

    private void OnLanguageChanged() => InvokeAsync(() =>
    {
        ApplyThemeLabel();
        StateHasChanged();
    });

    private void ApplyThemeLabel() => ThemeLabel = Session.Language == "zh-CN"
        ? (ThemeIcon == "sun" ? "浅色" : "深色")
        : (ThemeIcon == "sun" ? "Light" : "Dark");

    private async Task ToggleTheme()
    {
        try
        {
            var next = await Js.InvokeAsync<string>("mwSetupToggleTheme");
            ThemeIcon = next == "light" ? "sun" : "moon";
        }
        catch (JSDisconnectedException)
        {
            ThemeIcon = ThemeIcon == "sun" ? "moon" : "sun";
        }
        ApplyThemeLabel();
    }

    public void Dispose() => Session.LanguageChanged -= OnLanguageChanged;
}
