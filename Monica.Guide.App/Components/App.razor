<!DOCTYPE html>
<html lang="@Language">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Monica Guide</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%236841e8'/%3E%3Cpath d='M6 9 L11.2 9 L16 16.6 L20.8 9 L26 9 L26 23 L20.8 23 L16 15.4 L11.2 23 L6 23 Z' fill='%23fbf8f1'/%3E%3C/svg%3E"/>
    <base href="@BaseUri"/>
    <HeadOutlet @rendermode="InteractiveServer"/>
    @* The Monica.Docs design language: warm paper, ink rules, violet hard shadows, runtime
       green, Bricolage Grotesque display type over IBM Plex. Fonts are embedded so the
       offline installer never reaches the network. *@
    <style>
        @@font-face {
            font-family: "Bricolage Grotesque";
            src: url("fonts/bricolage-grotesque-latin-variable.woff2") format("woff2");
            font-weight: 200 800;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: "IBM Plex Sans";
            src: url("fonts/ibm-plex-sans-latin-400.woff2") format("woff2");
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: "IBM Plex Sans";
            src: url("fonts/ibm-plex-sans-latin-500.woff2") format("woff2");
            font-weight: 500;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: "IBM Plex Sans";
            src: url("fonts/ibm-plex-sans-latin-600.woff2") format("woff2");
            font-weight: 600;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: "IBM Plex Mono";
            src: url("fonts/ibm-plex-mono-latin-400.woff2") format("woff2");
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: "IBM Plex Mono";
            src: url("fonts/ibm-plex-mono-latin-500.woff2") format("woff2");
            font-weight: 500;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: "IBM Plex Mono";
            src: url("fonts/ibm-plex-mono-latin-600.woff2") format("woff2");
            font-weight: 600;
            font-style: normal;
            font-display: swap;
        }

        /* ---- Monica.Docs tokens: paper light theme (default) ---- */
        :root {
            --paper: #f2eee5;
            --paper-bright: #fbf8f1;
            --paper-deep: #e7e0d3;
            --violet: #6841e8;
            --violet-dark: #4b2cae;
            --violet-pale: #ded4ff;
            --runtime: #b8f36b;
            --runtime-dark: #4d771f;
            --clay: #d86145;

            --bg: var(--paper);
            --surface: var(--paper-bright);
            --surface-2: #f6f1e6;
            --surface-3: var(--paper-deep);
            --text: #161713;
            --text-2: #393a34;
            --muted: #6c6c64;
            --rule: rgba(22, 23, 19, 0.22);
            --strong-rule: #161713;
            --grid-line: rgba(22, 23, 19, 0.035);

            --accent: var(--violet);
            --accent-text: var(--violet-dark);
            --accent-soft: rgba(104, 65, 232, 0.08);
            --accent-border: rgba(104, 65, 232, 0.42);

            --ok-text: var(--runtime-dark);
            --ok-fill: var(--runtime);
            --ok-soft: rgba(184, 243, 107, 0.22);
            --ok-border: rgba(77, 119, 31, 0.45);

            --warn-text: #8a6a1c;
            --warn-soft: rgba(233, 200, 119, 0.2);
            --warn-border: rgba(138, 106, 28, 0.4);

            --danger: var(--clay);
            --danger-text: #a83c22;
            --danger-soft: rgba(216, 97, 69, 0.1);
            --danger-border: rgba(216, 97, 69, 0.42);

            --knob: #fbf8f1;
            --font-display: "Bricolage Grotesque", "Arial Narrow", "Microsoft YaHei UI", sans-serif;
            --font-body: "IBM Plex Sans", "Segoe UI", "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", system-ui, sans-serif;
            --font-mono: "IBM Plex Mono", "Cascadia Code", "Cascadia Mono", Consolas, monospace;
        }
        /* ---- Ink dark theme: the docs site's dark panels (code windows) as a full page ---- */
        html[data-theme="dark"] {
            --bg: #161713;
            --surface: #1b1c18;
            --surface-2: #20211d;
            --surface-3: #262723;
            --text: #f7f4ec;
            --text-2: rgba(247, 244, 236, 0.68);
            --muted: rgba(247, 244, 236, 0.45);
            --rule: rgba(255, 255, 255, 0.16);
            --strong-rule: rgba(247, 244, 236, 0.82);
            --grid-line: rgba(255, 255, 255, 0.03);

            --accent-text: #a08bff;
            --accent-soft: rgba(104, 65, 232, 0.26);
            --accent-border: rgba(160, 139, 255, 0.42);

            --ok-text: var(--runtime);
            --ok-soft: rgba(184, 243, 107, 0.1);
            --ok-border: rgba(184, 243, 107, 0.35);

            --warn-text: #e9c877;
            --warn-soft: rgba(233, 200, 119, 0.1);
            --warn-border: rgba(233, 200, 119, 0.36);

            --danger: #e0684a;
            --danger-text: #ec8b6d;
            --danger-soft: rgba(216, 97, 69, 0.16);
            --danger-border: rgba(216, 97, 69, 0.5);

            --knob: #f7f4ec;
        }
        :root { color-scheme: light; }
        html[data-theme="dark"] { color-scheme: dark; }
        * { box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font: 14px/1.6 var(--font-body);
            -webkit-font-smoothing: antialiased;
        }
        /* Docs page grid: faint ruled columns fading toward the bottom of the viewport. */
        body::before {
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            content: "";
            background-image:
                linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
                linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
            background-size: 76px 100%, 100% 76px;
            mask-image: linear-gradient(to bottom, black 0%, transparent 94%);
        }
        /* Docs paper noise: fractal turbulence laid over everything, near-invisible. */
        body::after {
            position: fixed;
            inset: 0;
            z-index: 1000;
            pointer-events: none;
            content: "";
            opacity: 0.035;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.75'/%3E%3C/svg%3E");
            mix-blend-mode: multiply;
        }
        html[data-theme="dark"] body::after {
            opacity: 0.05;
            mix-blend-mode: screen;
        }
        ::selection { color: var(--paper-bright); background: var(--violet); }
        code, .mono { font-family: var(--font-mono); font-size: 0.92em; }
        a { color: var(--accent-text); }

        /* ---- shell ---- */
        .shell { display: flex; min-height: 100vh; }
        .sidebar {
            width: 232px; flex: 0 0 auto; display: flex; flex-direction: column;
            background: var(--surface); border-right: 1px solid var(--strong-rule);
            position: sticky; top: 0; height: 100vh;
        }
        .brand {
            display: flex; flex-direction: column; gap: 14px;
            padding: 24px 20px 20px; border-bottom: 1px solid var(--rule);
        }
        .brand-row { display: flex; align-items: center; gap: 10px; min-width: 0; }
        /* The Monica mark from the docs header: two parallelogram planes and a skewed cut. */
        .monica-mark { position: relative; display: inline-block; flex: 0 0 auto; width: 30px; height: 27px; }
        .mark-plane {
            position: absolute; inset-block: 0; width: 18px;
            clip-path: polygon(0 0, 68% 0, 100% 57%, 100% 100%, 70% 100%, 0 42%);
        }
        .mark-plane-violet { left: 0; background: var(--violet); }
        html[data-theme="dark"] .mark-plane-violet { background: var(--accent-text); }
        .mark-plane-ink { right: 0; background: var(--strong-rule); transform: scaleX(-1); }
        .mark-cut {
            position: absolute; top: 0; left: 13px; width: 4px; height: 18px;
            background: var(--surface); transform: skewX(-24deg);
        }
        .brand-text { min-width: 0; }
        .brand-name {
            font-family: var(--font-display);
            font-size: 21px; font-weight: 700; line-height: 1;
            letter-spacing: -0.045em; white-space: nowrap;
        }
        .brand-product {
            margin-top: 4px;
            color: var(--accent-text);
            font-family: var(--font-mono); font-size: 10px; font-weight: 600;
            line-height: 1; letter-spacing: 0.12em; text-transform: uppercase;
            white-space: nowrap;
        }
        .release-stamp {
            align-self: flex-start;
            padding: 3px 7px 2px;
            border: 1px solid var(--rule);
            color: var(--muted);
            font-family: var(--font-mono); font-size: 9px; font-weight: 600;
            line-height: 1.2; letter-spacing: 0.08em;
            max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .nav { display: flex; flex-direction: column; padding: 10px 0; }
        .nav-item {
            position: relative;
            display: flex; align-items: center; gap: 10px;
            padding: 12px 20px;
            color: var(--text-2); text-decoration: none;
            font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
            letter-spacing: 0.07em; text-transform: uppercase;
            transition: color .15s;
        }
        .nav-item:hover { color: var(--text); }
        .nav-item::after {
            position: absolute; right: 0; bottom: 0; left: 0; height: 3px;
            content: ""; background: var(--accent);
            transform: scaleX(0); transform-origin: left;
            transition: transform .2s ease;
        }
        .nav-item:hover::after, .nav-item.active::after { transform: scaleX(1); }
        .nav-item.active { color: var(--accent-text); }
        .nav-item .icon { flex: 0 0 auto; opacity: .9; }
        .sidebar-footer {
            margin-top: auto; padding: 14px 16px 18px;
            border-top: 1px solid var(--rule);
            display: flex; flex-direction: column; gap: 12px;
        }
        .footer-tools { display: flex; gap: 8px; }
        .tool-btn {
            flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 7px;
            background: transparent; border: 1px solid var(--rule); color: var(--text-2);
            padding: 8px 10px; cursor: pointer;
            font-family: var(--font-mono); font-size: 9.5px; font-weight: 500;
            letter-spacing: 0.06em; text-transform: uppercase;
            transition: color .15s, border-color .15s;
        }
        .tool-btn:hover { border-color: var(--accent-border); color: var(--accent-text); }
        .sidebar-note {
            font-family: var(--font-mono); font-size: 9px; color: var(--muted);
            letter-spacing: 0.04em; line-height: 1.5;
            display: flex; gap: 7px; align-items: center;
        }
        .content { flex: 1; min-width: 0; padding: 38px 48px 84px; max-width: 1060px; }

        .page-title {
            margin: 0 0 8px;
            font-family: var(--font-display);
            font-size: 30px; font-weight: 650; line-height: 1.05; letter-spacing: -0.04em;
        }
        .page-sub { color: var(--text-2); margin: 0 0 26px; font-size: 13.5px; }

        /* ---- cards: ink-ruled paper panels ---- */
        .card {
            background: var(--surface);
            border: 1px solid var(--strong-rule);
            padding: 22px 24px; margin-bottom: 22px;
        }
        /* The hero card carries the docs signature: a hard violet offset shadow. */
        .card:has(> .hero) { box-shadow: 10px 10px 0 var(--accent); margin-bottom: 30px; }
        .card h2 {
            margin: 0 0 14px; color: var(--muted);
            font-family: var(--font-mono); font-size: 10px; font-weight: 600;
            letter-spacing: 0.1em; text-transform: uppercase;
        }
        .card-title { display: flex; align-items: center; gap: 8px; }

        /* ---- hero ---- */
        .hero { display: flex; align-items: center; gap: 18px; }
        .hero-badge {
            width: 52px; height: 52px; display: grid; place-items: center; flex: 0 0 auto;
            background: var(--ok-soft); color: var(--ok-text); border: 1px solid var(--ok-border);
        }
        .hero-badge.warn { background: var(--warn-soft); color: var(--warn-text); border-color: var(--warn-border); }
        .hero-badge.error { background: var(--danger-soft); color: var(--danger-text); border-color: var(--danger-border); }
        .hero-main { flex: 1; min-width: 0; }
        .hero-title {
            font-family: var(--font-display);
            font-size: 21px; font-weight: 620; letter-spacing: -0.02em;
            margin: 0; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
        }
        .hero-sub { color: var(--text-2); font-size: 13px; margin: 4px 0 0; }
        .hero-side { text-align: right; }
        .hero-product {
            color: var(--accent-text);
            font-family: var(--font-mono); font-size: 10.5px; font-weight: 600;
            letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap;
        }
        .hero-version { font-family: var(--font-display); font-size: 21px; font-weight: 620; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
        .hero-version-label {
            font-family: var(--font-mono); font-size: 9px; color: var(--muted);
            letter-spacing: 0.08em; text-transform: uppercase;
        }

        /* ---- stat grid ---- */
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0; border-top: 1px solid var(--rule); }
        .stat { padding: 14px 14px 2px 0; min-width: 0; }
        .stat + .stat { padding-left: 14px; border-left: 1px solid var(--rule); }
        .stat .label {
            display: flex; align-items: center; gap: 7px;
            color: var(--muted); margin-bottom: 6px;
            font-family: var(--font-mono); font-size: 8.5px; font-weight: 600;
            letter-spacing: 0.09em; text-transform: uppercase;
        }
        .stat .value {
            font-size: 13px; font-weight: 500; word-break: break-all;
            display: flex; align-items: center; gap: 8px; min-width: 0;
        }
        .stat .label .label-action { margin-left: auto; }
        .btn-tiny { min-height: 24px; padding: 0 8px; font-size: 8.5px; gap: 5px; }
        .btn-tiny .spinner { width: 11px; height: 11px; border-width: 2px; vertical-align: -2px; }
        .stat-time { font-family: var(--font-mono); font-size: 9.5px; color: var(--muted); flex: 0 0 auto; }

        /* ---- badges & chips: ruled mono tags ---- */
        .badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 3px 8px;
            font-family: var(--font-mono); font-size: 9px; font-weight: 600;
            letter-spacing: 0.06em; text-transform: uppercase;
            border: 1px solid; white-space: nowrap;
        }
        .badge.ok { background: var(--ok-soft); color: var(--ok-text); border-color: var(--ok-border); }
        .badge.warning { background: var(--warn-soft); color: var(--warn-text); border-color: var(--warn-border); }
        .badge.error { background: var(--danger-soft); color: var(--danger-text); border-color: var(--danger-border); }
        .badge.neutral { background: var(--surface-3); color: var(--text-2); border-color: var(--rule); }
        .badge.accent { background: var(--accent-soft); color: var(--accent-text); border-color: var(--accent-border); }
        .chip {
            display: inline-flex; align-items: center; padding: 3px 8px;
            background: transparent; border: 1px solid var(--rule);
            color: var(--text-2);
            font-family: var(--font-mono); font-size: 9.5px; font-weight: 500; letter-spacing: 0.03em;
        }
        .chips { display: flex; flex-wrap: wrap; gap: 7px; }
        .chip.ok { color: var(--ok-text); border-color: var(--ok-border); background: var(--ok-soft); }
        .chip.warn { color: var(--warn-text); border-color: var(--warn-border); background: var(--warn-soft); }

        /* ---- buttons: mono uppercase with hard offset shadows ---- */
        button { font: inherit; }
        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 9px;
            min-height: 44px; padding: 0 18px;
            font-family: var(--font-mono); font-size: 10.5px; font-weight: 600;
            letter-spacing: 0.05em; text-transform: uppercase; line-height: 1.2;
            cursor: pointer; text-decoration: none;
            border: 1px solid var(--strong-rule); background: transparent; color: var(--text);
            transition: transform .16s ease, box-shadow .16s ease, color .16s ease, border-color .16s ease, background .16s ease;
        }
        .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
        .btn:disabled { opacity: .4; cursor: not-allowed; box-shadow: none; transform: none; }
        .btn-primary { background: var(--accent); color: #fff; box-shadow: 4px 4px 0 var(--strong-rule); }
        .btn-primary:hover:not(:disabled) { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--strong-rule); }
        .btn-primary:active:not(:disabled) { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--strong-rule); }
        .btn-secondary { background: var(--surface); }
        .btn-secondary:hover:not(:disabled) { color: var(--accent-text); border-color: var(--accent-border); }
        .btn-danger { background: var(--danger); color: #fff; box-shadow: 4px 4px 0 var(--strong-rule); }
        .btn-danger:hover:not(:disabled) { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--strong-rule); }
        .btn-ghost { border-color: transparent; color: var(--text-2); }
        .btn-ghost:hover:not(:disabled) { color: var(--accent-text); border-color: var(--accent-border); }
        .btn-lg { min-height: 52px; padding: 0 24px; font-size: 11px; }
        .btn-sm { min-height: 34px; padding: 0 12px; font-size: 9.5px; }
        .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px; align-items: center; }

        /* ---- banners: ruled paper notes with a heavy accent spine ---- */
        .banner {
            display: flex; gap: 11px; align-items: flex-start;
            padding: 12px 15px; font-size: 12.5px;
            border: 1px solid; border-left-width: 4px; margin: 14px 0;
        }
        .banner .icon { flex: 0 0 auto; margin-top: 1px; }
        .banner-ok { background: var(--ok-soft); border-color: var(--ok-border); color: var(--ok-text); }
        .banner-error { background: var(--danger-soft); border-color: var(--danger-border); color: var(--danger-text); }
        .banner-info { background: var(--accent-soft); border-color: var(--accent-border); color: var(--text-2); }
        .banner-warn { background: var(--warn-soft); border-color: var(--warn-border); color: var(--warn-text); }

        /* ---- fields ---- */
        .field { display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; }
        .field > label {
            font-family: var(--font-mono); font-size: 9.5px; font-weight: 600;
            color: var(--text-2); letter-spacing: 0.08em; text-transform: uppercase;
        }
        .field .hint { font-size: 12px; color: var(--muted); }
        input[type="text"], input[type="number"], textarea {
            width: 100%; background: var(--bg); color: var(--text);
            border: 1px solid var(--strong-rule);
            padding: 10px 12px; font-size: 13.5px; font-family: inherit;
            transition: border-color .15s, box-shadow .15s;
        }
        input[type="text"], .workspace-path { font-family: var(--font-mono); font-size: 12.5px; }
        input:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
        input[type="number"] { max-width: 190px; }
        .input-row { display: flex; gap: 8px; align-items: stretch; }
        .input-row input { flex: 1; min-width: 0; width: auto; }
        .input-row .btn { flex: 0 0 auto; white-space: nowrap; }

        /* ---- switch: square ink track ---- */
        .switch-row { display: flex; align-items: center; gap: 14px; padding: 12px 2px; border-bottom: 1px solid var(--rule); }
        .switch-row:last-child { border-bottom: none; }
        .switch-row .switch-text { flex: 1; min-width: 0; }
        .switch-row .switch-text .primary { font-size: 13.5px; font-weight: 600; }
        .switch-row .switch-text .secondary { font-size: 12px; color: var(--muted); }
        .switch { position: relative; display: inline-block; width: 42px; height: 24px; flex: 0 0 auto; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .switch .track {
            position: absolute; inset: 0;
            background: var(--surface-3); border: 1px solid var(--strong-rule);
            transition: background .18s, border-color .18s; cursor: pointer;
        }
        .switch .track::after {
            content: ""; position: absolute; width: 16px; height: 16px;
            left: 3px; top: 3px;
            background: var(--muted);
            transition: transform .18s, background .18s;
        }
        .switch input:checked + .track { background: var(--accent); border-color: var(--strong-rule); }
        .switch input:checked + .track::after { transform: translateX(18px); background: var(--knob); }
        .switch input:focus-visible + .track { outline: 3px solid var(--accent); outline-offset: 2px; }

        /* ---- option cards: violet selection like the docs fit-spectrum ---- */
        .option-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
        .option-grid.wide { grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); }
        .option-card {
            display: flex; align-items: center; gap: 11px;
            padding: 13px 14px;
            border: 1px solid var(--rule); background: transparent; cursor: pointer;
            transition: border-color .15s, background .15s, color .15s, box-shadow .15s;
        }
        .option-card:hover { border-color: var(--strong-rule); }
        .option-card.selected {
            color: #fff; border-color: var(--strong-rule); background: var(--accent);
            box-shadow: 4px 4px 0 var(--strong-rule);
        }
        .option-card input { width: 15px; height: 15px; accent-color: var(--accent); }
        .option-card.selected input { accent-color: #fff; }
        .option-card .option-main { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
        .option-card .option-title { font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.02em; }
        .option-card .option-sub { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .option-card.selected .option-sub { color: rgba(255, 255, 255, 0.75); }
        .option-card .option-desc { font-size: 11.5px; line-height: 1.5; color: var(--text-2); }
        .option-card.selected .option-desc { color: rgba(255, 255, 255, 0.85); }
        .card-note {
            margin: 10px 0 0; padding-top: 10px;
            border-top: 1px dashed var(--rule);
            color: var(--muted); font-size: 12px; line-height: 1.5;
        }

        /* ---- workspace cards ---- */
        .workspace-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 14px; margin-bottom: 22px; }
        .workspace-card { margin-bottom: 0; display: flex; flex-direction: column; gap: 12px; }
        .workspace-card.workspace-attention { border-color: var(--warn-border); }
        .workspace-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .profile-badge {
            display: inline-flex; align-items: center; padding: 3px 8px;
            font-family: var(--font-mono); font-size: 8.5px; font-weight: 600;
            letter-spacing: 0.07em; text-transform: uppercase;
            border: 1px solid; background: var(--accent-soft); color: var(--accent-text); border-color: var(--accent-border);
        }
        .profile-badge.profile-application { background: var(--accent-soft); color: var(--accent-text); border-color: var(--accent-border); }
        .profile-badge.profile-extension { background: rgba(222, 212, 255, 0.4); color: var(--violet-dark); border-color: rgba(75, 44, 174, 0.4); }
        html[data-theme="dark"] .profile-badge.profile-extension { background: rgba(160, 139, 255, 0.14); color: #a08bff; border-color: rgba(160, 139, 255, 0.42); }
        .profile-badge.profile-framework { background: var(--ok-soft); color: var(--ok-text); border-color: var(--ok-border); }
        .profile-badge.profile-docs { background: var(--danger-soft); color: var(--danger-text); border-color: var(--danger-border); }
        .health-dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; }
        .health-dot.ok {
            background: var(--ok-fill);
            box-shadow: 0 0 0 4px rgba(184, 243, 107, 0.18);
            animation: pulse-ring 2.4s ease-in-out infinite;
        }
        .health-dot.warn { background: #e9c877; box-shadow: 0 0 0 4px rgba(233, 200, 119, 0.18); }
        @@keyframes pulse-ring { 50% { box-shadow: 0 0 0 8px rgba(184, 243, 107, 0); } }
        .workspace-path {
            color: var(--text); word-break: break-all; line-height: 1.5;
        }
        .workspace-meta { display: flex; flex-wrap: wrap; gap: 6px; }
        .workspace-issues { margin: 0; padding-left: 18px; color: var(--warn-text); font-size: 12.5px; line-height: 1.55; }

        /* ---- instruction injection sample: verbatim managed block panel ---- */
        .instruction-sample { border: 1px solid var(--rule); margin-top: 16px; }
        .instruction-sample-head { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 12px; border-bottom: 1px dashed var(--rule); }
        .instruction-sample .code-block { border: none; white-space: pre-wrap; overflow-wrap: break-word; }
        .instruction-sample .instruction-marker { color: var(--muted); }
        .workspace-card .actions { margin-top: auto; }
        details.global-targets {
            border: 1px dashed var(--rule); padding: 12px 16px;
            background: var(--surface-2); margin-top: 6px;
        }
        details.global-targets summary {
            cursor: pointer;
            font-family: var(--font-mono); font-size: 10px; font-weight: 600; color: var(--muted);
            letter-spacing: 0.08em; text-transform: uppercase; user-select: none;
        }
        details.global-targets[open] summary { color: var(--text-2); margin-bottom: 4px; }

        /* ---- wizard steps ---- */
        .steps { display: flex; margin-bottom: 28px; }
        .step { display: flex; align-items: center; gap: 9px; flex: 1; min-width: 0; }
        .step::after { content: ""; flex: 1; height: 1px; background: var(--rule); margin: 0 12px; }
        .step:last-child::after { display: none; }
        .step-dot {
            width: 28px; height: 28px; display: grid; place-items: center; flex: 0 0 auto;
            font-family: var(--font-mono); font-size: 12px; font-weight: 600;
            background: var(--surface-2); color: var(--muted);
            border: 1px solid var(--strong-rule);
        }
        .step.current .step-dot { background: var(--accent); border-color: var(--strong-rule); color: #fff; box-shadow: 3px 3px 0 var(--strong-rule); }
        .step.done .step-dot { background: var(--ok-soft); border-color: var(--ok-border); color: var(--ok-text); }
        .step-label { font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
        .step.current .step-label { color: var(--text); }

        /* ---- checks ---- */
        .checks { list-style: none; margin: 0; padding: 0; }
        .checks li {
            display: flex; gap: 12px; align-items: flex-start; padding: 11px 2px;
            border-bottom: 1px solid var(--rule);
        }
        .checks li:last-child { border-bottom: none; }
        .checks .icon { flex: 0 0 auto; margin-top: 2px; }
        .checks .icon.ok { color: var(--ok-text); }
        .checks .icon.warning { color: var(--warn-text); }
        .checks .icon.error { color: var(--danger-text); }
        .checks .msg { flex: 1; min-width: 0; font-size: 13px; }
        .checks .cid {
            display: block; color: var(--muted); font-family: var(--font-mono);
            font-size: 9.5px; letter-spacing: 0.04em; margin-bottom: 2px;
        }
        .checks .fix { display: block; color: var(--warn-text); font-size: 12px; margin-top: 3px; }

        /* ---- plan groups ---- */
        .plan-summary { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
        .group { border: 1px solid var(--rule); margin-bottom: 12px; }
        .group-header {
            display: flex; align-items: center; gap: 9px; padding: 10px 14px;
            background: var(--surface-2);
            font-family: var(--font-mono); font-size: 10px; font-weight: 600;
            letter-spacing: 0.07em; text-transform: uppercase;
        }
        .group-header .icon { color: var(--accent-text); }
        .group ul { list-style: none; margin: 0; padding: 4px 0; }
        .group li { padding: 8px 14px; display: flex; flex-direction: column; gap: 1px; border-top: 1px solid var(--rule); }
        .group li:first-child { border-top: none; }
        .group li .target { font-family: var(--font-mono); font-size: 11.5px; word-break: break-all; }
        .group li small { color: var(--muted); font-size: 12px; }

        /* ---- progress ---- */
        .progress-wrap { display: flex; flex-direction: column; gap: 8px; margin: 10px 0; }
        .progress-meta {
            display: flex; justify-content: space-between;
            font-family: var(--font-mono); font-size: 11px; color: var(--text-2);
        }
        .progress { height: 8px; background: var(--surface-3); overflow: hidden; border: 1px solid var(--rule); }
        .progress .fill { height: 100%; background: var(--accent); transition: width .2s ease; min-width: 2%; }
        .progress.indeterminate .fill { width: 35%; animation: slide 1.1s ease-in-out infinite alternate; }
        @@keyframes slide { from { margin-left: -10%; } to { margin-left: 100%; } }

        /* ---- phase panel ---- */
        .phase-panel { border: 1px solid var(--rule); background: var(--surface-2); padding: 14px 16px; margin: 10px 0 6px; }
        .phase-list { list-style: none; margin: 11px 0 0; padding: 0; max-height: 250px; overflow: auto; }
        .phase-list li {
            display: flex; align-items: center; gap: 9px; padding: 5px 2px;
            font-family: var(--font-mono); font-size: 11px; color: var(--text-2); line-height: 1.4;
        }
        .phase-list li.current { color: var(--text); font-weight: 600; }
        .phase-list .phase-text { flex: 1; min-width: 0; }
        .phase-list .spinner { width: 13px; height: 13px; border-width: 2px; }
        .phase-count { color: var(--muted); font-variant-numeric: tabular-nums; flex: 0 0 auto; }
        .phase-elapsed { margin-top: 8px; font-family: var(--font-mono); font-size: 10px; color: var(--muted); font-variant-numeric: tabular-nums; }

        /* ---- misc ---- */
        .spinner {
            width: 16px; height: 16px; border-radius: 50%; flex: 0 0 auto;
            border: 2px solid var(--accent-soft); border-top-color: var(--accent-text);
            animation: spin .8s linear infinite; display: inline-block; vertical-align: -4px;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .loading {
            display: flex; align-items: center; gap: 11px; color: var(--text-2);
            padding: 24px 0; font-size: 13px;
        }
        .note { color: var(--muted); font-size: 12.5px; }
        .error-text { color: var(--danger-text); font-size: 13px; word-break: break-word; }
        .success-text { color: var(--ok-text); }
        .confirm-line { display: flex; gap: 10px; align-items: center; margin: 14px 0; font-size: 13.5px; }
        .confirm-line input { width: 16px; height: 16px; accent-color: var(--danger); }
        .kv { display: grid; grid-template-columns: 170px 1fr; gap: 8px 14px; align-items: baseline; }
        .kv .k { color: var(--muted); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.05em; text-transform: uppercase; }
        .kv .v { word-break: break-all; font-size: 13px; }
        .icon { display: inline-block; vertical-align: -3px; }
        .icon.ok { color: var(--ok-text); }
        .icon.warning { color: var(--warn-text); }
        .icon.error { color: var(--danger-text); }
        .icon-14 { width: 14px; height: 14px; }
        .icon-16 { width: 16px; height: 16px; }
        .icon-18 { width: 18px; height: 18px; }
        .icon-22 { width: 22px; height: 22px; }
        .icon-26 { width: 26px; height: 26px; }
        .divider { height: 1px; background: var(--rule); margin: 18px 0; }
        .notes-block {
            white-space: pre-wrap; font-size: 12.5px; color: var(--text-2); line-height: 1.65;
            max-height: 260px; overflow: auto; background: var(--surface-2);
            border: 1px solid var(--rule); padding: 12px 15px;
        }
        .code-block-wrap { position: relative; }
        .code-block {
            margin: 0; white-space: pre; overflow: auto; font-size: 12px; line-height: 1.7;
            background: var(--bg); border: 1px solid var(--rule);
            padding: 14px 16px; color: var(--text);
        }
        .code-block, .code-block code { font-family: var(--font-mono); }
        .copy-overlay { position: absolute; top: 9px; right: 9px; }
        .rollback-item { display: flex; align-items: center; gap: 14px; padding: 12px 2px; border-bottom: 1px solid var(--rule); }
        .rollback-item:last-child { border-bottom: none; }
        .rollback-item .rollback-main { flex: 1; min-width: 0; }
        .danger-zone { border-color: var(--danger-border); }
    </style>
    <script>
        (function () {
            var stored = null;
            try { stored = localStorage.getItem("mw-setup-theme"); } catch (e) { }
            // The docs design language is paper-first; dark ink is the deliberate opt-out.
            var theme = stored || "light";
            document.documentElement.dataset.theme = theme;
            window.mwSetupToggleTheme = function () {
                var next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
                document.documentElement.dataset.theme = next;
                try { localStorage.setItem("mw-setup-theme", next); } catch (e) { }
                return next;
            };
        })();
    </script>
</head>
<body>
    <Routes @rendermode="InteractiveServer"/>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [Inject]
    private SetupSession Session { get; set; } = default!;

    private string Language => Session.Language;

    private string BaseUri => Navigation.BaseUri;
}
