@* Renders one projected guide check list with severity icons and remediation hints. *@
@if (View is not null && View.Items.Count > 0)
{
    <ul class="checks">
        @foreach (var item in View.OrderedItems)
        {
            <li>
                <Icon Name="@StatusIcon(item.Status)" Size="18" Class="@item.Status.ToString().ToLowerInvariant()"/>
                <span class="msg">
                    <span class="cid mono">@item.Id</span>
                    @item.Message
                    @if (!string.IsNullOrWhiteSpace(item.Remediation))
                    {
                        <span class="fix">↳ @item.Remediation</span>
                    }
                </span>
            </li>
        }
    </ul>
}
else
{
    <p class="note">@EmptyText</p>
}

@code {
    [Parameter]
    public SetupChecksView? View { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = string.Empty;

    [Inject]
    private SetupSession Session { get; set; } = default!;

    private static string StatusIcon(GuideCheckStatus status)
        => status switch
        {
            GuideCheckStatus.Ok => "check-circle",
            GuideCheckStatus.Warning => "alert",
            _ => "error-circle"
        };
}
