@* Renders one projected guide plan: coarse directory-level groups with icons. *@
@if (View is null)
{
    return;
}

@if (View.IsNoOp)
{
    <div class="banner banner-ok">
        <Icon Name="check-circle" Size="18"/>
        <span>@Session.T("plan-noop")</span>
    </div>
}
else
{
    <div class="plan-summary">
        <span class="badge accent">@View.ChangeCount @Session.T("plan-changes")</span>
        <span class="note">@Session.T("digest-note")</span>
    </div>
}

@foreach (var group in View.ChangeGroups)
{
    <div class="group">
        <div class="group-header">
            <Icon Name="@KindIcon(group.Kind)" Size="16"/>
            <span>@Session.T($"action-{KindKey(group.Kind)}")</span>
            <span class="badge neutral">@(group.Count)</span>
        </div>
        <ul>
            @foreach (var entry in group.Entries)
            {
                <li>
                    <span class="target mono">@entry.Target</span>
                    <small>@entry.Description</small>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter]
    public SetupPlanView? View { get; set; }

    [Inject]
    private SetupSession Session { get; set; } = default!;

    private static string KindKey(GuidePlanActionKind kind)
        => kind switch
        {
            GuidePlanActionKind.ReplaceSkillDirectory => "replace-skill-directory",
            GuidePlanActionKind.DeleteSkillDirectory => "delete-skill-directory",
            GuidePlanActionKind.WriteFile => "write-file",
            GuidePlanActionKind.DeleteFile => "delete-file",
            _ => "no-change"
        };

    private static string KindIcon(GuidePlanActionKind kind)
        => kind switch
        {
            GuidePlanActionKind.ReplaceSkillDirectory => "file",
            GuidePlanActionKind.DeleteSkillDirectory => "uninstall",
            GuidePlanActionKind.WriteFile => "file",
            GuidePlanActionKind.DeleteFile => "uninstall",
            _ => "check"
        };
}
