@* Live phase progress: elapsed clock, a determinate bar when the engine reports counts, and the running phase log. *@
@implements IDisposable

@if (Phases.Count > 0)
{
    <div class="phase-panel">
        @{
            var latest = Phases[^1];
        }
        @if (Active && latest.Total > 0)
        {
            <div class="progress">
                <div class="fill" style="width:@Math.Clamp(latest.Completed * 100 / latest.Total, 2, 100)%"></div>
            </div>
        }
        else
        {
            <div class="progress indeterminate"><div class="fill"></div></div>
        }
        <ul class="phase-list">
            @for (var index = 0; index < Phases.Count; index++)
            {
                var phase = Phases[index];
                var isCurrent = index == Phases.Count - 1 && Active;
                <li class="@(isCurrent ? "current" : "done")">
                    @if (isCurrent)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <Icon Name="check-circle" Size="14" Class="ok"/>
                    }
                    <span class="phase-text">@phase.Message</span>
                    @if (phase.Total > 0)
                    {
                        <span class="phase-count">@phase.Completed/@phase.Total</span>
                    }
                </li>
            }
        </ul>
        @if (Active)
        {
            <div class="phase-elapsed">@Session.T("elapsed") @Clock.Elapsed.ToString(@"m\:ss")</div>
        }
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<GuidePhase> Phases { get; set; } = [];

    [Parameter]
    public bool Active { get; set; }

    [Inject]
    private SetupSession Session { get; set; } = default!;

    private readonly System.Diagnostics.Stopwatch Clock = new();
    private System.Threading.Timer? ticker;
    private bool wasActive;

    protected override void OnParametersSet()
    {
        if (Active && !wasActive)
        {
            Clock.Restart();
            ticker ??= new System.Threading.Timer(
                _ => _ = InvokeAsync(StateHasChanged).ContinueWith(static task => { }, TaskScheduler.Default),
                null,
                1_000,
                1_000);
        }
        else if (!Active && ticker is not null)
        {
            ticker.Dispose();
            ticker = null;
            Clock.Stop();
        }
        wasActive = Active;
    }

    public void Dispose()
    {
        ticker?.Dispose();
    }
}
