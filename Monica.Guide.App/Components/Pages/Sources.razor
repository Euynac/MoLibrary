@page "/sources"
@implements IDisposable

<h1 class="page-title">@Session.CurrentProduct.DisplayName · @Session.T("sources")</h1>
<p class="page-sub">@Session.T("sources-sub")</p>

@if (Loading)
{
    <div class="loading"><span class="spinner"></span>@Session.T("operating")</div>
}
else
{
    <div class="card">
        <h2>@Session.T("src-issue-title")</h2>
        <div class="option-grid wide">
            @foreach (var mode in IssueModes)
            {
                var selected = IssueMode == mode;
                <label class="option-card @(selected ? "selected" : null)">
                    <input type="radio" name="issue-mode" checked="@selected" disabled="@PreferenceBusy"
                           @onchange="() => SetIssueModeAsync(mode)"/>
                    <span class="option-main">
                        <span class="option-title">@Session.T($"src-issue-mode-{ModeKey(mode)}")</span>
                        <span class="option-desc">@Session.T($"src-issue-desc-{ModeKey(mode)}")</span>
                    </span>
                </label>
            }
        </div>
        <p class="card-note">@Session.T("src-issue-note")</p>
    </div>

    <div class="card">
        <h2>@Session.T("src-proj-title")</h2>
        <div class="switch-row">
            <span class="switch-text">
                <span class="primary">@Session.T("src-proj-sources-title")</span>
                <span class="secondary">@Session.T("src-proj-sources-note")</span>
            </span>
            <label class="switch">
                <input type="checkbox" checked="@Projection.SourceHints" disabled="@ProjectionBusy"
                       @onchange="e => SetProjectionAsync(sourceHints: (bool)e.Value!, issuePolicy: Projection.IssuePolicy)"/>
                <span class="track"></span>
            </label>
        </div>
        <div class="switch-row">
            <span class="switch-text">
                <span class="primary">@Session.T("src-proj-issue-title")</span>
                <span class="secondary">@Session.T("src-proj-issue-note")</span>
            </span>
            <label class="switch">
                <input type="checkbox" checked="@Projection.IssuePolicy" disabled="@ProjectionBusy"
                       @onchange="e => SetProjectionAsync(sourceHints: Projection.SourceHints, issuePolicy: (bool)e.Value!)"/>
                <span class="track"></span>
            </label>
        </div>
    </div>

    @foreach (var ledgerIssue in Repositories.Where(static repository => repository.LedgerIssue is not null)
                 .Select(static repository => repository.LedgerIssue!)
                 .Distinct())
    {
        <div class="card">
            <div class="banner banner-error">
                <Icon Name="error-circle" Size="18"/>
                <span>@ledgerIssue</span>
            </div>
        </div>
    }

    <div class="workspace-grid">
        @foreach (var repository in Repositories)
        {
            <div class="card workspace-card">
                <div class="workspace-head">
                    <span class="profile-badge profile-generic" title="@string.Join(", ", repository.Aliases)">@repository.Repository</span>
                    <span class="health-dot @(RepositoryHealthy(repository) ? "ok" : "warn")" title="@Session.T("status")"></span>
                </div>
                @if (repository.Bound)
                {
                    <div class="workspace-path" title="@repository.SourcePath">@repository.SourcePath</div>
                    <div class="workspace-meta">
                        <span class="chip @(repository.PathHealth == "available" ? "ok" : "warn")">@Session.T($"src-health-{repository.PathHealth}")</span>
                        @if (repository.Dirty == true)
                        {
                            <span class="chip warn">@Session.T("src-dirty")</span>
                        }
                        <span class="chip">@Session.T("src-commit") @ShortCommit(repository.Commit)</span>
                    </div>
                    @if (repository.Warnings.Count > 0)
                    {
                        <ul class="workspace-issues">
                            @foreach (var warning in repository.Warnings)
                            {
                                <li>@warning.Message</li>
                            }
                        </ul>
                    }
                    <div class="actions">
                        <button class="btn btn-secondary" disabled="@Busy" @onclick="() => PreviewBindAsync(repository.Repository, repository.SourcePath!)">
                            <Icon Name="install" Size="16"/>
                            @Session.T("src-rebind")
                        </button>
                        <button class="btn btn-secondary" disabled="@Busy" @onclick="() => PreviewUnbindAsync(repository.Repository)">
                            <Icon Name="uninstall" Size="16"/>
                            @Session.T("src-unbind")
                        </button>
                    </div>
                }
                else
                {
                    <div class="banner banner-info">
                        <Icon Name="info" Size="18"/>
                        <span>@string.Format(Session.T("src-unbound-note"), repository.Repository)</span>
                    </div>
                    <div class="field">
                        <div class="input-row">
                            <input type="text" class="mono" @bind="BindPaths[repository.Repository]"
                                   placeholder="@SourcePlaceholder(repository)"/>
                            @if (SetupFolderPicker.IsSupported)
                            {
                                <button type="button" class="btn btn-secondary" disabled="@(PickBusy || Busy)"
                                        @onclick="() => BrowseSourceAsync(repository.Repository)">
                                    <Icon Name="folder" Size="16"/>
                                    @Session.T("browse")
                                </button>
                            }
                        </div>
                        <span class="hint">@Session.T("src-path-hint")</span>
                    </div>
                    <div class="actions">
                        <button class="btn btn-primary" disabled="@(Busy || string.IsNullOrWhiteSpace(BindPaths[repository.Repository]))"
                                @onclick="() => PreviewBindAsync(repository.Repository, BindPaths[repository.Repository])">
                            <Icon Name="file" Size="16"/>
                            @Session.T("src-bind-preview")
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    @if (Operation is not null)
    {
        <div class="card" id="plan-card">
            <h2>@Session.T("step-execute")</h2>
            @if (Operation.Error is not null)
            {
                <div class="banner banner-error">
                    <Icon Name="error-circle" Size="18"/>
                    <span>@Operation.Error</span>
                </div>
            }
            @if (Operation.Applied)
            {
                <div class="banner banner-ok">
                    <Icon Name="check-circle" Size="18"/>
                    <span>@Session.T("applied")</span>
                </div>
            }
            else if (Operation.PlanDigest is not null)
            {
                <div class="actions" style="margin-top:0">
                    <button class="btn btn-primary" disabled="@Busy" @onclick="ApplyAsync">
                        <Icon Name="rocket" Size="16"/>
                        @Session.T(ApplyAction == "unbind" ? "src-apply-unbind" : "src-apply-bind")
                    </button>
                </div>
                <p class="card-note">@Session.T("digest-note")</p>
            }
            <CheckList View="Operation.Checks"/>
            <PlanGroups View="Operation.Plan"/>
            @if (Busy && Phases.Count > 0)
            {
                <PhaseProgress Phases="Phases" Active="Busy"/>
            }
        </div>
    }
}

@code {
    [Inject]
    private SetupFacade Facade { get; set; } = default!;

    [Inject]
    private SetupSession Session { get; set; } = default!;

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private static readonly GuideIssueReportingMode[] IssueModes =
        [GuideIssueReportingMode.Prepare, GuideIssueReportingMode.Ask, GuideIssueReportingMode.Never];

    private bool Loading { get; set; } = true;

    private bool Busy { get; set; }

    private bool PickBusy { get; set; }

    private bool PreferenceBusy { get; set; }

    private GuideIssueReportingMode IssueMode { get; set; }

    private SetupWorkspaceProjectionView Projection { get; set; } = new(true, true);

    private bool ProjectionBusy { get; set; }

    private List<SetupSourceRepositoryView> Repositories { get; set; } = [];

    /// <summary>Per-repository checkout path inputs, keyed by the full repository name.</summary>
    private Dictionary<string, string> BindPaths { get; } = new(StringComparer.Ordinal);

    private SetupOperationView? Operation { get; set; }

    private string ApplyAction { get; set; } = "bind";

    private string? PendingRepository { get; set; }

    private string? PendingSourcePath { get; set; }

    private List<GuidePhase> Phases { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        // Only the machine-global agent policy owner manages sources; the hidden nav item
        // still leaves the URL reachable, so a non-owner lands on the dashboard instead.
        if (!Session.CurrentProduct.OwnsGlobalAgentPolicy)
        {
            Navigation.NavigateTo("");
            return;
        }

        Session.LanguageChanged += OnLanguageChanged;
        IssueMode = await Task.Run(() => Facade.GetIssueReporting());
        Projection = await Task.Run(() => Facade.GetWorkspaceProjection());
        await ReloadAsync();
        Loading = false;
    }

    private async Task ReloadAsync()
    {
        Repositories = [.. await Facade.ListSourcesAsync()];
        foreach (var repository in Repositories)
        {
            BindPaths.TryAdd(repository.Repository, string.Empty);
        }
    }

    private async Task SetIssueModeAsync(GuideIssueReportingMode mode)
    {
        PreferenceBusy = true;
        try
        {
            IssueMode = mode;
            await Task.Run(() => Facade.SetIssueReporting(mode));
        }
        finally
        {
            PreferenceBusy = false;
        }
    }

    private async Task SetProjectionAsync(bool sourceHints, bool issuePolicy)
    {
        ProjectionBusy = true;
        try
        {
            Projection = new SetupWorkspaceProjectionView(sourceHints, issuePolicy);
            await Task.Run(() => Facade.SetWorkspaceProjection(sourceHints, issuePolicy));
        }
        finally
        {
            ProjectionBusy = false;
        }
    }

    private async Task BrowseSourceAsync(string repository)
    {
        PickBusy = true;
        try
        {
            var picked = await SetupFolderPicker.PickDirectoryAsync(Session.T("browse-source-title"), BindPaths[repository]);
            if (!string.IsNullOrWhiteSpace(picked))
            {
                BindPaths[repository] = picked;
            }
        }
        finally
        {
            PickBusy = false;
        }
    }

    private async Task PreviewBindAsync(string repository, string sourcePath)
    {
        Busy = true;
        ApplyAction = "bind";
        PendingRepository = repository;
        PendingSourcePath = sourcePath;
        try
        {
            Operation = await Facade.PreviewSourceBindAsync(repository, sourcePath);
        }
        finally
        {
            Busy = false;
        }

        await RevealPlanAsync();
    }

    private async Task PreviewUnbindAsync(string repository)
    {
        Busy = true;
        ApplyAction = "unbind";
        PendingRepository = repository;
        PendingSourcePath = null;
        try
        {
            Operation = await Facade.PreviewSourceUnbindAsync(repository);
        }
        finally
        {
            Busy = false;
        }

        await RevealPlanAsync();
    }

    /// <summary>Brings the digest-locked plan card into view after a preview; source bindings stay preview-first.</summary>
    private async Task RevealPlanAsync()
    {
        if (Operation?.PlanDigest is null)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync(
                "eval",
                "document.getElementById('plan-card')?.scrollIntoView({behavior:'smooth', block:'start'})");
        }
        catch (JSDisconnectedException)
        {
            // A disconnected circuit has nothing left to scroll to.
        }
    }

    private async Task ApplyAsync()
    {
        if (Operation?.PlanDigest is null || PendingRepository is null)
        {
            return;
        }

        Busy = true;
        try
        {
            Operation = ApplyAction == "unbind"
                ? await Facade.ApplySourceUnbindAsync(PendingRepository, Operation.PlanDigest)
                : await Facade.ApplySourceBindAsync(PendingRepository, PendingSourcePath!, Operation.PlanDigest, CreatePhaseProgress());
            if (Operation.Applied)
            {
                await ReloadAsync();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private Progress<GuidePhase> CreatePhaseProgress()
    {
        Phases = [];
        return new Progress<GuidePhase>(phase =>
        {
            Phases.Add(phase);
            StateHasChanged();
        });
    }

    private bool RepositoryHealthy(SetupSourceRepositoryView repository)
        => repository.Bound && repository.PathHealth == "available" && repository.Dirty != true;

    private static string ModeKey(GuideIssueReportingMode mode)
        => mode.ToString().ToLowerInvariant();

    private static string ShortCommit(string? commit)
        => commit is null ? string.Empty : commit.Length > 12 ? commit[..12] : commit;

    private static string SourcePlaceholder(SetupSourceRepositoryView repository)
        => OperatingSystem.IsWindows()
            ? $@"D:\Code\{repository.Aliases.FirstOrDefault() ?? repository.Repository}"
            : $"~/code/{repository.Aliases.FirstOrDefault() ?? repository.Repository}";

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.LanguageChanged -= OnLanguageChanged;
}
