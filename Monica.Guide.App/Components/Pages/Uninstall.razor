@page "/uninstall"
@implements IDisposable

<h1 class="page-title">@Session.CurrentProduct.DisplayName · @Session.T("uninstall")</h1>
<p class="page-sub">@Session.T("data-retention-note")</p>

<div class="card">
    <h2>@Session.T("installed-targets")</h2>
    @if (Installations.Count == 0)
    {
        <div class="banner banner-warn">
            <Icon Name="alert" Size="18"/>
            <span>@Session.T("nothing-installed")</span>
        </div>
    }
    else
    {
        @if (ProjectInstallations.Count > 0)
        {
            <div class="field">
                <label>@Session.T("ws-group")</label>
                <div class="option-grid">
                    @foreach (var group in ProjectGroups)
                    {
                        <div class="option-card">
                            <span class="option-main">
                                <span class="option-title mono" title="@group.Key">@group.Key</span>
                                <span class="option-sub">@group.Sum(installation => installation.SkillCount) skills · @string.Join(", ", group.Select(installation => installation.TargetRoot))</span>
                            </span>
                            <button class="btn btn-secondary" disabled="@Busy" @onclick="() => PreviewWorkspaceRemovalAsync(group.Key)">
                                @Session.T("remove-target")
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        @if (GlobalInstallations.Count > 0)
        {
            <div class="field">
                <label>@Session.T("global-group")</label>
                <div class="option-grid">
                    @foreach (var installation in GlobalInstallations)
                    {
                        <div class="option-card">
                            <span class="option-main">
                                <span class="option-title">@TargetTitle(installation.Target)</span>
                                <span class="option-sub">@("@") @installation.EnvironmentSelector · @installation.SkillCount skills</span>
                            </span>
                            <button class="btn btn-secondary" disabled="@Busy" @onclick="() => PreviewRemovalAsync(installation)">
                                @Session.T("remove-target")
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<div class="card danger-zone">
    <h2>@Session.T("uninstall-everything")</h2>
    <div class="actions" style="margin-top:0">
        @if (Operation?.PlanDigest is null || Operation.Applied)
        {
            <button class="btn btn-secondary" disabled="@Busy" @onclick="PreviewAllAsync">
                <Icon Name="file" Size="16"/>
                @Session.T("preview-uninstall")
            </button>
        }
        @if (Operation?.PlanDigest is not null && Confirmed && !Operation.Applied)
        {
            <button class="btn btn-danger btn-lg" disabled="@Busy" @onclick="ApplyAsync">
                <Icon Name="uninstall" Size="16"/>
                @Session.T("execute-uninstall")
            </button>
        }
    </div>

    @if (Operation is not null)
    {
        @if (Operation.Error is not null)
        {
            <div class="banner banner-error">
                <Icon Name="error-circle" Size="18"/>
                <span>@Operation.Error</span>
            </div>
        }
        @if (Operation.Applied)
        {
            <div class="banner banner-ok">
                <Icon Name="check-circle" Size="18"/>
                <span>@Session.T("applied") @Session.T("uninstall-integration-note")</span>
            </div>
        }
        <CheckList View="Operation.Checks"/>
        <PlanGroups View="Operation.Plan"/>
        @if (Operation.PlanDigest is not null && !Operation.Applied && Operation.Plan.ChangeCount > 0)
        {
            <div class="confirm-line">
                <input type="checkbox" id="confirm" @bind="Confirmed"/>
                <label for="confirm">@Session.T("confirm-uninstall")</label>
            </div>
        }
        @if (Busy)
        {
            @if (Phases.Count > 0)
            {
                <PhaseProgress Phases="Phases" Active="Busy"/>
            }
            else
            {
                <div class="loading"><span class="spinner"></span>@Session.T("operating")</div>
            }
        }
    }
</div>

@code {
    [Inject]
    private SetupFacade Facade { get; set; } = default!;

    [Inject]
    private SetupSession Session { get; set; } = default!;

    private List<SetupInstallationView> Installations { get; set; } = [];

    private GuideUnconfigureRequest? PendingRequest { get; set; }

    private SetupOperationView? Operation { get; set; }

    private bool Confirmed { get; set; }

    private bool Busy { get; set; }

    private List<GuidePhase> Phases { get; set; } = [];

    private IReadOnlyList<SetupInstallationView> ProjectInstallations
        => [.. Installations.Where(static installation => installation.Workspace is not null)];

    private IReadOnlyList<SetupInstallationView> GlobalInstallations
        => [.. Installations.Where(static installation => installation.Workspace is null)];

    private IEnumerable<IGrouping<string, SetupInstallationView>> ProjectGroups
        => ProjectInstallations.GroupBy(static installation => installation.Workspace!, StringComparer.OrdinalIgnoreCase);

    private Progress<GuidePhase> CreatePhaseProgress()
    {
        Phases = [];
        return new Progress<GuidePhase>(phase =>
        {
            Phases.Add(phase);
            StateHasChanged();
        });
    }

    protected override async Task OnInitializedAsync()
    {
        Session.LanguageChanged += OnLanguageChanged;
        await ReloadInstallationsAsync();
    }

    private async Task ReloadInstallationsAsync()
    {
        Installations = [.. await Facade.ListInstallationsAsync()];
    }

    private async Task PreviewAllAsync() => await PreviewAsync(new GuideUnconfigureRequest());

    private async Task PreviewWorkspaceRemovalAsync(string workspace) => await PreviewAsync(new GuideUnconfigureRequest(Workspace: workspace));

    private async Task PreviewRemovalAsync(SetupInstallationView installation) => await PreviewAsync(new GuideUnconfigureRequest(
        [installation.Target],
        [GuideCommandParser.ParseEnvironment(installation.EnvironmentSelector)]));

    private async Task PreviewAsync(GuideUnconfigureRequest request)
    {
        Busy = true;
        Confirmed = false;
        PendingRequest = request;
        Operation = null;
        var progress = CreatePhaseProgress();
        try
        {
            Operation = await Facade.PreviewUninstallAsync(request, progress);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ApplyAsync()
    {
        if (Operation?.PlanDigest is null || PendingRequest is null)
        {
            return;
        }

        Busy = true;
        var progress = CreatePhaseProgress();
        try
        {
            Operation = await Facade.ApplyUninstallAsync(PendingRequest, Operation.PlanDigest, progress);
            Confirmed = false;
            if (Operation.Applied)
            {
                await ReloadInstallationsAsync();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private static string TargetTitle(GuideTarget target)
        => target == GuideTarget.Shared ? "~/.agents/skills" : "~/.claude/skills";

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.LanguageChanged -= OnLanguageChanged;
}
