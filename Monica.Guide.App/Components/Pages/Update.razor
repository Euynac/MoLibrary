@page "/update"
@implements IDisposable

<h1 class="page-title">@Session.CurrentProduct.DisplayName · @Session.T("update")</h1>
<p class="page-sub">@Session.T("update-flow-note")</p>

<div class="card">
    <h2>@Session.T("check-now")</h2>
    @if (Feed is null)
    {
        <div class="actions" style="margin-top:0">
            <button class="btn btn-primary" disabled="@Checking" @onclick="CheckAsync">
                <Icon Name="update" Size="16"/>
                @(Checking ? Session.T("checking") : Session.T("check-now"))
            </button>
        </div>
    }
    else if (Feed.Error is not null)
    {
        <div class="banner banner-error">
            <Icon Name="error-circle" Size="18"/>
            <span>@Feed.Error</span>
        </div>
        <div class="actions">
            <button class="btn btn-secondary" disabled="@Checking" @onclick="CheckAsync">@Session.T("check-now")</button>
        </div>
    }
    else if (!Feed.UpdateAvailable)
    {
        <div class="banner banner-ok">
            <Icon Name="check-circle" Size="18"/>
            <span>@Session.T("up-to-date") <span class="mono">@Feed.InstalledVersion</span></span>
        </div>
        <div class="actions">
            <button class="btn btn-ghost btn-sm" disabled="@Checking" @onclick="CheckAsync">@Session.T("check-now")</button>
        </div>
    }
    else
    {
        <div class="hero">
            <div class="hero-badge warn"><Icon Name="download" Size="26"/></div>
            <div class="hero-main">
                <h2 class="hero-title">
                    @Session.T("update-available")
                    <span class="badge accent">@Feed.LatestVersion</span>
                </h2>
                <p class="hero-sub">@Feed.LatestTitle · @FormatSize(Feed.ArchiveSizeBytes)</p>
            </div>
            <div class="hero-side">
                <div class="hero-version">@Feed.InstalledVersion</div>
                <div class="hero-version-label">@Session.T("currently-installed")</div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Feed.LatestNotes))
        {
            <div class="divider"></div>
            <h2>@Session.T("release-notes")</h2>
            <div class="notes-block">@Feed.LatestNotes</div>
        }
        <div class="actions">
            @if (Staging)
            {
                <button class="btn btn-primary" disabled><span class="spinner"></span>@PhaseLabel</button>
            }
            else
            {
                <button class="btn btn-primary" disabled="@Staging" @onclick="DownloadAsync">
                    <Icon Name="download" Size="16"/>
                    @(Staged is null ? Session.T("download-verify") : Session.T("download-again"))
                </button>
            }
        </div>
    }

    @if (Staging && Progress is not null)
    {
        <div class="progress-wrap">
            <div class="progress-meta">
                <span>@PhaseLabel</span>
                <span class="mono">@FormatBytes(Progress.Completed) / @(Progress.Total > 0 ? FormatBytes(Progress.Total) : "?")</span>
            </div>
            <div class="progress @(Progress.Total > 0 ? null : "indeterminate")">
                <div class="fill" style="width:@(Progress.Total > 0 ? Math.Clamp(Progress.Completed * 100 / Progress.Total, 0, 100) : 0)%"></div>
            </div>
        </div>
    }
    @if (StageError is not null)
    {
        <div class="banner banner-error">
            <Icon Name="error-circle" Size="18"/>
            <span>@StageError</span>
        </div>
    }
</div>

@if (Staged is not null || RollbackChoice is not null)
{
    <div class="card">
        <h2>@Session.T("step-execute")</h2>
        @if (Staged is not null)
        {
            <div class="banner banner-info">
                <Icon Name="check-circle" Size="18"/>
                <span>@Session.T("staged-ready") <span class="mono">v@(Staged.ProductVersion) (@(Staged.Tag))</span></span>
            </div>
        }
        @if (RollbackChoice is not null)
        {
            <div class="banner banner-warn">
                <Icon Name="history" Size="18"/>
                <span>@Session.T("rollback"): <span class="mono">v@(RollbackChoice.ProductVersion)</span></span>
            </div>
        }
        <div class="actions" style="margin-top:4px">
            @if (Operation?.PlanDigest is null)
            {
                <button class="btn btn-primary" disabled="@Busy" @onclick="PreviewAsync">
                    <Icon Name="file" Size="16"/>
                    @Session.T("preview-plan")
                </button>
            }
            else if (Operation.Applied)
            {
                <div class="banner banner-ok" style="margin:0">
                    <Icon Name="check-circle" Size="18"/>
                    <span>@Session.T("applied") @RestartLabel</span>
                </div>
            }
            else
            {
                <button class="btn btn-primary btn-lg" disabled="@Busy" @onclick="ApplyAsync">
                    <Icon Name="rocket" Size="16"/>
                    @(RollbackChoice is null ? Session.T("execute-install") : Session.T("rollback"))
                </button>
            }
        </div>
        @if (Operation is not null)
        {
            @if (Operation.Error is not null)
            {
                <div class="banner banner-error">
                    <Icon Name="error-circle" Size="18"/>
                    <span>@Operation.Error</span>
                </div>
            }
            <CheckList View="Operation.Checks"/>
            <PlanGroups View="Operation.Plan"/>
        }
        @if (Busy)
        {
            @if (Phases.Count > 0)
            {
                <PhaseProgress Phases="Phases" Active="Busy"/>
            }
            else
            {
                <div class="loading"><span class="spinner"></span>@Session.T("operating")</div>
            }
        }
    </div>
}

@if (Rollbacks.Count > 0 || RollbackScanning)
{
    <div class="card">
        <h2>@Session.T("rollback-title")</h2>
        <p class="note" style="margin:0 0 6px">@Session.T("rollback-hint")</p>
        @if (RollbackScanning)
        {
            <div class="loading"><span class="spinner"></span>@Session.T("operating")</div>
        }
        @foreach (var candidate in Rollbacks)
        {
            <div class="rollback-item">
                <Icon Name="history" Size="18" Class="ok"/>
                <span class="rollback-main">
                    <div><span class="badge neutral">v@(candidate.ProductVersion)</span></div>
                    <div class="note mono">@Path.GetDirectoryName(candidate.ApplicationDirectory)</div>
                </span>
                <button class="btn btn-secondary btn-sm" disabled="@Busy" @onclick="() => ChooseRollbackAsync(candidate)">
                    @Session.T("rollback")
                </button>
            </div>
        }
    </div>
}

@code {
    [Inject]
    private SetupFacade Facade { get; set; } = default!;

    [Inject]
    private SetupSession Session { get; set; } = default!;

    private SetupUpdateFeedView? Feed { get; set; }

    private bool Checking { get; set; }

    private bool Staging { get; set; }

    private SetupProgressView? Progress { get; set; }

    private SetupBundleView? Staged { get; set; }

    private string? StageError { get; set; }

    private SetupBundleView? RollbackChoice { get; set; }

    private SetupOperationView? Operation { get; set; }

    private IReadOnlyList<SetupBundleView> Rollbacks { get; set; } = [];

    private bool RollbackScanning { get; set; }

    private bool Busy { get; set; }

    private List<GuidePhase> Phases { get; set; } = [];

    private string? PreviousExecutable { get; set; }

    private bool WasRunning { get; set; }

    private string RestartLabel { get; set; } = string.Empty;

    private string PhaseLabel => Progress?.Phase switch
    {
        "download" => Session.T("phase-download"),
        "verify" => Session.T("phase-verify"),
        "extract" => Session.T("phase-extract"),
        "validate" => Session.T("phase-validate"),
        _ => Session.T("operating")
    };

    protected override void OnInitialized()
    {
        Session.LanguageChanged += OnLanguageChanged;
        // Scanning siblings hashes every bundle on disk; only the interactive circuit
        // starts it so the prerendered page paints immediately.
        if (RendererInfo.IsInteractive)
        {
            _ = LoadRollbacksAsync();
        }
    }

    private async Task LoadRollbacksAsync()
    {
        RollbackScanning = true;
        try
        {
            Rollbacks = await Facade.ListRollbackBundlesAsync();
        }
        finally
        {
            RollbackScanning = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Progress<GuidePhase> CreatePhaseProgress()
    {
        Phases = [];
        return new Progress<GuidePhase>(phase =>
        {
            Phases.Add(phase);
            StateHasChanged();
        });
    }

    private async Task CheckAsync()
    {
        Checking = true;
        try
        {
            Feed = await Facade.CheckForUpdateAsync();
        }
        finally
        {
            Checking = false;
        }
    }

    private async Task DownloadAsync()
    {
        if (Feed is null)
        {
            return;
        }

        Staging = true;
        StageError = null;
        Progress = null;
        try
        {
            var progress = new Progress<SetupProgressView>(value =>
            {
                Progress = value;
                InvokeAsync(StateHasChanged);
            });
            var staged = await Facade.StageUpdateAsync(Feed, progress);
            if (staged.Error is not null)
            {
                StageError = staged.Error;
            }
            else
            {
                Staged = staged.Bundle;
                RollbackChoice = null;
                await LoadRollbacksAsync();
            }
        }
        finally
        {
            Staging = false;
            Progress = null;
        }
    }

    private async Task PreviewAsync()
    {
        var bundle = Staged ?? RollbackChoice;
        if (bundle is null)
        {
            return;
        }

        Busy = true;
        var progress = CreatePhaseProgress();
        try
        {
            PreviousExecutable = Facade.InstalledExecutablePath;
            WasRunning = PreviousExecutable is not null && await Task.Run(() => PortListening());
            Operation = await Facade.PreviewInstallAsync(
                bundle.ApplicationDirectory,
                [],
                Session.CachedPort,
                progress);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ApplyAsync()
    {
        var bundle = Staged ?? RollbackChoice;
        if (bundle is null || Operation?.PlanDigest is null)
        {
            return;
        }

        Busy = true;
        var progress = CreatePhaseProgress();
        try
        {
            Operation = await Facade.ApplyInstallAsync(
                bundle.ApplicationDirectory,
                [],
                Session.CachedPort,
                Operation.PlanDigest,
                progress);
            if (Operation.Applied)
            {
                await RestartAfterApplyAsync();
                Staged = null;
                RollbackChoice = null;
                await LoadRollbacksAsync();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task RestartAfterApplyAsync()
    {
        if (!WasRunning)
        {
            return;
        }

        RestartLabel = Session.T("update-restart-note");
        await InvokeAsync(StateHasChanged);
        await Task.Run(() =>
        {
            if (PreviousExecutable is not null)
            {
                Facade.TryStopProductAt(PreviousExecutable, out _);
            }
        });
        await Task.Run(() => Facade.TryStartProduct(out _));
        RestartLabel = string.Empty;
    }

    private async Task ChooseRollbackAsync(SetupBundleView candidate)
    {
        RollbackChoice = candidate;
        Staged = null;
        Operation = null;
        await PreviewAsync();
    }

    private bool PortListening()
    {
        if (!Session.CurrentProduct.ServesLoopback)
        {
            return false;
        }
        using var client = new System.Net.Sockets.TcpClient();
        return client.ConnectAsync(
                System.Net.IPAddress.Loopback,
                GuideProductConfiguration.Load(Session.CurrentProduct).Port)
            .Wait(1_000);
    }

    private static string FormatBytes(long bytes)
        => bytes >= 1_073_741_824 ? $"{bytes / 1_073_741_824.0:F1} GB"
            : bytes >= 1_048_576 ? $"{bytes / 1_048_576.0:F1} MB"
            : bytes >= 1024 ? $"{bytes / 1024.0:F0} KB"
            : $"{bytes} B";

    private static string FormatSize(long bytes) => bytes > 0 ? FormatBytes(bytes) : "—";

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.LanguageChanged -= OnLanguageChanged;
}
