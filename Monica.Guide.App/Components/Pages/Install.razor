@page "/install"
@implements IDisposable

<h1 class="page-title">@Session.CurrentProduct.DisplayName · @Session.T("install")</h1>
<p class="page-sub">@Session.T("digest-note")</p>

<div class="steps">
    @for (var i = 0; i < StepLabels.Count; i++)
    {
        var index = i;
        <div class="step @(CurrentStep == index ? "current" : null) @(CurrentStep > index ? "done" : null)">
            <span class="step-dot">@(CurrentStep > index ? "✓" : (index + 1).ToString())</span>
            <span class="step-label">@StepLabels[index]</span>
        </div>
    }
</div>

@if (Presence.Count == 0 && !DetectionDone)
{
    <div class="loading"><span class="spinner"></span>@Session.T("operating")</div>
}
else
{
    <div class="card">
        <h2>1 · @Session.T("step-source")</h2>
        <div class="field">
            <label>@Session.T("bundle-path")</label>
            <div class="input-row">
                <input type="text" @bind="Session.BundlePath" @bind:after="ValidateAsync"
                       placeholder="@BundlePlaceholder"/>
                @if (SetupFolderPicker.IsSupported)
                {
                    <button type="button" class="btn btn-secondary" disabled="@PickBusy" @onclick="BrowseBundleAsync">
                        <Icon Name="folder" Size="16"/>
                        @Session.T("browse")
                    </button>
                }
            </div>
            <span class="hint">@Session.T("choose-folder-hint")</span>
        </div>
        @if (Bundle is not null)
        {
            if (Bundle.Error is not null)
            {
                <div class="banner banner-error">
                    <Icon Name="error-circle" Size="18"/>
                    <span>@Bundle.Error</span>
                </div>
            }
            else if (Bundle.Exists)
            {
                <div class="banner @(Bundle.HasManifest ? "banner-ok" : "banner-warn")">
                    <Icon Name="@(Bundle.HasManifest ? "check-circle" : "alert")" Size="18"/>
                    <span>
                        @(Bundle.HasManifest ? Session.T("bundle-valid") : Session.T("bundle-no-manifest"))
                        @if (Bundle.ProductVersion is not null)
                        {
                            <span>· <strong>@(Bundle.ProductName ?? Session.CurrentProduct.ProductName) v@(Bundle.ProductVersion)</strong></span>
                        }
                    </span>
                </div>
            }
        }
    </div>

    <div class="card">
        <h2>2 · @Session.T("step-options")</h2>
        <div class="field">
            <label>@Session.T("ws-group")</label>
            @if (Workspaces.Count == 0)
            {
                <div class="banner banner-info">
                    <Icon Name="info" Size="18"/>
                    <span>@Session.T("workspaces-empty")</span>
                </div>
                <div class="actions" style="margin-top:10px">
                    <a class="btn btn-secondary" href="workspaces">@Session.T("ws-add-title")</a>
                </div>
            }
            else
            {
                <div class="option-grid">
                    @foreach (var workspace in Workspaces)
                    {
                        var path = workspace.Workspace;
                        var selected = SelectedWorkspace == path;
                        <label class="option-card @(selected ? "selected" : null)" title="@path">
                            <input type="radio" name="install-workspace" checked="@selected"
                                   @onchange="() => SelectWorkspace(path)"/>
                            <span class="option-main">
                                <span class="option-title">@workspace.Profile</span>
                                <span class="option-sub mono">@path</span>
                            </span>
                        </label>
                    }
                </div>
                <span class="hint">@Session.T("workspaces-sub")</span>
            }
        </div>
        <details class="global-targets">
            <summary>@Session.T("global-targets")</summary>
            <div class="field" style="margin-top:12px">
                <label>@Session.T("select-targets")</label>
                <div class="option-grid">
                    @foreach (var environment in Environments())
                    {
                        @foreach (var target in TargetOptions)
                        {
                            var key = SelectionKey(environment.Selector, target);
                            var selected = Session.SelectedTargets.Contains(key);
                            <label class="option-card @(selected ? "selected" : null)">
                                <input type="checkbox" value="@key" checked="@selected"
                                       @onchange="e => ToggleTarget(key, (bool)(e.Value ?? false))"/>
                                <span class="option-main">
                                    <span class="option-title">@TargetTitle(target)</span>
                                    <span class="option-sub">@TargetPath(target) @("@") @environment.Selector</span>
                                </span>
                            </label>
                        }
                    }
                </div>
                <span class="hint">@Session.T("global-targets-hint")</span>
            </div>
            @if (Session.CurrentProduct.ServesLoopback)
            {
                <div class="field">
                    <label>@Session.T("port")</label>
                    <input type="number" @bind="Session.Port"/>
                </div>
            }
        </details>
    </div>

    <div class="card">
        <h2>3 · @Session.T("step-execute")</h2>
        <div class="actions" style="margin-top:0">
            <button class="btn btn-primary" disabled="@Busy" @onclick="PreviewAsync">
                <Icon Name="file" Size="16"/>
                @Session.T("preview-plan")
            </button>
            @if (Operation?.PlanDigest is not null && Bundle?.Exists == true && SelectionComplete && PortValid)
            {
                <button class="btn btn-primary" disabled="@Busy" @onclick="ApplyAsync">
                    <Icon Name="rocket" Size="16"/>
                    @Session.T("execute-install")
                </button>
            }
        </div>
        @if (ValidationError is not null)
        {
            <div class="banner banner-error">
                <Icon Name="error-circle" Size="18"/>
                <span>@ValidationError</span>
            </div>
        }
        @if (Operation is not null)
        {
            @if (Operation.Error is not null)
            {
                <div class="banner banner-error">
                    <Icon Name="error-circle" Size="18"/>
                    <span>@Operation.Error</span>
                </div>
            }
            @if (Operation.Applied)
            {
                <div class="banner banner-ok">
                    <Icon Name="check-circle" Size="18"/>
                    <span>@Session.T("applied")</span>
                </div>
                <div class="actions">
                    @if (Session.CurrentProduct.ServesLoopback)
                    {
                        <button class="btn btn-primary" disabled="@RestartBusy" @onclick="StartCockpitAsync">
                            @(RestartBusy ? Session.T("update-restart-note") : Session.T("start-cockpit"))
                        </button>
                    }
                    <a class="btn btn-secondary" href="">@Session.T("dashboard")</a>
                </div>
            }
            <CheckList View="Operation.Checks"/>
            <PlanGroups View="Operation.Plan"/>
        }
        @if (Busy)
        {
            @if (Phases.Count > 0)
            {
                <PhaseProgress Phases="Phases" Active="Busy"/>
            }
            else
            {
                <div class="loading"><span class="spinner"></span>@Session.T("operating")</div>
            }
        }
    </div>
}

@code {
    [Inject]
    private SetupFacade Facade { get; set; } = default!;

    [Inject]
    private SetupSession Session { get; set; } = default!;

    private static readonly GuideTarget[] TargetOptions = [GuideTarget.Shared, GuideTarget.Claude];

    private SetupBundleView? Bundle { get; set; }

    private SetupOperationView? Operation { get; set; }

    private List<SetupAgentPresence> Presence { get; set; } = [];

    private List<SetupWorkspaceView> Workspaces { get; set; } = [];

    private string? SelectedWorkspace { get; set; }

    private bool DetectionDone { get; set; }

    private string? ValidationError { get; set; }

    private bool Busy { get; set; }

    private bool RestartBusy { get; set; }

    private bool PickBusy { get; set; }

    /// <summary>Example extracted-bundle directory named after this platform's archive.</summary>
    private string BundlePlaceholder
    {
        get
        {
            var example = $"{Session.CurrentProduct.BundleDirectoryPrefix}v1.0.0-{AgentProductPlatform.CurrentRuntimeIdentifier}";
            return OperatingSystem.IsWindows() ? $@"C:\Tools\{example}" : $"~/tools/{example}";
        }
    }

    private List<GuidePhase> Phases { get; set; } = [];

    private Progress<GuidePhase> CreatePhaseProgress()
    {
        Phases = [];
        return new Progress<GuidePhase>(phase =>
        {
            Phases.Add(phase);
            StateHasChanged();
        });
    }

    private IReadOnlyList<string> StepLabels =>
    [
        Session.T("step-source"),
        Session.T("step-options"),
        Session.T("step-execute")
    ];

    private int CurrentStep => Operation?.Applied == true ? 2 : Operation?.PlanDigest is not null ? 2 : Bundle?.Exists == true ? 1 : 0;

    private bool SelectionComplete => SelectedWorkspace is not null || Session.SelectedTargets.Count > 0;

    private bool PortValid => !Session.CurrentProduct.ServesLoopback
                              || Session.SelectedTargets.Count > 0
                              || (int.TryParse(Session.Port, out var port) && port is > 0 and <= 65535);

    private int? SelectedPort => Session.CurrentProduct.ServesLoopback && int.TryParse(Session.Port, out var port)
        ? port
        : null;

    protected override async Task OnInitializedAsync()
    {
        Session.LanguageChanged += OnLanguageChanged;
        SeedDefaultBundle();
        if (string.IsNullOrWhiteSpace(Session.BundlePath))
        {
            Bundle = null;
        }
        else
        {
            Bundle = await Facade.ValidateBundleAsync(Session.BundlePath);
        }

        Workspaces = [.. await Facade.ListWorkspacesAsync()];
        SelectedWorkspace = Workspaces.Count == 1 ? Workspaces[0].Workspace : null;

        if (Session.PresenceChecked)
        {
            Presence = Session.PresenceCache is { } cached ? [.. cached] : [];
            DetectionDone = true;
            return;
        }

        var dashboard = await Facade.LoadDashboardAsync();
        Presence = [.. dashboard.Presence];
        Session.PresenceCache = dashboard.Presence;
        Session.PresenceChecked = true;
        Session.CachedPort = dashboard.ConfiguredPort;
        // Global catalogs are an explicit opt-out-of-project choice now: nothing is
        // pre-selected; the user opens the global section and checks targets deliberately.
        if (Session.CurrentProduct.ServesLoopback && dashboard.ConfiguredPort > 0)
        {
            Session.Port = dashboard.ConfiguredPort.ToString();
        }
        DetectionDone = true;
    }

    /// <summary>Defaults the bundle path to the bundle containing this setup executable.</summary>
    private void SeedDefaultBundle()
    {
        if (!string.IsNullOrWhiteSpace(Session.BundlePath))
        {
            return;
        }
        Session.BundlePath = Facade.DetectDefaultBundle() ?? string.Empty;
    }

    private IReadOnlyList<GuideEnvironment> Environments()
        => Presence
            .Select(static presence => presence.EnvironmentSelector)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(static selector => selector, StringComparer.OrdinalIgnoreCase)
            .Select(GuideCommandParser.ParseEnvironment)
            .ToArray();

    private static string SelectionKey(string selector, GuideTarget target)
        => $"{selector}::{target}";

    private void SelectWorkspace(string path)
    {
        SelectedWorkspace = path;
        Session.SelectedTargets.Clear();
    }

    private void ToggleTarget(string key, bool selected)
    {
        if (selected)
        {
            Session.SelectedTargets.Add(key);
            SelectedWorkspace = null;
        }
        else
        {
            Session.SelectedTargets.Remove(key);
        }
    }

    private async Task ValidateAsync()
    {
        Bundle = await Facade.ValidateBundleAsync(Session.BundlePath);
    }

    private async Task BrowseBundleAsync()
    {
        PickBusy = true;
        try
        {
            var picked = await SetupFolderPicker.PickDirectoryAsync(Session.T("browse-bundle-title"), Session.BundlePath);
            if (!string.IsNullOrWhiteSpace(picked))
            {
                Session.BundlePath = picked;
                await ValidateAsync();
            }
        }
        finally
        {
            PickBusy = false;
        }
    }

    private async Task PreviewAsync()
    {
        ValidationError = null;
        if (Bundle?.Exists != true)
        {
            ValidationError = Session.T("bundle-missing-exe");
            return;
        }

        if (!SelectionComplete)
        {
            ValidationError = Session.T("targets-required");
            return;
        }

        if (!PortValid)
        {
            ValidationError = Session.T("port-invalid");
            return;
        }

        Busy = true;
        var progress = CreatePhaseProgress();
        try
        {
            Operation = SelectedWorkspace is not null
                ? await Facade.PreviewWorkspaceInstallAsync(SelectedWorkspace, progress: progress)
                : await Facade.PreviewInstallAsync(Bundle.ApplicationDirectory, SelectedTargets(), SelectedPort, progress);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ApplyAsync()
    {
        if (Operation?.PlanDigest is null || Bundle is null)
        {
            return;
        }

        Busy = true;
        var progress = CreatePhaseProgress();
        try
        {
            Operation = SelectedWorkspace is not null
                ? await Facade.ApplyWorkspaceInstallAsync(SelectedWorkspace, Operation.PlanDigest, progress: progress)
                : await Facade.ApplyInstallAsync(Bundle.ApplicationDirectory, SelectedTargets(), SelectedPort, Operation.PlanDigest, progress);
            if (Operation.Applied)
            {
                Workspaces = [.. await Facade.ListWorkspacesAsync()];
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private List<GuideTargetSelection> SelectedTargets()
        => Environments()
            .Select(environment => new GuideTargetSelection(
                environment,
                TargetOptions
                    .Where(target => Session.SelectedTargets.Contains(SelectionKey(environment.Selector, target)))
                    .ToArray()))
            .Where(static selection => selection.Targets.Count > 0)
            .ToList();

    private async Task StartCockpitAsync()
    {
        RestartBusy = true;
        try
        {
            await Task.Run(() => Facade.TryStartProduct(out _));
        }
        finally
        {
            RestartBusy = false;
        }
    }

    private static string AgentTitle(GuideAgent agent)
        => agent switch
        {
            GuideAgent.Claude => "Claude Code",
            GuideAgent.Codex => "Codex CLI",
            _ => agent.ToString()
        };

    private static string TargetTitle(GuideTarget target)
        => target == GuideTarget.Shared ? "~/.agents/skills" : "~/.claude/skills";

    private static string TargetPath(GuideTarget target)
        => target == GuideTarget.Shared ? "shared" : "claude";

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.LanguageChanged -= OnLanguageChanged;
}
