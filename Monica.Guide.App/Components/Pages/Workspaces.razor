@page "/workspaces"
@implements IDisposable

<h1 class="page-title">@Session.CurrentProduct.DisplayName · @Session.T("workspaces")</h1>
<p class="page-sub">@Session.T("workspaces-sub")</p>

@if (Loading)
{
    <div class="loading"><span class="spinner"></span>@Session.T("operating")</div>
}
else
{
    @if (Session.CurrentProduct.GlobalGuideSkill is not null)
    {
        <div class="card">
            <div class="switch-row">
                <span class="switch-text">
                    <span class="primary">@string.Format(Session.T("ws-global-guide-title"), Session.CurrentProduct.GlobalGuideSkill)</span>
                    <span class="secondary">@string.Format(Session.T("ws-global-guide-note"), Session.CurrentProduct.GlobalGuideSkill)</span>
                </span>
                <label class="switch">
                    <input type="checkbox" checked="@GlobalGuideSkill"
                           disabled="@PreferenceBusy"
                           @onchange="e => SetGlobalGuideSkillAsync((bool)e.Value!)"/>
                    <span class="track"></span>
                </label>
            </div>
        </div>
    }
    @if (Registered.Count == 0)
    {
        <div class="card">
            <div class="banner banner-info">
                <Icon Name="info" Size="18"/>
                <span>@Session.T("workspaces-empty")</span>
            </div>
        </div>
    }
    else
    {
        <div class="workspace-grid">
            @foreach (var workspace in Registered)
            {
                <div class="card workspace-card @(workspace.Issues.Count > 0 || !workspace.DirectoryExists ? "workspace-attention" : null)">
                    <div class="workspace-head">
                        <span class="profile-badge profile-@ProfileClass(workspace.Profile)">@workspace.Profile</span>
                        <span class="health-dot @(workspace.Healthy ? "ok" : "warn")" title="@Session.T("status")"></span>
                    </div>
                    <div class="workspace-path" title="@workspace.Workspace">@workspace.Workspace</div>
                    <div class="workspace-meta">
                        <span class="chip ok">@workspace.InstalledSkillCount/@workspace.ProfileSkillCount @Session.T("ws-skills")</span>
                        <span class="chip @(workspace.InstructionsCurrent ? "ok" : "warn")">@Session.T("ws-instructions")</span>
                        @foreach (var capability in workspace.Capabilities)
                        {
                            <span class="chip">@capability</span>
                        }
                    </div>
                    @if (workspace.Issues.Count > 0)
                    {
                        <ul class="workspace-issues">
                            @foreach (var issue in workspace.Issues)
                            {
                                <li>@issue</li>
                            }
                        </ul>
                    }
                    @if (RuleStates.TryGetValue(workspace.Workspace, out var rules) && rules.Count > 0)
                    {
                        <details class="workspace-rules">
                            <summary>
                                <span>@Session.T("ws-rules-title")</span>
                                @if (rules.Any(RuleIsDirty))
                                {
                                    <span class="chip warn">@Session.T("ws-rules-pending")</span>
                                }
                            </summary>
                            <p class="hint">@Session.T("ws-rules-hint")</p>
                            @foreach (var rule in rules)
                            {
                                <div class="switch-row rule-row">
                                    <span class="switch-text">
                                        <span class="primary mono">@rule.Id</span>
                                        <span class="secondary">@rule.Text</span>
                                    </span>
                                    <label class="switch">
                                        <input type="checkbox" checked="@rule.StagedEnabled"
                                               disabled="@Busy"
                                               @onchange="e => ToggleRule(workspace.Workspace, rule.Id, (bool)e.Value!)"/>
                                        <span class="track"></span>
                                    </label>
                                </div>
                            }
                        </details>
                    }
                    <div class="actions">
                        <button class="btn btn-primary" disabled="@Busy" @onclick="() => InstallAsync(workspace)">
                            <Icon Name="install" Size="16"/>
                            @(workspace.InstalledSkillCount == 0 ? Session.T("ws-install") : Session.T("ws-update"))
                        </button>
                        <button class="btn btn-secondary" disabled="@Busy" @onclick="() => ForgetAsync(workspace)">
                            <Icon Name="uninstall" Size="16"/>
                            @Session.T("ws-forget")
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="card">
        <h2>@Session.T("ws-preview-title")</h2>
        <p class="card-note">@Session.T(Session.CurrentProduct.OwnsGlobalAgentPolicy ? "ws-preview-note" : "ws-preview-note-plain")</p>
        @if (Session.CurrentProduct.OwnsGlobalAgentPolicy)
        {
            <div class="switch-row">
                <span class="switch-text">
                    <span class="primary">@Session.T("src-proj-sources-title")</span>
                    <span class="secondary">@Session.T("src-proj-sources-note")</span>
                </span>
                <label class="switch">
                    <input type="checkbox" checked="@Projection.SourceHints" disabled="@PreferenceBusy"
                           @onchange="e => SetProjectionAsync(sourceHints: (bool)e.Value!, issuePolicy: Projection.IssuePolicy)"/>
                    <span class="track"></span>
                </label>
            </div>
            <div class="switch-row">
                <span class="switch-text">
                    <span class="primary">@Session.T("src-proj-issue-title")</span>
                    <span class="secondary">@Session.T("src-proj-issue-note")</span>
                </span>
                <label class="switch">
                    <input type="checkbox" checked="@Projection.IssuePolicy" disabled="@PreferenceBusy"
                           @onchange="e => SetProjectionAsync(sourceHints: Projection.SourceHints, issuePolicy: (bool)e.Value!)"/>
                    <span class="track"></span>
                </label>
            </div>
            <div class="field">
                <label>@Session.T("ws-preview-issue-mode")</label>
                <div class="option-grid">
                    @foreach (var mode in IssueModes)
                    {
                        var selected = IssueMode == mode;
                        <label class="option-card @(selected ? "selected" : null)">
                            <input type="radio" name="ws-preview-issue-mode" checked="@selected" disabled="@PreferenceBusy"
                                   @onchange="() => SetIssueModeAsync(mode)"/>
                            <span class="option-main">
                                <span class="option-title">@Session.T($"src-issue-mode-{ModeKey(mode)}")</span>
                                <span class="option-desc">@Session.T($"src-issue-desc-{ModeKey(mode)}")</span>
                            </span>
                        </label>
                    }
                </div>
            </div>
        }
        @if (InstructionsPreview is { Body: { } sampleBody })
        {
            <div class="instruction-sample">
                <div class="instruction-sample-head">
                    <span class="chip">AGENTS.md</span>
                    <span class="chip">@string.Format(Session.T("ws-preview-profile"), InstructionsPreview.Profile)</span>
                </div>
<pre class="code-block instruction-sample-body"><span class="instruction-marker">@InstructionsPreview.StartMarker</span>
@sampleBody
<span class="instruction-marker">@InstructionsPreview.EndMarker</span></pre>
            </div>
        }
        else
        {
            <div class="banner banner-info">
                <Icon Name="info" Size="18"/>
                <span>@Session.T("ws-preview-unavailable")</span>
            </div>
        }
    </div>

    <div class="card">
        <h2>@Session.T("ws-add-title")</h2>
        <div class="field">
            <label>@Session.T("ws-path")</label>
            <div class="input-row">
                <input type="text" @bind="CandidatePath" @bind:after="InspectAsync"
                       placeholder="@WorkspacePlaceholder"/>
                @if (SetupFolderPicker.IsSupported)
                {
                    <button type="button" class="btn btn-secondary" disabled="@(PickBusy || Inspecting)" @onclick="BrowseWorkspaceAsync">
                        <Icon Name="folder" Size="16"/>
                        @Session.T("browse")
                    </button>
                }
            </div>
            <span class="hint">@Session.T("ws-path-hint")</span>
        </div>
        @if (Inspecting)
        {
            <div class="loading">
                <span class="spinner"></span>
                <span>@Session.T("ws-inspecting") <span class="mono">@CandidatePath</span></span>
            </div>
        }
        else if (Detection is not null)
        {
            <div class="banner @(Detection.Outcome == GuideWorkspaceDetectionOutcome.NotADirectory
                                     ? "banner-error"
                                     : Detection.Initialized ? "banner-ok" : "banner-info")">
                <Icon Name="@(Detection.Initialized
                                  ? "check-circle"
                                  : Detection.Outcome == GuideWorkspaceDetectionOutcome.NotADirectory
                                      ? "error-circle"
                                      : "info")" Size="18"/>
                <span>
                    @DetectionText
                    @if (Detection.FrameworkVersion is not null)
                    {
                        <span> · @Session.T("version") @Detection.FrameworkVersion</span>
                    }
                    @if (Detection.Initialized)
                    {
                        <span> · @Session.T("ws-already-initialized")</span>
                    }
                </span>
            </div>
        }
        @if (Detection is { Initialized: false, Outcome: not GuideWorkspaceDetectionOutcome.NotADirectory })
        {
            <div class="field">
                <label>@Session.T("ws-profile")</label>
                <div class="option-grid wide">
                    @foreach (var profile in Profiles)
                    {
                        var selected = SelectedProfile == profile;
                        <label class="option-card @(selected ? "selected" : null)">
                            <input type="radio" name="ws-profile" checked="@selected"
                                   @onchange="() => SelectProfile(profile)"/>
                            <span class="option-main">
                                <span class="option-title">@profile</span>
                                <span class="option-desc">@Session.T($"ws-profile-desc-{profile}")</span>
                            </span>
                        </label>
                    }
                </div>
                @if (Detection.CandidateProfile is { } candidate)
                {
                    <span class="hint">@Session.T("ws-profile-hint") @(Session.T("ws-candidate")): @candidate (@Detection.Confidence)</span>
                }
            </div>
            @if (SelectedProfile == "application")
            {
                <div class="field">
                    <label>@Session.T("ws-architecture")</label>
                    <div class="option-grid">
                        @foreach (var architecture in Architectures)
                        {
                            var selected = SelectedArchitecture == architecture;
                            <label class="option-card @(selected ? "selected" : null)">
                                <input type="radio" name="ws-arch" checked="@selected"
                                       @onchange="() => SelectedArchitecture = architecture"/>
                                <span class="option-main">
                                    <span class="option-title">@architecture</span>
                                </span>
                            </label>
                        }
                    </div>
                </div>
            }
            <div class="actions" style="margin-top:0">
                <button class="btn btn-primary" disabled="@(Busy || Inspecting || SelectedProfile is null)" @onclick="InitPreviewAsync">
                    <Icon Name="file" Size="16"/>
                    @Session.T("ws-init-preview")
                </button>
            </div>
        }
        else if (Detection is { Initialized: true })
        {
            <div class="actions" style="margin-top:0">
                <button class="btn btn-primary" disabled="@Busy" @onclick="() => InstallForPathAsync(CandidatePath!)">
                    <Icon Name="install" Size="16"/>
                    @Session.T("ws-install")
                </button>
            </div>
        }
        @if (ValidationError is not null)
        {
            <div class="banner banner-error">
                <Icon Name="error-circle" Size="18"/>
                <span>@ValidationError</span>
            </div>
        }
    </div>

    @if (Operation is not null)
    {
        <div class="card" id="plan-card">
            <h2>@Session.T("step-execute")</h2>
            @if (Operation.Error is not null)
            {
                <div class="banner banner-error">
                    <Icon Name="error-circle" Size="18"/>
                    <span>@Operation.Error</span>
                </div>
            }
            @if (Operation.Applied)
            {
                <div class="banner banner-ok">
                    <Icon Name="check-circle" Size="18"/>
                    <span>@Session.T("applied")</span>
                </div>
            }
            else if (Operation.PlanDigest is not null)
            {
                <div class="actions" style="margin-top:0">
                    <button class="btn btn-primary" disabled="@Busy" @onclick="ApplyAsync">
                        <Icon Name="rocket" Size="16"/>
                        @Session.T(ApplyAction == "forget" ? "ws-apply-forget" : "ws-apply-install")
                    </button>
                </div>
                <p class="card-note">@Session.T("digest-note")</p>
            }
            <CheckList View="Operation.Checks"/>
            <PlanGroups View="Operation.Plan"/>
            @if (Busy && Phases.Count > 0)
            {
                <PhaseProgress Phases="Phases" Active="Busy"/>
            }
        </div>
    }
}

@code {
    [Inject]
    private SetupFacade Facade { get; set; } = default!;

    [Inject]
    private SetupSession Session { get; set; } = default!;

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    private static readonly string[] Profiles = ["application", "extension-author", "framework-contributor", "docs-contributor"];
    private static readonly string[] Architectures = ["microservice", "modular-monolith"];
    private static readonly GuideIssueReportingMode[] IssueModes =
        [GuideIssueReportingMode.Prepare, GuideIssueReportingMode.Ask, GuideIssueReportingMode.Never];

    private bool Loading { get; set; } = true;

    private bool Busy { get; set; }

    private bool PickBusy { get; set; }

    private bool Inspecting { get; set; }

    private bool GlobalGuideSkill { get; set; }

    private bool PreferenceBusy { get; set; }

    private GuideIssueReportingMode IssueMode { get; set; }

    private SetupWorkspaceProjectionView Projection { get; set; } = new(true, true);

    private SetupInstructionsPreviewView? InstructionsPreview { get; set; }

    private async Task SetGlobalGuideSkillAsync(bool enabled)
    {
        PreferenceBusy = true;
        try
        {
            GlobalGuideSkill = enabled;
            await Task.Run(() => Facade.SetGlobalGuideSkill(enabled));
        }
        finally
        {
            PreferenceBusy = false;
        }
    }

    /// <summary>
    /// Sets one projection switch and re-renders the instruction example so the effect of the
    /// machine-global switch is visible immediately, not only after the next update converges.
    /// </summary>
    private async Task SetProjectionAsync(bool sourceHints, bool issuePolicy)
    {
        PreferenceBusy = true;
        try
        {
            Projection = new SetupWorkspaceProjectionView(sourceHints, issuePolicy);
            await Task.Run(() => Facade.SetWorkspaceProjection(sourceHints, issuePolicy));
            await LoadInstructionsPreviewAsync();
        }
        finally
        {
            PreferenceBusy = false;
        }
    }

    private async Task SetIssueModeAsync(GuideIssueReportingMode mode)
    {
        PreferenceBusy = true;
        try
        {
            IssueMode = mode;
            await Task.Run(() => Facade.SetIssueReporting(mode));
            await LoadInstructionsPreviewAsync();
        }
        finally
        {
            PreferenceBusy = false;
        }
    }

    /// <summary>Previews with a registered workspace's profile when one exists, else the catalog default.</summary>
    private async Task LoadInstructionsPreviewAsync()
        => InstructionsPreview = await Facade.PreviewWorkspaceInstructionsAsync(Registered.FirstOrDefault()?.Profile);

    private List<SetupWorkspaceView> Registered { get; set; } = [];

    /// <summary>One managed rule with its on-disk switch state and the toggle state staged in this page.</summary>
    private sealed record WorkspaceRuleState(string Id, string Text, bool EnabledOnDisk, bool StagedEnabled);

    private Dictionary<string, List<WorkspaceRuleState>> RuleStates { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<GuideRuleSwitch>? PendingRuleSwitches { get; set; }

    private static bool RuleIsDirty(WorkspaceRuleState rule)
        => rule.StagedEnabled != rule.EnabledOnDisk;

    private void ToggleRule(string workspace, string id, bool enabled)
    {
        if (!RuleStates.TryGetValue(workspace, out var rules))
        {
            return;
        }

        var index = rules.FindIndex(rule => string.Equals(rule.Id, id, StringComparison.Ordinal));
        if (index >= 0)
        {
            rules[index] = rules[index] with { StagedEnabled = enabled };
        }
    }

    /// <summary>
    /// The staged switch state for one workspace, or null when it exposes no rules; applying
    /// every staged state (not only the deltas) keeps the digest-locked replay idempotent.
    /// </summary>
    private IReadOnlyList<GuideRuleSwitch>? SwitchesFor(string workspace)
        => RuleStates.TryGetValue(workspace, out var rules) && rules.Count > 0
            ? rules.Select(static rule => new GuideRuleSwitch(rule.Id, rule.StagedEnabled)).ToArray()
            : null;

    private string CandidatePath { get; set; } = string.Empty;

    /// <summary>Example project root in this host's path shape.</summary>
    private string WorkspacePlaceholder
        => OperatingSystem.IsWindows() ? @"D:\Code\MyMonicaApp" : "~/code/MyMonicaApp";

    private SetupWorkspaceDetectionView? Detection { get; set; }

    /// <summary>Localized detection verdict; recomputed per render so language switches apply.</summary>
    private string DetectionText => Detection?.Outcome switch
    {
        GuideWorkspaceDetectionOutcome.FrameworkRepository => Session.T("ws-detect-framework"),
        GuideWorkspaceDetectionOutcome.DocsRepository => Session.T("ws-detect-docs"),
        GuideWorkspaceDetectionOutcome.ExtensionCharacteristics => Session.T("ws-detect-extension"),
        GuideWorkspaceDetectionOutcome.ApplicationCharacteristics => Session.T("ws-detect-application"),
        GuideWorkspaceDetectionOutcome.AmbiguousApplicationAndExtension => Session.T("ws-detect-ambiguous-both"),
        GuideWorkspaceDetectionOutcome.AmbiguousApplicationUnscanned => Session.T("ws-detect-ambiguous-unscanned"),
        GuideWorkspaceDetectionOutcome.AmbiguousScanExhausted => Session.T("ws-detect-ambiguous-exhausted"),
        GuideWorkspaceDetectionOutcome.AmbiguousNoCharacteristics => Session.T("ws-detect-ambiguous-none"),
        _ => Session.T("ws-detect-not-directory")
    };

    private string? SelectedProfile { get; set; }

    private string? SelectedArchitecture { get; set; }

    private SetupOperationView? Operation { get; set; }

    private string ApplyAction { get; set; } = "install";

    private string? ValidationError { get; set; }

    private string? PendingWorkspace { get; set; }

    private List<GuidePhase> Phases { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        Session.LanguageChanged += OnLanguageChanged;
        GlobalGuideSkill = await Task.Run(() => Facade.GetGlobalGuideSkill());
        if (Session.CurrentProduct.OwnsGlobalAgentPolicy)
        {
            IssueMode = await Task.Run(() => Facade.GetIssueReporting());
            Projection = await Task.Run(() => Facade.GetWorkspaceProjection());
        }

        await ReloadAsync();
        await LoadInstructionsPreviewAsync();
        Loading = false;
    }

    private async Task ReloadAsync()
    {
        Registered = [.. await Facade.ListWorkspacesAsync()];
        await LoadRuleStatesAsync();
        await LoadInstructionsPreviewAsync();
    }

    private async Task LoadRuleStatesAsync()
    {
        var states = new Dictionary<string, List<WorkspaceRuleState>>(StringComparer.OrdinalIgnoreCase);
        foreach (var workspace in Registered)
        {
            var view = await Facade.DescribeWorkspaceRulesAsync(workspace.Workspace);
            if (view.Profile is null)
            {
                continue;
            }

            states[workspace.Workspace] = view.Rules
                .Select(static rule => new WorkspaceRuleState(rule.Id, rule.Text, rule.Enabled, rule.Enabled))
                .ToList();
        }

        RuleStates = states;
    }

    private async Task InspectAsync()
    {
        Detection = null;
        ValidationError = null;
        SelectedProfile = null;
        SelectedArchitecture = null;
        if (string.IsNullOrWhiteSpace(CandidatePath))
        {
            return;
        }

        // Detection walks the candidate tree and probes Git identity, so it can take a
        // moment on large checkouts; the inspecting state keeps that visible, and a
        // superseded path simply discards its own slower result.
        var inspectedPath = CandidatePath;
        Inspecting = true;
        try
        {
            var detection = await Facade.InspectWorkspaceAsync(inspectedPath);
            if (!string.Equals(CandidatePath, inspectedPath, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            Detection = detection;
            SelectedProfile = detection.CandidateProfile is { } candidate && Profiles.Contains(candidate)
                ? candidate
                : null;
        }
        finally
        {
            Inspecting = false;
        }
    }

    private async Task BrowseWorkspaceAsync()
    {
        PickBusy = true;
        try
        {
            var picked = await SetupFolderPicker.PickDirectoryAsync(Session.T("browse-workspace-title"), CandidatePath);
            if (!string.IsNullOrWhiteSpace(picked))
            {
                CandidatePath = picked;
                await InspectAsync();
            }
        }
        finally
        {
            PickBusy = false;
        }
    }

    private void SelectProfile(string profile)
    {
        SelectedProfile = profile;
        if (profile != "application")
        {
            SelectedArchitecture = null;
        }
    }

    private async Task InitPreviewAsync()
    {
        ValidationError = null;
        if (SelectedProfile is null)
        {
            ValidationError = Session.T("ws-profile-required");
            return;
        }

        if (SelectedProfile == "application" && SelectedArchitecture is null)
        {
            ValidationError = Session.T("ws-architecture-required");
            return;
        }

        Busy = true;
        ApplyAction = "init";
        PendingWorkspace = CandidatePath;
        PendingRuleSwitches = null;
        try
        {
            var capabilities = SelectedProfile == "application" && SelectedArchitecture is not null
                ? [SelectedArchitecture]
                : Array.Empty<string>();
            Operation = await Facade.PreviewWorkspaceInitAsync(CandidatePath, SelectedProfile, capabilities);
        }
        finally
        {
            Busy = false;
        }

        await RevealPlanAsync();
    }

    private async Task InstallAsync(SetupWorkspaceView workspace)
        => await InstallForPathAsync(workspace.Workspace);

    private async Task InstallForPathAsync(string workspace)
    {
        ValidationError = null;
        Busy = true;
        ApplyAction = "install";
        PendingWorkspace = workspace;
        PendingRuleSwitches = SwitchesFor(workspace);
        try
        {
            Operation = await Facade.PreviewWorkspaceInstallAsync(workspace, PendingRuleSwitches, CreatePhaseProgress());
        }
        finally
        {
            Busy = false;
        }

        await RevealPlanAsync();
    }

    private async Task ForgetAsync(SetupWorkspaceView workspace)
    {
        Busy = true;
        ApplyAction = "forget";
        PendingWorkspace = workspace.Workspace;
        PendingRuleSwitches = null;
        try
        {
            Operation = await Facade.PreviewWorkspaceForgetAsync(workspace.Workspace);
        }
        finally
        {
            Busy = false;
        }

        await RevealPlanAsync();
    }

    /// <summary>
    /// Brings the digest-locked plan card into view after a preview so the second, applying
    /// click is unmissable: every workspace mutation is preview-first and applies nothing by itself.
    /// </summary>
    private async Task RevealPlanAsync()
    {
        if (Operation?.PlanDigest is null)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync(
                "eval",
                "document.getElementById('plan-card')?.scrollIntoView({behavior:'smooth', block:'start'})");
        }
        catch (JSDisconnectedException)
        {
            // A disconnected circuit has nothing left to scroll to.
        }
    }

    private async Task ApplyAsync()
    {
        if (Operation?.PlanDigest is null || PendingWorkspace is null)
        {
            return;
        }

        Busy = true;
        try
        {
            Operation = ApplyAction switch
            {
                "init" => await Facade.ApplyWorkspaceInitAsync(
                    PendingWorkspace, SelectedProfile!, CapabilitiesForInit(), Operation.PlanDigest),
                "forget" => await Facade.ApplyWorkspaceForgetAsync(PendingWorkspace, Operation.PlanDigest),
                _ => await Facade.ApplyWorkspaceInstallAsync(
                    PendingWorkspace, Operation.PlanDigest, PendingRuleSwitches, CreatePhaseProgress())
            };
            if (Operation.Applied)
            {
                await ReloadAsync();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private IReadOnlyList<string> CapabilitiesForInit()
        => SelectedProfile == "application" && SelectedArchitecture is not null
            ? [SelectedArchitecture]
            : Array.Empty<string>();

    private Progress<GuidePhase> CreatePhaseProgress()
    {
        Phases = [];
        return new Progress<GuidePhase>(phase =>
        {
            Phases.Add(phase);
            StateHasChanged();
        });
    }

    private static string ModeKey(GuideIssueReportingMode mode)
        => mode.ToString().ToLowerInvariant();

    private static string ProfileClass(string profile)
        => profile switch
        {
            "application" => "application",
            "extension-author" => "extension",
            "framework-contributor" => "framework",
            "docs-contributor" => "docs",
            _ => "generic"
        };

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.LanguageChanged -= OnLanguageChanged;
}
