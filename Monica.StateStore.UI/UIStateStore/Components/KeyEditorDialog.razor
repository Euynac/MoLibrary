@using Monica.StateStore.UI.Services
@using Monica.StateStore.UI.Models
@using Monica.Core.Results;
@using Monica.StateStore.Models
@inject StateStoreUIService StateStoreService
@inject ISnackbar Snackbar
@inject IStringLocalizer<StateStoreResource> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @* Key name *@
            <MudTextField Value="@KeyInfo.Key"
                          Label="@L["KeyEditor:Labels:KeyName"]"
                          Variant="Variant.Outlined"
                          ReadOnly="true"
                          Style="font-family: monospace;" />

            @* ETag *@
            @if (!string.IsNullOrEmpty(KeyInfo.ETag))
            {
                <MudTextField Value="@KeyInfo.ETag"
                              Label="@L["KeyEditor:Labels:ETag"]"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              Style="font-family: monospace;" />
            }

            @* TTL (edit mode only) *@
            @if (!ReadOnly)
            {
                <MudNumericField @bind-Value="ttlSeconds"
                                 Label="@L["KeyEditor:Labels:TTL"]"
                                 Variant="Variant.Outlined"
                                 Min="0"
                                 Adornment="Adornment.End"
                                 AdornmentText="@L["KeyEditor:Labels:TTLUnit"]" />
            }

            @* JSON value editor *@
            <MudTextField @bind-Value="editedValue"
                          Label="@L["KeyEditor:Labels:JsonValue"]"
                          Variant="Variant.Outlined"
                          Lines="15"
                          ReadOnly="@ReadOnly"
                          Style="font-family: monospace;"
                          HelperText="@(ReadOnly ? "" : L["KeyEditor:Labels:JsonHelperText"])" />

            @if (!ReadOnly)
            {
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FormatIndentIncrease"
                               OnClick="FormatJson"
                               Size="Size.Small">
                        @L["KeyEditor:Actions:FormatJson"]
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Compress"
                               OnClick="MinifyJson"
                               Size="Size.Small">
                        @L["KeyEditor:Actions:MinifyJson"]
                    </MudButton>
                </div>
            }

            @if (errorMessage != null)
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["KeyEditor:Actions:Cancel"]</MudButton>
        @if (!ReadOnly)
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="SaveAsync"
                       Disabled="isSaving">
                @if (isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @L["KeyEditor:Actions:Save"]
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public StateStoreKeyInfo KeyInfo { get; set; } = null!;
    [Parameter] public string? ServiceKey { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<StateStoreKeyInfo> OnSaved { get; set; }

    private string editedValue = "";
    private int ttlSeconds = 0;
    private bool isSaving = false;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        editedValue = KeyInfo.RawValue ?? "";
        ttlSeconds = KeyInfo.TTLStatus switch
        {
            EStateStoreKeyTtlStatus.Expiring when KeyInfo.TTL.HasValue => (int)Math.Ceiling(KeyInfo.TTL.Value.TotalSeconds),
            EStateStoreKeyTtlStatus.Permanent => 0,
            _ => ttlSeconds
        };
    }

    private void FormatJson()
    {
        try
        {
            var obj = System.Text.Json.JsonSerializer.Deserialize<object>(editedValue);
            editedValue = System.Text.Json.JsonSerializer.Serialize(obj, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = L["KeyEditor:Messages:FormatFailed", ex.Message];
        }
    }

    private void MinifyJson()
    {
        try
        {
            var obj = System.Text.Json.JsonSerializer.Deserialize<object>(editedValue);
            editedValue = System.Text.Json.JsonSerializer.Serialize(obj);
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = L["KeyEditor:Messages:MinifyFailed", ex.Message];
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var request = new StateStoreKeyUpdateRequest
            {
                Key = KeyInfo.Key,
                Value = editedValue,
                ETag = KeyInfo.ETag,
                TTL = ttlSeconds > 0 ? TimeSpan.FromSeconds(ttlSeconds) : null
            };

            var result = await StateStoreService.SaveKeyAsync(ServiceKey, request);

            if (result.IsFailed(out var error))
            {
                errorMessage = error.Message;
            }
            else
            {
                var refreshedKey = await StateStoreService.GetKeyAsync(ServiceKey, KeyInfo.Key);
                if (refreshedKey.IsOk(out var loadedKey))
                {
                    await OnSaved.InvokeAsync(loadedKey);
                }
                else
                {
                    KeyInfo.RawValue = editedValue;
                    await OnSaved.InvokeAsync(KeyInfo);
                }

                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
