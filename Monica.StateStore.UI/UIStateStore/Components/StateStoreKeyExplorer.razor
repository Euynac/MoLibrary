@using Monica.StateStore.Providers
@using Monica.StateStore.UI.Services
@using Monica.StateStore.UI.Models
@using Monica.StateStore.UI.Modules
@using Monica.Tool.MoResponse
@inject StateStoreUIService StateStoreService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<StateStoreResource> L

<MudGrid>
    @* Provider 选择和搜索 *@
    <MudItem xs="12">
        <MudPaper Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="StateStoreProviderInfo"
                               Label="@L["KeyExplorer:Labels:SelectProvider"]"
                               @bind-Value="selectedProvider"
                               @bind-Value:after="OnProviderChanged"
                               Variant="Variant.Outlined">
                        @foreach (var provider in Providers)
                        {
                            <MudSelectItem Value="provider">
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@GetProviderIcon(provider)"
                                             Size="Size.Small" Class="mr-2" />
                                    @provider.DisplayName
                                    <MudChip T="string" Size="Size.Small" Class="ml-2"
                                             Color="@GetProviderColor(provider)">
                                        @provider.ProviderTypeName
                                    </MudChip>
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="searchPattern"
                                  Label="@GetSearchLabel()"
                                  Placeholder="@GetSearchPlaceholder()"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="SearchKeysAsync"
                                  OnKeyDown="OnSearchKeyDown" />
                </MudItem>

                <MudItem xs="12" md="3" Class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="SearchKeysAsync"
                               Disabled="@(selectedProvider == null || isSearching)">
                        @GetSearchButtonText()
                    </MudButton>

                    @if (Options.AllowKeyCreation)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateKeyDialog"
                                   Disabled="@(selectedProvider == null)">
                            @L["KeyExplorer:Actions:Create"]
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>

            @if (selectedProvider != null && !selectedProvider.SupportsKeyScanning)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">
                    <MudText>
                        <strong>@L["KeyExplorer:Messages:NoScanningSupport"]</strong>@L["KeyExplorer:Messages:EnterFullKeyName"]
                    </MudText>
                </MudAlert>
            }
        </MudPaper>
    </MudItem>

    @* Key 表格 *@
    <MudItem xs="12">
        <MudPaper Class="pa-4">
            @if (isSearching)
            {
                <div class="d-flex justify-center pa-4">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (searchError != null)
            {
                <MudAlert Severity="Severity.Error">@searchError</MudAlert>
            }
            else if (keys.Any())
            {
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.subtitle1">
                        @L["KeyExplorer:Messages:FoundKeys", scanResult.TotalCount]
                        @if (scanResult.HasMore)
                        {
                            <span class="ml-1">@L["KeyExplorer:Messages:ShowingFirst", keys.Count]</span>
                        }
                    </MudText>

                    @if (selectedKeys.Any() && Options.AllowKeyDeletion)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="DeleteSelectedKeys">
                            @L["KeyExplorer:Actions:DeleteSelected", selectedKeys.Count]
                        </MudButton>
                    }
                </div>

                <MudTable T="StateStoreKeyInfo"
                          Items="keys"
                          Dense="true"
                          Hover="true"
                          MultiSelection="@Options.AllowKeyDeletion"
                          @bind-SelectedItems="selectedKeys"
                          Loading="isLoadingValues">
                    <HeaderContent>
                        <MudTh>@L["KeyExplorer:Labels:KeyNameColumn"]</MudTh>
                        <MudTh>@L["KeyExplorer:Labels:ValuePreview"]</MudTh>
                        <MudTh Style="width: 150px;">@L["KeyExplorer:Labels:Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Key">
                            <MudText Typo="Typo.body2" Style="font-family: monospace; word-break: break-all;">
                                @context.Key
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="值">
                            <KeyValuePreviewCell KeyInfo="context"
                                                 OnLoadValue="() => LoadKeyValueAsync(context)" />
                        </MudTd>
                        <MudTd DataLabel="操作">
                            <div class="d-flex gap-1">
                                <MudTooltip Text="@L["KeyExplorer:Actions:View"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Size="Size.Small"
                                                   Color="Color.Info"
                                                   OnClick="() => ViewKey(context)" />
                                </MudTooltip>

                                @if (Options.AllowKeyEditing)
                                {
                                    <MudTooltip Text="@L["KeyExplorer:Actions:Edit"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="() => EditKey(context)" />
                                    </MudTooltip>
                                }

                                @if (Options.AllowKeyDeletion)
                                {
                                    <MudTooltip Text="@L["KeyExplorer:Actions:Delete"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => DeleteKey(context)" />
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else if (hasSearched)
            {
                <MudAlert Severity="Severity.Info">@L["KeyExplorer:Messages:NoKeysFound"]</MudAlert>
            }
            else
            {
                <MudText Class="text-center pa-4" Color="Color.Secondary">
                    @L["KeyExplorer:Messages:SelectProviderToStart"]
                </MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public List<StateStoreProviderInfo> Providers { get; set; } = [];
    [Parameter] public ModuleStateStoreUIOption Options { get; set; } = new();

    private StateStoreProviderInfo? selectedProvider;
    private string searchPattern = "*";
    private List<StateStoreKeyInfo> keys = [];
    private HashSet<StateStoreKeyInfo> selectedKeys = [];
    private KeyScanResult scanResult = new();
    private bool isSearching = false;
    private bool isLoadingValues = false;
    private bool hasSearched = false;
    private string? searchError = null;

    protected override void OnParametersSet()
    {
        if (selectedProvider == null && Providers.Any())
        {
            selectedProvider = Providers.First();
        }
    }

    private void OnProviderChanged()
    {
        keys.Clear();
        selectedKeys.Clear();
        searchError = null;
        hasSearched = false;
        searchPattern = selectedProvider?.SupportsKeyScanning == true ? "*" : "";
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchKeysAsync();
        }
    }

    private string GetSearchLabel()
    {
        return selectedProvider?.SupportsKeyScanning == true
            ? L["KeyExplorer:Labels:KeyPattern"]
            : L["KeyExplorer:Labels:KeyName"];
    }

    private string GetSearchPlaceholder()
    {
        return selectedProvider?.SupportsKeyScanning == true
            ? L["KeyExplorer:Placeholders:PatternSearch"]
            : L["KeyExplorer:Placeholders:FullKeyName"];
    }

    private string GetSearchButtonText()
    {
        return selectedProvider?.SupportsKeyScanning == true ? L["KeyExplorer:Actions:Scan"] : L["KeyExplorer:Actions:Query"];
    }

    private async Task SearchKeysAsync()
    {
        if (selectedProvider == null || string.IsNullOrWhiteSpace(searchPattern)) return;

        isSearching = true;
        searchError = null;
        hasSearched = true;
        keys.Clear();
        selectedKeys.Clear();
        StateHasChanged();

        try
        {
            // 对于不支持扫描的 Provider，使用精确查询
            if (!selectedProvider.SupportsKeyScanning)
            {
                var keyResult = await StateStoreService.GetKeyAsync(
                    selectedProvider.ServiceKey,
                    searchPattern);

                if (keyResult.IsOk(out var keyInfo))
                {
                    keys = [keyInfo];
                    scanResult = new KeyScanResult { Keys = [searchPattern], TotalCount = 1 };
                }
            }
            else
            {
                var result = await StateStoreService.ScanKeysAsync(
                    selectedProvider.ServiceKey,
                    searchPattern,
                    Options.MaxKeysPerPage);

                if (result.IsFailed(out var error))
                {
                    searchError = error.Message;
                }
                else
                {
                    scanResult = result.Data!;
                    keys = scanResult.Keys
                        .Select(k => new StateStoreKeyInfo { Key = k })
                        .ToList();
                }
            }
        }
        catch (Exception ex)
        {
            searchError = ex.Message;
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task LoadKeyValueAsync(StateStoreKeyInfo keyInfo)
    {
        if (keyInfo.IsValueLoaded || selectedProvider == null) return;

        var result = await StateStoreService.GetKeyAsync(
            selectedProvider.ServiceKey,
            keyInfo.Key);

        if (result.IsOk(out var loadedKey))
        {
            keyInfo.RawValue = loadedKey.RawValue;
            keyInfo.ETag = loadedKey.ETag;
            keyInfo.IsValueLoaded = true;
            keyInfo.Error = loadedKey.Error;
        }
        else
        {
            keyInfo.Error = result.Message;
            keyInfo.IsValueLoaded = true;
        }

        StateHasChanged();
    }

    private async Task ViewKey(StateStoreKeyInfo keyInfo)
    {
        if (!keyInfo.IsValueLoaded)
        {
            await LoadKeyValueAsync(keyInfo);
        }

        var parameters = new DialogParameters<KeyEditorDialog>
        {
            { x => x.KeyInfo, keyInfo },
            { x => x.ReadOnly, true }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<KeyEditorDialog>(L["KeyExplorer:Dialogs:ViewKeyTitle", keyInfo.Key], parameters, options);
    }

    private async Task EditKey(StateStoreKeyInfo keyInfo)
    {
        if (!keyInfo.IsValueLoaded)
        {
            await LoadKeyValueAsync(keyInfo);
        }

        var parameters = new DialogParameters<KeyEditorDialog>
        {
            { x => x.KeyInfo, keyInfo },
            { x => x.ServiceKey, selectedProvider?.ServiceKey },
            { x => x.ReadOnly, false },
            { x => x.OnSaved, EventCallback.Factory.Create<StateStoreKeyInfo>(this, OnKeySaved) }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<KeyEditorDialog>(L["KeyExplorer:Dialogs:EditKeyTitle", keyInfo.Key], parameters, options);
    }

    private void OnKeySaved(StateStoreKeyInfo updatedKey)
    {
        var existing = keys.FirstOrDefault(k => k.Key == updatedKey.Key);
        if (existing != null)
        {
            existing.RawValue = updatedKey.RawValue;
            existing.ETag = updatedKey.ETag;
        }

        Snackbar.Add(L["KeyExplorer:Messages:KeySaveSuccess"], Severity.Success);
        StateHasChanged();
    }

    private async Task OpenCreateKeyDialog()
    {
        var parameters = new DialogParameters<KeyCreateDialog>
        {
            { x => x.ServiceKey, selectedProvider?.ServiceKey },
            { x => x.OnCreated, EventCallback.Factory.Create<StateStoreKeyInfo>(this, OnKeyCreated) }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<KeyCreateDialog>(L["KeyCreate:Dialogs:Title"], parameters, options);
    }

    private void OnKeyCreated(StateStoreKeyInfo newKey)
    {
        keys.Insert(0, newKey);
        scanResult = scanResult with { TotalCount = scanResult.TotalCount + 1 };
        Snackbar.Add(L["KeyExplorer:Messages:KeyCreateSuccess"], Severity.Success);
        StateHasChanged();
    }

    private async Task DeleteKey(StateStoreKeyInfo keyInfo)
    {
        var confirmed = await DialogService.ShowMessageBox(
            L["KeyExplorer:Dialogs:DeleteKeyTitle"],
            L["KeyExplorer:Dialogs:DeleteKeyMessage", keyInfo.Key],
            L["KeyExplorer:Dialogs:DeleteKeyConfirm"],
            L["KeyExplorer:Dialogs:DeleteKeyCancel"]);

        if (confirmed == true && selectedProvider != null)
        {
            var result = await StateStoreService.DeleteKeyAsync(
                selectedProvider.ServiceKey,
                keyInfo.Key,
                keyInfo.ETag);

            if (result.IsFailed(out var error))
            {
                Snackbar.Add(L["KeyExplorer:Messages:KeyDeleteFailed", error.Message], Severity.Error);
            }
            else
            {
                keys.Remove(keyInfo);
                scanResult = scanResult with { TotalCount = scanResult.TotalCount - 1 };
                Snackbar.Add(L["KeyExplorer:Messages:KeyDeleteSuccess"], Severity.Success);
                StateHasChanged();
            }
        }
    }

    private async Task DeleteSelectedKeys()
    {
        if (!selectedKeys.Any() || selectedProvider == null) return;

        var confirmed = await DialogService.ShowMessageBox(
            L["KeyExplorer:Dialogs:BatchDeleteTitle"],
            L["KeyExplorer:Dialogs:BatchDeleteMessage", selectedKeys.Count],
            L["KeyExplorer:Dialogs:BatchDeleteConfirm"],
            L["KeyExplorer:Dialogs:DeleteKeyCancel"]);

        if (confirmed == true)
        {
            var result = await StateStoreService.DeleteKeysAsync(
                selectedProvider.ServiceKey,
                selectedKeys.Select(k => k.Key).ToList());

            if (result.IsFailed(out var error))
            {
                Snackbar.Add(L["KeyExplorer:Messages:BatchDeleteFailed", error.Message], Severity.Error);
            }
            else
            {
                foreach (var key in selectedKeys.ToList())
                {
                    keys.Remove(key);
                }
                scanResult = scanResult with { TotalCount = scanResult.TotalCount - selectedKeys.Count };
                selectedKeys.Clear();
                Snackbar.Add(result.Message ?? L["KeyExplorer:Messages:DeleteSuccess"], Severity.Success);
                StateHasChanged();
            }
        }
    }

    private static string GetProviderIcon(StateStoreProviderInfo provider) => provider.ProviderType switch
    {
        EStateStoreProviderType.Redis => Icons.Material.Filled.Storage,
        EStateStoreProviderType.Dapr => Icons.Material.Filled.Cloud,
        EStateStoreProviderType.Memory => Icons.Material.Filled.Memory,
        _ => Icons.Material.Filled.Help
    };

    private static Color GetProviderColor(StateStoreProviderInfo provider) => provider.ProviderType switch
    {
        EStateStoreProviderType.Redis => Color.Error,
        EStateStoreProviderType.Dapr => Color.Info,
        EStateStoreProviderType.Memory => Color.Success,
        _ => Color.Default
    };
}
