@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Options
@using Monica.Modules
@using Monica.StateStore.UI.Models
@using Monica.StateStore.UI.Services
@using Monica.StateStore.UI.UIStateStore.Components
@using Monica.Core.Results;
@inject StateStoreUIService StateStoreService
@inject IOptions<ModuleStateStoreUIOption> Options
@inject ISnackbar Snackbar
@inject IStringLocalizer<StateStoreResource> L
@implements IDisposable

<PageTitle>@L["Dashboard:PageTitle"]</PageTitle>

<div class="state-store-dashboard-page">
    <MudPaper Class="dashboard-banner" Elevation="0">
        <div class="dashboard-banner__identity">
            <span class="dashboard-banner__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Storage" /></span>
            <div class="dashboard-banner__copy">
                <MudText Typo="Typo.overline" Class="dashboard-eyebrow">@L["Dashboard:Eyebrow"]</MudText>
                <MudText Typo="Typo.h4">@L["Dashboard:Title"]</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Dashboard:Subtitle"]</MudText>
            </div>
        </div>

        <div class="dashboard-banner__metrics">
            <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Storage">
                @L["Dashboard:Summary:RegisteredProviders", providers.Count]
            </MudChip>

            @if (PatternProviderCount > 0)
            {
                <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Search">
                    @L["Dashboard:Summary:PatternProviders", PatternProviderCount]
                </MudChip>
            }

            @if (ExactOnlyProviderCount > 0)
            {
                <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Key">
                    @L["Dashboard:Summary:ExactOnlyProviders", ExactOnlyProviderCount]
                </MudChip>
            }

            @if (DefaultProvider is not null)
            {
                <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Star">
                    @L["Dashboard:Summary:DefaultProvider", L.GetProviderDisplayName(DefaultProvider)]
                </MudChip>
            }
        </div>
    </MudPaper>

    <div class="dashboard-content">
        @if (isLoading)
        {
            <MudPaper Class="dashboard-state" Elevation="0">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.h6">@L["Dashboard:Messages:LoadingProviders"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard:Messages:LoadingProvidersDescription"]</MudText>
            </MudPaper>
        }
        else if (!providers.Any())
        {
            <MudPaper Class="dashboard-state" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">@L["Dashboard:Messages:NoProviders"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard:Messages:NoProvidersDescription"]</MudText>
            </MudPaper>
        }
        else
        {
            <StateStoreKeyExplorer Providers="providers"
                                   Options="Options.Value"
                                   OnRefreshProviders="LoadProvidersAsync" />
        }
    </div>
</div>

@code {
    public const string PAGE_URL = "/state-store-dashboard";

    private List<StateStoreProviderInfo> providers = [];
    private bool isLoading;
    private bool isDisposed;

    private StateStoreProviderInfo? DefaultProvider => providers.FirstOrDefault(provider => provider.IsDefaultStateStore);

    private int ExactOnlyProviderCount => providers.Count(provider => provider.SupportsExactLookup && !provider.SupportsKeyScanning);

    private int PatternProviderCount => providers.Count(provider => provider.SupportsKeyScanning);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isDisposed)
        {
            await LoadProvidersAsync();
        }
    }

    private async Task LoadProvidersAsync()
    {
        if (isDisposed)
        {
            return;
        }

        isLoading = true;
        StateHasChanged();

        await Task.Yield();

        if (isDisposed)
        {
            return;
        }

        if (StateStoreService.GetRegisteredProviders().IsFailed(out var error, out var data))
        {
            Snackbar.Add(L["Dashboard:Messages:LoadProviderFailed", error], Severity.Error);
        }
        else
        {
            providers = data;
        }

        isLoading = false;
        if (!isDisposed)
        {
            StateHasChanged();
        }
    }

    public void Dispose() => isDisposed = true;
}
