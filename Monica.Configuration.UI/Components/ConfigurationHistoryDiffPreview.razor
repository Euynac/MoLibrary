@using Monica.Configuration.UI.Localization
@using Monica.UI.UIDiffHighlight.Models
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L

<div class="configuration-history-diff-preview">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (Rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L["History:Dialog:NoPreview"]</MudAlert>
    }
    else
    {
        <MudStack Spacing="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @(IsRollbackPreview ? L["History:Dialog:RollbackDirection"] : L["History:Dialog:DiffDirection"])
            </MudText>
            <DiffViewer OriginText="@_originText"
                        NewText="@_targetText"
                        Options="@_diffOptions"
                        ViewMode="@ViewMode" />
        </MudStack>
    }
</div>

@code {
    private readonly DiffHighlightOptions _diffOptions = new()
    {
        Mode = EDiffHighlightMode.Line,
        ContextLines = 4,
        MaxCharacterDiffLength = 5000
    };

    private readonly Dictionary<string, ConfigurationDefinition> _definitions = new(StringComparer.OrdinalIgnoreCase);
    private string _originText = "null";
    private string _targetText = "null";
    private string? _inputIdentity;
    private bool _loading;

    [Parameter] public IReadOnlyList<ConfigurationValueHistory> Rows { get; set; } = [];
    [Parameter] public bool IsRollbackPreview { get; set; }
    [Parameter] public EDiffViewMode ViewMode { get; set; } = EDiffViewMode.Unified;
    [Parameter] public IReadOnlyDictionary<string, ConfigurationStoredValue?> CurrentValuesByHistoryId { get; set; } =
        new Dictionary<string, ConfigurationStoredValue?>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public string? PreviewIdentity { get; set; }
    [Parameter] public EventCallback<bool> LoadingChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var inputIdentity = $"{IsRollbackPreview}:{PreviewIdentity}:{string.Join('\u001f', Rows.Select(static row => row.HistoryId))}";
        if (string.Equals(_inputIdentity, inputIdentity, StringComparison.Ordinal))
        {
            return;
        }

        // Set this before notifying the parent so its rerender cannot restart the same asynchronous load.
        _inputIdentity = inputIdentity;
        _loading = true;
        await LoadingChanged.InvokeAsync(true);
        try
        {
            await EnsureDefinitionsAsync();
            _originText = ConfigurationHistoryDiffSnapshotBuilder.BuildOriginSnapshot(
                Rows,
                IsRollbackPreview,
                CurrentValuesByHistoryId,
                IsSensitive,
                DefinitionDisplay,
                TargetDisplay,
                L["State:Value:Sensitive"]);
            _targetText = ConfigurationHistoryDiffSnapshotBuilder.BuildTargetSnapshot(
                Rows,
                IsRollbackPreview,
                IsSensitive,
                DefinitionDisplay,
                TargetDisplay,
                L["State:Value:Sensitive"]);
        }
        finally
        {
            _loading = false;
            await LoadingChanged.InvokeAsync(false);
        }
    }

    private async Task EnsureDefinitionsAsync()
    {
        foreach (var definitionKey in Rows.Select(row => row.DefinitionKey).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            if (_definitions.ContainsKey(definitionKey))
            {
                continue;
            }

            var result = await Facade.GetDefinitionAsync(definitionKey);
            if (!result.IsFailed(out _, out var detail))
            {
                _definitions[definitionKey] = detail.Definition;
            }
        }
    }

    private bool IsSensitive(ConfigurationValueHistory row)
    {
        // Legacy rows and schema drift cannot prove the historical sensitivity contract, so hide their values.
        if (!_definitions.TryGetValue(row.DefinitionKey, out var definition)
            || definition.SchemaVersion != row.SchemaVersion
            || string.IsNullOrWhiteSpace(row.SchemaHash)
            || !string.Equals(definition.SchemaHash, row.SchemaHash, StringComparison.Ordinal))
        {
            return true;
        }

        var targetNode = ResolveTargetNode(definition, row.LogicalPath);
        return targetNode is null || ContainsSensitiveNode(targetNode);
    }

    private string DefinitionDisplay(string definitionKey)
    {
        return _definitions.TryGetValue(definitionKey, out var definition)
            ? definition.DisplayName
            : definitionKey;
    }

    private string TargetDisplay(ConfigurationValueHistory row)
    {
        if (row.TargetKind == ConfigurationMutationTargetKind.MonicaEffectiveStore)
        {
            return L["History:Targets:Monica"];
        }

        var sourceName = row.SourceDisplayName ?? L["History:Targets:External"];
        return string.IsNullOrWhiteSpace(row.SourcePhysicalPath)
            ? sourceName
            : $"{sourceName} [{row.SourcePhysicalPath}]";
    }

    private static ConfigurationNodeDefinition? ResolveTargetNode(ConfigurationDefinition definition, LogicalPath logicalPath)
    {
        var current = definition.Root;
        foreach (var segment in logicalPath.Segments)
        {
            current = segment switch
            {
                PropertySegment property => current.Children.FirstOrDefault(child =>
                    string.Equals(child.Name, property.Name, StringComparison.OrdinalIgnoreCase)),
                DictionaryKeySegment => current.DictionaryTemplate?.ValueTemplate,
                ListItemKeySegment or ListIndexSegment => current.ListTemplate?.ItemTemplate,
                _ => null
            };

            if (current is null)
            {
                return null;
            }
        }

        return current;
    }

    private static bool ContainsSensitiveNode(ConfigurationNodeDefinition node)
    {
        if (node.IsSensitive || node.Children.Any(ContainsSensitiveNode))
        {
            return true;
        }

        return node.DictionaryTemplate?.ValueTemplate is { } dictionaryValue
                   && ContainsSensitiveNode(dictionaryValue)
               || node.ListTemplate?.ItemTemplate is { } listItem
                   && ContainsSensitiveNode(listItem);
    }
}
