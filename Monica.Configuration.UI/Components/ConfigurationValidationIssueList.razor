@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

@if (Issues.Count > 0)
{
    <MudStack Spacing="1" Class="configuration-validation-issue-list">
        @foreach (var issue in OrderedIssues)
        {
            <MudPaper Outlined="true" Class="pa-3 configuration-validation-issue-card">
                <MudStack Spacing="2">
                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">@Title(issue)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@issue.LogicalPath.ToCanonicalString()</MudText>
                            @if (ShowRuntimeMetadata && !string.IsNullOrWhiteSpace(issue.ConfigurationPath))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["State:RuntimeValidation:ConfigurationPath"]: @issue.ConfigurationPath
                                </MudText>
                            }
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTooltip Text="@RuleTip(issue)" Placement="Placement.Left">
                                <MudIconButton Icon="@Icons.Material.Filled.Info"
                                               Size="Size.Small"
                                               Color="Color.Info" />
                            </MudTooltip>
                            @if (ShowSourceChain && !string.IsNullOrWhiteSpace(issue.ConfigurationPath))
                            {
                                <MudTooltip Text="@L["State:RuntimeValidation:Actions:SourceChain"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   Variant="Variant.Outlined"
                                                   OnClick="() => SourceChainRequested.InvokeAsync(issue)" />
                                </MudTooltip>
                            }
                            @if (ShowJump)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.NearMe"
                                           OnClick="() => JumpRequested.InvokeAsync(issue)">
                                    @L["Common:Actions:Jump"]
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="@(ShowRuntimeMetadata ? 4 : 5)">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@ValueLabelText</MudText>
                            <MudText Typo="Typo.body2" Class="configuration-validation-issue-value">@DisplayInvalidValue(issue)</MudText>
                        </MudItem>
                        <MudItem xs="12" md="@(ShowRuntimeMetadata ? 4 : 7)">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@ReasonLabelText</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Error">@issue.ValidationError</MudText>
                        </MudItem>
                        @if (ShowRuntimeMetadata)
                        {
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["State:RuntimeValidation:EffectiveSource"]</MudText>
                                <MudText Typo="Typo.body2">@DisplayEffectiveSource(issue)</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

@code {
    [Parameter] public IReadOnlyList<ConfigurationValidationIssue> Issues { get; set; } = [];
    [Parameter] public bool ShowDefinition { get; set; } = true;
    [Parameter] public bool ShowJump { get; set; } = true;
    [Parameter] public bool ShowRuntimeMetadata { get; set; }
    [Parameter] public bool ShowSourceChain { get; set; }
    [Parameter] public string? ValueLabel { get; set; }
    [Parameter] public string? ReasonLabel { get; set; }
    [Parameter] public EventCallback<ConfigurationValidationIssue> JumpRequested { get; set; }
    [Parameter] public EventCallback<ConfigurationValidationIssue> SourceChainRequested { get; set; }

    private string ValueLabelText => ValueLabel ?? L["Dialogs:SaveGroup:Validation:InvalidValue"].Value;

    private string ReasonLabelText => ReasonLabel ?? L["Dialogs:SaveGroup:Validation:Reason"].Value;

    private IEnumerable<ConfigurationValidationIssue> OrderedIssues =>
        Issues
            .OrderBy(issue => issue.DefinitionDisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(issue => issue.LogicalPath.ToCanonicalString(), StringComparer.OrdinalIgnoreCase);

    private string Title(ConfigurationValidationIssue issue)
    {
        return ShowDefinition
            ? $"{issue.DefinitionDisplayName} · {issue.NodeDisplayName}"
            : issue.NodeDisplayName;
    }

    private string DisplayInvalidValue(ConfigurationValidationIssue issue)
    {
        if (issue.IsMissing)
        {
            return L["State:RuntimeValidation:MissingValue"].Value;
        }

        if (issue.IsSensitive)
        {
            return L["State:Value:Sensitive"].Value;
        }

        return string.IsNullOrWhiteSpace(issue.InvalidDisplayValue)
            ? L["Value:States:Empty"].Value
            : issue.InvalidDisplayValue;
    }

    private string DisplayEffectiveSource(ConfigurationValidationIssue issue)
    {
        return issue.EffectiveSource is null
            ? L["State:RuntimeValidation:NoEffectiveSource"].Value
            : issue.EffectiveSource.DisplayName;
    }

    private string RuleTip(ConfigurationValidationIssue issue)
    {
        if (issue.ValidationRules.Count == 0)
        {
            return L["Dialogs:SaveGroup:Validation:NoRuleTip"].Value;
        }

        return string.Join(
            Environment.NewLine,
            issue.ValidationRules.Select(rule => ConfigurationValidationRuleFormatter.Format(rule, L)));
    }
}
