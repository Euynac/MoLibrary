@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<div class="configuration-definition-list-shell">
    <MudPaper Outlined="true" Class="pa-3 configuration-definition-list">
        <div class="configuration-definition-list-content">
            <MudTextField T="string"
                          Value="@SearchText"
                          ValueChanged="OnSearchChanged"
                          Placeholder="@L["State:SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />

            <div class="configuration-definition-list-scroll">
                @if (Definitions.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@L["State:Definitions:Empty"]</MudAlert>
                }
                else if (!FilteredDefinitions.Any())
                {
                    <MudAlert Severity="Severity.Info">@L["State:Definitions:NoMatches"]</MudAlert>
                }
                else
                {
                    <MudList T="ConfigurationDefinitionSummary" Dense="true">
                        @foreach (var group in FilteredDefinitions.GroupBy(x => string.IsNullOrWhiteSpace(x.OwnerModule) ? L["State:Definitions:Ungrouped"].Value : x.OwnerModule!)
                                     .OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
                        {
                            <MudListSubheader>@group.Key</MudListSubheader>
                            @foreach (var definition in group.OrderBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                var matches = GetNodeMatches(definition);
                                <MudListItem T="ConfigurationDefinitionSummary"
                                             Value="@definition"
                                             Icon="@Icons.Material.Filled.Settings"
                                             Class="@(IsSelected(definition) ? "selected-definition" : null)"
                                             OnClick="() => SelectedDefinitionChanged.InvokeAsync(definition)">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">
                                            <MudHighlighter Text="@definition.DisplayName" HighlightedTexts="@SearchTerms" />
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            <MudHighlighter Text="@GetOptionsTypeName(definition)" HighlightedTexts="@SearchTerms" />
                                        </MudText>
                                        @if (matches.Count > 0)
                                        {
                                            <div class="configuration-node-match-list">
                                                @foreach (var match in matches.Take(MAX_VISIBLE_NODE_MATCHES))
                                                {
                                                    <div @onclick:stopPropagation="true">
                                                        <MudButton Variant="Variant.Text"
                                                                   Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                                                   Class="configuration-node-match-button"
                                                                   OnClick="@(() => NodeSearchMatchSelected.InvokeAsync(match))">
                                                            <MudStack Spacing="0" AlignItems="AlignItems.Start" Class="configuration-node-match-text">
                                                                <MudText Typo="Typo.caption">
                                                                    <MudHighlighter Text="@match.DisplayName" HighlightedTexts="@SearchTerms" />
                                                                </MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@match.PathLabel</MudText>
                                                            </MudStack>
                                                        </MudButton>
                                                    </div>
                                                }
                                                @if (matches.Count > MAX_VISIBLE_NODE_MATCHES)
                                                {
                                                    <MudChip T="int" Size="Size.Small" Variant="Variant.Outlined">
                                                        +@(matches.Count - MAX_VISIBLE_NODE_MATCHES)
                                                    </MudChip>
                                                }
                                            </div>
                                        }
                                    </MudStack>
                                </MudListItem>
                            }
                        }
                    </MudList>
                }
            </div>

            <div class="configuration-definition-list-footer">
                <MudDivider />

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                    <MudChip T="int" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                        @PendingCount
                    </MudChip>
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="@L["State:Actions:UndoAll"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                           Disabled="@(PendingCount == 0)"
                                           OnClick="UndoAll" />
                        </MudTooltip>
                        <MudTooltip Text="@L["State:Actions:SaveGroup"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Save"
                                           Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           Disabled="@(PendingCount == 0)"
                                           OnClick="SaveGroup" />
                        </MudTooltip>
                    </MudStack>
                </MudStack>
            </div>
        </div>
    </MudPaper>
</div>

@code {
    private const int MAX_VISIBLE_NODE_MATCHES = 4;

    [Parameter] public IReadOnlyList<ConfigurationDefinitionSummary> Definitions { get; set; } = [];
    [Parameter] public ConfigurationDefinitionSummary? SelectedDefinition { get; set; }
    [Parameter] public EventCallback<ConfigurationDefinitionSummary> SelectedDefinitionChanged { get; set; }
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<ConfigurationNodeSearchMatch>> NodeSearchMatches { get; set; } =
        new Dictionary<string, IReadOnlyList<ConfigurationNodeSearchMatch>>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public EventCallback<ConfigurationNodeSearchMatch> NodeSearchMatchSelected { get; set; }
    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }
    [Parameter] public int PendingCount { get; set; }
    [Parameter] public EventCallback SaveGroup { get; set; }
    [Parameter] public EventCallback UndoAll { get; set; }

    private IEnumerable<ConfigurationDefinitionSummary> FilteredDefinitions =>
        string.IsNullOrWhiteSpace(SearchText)
            ? Definitions
            : Definitions.Where(definition =>
                IsDefinitionMatch(definition)
                || GetNodeMatches(definition).Count > 0);

    private IReadOnlyList<string> SearchTerms => string.IsNullOrWhiteSpace(SearchText)
        ? []
        : SearchText
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private bool IsSelected(ConfigurationDefinitionSummary definition)
    {
        return string.Equals(definition.DefinitionKey, SelectedDefinition?.DefinitionKey, StringComparison.OrdinalIgnoreCase);
    }

    private Task OnSearchChanged(string value)
    {
        SearchText = value;
        return SearchTextChanged.InvokeAsync(value);
    }

    private bool IsDefinitionMatch(ConfigurationDefinitionSummary definition)
    {
        return SearchTerms.Count == 0
               || ContainsAny(definition.DefinitionKey)
               || ContainsAny(definition.DisplayName)
               || ContainsAny(definition.ClrTypeName)
               || ContainsAny(definition.SectionPath)
               || ContainsAny(definition.OwnerModule);
    }

    private bool ContainsAny(string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
               && SearchTerms.Any(term => value.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private IReadOnlyList<ConfigurationNodeSearchMatch> GetNodeMatches(ConfigurationDefinitionSummary definition)
    {
        return NodeSearchMatches.TryGetValue(definition.DefinitionKey, out var matches) ? matches : [];
    }

    private static string GetOptionsTypeName(ConfigurationDefinitionSummary definition)
    {
        var typeName = definition.ClrTypeName.Split(',', 2)[0];
        var lastSeparator = Math.Max(typeName.LastIndexOf('.'), typeName.LastIndexOf('+'));
        return lastSeparator >= 0 ? typeName[(lastSeparator + 1)..] : typeName;
    }
}
