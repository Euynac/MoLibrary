@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<div class="configuration-definition-list-shell">
    <MudPaper Outlined="true" Class="pa-3 configuration-definition-list">
        <div class="configuration-definition-list-content">
            <MudTextField T="string"
                          Value="@SearchText"
                          ValueChanged="OnSearchChanged"
                          Placeholder="@L["State:SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />

            <div class="configuration-definition-list-scroll">
                @if (Definitions.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@L["State:Definitions:Empty"]</MudAlert>
                }
                else if (!FilteredDefinitions.Any())
                {
                    <MudAlert Severity="Severity.Info">@L["State:Definitions:NoMatches"]</MudAlert>
                }
                else
                {
                    <MudList T="ConfigurationDefinitionSummary" Dense="true">
                        @foreach (var group in FilteredDefinitions.GroupBy(x => string.IsNullOrWhiteSpace(x.OwnerModule) ? L["State:Definitions:Ungrouped"].Value : x.OwnerModule!)
                                     .OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
                        {
                            <MudListSubheader>@group.Key</MudListSubheader>
                            @foreach (var definition in group.OrderBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                <MudListItem T="ConfigurationDefinitionSummary"
                                             Value="@definition"
                                             Icon="@Icons.Material.Filled.Settings"
                                             Class="@(IsSelected(definition) ? "selected-definition" : null)"
                                             OnClick="() => SelectedDefinitionChanged.InvokeAsync(definition)">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">@definition.DisplayName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@definition.DefinitionKey</MudText>
                                    </MudStack>
                                </MudListItem>
                            }
                        }
                    </MudList>
                }
            </div>

            <div class="configuration-definition-list-footer">
                <MudDivider />

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                    <MudChip T="int" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                        @PendingCount
                    </MudChip>
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="@L["State:Actions:UndoAll"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                           Disabled="@(PendingCount == 0)"
                                           OnClick="UndoAll" />
                        </MudTooltip>
                        <MudTooltip Text="@L["State:Actions:SaveGroup"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Save"
                                           Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           Disabled="@(PendingCount == 0)"
                                           OnClick="SaveGroup" />
                        </MudTooltip>
                    </MudStack>
                </MudStack>
            </div>
        </div>
    </MudPaper>
</div>

@code {
    [Parameter] public IReadOnlyList<ConfigurationDefinitionSummary> Definitions { get; set; } = [];
    [Parameter] public ConfigurationDefinitionSummary? SelectedDefinition { get; set; }
    [Parameter] public EventCallback<ConfigurationDefinitionSummary> SelectedDefinitionChanged { get; set; }
    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }
    [Parameter] public int PendingCount { get; set; }
    [Parameter] public EventCallback SaveGroup { get; set; }
    [Parameter] public EventCallback UndoAll { get; set; }

    private IEnumerable<ConfigurationDefinitionSummary> FilteredDefinitions =>
        string.IsNullOrWhiteSpace(SearchText)
            ? Definitions
            : Definitions.Where(definition =>
                definition.DefinitionKey.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                || definition.DisplayName.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                || definition.SectionPath.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                || (definition.OwnerModule?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    private bool IsSelected(ConfigurationDefinitionSummary definition)
    {
        return string.Equals(definition.DefinitionKey, SelectedDefinition?.DefinitionKey, StringComparison.OrdinalIgnoreCase);
    }

    private Task OnSearchChanged(string value)
    {
        SearchText = value;
        return SearchTextChanged.InvokeAsync(value);
    }
}
