@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<MudPaper Outlined="true" Class="pa-3">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            <MudText Typo="Typo.subtitle2">@StageText</MudText>
            @if (Progress.Percent is { } percent)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["ImportExport:Progress:Percent", Math.Round(percent)]
                </MudText>
            }
        </MudStack>

        @if (Progress.Percent is { } value)
        {
            <MudProgressLinear Value="@value" Min="0" Max="100" Color="Color.Primary" />
        }
        else
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                @L[DefinitionMetricsKey,
                    Progress.LoadedDefinitionCount,
                    Progress.TotalDefinitionCount,
                    Progress.ProcessedDefinitionCount,
                    Progress.TotalProcessDefinitionCount]
            </MudChip>
            @if (Progress.Operation == ConfigurationPackageProgressOperation.Export)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                    @L["ImportExport:Export:ProgressRedacted", Progress.RedactedPathCount]
                </MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @L["ImportExport:Report:Changes", Progress.ChangeCount]
                </MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                    @L["ImportExport:Report:Issues", Progress.ValidationIssueCount]
                </MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                    @L["ImportExport:Report:Diagnostics", Progress.DiagnosticCount]
                </MudChip>
            }
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(Progress.CurrentDefinitionDisplayName))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @L["ImportExport:Progress:CurrentDefinition",
                    Progress.CurrentDefinitionDisplayName,
                    Progress.CurrentDefinitionKey ?? L["Common:States:Empty"]]
            </MudText>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ConfigurationPackageProgress Progress { get; set; } = null!;

    private string DefinitionMetricsKey => Progress.Operation == ConfigurationPackageProgressOperation.Export
        ? "ImportExport:Export:ProgressDefinitions"
        : "ImportExport:Import:ProgressDefinitions";

    private string StageText => Progress.Stage switch
    {
        ConfigurationPackageProgressStage.LoadingDefinitions => L["ImportExport:Progress:LoadingDefinitions"],
        ConfigurationPackageProgressStage.AnalyzingDefinitions => L["ImportExport:Import:ProgressAnalyzingDefinitions"],
        ConfigurationPackageProgressStage.ExportingDefinitions => L["ImportExport:Export:ProgressExportingDefinitions"],
        _ => L["ImportExport:Import:ProgressReadingPackage"]
    };
}
