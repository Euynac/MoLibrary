@using Monica.Configuration.Providers
@using System.Text.Json
@using Monica.Configuration.Providers.JsonFile

@using Monica.Configuration.Models

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">对象编辑器 - @SubStructure?.Title</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (SubStructure?.Items != null)
        {
            @foreach (var item in SubStructure.Items)
            {
                <div class="mb-3">
                    <ConfigurationBasicTypeEditor Type="@item.Type"
                                                  Value="@GetValue(item.Name)"
                                                  OriginalValue="@GetOriginalValue(item.Name)"
                                                  ValueChanged="@((object? v) => SetValue(item.Name, v))"
                                                  Label="@item.Title"
                                                  HelperText="@item.Desc"
                                                  RegexPattern="@item.RegexPattern"
                                                  IsNullable="@item.IsNullable" />
                </div>
            }
        }
        else
        {
            <MudText Typo="Typo.caption" Class="text-muted">无子结构定义</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public ConfigurationSnapshot? SubStructure { get; set; }
    [Parameter] public object? Value { get; set; }
    [Parameter] public object? OriginalValue { get; set; }
    [Parameter] public EventCallback<object?> ValueChanged { get; set; }

    private Dictionary<string, object> currentValue = [];

    protected override void OnParametersSet()
    {
        // Parse the actual object value from the passed Value parameter
        if (Value is JsonElement element && element.ValueKind == JsonValueKind.Object)
        {
            currentValue = element.EnumerateObject().ToDictionary(x => x.Name, x => (object)x.Value);
        }
        else if (Value is JsonElement { ValueKind: JsonValueKind.Null } || Value is null)
        {
            // If Value is null, an empty dictionary is created, and the default value will be filled in later based on the structure of SubStructure.
            currentValue = [];
        }
        else
        {
            // In other cases, an empty dictionary is also created
            currentValue = [];
        }
    }

    private object? GetValue(string propertyName)
    {
        // Get the value of the specified attribute from the actual value parsed (using the attribute name of the JSON object)
        return currentValue.GetValueOrDefault(propertyName);

        // If the attribute does not exist in the current value, return null (BasicTypeEditor will handle the default value)
    }

    private async Task SetValue(string propertyName, object? value)
    {
        // Update the specified property value of the object (using the property name of the JSON object)
        if (value == null)
        {
            // If the value is null, check whether the corresponding SubStructure item allows null
            var structureItem = SubStructure?.Items?.FirstOrDefault(x => x.Name == propertyName);
            if (structureItem?.IsNullable == true)
            {
                currentValue[propertyName] = null!;
            }
            else
            {
                // If null is not allowed, remove this attribute
                if (currentValue.ContainsKey(propertyName))
                {
                    currentValue.Remove(propertyName);
                }
            }
        }
        else
        {
            currentValue[propertyName] = value;
        }
        
        // Convert updated Dictionary to JsonElement and notify parent component
        var result = JsonFileConventions.ToJsonElement(currentValue);
        await ValueChanged.InvokeAsync(result);
    }
    
    private object? GetOriginalValue(string propertyName)
    {
        if (OriginalValue is JsonElement element && element.ValueKind == JsonValueKind.Object)
        {
            if (element.TryGetProperty(propertyName, out var property))
            {
                return property;
            }
        }
        return null;
    }

}