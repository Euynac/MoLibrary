@using Monica.Configuration.UI.Localization
@using System.Text.Json.Nodes
@using Monica.UI.UIDiffHighlight.Models
@inject IStringLocalizer<ConfigurationUIResource> L

@if (Changes.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">@L["Dialogs:ComplexEditor:NoPatch"]</MudAlert>
}
else
{
    <div class="configuration-patch-diff">
        <DiffViewer OriginText="@BuildSnapshot(useOriginal: true)"
                    NewText="@BuildSnapshot(useOriginal: false)"
                    Options="@DiffOptions"
                    ViewMode="@(Expanded ? EDiffViewMode.Split : EDiffViewMode.Unified)" />
        <div class="configuration-patch-paths">
            @foreach (var change in OrderedChanges)
        {
                <MudChip T="string" Size="Size.Small" Color="@PatchColor(change.MutationKind)" Variant="Variant.Outlined">
                    @change.MutationKind&nbsp;@change.LogicalPath.ToCanonicalString()
                </MudChip>
        }
        </div>
    </div>
}

@code {
    private readonly DiffHighlightOptions DiffOptions = new()
    {
        Mode = EDiffHighlightMode.Line,
        ContextLines = 4,
        MaxCharacterDiffLength = 5000
    };

    [Parameter] public IReadOnlyList<PendingChange> Changes { get; set; } = [];
    [Parameter] public bool Expanded { get; set; }

    private IEnumerable<PendingChange> OrderedChanges =>
        Changes.OrderBy(change => change.LogicalPath.ToCanonicalString(), StringComparer.Ordinal);

    private string BuildSnapshot(bool useOriginal)
    {
        var snapshot = new JsonObject();
        foreach (var change in OrderedChanges)
        {
            snapshot[change.LogicalPath.ToCanonicalString()] = BuildSnapshotValue(change, useOriginal);
        }

        return snapshot.ToJsonString(ConfigurationJsonDisplayFormatter.ReadableJsonOptions);
    }

    private JsonNode? BuildSnapshotValue(PendingChange change, bool useOriginal)
    {
        if (change.IsSensitive)
        {
            return JsonValue.Create(L["State:Value:Sensitive"].Value);
        }

        var value = useOriginal ? change.OriginalValue : change.NewValue;
        return string.IsNullOrWhiteSpace(value?.Json)
            ? null
            : JsonNode.Parse(value.Json);
    }

    private static Color PatchColor(ConfigurationMutationKind kind)
    {
        return kind switch
        {
            ConfigurationMutationKind.Remove => Color.Error,
            _ => Color.Info
        };
    }
}
