@using System.Text.Json.Nodes
@using Monica.Configuration.Services.Support
@using Monica.Configuration.UI.Localization
@using Monica.UI.UIDiffHighlight.Models
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_groups.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["Dialogs:ComplexEditor:NoPatch"]</MudAlert>
}
else
{
    <div class="configuration-definition-diff-preview">
        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            @foreach (var group in _groups)
            {
                <MudExpansionPanel Text="@group.DisplayName" Expanded="@(_groups.Count == 1)">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@group.DefinitionKey</MudChip>
                            @if (group.ChangeCount > 0)
                            {
                                <MudChip T="int" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                    @L["Dialogs:SaveGroup:ChangeCount", group.ChangeCount]
                                </MudChip>
                            }
                            @if (group.ValidationIssues.Count > 0)
                            {
                                <MudChip T="int" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                    @L["Dialogs:SaveGroup:Validation:IssueCount", group.ValidationIssues.Count]
                                </MudChip>
                            }
                        </MudStack>
                        <ConfigurationValidationIssueList Issues="@group.ValidationIssues"
                                                          ShowDefinition="false"
                                                          JumpRequested="JumpRequested" />
                        @if (group.ChangeCount > 0)
                        {
                            <DiffViewer OriginText="@group.OriginJson"
                                        NewText="@group.TargetJson"
                                        Options="@DiffOptions"
                                        ViewMode="EDiffViewMode.Split" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">@L["Dialogs:SaveGroup:Validation:NoSaveableChanges"]</MudAlert>
                        }
                    </MudStack>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </div>
}

@code {
    private readonly ConfigurationEffectiveValuePatchEngine _patchEngine = new();
    private readonly DiffHighlightOptions DiffOptions = new()
    {
        Mode = EDiffHighlightMode.Line,
        ContextLines = 4,
        MaxCharacterDiffLength = 8000
    };

    private IReadOnlyList<DefinitionDiffGroup> _groups = [];
    private bool _loading;
    private string? _error;

    [Parameter] public IReadOnlyList<PendingChange> Changes { get; set; } = [];
    [Parameter] public IReadOnlyList<ConfigurationValidationIssue> ValidationIssues { get; set; } = [];
    [Parameter] public EventCallback<ConfigurationValidationIssue> JumpRequested { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _groups = await BuildGroupsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _groups = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<IReadOnlyList<DefinitionDiffGroup>> BuildGroupsAsync()
    {
        var groups = new List<DefinitionDiffGroup>();
        var definitionKeys = Changes.Select(change => change.DefinitionKey)
            .Concat(ValidationIssues.Select(issue => issue.DefinitionKey))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(DisplayNameForDefinition, StringComparer.OrdinalIgnoreCase)
            .ToArray();

        foreach (var definitionKey in definitionKeys)
        {
            var changes = Changes
                .Where(change => string.Equals(change.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))
                .ToArray();
            var issues = ValidationIssues
                .Where(issue => string.Equals(issue.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))
                .ToArray();
            var originJson = "{}";
            var targetJson = "{}";
            if (changes.Length > 0)
            {
                var definition = await LoadDefinitionAsync(definitionKey);
                originJson = await LoadOriginJsonAsync(definitionKey);
                targetJson = ApplyChanges(definition, originJson, changes);
                originJson = FormatForDisplay(originJson, definition);
                targetJson = FormatForDisplay(targetJson, definition);
            }

            groups.Add(new DefinitionDiffGroup(
                definitionKey,
                DisplayNameForDefinition(definitionKey),
                changes.Length,
                issues,
                originJson,
                targetJson));
        }

        return groups;
    }

    private string DisplayNameForDefinition(string definitionKey)
    {
        return Changes.FirstOrDefault(change => string.Equals(change.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))?.DefinitionDisplayName
               ?? ValidationIssues.FirstOrDefault(issue => string.Equals(issue.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))?.DefinitionDisplayName
               ?? definitionKey;
    }

    private async Task<ConfigurationDefinition> LoadDefinitionAsync(string definitionKey)
    {
        var result = await Facade.GetDefinitionAsync(definitionKey);
        if (result.IsFailed(out var error, out var detail))
        {
            throw new InvalidOperationException($"{L["Common:Errors:LoadFailed"]}: {error.Message}");
        }

        return detail.Definition;
    }

    private async Task<string> LoadOriginJsonAsync(string definitionKey)
    {
        var result = await Facade.GetEffectiveValueAsync(definitionKey, LogicalPath.Root);
        if (result.IsFailed(out var error, out var value))
        {
            throw new InvalidOperationException($"{L["Common:Errors:LoadFailed"]}: {error.Message}");
        }

        return string.IsNullOrWhiteSpace(value.DisplayValue) ? "{}" : value.DisplayValue!;
    }

    private string ApplyChanges(
        ConfigurationDefinition definition,
        string originJson,
        IEnumerable<PendingChange> changes)
    {
        var targetJson = NormalizeJson(originJson);
        foreach (var change in changes.OrderBy(change => change.LogicalPath.ToCanonicalString(), StringComparer.Ordinal))
        {
            targetJson = change.MutationKind switch
            {
                ConfigurationMutationKind.Remove when change.LogicalPath.Depth == 0 => "{}",
                ConfigurationMutationKind.Remove => _patchEngine.Remove(targetJson, definition, change.LogicalPath),
                _ when change.LogicalPath.Depth == 0 => change.NewValue.Json,
                _ => _patchEngine.Patch(targetJson, definition, change.LogicalPath, change.NewValue.Json)
            };
        }

        return targetJson;
    }

    private string FormatForDisplay(string json, ConfigurationDefinition definition)
    {
        return ConfigurationJsonDisplayFormatter.Format(json, definition.Root, L["State:Value:Sensitive"].Value);
    }

    private static string NormalizeJson(string json)
    {
        return ParseJson(json)?.ToJsonString() ?? "{}";
    }

    private static JsonNode? ParseJson(string json)
    {
        return JsonNode.Parse(string.IsNullOrWhiteSpace(json) ? "{}" : json) ?? new JsonObject();
    }

    private sealed record DefinitionDiffGroup(
        string DefinitionKey,
        string DisplayName,
        int ChangeCount,
        IReadOnlyList<ConfigurationValidationIssue> ValidationIssues,
        string OriginJson,
        string TargetJson);
}
