@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<MudPaper Outlined="true" Class="pa-3">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            <MudText Typo="Typo.subtitle2">@StageText</MudText>
            @if (Progress.Percent is { } percent)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["ImportExport:Import:ProgressPercent", Math.Round(percent)]
                </MudText>
            }
        </MudStack>

        @if (Progress.Percent is { } value)
        {
            <MudProgressLinear Value="@value" Min="0" Max="100" Color="Color.Primary" />
        }
        else
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                @L["ImportExport:Import:ProgressDefinitions",
                    Progress.LoadedDefinitionCount,
                    Progress.TotalDefinitionCount,
                    Progress.ProcessedPackageDefinitionCount,
                    Progress.TotalPackageDefinitionCount]
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                @L["ImportExport:Report:Changes", Progress.ChangeCount]
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                @L["ImportExport:Report:Issues", Progress.ValidationIssueCount]
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                @L["ImportExport:Report:Diagnostics", Progress.DiagnosticCount]
            </MudChip>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(Progress.CurrentDefinitionDisplayName))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @L["ImportExport:Import:ProgressCurrentDefinition",
                    Progress.CurrentDefinitionDisplayName,
                    Progress.CurrentDefinitionKey ?? L["Common:States:Empty"]]
            </MudText>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ConfigurationImportProgress Progress { get; set; } = null!;

    private string StageText => Progress.Stage switch
    {
        ConfigurationImportProgressStage.LoadingDefinitions => L["ImportExport:Import:ProgressLoadingDefinitions"],
        ConfigurationImportProgressStage.AnalyzingDefinitions => L["ImportExport:Import:ProgressAnalyzingDefinitions"],
        _ => L["ImportExport:Import:ProgressReadingPackage"]
    };
}
