@using System.Globalization
@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<div class="@EditorClass">
    @if (Node.ValueKind == ConfigurationValueKind.Boolean)
    {
        <MudSwitch @key="EditorInstanceKey"
                   T="bool"
                   Value="@_boolValue"
                   ValueChanged="OnBoolChanged"
                   Disabled="@Disabled"
                   Color="Color.Primary" />
    }
    else if (IsNumeric)
    {
        <MudNumericField @key="EditorInstanceKey"
                         T="decimal?"
                         Value="@_decimalValue"
                         ValueChanged="OnDecimalChanged"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Immediate="true"
                         Error="@HasError"
                         Disabled="@Disabled" />
    }
    else if (Node.ValueKind == ConfigurationValueKind.DateTime)
    {
        <MudDatePicker @key="EditorInstanceKey"
                       Date="@_dateValue"
                       DateChanged="OnDateChanged"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Editable="true"
                       Error="@HasError"
                       Disabled="@Disabled" />
    }
    else if (Node.ValueKind == ConfigurationValueKind.TimeSpan)
    {
        <div class="configuration-time-span-editor">
            <div class="configuration-time-span-input">
                <MudTextField @key="EditorInstanceKey"
                              T="string"
                              @bind-Value:get="@_textValue"
                              @bind-Value:set="OnTimeTextChanged"
                              OnBlur="OnTimeTextBlurred"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Placeholder="@L["State:Editor:TimeSpanPlaceholder"]"
                              Error="@HasError"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Schedule"
                              OnAdornmentClick="OpenTimePicker"
                              Disabled="@Disabled" />
                <MudPopover Open="@_timePickerOpen"
                            AnchorOrigin="Origin.BottomRight"
                            TransformOrigin="Origin.TopRight"
                            Class="configuration-time-picker-popover">
                    <MudStack Spacing="2" Class="configuration-time-picker-menu">
                        <MudTimePicker PickerVariant="PickerVariant.Static"
                                       Time="@_pickerDraftTime"
                                       TimeChanged="OnTimePickerDraftChanged"
                                       TimeFormat="HH:mm"
                                       AmPm="false" />
                        <MudStack Row="true" Justify="Justify.FlexEnd">
                            <MudButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       OnClick="ApplyTimePickerDraft">
                                @L["Common:Actions:Apply"]
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPopover>
                <MudOverlay Visible="@_timePickerOpen"
                            AutoClose="true"
                            OnClosed="CloseTimePicker"
                            LockScroll="false"
                            Modal="false" />
                @if (HasError)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="configuration-time-span-error">
                        @ActiveError
                    </MudText>
                }
            </div>
        </div>
    }
    else if (EnumValues.Count > 0)
    {
        <MudSelect @key="EditorInstanceKey"
                   T="string"
                   Value="@_textValue"
                   ValueChanged="OnTextChanged"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Error="@HasError"
                   Disabled="@Disabled">
            @foreach (var value in EnumValues)
            {
                <MudSelectItem T="string" Value="@value">@value</MudSelectItem>
            }
        </MudSelect>
    }
    else
    {
        <MudTextField @key="EditorInstanceKey"
                      T="string"
                      Value="@_textValue"
                      ValueChanged="OnTextChanged"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      InputType="@TextInputType"
                      Placeholder="@Placeholder"
                      Error="@HasError"
                      Adornment="@(Node.IsSensitive ? Adornment.End : Adornment.None)"
                      AdornmentIcon="@SensitiveAdornmentIcon"
                      OnAdornmentClick="ToggleSensitiveVisibility"
                      oncopy="@(Node.IsSensitive ? "return false" : null)"
                      oncut="@(Node.IsSensitive ? "return false" : null)"
                      Disabled="@Disabled" />
        @if (Node.IsRegexPatternText)
        {
            <div class="configuration-regex-hint">
                <MudTooltip Text="@L["State:Editor:RegexPatternTooltip"]">
                    <span class="configuration-regex-badge">
                        <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Small" />
                        <span>@L["State:Editor:RegexPattern"]</span>
                    </span>
                </MudTooltip>
                @if (CanShowRegexPreview && RegexPreviewTokens.Count > 0)
                {
                    <button type="button"
                            class="@RegexPreviewClass"
                            aria-label="@RegexPreviewToggleLabel"
                            title="@RegexPreviewToggleLabel"
                            @onclick="ToggleRegexPreviewMode">
                        <span class="configuration-regex-preview-mode">@RegexPreviewModeLabel</span>
                        <code class="configuration-regex-preview-code" aria-label="@L["State:Editor:RegexPreview"]">
                            @foreach (var token in RegexPreviewTokens)
                            {
                                <span class="@token.CssClass">@token.Text</span>
                            }
                        </code>
                    </button>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Node.EditorHint))
        {
            <div class="configuration-editor-hint">
                <MudTooltip Text="@L["State:Editor:EditorHintTooltip", Node.EditorHint]">
                    <span class="configuration-editor-hint-badge">
                        <MudIcon Icon="@Icons.Material.Filled.EditAttributes" Size="Size.Small" />
                        <span>@Node.EditorHint</span>
                    </span>
                </MudTooltip>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public ConfigurationNodeDefinition Node { get; set; } = null!;
    [Parameter] public ConfigurationEffectiveValue? EffectiveValue { get; set; }
    [Parameter] public bool IsModified { get; set; }
    [Parameter] public PendingChange? PendingChange { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ConfigurationValidationIssue? ValidationIssue { get; set; }
    [Parameter] public EventCallback<ConfigurationScalarEditResult> ValueChanged { get; set; }

    private string _textValue = string.Empty;
    private bool _boolValue;
    private decimal? _decimalValue;
    private DateTime? _dateValue;
    private TimeSpan? _timeValue;
    private TimeSpan? _pickerDraftTime;
    private bool _timePickerOpen;
    private bool _showSensitive;
    private bool _showDecodedRegexPreview;
    private string? _error;
    private string? _lastNodePath;
    private string? _lastEffectiveDisplayValue;
    private string? _lastPendingChangeKey;
    private string? _lastLocalPendingChangeKey;
    private string? _lastValidationIssueKey;
    private bool _lastIsModified;
    private bool _hasInvalidLocalEdit;
    private bool _preserveCurrentValueOnValidationClear;
    private int _editorResetVersion;

    private bool IsNumeric => Node.ValueKind is ConfigurationValueKind.Integer or ConfigurationValueKind.Decimal or ConfigurationValueKind.Floating;

    private IReadOnlyList<string> EnumValues =>
        ConfigurationScalarValueCodec.GetAllowedValues(Node);

    private InputType TextInputType => Node.IsSensitive && !_showSensitive ? InputType.Password : InputType.Text;

    private string? ActiveError => _error ?? ValidationIssue?.ValidationError;

    private bool HasError => !string.IsNullOrWhiteSpace(ActiveError);

    private bool CanShowRegexPreview => !Node.IsSensitive || _showSensitive;

    private IReadOnlyList<ConfigurationRegexPatternToken> RegexPreviewTokens =>
        ConfigurationRegexPatternHighlighter.Tokenize(_textValue, _showDecodedRegexPreview);

    private string RegexPreviewModeLabel => _showDecodedRegexPreview
        ? L["State:Editor:RegexPreviewDecoded"].Value
        : L["State:Editor:RegexPreviewEscaped"].Value;

    private string RegexPreviewToggleLabel => _showDecodedRegexPreview
        ? L["State:Editor:RegexPreviewShowEscaped"].Value
        : L["State:Editor:RegexPreviewShowDecoded"].Value;

    private string RegexPreviewClass => string.Join(' ', new[]
    {
        "configuration-regex-preview",
        _showDecodedRegexPreview ? "is-decoded" : "is-escaped"
    });

    private string EditorClass => string.Join(' ', new[]
    {
        "configuration-scalar-editor",
        IsModified ? "modified-input" : null,
        HasError ? "invalid-input" : null
    }.Where(static value => !string.IsNullOrWhiteSpace(value)));

    private string EditorInstanceKey => $"{Node.RelativePath.ToCanonicalString()}:{Node.ValueKind}:{_editorResetVersion}";

    private string? SensitiveAdornmentIcon => Node.IsSensitive
        ? _showSensitive ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility
        : null;

    private string? Placeholder => Node.IsSensitive && string.IsNullOrWhiteSpace(_textValue)
        ? L["State:Editor:SensitivePlaceholder"].Value
        : null;

    protected override void OnParametersSet()
    {
        var displayValue = PendingChange?.NewDisplayValue ?? EffectiveValue?.DisplayValue ?? string.Empty;
        var nodePath = Node.RelativePath.ToCanonicalString();
        var pendingChangeKey = BuildPendingChangeKey(PendingChange);
        var validationIssueKey = BuildValidationIssueKey();

        var pathChanged = !string.Equals(_lastNodePath, nodePath, StringComparison.Ordinal);
        var displayChanged = !string.Equals(_lastEffectiveDisplayValue, displayValue, StringComparison.Ordinal);
        var pendingChanged = !string.Equals(_lastPendingChangeKey, pendingChangeKey, StringComparison.Ordinal);
        var validationIssueChanged = !string.Equals(_lastValidationIssueKey, validationIssueKey, StringComparison.Ordinal);
        var modifiedChanged = _lastIsModified != IsModified;
        if (!pathChanged && !displayChanged && !pendingChanged && !validationIssueChanged && !modifiedChanged)
        {
            return;
        }

        if (pathChanged)
        {
            _showDecodedRegexPreview = false;
            if (ValidationIssue is not null)
            {
                SyncFromValidationIssue(ValidationIssue);
            }
            else
            {
                SyncFromEffectiveValue(displayValue, resetSensitiveVisibility: true);
            }
        }
        else if (PendingChange is not null && pendingChanged && !IsLocalPendingChange(pendingChangeKey))
        {
            SyncFromEffectiveValue(displayValue, resetSensitiveVisibility: false);
        }
        else if (ValidationIssue is not null && validationIssueChanged)
        {
            SyncFromValidationIssue(ValidationIssue);
        }
        else if (ValidationIssue is null && validationIssueChanged)
        {
            if (_preserveCurrentValueOnValidationClear)
            {
                _error = null;
                _hasInvalidLocalEdit = false;
                _preserveCurrentValueOnValidationClear = false;
            }
            else
            {
                SyncFromEffectiveValue(displayValue, resetSensitiveVisibility: false);
            }
        }
        else if (!IsModified && !_hasInvalidLocalEdit)
        {
            SyncFromEffectiveValue(displayValue, resetSensitiveVisibility: false);
        }

        _lastNodePath = nodePath;
        _lastEffectiveDisplayValue = displayValue;
        _lastPendingChangeKey = pendingChangeKey;
        if (PendingChange is null)
        {
            _lastLocalPendingChangeKey = null;
        }

        _lastValidationIssueKey = validationIssueKey;
        _lastIsModified = IsModified;
    }

    private bool IsLocalPendingChange(string? pendingChangeKey)
    {
        return pendingChangeKey is not null
               && string.Equals(pendingChangeKey, _lastLocalPendingChangeKey, StringComparison.Ordinal);
    }

    private static string? BuildPendingChangeKey(PendingChange? change)
    {
        return change is null
            ? null
            : $"{change.LogicalPath.ToCanonicalString()}:{change.MutationKind}:{change.NewValue.Json}:{change.NewDisplayValue}";
    }

    private string? BuildValidationIssueKey()
    {
        return ValidationIssue is null
            ? null
            : $"{ValidationIssue.DefinitionKey}:{ValidationIssue.LogicalPath.ToCanonicalString()}:{ValidationIssue.InvalidDisplayValue}:{ValidationIssue.ValidationError}";
    }

    private void SyncFromEffectiveValue(string displayValue, bool resetSensitiveVisibility)
    {
        if (resetSensitiveVisibility)
        {
            _showSensitive = false;
        }

        _error = null;
        _hasInvalidLocalEdit = false;
        _preserveCurrentValueOnValidationClear = false;
        SyncScalarFields(displayValue);
        _editorResetVersion++;
    }

    private void SyncFromValidationIssue(ConfigurationValidationIssue issue)
    {
        var displayValue = issue.IsSensitive ? string.Empty : issue.InvalidDisplayValue ?? string.Empty;
        SyncScalarFields(displayValue);
        _error = issue.ValidationError;
        _hasInvalidLocalEdit = true;
        _preserveCurrentValueOnValidationClear = false;
    }

    private void SyncScalarFields(string displayValue)
    {
        displayValue = ConfigurationScalarValueCodec.NormalizeDisplayValue(Node, displayValue);
        _textValue = Node.ValueKind == ConfigurationValueKind.TimeSpan
            ? ConfigurationScalarTextCodec.NormalizeTimeSpanDisplay(displayValue)
            : displayValue;
        _boolValue = bool.TryParse(displayValue, out var parsedBool) && parsedBool;
        _decimalValue = decimal.TryParse(displayValue, NumberStyles.Any, CultureInfo.InvariantCulture, out var parsedDecimal)
            ? parsedDecimal
            : null;
        _dateValue = DateTime.TryParse(displayValue, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var parsedDate)
            ? parsedDate
            : null;
        _timeValue = ConfigurationScalarTextCodec.TryParseTimeSpan(displayValue, out var parsedTime)
            ? parsedTime
            : null;
    }

    private async Task OnTextChanged(string value)
    {
        _textValue = value;
        await EmitAsync(value);
    }

    private async Task OnBoolChanged(bool value)
    {
        _boolValue = value;
        await EmitAsync(value ? "true" : "false", rawJson: value ? "true" : "false");
    }

    private async Task OnDecimalChanged(decimal? value)
    {
        _decimalValue = value;
        await EmitAsync(value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty, rawJson: value?.ToString(CultureInfo.InvariantCulture) ?? "null");
    }

    private async Task OnDateChanged(DateTime? value)
    {
        _dateValue = value;
        var text = value?.ToString("O", CultureInfo.InvariantCulture) ?? string.Empty;
        await EmitAsync(text);
    }

    private void OpenTimePicker()
    {
        if (Disabled)
        {
            return;
        }

        _pickerDraftTime = _timeValue;
        _timePickerOpen = true;
    }

    private void CloseTimePicker()
    {
        _timePickerOpen = false;
    }

    private Task OnTimePickerDraftChanged(TimeSpan? value)
    {
        _pickerDraftTime = value;
        return Task.CompletedTask;
    }

    private async Task ApplyTimePickerDraft()
    {
        _timeValue = _pickerDraftTime;
        if (_timeValue is null)
        {
            _textValue = string.Empty;
            await EmitAsync(string.Empty);
        }
        else
        {
            var displayValue = ConfigurationScalarTextCodec.FormatTimeSpan(_timeValue.Value);
            _textValue = displayValue;
            await EmitAsync(displayValue, ConfigurationScalarTextCodec.ToTimeSpanJson(_timeValue.Value));
        }

        _timePickerOpen = false;
    }

    private async Task OnTimeTextChanged(string? value)
    {
        value ??= string.Empty;
        _textValue = value;
        if (!Validate(value))
        {
            await EmitInvalidAsync(value);
            return;
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            await EmitAsync(value);
            return;
        }

        if (!ConfigurationScalarTextCodec.TryParseTimeSpan(value, out var parsedValue))
        {
            _error = L["State:Editor:InvalidTimeSpan"];
            await EmitInvalidAsync(value);
            return;
        }

        await EmitAsync(
            ConfigurationScalarTextCodec.FormatTimeSpan(parsedValue),
            ConfigurationScalarTextCodec.ToTimeSpanJson(parsedValue));
    }

    private Task OnTimeTextBlurred(FocusEventArgs _)
    {
        return OnTimeTextChanged(_textValue);
    }

    private async Task EmitAsync(string displayValue, string? rawJson = null)
    {
        var conversion = ConfigurationScalarValueCodec.ConvertDisplayValue(Node, displayValue, L, rawJson);
        if (!conversion.IsValid || conversion.StoredValue is null)
        {
            await EmitInvalidAsync(conversion.DisplayValue, conversion.ValidationError);
            return;
        }

        _hasInvalidLocalEdit = false;
        _preserveCurrentValueOnValidationClear = true;
        _lastLocalPendingChangeKey = BuildLocalPendingChangeKey(conversion.StoredValue, conversion.DisplayValue);
        await ValueChanged.InvokeAsync(new ConfigurationScalarEditResult
        {
            IsValid = true,
            StoredValue = conversion.StoredValue,
            DisplayValue = conversion.DisplayValue
        });
    }

    private async Task EmitInvalidAsync(string displayValue, string? validationError = null)
    {
        _error = validationError ?? _error;
        _hasInvalidLocalEdit = true;
        _preserveCurrentValueOnValidationClear = false;
        await ValueChanged.InvokeAsync(new ConfigurationScalarEditResult
        {
            IsValid = false,
            DisplayValue = displayValue,
            ValidationError = _error
        });
    }

    private string BuildLocalPendingChangeKey(ConfigurationStoredValue storedValue, string? displayValue)
    {
        return $"{Node.RelativePath.ToCanonicalString()}:{ConfigurationMutationKind.Set}:{storedValue.Json}:{displayValue}";
    }

    private bool Validate(string value)
    {
        _error = ConfigurationScalarValueCodec.ValidateDisplayValue(Node, value, L);
        return string.IsNullOrWhiteSpace(_error);
    }

    private void ToggleSensitiveVisibility()
    {
        _showSensitive = !_showSensitive;
    }

    private void ToggleRegexPreviewMode()
    {
        _showDecodedRegexPreview = !_showDecodedRegexPreview;
    }
}
