@using Monica.Configuration.UI.Localization
@inject ConfigurationStateStore StateStore
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IStringLocalizer<ConfigurationUIResource> L

<MudPaper Outlined="true" Class="pa-3 configuration-value-row">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.subtitle2">@DisplayName</MudText>
                    @if (!string.IsNullOrWhiteSpace(Node.Description))
                    {
                        <MudTooltip Text="@Node.Description">
                            <MudIconButton Icon="@Icons.Material.Filled.Info"
                                           Size="Size.Small"
                                           Color="Color.Info"
                                           Variant="Variant.Text"
                                           Class="configuration-description-button" />
                        </MudTooltip>
                    }
                    @if (Node.IsSensitive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L["State:Value:Sensitive"]</MudChip>
                    }
                    @if (Node.ValidationRules.OfType<RequiredRule>().Any())
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@L["State:Value:Required"]</MudChip>
                    }
                    @if (EffectiveReloadBehavior is ConfigurationReloadBehavior.RequiresRestart or ConfigurationReloadBehavior.StaticAfterStartup)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">@L["State:Value:RestartNeeded"]</MudChip>
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@PathLabel</MudText>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="6">
            @if (Node.NodeKind == ConfigurationNodeKind.Scalar)
            {
                <ConfigurationScalarEditor Node="@Node"
                                           EffectiveValue="@EffectiveValue"
                                           IsModified="@(PendingChange is not null)"
                                           ValueChanged="StageScalar" />
            }
            else
            {
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.DataObject"
                           OnClick="EditComplexValue">
                    @L["State:Actions:EditComplex"]
                </MudButton>
            }
        </MudItem>

        <MudItem xs="12" md="2">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                <MudTooltip Text="@L["History:Title"]">
                    <MudIconButton Icon="@Icons.Material.Filled.History"
                                   Size="Size.Small"
                                   OnClick="OpenHistory" />
                </MudTooltip>
                @if (PendingChange is not null)
                {
                    <MudTooltip Text="@L["State:Actions:Undo"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                       Size="Size.Small"
                                       Color="Color.Warning"
                                       OnClick="Undo" />
                    </MudTooltip>
                }
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ConfigurationDefinition Definition { get; set; } = null!;
    [Parameter, EditorRequired] public ConfigurationNodeDefinition Node { get; set; } = null!;
    [Parameter] public ConfigurationEffectiveValue? EffectiveValue { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private PendingChange? PendingChange => StateStore.Get(Definition.DefinitionKey, Node.RelativePath);

    private string DisplayName => string.IsNullOrWhiteSpace(Node.DisplayName) ? Node.Name : Node.DisplayName!;

    private string PathLabel => Node.RelativePath.Depth == 0 ? L["State:Tree:Root"] : Node.RelativePath.ToCanonicalString();

    private ConfigurationReloadBehavior EffectiveReloadBehavior =>
        Node.ReloadBehavior is { } behavior and not ConfigurationReloadBehavior.Inherit
            ? behavior
            : Definition.ReloadBehavior;

    private async Task StageScalar(ConfigurationScalarEditResult result)
    {
        StateStore.Stage(new PendingChange
        {
            DefinitionKey = Definition.DefinitionKey,
            DefinitionDisplayName = Definition.DisplayName,
            LogicalPath = Node.RelativePath,
            NodeDisplayName = DisplayName,
            MutationKind = ConfigurationMutationKind.Set,
            NewValue = result.StoredValue,
            OriginalDisplayValue = EffectiveValue?.DisplayValue,
            NewDisplayValue = result.DisplayValue,
            ExpectedSchemaVersion = Definition.SchemaVersion,
            ExpectedValueVersion = EffectiveValue?.Version,
            IsSensitive = Node.IsSensitive,
            NodeKind = Node.NodeKind,
            ValueKind = Node.ValueKind,
            ReloadBehavior = EffectiveReloadBehavior
        });
        await Changed.InvokeAsync();
    }

    private async Task EditComplexValue()
    {
        var parameters = new DialogParameters<ComplexValueEditorDialog>();
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.Node, Node);
        parameters.Add(dialog => dialog.EffectiveValue, EffectiveValue);
        var dialog = await DialogService.ShowAsync<ComplexValueEditorDialog>(L["Dialogs:ComplexEditor:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: PendingChange change })
        {
            StateStore.Stage(change);
            await Changed.InvokeAsync();
        }
    }

    private void OpenHistory()
    {
        NavigationManager.NavigateTo(ConfigurationUiRoutes.History(Definition.DefinitionKey, Node.RelativePath));
    }

    private async Task Undo()
    {
        StateStore.Undo(Definition.DefinitionKey, Node.RelativePath);
        await Changed.InvokeAsync();
    }

}
