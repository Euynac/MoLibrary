@using Monica.Configuration.UI.Localization
@inject ConfigurationFacade Facade
@inject ConfigurationStateStore StateStore
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<MudPaper Outlined="true" Class="pa-3 configuration-value-row">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.subtitle2">@DisplayName</MudText>
                    @if (!string.IsNullOrWhiteSpace(Node.Description))
                    {
                        <MudTooltip Text="@Node.Description">
                            <MudIconButton Icon="@Icons.Material.Filled.Info"
                                           Size="Size.Small"
                                           Color="Color.Info"
                                           Variant="Variant.Text"
                                           Class="configuration-description-button" />
                        </MudTooltip>
                    }
                    @if (Node.IsSensitive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L["State:Value:Sensitive"]</MudChip>
                    }
                    @if (Node.ValidationRules.OfType<RequiredRule>().Any())
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@L["State:Value:Required"]</MudChip>
                    }
                    @if (EffectiveReloadBehavior is ConfigurationReloadBehavior.RequiresRestart or ConfigurationReloadBehavior.StaticAfterStartup)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">@L["State:Value:RestartNeeded"]</MudChip>
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@PathLabel</MudText>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="6">
            @if (Node.NodeKind == ConfigurationNodeKind.Scalar)
            {
                <ConfigurationScalarEditor Node="@Node"
                                           EffectiveValue="@EffectiveValue"
                                           IsModified="@(PendingChange is not null)"
                                           ValueChanged="StageScalar" />
            }
            else if (Node.NodeKind is ConfigurationNodeKind.Dictionary or ConfigurationNodeKind.List)
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="PreviewComplexValue">
                        @L["State:Actions:PreviewValue"]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.DataObject"
                               OnClick="EditComplexValue">
                        @L["State:Actions:EditComplex"]
                    </MudButton>
                </MudStack>
            }
        </MudItem>

        <MudItem xs="12" md="2">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                <MudTooltip Text="@L["History:Title"]">
                    <MudIconButton Icon="@Icons.Material.Filled.History"
                                   Size="Size.Small"
                                   OnClick="OpenHistoryAsync" />
                </MudTooltip>
                @if (HasPendingChanges)
                {
                    <MudTooltip Text="@L["State:Actions:Undo"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                       Size="Size.Small"
                                       Color="Color.Warning"
                                       OnClick="Undo" />
                    </MudTooltip>
                }
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ConfigurationDefinition Definition { get; set; } = null!;
    [Parameter, EditorRequired] public ConfigurationNodeDefinition Node { get; set; } = null!;
    [Parameter] public ConfigurationEffectiveValue? EffectiveValue { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private PendingChange? PendingChange => StateStore.Get(Definition.DefinitionKey, Node.RelativePath);

    private IReadOnlyList<PendingChange> ScopedPendingChanges => StateStore.GetScope(Definition.DefinitionKey, Node.RelativePath);

    private bool HasPendingChanges => Node.NodeKind == ConfigurationNodeKind.Scalar
        ? PendingChange is not null
        : ScopedPendingChanges.Count > 0;

    private string DisplayName => string.IsNullOrWhiteSpace(Node.DisplayName) ? Node.Name : Node.DisplayName!;

    private string PathLabel => Node.RelativePath.Depth == 0 ? L["State:Tree:Root"] : Node.RelativePath.ToCanonicalString();

    private ConfigurationReloadBehavior EffectiveReloadBehavior =>
        Node.ReloadBehavior is { } behavior and not ConfigurationReloadBehavior.Inherit
            ? behavior
            : Definition.ReloadBehavior;

    private async Task StageScalar(ConfigurationScalarEditResult result)
    {
        if (!result.IsValid || result.StoredValue is null)
        {
            await UndoScalarIfPending();
            return;
        }

        if (IsSameAsEffectiveValue(result))
        {
            await UndoScalarIfPending();
            return;
        }

        StateStore.Stage(new PendingChange
        {
            DefinitionKey = Definition.DefinitionKey,
            DefinitionDisplayName = Definition.DisplayName,
            LogicalPath = Node.RelativePath,
            NodeDisplayName = DisplayName,
            MutationKind = ConfigurationMutationKind.Set,
            NewValue = result.StoredValue,
            OriginalDisplayValue = EffectiveValue?.DisplayValue,
            NewDisplayValue = result.DisplayValue,
            ExpectedSchemaVersion = Definition.SchemaVersion,
            ExpectedValueVersion = EffectiveValue?.Version,
            IsSensitive = Node.IsSensitive,
            NodeKind = Node.NodeKind,
            ValueKind = Node.ValueKind,
            ReloadBehavior = EffectiveReloadBehavior
        });
        await Changed.InvokeAsync();
    }

    private bool IsSameAsEffectiveValue(ConfigurationScalarEditResult result)
    {
        var effectiveDisplayValue = EffectiveValue?.DisplayValue ?? string.Empty;
        return string.Equals(result.DisplayValue, effectiveDisplayValue, StringComparison.Ordinal);
    }

    private async Task UndoScalarIfPending()
    {
        if (PendingChange is null)
        {
            return;
        }

        StateStore.Undo(Definition.DefinitionKey, Node.RelativePath);
        await Changed.InvokeAsync();
    }

    private async Task EditComplexValue()
    {
        var effectiveValue = await LoadComplexEffectiveValueAsync();
        if (effectiveValue is null)
        {
            return;
        }

        var parameters = new DialogParameters<ComplexValueEditorDialog>();
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.Node, Node);
        parameters.Add(dialog => dialog.EffectiveValue, effectiveValue);
        parameters.Add(dialog => dialog.PendingChanges, StateStore.GetPending());
        var dialog = await DialogService.ShowAsync<ComplexValueEditorDialog>(L["Dialogs:ComplexEditor:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        });
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        if (result.Data is IReadOnlyList<PendingChange> changes)
        {
            StateStore.ReplaceScope(Definition.DefinitionKey, Node.RelativePath, changes);
            await Changed.InvokeAsync();
        }
    }

    private async Task PreviewComplexValue()
    {
        var effectiveValue = await LoadComplexEffectiveValueAsync();
        if (effectiveValue is null)
        {
            return;
        }

        var parameters = new DialogParameters<ConfigurationCurrentValuePreviewDialog>();
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.Node, Node);
        parameters.Add(dialog => dialog.EffectiveValue, effectiveValue);
        parameters.Add(dialog => dialog.PendingChanges, StateStore.GetPending());
        await DialogService.ShowAsync<ConfigurationCurrentValuePreviewDialog>(L["Dialogs:CurrentValue:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        });
    }

    private async Task<ConfigurationEffectiveValue?> LoadComplexEffectiveValueAsync()
    {
        var effectiveValueResult = await Facade.GetEffectiveValueAsync(Definition.DefinitionKey, Node.RelativePath);
        if (effectiveValueResult.IsFailed(out var error, out var loadedEffectiveValue))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            return null;
        }

        return loadedEffectiveValue;
    }

    private async Task OpenHistoryAsync()
    {
        var result = await Facade.GetHistoryAsync(Definition.DefinitionKey, Node.RelativePath);
        if (result.IsFailed(out var error, out var rows))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<ConfigurationHistoryDiffDialog>();
        parameters.Add(dialog => dialog.Rows, rows);
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.FocusPath, Node.RelativePath);
        parameters.Add(dialog => dialog.Title, L["History:Dialog:MutationTitle", Definition.DisplayName]);
        await DialogService.ShowAsync<ConfigurationHistoryDiffDialog>(L["History:Dialog:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        });
    }

    private async Task Undo()
    {
        if (Node.NodeKind == ConfigurationNodeKind.Scalar)
        {
            StateStore.Undo(Definition.DefinitionKey, Node.RelativePath);
        }
        else
        {
            StateStore.UndoScope(Definition.DefinitionKey, Node.RelativePath);
        }

        await Changed.InvokeAsync();
    }

}
