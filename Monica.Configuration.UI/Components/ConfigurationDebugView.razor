@using Monica.Core.Results;
@using Monica.Configuration.Facades
@inject ConfigurationFacade ConfigurationFacade
@inject ISnackbar Snackbar

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-2" Style="vertical-align: text-bottom;" />
                配置调试视图
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Variant="Variant.Outlined"
                      StartIcon="@Icons.Material.Filled.Refresh"
                      OnClick="LoadDebugViewAsync"
                      Disabled="@isLoading">
                刷新
            </MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (debugView != null && debugView.Any())
        {
            <!-- Search Section -->
            <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="searchText"
                             Label="搜索调试信息"
                             Placeholder="输入关键字搜索..."
                             Variant="Variant.Outlined"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             Clearable="true"
                             Immediate="false"
                             DebounceInterval="300"
                             OnDebounceIntervalElapsed="OnSearchChanged"
                             Style="flex: 1;" />

                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Info">
                        找到 @FilteredDebugView.Count() 条结果
                    </MudChip>
                }
            </MudStack>

            <MudTable T="string" Items="FilteredDebugView" Dense="true" Hover="true" FixedHeader="true" Height="70vh" Style="width: 100%;" RowsPerPage="50">
                <HeaderContent>
                    <MudTh Style="width: 100%;">调试信息</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="调试信息" Style="width: 100%; word-break: break-all;">
                        <MudText Typo="Typo.body2" Style="font-family: monospace; white-space: pre-wrap; word-wrap: break-word;">@HighlightSearchText(context)</MudText>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@(new[] { 20, 50, 100, 200 })" />
                </PagerContent>
                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            @(string.IsNullOrWhiteSpace(searchText) ? "暂无调试信息" : "未找到匹配的调试信息")
                        </MudText>
                    </MudStack>
                </NoRecordsContent>
            </MudTable>
        }
        else if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (debugView != null && !debugView.Any())
        {
            <MudAlert Severity="Severity.Info">暂无调试信息</MudAlert>
        }
        else
        {
            <MudText Class="text-muted">加载中...</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    private string[]? debugView;
    private bool isLoading = false;
    private string searchText = string.Empty;

    private IEnumerable<string> FilteredDebugView =>
        string.IsNullOrWhiteSpace(searchText)
            ? (debugView ?? Array.Empty<string>())
            : debugView?.Where(line => line.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase))
              ?? Array.Empty<string>();

    private void OnSearchChanged()
    {
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDebugViewAsync();
    }

    private MarkupString HighlightSearchText(string text)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return new MarkupString(System.Net.WebUtility.HtmlEncode(text));

        var keyword = searchText.Trim();
        var escapedText = System.Net.WebUtility.HtmlEncode(text);
        var escapedKeyword = System.Net.WebUtility.HtmlEncode(keyword);

        var highlighted = System.Text.RegularExpressions.Regex.Replace(
            escapedText,
            System.Text.RegularExpressions.Regex.Escape(escapedKeyword),
            match => $"<mark style='background: var(--mo-color-highlight-background); color: var(--mo-color-highlight-text); padding: 0 2px; border-radius: 4px;'>{match.Value}</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return new MarkupString(highlighted);
    }

    public async Task LoadDebugViewAsync()
    {
        isLoading = true;
        StateHasChanged();

        if ((await ConfigurationFacade.GetDebugViewAsync()).IsFailed(out var error, out var data))
        {
            Snackbar.Add($"加载调试视图失败: {error}", Severity.Error);
        }
        else
        {
            debugView = data;
        }

        isLoading = false;
        StateHasChanged();
    }
}
