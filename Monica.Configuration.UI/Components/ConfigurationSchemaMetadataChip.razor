@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<MudTooltip Delay="300" Arrow="true" Placement="@Placement">
    <ChildContent>
        @if (OnClick.HasDelegate)
        {
            <MudChip T="string"
                     Size="@Size"
                     Color="@Color"
                     Variant="@Variant"
                     OnClick="HandleClick">
                @L["State:Definitions:SchemaVersionChip", SchemaVersion]
            </MudChip>
        }
        else
        {
            <MudChip T="string"
                     Size="@Size"
                     Color="@Color"
                     Variant="@Variant">
                @L["State:Definitions:SchemaVersionChip", SchemaVersion]
            </MudChip>
        }
    </ChildContent>
    <TooltipContent>
        <MudStack Spacing="1" Class="configuration-schema-metadata-tooltip">
            <MudText Typo="Typo.caption" Class="configuration-schema-metadata-title">
                @L["State:Definitions:SchemaMetadataTitle"]
            </MudText>
            <MudText Typo="Typo.caption">
                @L["State:Definitions:SchemaVersionDetail", SchemaVersion]
            </MudText>
            <MudText Typo="Typo.caption">@L["State:Definitions:SchemaHashDetail"]</MudText>
            <MudText Typo="Typo.caption" Class="configuration-schema-hash-short">
                @ShortHash
            </MudText>
            <MudText Typo="Typo.caption" Class="configuration-schema-hash-value">
                @DisplayHash
            </MudText>
        </MudStack>
    </TooltipContent>
</MudTooltip>

@code {
    [Parameter] public int SchemaVersion { get; set; }
    [Parameter] public string? SchemaHash { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Placement Placement { get; set; } = Placement.Bottom;
    [Parameter] public EventCallback OnClick { get; set; }

    private string DisplayHash =>
        string.IsNullOrWhiteSpace(SchemaHash)
            ? L["State:Definitions:SchemaHashMissing"].Value
            : SchemaHash;

    private string ShortHash
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SchemaHash))
            {
                return L["State:Definitions:SchemaHashMissing"].Value;
            }

            var hash = SchemaHash;
            if (hash.StartsWith("sha256:", StringComparison.OrdinalIgnoreCase) && hash.Length > 22)
            {
                return $"{hash[..14]}...{hash[^8..]}";
            }

            return hash.Length > 24 ? $"{hash[..12]}...{hash[^8..]}" : hash;
        }
    }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}
