@attribute [Route(PAGE_URL)]
@inject ConfigurationFacade Facade
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationMutationEditor:Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="configuration-page-shell">
    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@L["Pages:ConfigurationMutationEditor:Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@DefinitionKey</MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">
            @L["Common:Actions:Back"]
        </MudButton>
    </MudStack>

    <MudPaper Class="pa-4" Outlined="true">
        <MudStack Spacing="3">
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_definition is null)
            {
                <MudAlert Severity="Severity.Warning">@L["Common:States:NotFound"]</MudAlert>
            }
            else if (_selectedNode is not null)
            {
                <MudAlert Severity="@ResolveReloadSeverity(_selectedNode)" Variant="Variant.Outlined">
                    @L["Mutation:ReloadBehavior"]: @ResolveReloadBehavior(_selectedNode)
                    @if (ResolveReloadBehavior(_selectedNode) == ConfigurationReloadBehavior.RequiresRestart)
                    {
                        <span> - @L["Mutation:Hints:RequiresRestart"]</span>
                    }
                    else if (ResolveReloadBehavior(_selectedNode) == ConfigurationReloadBehavior.StaticAfterStartup)
                    {
                        <span> - @L["Mutation:Hints:StaticAfterStartup"]</span>
                    }
                </MudAlert>
            }

            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Value="@DefinitionKey" Label="@L["Mutation:DefinitionKey"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="_pathText" Label="@L["Mutation:LogicalPath"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="ConfigurationMutationKind" @bind-Value="_mutationKind" Label="@L["Mutation:MutationKind"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="ConfigurationMutationKind" Value="@ConfigurationMutationKind.Set">@L["Mutation:Kinds:Set"]</MudSelectItem>
                        <MudSelectItem T="ConfigurationMutationKind" Value="@ConfigurationMutationKind.Remove">@L["Mutation:Kinds:Remove"]</MudSelectItem>
                        <MudSelectItem T="ConfigurationMutationKind" Value="@ConfigurationMutationKind.Replace">@L["Mutation:Kinds:Replace"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="_targetSourceKey" Label="@L["Mutation:SourceKey"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_schemaVersion" Label="@L["Mutation:ExpectedSchemaVersion"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="long?" @bind-Value="_valueVersion" Label="@L["Mutation:ExpectedValueVersion"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            <MudTabs Rounded="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="@L["Mutation:RawJson"]" Icon="@Icons.Material.Filled.Code">
                    <MudTextField T="string" @bind-Value="_jsonText" Variant="Variant.Outlined" Lines="12" FullWidth="true" />
                </MudTabPanel>
                <MudTabPanel Text="@L["Mutation:Structured"]" Icon="@Icons.Material.Filled.DataObject">
                    <MudTextField T="string" @bind-Value="_jsonText" Variant="Variant.Outlined" Lines="12" FullWidth="true" />
                </MudTabPanel>
            </MudTabs>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="ApplyAsync">
                    @L["Mutation:Apply"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="Reset">
                    @L["Mutation:Reset"]
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    public const string PAGE_URL = "/configuration/{definitionKey}/edit";

    [Parameter] public string DefinitionKey { get; set; } = string.Empty;

    private string _pathText = string.Empty;
    private string _targetSourceKey = string.Empty;
    private ConfigurationMutationKind _mutationKind = ConfigurationMutationKind.Set;
    private string _jsonText = "{}";
    private int _schemaVersion = 1;
    private long? _valueVersion;
    private ConfigurationDefinition? _definition;
    private ConfigurationNodeDefinition? _selectedNode;
    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _pathText = ConfigurationUiRoutes.ReadPath(NavigationManager.Uri).ToCanonicalString();
        await LoadDefinitionAsync();
    }

    private async Task ApplyAsync()
    {
        if (!TryParsePath(out var logicalPath) || !TryBuildStoredValue(out var value))
        {
            return;
        }

        _selectedNode = ResolveNode(_definition, logicalPath);
        var request = new ConfigurationMutationRequest
        {
            DefinitionKey = DefinitionKey,
            LogicalPath = logicalPath,
            MutationKind = _mutationKind,
            Value = value,
            TargetSourceKey = string.IsNullOrWhiteSpace(_targetSourceKey) ? null : _targetSourceKey,
            ExpectedSchemaVersion = _schemaVersion,
            ExpectedValueVersion = _valueVersion
        };

        var result = await Facade.MutateAsync(request);
        if (result.IsFailed(out var error, out _))
        {
            Snackbar.Add($"{L["Common:Errors:MutationFailed"]}: {error.Message}", Severity.Error);
            return;
        }

        Snackbar.Add(L["Mutation:States:Success"], Severity.Success);
    }

    private async Task LoadDefinitionAsync()
    {
        _isLoading = true;
        var result = await Facade.GetDefinitionAsync(DefinitionKey);
        if (result.IsFailed(out var error, out var detail))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            _definition = null;
            _selectedNode = null;
            _isLoading = false;
            return;
        }

        _definition = detail.Definition;
        _schemaVersion = _definition.SchemaVersion;
        _selectedNode = ResolveNode(_definition, ConfigurationUiRoutes.ReadPath(NavigationManager.Uri));
        _isLoading = false;
    }

    private bool TryParsePath(out LogicalPath logicalPath)
    {
        try
        {
            logicalPath = LogicalPath.Parse(_pathText);
            _pathText = logicalPath.ToCanonicalString();
            _selectedNode = ResolveNode(_definition, logicalPath);
            return true;
        }
        catch (Exception ex)
        {
            logicalPath = LogicalPath.Root;
            Snackbar.Add($"{L["Common:Errors:InvalidPath"]}: {ex.Message}", Severity.Error);
            return false;
        }
    }

    private bool TryBuildStoredValue(out ConfigurationStoredValue value)
    {
        var json = string.IsNullOrWhiteSpace(_jsonText) ? "null" : _jsonText;
        try
        {
            using var _ = JsonDocument.Parse(json);
            value = ConfigurationStoredValue.Plain(json);
            return true;
        }
        catch (JsonException ex)
        {
            value = ConfigurationStoredValue.Null;
            Snackbar.Add($"{L["Common:Errors:InvalidJson"]}: {ex.Message}", Severity.Error);
            return false;
        }
    }

    private void Reset()
    {
        _jsonText = "{}";
        _mutationKind = ConfigurationMutationKind.Set;
        _targetSourceKey = string.Empty;
        _schemaVersion = _definition?.SchemaVersion ?? 1;
        _valueVersion = null;
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo(TryParsePath(out var logicalPath)
            ? ConfigurationUiRoutes.Value(DefinitionKey, logicalPath)
            : ConfigurationUiRoutes.Value(DefinitionKey));
    }

    private static ConfigurationNodeDefinition? ResolveNode(ConfigurationDefinition? definition, LogicalPath logicalPath)
    {
        if (definition is null)
        {
            return null;
        }

        var current = definition.Root;
        foreach (var segment in logicalPath.Segments)
        {
            current = segment switch
            {
                PropertySegment property => current.Children.FirstOrDefault(child =>
                    string.Equals(child.Name, property.Name, StringComparison.OrdinalIgnoreCase)),
                DictionaryKeySegment => current.DictionaryTemplate?.ValueTemplate,
                ListItemKeySegment or ListIndexSegment => current.ListTemplate?.ItemTemplate,
                _ => null
            };

            if (current is null)
            {
                return null;
            }
        }

        return current;
    }

    private ConfigurationReloadBehavior ResolveReloadBehavior(ConfigurationNodeDefinition node)
    {
        return node.ReloadBehavior is { } behavior and not ConfigurationReloadBehavior.Inherit
            ? behavior
            : _definition?.ReloadBehavior ?? ConfigurationReloadBehavior.OnlineReloadable;
    }

    private Severity ResolveReloadSeverity(ConfigurationNodeDefinition node)
    {
        return ResolveReloadBehavior(node) is ConfigurationReloadBehavior.RequiresRestart or ConfigurationReloadBehavior.StaticAfterStartup
            ? Severity.Warning
            : Severity.Info;
    }
}
