@attribute [Route(PAGE_URL)]
@inject ConfigurationFacade Facade
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationVersions:Title"]</PageTitle>

<div class="configuration-versions-page">
    <MudContainer MaxWidth="MaxWidth.False">
        <MudStack Spacing="3">
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">@L["Pages:ConfigurationVersions:Title"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Versions:Subtitle"]</MudText>
                </MudStack>
                <MudTooltip Text="@L["Common:Actions:Refresh"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" OnClick="LoadAsync" />
                </MudTooltip>
            </MudStack>

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_versions.Count == 0)
            {
                <MudAlert Severity="Severity.Info">@L["Versions:Empty"]</MudAlert>
            }
            else
            {
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="5" lg="4">
                        <MudStack Spacing="3">
                            @if (CurrentVersion is { } currentVersion)
                            {
                                <MudPaper Outlined="true" Class="pa-3 configuration-current-version-panel">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Primary" />
                                            <MudText Typo="Typo.subtitle1">@L["Versions:Current:Title"]</MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.h6">@VersionText(currentVersion)</MudText>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                            <MudTooltip Text="@DefinitionTooltip(currentVersion)">
                                                <MudChip T="int" Size="Size.Small" Variant="Variant.Outlined">
                                                    @L["Versions:Current:DefinitionCount", currentVersion.DefinitionCount]
                                                </MudChip>
                                            </MudTooltip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                @L["History:Dialog:Operator"]: @OperatorText(currentVersion)
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                @L["Group:Label"]: @ValueOrEmpty(currentVersion.MutationGroupId)
                                            </MudChip>
                                        </MudStack>
                                        @if (!string.IsNullOrWhiteSpace(currentVersion.Reason))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@currentVersion.Reason</MudText>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }

                            <MudPaper Outlined="true" Class="pa-3 configuration-version-history-panel">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <MudText Typo="Typo.subtitle1">@L["Versions:List:Title"]</MudText>
                                        <MudChip T="int" Size="Size.Small" Variant="Variant.Outlined">@HistoryVersions.Count</MudChip>
                                    </MudStack>

                                    @if (HistoryVersions.Count == 0)
                                    {
                                        <MudAlert Severity="Severity.Info">@L["Versions:List:Empty"]</MudAlert>
                                    }
                                    else
                                    {
                                        <div class="configuration-version-history-list">
                                            @foreach (var version in HistoryVersions)
                                            {
                                                <div class="@HistoryItemClass(version)" @onclick="() => SelectVersionAsync(version.Version)">
                                                    <MudStack Spacing="1">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                                            <MudStack Spacing="0">
                                                                <MudText Typo="Typo.subtitle2">@VersionText(version)</MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                    @L["Versions:List:ComparedToCurrent", CurrentVersionLabel]
                                                                </MudText>
                                                            </MudStack>
                                                            <div class="configuration-version-history-actions" @onclick:stopPropagation="true">
                                                                <MudTooltip Text="@L["Versions:Actions:CompareCurrent"]">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.CompareArrows"
                                                                                   Size="Size.Small"
                                                                                   Color="@(IsSelected(version) ? Color.Primary : Color.Default)"
                                                                                   OnClick="() => SelectVersionAsync(version.Version)" />
                                                                </MudTooltip>
                                                                <MudTooltip Text="@L["Rollback:Confirm"]">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                                                                   Size="Size.Small"
                                                                                   Color="Color.Warning"
                                                                                   OnClick="() => RollbackAsync(version)" />
                                                                </MudTooltip>
                                                            </div>
                                                        </MudStack>
                                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                                            <MudTooltip Text="@DefinitionTooltip(version)">
                                                                <MudChip T="int" Size="Size.Small" Variant="Variant.Outlined">
                                                                    @L["Versions:Current:DefinitionCount", version.DefinitionCount]
                                                                </MudChip>
                                                            </MudTooltip>
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                                @OperatorText(version)
                                                            </MudChip>
                                                            @if (!string.IsNullOrWhiteSpace(version.Reason))
                                                            {
                                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@version.Reason</MudChip>
                                                            }
                                                        </MudStack>
                                                    </MudStack>
                                                </div>
                                            }
                                        </div>
                                    }
                                </MudStack>
                            </MudPaper>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="7" lg="8">
                        <MudPaper Outlined="true" Class="pa-3 configuration-version-comparison-panel">
                            <MudStack Spacing="3">
                                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1">@ComparisonTitle</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Versions:Compare:CurrentOnly"]</MudText>
                                    </MudStack>
                                    @if (_selectedComparison is not null)
                                    {
                                        <MudChip T="int" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                            @L["Versions:Diff:ChangedDefinitions", _selectedComparison.Changes.Count]
                                        </MudChip>
                                    }
                                </MudStack>

                                @if (SelectedHistoryVersion is null)
                                {
                                    <MudAlert Severity="Severity.Info">@L["Versions:List:Empty"]</MudAlert>
                                }
                                else if (_comparisonLoading)
                                {
                                    <MudProgressLinear Indeterminate="true" />
                                }
                                else if (_selectedComparison is null)
                                {
                                    <MudAlert Severity="Severity.Warning">@L["Versions:Compare:Unavailable"]</MudAlert>
                                }
                                else
                                {
                                    <ConfigurationUnifiedVersionDiffPanel Comparison="_selectedComparison" ShowSummaryHeader="false" />
                                }
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
    </MudContainer>
</div>

@code {
    public const string PAGE_URL = ConfigurationUiRoutes.VERSIONS_ROUTE;

    private readonly List<ConfigurationUnifiedVersionSummary> _versions = [];
    private readonly Dictionary<long, ConfigurationUnifiedVersionComparison> _comparisonCache = new();
    private ConfigurationUnifiedVersionComparison? _selectedComparison;
    private long? _selectedHistoryVersion;
    private long _comparisonRequestId;
    private bool _loading = true;
    private bool _comparisonLoading;

    private ConfigurationUnifiedVersionSummary? CurrentVersion => _versions.FirstOrDefault();

    private IReadOnlyList<ConfigurationUnifiedVersionSummary> HistoryVersions =>
        _versions.Count <= 1 ? [] : _versions.Skip(1).ToArray();

    private ConfigurationUnifiedVersionSummary? SelectedHistoryVersion =>
        _selectedHistoryVersion is { } version
            ? _versions.FirstOrDefault(candidate => candidate.Version == version)
            : null;

    private string CurrentVersionLabel => CurrentVersion is { } current
        ? ConfigurationUnifiedVersionJsonFormatter.VersionLabel(current.Version)
        : L["Common:States:Empty"];

    private string ComparisonTitle =>
        CurrentVersion is { } current && SelectedHistoryVersion is { } selected
            ? L["Versions:Compare:AgainstCurrent", VersionText(selected), VersionText(current)]
            : L["Versions:Compare:NoSelection"];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _comparisonLoading = false;
        _selectedComparison = null;
        _comparisonCache.Clear();

        var result = await Facade.GetUnifiedVersionsAsync(limit: 200);
        if (result.IsFailed(out var error, out var versions))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            _versions.Clear();
            _selectedHistoryVersion = null;
        }
        else
        {
            _versions.Clear();
            _versions.AddRange(versions.OrderByDescending(static version => version.Version));
            SelectDefaultHistoryVersion();
        }

        _loading = false;

        if (_selectedHistoryVersion is { } selectedVersion)
        {
            await LoadComparisonAsync(selectedVersion);
        }
    }

    private void SelectDefaultHistoryVersion()
    {
        var current = CurrentVersion;
        if (current is null)
        {
            _selectedHistoryVersion = null;
            return;
        }

        if (_selectedHistoryVersion is { } selected
            && selected != current.Version
            && _versions.Any(version => version.Version == selected))
        {
            return;
        }

        _selectedHistoryVersion = HistoryVersions.FirstOrDefault()?.Version;
    }

    private async Task SelectVersionAsync(long version)
    {
        await LoadComparisonAsync(version);
    }

    private async Task LoadComparisonAsync(long historyVersion)
    {
        var current = CurrentVersion;
        if (current is null || historyVersion == current.Version)
        {
            _selectedHistoryVersion = null;
            _selectedComparison = null;
            return;
        }

        _selectedHistoryVersion = historyVersion;
        if (_comparisonCache.TryGetValue(historyVersion, out var cached)
            && cached.Target.Summary.Version == current.Version)
        {
            _selectedComparison = cached;
            _comparisonLoading = false;
            return;
        }

        var requestId = ++_comparisonRequestId;
        _comparisonLoading = true;
        _selectedComparison = null;

        try
        {
            var result = await Facade.CompareUnifiedVersionsAsync(historyVersion, current.Version);
            if (requestId != _comparisonRequestId)
            {
                return;
            }

            if (result.IsFailed(out var error, out var comparison))
            {
                Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
                return;
            }

            _comparisonCache[historyVersion] = comparison;
            _selectedComparison = comparison;
        }
        finally
        {
            if (requestId == _comparisonRequestId)
            {
                _comparisonLoading = false;
            }
        }
    }

    private async Task RollbackAsync(ConfigurationUnifiedVersionSummary version)
    {
        var parameters = new DialogParameters<ConfigurationUnifiedVersionRollbackDialog>();
        parameters.Add(dialog => dialog.Version, version.Version);
        var dialog = await DialogService.ShowAsync<ConfigurationUnifiedVersionRollbackDialog>(
            L["Versions:Rollback:Title", ConfigurationUnifiedVersionJsonFormatter.VersionLabel(version.Version)],
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ConfigurationUnifiedVersionRollbackResult })
        {
            Snackbar.Add(L["Rollback:Success"], Severity.Success);
            await LoadAsync();
        }
    }

    private bool IsSelected(ConfigurationUnifiedVersionSummary version)
    {
        return _selectedHistoryVersion == version.Version;
    }

    private string HistoryItemClass(ConfigurationUnifiedVersionSummary version)
    {
        return IsSelected(version)
            ? "configuration-version-history-item is-selected"
            : "configuration-version-history-item";
    }

    private string VersionText(ConfigurationUnifiedVersionSummary version)
    {
        return $"{ConfigurationUnifiedVersionJsonFormatter.VersionLabel(version.Version)} · {version.CreatedTime.ToLocalTime():yyyy-MM-dd HH:mm:ss}";
    }

    private string DefinitionTooltip(ConfigurationUnifiedVersionSummary version)
    {
        return version.DefinitionKeys.Count == 0
            ? L["Versions:Definitions:Empty"]
            : string.Join(Environment.NewLine, version.DefinitionKeys);
    }

    private string OperatorText(ConfigurationUnifiedVersionSummary version)
    {
        return !string.IsNullOrWhiteSpace(version.ModifierName)
            ? version.ModifierName!
            : !string.IsNullOrWhiteSpace(version.ModifierId)
                ? version.ModifierId!
                : L["Common:States:Empty"];
    }

    private string ValueOrEmpty(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? L["Common:States:Empty"] : value;
    }
}
