@attribute [Route(PAGE_URL)]
@inject ConfigurationVersionsPageState State
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationVersions:Title"]</PageTitle>

<div class="configuration-versions-page">
    <MudContainer MaxWidth="MaxWidth.False">
        <MudStack Spacing="3">
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">@L["Pages:ConfigurationVersions:Title"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Versions:Subtitle"]</MudText>
                </MudStack>
                <MudTooltip Text="@L["Common:Actions:Refresh"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Variant="Variant.Outlined"
                                   Disabled="@State.Loading"
                                   OnClick="State.LoadAsync"
                                   aria-label="@L["Common:Actions:Refresh"]" />
                </MudTooltip>
            </MudStack>

            @if (State.Loading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (!State.HasVersions)
            {
                <MudAlert Severity="Severity.Info">@L["Versions:Empty"]</MudAlert>
            }
            else
            {
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="5" lg="4">
                        <MudStack Spacing="3">
                            @if (State.CurrentVersion is { } currentVersion)
                            {
                                <ConfigurationUnifiedVersionCurrentPanel Version="currentVersion" />
                            }

                            <ConfigurationUnifiedVersionHistoryPanel Versions="State.HistoryVersions"
                                                                     CurrentVersionLabel="@State.CurrentVersionLabel"
                                                                     SelectedVersion="@State.SelectedHistoryVersion"
                                                                     PreviousComparisonVersion="@State.PreviousComparisonVersion"
                                                                     OnVersionSelected="State.SelectVersionAsync"
                                                                     OnComparePrevious="State.CompareWithPreviousAsync"
                                                                     OnRollback="RollbackAsync"
                                                                     OnDeleted="State.LoadAsync" />
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="7" lg="8">
                        <ConfigurationUnifiedVersionComparisonPanel Title="@State.ComparisonTitle"
                                                                    Subtitle="@State.ComparisonSubtitle"
                                                                    HasSelection="@State.HasSelectedHistoryVersion"
                                                                    Loading="@State.ComparisonLoading"
                                                                    Comparison="@State.SelectedComparison" />
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
    </MudContainer>
</div>

@code {
    public const string PAGE_URL = ConfigurationUiRoutes.VERSIONS_ROUTE;

    protected override async Task OnInitializedAsync()
    {
        await State.LoadAsync();
    }

    private async Task RollbackAsync(ConfigurationUnifiedVersionSummary version)
    {
        var parameters = new DialogParameters<ConfigurationUnifiedVersionRollbackDialog>();
        parameters.Add(dialog => dialog.Version, version.Version);
        var dialog = await DialogService.ShowAsync<ConfigurationUnifiedVersionRollbackDialog>(
            L["Versions:Rollback:Title", ConfigurationUnifiedVersionJsonFormatter.VersionLabel(version.Version)],
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ConfigurationUnifiedVersionRollbackResult rollback })
        {
            if (rollback.ApplyResult.Status == ConfigurationMutationGroupApplyStatus.PartiallyApplied)
            {
                Snackbar.Add(
                    L["Versions:Rollback:Messages:PartiallyApplied", rollback.MutationGroup.GroupId],
                    Severity.Error);
            }
            else if (rollback.ApplyResult.PostCommitIssues.Count > 0)
            {
                Snackbar.Add(
                    L["Versions:Rollback:Messages:AppliedWithIssues", rollback.MutationGroup.GroupId],
                    Severity.Warning);
            }
            else
            {
                Snackbar.Add(L["Rollback:Success"], Severity.Success);
            }

            if (rollback.ApplyResult.PostCommitIssues.Count > 0)
            {
                var issueParameters = new DialogParameters<ConfigurationPostCommitIssuesDialog>();
                issueParameters.Add(issueDialog => issueDialog.Issues, rollback.ApplyResult.PostCommitIssues);
                issueParameters.Add(
                    issueDialog => issueDialog.SummaryText,
                    L["Versions:Rollback:Messages:AppliedWithIssues", rollback.MutationGroup.GroupId].Value);
                var issuesDialog = await DialogService.ShowAsync<ConfigurationPostCommitIssuesDialog>(
                    L["Dialogs:PostCommitIssues:Title"],
                    issueParameters);
                await issuesDialog.Result;
            }

            await State.LoadAsync();
        }
    }
}
