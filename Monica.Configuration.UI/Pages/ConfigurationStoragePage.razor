@attribute [Route(PAGE_URL)]
@inject ConfigurationFacade Facade
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationStorage:Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="configuration-storage-page">
    <MudStack Spacing="3">
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">@L["Pages:ConfigurationStorage:Title"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Storage:Subtitle"]</MudText>
            </MudStack>
            <MudTooltip Text="@L["Common:Actions:Refresh"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" OnClick="LoadAsync" />
            </MudTooltip>
        </MudStack>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_overview is null)
        {
            <MudAlert Severity="Severity.Info">@L["Storage:Empty"]</MudAlert>
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">@L["Sources:Runtime:Title"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Sources:Runtime:Subtitle"]</MudText>
                        </MudStack>
                        <MudChip T="int" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">@_sourceInventories.Count</MudChip>
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(_sourceInventoryLoadError))
                    {
                        <MudAlert Severity="Severity.Error">@($"{L["Common:Errors:LoadFailed"]}: {_sourceInventoryLoadError}")</MudAlert>
                    }
                    else if (_sourceInventories.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">@L["Sources:Empty"]</MudAlert>
                    }
                    else
                    {
                        <MudExpansionPanels MultiExpansion="true" Elevation="0" Dense="true" Class="configuration-source-panels">
                            @foreach (var inventory in _sourceInventories)
                            {
                                <MudExpansionPanel Class="configuration-source-panel">
                                    <TitleContent>
                                        <div class="configuration-source-title">
                                            <MudChip T="int"
                                                     Size="Size.Small"
                                                     Color="Color.Default"
                                                     Variant="Variant.Outlined">
                                                @inventory.Source.PriorityIndex
                                            </MudChip>
                                            <div class="configuration-source-title-main">
                                                <MudText Typo="Typo.body2">@inventory.Source.DisplayName</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@SourcePath(inventory.Source)</MudText>
                                            </div>
                                            <div class="configuration-source-title-actions">
                                                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@inventory.Source.Kind</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                        @L["Sources:Inventory:SuppliedCount", inventory.SuppliedValueCount]
                                                    </MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                                        @L["Sources:Inventory:EffectiveCount", inventory.EffectiveValueCount]
                                                    </MudChip>
                                                    @if (inventory.ManagedValueCount > 0)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                            @L["Sources:Inventory:ManagedCount", inventory.ManagedValueCount]
                                                        </MudChip>
                                                    }
                                                    @if (inventory.UnmanagedValueCount > 0)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                                            @L["Sources:Inventory:UnmanagedCount", inventory.UnmanagedValueCount]
                                                        </MudChip>
                                                    }
                                                    <MudChip T="string" Size="Size.Small" Color="@(inventory.Source.IsWritable ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                                                        @(inventory.Source.IsWritable ? L["Sources:Writable"] : L["Sources:ReadOnly"])
                                                    </MudChip>
                                                    @if (inventory.Source.IsManagedByMonica)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">@L["Sources:Managed"]</MudChip>
                                                    }
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@ReloadText(inventory.Source)</MudChip>
                                                    @if (inventory.Source.Kind == ConfigurationSourceKind.JsonFile)
                                                    {
                                                        <MudTooltip Text="@L["Sources:Actions:ViewFile"]">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Article"
                                                                           Size="Size.Small"
                                                                           OnClick="() => ViewFileAsync(inventory.Source)" />
                                                        </MudTooltip>
                                                    }
                                                </MudStack>
                                            </div>
                                        </div>
                                    </TitleContent>
                                    <ChildContent>
                                        @if (inventory.Items.Count == 0)
                                        {
                                            <MudAlert Severity="Severity.Info">@L["Sources:Inventory:NoItems"]</MudAlert>
                                        }
                                        else
                                        {
                                            <div class="configuration-source-groups">
                                                @foreach (var group in SourceInventoryGroups(inventory))
                                                {
                                                    <div class="@SourceGroupClass(group)">
                                                        <MudPaper Outlined="true" Class="pa-3 configuration-source-group-card">
                                                            <MudStack Spacing="2">
                                                                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                                                    <MudStack Spacing="0">
                                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                            <MudText Typo="Typo.subtitle2">@group.Title</MudText>
                                                                            @if (group.UnmanagedCount > 0)
                                                                            {
                                                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                                                                    @L["Sources:Unmanaged"]
                                                                                </MudChip>
                                                                            }
                                                                            @if (group.EffectiveCount == group.Items.Count)
                                                                            {
                                                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                                                                    @L["Sources:Effective"]
                                                                                </MudChip>
                                                                            }
                                                                        </MudStack>
                                                                        @if (!string.IsNullOrWhiteSpace(group.Subtitle))
                                                                        {
                                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@group.Subtitle</MudText>
                                                                        }
                                                                    </MudStack>
                                                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
                                                                        <MudChip T="int" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                                            @L["Sources:Inventory:ItemCount", group.Items.Count]
                                                                        </MudChip>
                                                                        @if (group.EffectiveCount > 0 && group.EffectiveCount != group.Items.Count)
                                                                        {
                                                                            <MudChip T="int" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                                                                @L["Sources:Inventory:EffectiveCount", group.EffectiveCount]
                                                                            </MudChip>
                                                                        }
                                                                    </MudStack>
                                                                </MudStack>

                                                                <div class="configuration-source-value-grid" role="table">
                                                                    <div class="configuration-source-value-header" role="row">
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Sources:Inventory:FieldColumn"]</MudText>
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Sources:Inventory:ValueColumn"]</MudText>
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Sources:Inventory:StateColumn"]</MudText>
                                                                    </div>
                                                                    @foreach (var item in group.Items)
                                                                    {
                                                                        var overridingSource = OverridingSourceFor(item, inventory.Source);
                                                                        <div class="@SourceItemRowClass(item)" role="row">
                                                                            <div class="configuration-source-value-field" role="cell">
                                                                                <MudText Typo="Typo.body2">@FieldLabel(item)</MudText>
                                                                                <MudTooltip Text="@item.ConfigurationPath">
                                                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="configuration-source-value-path">
                                                                                        @item.RelativeConfigurationPath
                                                                                    </MudText>
                                                                                </MudTooltip>
                                                                            </div>
                                                                            <MudText Typo="Typo.body2" Class="configuration-source-value-content" role="cell">@DisplayValue(item)</MudText>
                                                                            <div class="configuration-source-value-state" role="cell">
                                                                                @if (item.IsEffective)
                                                                                {
                                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                                                                        @L["Sources:Effective"]
                                                                                    </MudChip>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <MudTooltip Placement="Placement.Left" Arrow="true">
                                                                                        <ChildContent>
                                                                                            <span class="configuration-source-overridden-state">
                                                                                                @L["Sources:Inventory:Overridden"]
                                                                                            </span>
                                                                                        </ChildContent>
                                                                                        <TooltipContent>
                                                                                            <div class="configuration-source-overridden-tooltip">
                                                                                                @OverriddenTooltip(overridingSource)
                                                                                            </div>
                                                                                        </TooltipContent>
                                                                                    </MudTooltip>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </MudStack>
                                                        </MudPaper>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </ChildContent>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                </MudStack>
            </MudPaper>

            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    @StoreCard(L["Storage:Roles:EffectiveValues"], _overview.EffectiveValueStore)
                </MudItem>
                <MudItem xs="12" md="4">
                    @StoreCard(L["Storage:Roles:History"], _overview.HistoryStore)
                </MudItem>
                <MudItem xs="12" md="4">
                    @StoreCard(L["Storage:Roles:Metadata"], _overview.MetadataStore)
                </MudItem>
            </MudGrid>

            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">@L["Storage:Notifications:Title"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Storage:Notifications:Subtitle"]</MudText>
                    </MudStack>
                    <MudChip T="string"
                             Color="@(_overview.HasChangeNotifier ? Color.Success : Color.Default)"
                             Variant="@(_overview.HasChangeNotifier ? Variant.Filled : Variant.Outlined)">
                        @(_overview.HasChangeNotifier ? L["Storage:Notifications:Registered"] : L["Storage:Notifications:NotRegistered"])
                    </MudChip>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    public const string PAGE_URL = ConfigurationUiRoutes.STORAGE_ROUTE;

    private readonly List<ConfigurationStoreState> _states = [];
    private readonly List<ConfigurationSourceInventory> _sourceInventories = [];
    private ConfigurationStorageOverview? _overview;
    private string? _sourceInventoryLoadError;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var overviewResult = await Facade.GetStorageOverviewAsync();
        if (overviewResult.IsFailed(out var overviewError, out var overview))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {overviewError.Message}", Severity.Error);
            _overview = null;
        }
        else
        {
            _overview = overview;
        }

        var stateResult = await Facade.GetStoreStatesAsync();
        if (!stateResult.IsFailed(out _, out var states))
        {
            _states.Clear();
            _states.AddRange(states);
        }

        var sourceResult = await Facade.GetConfigurationSourceInventoriesAsync();
        _sourceInventories.Clear();
        if (sourceResult.IsFailed(out var sourceError, out var sourceInventories))
        {
            _sourceInventoryLoadError = sourceError.Message;
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {sourceError.Message}", Severity.Error);
        }
        else
        {
            _sourceInventoryLoadError = null;
            _sourceInventories.AddRange(sourceInventories);
        }

        _loading = false;
    }

    private async Task ViewFileAsync(ConfigurationSourceDescriptor source)
    {
        var parameters = new DialogParameters<ConfigurationSourceFileDialog>();
        parameters.Add(dialog => dialog.SourceKey, source.SourceKey);
        await DialogService.ShowAsync<ConfigurationSourceFileDialog>(L["Sources:File:Title", source.DisplayName], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        });
    }

    private string SourcePath(ConfigurationSourceDescriptor source)
    {
        return source.PhysicalPath ?? source.SourcePath ?? source.ProviderType;
    }

    private string ReloadText(ConfigurationSourceDescriptor source)
    {
        return source.ReloadOnChange is null
            ? L["Sources:Reload:Unknown"]
            : source.ReloadOnChange.Value ? L["Sources:Reload:Enabled"] : L["Sources:Reload:Disabled"];
    }

    private IReadOnlyList<SourceInventoryGroup> SourceInventoryGroups(ConfigurationSourceInventory inventory)
    {
        return inventory.Items
            .GroupBy(SourceInventoryGroupKey)
            .Select(group =>
            {
                var items = group
                    .OrderBy(static item => item.RelativeConfigurationPath, StringComparer.OrdinalIgnoreCase)
                    .ToArray();
                return new SourceInventoryGroup(
                    GroupTitle(items[0]),
                    GroupSubtitle(items[0]),
                    items,
                    items.Count(static item => item.IsEffective),
                    items.Count(static item => !item.IsManagedByMonica));
            })
            .OrderBy(group => group.UnmanagedCount > 0 ? 1 : 0)
            .ThenBy(group => group.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private string SourceInventoryGroupKey(ConfigurationSourceInventoryItem item)
    {
        return item.IsManagedByMonica
            ? item.DefinitionKey ?? item.DefinitionDisplayName ?? item.ConfigurationPath
            : L["Sources:Inventory:UnmanagedDefinition"].Value;
    }

    private string GroupTitle(ConfigurationSourceInventoryItem item)
    {
        return item.IsManagedByMonica
            ? item.DefinitionDisplayName ?? L["Sources:Inventory:UnknownDefinition"]
            : L["Sources:Inventory:UnmanagedDefinition"];
    }

    private string GroupSubtitle(ConfigurationSourceInventoryItem item)
    {
        if (!item.IsManagedByMonica)
        {
            return L["Sources:Inventory:RuntimeKey"];
        }

        return item.DefinitionKey ?? string.Empty;
    }

    private string FieldLabel(ConfigurationSourceInventoryItem item)
    {
        return string.IsNullOrWhiteSpace(item.NodeLabel)
            ? item.RelativeConfigurationPath
            : item.NodeLabel!;
    }

    private string DisplayValue(ConfigurationSourceInventoryItem item)
    {
        return item.IsSensitive ? L["State:Value:Sensitive"] : item.DisplayValue ?? L["Value:States:Empty"];
    }

    private ConfigurationSourceDescriptor? OverridingSourceFor(
        ConfigurationSourceInventoryItem item,
        ConfigurationSourceDescriptor currentSource)
    {
        if (item.IsEffective)
        {
            return null;
        }

        return _sourceInventories
            .OrderByDescending(static inventory => inventory.Source.PriorityIndex)
            .FirstOrDefault(inventory =>
                !string.Equals(inventory.Source.SourceKey, currentSource.SourceKey, StringComparison.Ordinal)
                && inventory.Items.Any(candidate => candidate.IsEffective && HasSameConfigurationPath(candidate, item)))
            ?.Source;
    }

    private string OverriddenTooltip(ConfigurationSourceDescriptor? source)
    {
        return source is null
            ? L["Sources:Inventory:OverriddenUnknownTooltip"]
            : L["Sources:Inventory:OverriddenTooltip", source.DisplayName, source.PriorityIndex, SourcePath(source)];
    }

    private static bool HasSameConfigurationPath(
        ConfigurationSourceInventoryItem left,
        ConfigurationSourceInventoryItem right)
    {
        return string.Equals(left.ConfigurationPath, right.ConfigurationPath, StringComparison.OrdinalIgnoreCase);
    }

    private static string SourceGroupClass(SourceInventoryGroup group)
    {
        return group.EffectiveCount == group.Items.Count
            ? "configuration-source-group effective-source"
            : "configuration-source-group";
    }

    private static string SourceItemRowClass(ConfigurationSourceInventoryItem item)
    {
        return item.IsEffective ? "configuration-source-value-row effective-source" : "configuration-source-value-row";
    }

    private sealed record SourceInventoryGroup(
        string Title,
        string Subtitle,
        IReadOnlyList<ConfigurationSourceInventoryItem> Items,
        int EffectiveCount,
        int UnmanagedCount);

    private RenderFragment StoreCard(string role, ConfigurationStoreDescriptor store) => builder =>
    {
        var state = _states.FirstOrDefault(candidate =>
            string.Equals(candidate.StoreKey, store.StoreKey, StringComparison.OrdinalIgnoreCase));

        builder.OpenComponent<MudPaper>(0);
        builder.AddAttribute(1, "Outlined", true);
        builder.AddAttribute(2, "Class", "pa-3 storage-card");
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenComponent<MudStack>(4);
            content.AddAttribute(5, "Spacing", 2);
            content.AddAttribute(6, "ChildContent", (RenderFragment)(stack =>
            {
                stack.OpenComponent<MudText>(7);
                stack.AddAttribute(8, "Typo", Typo.overline);
                stack.AddAttribute(9, "Color", Color.Secondary);
                stack.AddAttribute(10, "ChildContent", (RenderFragment)(child => child.AddContent(11, role)));
                stack.CloseComponent();

                stack.OpenComponent<MudText>(12);
                stack.AddAttribute(13, "Typo", Typo.subtitle2);
                stack.AddAttribute(14, "ChildContent", (RenderFragment)(child => child.AddContent(15, store.DisplayName)));
                stack.CloseComponent();

                stack.OpenComponent<MudText>(16);
                stack.AddAttribute(17, "Typo", Typo.caption);
                stack.AddAttribute(18, "Color", Color.Secondary);
                stack.AddAttribute(19, "ChildContent", (RenderFragment)(child => child.AddContent(20, store.StoreKey)));
                stack.CloseComponent();

                stack.AddContent(21, CapabilityChips(store));
                stack.AddContent(22, StoreState(state));
            }));
            content.CloseComponent();
        }));
        builder.CloseComponent();
    };

    private RenderFragment CapabilityChips(ConfigurationStoreDescriptor store) => builder =>
    {
        builder.OpenComponent<MudStack>(0);
        builder.AddAttribute(1, "Row", true);
        builder.AddAttribute(2, "Wrap", Wrap.Wrap);
        builder.AddAttribute(3, "Spacing", 1);
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(content =>
        {
            content.AddContent(5, CapabilityChip(store.SupportsEffectiveValues, L["Storage:Capabilities:EffectiveValues"]));
            content.AddContent(6, CapabilityChip(store.SupportsHistory, L["Storage:Capabilities:History"]));
            content.AddContent(7, CapabilityChip(store.SupportsMetadata, L["Storage:Capabilities:Metadata"]));
        }));
        builder.CloseComponent();
    };

    private RenderFragment CapabilityChip(bool enabled, string label) => builder =>
    {
        builder.OpenComponent<MudChip<string>>(0);
        builder.AddAttribute(1, "Size", Size.Small);
        builder.AddAttribute(2, "Color", enabled ? Color.Success : Color.Default);
        builder.AddAttribute(3, "Variant", enabled ? Variant.Filled : Variant.Outlined);
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(child => child.AddContent(5, label)));
        builder.CloseComponent();
    };

    private RenderFragment StoreState(ConfigurationStoreState? state) => builder =>
    {
        if (state is null)
        {
            builder.OpenComponent<MudText>(0);
            builder.AddAttribute(1, "Typo", Typo.caption);
            builder.AddAttribute(2, "Color", Color.Secondary);
            builder.AddAttribute(3, "ChildContent", (RenderFragment)(child => child.AddContent(4, L["Storage:State:Unknown"])));
            builder.CloseComponent();
            return;
        }

        builder.OpenComponent<MudStack>(5);
        builder.AddAttribute(6, "Row", true);
        builder.AddAttribute(7, "AlignItems", AlignItems.Center);
        builder.AddAttribute(8, "Spacing", 1);
        builder.AddAttribute(9, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenComponent<MudChip<string>>(10);
            content.AddAttribute(11, "Size", Size.Small);
            content.AddAttribute(12, "Color", state.LastOperationSucceeded ? Color.Success : Color.Error);
            content.AddAttribute(13, "Variant", Variant.Filled);
            content.AddAttribute(14, "ChildContent", (RenderFragment)(child =>
                child.AddContent(15, state.LastOperationSucceeded ? L["Storage:State:Succeeded"] : L["Storage:State:Failed"])));
            content.CloseComponent();

            content.OpenComponent<MudText>(16);
            content.AddAttribute(17, "Typo", Typo.caption);
            content.AddAttribute(18, "Color", Color.Secondary);
            content.AddAttribute(19, "ChildContent", (RenderFragment)(child =>
                child.AddContent(20, state.LastOperationTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))));
            content.CloseComponent();
        }));
        builder.CloseComponent();
    };
}
