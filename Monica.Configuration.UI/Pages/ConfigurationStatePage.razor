    private async Task OpenSelectedDefinitionJsonEditAsync()
    {
        if (_selectedDefinition is null)
        {
            return;
        }

        try
        {
            var effectiveValue = await PackageService.LoadEffectiveValueAsync(_selectedDefinition.DefinitionKey, LogicalPath.Root);
            var scalarValues = await PackageService.LoadScalarEffectiveValuesAsync(_selectedDefinition);
            var parameters = new DialogParameters<ConfigurationJsonEditDialog>();
            parameters.Add(dialog => dialog.Definition, _selectedDefinition);
            parameters.Add(dialog => dialog.Node, _selectedDefinition.Root);
            parameters.Add(dialog => dialog.EffectiveValue, effectiveValue);
            parameters.Add(dialog => dialog.ScalarEffectiveValues, scalarValues);
            parameters.Add(dialog => dialog.PendingChanges, StateStore.GetPending());
            parameters.Add(dialog => dialog.CompactChanges, false);
            var dialog = await DialogService.ShowAsync<ConfigurationJsonEditDialog>(L["ImportExport:JsonEditor:Title"], parameters, new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true
            });
            var result = await dialog.Result;
            if (result is { Canceled: false, Data: ConfigurationJsonDraftResult draft })
            {
                StateStore.ReplaceScope(_selectedDefinition.DefinitionKey, LogicalPath.Root, draft.Changes, draft.ValidationIssues);
                await RefreshPendingCount();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {ex.Message}", Severity.Error);
        }
    }

