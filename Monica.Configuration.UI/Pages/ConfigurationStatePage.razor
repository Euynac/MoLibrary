@attribute [Route(PAGE_URL)]
@implements IDisposable
@inject ConfigurationFacade Facade
@inject ConfigurationStateStore StateStore
@inject ConfigurationParameterPackageService PackageService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationState:Title"]</PageTitle>

<div class="configuration-state-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="configuration-state-container">
        <MudStack Spacing="3" Class="configuration-state-layout">
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="configuration-state-header">
                <MudStack Spacing="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="configuration-state-title-row">
                        <MudText Typo="Typo.h4">@L["Pages:ConfigurationState:Title"]</MudText>
                        @if (!_loadingDefinitions)
                        {
                            <span class="configuration-runtime-validation-anchor">
                                <MudTooltip Text="@RuntimeValidationStatusTooltip">
                                    <MudBadge Content="@RuntimeValidationIssueCount"
                                              Color="@RuntimeValidationStatusColor"
                                              Visible="@(RuntimeValidationIssueCount > 0)"
                                              Overlap="true">
                                        <MudIconButton Icon="@RuntimeValidationStatusIcon"
                                                       Color="@RuntimeValidationStatusColor"
                                                       Size="Size.Small"
                                                       OnClick="ToggleRuntimeValidationPopover"
                                                       aria-label="@L["State:RuntimeValidation:OpenDetails"]" />
                                    </MudBadge>
                                </MudTooltip>

                                <MudPopover Open="@_runtimeValidationPopoverOpen"
                                            AnchorOrigin="Origin.BottomLeft"
                                            TransformOrigin="Origin.TopLeft"
                                            Class="configuration-runtime-validation-popover"
                                            Paper="false">
                                    <MudPaper Elevation="6" Class="pa-3 configuration-runtime-validation-popover-content">
                                        <MudStack Spacing="2">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudIcon Icon="@RuntimeValidationStatusIcon"
                                                             Color="@RuntimeValidationStatusColor" />
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.subtitle1">@L["State:RuntimeValidation:Title"]</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@RuntimeValidationSummary</MudText>
                                                    </MudStack>
                                                </MudStack>
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudChip T="int"
                                                             Size="Size.Small"
                                                             Color="@RuntimeValidationStatusColor"
                                                             Variant="Variant.Outlined">
                                                        @RuntimeValidationIssueCount
                                                    </MudChip>
                                                    <MudTooltip Text="@L["Common:Actions:Close"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                       Size="Size.Small"
                                                                       OnClick="CloseRuntimeValidationPopover"
                                                                       aria-label="@L["Common:Actions:Close"]" />
                                                    </MudTooltip>
                                                </MudStack>
                                            </MudStack>

                                            @if (_runtimeValidationReport is null)
                                            {
                                                <MudAlert Severity="Severity.Warning">@L["State:RuntimeValidation:Unavailable"]</MudAlert>
                                            }
                                            else if (_runtimeValidationReport.IsValid)
                                            {
                                                <MudAlert Severity="Severity.Success">@L["State:RuntimeValidation:Valid"]</MudAlert>
                                            }
                                            else
                                            {
                                                <ConfigurationValidationIssueList Issues="@RuntimeValidationIssues"
                                                                                  ShowRuntimeMetadata="true"
                                                                                  ShowSourceChain="true"
                                                                                  ValueLabel="@L["State:RuntimeValidation:CurrentValue"].Value"
                                                                                  ReasonLabel="@L["State:RuntimeValidation:Problem"].Value"
                                                                                  JumpRequested="JumpToRuntimeValidationIssueAsync"
                                                                                  SourceChainRequested="OpenRuntimeIssueSourceChainAsync" />
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </MudPopover>
                                <MudOverlay Visible="@_runtimeValidationPopoverOpen"
                                            AutoClose="true"
                                            OnClosed="CloseRuntimeValidationPopover"
                                            LockScroll="false"
                                            Modal="false" />
                            </span>
                        }
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["State:Subtitle"]</MudText>
                </MudStack>
                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.UploadFile"
                               OnClick="OpenImportDialog">
                        @L["Common:Actions:Import"]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="() => OpenExportDialog(null, null)">
                        @L["Common:Actions:Export"]
                    </MudButton>
                    <MudTooltip Text="@L["Common:Actions:Refresh"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Variant="Variant.Outlined"
                                       OnClick="LoadDefinitionsAsync" />
                    </MudTooltip>
                </MudStack>
            </MudStack>

            @if (_loadingDefinitions)
            {
                <MudPaper Outlined="true" Class="pa-6 configuration-loading">
                    <MudProgressCircular Indeterminate="true" />
                    <MudText>@L["Common:States:Loading"]</MudText>
                </MudPaper>
            }
            else
            {
                <MudGrid Spacing="3" Class="configuration-state-grid">
                    <MudItem xs="12" md="3" Class="configuration-state-left">
                        <ConfigurationDefinitionList Definitions="@_definitions"
                                                     SelectedDefinition="@_selectedSummary"
                                                     SelectedDefinitionChanged="SelectDefinitionAsync"
                                                     NodeSearchMatches="@NodeSearchMatches"
                                                     NodeSearchMatchSelected="SelectSearchMatchAsync"
                                                     SearchText="@_searchText"
                                                     SearchTextChanged="OnSearchChanged"
                                                     PendingCountsByDefinition="@PendingCountsByDefinition"
                                                     RuntimeValidationCountsByDefinition="@RuntimeValidationCountsByDefinition"
                                                     PendingCount="@_pendingCount"
                                                     ValidationIssueCount="@_validationIssueCount"
                                                     RuntimeValidationIssueCount="@RuntimeValidationIssueCount"
                                                     SaveGroup="OpenSaveGroupDialog"
                                                     UndoAll="UndoAll" />
                    </MudItem>

                    <MudItem xs="12" md="9" Class="configuration-state-right">
                        @if (_selectedDefinition is null)
                        {
                            <MudAlert Severity="Severity.Info">@L["State:Definitions:SelectPrompt"]</MudAlert>
                        }
                        else
                        {
                            <MudPaper Outlined="true" Class="pa-3 configuration-definition-shell">
                                <MudStack Spacing="3" Class="configuration-definition-content">
                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <MudStack Spacing="0">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudText Typo="Typo.h5">@_selectedDefinition.DisplayName</MudText>
                                                @if (!string.IsNullOrWhiteSpace(_selectedDefinition.Description))
                                                {
                                                    <MudTooltip Text="@_selectedDefinition.Description">
                                                        <span class="configuration-description-icon">
                                                            <MudIcon Icon="@Icons.Material.Filled.Info"
                                                                     Size="Size.Small"
                                                                     Color="Color.Info" />
                                                        </span>
                                                    </MudTooltip>
                                                }
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@_selectedDefinition.DefinitionKey</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1" Class="configuration-definition-meta-actions">
                                            @if (!string.IsNullOrWhiteSpace(_selectedDefinition.Category))
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_selectedDefinition.Category</MudChip>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(_selectedDefinition.FromProject))
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_selectedDefinition.FromProject</MudChip>
                                            }
                                            @if (_selectedDefinition.Origin == ConfigurationDefinitionOrigin.PublishedMetadata)
                                            {
                                                <MudTooltip Text="@L["State:Definitions:PublishedMetadataTooltip"]">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                        @L["State:Definitions:PublishedMetadata"]
                                                    </MudChip>
                                                </MudTooltip>
                                            }
                                            <ConfigurationSchemaMetadataChip SchemaVersion="@_selectedDefinition.SchemaVersion"
                                                                             SchemaHash="@_selectedDefinition.SchemaHash"
                                                                             OnClick="OpenSelectedDefinitionPublishHistoryAsync" />
                                            <MudTooltip Text="@ReloadBehaviorDescription(_selectedDefinition.ReloadBehavior)">
                                                <MudChip T="string"
                                                         Size="Size.Small"
                                                         Color="@ReloadBehaviorColor(_selectedDefinition.ReloadBehavior)"
                                                         Variant="Variant.Outlined">
                                                    @ReloadBehaviorLabel(_selectedDefinition.ReloadBehavior)
                                                </MudChip>
                                            </MudTooltip>
                                            <MudTooltip Text="@L["Common:Actions:EditJson"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.DataObject"
                                                               Size="Size.Small"
                                                               Variant="Variant.Outlined"
                                                               OnClick="OpenSelectedDefinitionJsonEditAsync" />
                                            </MudTooltip>
                                            <MudTooltip Text="@L["History:Actions:ViewDefinitionHistory"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.History"
                                                               Size="Size.Small"
                                                               Variant="Variant.Outlined"
                                                               OnClick="OpenSelectedDefinitionHistoryAsync" />
                                            </MudTooltip>
                                            <MudTooltip Text="@L["ImportExport:Export:DefinitionAction"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                               Size="Size.Small"
                                                               Variant="Variant.Outlined"
                                                               OnClick="() => OpenExportDialog(_selectedDefinition.DefinitionKey, _selectedDefinition.DisplayName)" />
                                            </MudTooltip>
                                            @if (CanInspectSelectedDefinitionSources)
                                            {
                                                <MudTooltip Text="@L["Sources:Definition:Title"]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                                                   Size="Size.Small"
                                                                   Variant="Variant.Outlined"
                                                                   OnClick="OpenDefinitionSourcesAsync" />
                                                </MudTooltip>
                                            }
                                        </MudStack>
                                    </MudStack>

                                    @if (_loadingDefinition)
                                    {
                                        <MudProgressLinear Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <MudGrid Spacing="3" Class="configuration-detail-grid">
                                            <MudItem xs="12" lg="4" Class="configuration-detail-left">
                                                <MudPaper Outlined="true" Class="pa-3 configuration-section-panel">
                                                    <MudText Typo="Typo.subtitle2" Class="mb-2">@L["State:Sections:Title"]</MudText>
                                                    <div class="configuration-section-list">
                                                        @foreach (var sectionItem in SectionItems)
                                                        {
                                                            var isSelectedSection = IsSelectedNode(sectionItem.Node);
                                                            <MudButton Variant="@(isSelectedSection ? Variant.Filled : Variant.Text)"
                                                                       Color="@(isSelectedSection ? Color.Primary : Color.Default)"
                                                                       StartIcon="@sectionItem.Icon"
                                                                       FullWidth="true"
                                                                       Class="configuration-section-button"
                                                                       OnClick="() => OnSelectedNodeChanged(sectionItem.Node)">
                                                                <MudStack Spacing="1" AlignItems="AlignItems.Start" Class="configuration-section-content">
                                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1" Class="configuration-section-title-row">
                                                                        <MudText Typo="Typo.body2">
                                                                            <MudHighlighter Text="@sectionItem.Title" HighlightedTexts="@SearchTerms" />
                                                                        </MudText>
                                                                        <MudChip T="int" Size="Size.Small" Variant="Variant.Outlined">@sectionItem.ScalarCount</MudChip>
                                                                    </MudStack>
                                                                    <MudText Typo="Typo.caption" Color="@(isSelectedSection ? Color.Inherit : Color.Secondary)">@sectionItem.PathLabel</MudText>
                                                                    @if (!string.IsNullOrWhiteSpace(sectionItem.Description))
                                                                    {
                                                                        <MudText Typo="Typo.caption" Color="@(isSelectedSection ? Color.Inherit : Color.Secondary)">@sectionItem.Description</MudText>
                                                                    }
                                                                </MudStack>
                                                            </MudButton>
                                                        }
                                                    </div>
                                                </MudPaper>
                                            </MudItem>

                                            <MudItem xs="12" lg="8" Class="configuration-detail-right">
                                                <MudStack Spacing="2" Class="configuration-values-panel">
                                                    @foreach (var node in VisibleNodes)
                                                    {
                                                        <ConfigurationValueRow Definition="@_selectedDefinition"
                                                                               Node="@node"
                                                                               EffectiveValue="@GetEffectiveValue(node)"
                                                                               HighlightedPath="@_highlightedPath"
                                                                               Changed="RefreshPendingCount"
                                                                               CommittedChanged="ReloadSelectedEffectiveValuesAndValidationAsync" />
                                                    }
                                                </MudStack>
                                            </MudItem>
                                        </MudGrid>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
    </MudContainer>
</div>

@code {
    public const string PAGE_URL = ConfigurationUiRoutes.STATE_ROUTE;

    private readonly List<ConfigurationDefinitionSummary> _definitions = [];
    private readonly Dictionary<string, ConfigurationDefinition> _definitionDetails = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<LogicalPath, ConfigurationEffectiveValue> _effectiveValues = [];
    private ConfigurationDefinitionSummary? _selectedSummary;
    private ConfigurationDefinition? _selectedDefinition;
    private ConfigurationNodeDefinition? _selectedNode;
    private string _searchText = string.Empty;
    private bool _loadingDefinitions = true;
    private bool _loadingDefinition;
    private int _pendingCount;
    private int _validationIssueCount;
    private string? _requestedDefinitionKey;
    private LogicalPath? _requestedPath;
    private LogicalPath? _highlightedPath;
    private ConfigurationValidationReport? _runtimeValidationReport;
    private bool _runtimeValidationPopoverOpen;

    private bool CanInspectSelectedDefinitionSources =>
        _selectedDefinition?.Origin == ConfigurationDefinitionOrigin.LocalScan;

    private string ReloadBehaviorLabel(ConfigurationReloadBehavior behavior)
    {
        return ConfigurationReloadBehaviorFormatter.Label(behavior, L);
    }

    private string ReloadBehaviorDescription(ConfigurationReloadBehavior behavior)
    {
        return ConfigurationReloadBehaviorFormatter.Description(behavior, L);
    }

    private static Color ReloadBehaviorColor(ConfigurationReloadBehavior behavior)
    {
        return behavior.RequiresProcessRestart() ? Color.Warning : Color.Info;
    }

    private IReadOnlyList<string> SearchTerms => string.IsNullOrWhiteSpace(_searchText)
        ? []
        : _searchText
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyDictionary<string, IReadOnlyList<ConfigurationNodeSearchMatch>> NodeSearchMatches =>
        string.IsNullOrWhiteSpace(_searchText)
            ? new Dictionary<string, IReadOnlyList<ConfigurationNodeSearchMatch>>(StringComparer.OrdinalIgnoreCase)
            : BuildNodeSearchMatches();

    private IReadOnlyDictionary<string, int> PendingCountsByDefinition =>
        StateStore.GetPending()
            .GroupBy(change => change.DefinitionKey, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);

    private IReadOnlyDictionary<string, int> RuntimeValidationCountsByDefinition =>
        _runtimeValidationReport?.Issues
            .GroupBy(issue => issue.DefinitionKey, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase)
        ?? new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

    private int RuntimeValidationIssueCount => _runtimeValidationReport?.IssueCount ?? 0;

    private Color RuntimeValidationStatusColor =>
        _runtimeValidationReport is null
            ? Color.Warning
            : RuntimeValidationIssueCount == 0
                ? Color.Success
                : Color.Error;

    private string RuntimeValidationStatusIcon =>
        _runtimeValidationReport is null
            ? Icons.Material.Filled.Help
            : RuntimeValidationIssueCount == 0
                ? Icons.Material.Filled.CheckCircle
                : Icons.Material.Filled.Error;

    private string RuntimeValidationStatusTooltip =>
        $"{L["State:RuntimeValidation:Title"]}: {RuntimeValidationSummary}";

    private string RuntimeValidationSummary =>
        _runtimeValidationReport is null
            ? L["State:RuntimeValidation:Unavailable"].Value
            : RuntimeValidationIssueCount == 0
                ? L["State:RuntimeValidation:ValidSummary"].Value
                : L["State:RuntimeValidation:InvalidSummary", RuntimeValidationIssueCount, RuntimeValidationCountsByDefinition.Count].Value;

    private IReadOnlyList<ConfigurationValidationIssue> RuntimeValidationIssues =>
        _runtimeValidationReport?.Issues.Select(ToUiValidationIssue).ToArray() ?? [];

    private IReadOnlyList<ConfigurationSectionItem> SectionItems =>
        _selectedDefinition is null
            ? []
            : EnumerateSectionNodes(_selectedDefinition.Root)
                .Select(BuildSectionItem)
                .ToArray();

    private IEnumerable<ConfigurationNodeDefinition> VisibleNodes
    {
        get
        {
            if (_selectedNode is null)
            {
                return [];
            }

            if (IsSimpleEditableNode(_selectedNode))
            {
                return [_selectedNode];
            }

            if (_selectedNode.RelativePath.Depth == 0)
            {
                var rootItems = EnumerateNodes(_selectedNode)
                    .Where(node => node.RelativePath.Depth > 0
                                   && (IsSimpleEditableNode(node) || IsComplexNodeItem(node)))
                    .ToArray();
                return rootItems.Length == 0 ? [_selectedNode] : rootItems;
            }

            var leaves = EnumerateNodes(_selectedNode).Where(IsSimpleEditableNode).ToArray();
            return leaves.Length == 0 ? [_selectedNode] : leaves;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ReadRouteTarget();
        StateStore.Changed += OnStateStoreChanged;
        await LoadDefinitionsAsync();
    }

    public void Dispose()
    {
        StateStore.Changed -= OnStateStoreChanged;
    }

    private async Task LoadDefinitionsAsync()
    {
        _loadingDefinitions = true;
        var result = await Facade.GetDefinitionsAsync();
        if (result.IsFailed(out var error, out var definitions))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            _definitions.Clear();
            _runtimeValidationReport = null;
            _loadingDefinitions = false;
            return;
        }

        _definitions.Clear();
        _definitions.AddRange(definitions);
        _definitionDetails.Clear();
        await LoadRuntimeValidationReportAsync();
        _loadingDefinitions = false;

        if (_selectedSummary is null && _definitions.Count > 0)
        {
            var initialSummary = ResolveRequestedDefinitionSummary() ?? _definitions[0];
            await SelectDefinitionAsync(initialSummary);
            ApplyRequestedPath();
        }
    }

    private async Task LoadRuntimeValidationReportAsync()
    {
        var result = await Facade.GetRuntimeValidationReportAsync();
        if (result.IsFailed(out var error, out var report))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            _runtimeValidationReport = null;
            CloseRuntimeValidationPopover();
            return;
        }

        _runtimeValidationReport = report;
    }

    private void ToggleRuntimeValidationPopover()
    {
        _runtimeValidationPopoverOpen = !_runtimeValidationPopoverOpen;
    }

    private void CloseRuntimeValidationPopover()
    {
        _runtimeValidationPopoverOpen = false;
    }

    private static ConfigurationValidationIssue ToUiValidationIssue(ConfigurationRuntimeValidationIssue issue)
    {
        return new ConfigurationValidationIssue
        {
            DefinitionKey = issue.DefinitionKey,
            DefinitionDisplayName = issue.DefinitionDisplayName,
            LogicalPath = issue.LogicalPath,
            NodeDisplayName = issue.NodeDisplayName,
            InvalidDisplayValue = issue.EffectiveDisplayValue,
            ConfigurationPath = issue.ConfigurationPath,
            ValidationError = issue.Problem,
            EffectiveSource = issue.EffectiveSource,
            IsMissing = issue.IsMissing,
            IsSensitive = issue.IsSensitive,
            ValidationRules = issue.ValidationRules
        };
    }

    private void ReadRouteTarget()
    {
        _requestedDefinitionKey = ConfigurationUiRoutes.ReadDefinitionKey(NavigationManager.Uri);
        try
        {
            var requestedPath = ConfigurationUiRoutes.ReadPath(NavigationManager.Uri);
            _requestedPath = requestedPath.Depth == 0 ? null : requestedPath;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Common:Errors:InvalidPath"]}: {ex.Message}", Severity.Error);
        }
    }

    private ConfigurationDefinitionSummary? ResolveRequestedDefinitionSummary()
    {
        return string.IsNullOrWhiteSpace(_requestedDefinitionKey)
            ? null
            : _definitions.FirstOrDefault(definition =>
                string.Equals(definition.DefinitionKey, _requestedDefinitionKey, StringComparison.OrdinalIgnoreCase));
    }

    private void ApplyRequestedPath()
    {
        if (_requestedPath is not null)
        {
            JumpToCurrentDefinitionPath(_requestedPath);
        }

        _requestedPath = null;
        _requestedDefinitionKey = null;
    }

    private async Task SelectDefinitionAsync(ConfigurationDefinitionSummary summary)
    {
        _selectedSummary = summary;
        _loadingDefinition = true;
        _effectiveValues.Clear();
        try
        {
            var result = await LoadDefinitionDetailAsync(summary.DefinitionKey);
            if (result.IsFailed(out var error, out var detail))
            {
                Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
                _selectedDefinition = null;
                _selectedNode = null;
                return;
            }

            _selectedDefinition = detail.Definition;
            _selectedNode = _selectedDefinition.Root;
            _highlightedPath = null;
            await LoadEffectiveValuesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {ex.Message}", Severity.Error);
            _selectedDefinition = null;
            _selectedNode = null;
        }
        finally
        {
            _loadingDefinition = false;
        }
    }

    private async Task LoadEffectiveValuesAsync()
    {
        if (_selectedDefinition is null)
        {
            return;
        }

        foreach (var node in EnumerateNodes(_selectedDefinition.Root).Where(IsSimpleEditableNode))
        {
            var result = await Facade.GetEffectiveValueAsync(_selectedDefinition.DefinitionKey, node.RelativePath);
            if (!result.IsFailed(out _, out var effectiveValue))
            {
                _effectiveValues[node.RelativePath] = effectiveValue;
            }
        }
    }

    private async Task ReloadSelectedEffectiveValuesAndValidationAsync()
    {
        await LoadEffectiveValuesAsync();
        await LoadRuntimeValidationReportAsync();
    }

    private ConfigurationEffectiveValue? GetEffectiveValue(ConfigurationNodeDefinition node)
    {
        return _effectiveValues.GetValueOrDefault(node.RelativePath);
    }

    private async Task<Res<ConfigurationDefinitionDetail>> LoadDefinitionDetailAsync(string definitionKey)
    {
        if (_definitionDetails.TryGetValue(definitionKey, out var cachedDefinition))
        {
            return Res.Ok(new ConfigurationDefinitionDetail
            {
                Definition = cachedDefinition
            });
        }

        var result = await Facade.GetDefinitionAsync(definitionKey);
        if (!result.IsFailed(out _, out var detail))
        {
            _definitionDetails[definitionKey] = detail.Definition;
        }

        return result;
    }

    private static IEnumerable<ConfigurationNodeDefinition> EnumerateNodes(ConfigurationNodeDefinition node)
    {
        yield return node;
        foreach (var child in node.Children)
        {
            foreach (var descendant in EnumerateNodes(child))
            {
                yield return descendant;
            }
        }
    }

    private IReadOnlyDictionary<string, IReadOnlyList<ConfigurationNodeSearchMatch>> BuildNodeSearchMatches()
    {
        return _definitionDetails.Values
            .Select(definition => new
            {
                definition.DefinitionKey,
                Matches = EnumerateNodes(definition.Root)
                    .Where(node => node.RelativePath.Depth > 0 && IsNodeSearchMatch(node))
                    .Select(node => new ConfigurationNodeSearchMatch
                    {
                        DefinitionKey = definition.DefinitionKey,
                        Node = node,
                        DisplayName = GetNodeLabel(node),
                        PathLabel = node.RelativePath.ToCanonicalString(),
                        Description = node.Description
                    })
                    .ToArray()
            })
            .Where(group => group.Matches.Length > 0)
            .ToDictionary(group => group.DefinitionKey, group => (IReadOnlyList<ConfigurationNodeSearchMatch>)group.Matches, StringComparer.OrdinalIgnoreCase);
    }

    private bool IsNodeSearchMatch(ConfigurationNodeDefinition node)
    {
        return SearchTerms.Count > 0
               && (ContainsAnySearchTerm(node.Name)
                   || ContainsAnySearchTerm(node.DisplayName)
                   || ContainsAnySearchTerm(node.Description)
                   || ContainsAnySearchTerm(node.RelativePath.ToCanonicalString()));
    }

    private bool ContainsAnySearchTerm(string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
               && SearchTerms.Any(term => value.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<ConfigurationNodeDefinition> EnumerateSectionNodes(ConfigurationNodeDefinition root)
    {
        yield return root;
        foreach (var node in EnumerateNodes(root).Where(node => node.RelativePath.Depth > 0 && !IsSimpleEditableNode(node)))
        {
            yield return node;
        }
    }

    private ConfigurationSectionItem BuildSectionItem(ConfigurationNodeDefinition node)
    {
        var isRoot = node.RelativePath.Depth == 0;
        var scalarCount = EnumerateNodes(node).Count(IsSimpleEditableNode);
        return new ConfigurationSectionItem(
            node,
            GetNodeLabel(node),
            isRoot ? L["State:Sections:RootDescription"].Value : node.Description,
            isRoot ? L["State:Tree:Root"].Value : node.RelativePath.ToCanonicalString(),
            SectionIcon(node),
            scalarCount);
    }

    private string GetNodeLabel(ConfigurationNodeDefinition node)
    {
        if (node.RelativePath.Depth == 0)
        {
            return L["State:Tree:Root"];
        }

        if (string.IsNullOrWhiteSpace(node.DisplayName)
            || string.Equals(node.DisplayName, node.Name, StringComparison.OrdinalIgnoreCase))
        {
            return node.Name;
        }

        return node.DisplayName!;
    }

    private static string SectionIcon(ConfigurationNodeDefinition node)
    {
        return node.NodeKind switch
        {
            ConfigurationNodeKind.Dictionary => Icons.Material.Filled.DataObject,
            ConfigurationNodeKind.List => Icons.Material.Filled.FormatListBulleted,
            _ when node.RelativePath.Depth == 0 => Icons.Material.Filled.Home,
            _ => Icons.Material.Filled.Folder
        };
    }

    private static bool IsComplexNodeItem(ConfigurationNodeDefinition node)
    {
        return !node.IsScalarCollection()
               && node.NodeKind is (ConfigurationNodeKind.Object or ConfigurationNodeKind.Dictionary or ConfigurationNodeKind.List);
    }

    private static bool IsSimpleEditableNode(ConfigurationNodeDefinition node)
    {
        return node.NodeKind == ConfigurationNodeKind.Scalar || node.IsScalarCollection();
    }

    private bool IsSelectedNode(ConfigurationNodeDefinition node)
    {
        return _selectedNode?.RelativePath.Equals(node.RelativePath) is true;
    }

    private Task OnSelectedNodeChanged(ConfigurationNodeDefinition? node)
    {
        _selectedNode = node;
        _highlightedPath = null;
