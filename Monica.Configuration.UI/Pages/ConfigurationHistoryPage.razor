@attribute [Route(PAGE_URL)]
@inject ConfigurationFacade Facade
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationHistory:Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="configuration-history-page">
    <MudStack Spacing="3">
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">@L["Pages:ConfigurationHistory:Title"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["History:Subtitle"]</MudText>
            </MudStack>
            <MudTooltip Text="@L["Common:Actions:Refresh"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" OnClick="LoadAsync" />
            </MudTooltip>
        </MudStack>

        <MudPaper Outlined="true" Class="pa-3">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="3">
                    <MudSelect T="string"
                               @bind-Value="_definitionKey"
                               Label="@L["State:Columns:Definition"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var definition in _definitions)
                        {
                            <MudSelectItem T="string" Value="@definition.DefinitionKey">@definition.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  @bind-Value="_pathText"
                                  Label="@L["Value:Path"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker @bind-Date="_fromDate"
                                   Label="@L["History:Filters:From"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Editable="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker @bind-Date="_toDate"
                                   Label="@L["History:Filters:To"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Editable="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTabs Rounded="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="@L["History:Tabs:Mutations"]" Icon="@Icons.Material.Filled.List">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_history.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@L["History:States:Empty"]</MudAlert>
                }
                else
                {
                    <MudTable T="ConfigurationValueHistory" Items="@FilteredHistory" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>@L["History:Columns:Time"]</MudTh>
                            <MudTh>@L["State:Columns:Definition"]</MudTh>
                            <MudTh>@L["State:Columns:Path"]</MudTh>
                            <MudTh>@L["History:Columns:Source"]</MudTh>
                            <MudTh>@L["History:Columns:Kind"]</MudTh>
                            <MudTh>@L["Group:Label"]</MudTh>
                            <MudTh />
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["History:Columns:Time"]">@context.ModifiedTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                            <MudTd DataLabel="@L["State:Columns:Definition"]">@DefinitionDisplay(context.DefinitionKey)</MudTd>
                            <MudTd DataLabel="@L["State:Columns:Path"]">@context.LogicalPath.ToCanonicalString()</MudTd>
                            <MudTd DataLabel="@L["History:Columns:Source"]">@context.SourceKey</MudTd>
                            <MudTd DataLabel="@L["History:Columns:Kind"]">@context.MutationKind</MudTd>
                            <MudTd DataLabel="@L["Group:Label"]">@GroupLabel(context.MutationGroupId)</MudTd>
                            <MudTd>
                                <MudTooltip Text="@L["Rollback:Confirm"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                                   Size="Size.Small"
                                                   Color="Color.Warning"
                                                   OnClick="() => RollbackHistoryAsync(context)" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="@L["History:Tabs:Groups"]" Icon="@Icons.Material.Filled.Folder">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_groups.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@L["Group:Empty"]</MudAlert>
                }
                else
                {
                    <MudTable T="ConfigurationMutationGroup" Items="@_groups" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>@L["Group:Label"]</MudTh>
                            <MudTh>@L["History:Columns:Time"]</MudTh>
                            <MudTh>@L["Group:MutationCount"]</MudTh>
                            <MudTh>@L["Group:Definitions"]</MudTh>
                            <MudTh>@L["Group:Status"]</MudTh>
                            <MudTh />
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["Group:Label"]">@context.Label</MudTd>
                            <MudTd DataLabel="@L["History:Columns:Time"]">@context.CreatedTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                            <MudTd DataLabel="@L["Group:MutationCount"]">@context.MutationCount</MudTd>
                            <MudTd DataLabel="@L["Group:Definitions"]">
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                    @foreach (var definitionKey in context.DefinitionKeys)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@DefinitionDisplay(definitionKey)</MudChip>
                                    }
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="@L["Group:Status"]">@StatusText(context.Status)</MudTd>
                            <MudTd>
                                <MudStack Row="true" Spacing="1">
                                    <MudTooltip Text="@L["Group:ViewHistory"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.List"
                                                       Size="Size.Small"
                                                       OnClick="() => ShowGroupHistoryAsync(context)" />
                                    </MudTooltip>
                                    <MudTooltip Text="@L["Rollback:Confirm"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                                       Size="Size.Small"
                                                       Color="Color.Warning"
                                                       Disabled="@(context.Status == ConfigurationMutationGroupStatus.RolledBack)"
                                                       OnClick="() => RollbackGroupAsync(context)" />
                                    </MudTooltip>
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>

@code {
    public const string PAGE_URL = ConfigurationUiRoutes.HISTORY_ROUTE;

    private readonly List<ConfigurationDefinitionSummary> _definitions = [];
    private readonly List<ConfigurationValueHistory> _history = [];
    private readonly List<ConfigurationMutationGroup> _groups = [];
    private string? _definitionKey;
    private string _pathText = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _loading = true;

    private IEnumerable<ConfigurationValueHistory> FilteredHistory =>
        string.IsNullOrWhiteSpace(_pathText)
            ? _history
            : _history.Where(history => history.LogicalPath.ToCanonicalString().Contains(_pathText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri, UriKind.Absolute);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("definitionKey", out var definitionValues))
        {
            _definitionKey = definitionValues.FirstOrDefault();
        }

        if (query.TryGetValue("path", out var pathValues))
        {
            _pathText = pathValues.FirstOrDefault() ?? string.Empty;
        }

        await LoadDefinitionsAsync();
        await LoadAsync();
    }

    private async Task LoadDefinitionsAsync()
    {
        var result = await Facade.GetDefinitionsAsync();
        if (!result.IsFailed(out _, out var definitions))
        {
            _definitions.Clear();
            _definitions.AddRange(definitions);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        LogicalPath? logicalPath = null;
        if (!string.IsNullOrWhiteSpace(_pathText))
        {
            try
            {
                logicalPath = LogicalPath.Parse(_pathText);
                _pathText = logicalPath.ToCanonicalString();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{L["Common:Errors:InvalidPath"]}: {ex.Message}", Severity.Error);
            }
        }

        DateTimeOffset? from = _fromDate is null ? null : new DateTimeOffset(_fromDate.Value);
        DateTimeOffset? to = _toDate is null ? null : new DateTimeOffset(_toDate.Value.Date.AddDays(1).AddTicks(-1));

        var historyResult = await Facade.QueryHistoryAsync(from, to, _definitionKey, logicalPath);
        if (historyResult.IsFailed(out var historyError, out var history))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {historyError.Message}", Severity.Error);
            _history.Clear();
        }
        else
        {
            _history.Clear();
            _history.AddRange(history);
        }

        var groupResult = await Facade.GetMutationGroupsAsync(from, to, _definitionKey);
        if (groupResult.IsFailed(out var groupError, out var groups))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {groupError.Message}", Severity.Error);
            _groups.Clear();
        }
        else
        {
            _groups.Clear();
            _groups.AddRange(groups);
        }

        _loading = false;
    }

    private async Task RollbackHistoryAsync(ConfigurationValueHistory history)
    {
        var parameters = new DialogParameters<RollbackConfirmationDialog>();
        parameters.Add(dialog => dialog.HistoryRow, history);
        var dialog = await DialogService.ShowAsync<RollbackConfirmationDialog>(L["Rollback:SingleTitle"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        });
        if (await WasConfirmedAsync(dialog))
        {
            Snackbar.Add(L["Rollback:Success"], Severity.Success);
            await LoadAsync();
        }
    }

    private async Task RollbackGroupAsync(ConfigurationMutationGroup group)
    {
        var parameters = new DialogParameters<RollbackConfirmationDialog>();
        parameters.Add(dialog => dialog.Group, group);
        var dialog = await DialogService.ShowAsync<RollbackConfirmationDialog>(L["Rollback:GroupTitle"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        });
        if (await WasConfirmedAsync(dialog))
        {
            Snackbar.Add(L["Rollback:Success"], Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ShowGroupHistoryAsync(ConfigurationMutationGroup group)
    {
        var result = await Facade.GetGroupHistoryAsync(group.GroupId);
        if (result.IsFailed(out var error, out var rows))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            return;
        }

        _history.Clear();
        _history.AddRange(rows);
        Snackbar.Add(L["Group:HistoryLoaded", group.Label], Severity.Info);
    }

    private static async Task<bool> WasConfirmedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    private string DefinitionDisplay(string definitionKey)
    {
        return _definitions.FirstOrDefault(definition =>
            string.Equals(definition.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? definitionKey;
    }

    private string GroupLabel(string? groupId)
    {
        if (string.IsNullOrWhiteSpace(groupId))
        {
            return string.Empty;
        }

        return _groups.FirstOrDefault(group => group.GroupId == groupId)?.Label ?? groupId;
    }

    private string StatusText(ConfigurationMutationGroupStatus status)
    {
        return L[$"Group:StatusValues:{status}"];
    }
}
