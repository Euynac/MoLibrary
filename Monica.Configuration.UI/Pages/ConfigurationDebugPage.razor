@attribute [Route(PAGE_URL)]
@inject ConfigurationFacade Facade
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationDebug:Title"]</PageTitle>

<div class="configuration-debug-page">
<MudContainer MaxWidth="MaxWidth.False">
    <MudStack Spacing="3">
        <ConfigurationPageHeader Title="@L["Pages:ConfigurationDebug:Title"]"
                                 Subtitle="@L["Debug:Subtitle"]"
                                 Icon="@Icons.Material.Filled.BugReport">
            <Actions>
                <MudTooltip Text="@L["Common:Actions:Refresh"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Variant="Variant.Outlined"
                                   OnClick="LoadAsync"
                                   aria-label="@L["Common:Actions:Refresh"]" />
                </MudTooltip>
            </Actions>
        </ConfigurationPageHeader>

        <MudPaper Outlined="true" Class="pa-3">
            <MudTextField T="string"
                          @bind-Value="_searchText"
                          Placeholder="@L["Debug:SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudPaper>

        @if (SensitiveLineCount > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                @L["Debug:SensitiveNotice", SensitiveLineCount]
            </MudAlert>
        }

        @if (_loading)
        {
            <MudPaper Outlined="true" Class="pa-6 configuration-debug-loading">
                <MudProgressCircular Indeterminate="true" />
                <MudText>@L["Common:States:Loading"]</MudText>
            </MudPaper>
        }
        else if (_lines.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L["Debug:Empty"]</MudAlert>
        }
        else
        {
            <MudPaper Outlined="true" Class="configuration-debug-view">
                @foreach (var line in FilteredLines)
                {
                    var isRevealed = _revealedLines.Contains(line.Index);
                    <div class="debug-line @(IsMatch(line) ? "debug-line-match" : null) @(line.IsSensitive ? "debug-line-sensitive" : null)">
                        <code class="debug-line-content">@line.GetDisplayText(isRevealed)</code>
                        @if (line.IsSensitive)
                        {
                            <MudTooltip Text="@(isRevealed ? L["Debug:HideSensitive"] : L["Debug:RevealSensitive"])">
                                <MudIconButton Icon="@(isRevealed ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                               Size="Size.Small"
                                               Color="Color.Warning"
                                               aria-label="@(isRevealed
                                                   ? L["Debug:HideSensitiveAria", line.Key]
                                                   : L["Debug:RevealSensitiveAria", line.Key])"
                                               OnClick="@(() => ToggleSensitiveLine(line.Index))" />
                            </MudTooltip>
                        }
                    </div>
                }
            </MudPaper>
        }
    </MudStack>
</MudContainer>
</div>

@code {
    public const string PAGE_URL = ConfigurationUiRoutes.DEBUG_ROUTE;

    private readonly List<ConfigurationDebugLine> _lines = [];
    private readonly HashSet<int> _revealedLines = [];
    private string _searchText = string.Empty;
    private bool _loading = true;

    private IEnumerable<ConfigurationDebugLine> FilteredLines =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _lines
            : _lines.Where(IsMatch);

    private int SensitiveLineCount => _lines.Count(static line => line.IsSensitive);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await Facade.GetDebugViewAsync();
        if (result.IsFailed(out var error, out var debugView))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            _lines.Clear();
            _loading = false;
            return;
        }

        _lines.Clear();
        _revealedLines.Clear();
        _lines.AddRange(ConfigurationDebugValueRedactor.Parse(debugView));
        _loading = false;
    }

    private bool IsMatch(ConfigurationDebugLine line)
    {
        return string.IsNullOrWhiteSpace(_searchText)
               || line.SearchText.Contains(_searchText, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleSensitiveLine(int lineIndex)
    {
        if (!_revealedLines.Add(lineIndex))
        {
            _revealedLines.Remove(lineIndex);
        }
    }
}
