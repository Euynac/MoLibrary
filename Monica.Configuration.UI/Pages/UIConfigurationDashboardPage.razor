@attribute [Route(PAGE_URL)]
@using Monica.Configuration.UI.UIConfiguration.Components
@using Monica.Configuration.UI.Services
@using Monica.Configuration.Model
@using Monica.Configuration.UI.Model
@using Microsoft.Extensions.Options
@using Monica.Core.Results;
@using Monica.Modules
@inject ConfigurationUIService ConfigurationUIService
@inject ISnackbar Snackbar
@inject IOptions<ModuleServiceDiscoveryOption> Options

<PageTitle>@DashboardTitle</PageTitle>

<div class="dashboard-page-shell">
    <MudContainer MaxWidth="MaxWidth.False">
        <MudPaper Class="pa-6 mb-6" Elevation="2">
            <MudText Typo="Typo.h3" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-3" />
                @DashboardTitle
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                @DashboardDescription
            </MudText>
        </MudPaper>

        <MudTabs Elevation="4"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 Class="mb-6"
                 @bind-ActivePanelIndex="activeTabIndex"
                 @bind-ActivePanelIndex:after="OnTabChangedAsync">
            <MudTabPanel Text="配置状态" Icon="@Icons.Material.Filled.Tune">
                <div class="tab-content-panel">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween"
                                  AlignItems="AlignItems.Center"
                                  Class="mb-4">
                            <MudText Typo="Typo.h6">配置状态</MudText>
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="LoadConfigStatusAsync"
                                       Disabled="@isLoading">
                                刷新
                            </MudButton>
                        </MudStack>

                        @if (configStatus != null)
                        {
                            <ConfigurationExplorer Configs="configStatus" OnConfigUpdate="HandleConfigUpdate" />
                        }
                        else if (isLoading)
                        {
                            <MudStack AlignItems="AlignItems.Center"
                                      Justify="Justify.Center"
                                      Spacing="2"
                                      Class="loading-state">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">正在加载配置状态...</MudText>
                            </MudStack>
                        }
                    </MudPaper>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="配置历史" Icon="@Icons.Material.Filled.History">
                <div class="tab-content-panel">
                    <ConfigurationHistory />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="配置概览" Icon="@Icons.Material.Filled.Assessment">
                <div class="tab-content-panel">
                    <ConfigurationOverview />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="调试视图" Icon="@Icons.Material.Filled.BugReport">
                <div class="tab-content-panel">
                    <ConfigurationDebugView @ref="debugViewComponent" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="配置提供者" Icon="@Icons.Material.Filled.Extension">
                <div class="tab-content-panel">
                    <ConfigurationProviderView @ref="providerViewComponent" />
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudContainer>
</div>

@code {
    public const string PAGE_URL = "/configuration-dashboard";

    private List<DtoDomainGroup>? configStatus;
    private bool isLoading;
    private int activeTabIndex = 0;
    private ConfigurationDebugView? debugViewComponent;
    private ConfigurationProviderView? providerViewComponent;
    private string DashboardTitle => Options.Value.IsRegistryServer ? "配置中心面板" : "配置客户端面板";
    private string DashboardDescription => Options.Value.IsRegistryServer
        ? "集中查看配置状态、变更历史、配置概览、调试视图和提供者信息。"
        : "查看客户端配置状态、变更历史、配置概览、调试视图和提供者信息。";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadConfigStatusAsync();
        }
    }

    private async Task LoadConfigStatusAsync()
    {
        isLoading = true;
        StateHasChanged();

        await Task.Yield();

        if ((await ConfigurationUIService.GetConfigsAsync()).IsFailed(out var error, out var data))
        {
            Snackbar.Add($"加载配置状态失败: {error}", Severity.Error);
        }
        else
        {
            configStatus = data;
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleConfigUpdate(DtoUpdateConfig updateRequest)
    {
        if ((await ConfigurationUIService.UpdateConfigAsync(updateRequest)).IsFailed(out var error))
        {
            Snackbar.Add($"配置更新失败: {error}", Severity.Error);
        }
        else
        {
            Snackbar.Add("配置更新成功", Severity.Success);
            await LoadConfigStatusAsync();
        }
    }
    
    private async Task OnTabChangedAsync()
    {
        if (activeTabIndex == 3 && debugViewComponent is not null)
        {
            await debugViewComponent.LoadDebugViewAsync();
            return;
        }

        if (activeTabIndex == 4 && providerViewComponent is not null)
        {
            await providerViewComponent.LoadProvidersAsync();
        }
    }
}
