@attribute [Route(PAGE_URL)]
@inject ConfigurationFacade Facade
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationOverview:Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="configuration-page-shell">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Spacing="2">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@L["Pages:ConfigurationOverview:Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["Overview:States:Loading"]
            </MudText>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudTextField T="string"
                          @bind-Value="_searchText"
                          Placeholder="@L["Overview:SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="configuration-search" />
            <MudTooltip Text="@L["Overview:Refresh"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Variant="Variant.Outlined"
                               OnClick="LoadAsync" />
            </MudTooltip>
        </MudStack>
    </MudStack>

    @if (_isLoading)
    {
        <MudPaper Class="pa-6 configuration-state-shell" Outlined="true">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" />
                <MudText>@L["Overview:States:Loading"]</MudText>
            </MudStack>
        </MudPaper>
    }
    else if (_definitions.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L["Overview:States:Empty"]</MudAlert>
    }
    else
    {
        <MudTable T="ConfigurationDefinitionSummary" Items="@FilteredDefinitions" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>@L["Overview:Columns:Key"]</MudTh>
                <MudTh>@L["Overview:Columns:DisplayName"]</MudTh>
                <MudTh>@L["Overview:Columns:SectionPath"]</MudTh>
                <MudTh>@L["Overview:Columns:OwnerModule"]</MudTh>
                <MudTh>@L["Overview:Columns:SchemaVersion"]</MudTh>
                <MudTh />
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Overview:Columns:Key"]">@context.DefinitionKey</MudTd>
                <MudTd DataLabel="@L["Overview:Columns:DisplayName"]">@context.DisplayName</MudTd>
                <MudTd DataLabel="@L["Overview:Columns:SectionPath"]">@context.SectionPath</MudTd>
                <MudTd DataLabel="@L["Overview:Columns:OwnerModule"]">@context.OwnerModule</MudTd>
                <MudTd DataLabel="@L["Overview:Columns:SchemaVersion"]">@context.SchemaVersion</MudTd>
                <MudTd DataLabel="@L["Common:Actions:Refresh"]">
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="@L["Overview:OpenDefinition"]">
                            <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="() => NavigateDefinition(context.DefinitionKey)" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Overview:OpenValue"]">
                            <MudIconButton Icon="@Icons.Material.Filled.DataObject"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="() => NavigateValue(context.DefinitionKey)" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Overview:OpenMutation"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           OnClick="() => NavigateMutation(context.DefinitionKey)" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Overview:OpenHistory"]">
                            <MudIconButton Icon="@Icons.Material.Filled.History"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           OnClick="() => NavigateHistory(context.DefinitionKey)" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    public const string PAGE_URL = ConfigurationUiRoutes.OVERVIEW_ROUTE;

    private readonly List<ConfigurationDefinitionSummary> _definitions = [];
    private string _searchText = string.Empty;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private IEnumerable<ConfigurationDefinitionSummary> FilteredDefinitions =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _definitions
            : _definitions.Where(definition =>
                definition.DefinitionKey.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || definition.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || (definition.OwnerModule?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || definition.SectionPath.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private async Task LoadAsync()
    {
        _isLoading = true;
        var result = await Facade.GetDefinitionsAsync();
        if (result.IsFailed(out var error, out var definitions))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            _definitions.Clear();
            _isLoading = false;
            return;
        }

        _definitions.Clear();
        _definitions.AddRange(definitions);
        _isLoading = false;
    }

    private void NavigateDefinition(string definitionKey) =>
        NavigationManager.NavigateTo(ConfigurationUiRoutes.Definition(definitionKey));

    private void NavigateValue(string definitionKey) =>
        NavigationManager.NavigateTo(ConfigurationUiRoutes.Value(definitionKey));

    private void NavigateMutation(string definitionKey) =>
        NavigationManager.NavigateTo(ConfigurationUiRoutes.Edit(definitionKey));

    private void NavigateHistory(string definitionKey) =>
        NavigationManager.NavigateTo(ConfigurationUiRoutes.History(definitionKey));
}
