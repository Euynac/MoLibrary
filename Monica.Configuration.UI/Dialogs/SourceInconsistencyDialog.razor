@using Monica.Configuration.UI.Models
<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                <MudText Typo="Typo.body2">
                    配置类 <strong>@Analysis.ConfigTitle</strong> 中的配置项来自不同的配置源。
                    这可能是由于部分配置项被特定配置源覆盖导致的。
                </MudText>
            </MudAlert>

            <MudText Typo="Typo.h6" Class="mb-3">配置来源详情</MudText>

            @foreach (var sourceGroup in Analysis.SourceGroups)
            {
                <MudCard Outlined="true" Class="mb-3">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Source"
                                         Size="Size.Small"
                                         Class="mr-2" />
                                <div>
                                    <MudText Typo="Typo.subtitle1">@sourceGroup.Provider</MudText>
                                    @if (!string.IsNullOrEmpty(sourceGroup.Source))
                                    {
                                        <MudText Typo="Typo.caption"
                                                 Class="text-muted"
                                                 Style="font-family: monospace;">
                                            @sourceGroup.Source
                                        </MudText>
                                    }
                                </div>
                            </div>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Info"
                                     Text="@($"{sourceGroup.Items.Count} 项")" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            @foreach (var item in sourceGroup.Items)
                            {
                                <MudListItem T="string">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Settings"
                                                 Size="Size.Small"
                                                 Class="mr-2" />
                                        <div>
                                            <MudText Typo="Typo.body2">@item.Title</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @item.Name
                                            </MudText>
                                        </div>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudCardContent>
                </MudCard>
            }

            <MudAlert Severity="Severity.Info" Class="mt-3">
                <MudText Typo="Typo.caption">
                    提示：配置项的最终值由优先级最高的配置源决定。
                    如需统一配置来源，请在相应的配置文件中进行调整。
                </MudText>
            </MudAlert>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            关闭
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public ConfigSourceAnalysis Analysis { get; set; } = null!;

    private void Close() => MudDialog?.Close();
}

