@using Monica.Configuration.UI.Localization
@using Monica.Configuration.Serialization
@using Monica.UI.UIDiffHighlight.Models
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog Class="configuration-definition-publish-history-dialog">
    <DialogContent>
        <MudStack Spacing="3" Class="configuration-definition-publish-history-content">
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">@Definition?.DisplayName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Definition?.DefinitionKey</MudText>
                </MudStack>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @L["History:SchemaPublish:Count", Histories.Count]
                </MudChip>
            </MudStack>

            @if (Histories.Count == 0)
            {
                <MudAlert Severity="Severity.Info">@L["History:SchemaPublish:Empty"]</MudAlert>
            }
            else
            {
                <MudGrid Spacing="3" Class="configuration-definition-publish-history-layout">
                    <MudItem xs="12" md="4" Class="configuration-definition-publish-history-timeline-column">
                        <MudPaper Outlined="true" Class="pa-3 configuration-definition-publish-history-panel">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["History:Dialog:Timeline"]</MudText>
                            <div class="configuration-definition-publish-history-scroll">
                                <MudTimeline TimelinePosition="TimelinePosition.Left" TimelineOrientation="TimelineOrientation.Vertical">
                                    @foreach (var history in OrderedHistories)
                                    {
                                        <MudTimelineItem Color="@ChangeKindColor(history.ChangeKind)"
                                                         Icon="@ChangeKindIcon(history.ChangeKind)"
                                                         Size="Size.Small">
                                            <ItemContent>
                                                <MudButton Variant="@(history == _selectedHistory ? Variant.Outlined : Variant.Text)"
                                                           Color="Color.Primary"
                                                           FullWidth="true"
                                                           Class="configuration-definition-publish-history-timeline-button"
                                                           OnClick="() => SelectHistory(history)">
                                                    <MudStack Spacing="1" AlignItems="AlignItems.Start">
                                                        <MudText Typo="Typo.subtitle2">@ChangeKindText(history.ChangeKind)</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @VersionTransition(history)
                                                        </MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @history.PublishedTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                                        </MudText>
                                                    </MudStack>
                                                </MudButton>
                                            </ItemContent>
                                        </MudTimelineItem>
                                    }
                                </MudTimeline>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="8" Class="configuration-definition-publish-history-detail-column">
                        <MudPaper Outlined="true" Class="pa-3 configuration-definition-publish-history-panel">
                            @if (_selectedHistory is not null)
                            {
                                <MudStack Spacing="3">
                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1">@ChangeKindText(_selectedHistory.ChangeKind)</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @_selectedHistory.PublishedTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")
                                            </MudText>
                                        </MudStack>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@ChangeKindColor(_selectedHistory.ChangeKind)"
                                                     Variant="Variant.Outlined"
                                                     Icon="@ChangeKindIcon(_selectedHistory.ChangeKind)">
                                                @ChangeKindText(_selectedHistory.ChangeKind)
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                @VersionTransition(_selectedHistory)
                                            </MudChip>
                                        </MudStack>
                                    </MudStack>

                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:SchemaPublish:Publisher"]</MudText>
                                            <MudText Typo="Typo.body2">@PublisherText(_selectedHistory)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:SchemaPublish:PublisherVersion"]</MudText>
                                            <MudText Typo="Typo.body2">@ValueOrEmpty(_selectedHistory.PublisherVersion)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:SchemaPublish:SectionPath"]</MudText>
                                            <MudText Typo="Typo.body2">@_selectedHistory.SectionPath</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:SchemaPublish:FromProject"]</MudText>
                                            <MudText Typo="Typo.body2">@_selectedHistory.FromProject</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:SchemaPublish:PreviousHash"]</MudText>
                                            <MudText Typo="Typo.body2" Class="configuration-definition-publish-history-hash">
                                                @ValueOrEmpty(_selectedHistory.PreviousSchemaHash)
                                            </MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:SchemaPublish:NewHash"]</MudText>
                                            <MudText Typo="Typo.body2" Class="configuration-definition-publish-history-hash">
                                                @_selectedHistory.NewSchemaHash
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>

                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle2">@L["History:SchemaPublish:ChangeSummary"]</MudText>
                                        @if (SelectedChanges.Count == 0)
                                        {
                                            <MudAlert Severity="Severity.Info" Dense="true">@L["History:SchemaPublish:NoSummary"]</MudAlert>
                                        }
                                        else
                                        {
                                            <MudTable T="SchemaPublishChangeView" Items="@SelectedChanges" Dense="true" Hover="true" Elevation="0">
                                                <HeaderContent>
                                                    <MudTh>@L["History:SchemaPublish:Field"]</MudTh>
                                                    <MudTh>@L["History:SchemaPublish:PreviousValue"]</MudTh>
                                                    <MudTh>@L["History:SchemaPublish:NewValue"]</MudTh>
                                                </HeaderContent>
                                                <RowTemplate>
                                                    <MudTd DataLabel="@L["History:SchemaPublish:Field"]">@context.Field</MudTd>
                                                    <MudTd DataLabel="@L["History:SchemaPublish:PreviousValue"]">@ValueOrEmpty(context.PreviousValue)</MudTd>
                                                    <MudTd DataLabel="@L["History:SchemaPublish:NewValue"]">@ValueOrEmpty(context.NewValue)</MudTd>
                                                </RowTemplate>
                                            </MudTable>
                                        }
                                    </MudStack>

                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle2">@L["History:SchemaPublish:SchemaDiff"]</MudText>
                                        <DiffViewer OriginText="@FormatJson(_selectedHistory.PreviousSchemaJson)"
                                                    NewText="@FormatJson(_selectedHistory.NewSchemaJson)"
                                                    Options="@_diffOptions"
                                                    ViewMode="EDiffViewMode.Unified" />
                                    </MudStack>
                                </MudStack>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Common:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DiffHighlightOptions _diffOptions = new()
    {
        Mode = EDiffHighlightMode.Line,
        ContextLines = 4,
        MaxCharacterDiffLength = 5000
    };

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ConfigurationDefinition? Definition { get; set; }
    [Parameter] public IReadOnlyList<ConfigurationDefinitionPublishHistory> Histories { get; set; } = [];

    private ConfigurationDefinitionPublishHistory? _selectedHistory;

    private IReadOnlyList<ConfigurationDefinitionPublishHistory> OrderedHistories =>
        Histories
            .OrderByDescending(history => history.PublishedTime)
            .ThenByDescending(history => history.HistoryId)
            .ToArray();

    private IReadOnlyList<SchemaPublishChangeView> SelectedChanges =>
        _selectedHistory is null
            ? []
            : ParseChanges(_selectedHistory.ChangeSummaryJson);

    protected override void OnParametersSet()
    {
        _selectedHistory ??= OrderedHistories.FirstOrDefault();
    }

    private void SelectHistory(ConfigurationDefinitionPublishHistory history)
    {
        _selectedHistory = history;
    }

    private void Close()
    {
        MudDialog.Close();
    }

    private string ChangeKindText(ConfigurationDefinitionPublishChangeKind kind)
    {
        return kind switch
        {
            ConfigurationDefinitionPublishChangeKind.Created => L["History:SchemaPublish:Kinds:Created"],
            ConfigurationDefinitionPublishChangeKind.SchemaChanged => L["History:SchemaPublish:Kinds:SchemaChanged"],
            ConfigurationDefinitionPublishChangeKind.MetadataChanged => L["History:SchemaPublish:Kinds:MetadataChanged"],
            _ => kind.ToString()
        };
    }

    private static Color ChangeKindColor(ConfigurationDefinitionPublishChangeKind kind)
    {
        return kind switch
        {
            ConfigurationDefinitionPublishChangeKind.Created => Color.Success,
            ConfigurationDefinitionPublishChangeKind.SchemaChanged => Color.Warning,
            ConfigurationDefinitionPublishChangeKind.MetadataChanged => Color.Info,
            _ => Color.Default
        };
    }

    private static string ChangeKindIcon(ConfigurationDefinitionPublishChangeKind kind)
    {
        return kind switch
        {
            ConfigurationDefinitionPublishChangeKind.Created => Icons.Material.Filled.Add,
            ConfigurationDefinitionPublishChangeKind.SchemaChanged => Icons.Material.Filled.DataObject,
            ConfigurationDefinitionPublishChangeKind.MetadataChanged => Icons.Material.Filled.Edit,
            _ => Icons.Material.Filled.Timeline
        };
    }

    private string VersionTransition(ConfigurationDefinitionPublishHistory history)
    {
        return history.PreviousSchemaVersion is null
            ? L["History:SchemaPublish:VersionCreated", history.NewSchemaVersion]
            : history.ChangeKind == ConfigurationDefinitionPublishChangeKind.SchemaChanged
              && history.PreviousSchemaVersion != history.NewSchemaVersion
                ? L["History:SchemaPublish:VersionChanged", history.PreviousSchemaVersion, history.NewSchemaVersion]
                : L["History:SchemaPublish:VersionCreated", history.NewSchemaVersion];
    }

    private static string PublisherText(ConfigurationDefinitionPublishHistory history)
    {
        return string.Equals(history.PublisherId, history.PublisherName, StringComparison.Ordinal)
            ? history.PublisherName
            : $"{history.PublisherName} ({history.PublisherId})";
    }

    private string ValueOrEmpty(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? L["Common:States:Empty"] : value;
    }

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return "null";
        }

        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, ConfigurationJsonDisplayFormatter.ReadableJsonOptions);
        }
        catch (JsonException)
        {
            return json;
        }
    }

    private static IReadOnlyList<SchemaPublishChangeView> ParseChanges(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return [];
        }

        try
        {
            var summary = JsonSerializer.Deserialize<SchemaPublishChangeSummaryView>(
                json,
                ConfigurationPersistedJsonOptions.CompactSchema);
            return summary?.Changes ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private sealed class SchemaPublishChangeSummaryView
    {
        public IReadOnlyList<SchemaPublishChangeView> Changes { get; init; } = [];
    }

    private sealed class SchemaPublishChangeView
    {
        public string Field { get; init; } = "";

        public string? PreviousValue { get; init; }

        public string? NewValue { get; init; }
    }
}
