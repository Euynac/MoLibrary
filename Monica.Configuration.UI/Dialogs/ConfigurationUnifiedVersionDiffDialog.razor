@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog Class="configuration-unified-version-diff-dialog">
    <DialogContent>
        <ConfigurationUnifiedVersionDiffPanel Comparison="Comparison" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Common:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public ConfigurationUnifiedVersionComparison Comparison { get; set; } = null!;

    private void Close()
    {
        MudDialog.Close();
    }
}
