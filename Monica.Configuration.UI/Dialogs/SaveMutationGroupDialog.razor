@using Monica.Configuration.UI.Localization
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog Class="configuration-save-group-dialog">
    <DialogContent>
        <div class="configuration-save-group-dialog-body">
            <div class="configuration-save-group-form">
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  @bind-Value="_label"
                                  Label="@L["Group:Label"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                    <MudTextField T="string"
                                  @bind-Value="_reason"
                                  Label="@L["Group:Reason"]"
                                  Variant="Variant.Outlined"
                                  Lines="2" />

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <MudAlert Severity="Severity.Error">@_error</MudAlert>
                    }
                    @if (ValidationIssues.Count > 0)
                    {
                        <MudAlert Severity="Severity.Error">
                            @L["Dialogs:SaveGroup:Validation:BlockedSummary", ValidationIssues.Count]
                        </MudAlert>
                    }
                    @if (ExternalChangeCount > 0)
                    {
                        <MudAlert Severity="Severity.Warning">
                            @L["Dialogs:SaveGroup:ExternalTargetSummary", ExternalChangeCount]
                        </MudAlert>
                    }
                </MudStack>
            </div>

            <div class="configuration-save-group-preview">
                <MudTabs Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-3">
                    <MudTabPanel Text="@L["Dialogs:SaveGroup:Tabs:DefinitionDiff"]" Icon="@Icons.Material.Filled.Difference">
                        <ConfigurationPendingDefinitionDiffPreview Changes="@Changes"
                                                                   ValidationIssues="@ValidationIssues"
                                                                   JumpRequested="JumpToIssue" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Dialogs:SaveGroup:Tabs:ChangeList"]" Icon="@Icons.Material.Filled.List">
                        <MudStack Spacing="3">
                            @if (ValidationIssues.Count > 0)
                            {
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2">@L["Dialogs:SaveGroup:Validation:Title"]</MudText>
                                    <ConfigurationValidationIssueList Issues="@ValidationIssues"
                                                                      JumpRequested="JumpToIssue" />
                                </MudStack>
                            }

                            @if (Changes.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info">@L["Dialogs:SaveGroup:Validation:NoSaveableChanges"]</MudAlert>
                            }
                            else
                            {
                                <MudTable T="PendingChange" Items="@Changes" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>@L["State:Columns:Definition"]</MudTh>
                                        <MudTh>@L["State:Columns:Path"]</MudTh>
                                        <MudTh>@L["History:Columns:Target"]</MudTh>
                                        <MudTh>@L["History:Columns:Kind"]</MudTh>
                                        <MudTh>@L["State:Columns:OldValue"]</MudTh>
                                        <MudTh>@L["State:Columns:NewValue"]</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="@L["State:Columns:Definition"]">@context.DefinitionDisplayName</MudTd>
                                        <MudTd DataLabel="@L["State:Columns:Path"]">@context.LogicalPath.ToCanonicalString()</MudTd>
                                        <MudTd DataLabel="@L["History:Columns:Target"]">@TargetChip(context)</MudTd>
                                        <MudTd DataLabel="@L["History:Columns:Kind"]">@context.MutationKind</MudTd>
                                        <MudTd DataLabel="@L["State:Columns:OldValue"]">@DisplayValue(context, context.OriginalDisplayValue)</MudTd>
                                        <MudTd DataLabel="@L["State:Columns:NewValue"]">@DisplayValue(context, context.NewDisplayValue)</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudStack>
                    </MudTabPanel>
                </MudTabs>
            </div>

            @if (_saving)
            {
                <MudProgressLinear Indeterminate="true" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">@L["Common:Actions:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync"
                   Disabled="@(_saving || Changes.Count == 0 || ValidationIssues.Count > 0 || string.IsNullOrWhiteSpace(_label))">
            @L["Group:SaveCount", Changes.Count]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public IReadOnlyList<PendingChange> Changes { get; set; } = [];
    [Parameter] public IReadOnlyList<ConfigurationValidationIssue> ValidationIssues { get; set; } = [];

    private string _label = string.Empty;
    private string? _reason;
    private string? _error;
    private bool _saving;

    private int ExternalChangeCount => Changes.Count(change => change.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource);

    protected override void OnInitialized()
    {
        _label = string.Format(L["Group:DefaultLabel"], DateTimeOffset.Now.ToString("yyyy-MM-dd HH:mm"));
    }

    private async Task SaveAsync()
    {
        if (Changes.Count == 0)
        {
            return;
        }

        _saving = true;
        _error = null;

        var beginResult = await Facade.BeginMutationGroupAsync(_label, _reason, new ConfigurationMutationContext { Reason = _reason });
        if (beginResult.IsFailed(out var beginError, out var group))
        {
            _error = beginError.Message;
            _saving = false;
            return;
        }

        var successCount = 0;
        var definitionKeys = new List<string>();
        var latestVersionsByDefinition = new Dictionary<string, long?>(StringComparer.OrdinalIgnoreCase);

        foreach (var change in Changes)
        {
            var result = change.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource
                ? await ApplyExternalChangeAsync(change, group.GroupId)
                : await ApplyMonicaChangeAsync(change, group.GroupId, latestVersionsByDefinition);

            if (result.IsFailed(out var error, out var mutationResult))
            {
                await Facade.MarkMutationGroupPartialAsync(group.GroupId, successCount, definitionKeys);
                _error = error.Message;
                _saving = false;
                return;
            }

            successCount++;
            definitionKeys.Add(change.DefinitionKey);
            if (change.TargetKind == ConfigurationMutationTargetKind.MonicaEffectiveStore)
            {
                latestVersionsByDefinition[change.DefinitionKey] = mutationResult.NewVersion;
            }
        }

        var completeResult = await Facade.CompleteMutationGroupAsync(group.GroupId, successCount, definitionKeys);
        if (completeResult.IsFailed(out var completeError))
        {
            _error = completeError.Message;
            _saving = false;
            return;
        }

        MudDialog.Close(DialogResult.Ok(SaveMutationGroupDialogResult.Saved(group)));
    }

    private async Task<Res<ConfigurationMutationResult>> ApplyMonicaChangeAsync(
        PendingChange change,
        string groupId,
        IReadOnlyDictionary<string, long?> latestVersionsByDefinition)
    {
        var expectedValueVersion = latestVersionsByDefinition.GetValueOrDefault(
            change.DefinitionKey,
            change.ExpectedValueVersion);
        return await Facade.MutateAsync(new ConfigurationMutationRequest
        {
            DefinitionKey = change.DefinitionKey,
            LogicalPath = change.LogicalPath,
            MutationKind = change.MutationKind,
            Value = change.NewValue,
            ExpectedSchemaVersion = change.ExpectedSchemaVersion,
            ExpectedValueVersion = expectedValueVersion,
            Context = new ConfigurationMutationContext
            {
                MutationGroupId = groupId,
                Reason = _reason
            }
        });
    }

    private async Task<Res<ConfigurationMutationResult>> ApplyExternalChangeAsync(PendingChange change, string groupId)
    {
        if (string.IsNullOrWhiteSpace(change.SourceKey))
        {
            return L["Dialogs:SaveGroup:MissingSourceTarget"].Value;
        }

        var revisionResult = await Facade.GetSourceRevisionAsync(change.SourceKey);
        var expectedRevision = revisionResult.IsFailed(out _, out var revision) ? null : revision;
        return await Facade.MutateSourceAsync(new ConfigurationSourceMutationRequest
        {
            SourceKey = change.SourceKey,
            DefinitionKey = change.DefinitionKey,
            LogicalPath = change.LogicalPath,
            MutationKind = change.MutationKind,
            Value = change.NewValue,
            ExpectedSchemaVersion = change.ExpectedSchemaVersion,
            ExpectedSourceRevision = expectedRevision,
            Context = new ConfigurationMutationContext
            {
                MutationGroupId = groupId,
                Reason = _reason
            }
        });
    }

    private string DisplayValue(PendingChange change, string? value)
    {
        if (change.IsSensitive)
        {
            return L["State:Value:Sensitive"];
        }

        return string.IsNullOrWhiteSpace(value) ? L["Value:States:Empty"] : value;
    }

    private RenderFragment TargetChip(PendingChange change) => builder =>
    {
        if (change.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
        {
            builder.OpenComponent<MudTooltip>(0);
            builder.AddAttribute(1, "Text", L["History:Targets:ExternalTooltip",
                change.SourceDisplayName ?? L["History:Targets:External"],
                change.SourceConfigurationPath ?? change.LogicalPath.ToCanonicalString(),
                change.SourcePhysicalPath ?? change.SourceProviderType ?? L["Common:States:Empty"]]);
            builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
            {
                content.OpenComponent<MudChip<string>>(3);
                content.AddAttribute(4, "Size", Size.Small);
                content.AddAttribute(5, "Color", Color.Warning);
                content.AddAttribute(6, "Variant", Variant.Outlined);
                content.AddAttribute(7, "ChildContent", (RenderFragment)(chip => chip.AddContent(8, change.SourceDisplayName ?? L["History:Targets:ExternalShort"])));
                content.CloseComponent();
            }));
            builder.CloseComponent();
            return;
        }

        builder.OpenComponent<MudChip<string>>(9);
        builder.AddAttribute(10, "Size", Size.Small);
        builder.AddAttribute(11, "Color", Color.Info);
        builder.AddAttribute(12, "Variant", Variant.Outlined);
        builder.AddAttribute(13, "ChildContent", (RenderFragment)(content => content.AddContent(14, L["History:Targets:MonicaShort"])));
        builder.CloseComponent();
    };

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void JumpToIssue(ConfigurationValidationIssue issue)
    {
        MudDialog.Close(DialogResult.Ok(SaveMutationGroupDialogResult.JumpTo(issue)));
    }
}
