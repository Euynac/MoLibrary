@using Monica.Configuration.UI.Localization
@inject ConfigurationFacade Facade
@inject IDialogService DialogService
@inject IStringLocalizer<ConfigurationUIResource> L
@inject Microsoft.Extensions.Options.IOptions<Monica.Modules.ModuleConfigurationUIOption> UIOptions

<MudDialog Class="configuration-save-group-dialog">
    <DialogContent>
        <div class="configuration-save-group-dialog-body">
            <div class="configuration-save-group-form">
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  @bind-Value="_label"
                                  Label="@L["Group:Label"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                    <MudTextField T="string"
                                  @bind-Value="_reason"
                                  Label="@L["Group:Reason"]"
                                  Variant="Variant.Outlined"
                                  Lines="2" />

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <MudAlert Severity="Severity.Error">@_error</MudAlert>
                    }
                    @if (_review.ValidationIssues.Count > 0)
                    {
                        <MudAlert Severity="Severity.Error">
                            @L["Dialogs:SaveGroup:Validation:BlockedSummary", _review.ValidationIssues.Count]
                        </MudAlert>
                    }
                    @if (ExternalChangeCount > 0)
                    {
                        <MudAlert Severity="Severity.Warning">
                            @L["Dialogs:SaveGroup:ExternalTargetSummary", ExternalChangeCount]
                        </MudAlert>
                    }
                </MudStack>
            </div>

            <div class="configuration-save-group-preview">
                <ConfigurationPendingReviewTabs Review="_review"
                                                ActionMode="ConfigurationPendingReviewActionMode.Undo"
                                                ActionsDisabled="_saving"
                                                JumpIssueRequested="JumpToIssue"
                                                JumpChangeRequested="JumpToChange"
                                                UndoRequested="UndoReviewAsync" />
            </div>

            @if (_saving)
            {
                <MudProgressLinear Indeterminate="true" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">@L["Common:Actions:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync"
                   Disabled="@(_saving || _review.Changes.Count == 0 || _review.ValidationIssues.Count > 0 || string.IsNullOrWhiteSpace(_label))">
            @L["Group:SaveCount", _review.Changes.Count]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public IReadOnlyList<PendingChange> Changes { get; set; } = [];
    [Parameter] public IReadOnlyList<ConfigurationValidationIssue> ValidationIssues { get; set; } = [];
    [Parameter] public EventCallback<ConfigurationPendingReviewUndoRequest> UndoRequested { get; set; }

    private string _label = string.Empty;
    private string? _reason;
    private string? _error;
    private bool _saving;
    private ConfigurationPendingReviewState _review = null!;

    private int ExternalChangeCount => _review.Changes.Count(change => change.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource);

    protected override void OnParametersSet()
    {
        _review ??= new ConfigurationPendingReviewState(Changes, ValidationIssues);
    }

    protected override void OnInitialized()
    {
        _label = string.Format(L["Group:DefaultLabel"], DateTimeOffset.Now.ToString("yyyy-MM-dd HH:mm"));
    }

    private async Task SaveAsync()
    {
        if (_review.Changes.Count == 0)
        {
            return;
        }

        var changes = _review.Changes;
        _saving = true;
        _error = null;

        if (UIOptions.Value.EnableAffectedServiceConfirmation
            && !await ConfirmAffectedServicesAsync(changes))
        {
            _saving = false;
            return;
        }

        var commandResult = await BuildCommandsAsync(changes);
        if (commandResult.IsFailed(out var commandError, out var commands))
        {
            _error = commandError.Message;
            _saving = false;
            return;
        }

        var applyResult = await Facade.ApplyMutationGroupAsync(new ConfigurationMutationGroupApplyRequest
        {
            Label = _label,
            Reason = _reason,
            Context = new ConfigurationMutationContext { Reason = _reason },
            Commands = commands
        });
        if (applyResult.IsFailed(out var applyError, out var result))
        {
            if (applyError.Message?.Contains(nameof(ConfigurationConcurrencyConflictException), StringComparison.Ordinal) is true)
            {
                MudDialog.Close(DialogResult.Ok(SaveMutationGroupDialogResult.ConcurrencyConflict(applyError.Message)));
                return;
            }

            _error = applyError.Message;
            _saving = false;
            return;
        }

        MudDialog.Close(DialogResult.Ok(SaveMutationGroupDialogResult.Saved(result)));
    }

    private async Task<bool> ConfirmAffectedServicesAsync(IReadOnlyList<PendingChange> changes)
    {
        var definitionKeys = changes
            .Select(static change => change.DefinitionKey)
            .Where(static key => !string.IsNullOrWhiteSpace(key))
            .Select(static key => key.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        var displayNames = changes
            .GroupBy(static change => change.DefinitionKey.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                static group => group.Key,
                static group => group
                    .Select(static change => change.DefinitionDisplayName)
                    .FirstOrDefault(static displayName => !string.IsNullOrWhiteSpace(displayName))
                    ?? group.Key,
                StringComparer.OrdinalIgnoreCase);

        ConfigurationDefinitionChangeImpact? impact = null;
        string? analysisError = null;
        var impactResult = await Facade.GetDefinitionChangeImpactAsync(definitionKeys);
        if (impactResult.IsFailed(out var impactError, out impact))
        {
            analysisError = impactError.Message;
        }

        var parameters = new DialogParameters<ConfigurationAffectedServiceConfirmationDialog>();
        parameters.Add(dialog => dialog.ChangeCount, changes.Count);
        parameters.Add(dialog => dialog.Impact, impact);
        parameters.Add(dialog => dialog.AnalysisError, analysisError);
        parameters.Add(dialog => dialog.DefinitionDisplayNames, displayNames);
        var dialog = await DialogService.ShowAsync<ConfigurationAffectedServiceConfirmationDialog>(
            L["Dialogs:SaveGroup:Impact:Title"],
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true
            });
        var result = await dialog.Result;
        return result is { Canceled: false } && result.Data is true;
    }

    private async Task<Res<IReadOnlyList<ConfigurationMutationCommand>>> BuildCommandsAsync(
        IReadOnlyList<PendingChange> changes)
    {
        var revisions = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        var commands = new List<ConfigurationMutationCommand>(changes.Count);
        foreach (var change in changes)
        {
            ConfigurationMutationTarget target;
            if (change.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
            {
                if (string.IsNullOrWhiteSpace(change.SourceKey))
                {
                    return L["Dialogs:SaveGroup:MissingSourceTarget"].Value;
                }

                if (!revisions.TryGetValue(change.SourceKey, out var revision))
                {
                    var revisionResult = await Facade.GetSourceRevisionAsync(change.SourceKey);
                    if (revisionResult.IsFailed(out var revisionError, out revision))
                    {
                        return revisionError;
                    }

                    revisions[change.SourceKey] = revision;
                }

                target = new ConfigurationExternalSourceMutationTarget
                {
                    SourceKey = change.SourceKey,
                    ExpectedRevision = revision
                };
            }
            else
            {
                target = new ConfigurationEffectiveStoreMutationTarget
                {
                    ExpectedVersion = change.ExpectedValueVersion
                };
            }

            commands.Add(new ConfigurationMutationCommand
            {
                RequestId = change.RequestId,
                DefinitionKey = change.DefinitionKey,
                LogicalPath = change.LogicalPath,
                MutationKind = change.MutationKind,
                Value = change.NewValue,
                ExpectedSchemaVersion = change.ExpectedSchemaVersion,
                Target = target
            });
        }

        return Res.Ok<IReadOnlyList<ConfigurationMutationCommand>>(commands);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void JumpToIssue(ConfigurationValidationIssue issue)
    {
        MudDialog.Close(DialogResult.Ok(SaveMutationGroupDialogResult.JumpTo(issue)));
    }

    private void JumpToChange(PendingChange change)
    {
        MudDialog.Close(DialogResult.Ok(SaveMutationGroupDialogResult.JumpTo(change)));
    }

    private async Task UndoReviewAsync(ConfigurationPendingReviewUndoRequest request)
    {
        if (!_review.Undo(request))
        {
            return;
        }

        await UndoRequested.InvokeAsync(request);
    }
}
