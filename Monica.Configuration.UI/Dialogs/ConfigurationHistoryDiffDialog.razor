@using Monica.Configuration.UI.Localization
@using Monica.UI.UIDiffHighlight.Models
@inject IDialogService DialogService
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog Class="configuration-history-diff-dialog">
    <DialogContent>
        <MudStack Spacing="3" Class="configuration-history-diff-dialog-content">
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                <MudStack Spacing="0">
                    @if (Group is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:Dialog:GroupSubtitle", Group.MutationCount, Group.DefinitionKeys.Count]</MudText>
                    }
                    else if (!string.IsNullOrWhiteSpace(FocusPathText))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@FocusPathText</MudText>
                    }
                </MudStack>
                @if (Group is not null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@StatusText(Group.Status)</MudChip>
                }
            </MudStack>

            @if (_entries.Count == 0)
            {
                <MudAlert Severity="Severity.Info">@L["History:Dialog:NoPreview"]</MudAlert>
            }
            else
            {
                <MudGrid Spacing="3" Class="configuration-history-diff-layout">
                    <MudItem xs="12" md="4" Class="configuration-history-diff-timeline-column">
                        <MudPaper Outlined="true" Class="pa-3 configuration-history-diff-timeline-panel">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["History:Dialog:Timeline"]</MudText>
                            <div class="configuration-history-diff-timeline-scroll">
                                <MudTimeline TimelinePosition="TimelinePosition.Left" TimelineOrientation="TimelineOrientation.Vertical">
                                    @foreach (var entry in _entries)
                                    {
                                        <MudTimelineItem Color="@entry.Color" Icon="@entry.Icon" Size="Size.Small">
                                            <ItemContent>
                                                <MudButton Variant="@(entry == _selectedEntry ? Variant.Outlined : Variant.Text)"
                                                           Color="Color.Primary"
                                                           FullWidth="true"
                                                           Class="@TimelineButtonClass(entry)"
                                                           OnClick="() => SelectEntry(entry)">
                                                    <MudStack Spacing="1" AlignItems="AlignItems.Start">
                                                        <MudText Typo="Typo.subtitle2">@entry.Title</MudText>
                                                        @if (!string.IsNullOrWhiteSpace(entry.Subtitle))
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Subtitle</MudText>
                                                        }
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Time.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                                                    </MudStack>
                                                </MudButton>
                                            </ItemContent>
                                        </MudTimelineItem>
                                    }
                                </MudTimeline>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="8" Class="configuration-history-diff-preview-column">
                        <MudPaper Outlined="true" Class="pa-3 configuration-history-diff-preview-panel">
                            @if (_selectedEntry is not null)
                            {
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1">@_selectedEntry.Title</MudText>
                                            @if (!string.IsNullOrWhiteSpace(_selectedEntry.Subtitle))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@_selectedEntry.Subtitle</MudText>
                                            }
                                        </MudStack>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@TargetColor(_selectedEntry.Rows)"
                                                     Variant="Variant.Outlined"
                                                     Icon="@TargetIcon(_selectedEntry.Rows)">
                                                @TargetKindText(_selectedEntry.Rows)
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["History:Dialog:Version", _selectedEntry.Version]</MudChip>
                                            <MudChip T="ConfigurationMutationKind" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@_selectedEntry.MutationKind</MudChip>
                                            @if (CanRollbackSelectedEntry)
                                            {
                                                <MudButton Size="Size.Small"
                                                           Color="Color.Warning"
                                                           Variant="Variant.Outlined"
                                                           StartIcon="@Icons.Material.Filled.Restore"
                                                           OnClick="RollbackSelectedEntryAsync">
                                                    @L["Rollback:Confirm"]
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudStack>

                                    @if (_selectedEntry.Rows.Count == 1)
                                    {
                                        <MudGrid Spacing="2" Class="configuration-history-target-details">
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:Dialog:TargetKind"]</MudText>
                                                <MudText Typo="Typo.body2">@TargetKindText(_selectedEntry.Rows)</MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:Dialog:Target"]</MudText>
                                                <MudText Typo="Typo.body2">@TargetDisplay(_selectedEntry.Rows[0])</MudText>
                                            </MudItem>
                                            @if (_selectedEntry.Rows[0].TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:Dialog:SourceProvider"]</MudText>
                                                    <MudText Typo="Typo.body2">@ValueOrEmpty(_selectedEntry.Rows[0].SourceProviderType)</MudText>
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:Dialog:SourceConfigurationPath"]</MudText>
                                                    <MudText Typo="Typo.body2">@ValueOrEmpty(_selectedEntry.Rows[0].SourceConfigurationPath ?? _selectedEntry.Rows[0].ConfigurationPath)</MudText>
                                                </MudItem>
                                                <MudItem xs="12">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:Dialog:SourcePhysicalPath"]</MudText>
                                                    <MudText Typo="Typo.body2" Class="configuration-history-source-path">@ValueOrEmpty(_selectedEntry.Rows[0].SourcePhysicalPath)</MudText>
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:Dialog:SourceRevisionBefore"]</MudText>
                                                    <MudText Typo="Typo.body2">@ShortRevision(_selectedEntry.Rows[0].SourceRevisionBefore)</MudText>
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:Dialog:SourceRevisionAfter"]</MudText>
                                                    <MudText Typo="Typo.body2">@ShortRevision(_selectedEntry.Rows[0].SourceRevisionAfter)</MudText>
                                                </MudItem>
                                            }
                                        </MudGrid>
                                    }
                                    else
                                    {
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Storage">
                                                @L["History:Dialog:MonicaTargetCount", _selectedEntry.Rows.Count(row => row.TargetKind == ConfigurationMutationTargetKind.MonicaEffectiveStore)]
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Description">
                                                @L["History:Dialog:ExternalTargetCount", _selectedEntry.Rows.Count(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)]
                                            </MudChip>
                                        </MudStack>
                                    }

                                    <ConfigurationHistoryDiffPreview Rows="@_selectedEntry.Rows"
                                                                     ViewMode="EDiffViewMode.Unified" />

                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["History:Dialog:Operator"]</MudText>
                                            <MudText Typo="Typo.body2">@OperatorText(_selectedEntry.Rows[0])</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Group:Reason"]</MudText>
                                            <MudText Typo="Typo.body2">@ReasonText(_selectedEntry.Rows)</MudText>
                                        </MudItem>
                                    </MudGrid>
                                </MudStack>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Common:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string GROUP_SUMMARY_ENTRY_ID = "group";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public IReadOnlyList<ConfigurationValueHistory> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<ConfigurationDefinitionSummary> Definitions { get; set; } = [];
    [Parameter] public ConfigurationDefinition? Definition { get; set; }
    [Parameter] public ConfigurationMutationGroup? Group { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public LogicalPath? FocusPath { get; set; }

    private readonly List<HistoryTimelineEntry> _entries = [];
    private HistoryTimelineEntry? _selectedEntry;

    private string DialogTitle => !string.IsNullOrWhiteSpace(Title)
        ? Title!
        : Group is not null
            ? L["History:Dialog:GroupTitle", Group.Label]
            : L["History:Dialog:Title"];

    private string? FocusPathText => FocusPath?.ToCanonicalString();

    private bool CanRollbackSelectedEntry =>
        _selectedEntry is { Rows.Count: 1 }
        || (_selectedEntry?.Id == GROUP_SUMMARY_ENTRY_ID && Group is not null && _selectedEntry.Rows.Count > 0);

    protected override void OnParametersSet()
    {
        _entries.Clear();
        var orderedRows = Rows
            .OrderByDescending(row => row.ModifiedTime)
            .ThenByDescending(row => row.Version)
            .ToArray();
        var focusedSinglePath = Group is null && FocusPath is not null;

        if (Group is not null && orderedRows.Length > 1)
        {
            _entries.Add(new HistoryTimelineEntry(
                GROUP_SUMMARY_ENTRY_ID,
                L["History:Dialog:GroupSummary"],
                L["History:Dialog:GroupSubtitle", Group.MutationCount, Group.DefinitionKeys.Count],
                Group.CreatedTime,
                orderedRows,
                ConfigurationMutationKind.Set,
                orderedRows.Max(row => row.Version),
                Color.Primary,
                Icons.Material.Filled.Folder));
        }

        foreach (var row in orderedRows)
        {
            _entries.Add(new HistoryTimelineEntry(
                row.HistoryId,
                TimelineTitle(row, focusedSinglePath),
                TimelineSubtitle(row, focusedSinglePath),
                row.ModifiedTime,
                [row],
                row.MutationKind,
                row.Version,
                TargetColor(row),
                TimelineIcon(row)));
        }

        _selectedEntry = _entries.FirstOrDefault(entry => _selectedEntry?.Id == entry.Id) ?? _entries.FirstOrDefault();
    }

    private void SelectEntry(HistoryTimelineEntry entry)
    {
        _selectedEntry = entry;
    }

    private string TimelineButtonClass(HistoryTimelineEntry entry)
    {
        return entry == _selectedEntry
            ? "configuration-history-diff-timeline-button selected"
            : "configuration-history-diff-timeline-button";
    }

    private string DefinitionDisplay(string definitionKey)
    {
        if (Definition is not null && string.Equals(Definition.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))
        {
            return Definition.DisplayName;
        }

        return Definitions.FirstOrDefault(definition =>
            string.Equals(definition.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? definitionKey;
    }

    private string TimelineTitle(ConfigurationValueHistory row, bool focusedSinglePath)
    {
        return focusedSinglePath ? TargetDisplay(row) : DefinitionDisplay(row.DefinitionKey);
    }

    private string TimelineSubtitle(ConfigurationValueHistory row, bool focusedSinglePath)
    {
        return focusedSinglePath
            ? L["History:Dialog:TimelineFocusedSubtitle", row.MutationKind, row.Version]
            : L["History:Dialog:TimelineRowSubtitle", row.LogicalPath.ToCanonicalString(), TargetDisplay(row)];
    }

    private string TargetDisplay(ConfigurationValueHistory row)
    {
        return row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource
            ? row.SourceDisplayName ?? L["History:Targets:External"]
            : L["History:Targets:Monica"];
    }

    private string TargetKindText(IReadOnlyList<ConfigurationValueHistory> rows)
    {
        if (rows.Count == 1)
        {
            return rows[0].TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource
                ? L["History:Targets:External"]
                : L["History:Targets:Monica"];
        }

        return rows.Any(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
            ? L["History:Targets:Mixed"]
            : L["History:Targets:Monica"];
    }

    private static Color TargetColor(IReadOnlyList<ConfigurationValueHistory> rows)
    {
        return rows.Any(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
            ? Color.Warning
            : Color.Primary;
    }

    private static Color TargetColor(ConfigurationValueHistory row)
    {
        return row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource
            ? Color.Warning
            : Color.Info;
    }

    private static string TargetIcon(IReadOnlyList<ConfigurationValueHistory> rows)
    {
        return rows.Any(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
            ? Icons.Material.Filled.Description
            : Icons.Material.Filled.Storage;
    }

    private static string TimelineIcon(ConfigurationValueHistory row)
    {
        return row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource
            ? Icons.Material.Filled.Description
            : MutationIcon(row.MutationKind);
    }

    private string ValueOrEmpty(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? L["Common:States:Empty"] : value;
    }

    private string ShortRevision(string? revision)
    {
        if (string.IsNullOrWhiteSpace(revision))
        {
            return L["Common:States:Empty"];
        }

        return revision.Length <= 12 ? revision : revision[..12];
    }

    private string StatusText(ConfigurationMutationGroupStatus status)
    {
        return L[$"Group:StatusValues:{status}"];
    }

    private string OperatorText(ConfigurationValueHistory history)
    {
        return string.IsNullOrWhiteSpace(history.ModifierName)
            ? history.ModifierId ?? L["Common:States:Empty"]
            : history.ModifierName!;
    }

    private string ReasonText(IReadOnlyList<ConfigurationValueHistory> rows)
    {
        var reason = rows
            .Select(row => row.Reason)
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
        return string.IsNullOrWhiteSpace(reason) ? L["Common:States:Empty"] : reason!;
    }

    private static string MutationIcon(ConfigurationMutationKind kind)
    {
        return kind switch
        {
            ConfigurationMutationKind.Remove => Icons.Material.Filled.Delete,
            _ => Icons.Material.Filled.Edit
        };
    }

    private async Task RollbackSelectedEntryAsync()
    {
        if (_selectedEntry is null)
        {
            return;
        }

        var parameters = new DialogParameters<RollbackConfirmationDialog>();
        string title;
        if (_selectedEntry.Id == GROUP_SUMMARY_ENTRY_ID && Group is not null)
        {
            parameters.Add(dialog => dialog.Group, Group);
            parameters.Add(dialog => dialog.GroupRows, _selectedEntry.Rows);
            title = L["Rollback:GroupTitle"];
        }
        else if (_selectedEntry.Rows.Count == 1)
        {
            var row = _selectedEntry.Rows[0];
            parameters.Add(dialog => dialog.HistoryRow, row);
            parameters.Add(dialog => dialog.GroupRows, new[] { row });
            title = L["Rollback:SingleTitle"];
        }
        else
        {
            return;
        }

        var dialog = await DialogService.ShowAsync<RollbackConfirmationDialog>(title, parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(false));
    }

    private sealed record HistoryTimelineEntry(
        string Id,
        string Title,
        string Subtitle,
        DateTimeOffset Time,
        IReadOnlyList<ConfigurationValueHistory> Rows,
        ConfigurationMutationKind MutationKind,
        long Version,
        Color Color,
        string Icon);
}
