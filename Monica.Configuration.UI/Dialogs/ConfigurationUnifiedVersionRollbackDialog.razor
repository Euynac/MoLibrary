@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog>
    <DialogContent>
        <div class="configuration-unified-version-rollback-dialog-content">
            <MudStack Spacing="3">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <MudAlert Severity="Severity.Error">@_error</MudAlert>
                    }

                    @if (_preview is not null)
                    {
                        <MudAlert Severity="@PreviewMessageSeverity" Variant="Variant.Outlined">
                            @PreviewMessage
                        </MudAlert>

                        <ConfigurationUnifiedVersionRollbackPreview Preview="_preview" />

                        @if (_preview.RequiresSchemaDriftAcknowledgement)
                        {
                            <MudCheckBox T="bool"
                                         @bind-Value="_acknowledgeSchemaDrift"
                                         Color="Color.Warning"
                                         Disabled="_saving"
                                         Label="@L["Versions:Rollback:Acknowledgement:CompatibleSchemaDrift"]" />
                        }

                        <MudTextField T="string"
                                      @bind-Value="_reason"
                                      Label="@L["Group:Reason"]"
                                      Variant="Variant.Outlined"
                                      Lines="2"
                                      Disabled="_saving" />
                    }
                }
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@(_saving || _reloading)">@L["Common:Actions:Cancel"]</MudButton>
        @if (HasRuntimeOutOfSync)
        {
            <MudButton Color="Color.Warning"
                       Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Sync"
                       OnClick="ReloadAndRefreshAsync"
                       Disabled="@(_loading || _saving || _reloading)">
                @L["Versions:Rollback:Actions:ReloadAndRefresh"]
            </MudButton>
        }
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadPreviewAsync"
                   Disabled="@(_loading || _saving || _reloading)">
            @L["Common:Actions:Refresh"]
        </MudButton>
        <MudButton Color="Color.Warning"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Restore"
                   OnClick="ApplyAsync"
                   Disabled="@(!CanApply)">
            @ApplyActionText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public long Version { get; set; }

    private ConfigurationUnifiedVersionApplyPreview? _preview;
    private string? _reason;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private bool _reloading;
    private bool _acknowledgeSchemaDrift;

    private bool CanApply =>
        !_saving && !_reloading && _preview?.CanApplyWithAcknowledgement(_acknowledgeSchemaDrift) == true;

    private bool HasRuntimeOutOfSync => _preview?.Targets.Any(static target =>
        target.Status == ConfigurationUnifiedVersionApplyTargetStatus.RuntimeOutOfSync) == true;

    private string ApplyActionText => _preview?.RequiresSchemaDriftAcknowledgement == true
        ? L["Versions:Rollback:Actions:AcknowledgeAndApply"]
        : L["Versions:Rollback:Actions:Apply"];

    private Severity PreviewMessageSeverity => _preview switch
    {
        { BlockedCount: > 0 } => Severity.Error,
        { HasChanges: false } => Severity.Info,
        { RequiresSchemaDriftAcknowledgement: true } => Severity.Warning,
        _ => Severity.Success
    };

    private string PreviewMessage => _preview switch
    {
        { BlockedCount: > 0 } => L["Versions:Rollback:Messages:Blocked"],
        { HasChanges: false } => L["Versions:Rollback:Messages:NoChanges"],
        { RequiresSchemaDriftAcknowledgement: true } => L["Versions:Rollback:Messages:CompatibleSchemaDrift"],
        _ => L["Versions:Rollback:Messages:Ready"]
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        _error = null;
        _preview = null;
        _acknowledgeSchemaDrift = false;
        try
        {
            var result = await Facade.PreviewUnifiedVersionRollbackAsync(Version);
            if (result.IsFailed(out var error, out var preview))
            {
                _error = error.Message;
                return;
            }

            _preview = preview;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyAsync()
    {
        if (_preview is null || !_preview.CanApplyWithAcknowledgement(_acknowledgeSchemaDrift))
        {
            return;
        }

        _saving = true;
        _error = null;
        var result = await Facade.RollbackUnifiedVersionAsync(new ConfigurationUnifiedVersionRollbackRequest
        {
            Version = Version,
            PreviewFingerprint = _preview.PreviewFingerprint,
            Reason = _reason,
            AcknowledgeCompatibleSchemaDrift = _acknowledgeSchemaDrift
        });
        _saving = false;
        if (result.IsFailed(out var error, out var rollback))
        {
            _error = error.Message;
            return;
        }

        MudDialog.Close(DialogResult.Ok(rollback));
    }

    private async Task ReloadAndRefreshAsync()
    {
        _reloading = true;
        _error = null;
        try
        {
            var result = await Facade.ReloadRuntimeConfigurationAsync();
            if (result.IsFailed(out var error, out _))
            {
                _error = error.Message;
                return;
            }

            await LoadPreviewAsync();
        }
        finally
        {
            _reloading = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
