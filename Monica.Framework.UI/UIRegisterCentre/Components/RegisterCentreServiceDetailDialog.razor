@using Monica.RegisterCentre.Models
@inject IStringLocalizer<RegisterCentreResource> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-3 mb-n1" />
            @L["ServiceDetailDialog:Title", Service?.AppName ?? L["Shared:Values:Unknown"].Value]
        </MudText>
    </TitleContent>
    <DialogContent>
        <RegisterCentreServiceDetail Service="@Service" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Cancel">@L["Shared:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public RegisteredServiceStatus Service { get; set; } = null!;

    private void Cancel() => MudDialog.Cancel();
}
