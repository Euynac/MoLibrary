@using Monica.Core.Execution.Models
@inject IStringLocalizer<ExecutionPipelineResource> L

@if (Plan is null)
{
    <div class="execution-pipeline-plan-detail__empty" data-testid="execution-pipeline-plan-unselected">
        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Color="Color.Secondary" Size="Size.Large" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:States:SelectPlan"]</MudText>
    </div>
}
else
{
    <article class="execution-pipeline-plan-detail" data-testid="execution-pipeline-plan-detail">
        <header class="execution-pipeline-plan-detail__header">
            <div>
                <MudTooltip Text="@Plan.Descriptor.FullName" Arrow="true" Placement="Placement.Top">
                    <MudText Typo="Typo.h5">@Plan.Descriptor.Name</MudText>
                </MudTooltip>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Plan.Descriptor.ComponentType.FullName</MudText>
            </div>
            <MudTooltip Text="@L["Page:Help:Concepts:PlanStatus"]" Arrow="true" Placement="Placement.Top">
                <ExecutionPipelineStatusBadge Status="@Plan.Status" />
            </MudTooltip>
        </header>

        <ExecutionPipelinePlanOverview Plan="@Plan" />

        @if (Plan.Error is { } error)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="execution-pipeline-plan-error">
                <ExecutionPipelineHelpLabel Text="@L["Page:Plans:Fault"]"
                                            HelpText="@L["Page:Help:Plans:Fault"]" />
                <div class="execution-pipeline-plan-detail__error-type">
                    <ExecutionPipelineHelpLabel Text="@L["Page:Plans:ExceptionType"]"
                                                HelpText="@L["Page:Help:Plans:ExceptionType"]" />
                    <span>@error.ExceptionType</span>
                </div>
                <MudText Typo="Typo.body2">@error.Message</MudText>
            </MudAlert>
        }

        @if (Plan.Status == ExecutionPipelinePlanStatus.Ready || !Plan.Behaviors.IsDefaultOrEmpty)
        {
            <ExecutionPipelineBehaviorChain Plan="@Plan" />
        }

        <ExecutionPipelineTechnicalIdentity Plan="@Plan" />
    </article>
}

@code {
    [Parameter]
    public ExecutionPipelinePlanSnapshot? Plan { get; set; }
}
