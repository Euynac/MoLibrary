@inject IStringLocalizer<SeederResource> L

@if (Session.Snapshot is { } snapshot)
{
    var run = snapshot.Run;
    <section class="seeder-run-overview" aria-labelledby="seeder-run-status-title">
        <div class="seeder-run-signature">
            <MudAlert Severity="@SeederDisplay.Severity(run.Status)"
                      Variant="Variant.Filled"
                      Icon="@SeederDisplay.Icon(run.Status)">
                <div class="seeder-run-alert-content">
                    <div class="seeder-run-identity">
                        <MudText Typo="Typo.overline">@L["Overview:RunLabel"]</MudText>
                        <div class="seeder-run-title">
                            <MudText Typo="Typo.h5" id="seeder-run-status-title">@L.GetText(run.Status)</MudText>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Filled"
                                     Color="@SeederDisplay.Color(run.ReadinessStatus)"
                                     Icon="@SeederDisplay.Icon(run.ReadinessStatus)">
                                @L["Overview:Readiness", L.GetText(run.ReadinessStatus)]
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.body2" id="seeder-run-progress-summary">
                            @L.FormatSeederRunProgress(run.CompletedCount, run.TotalCount)
                        </MudText>
                    </div>
                    <div class="seeder-run-evidence">
                        <span>@L["Overview:Duration", L.FormatSeederDuration(run.Duration)]</span>
                        <span>@L["Overview:CapturedAt", L.FormatSeederTimestamp(run.CapturedAtUtc)]</span>
                    </div>
                </div>
                <MudProgressLinear Value="@Session.ProgressPercent"
                                   Max="100"
                                   Indeterminate="@(run.Status == SeederRunStatus.Waiting && run.TotalCount == 0)"
                                   Color="Color.Inherit"
                                   Rounded="true"
                                   Class="seeder-run-progress"
                                   aria-labelledby="seeder-run-status-title seeder-run-progress-summary" />
                @if (!string.IsNullOrWhiteSpace(run.FailFastTriggerSeederTypeName))
                {
                    <div class="seeder-run-trigger">
                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" />
                        <span>@L["Overview:FailFastTrigger", run.FailFastTriggerSeederTypeName]</span>
                    </div>
                }
            </MudAlert>
        </div>

        <dl class="seeder-run-counts">
            <div>
                <dt>@L["SeederStatus:Pending"]</dt>
                <dd>@run.PendingCount</dd>
            </div>
            <div>
                <dt>@L["SeederStatus:Running"]</dt>
                <dd>@run.RunningCount</dd>
            </div>
            <div>
                <dt>@L["SeederStatus:Succeeded"]</dt>
                <dd>@run.SucceededCount</dd>
            </div>
            <div>
                <dt>@L["SeederStatus:Failed"]</dt>
                <dd>@run.FailedCount</dd>
            </div>
            <div>
                <dt>@L["SeederStatus:Blocked"]</dt>
                <dd>@run.BlockedCount</dd>
            </div>
            <div>
                <dt>@L["SeederStatus:Cancelled"]</dt>
                <dd>@run.CancelledCount</dd>
            </div>
        </dl>
    </section>
}

@code {
    [Parameter, EditorRequired] public SeederPageSession Session { get; set; } = default!;
}
