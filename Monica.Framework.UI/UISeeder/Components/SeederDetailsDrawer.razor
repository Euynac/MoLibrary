@inject IStringLocalizer<SeederResource> L

<MudDrawer Open="@Session.IsDetailsOpen"
           OpenChanged="@OnOpenChangedAsync"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Overlay="true"
           OverlayAutoClose="true"
           Fixed="true"
           Width="min(34rem, 100vw)"
           Elevation="8">
    @if (Session is { IsDetailsOpen: true, SelectedSeeder: { } seeder })
    {
        <div class="seeder-detail-focus-boundary">
            <MudFocusTrap DefaultFocus="DefaultFocus.FirstChild">
                <div id="seeder-detail-dialog"
                     class="seeder-detail-drawer"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="seeder-detail-title"
                     @onkeydown="HandleDrawerKeyDownAsync">
                    <MudDrawerHeader>
                        <div class="seeder-detail-header">
                            <div>
                                <MudText Typo="Typo.overline">@L["Details:Eyebrow"]</MudText>
                                <MudText Typo="Typo.h5"
                                         Class="seeder-detail-name"
                                         id="seeder-detail-title">
                                    @seeder.SeederName
                                </MudText>
                                <MudTooltip Text="@seeder.SeederTypeName">
                                    <code class="seeder-detail-type">@seeder.SeederTypeName</code>
                                </MudTooltip>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           OnClick="@CloseDetailsAsync"
                                           aria-label="@L["Actions:Close"]" />
                        </div>
                    </MudDrawerHeader>

                    <div class="seeder-detail-content"
                         role="region"
                         aria-labelledby="seeder-detail-title"
                         tabindex="0">
                        <div class="seeder-detail-status">
                            <MudChip T="string"
                                     Color="@SeederDisplay.Color(seeder.Status)"
                                     Icon="@SeederDisplay.Icon(seeder.Status)"
                                     Variant="Variant.Filled">
                                @L.GetText(seeder.Status)
                            </MudChip>
                            <span>@L.FormatSeederAttemptsSummary(seeder.Attempts, seeder.MaxAttempts)</span>
                        </div>

                        <section class="seeder-detail-section" aria-labelledby="seeder-policy-title">
                            <MudText Typo="Typo.subtitle1" id="seeder-policy-title">@L["Details:Policy:Title"]</MudText>
                            <dl class="seeder-detail-facts">
                                <div>
                                    <dt>@L["Details:Policy:ExecutionMode"]</dt>
                                    <dd>
                                        <span>@L.GetText(seeder.ExecutionMode)</span>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @L.GetText(seeder.ExecutionModeSource)
                                        </MudChip>
                                    </dd>
                                </div>
                                <div>
                                    <dt>@L["Details:Policy:Criticality"]</dt>
                                    <dd>
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Variant="Variant.Text"
                                                 Color="@SeederDisplay.Color(seeder.Criticality)">
                                            @L.GetText(seeder.Criticality)
                                        </MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @L.GetText(seeder.CriticalitySource)
                                        </MudChip>
                                    </dd>
                                </div>
                                <div>
                                    <dt>@L["Details:Policy:FailureBehavior"]</dt>
                                    <dd>
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Color="@SeederDisplay.Color(seeder.FailureBehavior)">
                                            @L.GetText(seeder.FailureBehavior)
                                        </MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @L.GetText(seeder.FailureBehaviorSource)
                                        </MudChip>
                                    </dd>
                                </div>
                                <div>
                                    <dt>@L["Details:Policy:MaxAttempts"]</dt>
                                    <dd>
                                        <span>@seeder.MaxAttempts</span>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @L.GetText(seeder.MaxAttemptsSource)
                                        </MudChip>
                                    </dd>
                                </div>
                            </dl>
                        </section>

                        <section class="seeder-detail-section" aria-labelledby="seeder-timing-title">
                            <MudText Typo="Typo.subtitle1" id="seeder-timing-title">@L["Details:Timing:Title"]</MudText>
                            <dl class="seeder-detail-facts">
                                <div>
                                    <dt>@L["Details:Timing:StartedAt"]</dt>
                                    <dd>@L.FormatSeederTimestamp(seeder.StartedAtUtc)</dd>
                                </div>
                                <div>
                                    <dt>@L["Details:Timing:CompletedAt"]</dt>
                                    <dd>@L.FormatSeederTimestamp(seeder.CompletedAtUtc)</dd>
                                </div>
                                <div>
                                    <dt>@L["Details:Timing:Duration"]</dt>
                                    <dd>@L.FormatSeederDuration(seeder.Duration)</dd>
                                </div>
                            </dl>
                        </section>

                        <section class="seeder-detail-section" aria-labelledby="seeder-dependencies-title">
                            <MudText Typo="Typo.subtitle1" id="seeder-dependencies-title">@L["Details:Dependencies:Title"]</MudText>
                            @if (seeder.Dependencies.Length == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Details:Dependencies:None"]</MudText>
                            }
                            else
                            {
                                <ul class="seeder-dependency-list">
                                    @foreach (var dependency in seeder.Dependencies)
                                    {
                                        var dependencySnapshot = FindDependency(dependency);
                                        <li>
                                            <div class="seeder-dependency-evidence">
                                                <code>@dependency</code>
                                                @if (dependencySnapshot is not null)
                                                {
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Variant="Variant.Outlined"
                                                             Color="@SeederDisplay.Color(dependencySnapshot.Status)">
                                                        @L.GetText(dependencySnapshot.Status)
                                                    </MudChip>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(dependencySnapshot?.ErrorMessage))
                                            {
                                                <span class="seeder-dependency-diagnostic">@dependencySnapshot.ErrorMessage</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </section>

                        <section class="seeder-detail-section" aria-labelledby="seeder-attempts-title">
                            <div class="seeder-detail-section-heading">
                                <MudText Typo="Typo.subtitle1" id="seeder-attempts-title">@L["Details:Attempts:Title"]</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L.FormatSeederRecordedAttempts(seeder.AttemptHistory.Length)
                                </MudText>
                            </div>
                            @if (seeder.AttemptHistory.Length == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Details:Attempts:None"]</MudText>
                            }
                            else
                            {
                                <ol class="seeder-attempt-list">
                                    @foreach (var attempt in seeder.AttemptHistory.OrderBy(static attempt => attempt.AttemptNumber))
                                    {
                                        <li data-testid="seeder-attempt-row">
                                            <div class="seeder-attempt-heading">
                                                <strong>@L["Details:Attempts:Number", attempt.AttemptNumber]</strong>
                                                <MudChip T="string"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Color="@SeederDisplay.Color(attempt.Status)">
                                                    @L.GetText(attempt.Status)
                                                </MudChip>
                                            </div>
                                            <dl class="seeder-attempt-facts">
                                                <div>
                                                    <dt>@L["Details:Timing:StartedAt"]</dt>
                                                    <dd>@L.FormatSeederTimestamp(attempt.StartedAtUtc)</dd>
                                                </div>
                                                <div>
                                                    <dt>@L["Details:Timing:CompletedAt"]</dt>
                                                    <dd>@L.FormatSeederTimestamp(attempt.CompletedAtUtc)</dd>
                                                </div>
                                                <div>
                                                    <dt>@L["Details:Timing:Duration"]</dt>
                                                    <dd>@L.FormatSeederDuration(attempt.Duration)</dd>
                                                </div>
                                            </dl>
                                            @if (!string.IsNullOrWhiteSpace(attempt.ErrorType) ||
                                                 !string.IsNullOrWhiteSpace(attempt.ErrorMessage))
                                            {
                                                <div class="seeder-attempt-error">
                                                    @if (!string.IsNullOrWhiteSpace(attempt.ErrorType))
                                                    {
                                                        <code>@attempt.ErrorType</code>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(attempt.ErrorMessage))
                                                    {
                                                        <span>@attempt.ErrorMessage</span>
                                                    }
                                                </div>
                                            }
                                        </li>
                                    }
                                </ol>
                            }
                        </section>

                        @if (!string.IsNullOrWhiteSpace(seeder.ErrorType) || !string.IsNullOrWhiteSpace(seeder.ErrorMessage))
                        {
                            <MudAlert Severity="Severity.Error"
                                      Variant="Variant.Outlined"
                                      Icon="@Icons.Material.Filled.BugReport">
                                <MudText Typo="Typo.subtitle2">@L["Details:Error:Title"]</MudText>
                                <dl class="seeder-detail-error">
                                    <div>
                                        <dt>@L["Details:Error:Type"]</dt>
                                        <dd><code>@seeder.ErrorType</code></dd>
                                    </div>
                                    <div>
                                        <dt>@L["Details:Error:Message"]</dt>
                                        <dd>@seeder.ErrorMessage</dd>
                                    </div>
                                </dl>
                                <MudText Typo="Typo.caption">@L["Details:Error:LogsHint"]</MudText>
                            </MudAlert>
                        }
                    </div>
                </div>
            </MudFocusTrap>
        </div>
    }
</MudDrawer>

@code {
    [Parameter, EditorRequired] public SeederPageSession Session { get; set; } = default!;

    private SeederExecutionSnapshot? FindDependency(string seederTypeName)
    {
        return Session.Snapshot?.Run.Seeders.FirstOrDefault(seeder => string.Equals(
            seeder.SeederTypeName,
            seederTypeName,
            StringComparison.Ordinal));
    }

    private Task OnOpenChangedAsync(bool open) => open || !Session.IsDetailsOpen
        ? Task.CompletedTask
        : CloseDetailsAsync();

    private Task HandleDrawerKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape"
            ? CloseDetailsAsync()
            : Task.CompletedTask;

    private Task CloseDetailsAsync() => Session.CloseDetailsAsync();
}
