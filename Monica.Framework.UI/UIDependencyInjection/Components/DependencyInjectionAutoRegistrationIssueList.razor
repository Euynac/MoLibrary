@using Microsoft.Extensions.DependencyInjection
@using Monica.DependencyInjection.Models
@inject IStringLocalizer<DependencyInjectionResource> L

<MudStack Spacing="2">
    @foreach (var issue in Items)
    {
        <MudAlert Severity="@GetAlertSeverity(issue.Severity)" Variant="Variant.Outlined">
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2">@GetIssueTitle(issue)</MudText>
                <MudText Typo="Typo.body2">@GetIssueDescription(issue)</MudText>

                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
                    <MudChip T="string" Size="Size.Small" Color="@GetChipColor(issue.Severity)" Variant="Variant.Filled">
                        @L[$"Page:Shared:IssueSeverities:{issue.Severity}"]
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                        @issue.SourceImplementationTypeDisplayName
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                        @L[$"Page:Shared:Lifetimes:{issue.Lifetime}"]
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                        @L[$"Page:Shared:LifetimeSources:{issue.LifetimeSource}"]
                    </MudChip>
                </MudStack>

                @if (issue.ExposedServices.Count > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["Page:Dialog:Fields:ExposedServices"]
                    </MudText>

                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var exposedService in issue.ExposedServices)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @GetExposedServiceText(exposedService)
                            </MudChip>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudAlert>
    }
</MudStack>

@code {
    [Parameter]
    public IReadOnlyList<DependencyInjectionAutoRegistrationIssueInfo> Items { get; set; } = [];

    private Severity GetAlertSeverity(DependencyInjectionDiagnosticSeverity severity)
    {
        return severity == DependencyInjectionDiagnosticSeverity.Error
            ? Severity.Error
            : Severity.Warning;
    }

    private Color GetChipColor(DependencyInjectionDiagnosticSeverity severity)
    {
        return severity == DependencyInjectionDiagnosticSeverity.Error
            ? Color.Error
            : Color.Warning;
    }

    private string GetIssueTitle(DependencyInjectionAutoRegistrationIssueInfo issue)
    {
        return L[$"Page:Shared:IssueKinds:{issue.Kind}:Title"];
    }

    private string GetIssueDescription(DependencyInjectionAutoRegistrationIssueInfo issue)
    {
        return issue.Kind switch
        {
            DependencyInjectionAutoRegistrationIssueKind.MissingExposedServices => L[
                $"Page:Shared:IssueKinds:{issue.Kind}:Description",
                issue.SourceImplementationTypeDisplayName,
                L[$"Page:Shared:Lifetimes:{issue.Lifetime}"]],
            DependencyInjectionAutoRegistrationIssueKind.ConcreteTypeOnlyExposure => L[
                $"Page:Shared:IssueKinds:{issue.Kind}:Description",
                issue.SourceImplementationTypeDisplayName],
            _ => issue.SourceImplementationTypeDisplayName
        };
    }

    private string GetExposedServiceText(DependencyInjectionExposedServiceInfo exposedService)
    {
        return exposedService.IsKeyedService
            ? $"{exposedService.ServiceTypeDisplayName} ({exposedService.ServiceKey})"
            : exposedService.ServiceTypeDisplayName;
    }
}
