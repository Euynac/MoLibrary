@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.Components
@using Monica.Core.Results
@using Monica.EventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.Framework.UI.UIEventBus.State
@inject EventBusMonitorService MonitorService
@inject EventBusTestService TestService
@inject EventBusProviderDiscoveryService ProviderDiscoveryService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<EventBusResource> L

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<div class="event-bus-page">
<MudContainer MaxWidth="MaxWidth.False" Class="event-bus-page__outer-container">
    <div class="event-bus-page__container">
    <header class="event-bus-page__header">
        <div class="event-bus-page__eyebrow">
            <span class="event-bus-page__eyebrow-line" aria-hidden="true"></span>
            <span>@L["Page:Header:Eyebrow"]</span>
        </div>
        <div class="event-bus-page__heading-row">
            <div>
                <MudText Typo="Typo.h3" HtmlTag="h1">@L["Page:Header:Title"]</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="event-bus-page__description">
                    @L["Page:Header:Description"]
                </MudText>
            </div>
            <MudButton StartIcon="@Icons.Material.Filled.Refresh"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="RefreshAsync"
                       Disabled="@_loading">
                    @L["Page:Header:Refresh"]
            </MudButton>
        </div>
    </header>

    <section class="event-bus-page__pulse" aria-label="@L["Page:Summary:AriaLabel"]">
        <article class="event-bus-pulse event-bus-pulse--primary">
            <MudIcon Icon="@Icons.Material.Filled.Subscriptions" />
            <span><small>@L["Page:Summary:Subscriptions"]</small><strong>@(_statistics?.TotalSubscriptions ?? _subscriptions.Count)</strong></span>
        </article>
        <article class="event-bus-pulse event-bus-pulse--success">
            <MudIcon Icon="@Icons.Material.Filled.Bolt" />
            <span><small>@L["Page:Summary:Active"]</small><strong>@(_statistics?.ActiveSubscriptions ?? 0)</strong></span>
        </article>
        <article class="event-bus-pulse event-bus-pulse--error">
            <MudIcon Icon="@Icons.Material.Filled.HeartBroken" />
            <span><small>@L["Page:Summary:Unhealthy"]</small><strong>@(_statistics?.UnhealthySubscriptions ?? 0)</strong></span>
        </article>
        <article class="event-bus-pulse event-bus-pulse--info">
            <MudIcon Icon="@Icons.Material.Filled.Hub" />
            <span><small>@L["Page:Summary:Providers"]</small><strong>@_providers.Count</strong></span>
        </article>
        <article class="event-bus-pulse event-bus-pulse--tertiary">
            <MudIcon Icon="@Icons.Material.Filled.Update" />
            <span><small>@L["Page:Summary:RecentChanges"]</small><strong>@_recentChanges.Count</strong></span>
        </article>
    </section>

    @if (_loading && _subscriptions.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="pa-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Color="Color.Primary">@L["Page:States:LoadingSubscriptions"]</MudText>
        </MudStack>
    }
    else
    {
        <!-- Tabs -->
        <div class="ui-event-bus-tabs">
            <MudTabs Elevation="0" Rounded="false" TabPanelsClass="ui-event-bus-tab-panels">
                <MudTabPanel Text="@L["Page:Tabs:Overview"]" Icon="@Icons.Material.Filled.Dashboard">
                    <SubscriptionStatisticsCard Statistics="_statistics"
                                               OnEventTypeClick="ShowSubscriptionsByEventTypeAsync"
                                               OnTopicClick="ShowSubscriptionsByTopicAsync" />

                    @if (_recentChanges.Any())
                    {
                        <MudPaper Class="event-bus-recent-changes" Elevation="0" Outlined="true">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Update" Color="Color.Info" />
                                        <MudText Typo="Typo.h6">@L["Page:RecentChanges:Title"]</MudText>
                                    </MudStack>
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                        @L["ChangesFeed:Count", _recentChanges.Count]
                                    </MudChip>
                                </MudStack>

                                <MudList T="string" ReadOnly="true" Dense="true" Class="event-bus-recent-changes__list">
                                    @foreach (var change in _recentChanges.Take(20))
                                    {
                                        <MudListItem T="string">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudIcon Icon="@change.ChangeTypeIcon" Color="@change.ChangeTypeColor" Size="Size.Small" />
                                                    <MudChip T="string" Color="@change.ChangeTypeColor" Size="Size.Small">
                                                        @L.GetSubscriptionChangeTypeText(change.ChangeType)
                                                    </MudChip>
                                                    <MudText Typo="Typo.body2">@change.Subscription.EventTypeShortName</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@change.TimestampDisplay</MudText>
                                                </MudStack>
                                                <MudChip T="string" Color="@change.Subscription.ScopeColor" Size="Size.Small">
                                                    @L.GetSubscriptionScopeText(change.Subscription.Scope)
                                                </MudChip>
                                            </MudStack>
                                        </MudListItem>
                                    }
                                </MudList>
                            </MudStack>
                        </MudPaper>
                    }
                </MudTabPanel>

                <MudTabPanel Text="@L["Page:Tabs:Providers"]" Icon="@Icons.Material.Filled.Hub" BadgeData="@_providers.Count.ToString()" BadgeColor="Color.Primary">
                    <EventBusProviderList Providers="_providers"
                                         AllSubscriptions="_subscriptions"
                                         IsLoading="_loading"
                                         OnRefresh="RefreshProvidersAsync" />
                </MudTabPanel>

                <MudTabPanel Text="@L["Page:Tabs:Subscriptions"]" Icon="@Icons.Material.Filled.List">
                    <SubscriptionFilterPanel Filter="_filter"
                                            Providers="_providers"
                                            OnFilterChanged="ApplyFilterAsync" />

                    <SubscriptionTable Subscriptions="_displayedSubscriptions"
                                      Loading="_loading"
                                      ActiveTestListenerIds="@_activeTestListenerIds"
                                      OnRowClick="ShowSubscriptionDetail"
                                      OnActivate="ActivateSubscriptionAsync"
                                      OnDeactivate="DeactivateSubscriptionAsync"
                                      OnUnsubscribe="UnsubscribeWithConfirmAsync"
                                      OnTest="ShowSubscriptionTestAsync" />
                </MudTabPanel>

                <MudTabPanel Text="@L["Page:Tabs:TestTools"]" Icon="@Icons.Material.Filled.Science">
                    <EventBusTestPanel />
                </MudTabPanel>
            </MudTabs>
        </div>
    }
    </div>
</MudContainer>
</div>

@code {
    public const string PAGE_URL = "/event-bus-monitor";

    private bool _loading = true;
    private readonly CancellationTokenSource _cts = new();
    private Task? _monitorTask;
    private bool _disposed;

    // data
    private List<SubscriptionViewModel> _subscriptions = new();
    private List<SubscriptionViewModel> _displayedSubscriptions = new();
    private SubscriptionStatistics? _statistics;
    private List<SubscriptionChangeViewModel> _recentChanges = new();
    private List<EventBusProviderInfo> _providers = new();
    private IReadOnlySet<string> _activeTestListenerIds = new HashSet<string>();

    // filter
    private SubscriptionFilter _filter = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDataAsync();

            // Start real-time monitoring
            if (_disposed)
            {
                return;
            }

            _monitorTask = ListenToChangesAsync(_cts.Token);

            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        if (_disposed)
        {
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            // Load subscription list
            if ((await MonitorService.GetAllSubscriptionsAsync()).IsFailed(out var error, out var subscriptions))
            {
                Snackbar.Add(L["Page:Messages:LoadSubscriptionsFailed", error], Severity.Error);
            }
            else
            {
                _subscriptions = subscriptions ?? new();
                await ApplyFilterAsync();
            }

            // Load statistics
            if ((await MonitorService.GetStatisticsAsync()).IsFailed(out var statsError, out var stats))
            {
                Snackbar.Add(L["Page:Messages:LoadStatisticsFailed", statsError], Severity.Error);
            }
            else
            {
                _statistics = stats;
            }

            // Load provider list
            if (ProviderDiscoveryService.GetRegisteredProviders().IsFailed(out var providerError, out var providers))
            {
                Snackbar.Add(L["Page:Messages:LoadProvidersFailed", providerError], Severity.Error);
            }
            else
            {
                _providers = providers ?? new();
            }

            RefreshActiveTestListeners();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Page:Messages:LoadDataFailed", ex.Message], Severity.Error);
        }
        finally
        {
            _loading = false;
            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private async Task RefreshAsync()
    {
        await LoadDataAsync();
        Snackbar.Add(L["Page:Messages:RefreshSucceeded"], Severity.Success);
    }

    private Task ApplyFilterAsync()
    {
        if (_filter.HasAnyFilter)
        {
            _displayedSubscriptions = _subscriptions.Where(s =>
            {
                if (_filter.State.HasValue && s.State != _filter.State.Value)
                    return false;

                if (_filter.TopicRuntimeState.HasValue && s.TopicRuntimeState != _filter.TopicRuntimeState.Value)
                    return false;

                if (_filter.Scope.HasValue && s.Scope != _filter.Scope.Value)
                    return false;

                if (_filter.IsAutoDiscovered.HasValue && s.IsAutoDiscovered != _filter.IsAutoDiscovered.Value)
                    return false;

                if (!string.IsNullOrWhiteSpace(_filter.SearchText))
                {
                    var searchText = _filter.SearchText.ToLowerInvariant();
                    if (!s.EventType.ToLowerInvariant().Contains(searchText) &&
                        !s.TopicName.ToLowerInvariant().Contains(searchText))
                        return false;
                }

                // Provider filter
                if (_filter.SelectedProvider != null)
                {
                    var keyMatches = s.ServiceKey == _filter.SelectedProvider.ServiceKey;
                    var scopeMatches = _filter.SelectedProvider.IsDistributed
                        ? s.Scope == EventSubscriptionScope.Distributed
                        : s.Scope == EventSubscriptionScope.Local;
                    if (!keyMatches || !scopeMatches)
                        return false;
                }

                return true;
            }).ToList();
        }
        else
        {
            _displayedSubscriptions = _subscriptions;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RefreshProvidersAsync()
    {
        if (ProviderDiscoveryService.GetRegisteredProviders().IsFailed(out var providerError, out var providers))
        {
            Snackbar.Add(L["Page:Messages:RefreshProvidersFailed", providerError], Severity.Error);
        }
        else
        {
            _providers = providers ?? new();
            Snackbar.Add(L["Page:Messages:RefreshProvidersSucceeded"], Severity.Success);
            StateHasChanged();
        }
    }

    private async Task ListenToChangesAsync(CancellationToken ct)
    {
        try
        {
            var reader = MonitorService.SubscribeToChanges();
            await foreach (var change in reader.ReadAllAsync(ct))
            {
                // Only registry changes feed the recent-changes list; runtime-status changes
                // still trigger a refresh of the subscriptions and statistics.
                if (change is EventBusMonitorChange.SubscriptionChanged subscriptionChange)
                {
                    _recentChanges.Insert(0, subscriptionChange.Change);
                    if (_recentChanges.Count > 100)
                    {
                        _recentChanges.RemoveAt(100);
                    }
                }

                // Refresh subscription list and statistics
                await RefreshSubscriptionsAsync();
                RefreshActiveTestListeners();

                if (_disposed)
                {
                    return;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on disposal
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                await InvokeAsync(() => Snackbar.Add(L["Page:Messages:RealtimeUpdateFailed", ex.Message], Severity.Error));
            }
        }
    }

    private async Task RefreshSubscriptionsAsync()
    {
        if ((await MonitorService.GetAllSubscriptionsAsync()).IsFailed(out _, out var subscriptions))
        {
            return;
        }

        _subscriptions = subscriptions ?? new();
        await ApplyFilterAsync();

        if ((await MonitorService.GetStatisticsAsync()).IsFailed(out _, out var stats))
        {
            return;
        }

        _statistics = stats;
    }

    private async Task ShowSubscriptionDetail(SubscriptionViewModel subscription)
    {
        var parameters = new DialogParameters
        {
            ["Subscription"] = subscription
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        await DialogService.ShowAsync<SubscriptionDetailDialog>(L["Page:DialogTitles:SubscriptionDetail", subscription.EventTypeShortName], parameters, options);
    }

    private async Task ShowSubscriptionTestAsync(SubscriptionViewModel subscription)
    {
        var parameters = new DialogParameters
        {
            ["Subscription"] = subscription
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<SubscriptionTestDialog>(L["Page:DialogTitles:SubscriptionTest", subscription.EventTypeShortName], parameters, options);
        await dialog.Result;
        RefreshActiveTestListeners();
        StateHasChanged();
    }

    private async Task ShowSubscriptionsByEventTypeAsync(string eventType)
    {
        var filteredSubscriptions = _subscriptions
            .Where(s => s.EventType == eventType)
            .ToList();

        var parameters = new DialogParameters
        {
            ["Title"] = L["Page:DialogTitles:EventTypeSubscriptions", filteredSubscriptions.FirstOrDefault()?.EventTypeShortName ?? eventType].Value,
            ["Subscriptions"] = filteredSubscriptions,
            ["OnSubscriptionSelected"] = EventCallback.Factory.Create<SubscriptionViewModel>(this, ShowSubscriptionDetail)
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        };

        await DialogService.ShowAsync<SubscriptionListDialog>(L["Page:DialogTitles:SubscriptionList"], parameters, options);
    }

    private async Task ShowSubscriptionsByTopicAsync(string topicName)
    {
        var filteredSubscriptions = _subscriptions
            .Where(s => s.TopicName == topicName)
            .ToList();

        var parameters = new DialogParameters
        {
            ["Title"] = L["Page:DialogTitles:TopicSubscriptions", topicName].Value,
            ["Subscriptions"] = filteredSubscriptions,
            ["OnSubscriptionSelected"] = EventCallback.Factory.Create<SubscriptionViewModel>(this, ShowSubscriptionDetail)
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        };

        await DialogService.ShowAsync<SubscriptionListDialog>(L["Page:DialogTitles:SubscriptionList"], parameters, options);
    }

    private async Task ActivateSubscriptionAsync(SubscriptionViewModel subscription)
    {
        var subscriptionId = new EventSubscriptionId(Guid.Parse(subscription.SubscriptionId));
        if ((await MonitorService.ActivateSubscriptionAsync(subscriptionId)).IsFailed(out var error))
        {
            Snackbar.Add(L["Page:Messages:ActivateFailed", error.Message ?? string.Empty], Severity.Error);
        }
        else
        {
            Snackbar.Add(L["Page:Messages:ActivateSucceeded"], Severity.Success);
        }
    }

    private void RefreshActiveTestListeners()
    {
        _activeTestListenerIds = TestService.GetActiveRuntimeListenerIds();
    }

    private async Task DeactivateSubscriptionAsync(SubscriptionViewModel subscription)
    {
        var subscriptionId = new EventSubscriptionId(Guid.Parse(subscription.SubscriptionId));
        if ((await MonitorService.DeactivateSubscriptionAsync(subscriptionId)).IsFailed(out var error))
        {
            Snackbar.Add(L["Page:Messages:DeactivateFailed", error.Message ?? string.Empty], Severity.Error);
        }
        else
        {
            Snackbar.Add(L["Page:Messages:DeactivateSucceeded"], Severity.Warning);
        }
    }

    private async Task UnsubscribeWithConfirmAsync(SubscriptionViewModel subscription)
    {
        // Simplified processing: perform removal directly without displaying a confirmation dialog box
        // In a production environment, you can use MudBlazor's IDialogService to display a confirmation dialog
        var subscriptionId = new EventSubscriptionId(Guid.Parse(subscription.SubscriptionId));
        if (TestService.GetRuntimeListenerSnapshot(subscriptionId).IsListening
            && (await TestService.StopRuntimeListenerAsync(subscriptionId)).IsFailed(out var stopError))
        {
            Snackbar.Add(L["Page:Messages:StopRuntimeListenerFailed", stopError.Message ?? string.Empty], Severity.Error);
            return;
        }

        if ((await MonitorService.UnsubscribeAsync(subscriptionId)).IsFailed(out var error))
        {
            Snackbar.Add(L["Page:Messages:UnsubscribeFailed", error.Message ?? string.Empty], Severity.Error);
        }
        else
        {
            Snackbar.Add(L["Page:Messages:UnsubscribeSucceeded"], Severity.Info);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        await _cts.CancelAsync();
        if (_monitorTask is not null)
        {
            try
            {
                await _monitorTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
        _cts.Dispose();
    }
}
