@attribute [Route(PAGE_URL)]

@using Monica.Framework.UI.UIProjectUnits.Components
@inject IStringLocalizer<ProjectUnitsResource> L

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<div class="project-units-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="project-units-page__outer-container">
        <div class="project-units-page__container">
            <header class="project-units-page__header">
                <div class="project-units-page__eyebrow">
                    <span class="project-units-page__eyebrow-line" aria-hidden="true"></span>
                    <span>@L["Page:Header:Eyebrow"]</span>
                </div>
                <div class="project-units-page__heading-row">
                    <div>
                        <MudText Typo="Typo.h3" HtmlTag="h1" Class="project-units-page__title">@L["Page:Header:Title"]</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="project-units-page__description">
                            @L["Page:Header:Description"]
                        </MudText>
                    </div>
                    <div class="project-units-page__header-mark" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
                    </div>
                </div>
            </header>

            <div class="project-units-page__content">
                <MudTabs Elevation="0"
                         Rounded="false"
                         Class="project-units-page__workspace">
                    <MudTabPanel Text="@L["Page:Tabs:StatusOverview"]"
                                 Icon="@Icons.Material.Filled.SpaceDashboard"
                                 PanelClass="project-units-tab-panel">
                        <ProjectUnitDashboard />
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Page:Tabs:ProjectUnit"]"
                                 Icon="@Icons.Material.Filled.AccountTree"
                                 PanelClass="project-units-tab-panel">
                        <ProjectUnitMonitor />
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Page:Tabs:ArchitectureVisualization"]"
                                 Icon="@Icons.Material.Filled.Hub"
                                 PanelClass="project-units-tab-panel">
                        <ProjectUnitVisualization />
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Page:Tabs:DomainEventTester"]"
                                 Icon="@Icons.Material.Filled.Event"
                                 PanelClass="project-units-tab-panel">
                        <DomainEventTester />
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Page:Tabs:RequestFilterManager"]"
                                 Icon="@Icons.Material.Filled.FilterAlt"
                                 PanelClass="project-units-tab-panel">
                        <RequestFilterManager />
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Page:Tabs:EnumInfo"]"
                                 Icon="@Icons.Material.Filled.DataObject"
                                 PanelClass="project-units-tab-panel">
                        <EnumInfoViewer />
                    </MudTabPanel>
                </MudTabs>
            </div>
        </div>
    </MudContainer>
</div>

@code {
    public const string PAGE_URL = "/project-units";
}
