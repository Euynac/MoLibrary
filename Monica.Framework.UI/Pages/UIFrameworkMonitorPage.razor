@attribute [Route(FRAMEWORK_MONITOR_DEBUG_URL)]

@using Monica.Framework.UI.UIFrameworkMonitor.Components
@inject IStringLocalizer<FrameworkMonitorResource> L

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<div class="framework-monitor-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="framework-monitor-page__outer-container">
        <div class="framework-monitor-page__container">
            <div class="framework-monitor-page__header">
                <MudText Typo="Typo.h4">@L["Page:Header:Title"]</MudText>
            </div>

            <div class="framework-monitor-page__content">
                <MudTabs Elevation="1"
                         Rounded="true"
                         ApplyEffectsToContainer="true"
                         Class="framework-monitor-tabs">
                    <MudTabPanel Text="@L["Page:Tabs:ProjectUnit"]"
                                 Icon="@Icons.Material.Filled.AccountTree"
                                 PanelClass="framework-monitor-tab-panel">
                        <ProjectUnitMonitor />
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Page:Tabs:ArchitectureVisualization"]"
                                 Icon="@Icons.Material.Filled.Hub"
                                 PanelClass="framework-monitor-tab-panel">
                        <ProjectUnitVisualization />
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Page:Tabs:DomainEventTester"]"
                                 Icon="@Icons.Material.Filled.Event"
                                 PanelClass="framework-monitor-tab-panel">
                        <DomainEventTester />
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Page:Tabs:RequestFilterManager"]"
                                 Icon="@Icons.Material.Filled.FilterAlt"
                                 PanelClass="framework-monitor-tab-panel">
                        <RequestFilterManager />
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Page:Tabs:EnumInfo"]"
                                 Icon="@Icons.Material.Filled.List"
                                 PanelClass="framework-monitor-tab-panel">
                        <EnumInfoViewer />
                    </MudTabPanel>
                </MudTabs>
            </div>
        </div>
    </MudContainer>
</div>

@code {
    public const string FRAMEWORK_MONITOR_DEBUG_URL = "/framework-monitor";
}
