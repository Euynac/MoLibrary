@attribute [Route(PAGE_URL)]
@using System.Diagnostics
@using System.Threading.Channels
@using Microsoft.Extensions.Logging
@using Monica.Framework.UI.UILogging.Components
@using Monica.Framework.UI.UILogging.Models
@using Monica.Framework.UI.UILogging.State
@using Monica.Core.Results
@using Monica.Framework.UI.UILogging.Support

@inject LoggingService LoggingService
@inject LogFileQueryService LogFileQueryService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ILogger<UILoggingMonitorPage> Logger
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<LoggingResource> L

@implements IAsyncDisposable

<PageTitle>@L["Page:Title"]</PageTitle>

<div class="logging-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="logging-page__outer-container">
        <div class="logging-page__container">
            <header class="logging-page__header">
                <div class="logging-page__eyebrow"><span aria-hidden="true"></span><span>@L["Page:Eyebrow"]</span></div>
                <div class="logging-page__heading-row">
                    <div><MudText Typo="Typo.h3" HtmlTag="h1">@L["Page:Heading"]</MudText><MudText Typo="Typo.body1" Color="Color.Secondary">@L["Page:Description"]</MudText></div>
                    <MudChip T="string" Icon="@(_isRunning ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)" Color="@(_isRunning ? Color.Success : Color.Warning)" Variant="Variant.Outlined">@L[_isRunning ? "Page:State:Running" : "Page:State:Paused"]</MudChip>
                </div>
            </header>

            <section class="logging-page__pulse" aria-label="@L["Page:Summary:AriaLabel"]">
                <article class="logging-pulse logging-pulse--primary"><MudIcon Icon="@Icons.Material.Filled.Description" /><span><small>@L["Page:Summary:File"]</small><strong title="@_currentLogFilePath">@(_currentLogFilePath is null ? L["Page:State:NotDetected"] : Path.GetFileName(_currentLogFilePath))</strong></span></article>
                <article class="logging-pulse logging-pulse--info"><MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" /><span><small>@L["Page:Summary:Lines"]</small><strong>@_totalFileLineCount.ToString("N0")</strong></span></article>
                <article class="logging-pulse logging-pulse--tertiary"><MudIcon Icon="@Icons.Material.Filled.Memory" /><span><small>@L["Page:Summary:Buffer"]</small><strong>@_currentLines.Count.ToString("N0")</strong></span></article>
                <article class="logging-pulse logging-pulse--success"><MudIcon Icon="@Icons.Material.Filled.Speed" /><span><small>@L["Page:Summary:LoadTime"]</small><strong>@L["Page:Summary:Milliseconds", _initLoadTimeMs]</strong></span></article>
            </section>

            @if (_isInitializing)
            {
                <div class="logging-page__loading" role="status"><MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" /><MudText Typo="Typo.h6">@L["Page:State:Loading"]</MudText></div>
            }
            else
            {
                <div class="logging-page__workspace">
                    <MudTabs Elevation="0" Rounded="false" TabPanelsClass="logging-page__tab-content">
                        <MudTabPanel Text="@L["Page:Tabs:Realtime"]" Icon="@Icons.Material.Filled.Timeline">
                            <div class="realtime-log-panel">
                                @if (!_logFileExists)
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                        <div class="logging-alert-row"><span>@L["Page:State:FileMissing", _currentLogFilePath ?? L["Page:State:NotConfigured"]]</span><MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="OpenFileSwitchDialog">@L["Page:Actions:SwitchFile"]</MudButton></div>
                                    </MudAlert>
                                }
                                <div class="logging-command-row">
                                    <LoggingToolbar IsRunning="@_isRunning" AutoScroll="@_autoScroll" AutoScrollChanged="OnAutoScrollChanged" SelectedLineLimit="@_selectedLineLimit" PresetLineCounts="@LoggingService.UIOption.PresetLineCounts" LineLimitChanged="OnLineLimitChanged" StartRequested="StartTailAsync" PauseRequested="PauseTailAsync" RefreshRequested="ReloadSnapshotAsync" ExportRequested="ExportBuffer" />
                                    <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Primary" OnClick="OpenFileSwitchDialog" title="@L["Page:Actions:SwitchFile"]" aria-label="@L["Page:Actions:SwitchFile"]" />
                                </div>
                                <LogFilterPanel Keyword="@_filterKeyword" OnlyCapture="@_onlyCapture" IsApplying="@_isApplyingFilter" KeywordChanged="OnKeywordChanged" OnlyCaptureChanged="OnOnlyCaptureChanged" ApplyRequested="ApplyFilterAsync" ClearRequested="ClearFilterAsync" />
                                <div class="viewer-section">
                                    @if (_isContextMode && _contextTargetLine is { } contextTargetLine)
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true"><div class="logging-alert-row"><span>@L["Page:Context:Viewing", contextTargetLine]</span><MudButton OnClick="ExitContextMode" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">@L["Page:Actions:Back"]</MudButton></div></MudAlert>
                                    }
                                    <LogViewer @ref="_logViewerRef" Lines="@_currentLines" Version="@_currentVersion" AutoScroll="@_autoScroll" Filter="@_snapshot?.Filter" OnLineClicked="HandleLineClick" OnShowContext="HandleShowContext" OnApplyFilter="HandleApplyFilter" LoadMoreRequested="HandleLoadMoreAsync" />
                                </div>
                            </div>
                        </MudTabPanel>
                        <MudTabPanel Text="@L["Page:Tabs:Files"]" Icon="@Icons.Material.Filled.Folder"><div class="file-table-panel"><LogFileTable Files="@_logFiles" IsLoading="@_filesLoading" CurrentDirectory="@_logDirectory" RefreshRequested="RefreshFilesAsync" DownloadRequested="DownloadFileAsync" /></div></MudTabPanel>
                    </MudTabs>
                </div>
            }
        </div>
    </MudContainer>
</div>

<MudDialog @bind-Visible="_fileSwitchDialogVisible">
    <TitleContent><MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"><MudIcon Icon="@Icons.Material.Filled.SwapHoriz" /><MudText>@L["Page:FileDialog:Title"]</MudText></MudStack></TitleContent>
    <DialogContent>
        @if (_filesLoading) { <div class="logging-dialog-state"><MudProgressCircular Indeterminate="true" Size="Size.Medium" /><MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:FileDialog:Loading"]</MudText></div> }
        else if (_logFiles.Count == 0) { <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">@L["Page:FileDialog:Empty"]</MudAlert> }
        else
        {
            <MudList T="LogFileDescriptor" @bind-SelectedValue="_selectedSwitchFile" Dense="true" Class="file-list">
                @foreach (var file in _logFiles)
                {
                    <MudListItem T="LogFileDescriptor" Value="file" Class="@(file == _selectedSwitchFile ? "selected-file" : "")"><div class="logging-file-row"><span><MudText Typo="Typo.body2">@file.FileName</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@file.RelativePath</MudText></span><span><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@FormatFileSize(file.Size)</MudChip><MudText Typo="Typo.caption" Color="Color.Secondary">@file.LastModified.ToString("MM-dd HH:mm")</MudText></span></div></MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="CloseFileSwitchDialog">@L["Page:Actions:Cancel"]</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SwitchToSelectedFile" Disabled="@(_selectedSwitchFile == null)">@L["Page:Actions:Confirm"]</MudButton></DialogActions>
</MudDialog>

@code {
    public const string PAGE_URL = "/logging-monitor";

    private ScreenLogSnapshot? _snapshot;
    private bool _isInitializing = true;
    private bool _isRunning;
    private bool _autoScroll = true;
    private bool _isApplyingFilter;
    private int _selectedLineLimit;
    private string? _filterKeyword;
    private bool _onlyCapture;
    private List<LogFileDescriptor> _logFiles = new();
    private bool _filesLoading;
    private string? _logDirectory;
    private string? _currentLogFilePath;
    private bool _logFileExists = true;

    // File switch dialog state
    private bool _fileSwitchDialogVisible;
    private LogFileDescriptor? _selectedSwitchFile;

    private LoggingSubscription? _subscription;
    private CancellationTokenSource? _subscriptionCts;
    private Task? _subscriptionTask;

    // Context mode state
    private bool _isContextMode;
    private long? _contextTargetLine;
    private int? _savedLineIndex;
    private ScreenLogSnapshot? _savedSnapshot;
    private bool _savedAutoScroll;
    private bool _savedIsRunning;

    // Metrics
    private long _totalFileLineCount;
    private long _initLoadTimeMs;

    private IJSObjectReference? _jsModule;
    private readonly SemaphoreSlim _jsModuleGate = new(1, 1);
    private LogViewer? _logViewerRef;
    private bool _disposed;

    private IReadOnlyList<LogLineViewModel> _currentLines => _snapshot?.Lines ?? Array.Empty<LogLineViewModel>();

    private long _currentVersion => _snapshot?.Version ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var options = LoggingService.UIOption;
            _selectedLineLimit = options.DefaultFetchLines;
            _onlyCapture = options.DefaultOnlyCapture;
            _logDirectory = LoggingService.LogDirectory;
            _currentLogFilePath = LoggingService.CurrentLogFilePath;
            _logFileExists = LoggingService.LogFileExists;

            _subscription = LoggingService.Subscribe();
            _subscriptionCts = new CancellationTokenSource();
            _subscriptionTask = ListenUpdatesAsync(_subscription.Reader, _subscriptionCts.Token);

            await InitializeSnapshotAsync();
            await RefreshFilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize the logging monitor page.");
            if (!_disposed)
            {
                Snackbar.Add(L["Page:Messages:InitializeFailed", ex.Message], Severity.Error);
            }

            // Clean up the subscription created during initialization.
            if (_subscriptionCts != null)
            {
                await _subscriptionCts.CancelAsync();
                if (_subscriptionTask is not null)
                {
                    try { await _subscriptionTask; } catch (OperationCanceledException) { }
                }
                _subscriptionCts.Dispose();
                _subscriptionCts = null;
            }
            if (_subscription != null)
            {
                await _subscription.DisposeAsync();
                _subscription = null;
            }
        }
        finally
        {
            _isInitializing = false;
            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private async Task InitializeSnapshotAsync()
    {
        var stopwatch = Stopwatch.StartNew();

        var result = await LoggingService.InitializeAsync(_selectedLineLimit);

        stopwatch.Stop();
        _initLoadTimeMs = stopwatch.ElapsedMilliseconds;

        if (result.IsFailed(out var error, out var snapshot))
        {
            if (!_disposed) Snackbar.Add(error.Message ?? L["Page:Messages:SnapshotInitializeFailed"].Value, Severity.Error);
            return;
        }

        if (_disposed) return;

        _snapshot = snapshot;
        _isRunning = LoggingService.IsRunning;
        _totalFileLineCount = LoggingService.TotalFileLineCount;

        StateHasChanged();
    }

    private async Task ListenUpdatesAsync(ChannelReader<ScreenLogSnapshot> reader, CancellationToken token)
    {
        try
        {
            await foreach (var snapshot in reader.ReadAllAsync(token))
            {
                if (_disposed) return;
                _snapshot = snapshot;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore cancellation.
        }
    }

    private Task OnKeywordChanged(string? keyword)
    {
        _filterKeyword = keyword;
        return Task.CompletedTask;
    }

    private Task OnOnlyCaptureChanged(bool onlyCapture)
    {
        _onlyCapture = onlyCapture;
        return Task.CompletedTask;
    }

    private Task OnAutoScrollChanged(bool autoScroll)
    {
        _autoScroll = autoScroll;
        return Task.CompletedTask;
    }

    private async Task OnLineLimitChanged(int lineCount)
    {
        if (_selectedLineLimit == lineCount)
        {
            return;
        }

        _selectedLineLimit = lineCount;
        await ReloadSnapshotAsync();
    }

    private async Task StartTailAsync()
    {
        var res = await LoggingService.StartAsync();
        if (res.IsFailed(out var error))
        {
            if (!_disposed) Snackbar.Add(error.Message ?? L["Page:Messages:StartFailed"].Value, Severity.Error);
            return;
        }

        if (_disposed) return;
        _isRunning = true;
        Snackbar.Add(L["Page:Messages:Started"], Severity.Success);
    }

    private async Task PauseTailAsync()
    {
        var res = await LoggingService.PauseAsync();
        if (res.IsFailed(out var error))
        {
            if (!_disposed) Snackbar.Add(error.Message ?? L["Page:Messages:PauseFailed"].Value, Severity.Error);
            return;
        }

        if (_disposed) return;
        _isRunning = false;
        Snackbar.Add(L["Page:Messages:Paused"], Severity.Info);
    }

    private async Task ReloadSnapshotAsync()
    {
        _isInitializing = true;
        StateHasChanged();
        try
        {
            await InitializeSnapshotAsync();
        }
        finally
        {
            _isInitializing = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task ApplyFilterAsync()
    {
        _isApplyingFilter = true;
        var res = await LoggingService.UpdateFilterAsync(_filterKeyword, _onlyCapture);
        if (res.IsFailed(out var error, out var snapshot))
        {
            if (!_disposed) Snackbar.Add(error.Message ?? L["Page:Messages:FilterFailed"].Value, Severity.Error);
        }
        else
        {
            _snapshot = snapshot;
        }

        _isApplyingFilter = false;
        if (!_disposed) StateHasChanged();
    }

    private async Task ClearFilterAsync()
    {
        _filterKeyword = null;
        await ApplyFilterAsync();
    }

    private Task HandleLineClick(LogLineViewModel line)
    {
        Logger.LogDebug("User inspected log line: {Header}", line.Header);
        return Task.CompletedTask;
    }

    private async Task RefreshFilesAsync()
    {
        _filesLoading = true;
        StateHasChanged();

        var res = await LoggingService.ListFilesAsync();
        if (res.IsFailed(out var error, out var files))
        {
            if (!_disposed) Snackbar.Add(error.Message ?? L["Page:Messages:FilesFailed"].Value, Severity.Error);
        }
        else
        {
            _logFiles = files.ToList();
        }

        _filesLoading = false;
        if (!_disposed) StateHasChanged();
    }

    private async Task DownloadFileAsync(string relativePath)
    {
        try
        {
            await TriggerBrowserDownloadAsync(BuildFileDownloadUrl(relativePath));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download log file: {RelativePath}", relativePath);
            if (!_disposed) Snackbar.Add(L["Page:Messages:DownloadFailed", ex.Message], Severity.Error);
        }
    }

    private async Task ExportBuffer()
    {
        try
        {
            await TriggerBrowserDownloadAsync("logging-ui/current/export");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export the current log buffer.");
            if (!_disposed) Snackbar.Add(L["Page:Messages:ExportFailed", ex.Message], Severity.Error);
        }
    }

    private async Task HandleShowContext((LogLineViewModel line, int lineIndex) args)
    {
        var (line, lineIndex) = args;

        if (!line.AbsoluteLineNumber.HasValue)
        {
            Snackbar.Add(L["Page:Messages:ContextUnavailable"], Severity.Warning);
            return;
        }

        try
        {
            // Preserve the current state before entering context mode.
            _savedSnapshot = _snapshot;
            _savedAutoScroll = _autoScroll;
            _savedIsRunning = _isRunning;
            _savedLineIndex = lineIndex;

            // Pause live updates before loading file context.
            if (_isRunning)
            {
                await LoggingService.PauseAsync();
            }

            // Disable auto-scroll while showing file context.
            _autoScroll = false;

            // Read file context around the selected line.
            var contextResult = await LogFileQueryService.ReadContextAsync(
                _currentLogFilePath ?? string.Empty,
                line.AbsoluteLineNumber.Value,
                50);

            if (contextResult.IsFailed(out var error, out var context))
            {
                if (!_disposed) Snackbar.Add(error.Message ?? L["Page:Messages:ContextReadFailed"].Value, Severity.Error);
                return;
            }

            if (_disposed) return;

            // Build a temporary snapshot for the context view.
            _snapshot = new ScreenLogSnapshot
            {
                Lines = context.Lines,
                Version = _snapshot?.Version ?? 0 + 1,
                TotalStoredLines = context.Lines.Count,
                Filter = LogFilterState.Disabled,
                GeneratedAt = DateTimeOffset.UtcNow
            };

            _isContextMode = true;
            _contextTargetLine = line.AbsoluteLineNumber.Value;

            Snackbar.Add(L["Page:Messages:ContextLoaded", line.AbsoluteLineNumber.Value], Severity.Info);
            StateHasChanged();

            // Wait for the UI to render before centering the target line.
            await Task.Delay(100, _subscriptionCts?.Token ?? CancellationToken.None);
            await ScrollToTargetLineAsync();
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to show log context.");
            if (!_disposed) Snackbar.Add(L["Page:Messages:ContextFailed", ex.Message], Severity.Error);
        }
    }

    private async Task ScrollToTargetLineAsync()
    {
        if (_logViewerRef == null || !_contextTargetLine.HasValue)
        {
            return;
        }

        // Find the target line index inside the current snapshot.
        var targetIndex = _snapshot?.Lines
            .Select((line, index) => new { line, index })
            .FirstOrDefault(x => x.line.AbsoluteLineNumber == _contextTargetLine.Value)?.index;

        if (targetIndex.HasValue)
        {
            await _logViewerRef.ScrollToLineAsync(targetIndex.Value);
        }
    }

    private async Task ExitContextMode()
    {
        if (!_isContextMode)
        {
            return;
        }

        // Restore the state that was active before entering context mode.
        _snapshot = _savedSnapshot;
        _autoScroll = _savedAutoScroll;

        // Resume live updates when they were active before entering context mode.
        if (_savedIsRunning)
        {
            await LoggingService.StartAsync();
            _isRunning = true;
        }

        _isContextMode = false;
        _contextTargetLine = null;
        _savedSnapshot = null;

        Snackbar.Add(L["Page:Messages:ReturnedToRealtime"], Severity.Info);
        StateHasChanged();

        // Restore the previous line position after the realtime view is rendered again.
        if (_savedLineIndex.HasValue)
        {
            await Task.Delay(100, _subscriptionCts?.Token ?? CancellationToken.None);
            if (_logViewerRef != null)
            {
                await _logViewerRef.ScrollToLineAsync(_savedLineIndex.Value);
            }
            _savedLineIndex = null;
        }
    }

    private async Task HandleApplyFilter((LogLineViewModel line, string keyword) args)
    {
        _filterKeyword = args.keyword;
        await ApplyFilterAsync();
    }

    private async Task<int> HandleLoadMoreAsync(int lineCount)
    {
        if (_isContextMode)
        {
            return 0;
        }

        try
        {
            var result = await LoggingService.LoadMoreLinesAsync(lineCount);

            if (result.IsFailed(out var error, out var loadedCount))
            {
                if (loadedCount == 0)
                {
                    Snackbar.Add(L["Page:Messages:FileStartReached"], Severity.Info);
                }
                else
                {
                    Snackbar.Add(error.Message ?? L["Page:Messages:LoadMoreFailed"].Value, Severity.Warning);
                }
                return 0;
            }

            if (loadedCount == 0)
            {
                Snackbar.Add(L["Page:Messages:FileStartReached"], Severity.Info);
            }
            else
            {
                Logger.LogDebug("Loaded {Count} historical log lines.", loadedCount);
            }

            return loadedCount;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed while loading additional log lines.");
            if (!_disposed) Snackbar.Add(L["Page:Messages:LoadFailed", ex.Message], Severity.Error);
            return 0;
        }
    }

    private async Task TriggerBrowserDownloadAsync(string relativeUrl)
    {
        var token = _subscriptionCts?.Token ?? CancellationToken.None;
        await _jsModuleGate.WaitAsync(token);
        IJSObjectReference? importedModule = null;
        try
        {
            ObjectDisposedException.ThrowIf(_disposed, this);

            if (_jsModule is null)
            {
                importedModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/Monica.Framework.UI/js/logging-ui.js");

                if (_disposed)
                {
                    return;
                }

                _jsModule = importedModule;
                importedModule = null;
            }

            ObjectDisposedException.ThrowIf(_disposed, this);
            var downloadUrl = NavigationManager.ToAbsoluteUri(relativeUrl).ToString();
            await _jsModule.InvokeVoidAsync("downloadFile", token, downloadUrl);
        }
        finally
        {
            await DisposeJsModuleAsync(importedModule);
            _jsModuleGate.Release();
        }
    }

    private static string BuildFileDownloadUrl(string relativePath)
    {
        var normalizedPath = relativePath.Replace('\\', '/');
        var encodedSegments = normalizedPath
            .Split('/', StringSplitOptions.RemoveEmptyEntries)
            .Select(Uri.EscapeDataString);

        return $"logging-ui/files/{string.Join("/", encodedSegments)}";
    }

    private async Task OpenFileSwitchDialog()
    {
        _selectedSwitchFile = null;
        _fileSwitchDialogVisible = true;
        await RefreshFilesAsync();
    }

    private void CloseFileSwitchDialog()
    {
        _fileSwitchDialogVisible = false;
        _selectedSwitchFile = null;
    }

    private async Task SwitchToSelectedFile()
    {
        if (_selectedSwitchFile == null)
        {
            return;
        }

        var selectedFile = _selectedSwitchFile;
        _fileSwitchDialogVisible = false;
        _isInitializing = true;
        StateHasChanged();

        try
        {
            var result = await LoggingService.SwitchToFileAsync(selectedFile.RelativePath, _selectedLineLimit);
            if (result.IsFailed(out var error, out var snapshot))
            {
                if (!_disposed) Snackbar.Add(error.Message ?? L["Page:Messages:SwitchFailed"].Value, Severity.Error);
                return;
            }

            if (_disposed) return;

            _snapshot = snapshot;
            _currentLogFilePath = LoggingService.CurrentLogFilePath;
            _logFileExists = LoggingService.LogFileExists;
            _totalFileLineCount = LoggingService.TotalFileLineCount;
            _isRunning = false;

            Snackbar.Add(L["Page:Messages:Switched", selectedFile.FileName], Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to switch the active log file.");
            if (!_disposed) Snackbar.Add(L["Page:Messages:SwitchFailed", ex.Message], Severity.Error);
        }
        finally
        {
            _isInitializing = false;
            _selectedSwitchFile = null;
            if (!_disposed) StateHasChanged();
        }
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        var order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        if (_subscriptionCts != null)
        {
            await _subscriptionCts.CancelAsync();
        }

        if (_subscriptionTask is not null)
        {
            try { await _subscriptionTask; } catch (OperationCanceledException) { }
        }

        if (_subscription is not null)
        {
            await _subscription.DisposeAsync();
        }

        await _jsModuleGate.WaitAsync();
        try
        {
            var module = Interlocked.Exchange(ref _jsModule, null);
            await DisposeJsModuleAsync(module);
        }
        finally { _jsModuleGate.Release(); }

        _subscriptionCts?.Dispose();
        _subscriptionCts = null;
        _jsModuleGate.Dispose();
    }

    private static async ValueTask DisposeJsModuleAsync(IJSObjectReference? module)
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }
}
