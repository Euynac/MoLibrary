@attribute [Route(PAGE_URL)]
@using Monica.Core.ObjectMapping.Models
@using Monica.Core.ObjectMapping.Facades
@using Monica.Core.Results
@using Monica.UI.Shared.Components.Markdown
@inject ObjectMappingFacade StatusService
@inject ISnackbar Snackbar
@inject IStringLocalizer<MapperResource> L

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<div class="mapper-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="mapper-page__outer-container">
        <div class="mapper-page__container">
            <header class="mapper-page__header">
                <div class="mapper-page__eyebrow">
                    <span class="mapper-page__eyebrow-line" aria-hidden="true"></span>
                    <span>@L["Page:Header:Eyebrow"]</span>
                </div>
                <div class="mapper-page__heading-row">
                    <div>
                        <MudText Typo="Typo.h3" HtmlTag="h1">@L["Page:Header:Title"]</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mapper-page__description">
                            @L["Page:Header:Description"]
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadDataAsync"
                               Disabled="@_loading">
                        @(_loading ? L["Page:Actions:Loading"] : L["Page:Actions:Refresh"])
                    </MudButton>
                </div>
            </header>

            <section class="mapper-page__pulse" aria-label="@L["Page:Summary:AriaLabel"]">
                <div class="mapper-page__pulse-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.CompareArrows" />
                </div>
                <div>
                    <span>@L["Page:Summary:RegisteredMappings"]</span>
                    <strong>@(_mapperData?.Count ?? 0)</strong>
                </div>
                <MudChip T="string" Size="Size.Small" Color="@(_loading ? Color.Info : Color.Success)" Variant="Variant.Outlined">
                    @(_loading ? L["Page:Summary:Scanning"] : L["Page:Summary:Ready"])
                </MudChip>
            </section>

            @if (_loading && _mapperData is null)
            {
                <div class="mapper-page__state" role="status">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">@L["Page:States:Loading"]</MudText>
                </div>
            }
            else if (_mapperData?.Mappings is { Count: > 0 } mappings)
            {
                <section class="mapper-registry">
                    <header class="mapper-registry__header">
                        <div class="mapper-registry__identity">
                            <span class="mapper-registry__icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
                            </span>
                            <div>
                                <MudText Typo="Typo.h6">@L["Page:Registry:Title"]</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Page:Registry:Description"]</MudText>
                            </div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @L["Page:Registry:Count", mappings.Count]
                        </MudChip>
                    </header>

                    <div class="mapper-table-wrapper">
                        <MudTable T="ObjectMapperInfo" Items="@mappings" Hover="true" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>@L["Page:Registry:Columns:SourceType"]</MudTh>
                                <MudTh>@L["Page:Registry:Columns:DestinationType"]</MudTh>
                                <MudTh Class="mapper-table__action-column">@L["Page:Registry:Columns:Actions"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["Page:Registry:Columns:SourceType"]">
                                    <code class="mapper-type">@context.SourceType</code>
                                </MudTd>
                                <MudTd DataLabel="@L["Page:Registry:Columns:DestinationType"]">
                                    <code class="mapper-type mapper-type--destination">@context.DestinationType</code>
                                </MudTd>
                                <MudTd DataLabel="@L["Page:Registry:Columns:Actions"]">
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Code"
                                               OnClick="@(() => ShowMapperCode(context))">
                                        @L["Page:Actions:InspectExpression"]
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </section>
            }
            else if (!_loading && _mapperData is not null)
            {
                <div class="mapper-page__state">
                    <MudIcon Icon="@Icons.Material.Filled.DataObject" Color="Color.Secondary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">@L["Page:States:EmptyTitle"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:States:EmptyDescription"]</MudText>
                </div>
            }
        </div>
    </MudContainer>
</div>

<MudDialog @bind-Visible="_showCodeDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@L["Page:Dialog:Title"]</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MarkdownThemeSync />
        @if (_selectedMapper is not null)
        {
            <div class="mapper-expression">
                <div class="mapper-expression__route">
                    <div class="mapper-expression__type mapper-expression__type--source">
                        <span>@L["Page:Dialog:SourceType"]</span>
                        <code>@_selectedMapper.SourceType</code>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="mapper-expression__arrow" />
                    <div class="mapper-expression__type mapper-expression__type--destination">
                        <span>@L["Page:Dialog:DestinationType"]</span>
                        <code>@_selectedMapper.DestinationType</code>
                    </div>
                </div>

                <div class="mapper-markdown-wrapper">
                    @if (!string.IsNullOrEmpty(_selectedMapper.MapExpression))
                    {
                        <MudMarkdown Value="@($"```csharp\n{_selectedMapper.MapExpression}\n```")" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            @L["Page:Dialog:NoExpression"]
                        </MudAlert>
                    }
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showCodeDialog = false)">@L["Page:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public const string PAGE_URL = "/mapper-debug";

    private bool _loading;
    private ObjectMapperStatusResponse? _mapperData;
    private bool _showCodeDialog;
    private ObjectMapperInfo? _selectedMapper;

    protected override Task OnAfterRenderAsync(bool firstRender)
        => firstRender ? LoadDataAsync(showSuccessMessage: false) : Task.CompletedTask;

    private Task LoadDataAsync() => LoadDataAsync(showSuccessMessage: true);

    private async Task LoadDataAsync(bool showSuccessMessage)
    {
        _loading = true;
        StateHasChanged();

        try
        {
            if ((await StatusService.GetStatusAsync()).IsFailed(out var error, out var data))
            {
                Snackbar.Add(L["Page:Messages:LoadFailed", error], Severity.Error);
                return;
            }

            _mapperData = data;
            if (showSuccessMessage)
            {
                Snackbar.Add(L["Page:Messages:LoadSucceeded", data.Count], Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Page:Messages:LoadException", ex.Message], Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ShowMapperCode(ObjectMapperInfo mapper)
    {
        _selectedMapper = mapper;
        _showCodeDialog = true;
    }
}
