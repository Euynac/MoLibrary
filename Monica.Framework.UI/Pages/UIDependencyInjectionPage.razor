@attribute [Route(PAGE_URL)]
@using Monica.Core.Results
@using Monica.DependencyInjection.Facades
@using Monica.DependencyInjection.Models
@using Monica.Framework.UI.UIDependencyInjection.Components
@using Monica.Framework.UI.UIDependencyInjection.Dialogs
@using Monica.Framework.UI.UIDependencyInjection.State
@inject DependencyInjectionDiagnosticsFacade DiagnosticsFacade
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<DependencyInjectionResource> L

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<div class="di-page">
    <MudPaper Class="pa-4 di-header" Outlined="true">
        <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="3">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Large" />
                    <MudText Typo="Typo.h4">@L["Page:Header:Title"]</MudText>
                </MudStack>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    @L["Page:Header:Description"]
                </MudText>
                @if (_state.Snapshot != null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["Page:Header:GeneratedAt", _state.Snapshot.CapturedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")]
                    </MudText>
                }
            </MudStack>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshAsync">
                @L["Page:Header:Refresh"]
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_state.Snapshot != null)
    {
        <div class="di-summary-grid">
            <MudPaper Class="pa-3 di-summary-card" Outlined="true">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["Page:Summary:Total"]</MudText>
                <MudText Typo="Typo.h5">@_state.Snapshot.TotalDescriptorCount</MudText>
            </MudPaper>

            <MudPaper Class="pa-3 di-summary-card" Outlined="true">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["Page:Summary:AutoRegistered"]</MudText>
                <MudText Typo="Typo.h5">@_state.Snapshot.AutoRegisteredDescriptorCount</MudText>
            </MudPaper>

            <MudPaper Class="pa-3 di-summary-card" Outlined="true">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["Page:Summary:Keyed"]</MudText>
                <MudText Typo="Typo.h5">@_state.Snapshot.KeyedDescriptorCount</MudText>
            </MudPaper>

            <MudPaper Class="pa-3 di-summary-card" Outlined="true">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["Page:Summary:Factories"]</MudText>
                <MudText Typo="Typo.h5">@_state.Snapshot.FactoryDescriptorCount</MudText>
            </MudPaper>

            <MudPaper Class="pa-3 di-summary-card" Outlined="true">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["Page:Summary:Rewritten"]</MudText>
                <MudText Typo="Typo.h5">@_state.Snapshot.RewrittenDescriptorCount</MudText>
            </MudPaper>

            <MudPaper Class="pa-3 di-summary-card" Outlined="true">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["Page:Summary:Warnings"]</MudText>
                <MudText Typo="Typo.h5">@_state.Snapshot.AutoRegistrationWarningCount</MudText>
            </MudPaper>

            <MudPaper Class="pa-3 di-summary-card" Outlined="true">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@L["Page:Summary:Errors"]</MudText>
                <MudText Typo="Typo.h5">@_state.Snapshot.AutoRegistrationErrorCount</MudText>
            </MudPaper>
        </div>
    }

    @if (_state.Snapshot is { AutoRegistrationIssues.Count: > 0 } snapshot)
    {
        <MudPaper Class="pa-4 di-issues-card" Outlined="true">
            <MudStack Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@L["Page:Issues:Title"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["Page:Issues:Description"]
                    </MudText>
                </MudStack>

                <DependencyInjectionAutoRegistrationIssueList Items="snapshot.AutoRegistrationIssues" />
            </MudStack>
        </MudPaper>
    }

    <DependencyInjectionDescriptorFilterBar State="_state"
                                            FilteredCount="@_state.FilteredDescriptors.Count"
                                            FiltersChanged="HandleFiltersChangedAsync" />

    @if (!string.IsNullOrWhiteSpace(_state.LoadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @L["Page:Messages:RefreshFailed", _state.LoadError]
        </MudAlert>
    }

    @if (_state.IsLoading)
    {
        <div class="di-state-shell">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Page:States:Loading"]</MudText>
            </MudStack>
        </div>
    }
    else if (_state.Snapshot == null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @L["Page:States:LoadFailed"]
        </MudAlert>
    }
    else if (_state.FilteredDescriptors.Count == 0)
    {
        <div class="di-state-shell">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                @L["Page:States:Empty"]
            </MudAlert>
        </div>
    }
    else
    {
        <MudPaper Class="di-grid-shell pa-0" Outlined="true">
            <DependencyInjectionDescriptorGrid Items="_state.FilteredDescriptors"
                                               OnViewDetails="ShowDetailsAsync" />
        </MudPaper>
    }
</div>

@code {
    public const string PAGE_URL = "/dependency-injection";

    private readonly DependencyInjectionPageState _state = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync(showSuccessMessage: false);
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        await LoadAsync(showSuccessMessage: true);
    }

    private async Task LoadAsync(bool showSuccessMessage)
    {
        _state.BeginLoad();
        StateHasChanged();

        if ((await DiagnosticsFacade.GetSnapshotAsync()).IsFailed(out var error, out var snapshot))
        {
            _state.FailLoad(error);
            Snackbar.Add(L["Page:Messages:RefreshFailed", error], Severity.Error);
            return;
        }

        _state.ApplySnapshot(snapshot);

        if (showSuccessMessage)
        {
            Snackbar.Add(L["Page:Messages:RefreshSucceeded"], Severity.Success);
        }
    }

    private Task HandleFiltersChangedAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ShowDetailsAsync(DependencyInjectionDescriptorInfo descriptor)
    {
        try
        {
            var parameters = new DialogParameters<DependencyInjectionDescriptorDetailDialog>
            {
                { x => x.Descriptor, descriptor }
            };

            await DialogService.ShowAsync<DependencyInjectionDescriptorDetailDialog>(
                L["Page:Dialog:Title"],
                parameters,
                new DialogOptions
                {
                    MaxWidth = MaxWidth.ExtraLarge,
                    FullWidth = true,
                    CloseButton = true
                });
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Page:Messages:DialogOpenFailed", ex.Message], Severity.Error);
        }
    }
}
