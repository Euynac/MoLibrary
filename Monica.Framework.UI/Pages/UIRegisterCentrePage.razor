@attribute [Route(REGISTERCENTRE_DEBUG_URL)]
@using Monica.Framework.UI.UIRegisterCentre.Components
@using Monica.Framework.UI.UIRegisterCentre.Services
@using Monica.RegisterCentre.Models
@using Monica.RegisterCentre.Interfaces
@using Monica.Tool.MoResponse
@inject RegisterCentreService RegisterCentreService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<RegisterCentreResource> L
@implements IDisposable

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<div class="register-centre-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
        <MudText Typo="Typo.h4" Class="mb-4">@L["Page:HeaderTitle"]</MudText>

        <MudTabs @bind-ActivePanelIndex="_activeTabIndex"
                 Elevation="4"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 Class="mb-6 register-centre-tabs">
            <MudTabPanel Text="@L["Page:Tabs:ServiceList"]" Icon="@Icons.Material.Filled.List">
                <div class="tab-content-panel">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudPaper Class="pa-4">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                        <MudText Typo="Typo.h6">@L["Page:ServiceList:Title"]</MudText>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudSwitch T="bool" @bind-Value="_autoRefreshEnabled" @bind-Value:after="OnAutoRefreshToggled" Color="Color.Primary" Label="@L["Shared:Labels:AutoRefresh"]" />
                                            <MudNumericField T="int" @bind-Value="_refreshInterval" @bind-Value:after="OnRefreshIntervalChanged" Label="@L["Shared:Labels:RefreshIntervalSeconds"]" Min="1" Max="60"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 120px"
                                                             Disabled="!_autoRefreshEnabled" Immediate="true" />
                                        </MudStack>
                                    </MudStack>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => RefreshServicesAsync())" Disabled="@_isLoading">
                                        <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-1" />
                                        @L["Shared:Actions:Refresh"]
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12">
                            <ServiceFilterPanel
                                AllServices="@_services"
                                FilterText="@_filterText"
                                FilterTextChanged="@((text) => { _filterText = text; ApplyFilters(); })"
                                SelectedStatuses="@_selectedStatuses"
                                SelectedStatusesChanged="@((statuses) => { _selectedStatuses = new HashSet<ServiceStatus>(statuses); ApplyFilters(); })"
                                SelectedDomains="@_selectedDomains"
                                SelectedDomainsChanged="@((domains) => { _selectedDomains = new HashSet<string>(domains); ApplyFilters(); })"
                                ShowOnlyWithInstances="@_showOnlyWithInstances"
                                ShowOnlyWithInstancesChanged="@((value) => { _showOnlyWithInstances = value; ApplyFilters(); })"
                                OnFiltersChanged="@ApplyFilters" />
                        </MudItem>

                        <MudItem xs="12">
                            <RegisterCentreServiceList Services="_filteredServices" OnRefresh="@(() => RefreshServicesAsync())" IsLoading="_isLoading" />

                            @if (!_isLoading && !_services.Any())
                            {
                                <MudPaper Class="pa-4 mt-2">
                                    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">
                                        @L["Page:States:NoServices"]
                                    </MudText>
                                </MudPaper>
                            }
                        </MudItem>
                    </MudGrid>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["Page:Tabs:ServiceGraph"]" Icon="@Icons.Material.Filled.AccountTree">
                <div class="tab-content-panel">
                    <ServiceVisualization OnServiceClick="OnServiceClickFromVisualization" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["Page:Tabs:DomainDependencyGraph"]" Icon="@Icons.Material.Filled.Hub">
                <div class="tab-content-panel">
                    <DomainDependencyVisualization OnDomainClick="OnDomainClickFromVisualization" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["Page:Tabs:DomainManagement"]" Icon="@Icons.Material.Filled.Domain">
                <div class="tab-content-panel">
                    @if (_selectedDomain == null)
                    {
                        <DomainList OnDomainSelected="OnDomainSelected" />
                    }
                    else
                    {
                        <DomainDetail DomainName="@_selectedDomain.Name" OnBackClick="OnBackToDomainList" OnServiceDetailClick="OnServiceDetailFromDomain" />
                    }
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["Page:Tabs:CurrentInstance"]" Icon="@Icons.Material.Filled.Computer">
                <div class="tab-content-panel">
                    <CurrentInstanceInfo />
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudContainer>
</div>

@code {
    public const string REGISTERCENTRE_DEBUG_URL = "/register-centre-manage";
    
    private bool _isLoading = false;
    private List<RegisteredServiceStatus> _services = new();
    private bool _autoRefreshEnabled = true;
    private int _refreshInterval = 3;
    private Timer? _refreshTimer;
    private DomainInfo? _selectedDomain;
    private int _activeTabIndex = 0;

    // Filter state
    private string _filterText = string.Empty;
    private HashSet<ServiceStatus> _selectedStatuses = new();
    private HashSet<string> _selectedDomains = new();
    private bool _showOnlyWithInstances = false;
    private List<RegisteredServiceStatus> _filteredServices = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshServicesAsync();
            SetupAutoRefresh();
        }
    }
    
    private void SetupAutoRefresh()
    {
        _refreshTimer?.Dispose();
        if (_autoRefreshEnabled)
        {
            _refreshTimer = new Timer(async _ => await InvokeAsync(() => RefreshServicesAsync(false, false)), null, 
                TimeSpan.FromSeconds(_refreshInterval), TimeSpan.FromSeconds(_refreshInterval));
        }
    }
    
    private void OnAutoRefreshToggled()
    {
        SetupAutoRefresh();
    }
    
    private void OnRefreshIntervalChanged()
    {
        if (_autoRefreshEnabled)
        {
            SetupAutoRefresh();
        }
    }

    private async Task RefreshServicesAsync(bool showNotification = true, bool showLoading = true)
    {
        if (showLoading)
        {
            _isLoading = true;
            StateHasChanged();
        }

        if ((await RegisterCentreService.GetMergedServicesWithEvictionTrackingAsync()).IsFailed(out var error, out var data))
        {
            if (showNotification)
                Snackbar.Add(L["Page:Messages:LoadServicesFailed", error.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Error);
            _services = new List<RegisteredServiceStatus>();
        }
        else
        {
            _services = data ?? new List<RegisteredServiceStatus>();
            ApplyFilters();
            if (showNotification)
                Snackbar.Add(L["Page:Messages:ServiceListRefreshed"].Value, Severity.Success);
        }

        if (showLoading)
        {
            _isLoading = false;
        }
        StateHasChanged();
    }

    private async Task OnServiceClickFromVisualization(RegisteredServiceStatus service)
    {
        var parameters = new DialogParameters
        {
            ["Service"] = service
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        await DialogService.ShowAsync<RegisterCentreServiceDetailDialog>(L["Page:Dialogs:ServiceDetailTitle", service.AppName].Value, parameters, options);
    }
    
    private async Task OnDomainSelected(DomainInfo domain)
    {
        _selectedDomain = domain;
        StateHasChanged();
        await Task.CompletedTask;
    }
    
    private async Task OnBackToDomainList()
    {
        _selectedDomain = null;
        StateHasChanged();
        await Task.CompletedTask;
    }
    
    private async Task OnServiceDetailFromDomain(RegisteredServiceStatus service)
    {
        var parameters = new DialogParameters
        {
            ["Service"] = service
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        await DialogService.ShowAsync<RegisterCentreServiceDetailDialog>(L["Page:Dialogs:ServiceDetailTitle", service.AppName].Value, parameters, options);
    }
    
    private async Task OnDomainClickFromVisualization(string domainName)
    {
        if (!(await RegisterCentreService.GetDomainsWithColorsAsync()).IsFailed(out var error, out var domains))
        {
            var domain = domains?.FirstOrDefault(d => d.Name == domainName);
            if (domain != null)
            {
                _selectedDomain = domain;
                _activeTabIndex = 3;
                StateHasChanged();
                Snackbar.Add(L["Page:Messages:SwitchedToDomainDetail", domain.DisplayName ?? domain.Name].Value, Severity.Info);
            }
            else
            {
                Snackbar.Add(L["Page:Messages:DomainNotFound", domainName].Value, Severity.Warning);
            }
        }
        else
        {
            Snackbar.Add(L["Page:Messages:LoadDomainsFailed", error.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Error);
        }
        await Task.CompletedTask;
    }

    private void ApplyFilters()
    {
        _filteredServices = _services.Where(service =>
        {
            // Text filter
            if (!string.IsNullOrWhiteSpace(_filterText))
            {
                var searchText = _filterText.ToLower();
                if (!service.AppName.ToLower().Contains(searchText) &&
                    !service.AppId.ToLower().Contains(searchText) &&
                    !(service.ProjectName?.ToLower().Contains(searchText) ?? false) &&
                    !(service.DomainName?.ToLower().Contains(searchText) ?? false))
                    return false;
            }

            // Status filter
            if (_selectedStatuses.Any() && !_selectedStatuses.Contains(service.OverallStatus))
                return false;

            // Domain filter
            if (_selectedDomains.Any() && !_selectedDomains.Contains(GetServiceDomainName(service)))
                return false;

            // Instance filter
            if (_showOnlyWithInstances && service.TotalInstanceCount == 0)
                return false;

            return true;
        }).ToList();
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private string GetServiceDomainName(RegisteredServiceStatus service)
        => service.DomainName ?? L["Shared:Values:Unknown"].Value;
}
