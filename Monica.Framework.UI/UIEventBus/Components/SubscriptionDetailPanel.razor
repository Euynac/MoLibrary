@using Monica.Framework.UI.UIEventBus.Models
@inject IStringLocalizer<EventBusResource> L

@if (Subscription != null)
{
    <div class="subscription-detail-wrapper">
        <MudGrid Spacing="3">
            <!-- Basic information -->
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" />
                                <MudText Typo="Typo.h6">@L["SubscriptionDetail:Sections:BasicInformation"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:SubscriptionId"]</MudText>
                                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@Subscription.SubscriptionId</MudText>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:State"]</MudText>
                                    <MudChip T="string" Color="@Subscription.StateColor" Size="Size.Small">
                                        @L.GetSubscriptionStateText(Subscription.State)
                                    </MudChip>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:EventType"]</MudText>
                                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@Subscription.EventType</MudText>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:TopicName"]</MudText>
                                    <MudText Typo="Typo.body2">@Subscription.TopicName</MudText>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:Scope"]</MudText>
                                    <MudChip T="string" Color="@Subscription.ScopeColor" Size="Size.Small">
                                        @L.GetSubscriptionScopeText(Subscription.Scope)
                                    </MudChip>
                                </MudStack>
                            </MudItem>
                            @if (!string.IsNullOrEmpty(Subscription.ServiceKey))
                            {
                                <MudItem xs="12">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:ServiceKey"]</MudText>
                                        <MudText Typo="Typo.body2">@Subscription.ServiceKey</MudText>
                                    </MudStack>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Processor information -->
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Secondary" />
                                <MudText Typo="Typo.h6">@L["SubscriptionDetail:Sections:HandlerInformation"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:HandlerType"]</MudText>
                                    @if (Subscription.IsActionHandler)
                                    {
                                        <MudStack Spacing="2">
                                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Functions">
                                                @L["Shared:Labels:ActionHandler"]
                                            </MudChip>

                                            @if (!string.IsNullOrEmpty(Subscription.ActionDeclaringType))
                                            {
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:DeclaringType"]</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-family: monospace; word-break: break-all;">
                                                        @Subscription.ActionDeclaringType
                                                    </MudText>
                                                </MudStack>
                                            }

                                            @if (!string.IsNullOrEmpty(Subscription.ActionMethodName))
                                            {
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:MethodName"]</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                                        @Subscription.ActionMethodName
                                                    </MudText>
                                                </MudStack>
                                            }

                                            @if (!string.IsNullOrEmpty(Subscription.ActionMethodSignature))
                                            {
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:MethodSignature"]</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-family: monospace; word-break: break-all;">
                                                        @Subscription.ActionMethodSignature
                                                    </MudText>
                                                </MudStack>
                                            }

                                            @if (Subscription.ActionIsStatic.HasValue)
                                            {
                                                <MudChip T="string" Size="Size.Small"
                                                         Color="@(Subscription.ActionIsStatic.Value ? Color.Secondary : Color.Default)">
                                                    @(Subscription.ActionIsStatic.Value ? L["SubscriptionTable:Labels:StaticMethod"] : L["SubscriptionTable:Labels:InstanceMethod"])
                                                </MudChip>
                                            }
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@Subscription.HandlerType</MudText>
                                    }
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:HandlerFactory"]</MudText>
                                    <MudText Typo="Typo.body2">@Subscription.HandlerFactoryType</MudText>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SubscriptionDetail:Fields:DiscoveryMode"]</MudText>
                                    @if (Subscription.IsAutoDiscovered)
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.AutoAwesome">
                                            @L.GetDiscoveryModeText(true)
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.TouchApp">
                                            @L.GetDiscoveryModeText(false)
                                        </MudChip>
                                    }
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- life cycle -->
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Tertiary" />
                                <MudText Typo="Typo.h6">@L["SubscriptionDetail:Sections:Lifecycle"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudTimeline TimelineOrientation="TimelineOrientation.Vertical">
                            <MudTimelineItem Color="Color.Info" Size="Size.Small">
                                <ItemContent>
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@L["SubscriptionDetail:Timeline:Created"]</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Subscription.CreatedAtDisplay</MudText>
                                    </MudStack>
                                </ItemContent>
                            </MudTimelineItem>

                            @if (Subscription.ActivatedAt.HasValue)
                            {
                                <MudTimelineItem Color="Color.Success" Size="Size.Small">
                                    <ItemContent>
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@L["SubscriptionDetail:Timeline:Activated"]</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Subscription.ActivatedAtDisplay</MudText>
                                        </MudStack>
                                    </ItemContent>
                                </MudTimelineItem>
                            }

                            @if (Subscription.DeactivatedAt.HasValue)
                            {
                                <MudTimelineItem Color="Color.Warning" Size="Size.Small">
                                    <ItemContent>
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@L["SubscriptionDetail:Timeline:Deactivated"]</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Subscription.DeactivatedAtDisplay</MudText>
                                        </MudStack>
                                    </ItemContent>
                                </MudTimelineItem>
                            }

                            @if (Subscription.State == EventBus.Models.EventSubscriptionState.Active)
                            {
                                <MudTimelineItem Color="Color.Success" Size="Size.Small">
                                    <ItemContent>
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@L["SubscriptionDetail:Timeline:CurrentState"]</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Success">
                                                @L["SubscriptionDetail:Timeline:ActiveRunning", L.GetSubscriptionDurationText(Subscription)]
                                            </MudText>
                                        </MudStack>
                                    </ItemContent>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- metadata -->
            @if (Subscription.Metadata.Any())
            {
                <MudItem xs="12">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Default" />
                                    <MudText Typo="Typo.h6">@L["SubscriptionDetail:Sections:Metadata"]</MudText>
                                </MudStack>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudSimpleTable Dense="true" Hover="true">
                                <thead>
                                    <tr>
                                        <th>@L["SubscriptionDetail:Fields:Key"]</th>
                                        <th>@L["SubscriptionDetail:Fields:Value"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var metadata in Subscription.Metadata)
                                    {
                                        <tr>
                                            <td style="font-family: monospace;">@metadata.Key</td>
                                            <td style="font-family: monospace;">@metadata.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </div>
}

@code {
    [Parameter]
    public SubscriptionViewModel? Subscription { get; set; }
}
