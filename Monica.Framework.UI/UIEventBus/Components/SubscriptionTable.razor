@using Monica.Framework.UI.UIEventBus.Models

<div class="subscription-table-wrapper">
    <MudTable T="SubscriptionViewModel"
             Items="@Subscriptions"
             Dense="true"
             Hover="true"
             Breakpoint="Breakpoint.Sm"
             Loading="@Loading"
             LoadingProgressColor="Color.Info"
             RowsPerPage="20">
        <HeaderContent>
            <MudTh>事件类型</MudTh>
            <MudTh>主题名称</MudTh>
            <MudTh>处理器</MudTh>
            <MudTh>范围</MudTh>
            <MudTh>状态</MudTh>
            <MudTh>创建时间</MudTh>
            <MudTh>操作</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="事件类型">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Color="Color.Default" />
                    <MudTooltip Text="@context.EventType">
                        <MudText Typo="Typo.body2" Style="cursor: pointer;" @onclick="() => OnRowClick.InvokeAsync(context)">
                            @context.EventTypeShortName
                        </MudText>
                    </MudTooltip>
                </MudStack>
                @if (context.IsAutoDiscovered)
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.AutoAwesome">自动</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="主题名称">
                <MudText Typo="Typo.body2">@context.TopicName</MudText>
            </MudTd>
            <MudTd DataLabel="处理器">
                @if (context.IsActionHandler && !string.IsNullOrEmpty(context.ActionHandlerTooltip))
                {
                    <MudTooltip Delay="300" Arrow="true" Placement="Placement.Top">
                        <ChildContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Small" Color="Color.Info" />
                                <MudText Typo="Typo.body2">@context.HandlerDisplay</MudText>
                            </MudStack>
                        </ChildContent>
                        <TooltipContent>
                            <MudStack Spacing="1" Class="pa-2" Style="max-width: 500px;">
                                @if (!string.IsNullOrEmpty(context.ActionDeclaringType))
                                {
                                    <MudText Typo="Typo.caption" Style="font-weight: 500;">声明类型:</MudText>
                                    <MudText Typo="Typo.caption" Style="font-family: monospace; word-break: break-all;">@context.ActionDeclaringType</MudText>
                                }
                                @if (!string.IsNullOrEmpty(context.ActionMethodName))
                                {
                                    <MudText Typo="Typo.caption" Style="font-weight: 500; margin-top: 8px;">方法名称:</MudText>
                                    <MudText Typo="Typo.caption" Style="font-family: monospace;">@context.ActionMethodName</MudText>
                                }
                                @if (!string.IsNullOrEmpty(context.ActionMethodSignature))
                                {
                                    <MudText Typo="Typo.caption" Style="font-weight: 500; margin-top: 8px;">方法签名:</MudText>
                                    <MudText Typo="Typo.caption" Style="font-family: monospace; word-break: break-all;">@context.ActionMethodSignature</MudText>
                                }
                                @if (context.ActionIsStatic.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Style="margin-top: 8px;">
                                        <MudChip T="string" Size="Size.Small" Color="@(context.ActionIsStatic.Value ? Color.Secondary : Color.Default)">
                                            @(context.ActionIsStatic.Value ? "静态方法" : "实例方法")
                                        </MudChip>
                                    </MudText>
                                }
                            </MudStack>
                        </TooltipContent>
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="@(context.HandlerType ?? "Action处理器")">
                        <MudText Typo="Typo.body2">@context.HandlerDisplay</MudText>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="范围">
                <MudChip T="string" Color="@context.ScopeColor" Size="Size.Small">
                    @context.ScopeDisplay
                </MudChip>
            </MudTd>
            <MudTd DataLabel="状态">
                <MudChip T="string" Color="@context.StateColor" Size="Size.Small">
                    @context.StateDisplay
                </MudChip>
            </MudTd>
            <MudTd DataLabel="创建时间">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.CreatedAtDisplay</MudText>
                    @if (context.State == EventBus.Models.EventSubscriptionState.Active)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            已运行 @context.DurationDisplay
                        </MudText>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="操作">
                <SubscriptionLifecycleControl Subscription="context"
                                             OnActivate="() => OnActivate.InvokeAsync(context)"
                                             OnDeactivate="() => OnDeactivate.InvokeAsync(context)"
                                             OnUnsubscribe="() => OnUnsubscribe.InvokeAsync(context)" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 10, 20, 50, 100 })" />
        </PagerContent>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">暂无订阅数据</MudText>
            </MudStack>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    [Parameter]
    public List<SubscriptionViewModel>? Subscriptions { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnRowClick { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnActivate { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnDeactivate { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnUnsubscribe { get; set; }
}
