@using Monica.Framework.UI.UIEventBus.Models
@inject IStringLocalizer<EventBusResource> L

<div class="subscription-table-wrapper">
    <MudTable T="SubscriptionViewModel"
             Items="@Subscriptions"
             Dense="true"
             Hover="true"
             Breakpoint="Breakpoint.Sm"
             Loading="@Loading"
             LoadingProgressColor="Color.Info"
             RowsPerPage="20">
        <HeaderContent>
            <MudTh>@L["SubscriptionTable:Columns:EventType"]</MudTh>
            <MudTh>@L["SubscriptionTable:Columns:TopicName"]</MudTh>
            <MudTh>@L["SubscriptionTable:Columns:Handler"]</MudTh>
            <MudTh>@L["SubscriptionTable:Columns:Scope"]</MudTh>
            <MudTh>@L["SubscriptionTable:Columns:State"]</MudTh>
            <MudTh>@L["SubscriptionTable:Columns:CreatedAt"]</MudTh>
            <MudTh>@L["SubscriptionTable:Columns:Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["SubscriptionTable:Columns:EventType"]">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Color="Color.Default" />
                    <MudTooltip Text="@context.EventType">
                        <MudText Typo="Typo.body2" Class="subscription-table__event-link" @onclick="() => OnRowClick.InvokeAsync(context)">
                            @context.EventTypeShortName
                        </MudText>
                    </MudTooltip>
                </MudStack>
                @if (context.IsAutoDiscovered)
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.AutoAwesome">@L["SubscriptionTable:Labels:Auto"]</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="@L["SubscriptionTable:Columns:TopicName"]">
                <MudText Typo="Typo.body2">@context.TopicName</MudText>
            </MudTd>
            <MudTd DataLabel="@L["SubscriptionTable:Columns:Handler"]">
                @if (context.IsActionHandler && !string.IsNullOrEmpty(L.BuildActionHandlerTooltip(context)))
                {
                    <MudTooltip Delay="300" Arrow="true" Placement="Placement.Top">
                        <ChildContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Small" Color="Color.Info" />
                                <MudText Typo="Typo.body2">@L.GetHandlerDisplayText(context)</MudText>
                            </MudStack>
                        </ChildContent>
                        <TooltipContent>
                            <MudStack Spacing="1" Class="subscription-table__tooltip pa-2">
                                @if (!string.IsNullOrEmpty(context.ActionDeclaringType))
                                {
                                    <MudText Typo="Typo.caption" Class="subscription-table__tooltip-label">@L["SubscriptionTable:Labels:DeclaringType"]</MudText>
                                    <MudText Typo="Typo.caption" Class="subscription-table__technical">@context.ActionDeclaringType</MudText>
                                }
                                @if (!string.IsNullOrEmpty(context.ActionMethodName))
                                {
                                    <MudText Typo="Typo.caption" Class="subscription-table__tooltip-label">@L["SubscriptionTable:Labels:MethodName"]</MudText>
                                    <MudText Typo="Typo.caption" Class="subscription-table__technical">@context.ActionMethodName</MudText>
                                }
                                @if (!string.IsNullOrEmpty(context.ActionMethodSignature))
                                {
                                    <MudText Typo="Typo.caption" Class="subscription-table__tooltip-label">@L["SubscriptionTable:Labels:MethodSignature"]</MudText>
                                    <MudText Typo="Typo.caption" Class="subscription-table__technical">@context.ActionMethodSignature</MudText>
                                }
                                @if (context.ActionIsStatic.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Class="subscription-table__tooltip-label">
                                        <MudChip T="string" Size="Size.Small" Color="@(context.ActionIsStatic.Value ? Color.Secondary : Color.Default)">
                                            @(context.ActionIsStatic.Value ? L["SubscriptionTable:Labels:StaticMethod"] : L["SubscriptionTable:Labels:InstanceMethod"])
                                        </MudChip>
                                    </MudText>
                                }
                            </MudStack>
                        </TooltipContent>
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="@(context.HandlerType ?? L["Shared:Labels:ActionHandler"].Value)">
                        <MudText Typo="Typo.body2">@L.GetHandlerDisplayText(context)</MudText>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="@L["SubscriptionTable:Columns:Scope"]">
                <MudChip T="string" Color="@context.ScopeColor" Size="Size.Small">
                    @L.GetSubscriptionScopeText(context.Scope)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["SubscriptionTable:Columns:State"]">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudChip T="string" Color="@context.StateColor" Size="Size.Small">
                        @L.GetSubscriptionStateText(context.State)
                    </MudChip>
                    @if (IsTestListening(context))
                    {
                        <MudTooltip Text="@L["SubscriptionTable:Labels:TestListening"]">
                            <MudIcon Icon="@Icons.Material.Filled.Hearing" Color="Color.Success" Size="Size.Small" />
                        </MudTooltip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="@L["SubscriptionTable:Columns:CreatedAt"]">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.CreatedAtDisplay</MudText>
                    @if (context.State == EventBus.Models.EventSubscriptionState.Active)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["SubscriptionTable:Labels:RunningFor", L.GetSubscriptionDurationText(context)]
                        </MudText>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="@L["SubscriptionTable:Columns:Actions"]">
                <SubscriptionLifecycleControl Subscription="context"
                                             OnActivate="() => OnActivate.InvokeAsync(context)"
                                             OnDeactivate="() => OnDeactivate.InvokeAsync(context)"
                                             OnUnsubscribe="() => OnUnsubscribe.InvokeAsync(context)"
                                             OnTest="() => OnTest.InvokeAsync(context)"
                                             IsTestListening="@IsTestListening(context)" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 10, 20, 50, 100 })" />
        </PagerContent>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">@L["SubscriptionTable:States:Empty"]</MudText>
            </MudStack>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    [Parameter]
    public List<SubscriptionViewModel>? Subscriptions { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnRowClick { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnActivate { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnDeactivate { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnUnsubscribe { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnTest { get; set; }

    [Parameter]
    public IReadOnlySet<string> ActiveTestListenerIds { get; set; } = new HashSet<string>();

    private bool IsTestListening(SubscriptionViewModel subscription)
    {
        return ActiveTestListenerIds.Contains(subscription.SubscriptionId);
    }
}
