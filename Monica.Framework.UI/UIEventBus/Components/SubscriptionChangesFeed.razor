@using Monica.Framework.UI.UIEventBus.Models
@inject IStringLocalizer<EventBusResource> L

<div class="subscription-changes-feed">
<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudStack Spacing="2">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Update" Color="Color.Info" />
                <MudText Typo="Typo.h6">@ResolvedTitle</MudText>
            </MudStack>
            @if (Changes.Any())
            {
                <MudChip T="string" Color="Color.Info" Size="Size.Small">
                    @L["ChangesFeed:Count", Changes.Count]
                </MudChip>
            }
        </MudStack>

        @if (Changes.Any())
        {
            <MudList T="string" ReadOnly="true" Dense="true" Class="subscription-changes-feed__list">
                @foreach (var change in Changes.Take(MaxItems))
                {
                    <MudListItem T="string" Class="change-feed-item">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@change.ChangeTypeIcon"
                                        Color="@change.ChangeTypeColor"
                                        Size="Size.Small" />
                                <MudChip T="string"
                                        Color="@change.ChangeTypeColor"
                                        Size="Size.Small">
                                    @L.GetSubscriptionChangeTypeText(change.ChangeType)
                                </MudChip>
                                <MudTooltip Text="@change.Subscription.EventType">
                                    <MudText Typo="Typo.body2">@change.Subscription.EventTypeShortName</MudText>
                                </MudTooltip>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @change.TimestampDisplay
                                </MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudChip T="string"
                                        Color="@change.Subscription.ScopeColor"
                                        Size="Size.Small">
                                    @L.GetSubscriptionScopeText(change.Subscription.Scope)
                                </MudChip>
                                <MudChip T="string"
                                        Color="@change.Subscription.StateColor"
                                        Size="Size.Small">
                                    @L.GetSubscriptionStateText(change.Subscription.State)
                                </MudChip>
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>

            @if (Changes.Count > MaxItems)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
                    @L["ChangesFeed:Truncated", MaxItems, Changes.Count]
                </MudText>
            }
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ChangesFeed:Empty"]</MudText>
            </MudStack>
        }
    </MudStack>
</MudPaper>
</div>

@code {
    [Parameter]
    public List<SubscriptionChangeViewModel> Changes { get; set; } = new();

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public int MaxItems { get; set; } = 20;

    private string ResolvedTitle => string.IsNullOrWhiteSpace(Title)
        ? L["ChangesFeed:DefaultTitle"].Value
        : Title;
}
