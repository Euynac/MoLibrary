@using Monica.Framework.UI.UIEventBus.Models
@using Monica.EventBus.Models

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Color="Color.Primary" />
                <MudText Typo="Typo.h6">过滤条件</MudText>
            </MudStack>
            @if (Filter?.HasAnyFilter == true)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Clear"
                          Color="Color.Secondary"
                          Variant="Variant.Text"
                          Size="Size.Small"
                          OnClick="ClearFilter">
                    清空过滤
                </MudButton>
            }
        </MudStack>

        <MudGrid Spacing="2">
            <!-- Provider selector -->
            @if (Providers.Any())
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string"
                               Label="Provider"
                               @bind-Value="SelectedProviderId"
                               OpenChanged="ApplyFilterOnSelectClosedAsync">
                        <MudSelectItem T="string" Value="@AllSelectionValue">全部</MudSelectItem>
                        @foreach (var provider in Providers)
                        {
                            <MudSelectItem T="string" Value="@provider.UniqueId">
                                @provider.DisplayName (@provider.ProviderTypeName, @(provider.IsDistributed ? "分布式" : "本地"))
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            <!-- Status filtering -->
            <MudItem xs="12" sm="6" md="@(Providers.Any() ? 2 : 3)">
                <MudSelect T="string"
                          Label="状态"
                          @bind-Value="SelectedState"
                          OpenChanged="ApplyFilterOnSelectClosedAsync">
                    <MudSelectItem T="string" Value="@AllSelectionValue">全部</MudSelectItem>
                    <MudSelectItem T="string" Value="@nameof(EventSubscriptionState.Active)">活跃</MudSelectItem>
                    <MudSelectItem T="string" Value="@nameof(EventSubscriptionState.Pending)">待激活</MudSelectItem>
                    <MudSelectItem T="string" Value="@nameof(EventSubscriptionState.Inactive)">未激活</MudSelectItem>
                    <MudSelectItem T="string" Value="@nameof(EventSubscriptionState.Disposed)">已释放</MudSelectItem>
                </MudSelect>
            </MudItem>

            <!-- Range filtering -->
            <MudItem xs="12" sm="6" md="@(Providers.Any() ? 2 : 3)">
                <MudSelect T="string"
                          Label="范围"
                          @bind-Value="SelectedScope"
                          OpenChanged="ApplyFilterOnSelectClosedAsync">
                    <MudSelectItem T="string" Value="@AllSelectionValue">全部</MudSelectItem>
                    <MudSelectItem T="string" Value="@nameof(EventSubscriptionScope.Local)">本地</MudSelectItem>
                    <MudSelectItem T="string" Value="@nameof(EventSubscriptionScope.Distributed)">分布式</MudSelectItem>
                </MudSelect>
            </MudItem>

            <!-- Automatic discovery filtering -->
            <MudItem xs="12" sm="6" md="@(Providers.Any() ? 2 : 3)">
                <MudSelect T="string"
                          Label="发现方式"
                          @bind-Value="SelectedDiscoveryMode"
                          OpenChanged="ApplyFilterOnSelectClosedAsync">
                    <MudSelectItem T="string" Value="@AllSelectionValue">全部</MudSelectItem>
                    <MudSelectItem T="string" Value="@AutoDiscoveredSelectionValue">自动发现</MudSelectItem>
                    <MudSelectItem T="string" Value="@ManualSelectionValue">手动订阅</MudSelectItem>
                </MudSelect>
            </MudItem>

            <!-- Search text -->
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                             Label="搜索"
                             @bind-Value="Filter!.SearchText"
                             Placeholder="事件类型或主题名称"
                             Clearable="true"
                             Immediate="false"
                             OnDebounceIntervalElapsed="ApplyFilterAsync"
                             DebounceInterval="500"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>

        @if (Filter?.HasAnyFilter == true)
        {
            <MudChip T="string"
                    Color="Color.Info"
                    Size="Size.Small"
                    Icon="@Icons.Material.Filled.Info">
                已应用 @GetFilterCount() 个过滤条件
            </MudChip>
        }
    </MudStack>
</MudPaper>

@code {
    private const string AllSelectionValue = "__all__";
    private const string AutoDiscoveredSelectionValue = "__auto__";
    private const string ManualSelectionValue = "__manual__";

    [Parameter]
    public SubscriptionFilter? Filter { get; set; }

    [Parameter]
    public EventCallback OnFilterChanged { get; set; }

    [Parameter]
    public List<EventBusProviderInfo> Providers { get; set; } = [];

    private string SelectedProviderId
    {
        get => Filter?.SelectedProvider?.UniqueId ?? AllSelectionValue;
        set
        {
            if (Filter is null)
            {
                return;
            }

            Filter.SelectedProvider = value == AllSelectionValue
                ? null
                : Providers.FirstOrDefault(provider => provider.UniqueId == value);
        }
    }

    private string SelectedState
    {
        get => Filter?.State?.ToString() ?? AllSelectionValue;
        set
        {
            if (Filter is null)
            {
                return;
            }

            Filter.State = Enum.TryParse<EventSubscriptionState>(value, out var state)
                ? state
                : null;
        }
    }

    private string SelectedScope
    {
        get => Filter?.Scope?.ToString() ?? AllSelectionValue;
        set
        {
            if (Filter is null)
            {
                return;
            }

            Filter.Scope = Enum.TryParse<EventSubscriptionScope>(value, out var scope)
                ? scope
                : null;
        }
    }

    private string SelectedDiscoveryMode
    {
        get => Filter?.IsAutoDiscovered switch
        {
            true => AutoDiscoveredSelectionValue,
            false => ManualSelectionValue,
            _ => AllSelectionValue
        };
        set
        {
            if (Filter is null)
            {
                return;
            }

            Filter.IsAutoDiscovered = value switch
            {
                AutoDiscoveredSelectionValue => true,
                ManualSelectionValue => false,
                _ => null
            };
        }
    }

    private async Task ApplyFilterAsync()
    {
        await OnFilterChanged.InvokeAsync();
    }

    private Task ApplyFilterOnSelectClosedAsync(bool isOpen)
    {
        return isOpen ? Task.CompletedTask : ApplyFilterAsync();
    }

    private async Task ClearFilter()
    {
        Filter?.Clear();
        await ApplyFilterAsync();
    }

    private int GetFilterCount()
    {
        if (Filter == null) return 0;

        int count = 0;
        if (Filter.State.HasValue) count++;
        if (Filter.Scope.HasValue) count++;
        if (Filter.IsAutoDiscovered.HasValue) count++;
        if (!string.IsNullOrWhiteSpace(Filter.SearchText)) count++;
        if (Filter.SelectedProvider != null) count++;

        return count;
    }
}
