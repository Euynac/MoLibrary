@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Core.Results;
@using Monica.Framework.UI.UIEventBus.State
@implements IAsyncDisposable
@inject EventBusTestService TestService
@inject ISnackbar Snackbar
@inject IStringLocalizer<EventBusResource> L

<div class="test-panel-wrapper">
    <MudStack Spacing="4">
        <!-- Publish test message -->
        <div class="publish-section-wrapper">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Send" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">@L["TestPanel:Publish:Title"]</MudText>
                    </MudStack>

                    <MudDivider />

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_publishTopicName"
                                          T="string"
                                          Label="@L["TestPanel:Publish:TopicName"]"
                                          Variant="Variant.Outlined"
                                          HelperText="@L["TestPanel:Publish:TopicHelper"]"
                                          Immediate="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_publishMessage"
                                          T="string"
                                          Label="@L["TestPanel:Publish:MessageContent"]"
                                          Variant="Variant.Outlined"
                                          Lines="3"
                                          Placeholder="@L["TestPanel:Publish:MessagePlaceholder"]"
                                          Immediate="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="PublishMessageAsync"
                                       Disabled="@_isPublishing">
                                @if (_isPublishing)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <text>@L["TestPanel:Publish:Sending"]</text>
                                }
                                else
                                {
                                    <text>@L["TestPanel:Publish:Send"]</text>
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudPaper>
        </div>

        <!-- Subscribe to test messages -->
        <div class="subscribe-section-wrapper">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" />
                        <MudText Typo="Typo.h6">@L["TestPanel:Subscribe:Title"]</MudText>
                    </MudStack>

                    <MudDivider />

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_subscribeTopicName"
                                          T="string"
                                          Label="@L["TestPanel:Subscribe:TopicName"]"
                                          Variant="Variant.Outlined"
                                          HelperText="@L["TestPanel:Subscribe:TopicHelper"]"
                                          Immediate="true"
                                          Disabled="@_isListening" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Row="true" Spacing="2">
                                @if (!_isListening)
                                {
                                    <MudButton Color="Color.Info"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.PlayArrow"
                                               OnClick="StartListeningAsync">
                                        @L["TestPanel:Subscribe:Start"]
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Color="Color.Error"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.Stop"
                                               OnClick="StopListeningAsync">
                                        @L["TestPanel:Subscribe:Stop"]
                                    </MudButton>
                                    <MudButton Color="Color.Primary"
                                               Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Clear"
                                               OnClick="ClearMessages"
                                               Disabled="@(_messages.Count == 0)">
                                        @L["TestPanel:Subscribe:Clear"]
                                    </MudButton>
                                }
                            </MudStack>
                        </MudItem>
                    </MudGrid>

                    <!-- Subscription status indicator -->
                    <div class="status-indicator-wrapper">
                        <MudPaper Class="@(_isListening ? "subscribed" : "unsubscribed")" Elevation="0">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                @if (_isListening)
                                {
                                    <MudProgressCircular Color="Color.Success" Size="Size.Small" Indeterminate="true" />
                                    <MudText Typo="Typo.body2" Color="Color.Success">
                                        <strong>@L["TestPanel:Subscribe:ListeningStatus", TestService.CurrentTopicName ?? string.Empty, _messages.Count]</strong>
                                    </MudText>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Default" Size="Size.Small" />
                                    <MudText Typo="Typo.body2" Color="Color.Default">
                                        @L["TestPanel:Subscribe:NotListening"]
                                    </MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    </div>

                    <!-- Message list -->
                    @if (_isListening)
                    {
                        <MudDivider />

                        @if (_messages.Count == 0)
                        {
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-6">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" />
                                <MudText Typo="Typo.body1" Color="Color.Default">
                                    @L["TestPanel:Subscribe:NoMessages"]
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @L["TestPanel:Subscribe:NoMessagesHint"]
                                </MudText>
                            </MudStack>
                        }
                        else
                        {
                            <div class="message-list-wrapper">
                                <MudStack Spacing="2" Class="message-list">
                                    @foreach (var msg in _messages.OrderByDescending(m => m.ReceivedAt))
                                    {
                                        <div class="message-card-wrapper">
                                            <MudCard Elevation="2">
                                                <MudCardContent>
                                                    <MudStack Spacing="2">
                                                        <!-- Message header -->
                                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                                <MudIcon Icon="@Icons.Material.Filled.Message" Color="Color.Info" Size="Size.Small" />
                                                                <MudText Typo="Typo.subtitle2">
                                                                    @L["TestPanel:Messages:MessageId", msg.EventData.MessageId]
                                                                </MudText>
                                                            </MudStack>
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                                                @msg.ReceivedAt.ToString("HH:mm:ss.fff")
                                                            </MudChip>
                                                        </MudStack>

                                                        <MudDivider />

                                                        <!-- Message content -->
                                                        <MudStack Spacing="1">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                @L["TestPanel:Messages:MessageContent"]
                                                            </MudText>
                                                            <div class="message-card__payload">
                                                                <MudText Typo="Typo.body2">
                                                                    @msg.EventData.Message
                                                                </MudText>
                                                            </div>
                                                        </MudStack>

                                                        <!-- message metadata -->
                                                        <MudStack Row="true" Spacing="3">
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Secondary" />
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                    @L["TestPanel:Messages:CreatedAt", msg.EventData.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")]
                                                                </MudText>
                                                            </MudStack>
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Secondary" />
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                    @L["TestPanel:Messages:ReceivedAt", msg.ReceivedAt.ToString("yyyy-MM-dd HH:mm:ss")]
                                                                </MudText>
                                                            </MudStack>
                                                        </MudStack>
                                                    </MudStack>
                                                </MudCardContent>
                                            </MudCard>
                                        </div>
                                    }
                                </MudStack>
                            </div>
                        }
                    }
                </MudStack>
            </MudPaper>
        </div>

        <!-- Instructions for use -->
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            <MudText Typo="Typo.body2">
                <strong>@L["TestPanel:Instructions:Title"]</strong>
            </MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">@L["TestPanel:Instructions:Publish"]</MudText>
                </MudListItem>
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">@L["TestPanel:Instructions:Subscribe"]</MudText>
                </MudListItem>
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">@((MarkupString)L["TestPanel:Instructions:DefaultTopic", $"<code>{_defaultTopicName}</code>"].Value)</MudText>
                </MudListItem>
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">@L["TestPanel:Instructions:MultiTab"]</MudText>
                </MudListItem>
            </MudList>
        </MudAlert>
    </MudStack>
</div>

@code {
    private readonly string _defaultTopicName = typeof(TestEventMessage).FullName!;

    private string _publishTopicName = string.Empty;
    private string _publishMessage = string.Empty;
    private string _subscribeTopicName = string.Empty;

    private bool _isPublishing;
    private bool _isListening;

    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly SemaphoreSlim _listenerGate = new(1, 1);
    private readonly object _disposeSync = new();
    private CancellationTokenSource? _refreshCancellation;
    private PeriodicTimer? _refreshTimer;
    private Task? _refreshTask;
    private Task? _disposeTask;
    private List<ReceivedTestMessage> _messages = new();
    private bool _ownsSubscription;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _publishTopicName = _defaultTopicName;
        _subscribeTopicName = _defaultTopicName;
    }

    private async Task PublishMessageAsync()
    {
        if (_disposed)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_publishMessage))
        {
            Snackbar.Add(L["TestPanel:Validation:MessageRequired"], Severity.Warning);
            return;
        }

        _isPublishing = true;
        StateHasChanged();

        try
        {
            var result = await TestService.PublishTestMessageAsync(
                _publishMessage,
                _publishTopicName,
                _lifetimeCancellation.Token);

            if (_disposed)
            {
                return;
            }

            if (result.IsFailed(out var error))
            {
                Snackbar.Add(L["TestPanel:Snackbars:PublishFailed", error.Message ?? string.Empty], Severity.Error);
            }
            else
            {
                Snackbar.Add(L["TestPanel:Snackbars:PublishSucceeded"], Severity.Success);
                _publishMessage = string.Empty;
            }
        }
        finally
        {
            _isPublishing = false;
            RenderIfActive();
        }
    }

    private async Task StartListeningAsync()
    {
        if (_disposed)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_subscribeTopicName))
        {
            Snackbar.Add(L["TestPanel:Validation:TopicRequired"], Severity.Warning);
            return;
        }

        await _listenerGate.WaitAsync();
        try
        {
            if (_disposed || _ownsSubscription)
            {
                return;
            }

            var subscribeResult = await TestService.SubscribeToTestTopicAsync(_subscribeTopicName);
            if (subscribeResult.IsFailed(out var error, out _))
            {
                if (!_disposed)
                {
                    Snackbar.Add(L["TestPanel:Snackbars:SubscribeFailed", error.Message ?? string.Empty], Severity.Error);
                }

                return;
            }

            _ownsSubscription = true;
            if (_disposed)
            {
                return;
            }

            _isListening = true;
            Snackbar.Add(L["TestPanel:Snackbars:SubscribeSucceeded"], Severity.Success);
            StartRefreshLoop();
            StateHasChanged();
        }
        finally
        {
            _listenerGate.Release();
        }
    }

    private async Task StopListeningAsync()
    {
        if (_disposed)
        {
            return;
        }

        await _listenerGate.WaitAsync();
        try
        {
            if (_disposed)
            {
                return;
            }

            await StopRefreshLoopAsync();
            var result = _ownsSubscription
                ? await TestService.UnsubscribeFromTestTopicAsync()
                : Res.Ok();
            _ownsSubscription = false;

            if (_disposed)
            {
                return;
            }

            if (result.IsFailed(out var error))
            {
                Snackbar.Add(L["TestPanel:Snackbars:UnsubscribeFailed", error.Message ?? string.Empty], Severity.Warning);
            }
            else
            {
                Snackbar.Add(L["TestPanel:Snackbars:UnsubscribeSucceeded"], Severity.Info);
            }

            _isListening = false;
            StateHasChanged();
        }
        finally
        {
            _listenerGate.Release();
        }
    }

    private void StartRefreshLoop()
    {
        _refreshCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCancellation.Token);
        _refreshTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        _refreshTask = RefreshLoopAsync(_refreshTimer, _refreshCancellation.Token);
    }

    private async Task RefreshLoopAsync(PeriodicTimer timer, CancellationToken cancellationToken)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    if (_disposed || cancellationToken.IsCancellationRequested)
                    {
                        return;
                    }

                    RefreshMessages();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The component owns the refresh loop and cancels it during stop or disposal.
        }
    }

    private async Task StopRefreshLoopAsync()
    {
        var refreshCancellation = _refreshCancellation;
        var refreshTimer = _refreshTimer;
        var refreshTask = _refreshTask;

        _refreshCancellation = null;
        _refreshTimer = null;
        _refreshTask = null;

        refreshCancellation?.Cancel();
        refreshTimer?.Dispose();

        if (refreshTask is not null)
        {
            await refreshTask;
        }

        refreshCancellation?.Dispose();
    }

    private void RefreshMessages()
    {
        _messages = TestService.GetReceivedMessages();
    }

    private void ClearMessages()
    {
        if (_disposed)
        {
            return;
        }

        TestService.ClearReceivedMessages();
        _messages.Clear();
        Snackbar.Add(L["TestPanel:Snackbars:ClearSucceeded"], Severity.Info);
        StateHasChanged();
    }

    private void RenderIfActive()
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync)
        {
            return new ValueTask(_disposeTask ??= DisposeCoreAsync());
        }
    }

    private async Task DisposeCoreAsync()
    {
        _disposed = true;
        _lifetimeCancellation.Cancel();

        await _listenerGate.WaitAsync();
        try
        {
            await StopRefreshLoopAsync();
            if (_ownsSubscription)
            {
                await TestService.UnsubscribeFromTestTopicAsync();
                _ownsSubscription = false;
            }
        }
        finally
        {
            _listenerGate.Release();
            _lifetimeCancellation.Dispose();
            _listenerGate.Dispose();
        }
    }
}
