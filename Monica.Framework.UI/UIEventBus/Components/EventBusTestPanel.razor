@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Core.Results;
@using Monica.Framework.UI.UIEventBus.State
@using System.Timers
@implements IDisposable
@inject EventBusTestService TestService
@inject ISnackbar Snackbar

<div class="test-panel-wrapper">
    <MudStack Spacing="4">
        <!-- Publish test message -->
        <div class="publish-section-wrapper">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Send" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">发布测试消息</MudText>
                    </MudStack>

                    <MudDivider />

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_publishTopicName"
                                          T="string"
                                          Label="主题名称"
                                          Variant="Variant.Outlined"
                                          HelperText="默认使用事件类型的完整名称"
                                          Immediate="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_publishMessage"
                                          T="string"
                                          Label="消息内容"
                                          Variant="Variant.Outlined"
                                          Lines="3"
                                          Placeholder="输入要发送的测试消息..."
                                          Immediate="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="PublishMessageAsync"
                                       Disabled="@_isPublishing">
                                @if (_isPublishing)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <text>发送中...</text>
                                }
                                else
                                {
                                    <text>发送消息</text>
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudPaper>
        </div>

        <!-- Subscribe to test messages -->
        <div class="subscribe-section-wrapper">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" />
                        <MudText Typo="Typo.h6">订阅测试消息</MudText>
                    </MudStack>

                    <MudDivider />

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_subscribeTopicName"
                                          T="string"
                                          Label="监听主题"
                                          Variant="Variant.Outlined"
                                          HelperText="默认使用事件类型的完整名称"
                                          Immediate="true"
                                          Disabled="@_isListening" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Row="true" Spacing="2">
                                @if (!_isListening)
                                {
                                    <MudButton Color="Color.Info"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.PlayArrow"
                                               OnClick="StartListeningAsync">
                                        开始监听
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Color="Color.Error"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.Stop"
                                               OnClick="StopListeningAsync">
                                        取消监听
                                    </MudButton>
                                    <MudButton Color="Color.Primary"
                                               Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Clear"
                                               OnClick="ClearMessages"
                                               Disabled="@(_messages.Count == 0)">
                                        清空消息
                                    </MudButton>
                                }
                            </MudStack>
                        </MudItem>
                    </MudGrid>

                    <!-- Subscription status indicator -->
                    <div class="status-indicator-wrapper">
                        <MudPaper Class="@(_isListening ? "subscribed" : "unsubscribed")" Elevation="0" Style="padding: 0.75rem; border-radius: var(--mud-default-borderradius); border: 1px solid var(--mud-palette-lines-default);">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                @if (_isListening)
                                {
                                    <MudProgressCircular Color="Color.Success" Size="Size.Small" Indeterminate="true" />
                                    <MudText Typo="Typo.body2" Color="Color.Success">
                                        <strong>正在监听...</strong> 主题: @TestService.CurrentTopicName | 已接收: @_messages.Count 条
                                    </MudText>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Default" Size="Size.Small" />
                                    <MudText Typo="Typo.body2" Color="Color.Default">
                                        未监听
                                    </MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    </div>

                    <!-- Message list -->
                    @if (_isListening)
                    {
                        <MudDivider />

                        @if (_messages.Count == 0)
                        {
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-6">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" />
                                <MudText Typo="Typo.body1" Color="Color.Default">
                                    暂无接收到的消息
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    消息将实时显示在这里（每500ms刷新）
                                </MudText>
                            </MudStack>
                        }
                        else
                        {
                            <div class="message-list-wrapper">
                                <MudStack Spacing="2" Style="max-height: 500px; overflow-y: auto;">
                                    @foreach (var msg in _messages.OrderByDescending(m => m.ReceivedAt))
                                    {
                                        <div class="message-card-wrapper">
                                            <MudCard Elevation="2">
                                                <MudCardContent>
                                                    <MudStack Spacing="2">
                                                        <!-- Message header -->
                                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                                <MudIcon Icon="@Icons.Material.Filled.Message" Color="Color.Info" Size="Size.Small" />
                                                                <MudText Typo="Typo.subtitle2">
                                                                    消息 ID: @msg.EventData.MessageId
                                                                </MudText>
                                                            </MudStack>
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                                                @msg.ReceivedAt.ToString("HH:mm:ss.fff")
                                                            </MudChip>
                                                        </MudStack>

                                                        <MudDivider />

                                                        <!-- Message content -->
                                                        <MudStack Spacing="1">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                消息内容:
                                                            </MudText>
                                                            <MudPaper Class="pa-2" Elevation="0" Style="background-color: var(--mud-palette-background-gray); border-radius: 4px;">
                                                                <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-word;">
                                                                    @msg.EventData.Message
                                                                </MudText>
                                                            </MudPaper>
                                                        </MudStack>

                                                        <!-- message metadata -->
                                                        <MudStack Row="true" Spacing="3">
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Secondary" />
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                    创建: @msg.EventData.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                                                </MudText>
                                                            </MudStack>
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Secondary" />
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                    接收: @msg.ReceivedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                                                </MudText>
                                                            </MudStack>
                                                        </MudStack>
                                                    </MudStack>
                                                </MudCardContent>
                                            </MudCard>
                                        </div>
                                    }
                                </MudStack>
                            </div>
                        }
                    }
                </MudStack>
            </MudPaper>
        </div>

        <!-- Instructions for use -->
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            <MudText Typo="Typo.body2">
                <strong>使用说明：</strong>
            </MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">1. 发布消息：填写主题名称和消息内容后点击"发送消息"</MudText>
                </MudListItem>
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">2. 订阅主题：填写监听主题后点击"开始监听"，消息将实时显示在下方</MudText>
                </MudListItem>
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">3. 主题名称默认为 <code>@_defaultTopicName</code></MudText>
                </MudListItem>
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">4. 可以在多个浏览器标签页测试发布/订阅</MudText>
                </MudListItem>
            </MudList>
        </MudAlert>
    </MudStack>
</div>

@code {
    private readonly string _defaultTopicName = typeof(TestEventMessage).FullName!;

    private string _publishTopicName = string.Empty;
    private string _publishMessage = string.Empty;
    private string _subscribeTopicName = string.Empty;

    private bool _isPublishing;
    private bool _isListening;

    private Timer? _refreshTimer;
    private List<ReceivedTestMessage> _messages = new();

    protected override void OnInitialized()
    {
        _publishTopicName = _defaultTopicName;
        _subscribeTopicName = _defaultTopicName;
    }

    private async Task PublishMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_publishMessage))
        {
            Snackbar.Add("请输入消息内容", Severity.Warning);
            return;
        }

        _isPublishing = true;
        StateHasChanged();

        try
        {
            var result = await TestService.PublishTestMessageAsync(_publishMessage, _publishTopicName);

            if (result.IsFailed(out var error))
            {
                Snackbar.Add($"发布失败: {error.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add("消息发布成功", Severity.Success);
                _publishMessage = string.Empty; // 清空输入
            }
        }
        finally
        {
            _isPublishing = false;
            StateHasChanged();
        }
    }

    private async Task StartListeningAsync()
    {
        if (string.IsNullOrWhiteSpace(_subscribeTopicName))
        {
            Snackbar.Add("请输入监听主题", Severity.Warning);
            return;
        }

        // Subscribe to topics
        var subscribeResult = await TestService.SubscribeToTestTopicAsync(_subscribeTopicName);

        if (subscribeResult.IsFailed(out var error, out var subscription))
        {
            Snackbar.Add($"订阅失败: {error.Message}", Severity.Error);
            return;
        }

        _isListening = true;
        Snackbar.Add("订阅成功，开始监听消息...", Severity.Success);

        // Start scheduled refresh
        StartRefreshTimer();

        StateHasChanged();
    }

    private async Task StopListeningAsync()
    {
        StopRefreshTimer();

        var result = await TestService.UnsubscribeFromTestTopicAsync();

        if (result.IsFailed(out var error))
        {
            Snackbar.Add($"取消订阅失败: {error.Message}", Severity.Warning);
        }
        else
        {
            Snackbar.Add("已停止监听", Severity.Info);
        }

        _isListening = false;
        StateHasChanged();
    }

    private void StartRefreshTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = new Timer(500); // 每500ms刷新一次
        _refreshTimer.Elapsed += async (sender, e) =>
        {
            await InvokeAsync(() =>
            {
                RefreshMessages();
                StateHasChanged();
            });
        };
        _refreshTimer.Start();
    }

    private void StopRefreshTimer()
    {
        _refreshTimer?.Stop();
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    private void RefreshMessages()
    {
        _messages = TestService.GetReceivedMessages();
    }

    private void ClearMessages()
    {
        TestService.ClearReceivedMessages();
        _messages.Clear();
        Snackbar.Add("已清空所有消息", Severity.Info);
        StateHasChanged();
    }

    public void Dispose()
    {
        StopRefreshTimer();

        // If still listening, automatically unsubscribe
        if (_isListening)
        {
            _ = TestService.UnsubscribeFromTestTopicAsync();
        }
    }
}
