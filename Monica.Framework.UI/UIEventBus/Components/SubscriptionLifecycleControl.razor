@using Monica.Framework.UI.UIEventBus.Models
@using Monica.EventBus.Models

@if (Subscription != null && Subscription.State != SubscriptionState.Disposed)
{
    <MudStack Row="true" Spacing="1">
        @if (Subscription.State == SubscriptionState.Active)
        {
            <!-- Active state: Show deactivate and remove buttons -->
            <MudTooltip Text="停用订阅">
                <MudIconButton Icon="@Icons.Material.Filled.PauseCircle"
                             Color="Color.Warning"
                             Size="Size.Small"
                             OnClick="() => OnDeactivate.InvokeAsync()" />
            </MudTooltip>
            <MudTooltip Text="移除订阅">
                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                             Color="Color.Error"
                             Size="Size.Small"
                             OnClick="() => OnUnsubscribe.InvokeAsync()" />
            </MudTooltip>
        }
        else if (Subscription.State == SubscriptionState.Inactive || Subscription.State == SubscriptionState.Pending)
        {
            <!-- Inactive/pending activation status: Show activation and removal buttons -->
            <MudTooltip Text="激活订阅">
                <MudIconButton Icon="@Icons.Material.Filled.PlayCircle"
                             Color="Color.Success"
                             Size="Size.Small"
                             OnClick="() => OnActivate.InvokeAsync()" />
            </MudTooltip>
            <MudTooltip Text="移除订阅">
                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                             Color="Color.Error"
                             Size="Size.Small"
                             OnClick="() => OnUnsubscribe.InvokeAsync()" />
            </MudTooltip>
        }
    </MudStack>
}
else if (Subscription?.State == SubscriptionState.Disposed)
{
    <!-- Released state: no buttons are displayed -->
    <MudChip T="string" Color="Color.Default" Size="Size.Small">已释放</MudChip>
}

@code {
    [Parameter]
    public SubscriptionViewModel? Subscription { get; set; }

    [Parameter]
    public EventCallback OnActivate { get; set; }

    [Parameter]
    public EventCallback OnDeactivate { get; set; }

    [Parameter]
    public EventCallback OnUnsubscribe { get; set; }
}
