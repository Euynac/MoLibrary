@using Monica.Framework.UI.UIEventBus.Models
@inject IStringLocalizer<EventBusResource> L

@if (Statistics is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Statistics:States:Loading"]</MudAlert>
}
else
{
    <section class="event-bus-rankings">
        <article class="event-bus-ranking">
            <header>
                <span class="event-bus-ranking__icon event-bus-ranking__icon--primary"><MudIcon Icon="@Icons.Material.Filled.Event" /></span>
                <span>
                    <MudText Typo="Typo.h6">@L["Statistics:Sections:TopEventTypes"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Statistics:Sections:TopEventTypesDescription"]</MudText>
                </span>
            </header>
            @if (Statistics.TopEventTypes.Any())
            {
                <div class="event-bus-ranking__list">
                    @foreach (var eventType in Statistics.TopEventTypes)
                    {
                        <button type="button" class="event-bus-ranking__row" title="@eventType.EventType" @onclick="() => OnEventTypeClick.InvokeAsync(eventType.EventType)">
                            <span>@eventType.EventTypeShortName</span><strong>@eventType.Count</strong>
                        </button>
                    }
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Statistics:States:Empty"]</MudText>
            }
        </article>

        <article class="event-bus-ranking">
            <header>
                <span class="event-bus-ranking__icon event-bus-ranking__icon--info"><MudIcon Icon="@Icons.Material.Filled.Topic" /></span>
                <span>
                    <MudText Typo="Typo.h6">@L["Statistics:Sections:TopTopics"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Statistics:Sections:TopTopicsDescription"]</MudText>
                </span>
            </header>
            @if (Statistics.TopTopics.Any())
            {
                <div class="event-bus-ranking__list">
                    @foreach (var topic in Statistics.TopTopics)
                    {
                        <button type="button" class="event-bus-ranking__row" @onclick="() => OnTopicClick.InvokeAsync(topic.TopicName)">
                            <span>@topic.TopicName</span><strong>@topic.Count</strong>
                        </button>
                    }
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Statistics:States:Empty"]</MudText>
            }
        </article>
    </section>
}

@code {
    [Parameter] public SubscriptionStatistics? Statistics { get; set; }
    [Parameter] public EventCallback<string> OnEventTypeClick { get; set; }
    [Parameter] public EventCallback<string> OnTopicClick { get; set; }
}
