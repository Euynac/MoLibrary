@using Monica.Framework.UI.UIEventBus.Models
@inject IStringLocalizer<EventBusResource> L

<MudGrid>
    <MudItem xs="12">
        <div class="d-flex justify-space-between align-center mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Providers:Title"]</MudText>
                @if (Providers.Any())
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["Providers:Count", Providers.Count]</MudChip>
                }
            </MudStack>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="OnRefresh"
                       Disabled="IsLoading">
                @L["Providers:Refresh"]
            </MudButton>
        </div>
    </MudItem>

    @if (IsLoading)
    {
        <MudItem xs="12">
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        </MudItem>
    }
    else if (!Providers.Any())
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info">
                @L["Providers:States:Empty"]
            </MudAlert>
        </MudItem>
    }
    else
    {
        @foreach (var provider in Providers)
        {
            <MudItem xs="12" md="6" lg="4">
                <EventBusProviderCard Provider="provider"
                                     OnViewDetailsClicked="HandleViewDetails" />
            </MudItem>
        }
    }
</MudGrid>

<!-- Provider details dialog -->
<EventBusProviderDetailDialog IsVisible="_showProviderDetail"
                              IsVisibleChanged="OnProviderDetailVisibilityChanged"
                              Provider="_selectedProvider"
                              Subscriptions="_providerSubscriptions" />

@code {
    [Parameter] public List<EventBusProviderInfo> Providers { get; set; } = [];
    [Parameter] public List<SubscriptionViewModel> AllSubscriptions { get; set; } = [];
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private bool _showProviderDetail;
    private EventBusProviderInfo? _selectedProvider;
    private List<SubscriptionViewModel> _providerSubscriptions = [];

    private void HandleViewDetails(EventBusProviderInfo provider)
    {
        _selectedProvider = provider;

        // Filter out subscriptions for this Provider
        _providerSubscriptions = AllSubscriptions.Where(s =>
        {
            var keyMatches = s.ServiceKey == provider.ServiceKey;
            var scopeMatches = provider.IsDistributed
                ? s.Scope == EventBus.Models.EventSubscriptionScope.Distributed
                : s.Scope == EventBus.Models.EventSubscriptionScope.Local;
            return keyMatches && scopeMatches;
        }).ToList();

        _showProviderDetail = true;
    }

    private Task OnProviderDetailVisibilityChanged(bool isVisible)
    {
        _showProviderDetail = isVisible;

        if (!isVisible)
        {
            _selectedProvider = null;
            _providerSubscriptions = [];
        }

        return Task.CompletedTask;
    }
}
