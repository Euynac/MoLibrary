@using Monica.Framework.UI.UIEventBus.Models
@inject IStringLocalizer<EventBusResource> L

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.List" />
            <MudText Typo="Typo.h6">@ResolvedTitle</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (Subscriptions != null && Subscriptions.Any())
        {
            <MudTable T="SubscriptionViewModel"
                     Items="@Subscriptions"
                     Dense="true"
                     Hover="true"
                     OnRowClick="HandleSubscriptionRowClickAsync"
                     Style="cursor: pointer;">
                <HeaderContent>
                    <MudTh>@L["SubscriptionTable:Columns:EventType"]</MudTh>
                    <MudTh>@L["SubscriptionTable:Columns:TopicName"]</MudTh>
                    <MudTh>@L["SubscriptionTable:Columns:Handler"]</MudTh>
                    <MudTh>@L["SubscriptionTable:Columns:Scope"]</MudTh>
                    <MudTh>@L["SubscriptionTable:Columns:State"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["SubscriptionTable:Columns:EventType"]">
                        <MudTooltip Text="@context.EventType">
                            <MudText Typo="Typo.body2">@context.EventTypeShortName</MudText>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="@L["SubscriptionTable:Columns:TopicName"]">
                        <MudText Typo="Typo.body2">@context.TopicName</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["SubscriptionTable:Columns:Handler"]">
                        <MudText Typo="Typo.body2">@L.GetHandlerDisplayText(context)</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["SubscriptionTable:Columns:Scope"]">
                        <MudChip T="string" Color="@context.ScopeColor" Size="Size.Small">
                            @L.GetSubscriptionScopeText(context.Scope)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["SubscriptionTable:Columns:State"]">
                        <MudChip T="string" Color="@context.StateColor" Size="Size.Small">
                            @L.GetSubscriptionStateText(context.State)
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info">@L["SubscriptionTable:States:Empty"]</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary">@L["Shared:Common:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public List<SubscriptionViewModel>? Subscriptions { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnSubscriptionSelected { get; set; }

    private string ResolvedTitle => string.IsNullOrWhiteSpace(Title)
        ? L["Page:DialogTitles:SubscriptionList"].Value
        : Title;

    private Task HandleSubscriptionRowClickAsync(TableRowClickEventArgs<SubscriptionViewModel> args)
    {
        return args.Item is null ? Task.CompletedTask : OnSubscriptionClick(args.Item);
    }

    private async Task OnSubscriptionClick(SubscriptionViewModel subscription)
    {
        if (OnSubscriptionSelected.HasDelegate)
        {
            await OnSubscriptionSelected.InvokeAsync(subscription);
        }
        MudDialog.Close();
    }

    private void Close()
    {
        MudDialog.Close();
    }
}
