@using Monica.Framework.UI.UIEventBus.Models
@inject IStringLocalizer<EventBusResource> L

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Info" />
            <MudText Typo="Typo.h6">@L["SubscriptionDetail:Title"]</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (Subscription != null)
        {
            <SubscriptionDetailPanel Subscription="Subscription" />
        }
        else
        {
            <MudAlert Severity="Severity.Info">@L["SubscriptionDetail:States:NotSelected"]</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary">@L["Shared:Common:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public SubscriptionViewModel? Subscription { get; set; }

    private void Close()
    {
        MudDialog.Close();
    }
}
