@using Monica.EventBus.Abstractions
@using Monica.Framework.UI.UIEventBus.Models
@using Microsoft.Extensions.DependencyInjection
@using Monica.Core.Modularity.Diagnostics.Facades
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Results
@using Monica.UI.Shell.Support
@using Monica.UI.UIModuleSystem.Components
@implements IDisposable
@inject IServiceProvider Services
@inject OperationalPageAccessEvaluator OperationalPageAccess
@inject IStringLocalizer<EventBusResource> L

<MudDialog Visible="IsVisible" VisibleChanged="OnVisibleChanged" Options="DialogOptions">
    <DialogContent>
        @if (Provider != null)
        {
            <div class="provider-detail-header mb-4">
                <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2">
                    <MudAvatar Color="@GetProviderColor()" Size="Size.Medium" Class="mr-2">
                        <MudIcon Icon="@GetProviderIcon()" />
                    </MudAvatar>
                    @L.GetProviderDisplayName(Provider)
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                    @Provider.ImplementationType
                </MudText>
            </div>

            <MudTabs Elevation="2"
                     Rounded="true"
                     ApplyEffectsToContainer="true"
                     ActivePanelIndex="@_activeTabIndex"
                     ActivePanelIndexChanged="OnActiveTabChanged">
                <MudTabPanel Text="@L["Providers:Detail:Tabs:Info"]" Icon="@Icons.Material.Filled.Info">
                    <div class="tab-content pa-4">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["Providers:Detail:Fields:ProviderType"]</MudText>
                                    </div>
                                    <MudChip T="string" Color="@GetProviderColor()" Size="Size.Small">
                                        @L.GetProviderKindText(Provider.ProviderType)
                                    </MudChip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Key" Color="Color.Info" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["Providers:Detail:Fields:ServiceKey"]</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @(Provider.ServiceKey ?? L["Services:Common:DefaultProviderKeyWithNoKey"].Value)
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@(Provider.IsDistributed ? Icons.Material.Filled.Cloud : Icons.Material.Filled.Memory)"
                                                 Color="@(Provider.IsDistributed ? Color.Info : Color.Success)"
                                                 Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["Providers:Detail:Fields:BusMode"]</MudText>
                                    </div>
                                    <MudChip T="string"
                                             Color="@(Provider.IsDistributed ? Color.Info : Color.Success)"
                                             Size="Size.Small">
                                        @L.GetProviderModeText(Provider.IsDistributed)
                                    </MudChip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Secondary" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["Providers:Detail:Fields:ImplementationType"]</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @Provider.ImplementationType
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Extension" Color="Color.Tertiary" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">@L["Providers:Detail:Fields:Capabilities"]</MudText>
                                    </div>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @if (Provider.SupportsBulkPublish)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.DynamicFeed" Size="Size.Small" Class="mr-1" />
                                                @L["Providers:Capabilities:BulkPublish"]
                                            </MudChip>
                                        }
                                        @if (Provider.SupportsStreaming)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.Stream" Size="Size.Small" Class="mr-1" />
                                                @L["Providers:Capabilities:Streaming"]
                                            </MudChip>
                                        }
                                        @if (Provider.SupportsDeadLetterQueue)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Class="mr-1" />
                                                @L["Providers:Capabilities:DeadLetterQueue"]
                                            </MudChip>
                                        }
                                        @if (Provider.Capabilities == EventBusProviderCapabilities.None)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                                @L["Providers:Capabilities:Basic"]
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@L["Providers:Detail:Tabs:Options"]" Icon="@Icons.Material.Filled.Settings">
                    <div class="tab-content pa-4">
                        @if (Provider.OptionDiagnosticsTarget is null)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                @L["Providers:Detail:Options:NoDedicatedConfiguration"]
                            </MudAlert>
                        }
                        else if (_optionDiagnosticsAccessDenied)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                @L["Providers:Detail:Options:AccessDenied"]
                            </MudAlert>
                        }
                        else if (_optionDiagnosticsFailed)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                                @L["Providers:Detail:Options:LoadFailed"]
                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadOptionDiagnosticsAsync">
                                    @L["Providers:Detail:Options:Retry"]
                                </MudButton>
                            </MudAlert>
                        }
                        else if (_optionDiagnostics is not null)
                        {
                            @if (_optionDiagnostics.ProfileResolution == ModuleOptionProfileResolution.DefaultFallback)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                                    @L[
                                        "Providers:Detail:Options:DefaultProfileFallback",
                                        _optionDiagnostics.RequestedProfileName ?? Provider.ServiceKey ?? string.Empty]
                                </MudAlert>
                            }
                            <ModuleOptionDiagnosticsPanel Diagnostics="@_optionDiagnostics" />
                        }
                        else
                        {
                            <div class="d-flex justify-center pa-4" role="status">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                            </div>
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@L["Providers:Detail:Tabs:Subscriptions"]" Icon="@Icons.Material.Filled.Subscriptions" BadgeData="@Subscriptions.Count.ToString()" BadgeColor="Color.Primary">
                    <div class="tab-content pa-4">
                        @if (!Subscriptions.Any())
                        {
                            <MudAlert Severity="Severity.Info">
                                @L["Providers:Detail:States:NoSubscriptions"]
                            </MudAlert>
                        }
                        else
                        {
                            <MudDataGrid T="SubscriptionViewModel" Items="@Subscriptions" Dense="true" Hover="true">
                                <Columns>
                                    <PropertyColumn Property="x => x.EventTypeShortName" Title="@L["Providers:Columns:EventType"]" />
                                    <PropertyColumn Property="x => x.TopicName" Title="@L["Providers:Columns:Topic"]" />
                                    <TemplateColumn Title="@L["Providers:Columns:State"]">
                                        <CellTemplate>
                                            <MudChip T="string" Size="Size.Small" Color="@context.Item.StateColor">
                                                @L.GetSubscriptionStateText(context.Item.State)
                                            </MudChip>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Providers:Columns:DiscoveryMode"]">
                                        <CellTemplate>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(context.Item.IsAutoDiscovered ? Color.Info : Color.Secondary)"
                                                     Variant="Variant.Outlined">
                                                @L.GetDiscoveryModeText(context.Item.IsAutoDiscovered)
                                            </MudChip>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="OnClose" StartIcon="@Icons.Material.Filled.Close">
            @L["Shared:Common:Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// Whether to display the dialog box
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>
    /// Whether to display dialog change events
    /// </summary>
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// Provider information
    /// </summary>
    [Parameter] public EventBusProviderInfo? Provider { get; set; }

    /// <summary>
    /// This Provider's subscription list
    /// </summary>
    [Parameter] public List<SubscriptionViewModel> Subscriptions { get; set; } = [];

    /// <summary>
    /// Dialog options
    /// </summary>
    private DialogOptions DialogOptions = new()
    {
        CloseButton = true,
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Large
    };

    private int _activeTabIndex;
    private string? _providerIdentity;
    private ModuleOptionDiagnostics? _optionDiagnostics;
    private bool _optionDiagnosticsFailed;
    private bool _optionDiagnosticsAccessDenied;
    private int _optionLoadVersion;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        var providerIdentity = Provider?.UniqueId;
        if (!string.Equals(_providerIdentity, providerIdentity, StringComparison.Ordinal))
        {
            _providerIdentity = providerIdentity;
            ClearOptionDiagnostics(resetTab: true);
        }

        if (!IsVisible)
        {
            ClearOptionDiagnostics(resetTab: true);
        }
    }

    /// <summary>
    /// Close dialog
    /// </summary>
    private Task OnClose() => SetVisibilityAsync(false);

    private Task OnVisibleChanged(bool isVisible) => SetVisibilityAsync(isVisible);

    private async Task SetVisibilityAsync(bool isVisible)
    {
        if (IsVisible == isVisible)
        {
            return;
        }

        IsVisible = isVisible;
        if (!isVisible)
        {
            ClearOptionDiagnostics(resetTab: true);
        }

        await IsVisibleChanged.InvokeAsync(isVisible);
    }

    private async Task OnActiveTabChanged(int tabIndex)
    {
        if (tabIndex != 1)
        {
            ClearOptionDiagnostics(resetTab: false);
            _activeTabIndex = tabIndex;
            return;
        }

        _activeTabIndex = tabIndex;
        if (Provider?.OptionDiagnosticsTarget is not null
            && _optionDiagnostics is null
            && !_optionDiagnosticsFailed
            && !_optionDiagnosticsAccessDenied)
        {
            await LoadOptionDiagnosticsAsync();
        }
    }

    private async Task LoadOptionDiagnosticsAsync()
    {
        var target = Provider?.OptionDiagnosticsTarget;
        if (target is null)
        {
            return;
        }

        var providerIdentity = _providerIdentity;
        var requestVersion = ++_optionLoadVersion;
        _optionDiagnostics = null;
        _optionDiagnosticsFailed = false;
        _optionDiagnosticsAccessDenied = false;

        var isAuthorized = await OperationalPageAccess.IsAuthorizedAsync();
        if (!CanApplyOptionLoad(requestVersion, providerIdentity))
        {
            return;
        }

        if (!isAuthorized)
        {
            _optionDiagnosticsAccessDenied = true;
            return;
        }

        var facade = Services.GetService<ModuleDiagnosticsFacade>();
        if (facade is null)
        {
            _optionDiagnosticsFailed = true;
            return;
        }

        var result = facade.GetModuleOptions(target.ModuleKey, target.ProfileSelector);
        if (result.IsFailed(out _, out var diagnostics))
        {
            _optionDiagnosticsFailed = true;
            return;
        }

        _optionDiagnostics = diagnostics;
    }

    private bool CanApplyOptionLoad(int requestVersion, string? providerIdentity) =>
        !_disposed
        && requestVersion == _optionLoadVersion
        && IsVisible
        && _activeTabIndex == 1
        && string.Equals(_providerIdentity, providerIdentity, StringComparison.Ordinal);

    private void ClearOptionDiagnostics(bool resetTab)
    {
        _optionLoadVersion++;
        _optionDiagnostics = null;
        _optionDiagnosticsFailed = false;
        _optionDiagnosticsAccessDenied = false;
        if (resetTab)
        {
            _activeTabIndex = 0;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        ClearOptionDiagnostics(resetTab: true);
    }

    private string GetProviderIcon() => Provider?.ProviderType switch
    {
        EventBusProviderKind.Local => Icons.Material.Filled.Memory,
        EventBusProviderKind.Dapr => Icons.Material.Filled.Cloud,
        _ => Icons.Material.Filled.Help
    };

    private Color GetProviderColor() => Provider?.ProviderType switch
    {
        EventBusProviderKind.Local => Color.Success,
        EventBusProviderKind.Dapr => Color.Info,
        _ => Color.Default
    };
}
