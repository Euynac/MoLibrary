@using Monica.Core.Results
@using Monica.Framework.ProjectUnits.Facades
@using Monica.UI.Shared.Components.Markdown
@using System.Linq
@using System.Reflection
@using Monica.Framework.ProjectUnits.Annotations
@using Monica.Framework.ProjectUnits.Models
@using Monica.Tool.Extensions
@inject ProjectUnitsFacade ProjectUnitsFacade
@inject IStringLocalizer<ProjectUnitsResource> L

<MudDialog @bind-Visible="Visible" Options="DialogOptions" OnBackdropClick="HandleBackdropClick">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-3" />
            @L["ProjectUnitDetailDialog:Title"]
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (SelectedUnit != null)
        {
            <MudSimpleTable Style="overflow-x: auto;" Elevation="0">
                <tbody>
                    <tr>
                        <td style="min-width: 120px;"><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Name"]</MudText></td>
                        <td><MudText>@SelectedUnit.Title</MudText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:FullName"]</MudText></td>
                        <td><MudText>@SelectedUnit.Key</MudText></td>
                    </tr>
                    @if (!string.IsNullOrEmpty(SelectedUnit.Author))
                    {
                        <tr>
                            <td><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Author"]</MudText></td>
                            <td><MudText>@SelectedUnit.Author</MudText></td>
                        </tr>
                    }
                    @if (SelectedUnit.Group?.Any() == true)
                    {
                        <tr>
                            <td><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Group"]</MudText></td>
                            <td><MudText>@string.Join(", ", SelectedUnit.Group)</MudText></td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(SelectedUnit.Description))
                    {
                        <tr>
                            <td><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Description"]</MudText></td>
                            <td><MudText>@SelectedUnit.Description</MudText></td>
                        </tr>
                    }
                    <tr>
                        <td><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Type"]</MudText></td>
                        <td>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@GetUnitTypeColor(SelectedUnit.UnitType)">
                                @L.GetProjectUnitTypeText(SelectedUnit.UnitType)
                            </MudChip>
                        </td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Statistics"]</MudText></td>
                        <td>
                            <MudChipSet T="string">
                                @if (SelectedUnit.DependencyUnits.Count > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                             Icon="@Icons.Material.Filled.Link">
                                        @L.GetCountText(ProjectUnitsCountText.Dependency, SelectedUnit.DependencyUnits.Count)
                                    </MudChip>
                                }
                                @if (SelectedUnit.DependedByCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                             Icon="@Icons.Material.Filled.CallReceived">
                                        @L.GetCountText(ProjectUnitsCountText.DependedBy, SelectedUnit.DependedByCount)
                                    </MudChip>
                                }
                                @if (SelectedUnit.Attributes.Any())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                             Icon="@Icons.Material.Filled.Label">
                                        @L.GetCountText(ProjectUnitsCountText.Attribute, SelectedUnit.Attributes.Count)
                                    </MudChip>
                                }
                                @if (SelectedUnit.Methods.Any())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                             Icon="@Icons.Material.Filled.Functions">
                                        @L.GetCountText(ProjectUnitsCountText.Method, SelectedUnit.Methods.Count)
                                    </MudChip>
                                }
                                @if (SelectedUnit.Alerts.Any())
                                {
                                    var errorCount = SelectedUnit.Alerts.Count(a => a.Level == EAlertLevel.Error);
                                    var warningCount = SelectedUnit.Alerts.Count(a => a.Level == EAlertLevel.Warning);
                                    var infoCount = SelectedUnit.Alerts.Count(a => a.Level == EAlertLevel.Info);
                                    
                                    @if (errorCount > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                                 Icon="@Icons.Material.Filled.Error">
                                            @L.GetCountText(ProjectUnitsCountText.Error, errorCount)
                                        </MudChip>
                                    }
                                    @if (warningCount > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                 Icon="@Icons.Material.Filled.Warning">
                                            @L.GetCountText(ProjectUnitsCountText.Warning, warningCount)
                                        </MudChip>
                                    }
                                    @if (infoCount > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                                 Icon="@Icons.Material.Filled.Info">
                                            @L.GetCountText(ProjectUnitsCountText.Info, infoCount)
                                        </MudChip>
                                    }
                                }
                            </MudChipSet>
                        </td>
                    </tr>
                    @if (SelectedUnit.DependencyUnits.Any())
                    {
                        <tr>
                            <td style="vertical-align: top;"><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Dependencies"]</MudText></td>
                            <td>
                                <MudChipSet T="string">
                                    @foreach (var dep in SelectedUnit.DependencyUnits)
                                    {
                                        <MudChip T="string" Size="Size.Small" 
                                                 Color="@GetUnitTypeColor(dep.UnitType)"
                                                 OnClick="@(() => OnChipClick(dep.Key))">
                                            @dep.Title
                                        </MudChip>
                                    }
                                </MudChipSet>
                            </td>
                        </tr>
                    }
                    @if (SelectedUnit.UnitType == EProjectUnitType.Configuration && _originalProjectUnit is UnitConfiguration configUnit)
                    {
                        <tr>
                            <td><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:ConfigurationMode"]</MudText></td>
                            <td>
                                @{
                                    var modeText = L.GetConfigurationModeText(configUnit.IsOffline);
                                    var modeColor = configUnit.IsOffline switch
                                    {
                                        true => Color.Success,
                                        false => Color.Warning,
                                        null => Color.Default
                                    };
                                    var modeIcon = configUnit.IsOffline switch
                                    {
                                        true => Icons.Material.Filled.CloudOff,
                                        false => Icons.Material.Filled.Cloud,
                                        null => Icons.Material.Filled.QuestionMark
                                    };
                                }
                                <MudChip T="string" Size="Size.Small" Color="@modeColor" Icon="@modeIcon">
                                    @modeText
                                </MudChip>
                            </td>
                        </tr>
                        @if (configUnit.ConfigurationDependencies.Any())
                        {
                            <tr>
                                <td style="vertical-align: top;"><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:ConfigurationUsage"]</MudText></td>
                                <td>
                                    <MudExpansionPanels>
                                        <MudExpansionPanel>
                                            <TitleContent>
                                                <div style="display: flex; align-items: center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Link" class="mr-3" />
                                                    <MudText>@L["ProjectUnitDetailDialog:Sections:ConfigurationUsageDetails", configUnit.ConfigurationDependencies.Count]</MudText>
                                                </div>
                                            </TitleContent>
                                            <ChildContent>
                                                <MudStack Spacing="1">
                                                    @foreach (var dependency in configUnit.ConfigurationDependencies)
                                                    {
                                                        var unit = dependency.Key;
                                                        var usage = dependency.Value;
                                                        var usageText = L.GetConfigurationUsageText(usage);
                                                        var usageColor = usage switch
                                                        {
                                                            EConfigurationUsageType.Offline => Color.Success,
                                                            EConfigurationUsageType.OnlineSnapshot => Color.Warning,
                                                            EConfigurationUsageType.OnlineMonitor => Color.Info,
                                                            EConfigurationUsageType.Unknown => Color.Default,
                                                            _ => Color.Default
                                                        };
                                                        var usageIcon = usage switch
                                                        {
                                                            EConfigurationUsageType.Offline => Icons.Material.Filled.CloudOff,
                                                            EConfigurationUsageType.OnlineSnapshot => Icons.Material.Filled.Cloud,
                                                            EConfigurationUsageType.OnlineMonitor => Icons.Material.Filled.Refresh,
                                                            EConfigurationUsageType.Unknown => Icons.Material.Filled.QuestionMark,
                                                            _ => Icons.Material.Filled.QuestionMark
                                                        };
                                                        
                                                        <div class="d-flex align-center justify-space-between">
                                                            <div class="d-flex align-center">
                                                                <MudChip T="string" Size="Size.Small" 
                                                                         Color="@GetUnitTypeColor(unit.UnitType)"
                                                                         OnClick="@(() => OnChipClick(unit.Key))">
                                                                    @unit.Title
                                                                </MudChip>
                                                                <MudText Typo="Typo.caption" Class="ml-2" Style="color: var(--mud-palette-text-secondary);">
                                                                    (@L.GetProjectUnitTypeText(unit.UnitType))
                                                                </MudText>
                                                            </div>
                                                            <MudChip T="string" Size="Size.Small" Color="@usageColor" Icon="@usageIcon">
                                                                @usageText
                                                            </MudChip>
                                                        </div>
                                                    }
                                                </MudStack>
                                            </ChildContent>
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                </td>
                            </tr>
                        }
                    }
                    @if (_originalProjectUnit?.ConstructorParameterTypes.Any() == true)
                    {
                        <tr>
                            <td style="vertical-align: top;"><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:ConstructorParameters"]</MudText></td>
                            <td>
                                <MudExpansionPanels>
                                    <MudExpansionPanel>
                                        <TitleContent>
                                            <div style="display: flex; align-items: center">
                                                <MudIcon Icon="@Icons.Material.Filled.Construction" class="mr-3" />
                                                <MudText>@L["ProjectUnitDetailDialog:Sections:ConstructorParameters", _originalProjectUnit.ConstructorParameterTypes.Count]</MudText>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <MudStack Spacing="1">
                                                @foreach (var paramType in _originalProjectUnit.ConstructorParameterTypes)
                                                {
                                                    <div class="d-flex align-center">
                                                        <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" Class="mr-2" />
                                                        <MudText Style="font-family: 'Cascadia Code', 'JetBrains Mono', monospace; background-color: var(--mud-palette-background-gray); padding: 4px 8px; border-radius: 4px;">
                                                            @paramType.GetCleanName()
                                                        </MudText>
                                                        <MudText Typo="Typo.caption" Class="ml-2" Style="color: var(--mud-palette-text-secondary);">
                                                            (@paramType.GetCleanFullName())
                                                        </MudText>
                                                    </div>
                                                }
                                            </MudStack>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </td>
                        </tr>
                    }
                    @if (DependedByUnits != null && DependedByUnits.Any())
                    {
                        <tr>
                            <td style="vertical-align: top;"><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:DependedBy"]</MudText></td>
                            <td>
                                <MudChipSet T="string">
                                    @foreach (var dep in DependedByUnits)
                                    {
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetUnitTypeColor(dep.UnitType)"
                                                 OnClick="@(() => OnChipClick(dep.Key))">
                                            @dep.Title
                                        </MudChip>
                                    }
                                </MudChipSet>
                            </td>
                        </tr>
                    }
                    @if (SelectedUnit.Attributes.Any())
                    {
                        <tr>
                            <td style="vertical-align: top;"><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Attributes"]</MudText></td>
                            <td>
                                <MudChipSet T="string">
                                    @foreach (var attr in SelectedUnit.Attributes)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                                            @attr.GetType().Name
                                        </MudChip>
                                    }
                                </MudChipSet>
                            </td>
                        </tr>
                    }
                    @if (SelectedUnit.Methods.Any())
                    {
                        <tr>
                            <td style="vertical-align: top;"><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Methods"]</MudText></td>
                            <td>
                                <MudExpansionPanels>
                                    <MudExpansionPanel>
                                        <TitleContent>
                                            <div style="display: flex; align-items: center">
                                                <MudIcon Icon="@Icons.Material.Filled.Functions" class="mr-3" />
                                                <MudText>@L["ProjectUnitDetailDialog:Sections:PublicMethods", SelectedUnit.Methods.Count]</MudText>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <MudStack Spacing="2">
                                                @foreach (var method in SelectedUnit.Methods)
                                                {
                                                    <MudCard Outlined="true" Style="border-left: 3px solid var(--mud-palette-primary);">
                                                        <MudCardContent Class="pa-2">
                                                            <div class="d-flex align-center justify-space-between">
                                                                <MudText Typo="Typo.caption" Style="font-family: 'Cascadia Code', 'JetBrains Mono', monospace; background-color: var(--mud-palette-background-gray); padding: 6px 10px; border-radius: 4px; flex-grow: 1;">
                                                                    @method.MethodSignature
                                                                </MudText>
                                                                <MudChipSet T="string" Class="ml-2">
                                                                    @if (method.MethodInfo.IsStatic)
                                                                    {
                                                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                                                                 Icon="@Icons.Material.Filled.Public">
                                                                            @L.GetMethodModifierText(ProjectUnitsMethodModifier.Static)
                                                                        </MudChip>
                                                                    }
                                                                    @if (method.MethodInfo.IsVirtual && !method.MethodInfo.IsAbstract)
                                                                    {
                                                                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">
                                                                            @L.GetMethodModifierText(ProjectUnitsMethodModifier.Virtual)
                                                                        </MudChip>
                                                                    }
                                                                    @if (method.MethodInfo.IsAbstract)
                                                                    {
                                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                                                            @L.GetMethodModifierText(ProjectUnitsMethodModifier.Abstract)
                                                                        </MudChip>
                                                                    }
                                                                    @if (IsAsyncMethod(method.MethodInfo))
                                                                    {
                                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                                                                 Icon="@Icons.Material.Filled.Sync">
                                                                            @L.GetMethodModifierText(ProjectUnitsMethodModifier.Async)
                                                                        </MudChip>
                                                                    }
                                                                </MudChipSet>
                                                            </div>
                                                            
                                                            @if (!string.IsNullOrEmpty(method.Description))
                                                            {
                                                                <MudText Typo="Typo.body2" Class="mt-2 ml-2" Style="color: var(--mud-palette-text-secondary); font-style: italic;">
                                                                    // @method.Description
                                                                </MudText>
                                                            }
                                                        </MudCardContent>
                                                    </MudCard>
                                                }
                                            </MudStack>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </td>
                        </tr>
                    }
                    @if (SelectedUnit.Alerts.Any())
                    {
                        <tr>
                            <td style="vertical-align: top;"><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Alerts"]</MudText></td>
                            <td>
                                <MudStack Spacing="1">
                                    @foreach (var alert in SelectedUnit.Alerts.OrderByDescending(a => a.Level))
                                    {
                                        var alertColor = alert.Level switch
                                        {
                                            EAlertLevel.Error => Color.Error,
                                            EAlertLevel.Warning => Color.Warning,
                                            EAlertLevel.Info => Color.Info,
                                            _ => Color.Default
                                        };
                                        var alertIcon = alert.Level switch
                                        {
                                            EAlertLevel.Error => Icons.Material.Filled.Error,
                                            EAlertLevel.Warning => Icons.Material.Filled.Warning,
                                            EAlertLevel.Info => Icons.Material.Filled.Info,
                                            _ => Icons.Material.Filled.Info
                                        };
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@alertIcon" Color="@alertColor" Size="Size.Small" Class="mr-2" />
                                            <MudText>
                                                <strong>[@L.GetAlertLevelText(alert.Level)]</strong> @alert.Message
                                                @if (!string.IsNullOrEmpty(alert.Source))
                                                {
                                                    <MudText Typo="Typo.caption" Class="ml-2" Style="display: inline;">(@alert.Source)</MudText>
                                                }
                                            </MudText>
                                        </div>
                                    }
                                </MudStack>
                            </td>
                        </tr>
                    }
                    @{
                        var unitInfoAttribute = GetUnitInfoAttribute();
                    }
                    @if (unitInfoAttribute?.MarkdownDocs != null)
                    {
                        <tr>
                            <td style="vertical-align: top;"><MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Documentation"]</MudText></td>
                            <td>
                                <MudExpansionPanels>
                                    <MudExpansionPanel>
                                        <TitleContent>
                                            <div style="display: flex; align-items: center">
                                                <MudIcon Icon="@Icons.Material.Filled.Description" class="mr-3" />
                                                <MudText>@L["ProjectUnitDetailDialog:Sections:MarkdownDocument"]</MudText>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <MarkdownThemeSync />
                                            <div style="max-height: 400px; overflow-y: auto;">
                                                <MudMarkdown Value="@unitInfoAttribute.MarkdownDocs" />
                                            </div>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Shared:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    
    [Parameter] public DtoProjectUnit? SelectedUnit { get; set; }
    [Parameter] public List<DtoProjectUnit>? AllProjectUnits { get; set; }
    [Parameter] public EventCallback<string> OnNodeFocus { get; set; }
    
    private List<DtoProjectUnit>? DependedByUnits { get; set; }
    private ProjectUnit? _originalProjectUnit;
    
    private readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        BackdropClick = true, 
        CloseOnEscapeKey = true 
    };
    
    protected override void OnParametersSet()
    {
        if (SelectedUnit != null && AllProjectUnits != null)
        {
            // Calculate units that depend on the current unit.
            DependedByUnits = AllProjectUnits
                .Where(u => u.DependencyUnits.Any(d => d.Key == SelectedUnit.Key))
                .ToList();

            // Try to load the original ProjectUnit instance.
            var result = ProjectUnitsFacade.GetProjectUnitByKey(SelectedUnit.Key);
            _originalProjectUnit = result.IsFailed(out _, out var data) ? null : data;
        }
    }
    
    private async Task OnChipClick(string nodeKey)
    {
        // Close the dialog first.
        await VisibleChanged.InvokeAsync(false);

        // Then request graph focus.
        if (OnNodeFocus.HasDelegate)
        {
            await OnNodeFocus.InvokeAsync(nodeKey);
        }
    }
    
    private async Task Close()
    {
        await VisibleChanged.InvokeAsync(false);
    }
    
    private async Task HandleBackdropClick()
    {
        // Keep dialog state synchronized when the backdrop is clicked.
        await VisibleChanged.InvokeAsync(false);
    }
    
    private Color GetUnitTypeColor(EProjectUnitType unitType)
    {
        return ProjectUnitVisualizationConfig.GetUnitTypeMudColor(unitType);
    }
    
    private bool IsAsyncMethod(MethodInfo method)
    {
        return method.ReturnType.IsGenericType && 
               (method.ReturnType.GetGenericTypeDefinition() == typeof(Task<>) || 
                method.ReturnType == typeof(Task));
    }
    
    private UnitInfoAttribute? GetUnitInfoAttribute()
    {
        return SelectedUnit?.Attributes.OfType<UnitInfoAttribute>().FirstOrDefault();
    }
}
