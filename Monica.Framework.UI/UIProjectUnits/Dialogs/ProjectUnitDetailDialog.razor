@using Monica.Core.Results
@using Monica.Framework.UI.UIProjectUnits.Services
@using Monica.ProjectUnits.Models
@inject IProjectUnitsUiDataSource DataSource
@inject IStringLocalizer<ProjectUnitsResource> L
@implements IAsyncDisposable

<MudDialog @bind-Visible="Visible" Options="_dialogOptions" OnBackdropClick="CloseAsync">
    <TitleContent>
        <div class="project-unit-detail__dialog-title">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@L["ProjectUnitDetailDialog:Title"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="project-unit-detail__loading" data-testid="project-unit-detail-loading">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Color="Color.Secondary">@L["ProjectUnitDetailDialog:States:Loading"]</MudText>
            </div>
        }
        else if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="project-unit-detail-error">
                @_loadError
            </MudAlert>
        }
        else if (_detail is not null)
        {
            var summary = _detail.Summary;
            <article class="project-unit-detail" data-testid="project-unit-detail">
                <header class="project-unit-detail__hero">
                    <div class="project-unit-detail__identity">
                        <div class="project-unit-detail__icon" data-color-role="@ProjectUnitVisualizationConfig.GetUnitTypeColorRole(summary.UnitType)">
                            <MudIcon Icon="@ProjectUnitVisualizationConfig.GetUnitTypeIcon(summary.UnitType)" Size="Size.Large" />
                        </div>
                        <div class="project-unit-detail__heading">
                            <MudText Typo="Typo.h5">@summary.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="project-unit-detail__key">
                                @summary.Key
                            </MudText>
                        </div>
                    </div>
                    <div class="project-unit-detail__badges">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@ProjectUnitVisualizationConfig.GetUnitTypeMudColor(summary.UnitType)"
                                 Icon="@ProjectUnitVisualizationConfig.GetUnitTypeIcon(summary.UnitType)">
                            @L.GetProjectUnitTypeText(summary.UnitType)
                        </MudChip>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(summary.HasExplicitMetadata ? Color.Success : Color.Warning)"
                                 Variant="Variant.Outlined"
                                 Icon="@(summary.HasExplicitMetadata ? Icons.Material.Filled.Verified : Icons.Material.Filled.Info)">
                            @(summary.HasExplicitMetadata
                                ? L["ProjectUnitDetailDialog:Badges:MetadataDeclared"]
                                : L["ProjectUnitDetailDialog:Badges:MetadataMissing"])
                        </MudChip>
                    </div>
                </header>

                @if (!string.IsNullOrWhiteSpace(summary.Description))
                {
                    <MudText Typo="Typo.body1" Class="project-unit-detail__description">@summary.Description</MudText>
                }

                <div class="project-unit-detail__facts">
                    <div class="project-unit-detail__fact">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Primary" Size="Size.Small" />
                        <span>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ProjectUnitDetailDialog:Fields:Owner"]</MudText>
                            <MudText Typo="Typo.body2">@(summary.Owner ?? L["Shared:Labels:NotDeclared"])</MudText>
                        </span>
                    </div>
                    <div class="project-unit-detail__fact">
                        <MudIcon Icon="@Icons.Material.Filled.Link" Color="Color.Info" Size="Size.Small" />
                        <span>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ProjectUnitDetailDialog:Fields:Dependencies"]</MudText>
                            <MudText Typo="Typo.body2">@summary.Dependencies.Count</MudText>
                        </span>
                    </div>
                    <div class="project-unit-detail__fact">
                        <MudIcon Icon="@Icons.Material.Filled.CallReceived" Color="Color.Success" Size="Size.Small" />
                        <span>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ProjectUnitDetailDialog:Fields:DependedBy"]</MudText>
                            <MudText Typo="Typo.body2">@summary.DependedByCount</MudText>
                        </span>
                    </div>
                    <div class="project-unit-detail__fact">
                        <MudIcon Icon="@Icons.Material.Filled.Functions" Color="Color.Secondary" Size="Size.Small" />
                        <span>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ProjectUnitDetailDialog:Fields:Methods"]</MudText>
                            <MudText Typo="Typo.body2">@summary.MethodCount</MudText>
                        </span>
                    </div>
                </div>

                <section class="project-unit-detail__section">
                    <div class="project-unit-detail__section-title">
                        <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Secondary" />
                        <div>
                            <MudText Typo="Typo.h6">@L["ProjectUnitDetailDialog:Sections:Requirements"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["ProjectUnitDetailDialog:Sections:RequirementsHint"]
                            </MudText>
                        </div>
                    </div>
                    @if (_detail.Requirements.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                            @L["ProjectUnitDetailDialog:States:NoRequirements"]
                        </MudAlert>
                    }
                    else
                    {
                        <div class="project-unit-detail__requirements">
                            @foreach (var requirement in _detail.Requirements)
                            {
                                <div class="project-unit-detail__requirement" data-resolved="@requirement.IsResolved.ToString().ToLowerInvariant()">
                                    <MudIcon Icon="@(requirement.IsResolved ? Icons.Material.Filled.Link : Icons.Material.Filled.LinkOff)"
                                             Color="@(requirement.IsResolved ? Color.Primary : Color.Default)" />
                                    <div class="project-unit-detail__requirement-copy">
                                        @if (requirement.IsResolved)
                                        {
                                            <a href="@requirement.Href" target="_blank" rel="noopener noreferrer"
                                               class="project-unit-detail__requirement-link">
                                                @requirement.Title
                                                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                            </a>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2">@requirement.Title</MudText>
                                        }
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@requirement.Id</MudText>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@(requirement.IsResolved ? Color.Success : Color.Default)">
                                        @(requirement.IsResolved
                                            ? L["ProjectUnitDetailDialog:Badges:Resolved"]
                                            : L["ProjectUnitDetailDialog:Badges:Unresolved"])
                                    </MudChip>
                                </div>
                            }
                        </div>
                    }
                </section>

                @if (summary.Tags.Count != 0)
                {
                    <section class="project-unit-detail__section">
                        <div class="project-unit-detail__section-title">
                            <MudIcon Icon="@Icons.Material.Filled.Label" Color="Color.Tertiary" />
                            <MudText Typo="Typo.h6">@L["ProjectUnitDetailDialog:Sections:Tags"]</MudText>
                        </div>
                        <MudChipSet T="string">
                            @foreach (var tag in summary.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                            }
                        </MudChipSet>
                    </section>
                }

                <section class="project-unit-detail__section">
                    <div class="project-unit-detail__section-title">
                        <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Info" />
                        <MudText Typo="Typo.h6">@L["ProjectUnitDetailDialog:Sections:Relationships"]</MudText>
                    </div>
                    <div class="project-unit-detail__relationships">
                        <div>
                            <MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:Dependencies"]</MudText>
                            @if (summary.Dependencies.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Shared:Labels:None"]</MudText>
                            }
                            else
                            {
                                <div class="project-unit-detail__reference-list">
                                    @foreach (var dependency in summary.Dependencies)
                                    {
                                        <button type="button" class="project-unit-detail__reference" @onclick="@(() => LoadDetailAsync(dependency.Key))">
                                            <MudIcon Icon="@ProjectUnitVisualizationConfig.GetUnitTypeIcon(dependency.UnitType)" Size="Size.Small" />
                                            <span>@dependency.Title</span>
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div>
                            <MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:DependedBy"]</MudText>
                            @if (_detail.Dependents.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Shared:Labels:None"]</MudText>
                            }
                            else
                            {
                                <div class="project-unit-detail__reference-list">
                                    @foreach (var dependent in _detail.Dependents)
                                    {
                                        <button type="button" class="project-unit-detail__reference" @onclick="@(() => LoadDetailAsync(dependent.Key))">
                                            <MudIcon Icon="@ProjectUnitVisualizationConfig.GetUnitTypeIcon(dependent.UnitType)" Size="Size.Small" />
                                            <span>@dependent.Title</span>
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>

                @if (_detail.Configuration is not null)
                {
                    <section class="project-unit-detail__section">
                        <div class="project-unit-detail__section-title">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Warning" />
                            <MudText Typo="Typo.h6">@L["ProjectUnitDetailDialog:Sections:Configuration"]</MudText>
                        </div>
                        <div class="project-unit-detail__configuration">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ProjectUnitDetailDialog:Fields:DefinitionKey"]</MudText>
                                <code>@_detail.Configuration.DefinitionKey</code>
                            </div>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(_detail.Configuration.IsOffline is true ? Color.Success : Color.Info)"
                                     Icon="@(_detail.Configuration.IsOffline is true ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.Cloud)">
                                @L.GetConfigurationModeText(_detail.Configuration.IsOffline)
                            </MudChip>
                        </div>
                        @if (_detail.Configuration.Usages.Count != 0)
                        {
                            <div class="project-unit-detail__usage-list">
                                @foreach (var usage in _detail.Configuration.Usages)
                                {
                                    <div class="project-unit-detail__usage">
                                        <button type="button" class="project-unit-detail__reference" @onclick="@(() => LoadDetailAsync(usage.Unit.Key))">
                                            <span>@usage.Unit.Title</span>
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                        </button>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @L.GetConfigurationUsageText(usage.UsageType)
                                        </MudChip>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }

                @if (_detail.ConstructorParameters.Count != 0 || _detail.Methods.Count != 0)
                {
                    <section class="project-unit-detail__section">
                        <div class="project-unit-detail__section-title">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">@L["ProjectUnitDetailDialog:Sections:TechnicalShape"]</MudText>
                        </div>
                        @if (_detail.ConstructorParameters.Count != 0)
                        {
                            <MudText Typo="Typo.subtitle2">@L["ProjectUnitDetailDialog:Fields:ConstructorParameters"]</MudText>
                            <div class="project-unit-detail__code-list">
                                @foreach (var parameter in _detail.ConstructorParameters)
                                {
                                    <code>@parameter</code>
                                }
                            </div>
                        }
                        @if (_detail.Methods.Count != 0)
                        {
                            <MudExpansionPanels Class="project-unit-detail__methods" Elevation="0">
                                <MudExpansionPanel Text="@L["ProjectUnitDetailDialog:Sections:PublicMethods", _detail.Methods.Count]">
                                    <div class="project-unit-detail__method-list">
                                        @foreach (var method in _detail.Methods)
                                        {
                                            <div class="project-unit-detail__method">
                                                <code>@method.Signature</code>
                                                <div class="project-unit-detail__method-badges">
                                                    @if (method.IsAsync)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@L.GetMethodModifierText(ProjectUnitsMethodModifier.Async)</MudChip>
                                                    }
                                                    @if (method.IsStatic)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L.GetMethodModifierText(ProjectUnitsMethodModifier.Static)</MudChip>
                                                    }
                                                    @if (method.IsVirtual)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L.GetMethodModifierText(ProjectUnitsMethodModifier.Virtual)</MudChip>
                                                    }
                                                    @if (method.IsAbstract)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L.GetMethodModifierText(ProjectUnitsMethodModifier.Abstract)</MudChip>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(method.Description))
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@method.Description</MudText>
                                                }
                                            </div>
                                        }
                                    </div>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                    </section>
                }

                @if (summary.Alerts.Count != 0)
                {
                    <section class="project-unit-detail__section">
                        <div class="project-unit-detail__section-title">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                            <MudText Typo="Typo.h6">@L["ProjectUnitDetailDialog:Fields:Alerts"]</MudText>
                        </div>
                        <div class="project-unit-detail__alerts">
                            @foreach (var alert in summary.Alerts)
                            {
                                <MudAlert Severity="@GetAlertSeverity(alert.Level)" Variant="Variant.Outlined" Dense="true">
                                    <strong>@L.GetAlertLevelText(alert.Level)</strong>
                                    @alert.Message
                                    @if (!string.IsNullOrWhiteSpace(alert.Source))
                                    {
                                        <span class="project-unit-detail__alert-source">@alert.Source</span>
                                    }
                                </MudAlert>
                            }
                        </div>
                    </section>
                }
            </article>
        }
    </DialogContent>
    <DialogActions>
        @if (_detail is not null && OnNodeFocus.HasDelegate)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.CenterFocusStrong" OnClick="FocusCurrentAsync">
                @L["ProjectUnitDetailDialog:Actions:FocusInGraph"]
            </MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseAsync">
            @L["Shared:Actions:Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public ProjectUnitSummary? SelectedUnit { get; set; }

    [Parameter]
    public EventCallback<string> OnNodeFocus { get; set; }

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Large,
        FullWidth = true,
        BackdropClick = true,
        CloseOnEscapeKey = true
    };

    private CancellationTokenSource? _loadCancellation;
    private ProjectUnitDetail? _detail;
    private string? _loadError;
    private string? _selectedSourceKey;
    private bool _loading;
    private bool _wasVisible;

    protected override async Task OnParametersSetAsync()
    {
        var shouldLoad = Visible
                         && SelectedUnit is not null
                         && (!_wasVisible || !string.Equals(_selectedSourceKey, SelectedUnit.Key, StringComparison.Ordinal));

        _wasVisible = Visible;
        if (!shouldLoad)
        {
            return;
        }

        _selectedSourceKey = SelectedUnit!.Key;
        await LoadDetailAsync(SelectedUnit.Key);
    }

    private async Task LoadDetailAsync(string key)
    {
        await CancelPendingLoadAsync();
        var cancellation = new CancellationTokenSource();
        _loadCancellation = cancellation;
        _loading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            var result = await DataSource.GetDetailAsync(key, cancellation.Token);
            if (result.IsFailed(out var error, out var detail))
            {
                _detail = null;
                _loadError = L["ProjectUnitDetailDialog:States:LoadFailed", error];
                return;
            }

            _detail = detail;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _detail = null;
            _loadError = L["ProjectUnitDetailDialog:States:LoadFailed", exception.Message];
        }
        finally
        {
            if (ReferenceEquals(_loadCancellation, cancellation))
            {
                _loadCancellation.Dispose();
                _loadCancellation = null;
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task FocusCurrentAsync()
    {
        if (_detail is null || !OnNodeFocus.HasDelegate)
        {
            return;
        }

        var key = _detail.Summary.Key;
        await CloseAsync();
        await OnNodeFocus.InvokeAsync(key);
    }

    private async Task CloseAsync()
    {
        await CancelPendingLoadAsync();
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task CancelPendingLoadAsync()
    {
        if (_loadCancellation is null)
        {
            return;
        }

        await _loadCancellation.CancelAsync();
        _loadCancellation.Dispose();
        _loadCancellation = null;
    }

    private static Severity GetAlertSeverity(EAlertLevel level)
    {
        return level switch
        {
            EAlertLevel.Error => Severity.Error,
            EAlertLevel.Warning => Severity.Warning,
            _ => Severity.Info
        };
    }

    public async ValueTask DisposeAsync()
    {
        await CancelPendingLoadAsync();
    }
}
