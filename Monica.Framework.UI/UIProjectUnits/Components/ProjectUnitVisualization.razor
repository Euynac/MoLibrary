@using Monica.Framework.ProjectUnits.Facades
@using Monica.Core.Results;
@using Monica.Framework.ProjectUnits.Models
@using static Monica.Framework.UI.UIProjectUnits.Components.ProjectUnitLayoutPanel
@using Monica.UI.Shared.Components.ContextMenu
@inject ProjectUnitsFacade ProjectUnitsFacade
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<ProjectUnitsResource> L
@implements IAsyncDisposable

<div class="project-units-tab-section">
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="project-units-tab-section__header">
        <MudText Typo="Typo.h6">@L["ProjectUnitVisualization:Header:Title"]</MudText>
        <div class="project-units-tab-section__actions">
            <MudTooltip Text="@L["ProjectUnitVisualization:Actions:RefreshTooltip"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               OnClick="LoadProjectUnitsAsync"
                               Disabled="@_loading" />
            </MudTooltip>
            <MudTooltip Text="@L["ProjectUnitVisualization:Actions:ResetViewTooltip"]">
                <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                               Color="Color.Secondary"
                               OnClick="ResetView"
                               Disabled="@_loading" />
            </MudTooltip>
            <MudTooltip Text="@L["ProjectUnitVisualization:Actions:LayoutSettingsTooltip"]">
                <MudIconButton Icon="@Icons.Material.Filled.Dashboard"
                               Color="Color.Info"
                               OnClick="ToggleLayoutPanel" />
            </MudTooltip>
            <MudTooltip Text="@L["ProjectUnitVisualization:Actions:FilterSettingsTooltip"]">
                <MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
                               Color="Color.Tertiary"
                               OnClick="ToggleFilterPanel" />
            </MudTooltip>
        </div>
    </MudStack>
    <div class="project-units-tab-section__body">
        @if (_showLayoutPanel)
        {
            <ProjectUnitLayoutPanel CurrentLayout="_currentLayout"
                                    ForceDistance="_forceDistance"
                                    ForceStrength="_forceStrength"
                                    CurrentLayoutChanged="OnLayoutChanged"
                                    ForceDistanceChanged="OnForceDistanceChanged"
                                    ForceStrengthChanged="OnForceStrengthChanged" />
        }

        @if (_showFilterPanel)
        {
            @if (!string.IsNullOrEmpty(_relatedToNodeId))
            {
                var relatedUnit = _allProjectUnits.FirstOrDefault(unit => unit.Key == _relatedToNodeId);
                <MudAlert Severity="Severity.Info" Class="mb-2" CloseIconClicked="ClearRelatedFilterClick">
                    @((MarkupString)L["ProjectUnitVisualization:States:RelatedNodesAlert", relatedUnit?.Title ?? _relatedToNodeId].Value)
                </MudAlert>
            }

            <ProjectUnitFilterPanel @bind-FilterText="_filterText"
                                    @bind-SelectedUnitTypes="_selectedUnitTypes"
                                    @bind-ShowOnlyWithDependencies="_showOnlyWithDependencies"
                                    @bind-ShowOnlyWithAlerts="_showOnlyWithAlerts"
                                    OnFiltersChanged="ApplyFilters" />
        }

        <div class="visualization-shell">
            <MudPaper Class="visualization-container" Elevation="0" Outlined="true">
                @if (_loading)
                {
                    <MudOverlay Visible="true" DarkBackground="false" Absolute="true">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    </MudOverlay>
                }
                <div id="project-unit-graph" @onclick="OnBackgroundClick" @oncontextmenu:preventDefault="true"></div>
            </MudPaper>
        </div>

        <MudPaper Class="pa-2" Elevation="0" Outlined="true">
            <MudGrid>
                <MudItem xs="12" sm="8">
                    <MudText Typo="Typo.caption">
                        @L["ProjectUnitVisualization:Legend:VisibleCount", _filteredUnits.Count, _allProjectUnits.Count]
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex justify-end">
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Circle" Color="Color.Info">
                        @L["ProjectUnitVisualization:Legend:SimpleUnit"]
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Square" Color="Color.Warning">
                        @L["ProjectUnitVisualization:Legend:ComplexUnit"]
                    </MudChip>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </div>
</div>

<ProjectUnitDetailDialog @bind-Visible="_detailDialogVisible"
                         SelectedUnit="_selectedUnit"
                         AllProjectUnits="_allProjectUnits"
                         OnNodeFocus="HandleNodeFocusFromDialog" />

<MoContextMenu TItem="DtoProjectUnit"
               Items="@_contextMenuItems"
               Visible="@_contextMenuOpen"
               InitialX="@_contextMenuX"
               InitialY="@_contextMenuY"
               ContextItem="@_contextMenuUnit"
               OnItemClick="@OnContextMenuItemClick"
               OnClose="@CloseContextMenu" />

@code {
    private IJSObjectReference? _jsModule;
    private List<DtoProjectUnit> _allProjectUnits = [];
    private List<DtoProjectUnit> _filteredUnits = [];
    private bool _loading;
    private bool _detailDialogVisible;
    private DtoProjectUnit? _selectedUnit;
    private DtoProjectUnit? _contextMenuUnit;
    private bool _showFilterPanel;
    private bool _showLayoutPanel;
    private string _filterText = string.Empty;
    private IReadOnlyCollection<EProjectUnitType> _selectedUnitTypes = new HashSet<EProjectUnitType>();
    private bool _showOnlyWithDependencies;
    private bool _showOnlyWithAlerts;
    private string? _relatedToNodeId;
    private bool _contextMenuOpen;
    private double _contextMenuX;
    private double _contextMenuY;
    private LayoutType _currentLayout = LayoutType.Force;
    private int _forceDistance = 500;
    private int _forceStrength = -300;
    private List<ContextMenuItem<DtoProjectUnit>> _contextMenuItems = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/Monica.Framework.UI/UIProjectUnits/projectUnitGraph.js");

        await InitializeGraph();
        await LoadProjectUnitsAsync();
    }

    private async Task InitializeGraph()
    {
        if (_jsModule is null)
        {
            return;
        }

        var isDarkMode = await JSRuntime.InvokeAsync<bool>(
            "eval",
            "document.documentElement.classList.contains('dark')");

        await _jsModule.InvokeVoidAsync(
            "initializeGraph",
            "project-unit-graph",
            isDarkMode,
            DotNetObjectReference.Create(this));
    }

    private async Task LoadProjectUnitsAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await ProjectUnitsFacade.GetAllProjectUnitsAsync();
            if (result.IsFailed(out var error, out var data))
            {
                Snackbar.Add(L["Shared:Messages:LoadFailed", error], Severity.Error);
                return;
            }

            _allProjectUnits = data;
            if (!_selectedUnitTypes.Any())
            {
                _selectedUnitTypes = new HashSet<EProjectUnitType>(
                    Enum.GetValues<EProjectUnitType>().Where(static type => type != EProjectUnitType.None));
            }

            _filteredUnits = new List<DtoProjectUnit>(_allProjectUnits);
            await UpdateGraph();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Shared:Messages:LoadException", ex.Message], Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task UpdateGraph()
    {
        if (_jsModule is null)
        {
            return;
        }

        await _jsModule.InvokeVoidAsync("updateGraph", PrepareGraphData());
        await SetLayout(_currentLayout);

        if (_currentLayout == LayoutType.Force)
        {
            await _jsModule.InvokeVoidAsync("setForceDistance", _forceDistance);
            await _jsModule.InvokeVoidAsync("setForceStrength", _forceStrength);
        }
    }

    private object PrepareGraphData()
    {
        var nodes = _filteredUnits.Select(unit => new
        {
            id = unit.Key,
            title = unit.Title,
            type = L.GetProjectUnitTypeText(unit.UnitType),
            typeValue = (int)unit.UnitType,
            dependencyCount = unit.DependencyUnits.Count,
            dependedByCount = unit.DependedByCount,
            hasAttributes = unit.Attributes.Any(),
            methodCount = unit.Methods.Count,
            hasMethod = unit.Methods.Any(),
            isComplex = ProjectUnitVisualizationConfig.IsComplexUnitType(unit.UnitType),
            color = ProjectUnitVisualizationConfig.GetUnitTypeColor(unit.UnitType),
            icon = ProjectUnitVisualizationConfig.GetUnitTypeIcon(unit.UnitType),
            chips = L.BuildProjectUnitGraphChips(unit),
            metadata = L.BuildProjectUnitGraphMetadata(unit),
            alertLevel = ProjectUnitVisualizationConfig.GetHighestAlertLevel(unit),
            alertCount = unit.Alerts.Count,
            tooltip = L.BuildProjectUnitGraphTooltip(unit),
            summary = L.BuildProjectUnitGraphSummary(unit),
            noMetadataText = L["ProjectUnitVisualization:Graph:NoMetadata"].Value
        }).ToList();

        var links = new List<object>();
        foreach (var unit in _filteredUnits)
        {
            foreach (var dependency in unit.DependencyUnits)
            {
                if (_filteredUnits.Any(item => item.Key == dependency.Key))
                {
                    links.Add(new
                    {
                        source = unit.Key,
                        target = dependency.Key
                    });
                }
            }
        }

        return new { nodes, links };
    }

    private void ToggleFilterPanel()
    {
        _showFilterPanel = !_showFilterPanel;
        if (_showFilterPanel)
        {
            _showLayoutPanel = false;
        }
    }

    private void ToggleLayoutPanel()
    {
        _showLayoutPanel = !_showLayoutPanel;
        if (_showLayoutPanel)
        {
            _showFilterPanel = false;
        }
    }

    private async Task SetLayout(LayoutType layoutType)
    {
        _currentLayout = layoutType;
        if (_jsModule is null)
        {
            return;
        }

        var layoutName = layoutType switch
        {
            LayoutType.Force => "force",
            LayoutType.Hierarchy => "hierarchy",
            LayoutType.Circular => "circular",
            LayoutType.MultiCircular => "multi_circular",
            _ => "force"
        };

        await _jsModule.InvokeVoidAsync("setLayout", layoutName);
    }

    private async Task OnForceDistanceChanged(int value)
    {
        _forceDistance = value;
        if (_jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("setForceDistance", value);
        }
    }

    private async Task OnForceStrengthChanged(int value)
    {
        _forceStrength = value;
        if (_jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("setForceStrength", value);
        }
    }

    private async Task ApplyFilters()
    {
        _filteredUnits = _allProjectUnits.Where(unit =>
        {
            if (!string.IsNullOrEmpty(_relatedToNodeId))
            {
                return GetAllRelatedNodes(_relatedToNodeId).Contains(unit.Key);
            }

            var matchesText = string.IsNullOrWhiteSpace(_filterText)
                || unit.Title.Contains(_filterText, StringComparison.OrdinalIgnoreCase)
                || unit.Key.Contains(_filterText, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrEmpty(unit.Author) && unit.Author.Contains(_filterText, StringComparison.OrdinalIgnoreCase))
                || (unit.Group?.Any(group => group.Contains(_filterText, StringComparison.OrdinalIgnoreCase)) == true)
                || (!string.IsNullOrEmpty(unit.Description) && unit.Description.Contains(_filterText, StringComparison.OrdinalIgnoreCase));

            var matchesType = !_selectedUnitTypes.Any() || _selectedUnitTypes.Contains(unit.UnitType);
            var matchesDependencies = !_showOnlyWithDependencies || unit.DependencyUnits.Any() || unit.DependedByCount > 0;
            var matchesAlerts = !_showOnlyWithAlerts || unit.Alerts.Any();

            return matchesText && matchesType && matchesDependencies && matchesAlerts;
        }).ToList();

        await UpdateGraph();
    }

    private async Task ResetView()
    {
        if (_jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("resetView");
        }
    }

    [JSInvokable]
    public void OnNodeClick(string nodeId)
    {
        _selectedUnit = _allProjectUnits.FirstOrDefault(unit => unit.Key == nodeId);
        if (_selectedUnit is null)
        {
            return;
        }

        _detailDialogVisible = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnNodeRightClick(string nodeId, double x, double y)
    {
        _contextMenuUnit = _allProjectUnits.FirstOrDefault(unit => unit.Key == nodeId);
        if (_contextMenuUnit is null)
        {
            return;
        }

        _contextMenuX = x;
        _contextMenuY = y;
        _contextMenuItems = BuildContextMenuItems(_contextMenuUnit);
        _contextMenuOpen = true;
        StateHasChanged();
    }

    private void OnBackgroundClick()
    {
        if (!_contextMenuOpen)
        {
            return;
        }

        _contextMenuOpen = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSvgBackgroundClick()
    {
        if (!_contextMenuOpen)
        {
            return;
        }

        _contextMenuOpen = false;
        StateHasChanged();
    }

    private void CloseContextMenu()
    {
        _contextMenuOpen = false;
    }

    private List<ContextMenuItem<DtoProjectUnit>> BuildContextMenuItems(DtoProjectUnit unit)
    {
        var builder = ContextMenuBuilder<DtoProjectUnit>.Create()
            .AddItem(L["ProjectUnitVisualization:ContextMenu:Details"], Icons.Material.Filled.Info, ShowContextDetailsAsync)
            .AddItem(L["ProjectUnitVisualization:ContextMenu:FocusNode"], Icons.Material.Filled.CenterFocusStrong, FocusOnNodeAsync)
            .AddItem(L["ProjectUnitVisualization:ContextMenu:FilterByType"], Icons.Material.Filled.FilterAlt, FilterByTypeAsync);

        if (!string.IsNullOrEmpty(_relatedToNodeId))
        {
            if (_relatedToNodeId == unit.Key)
            {
                builder.AddItem(L["ProjectUnitVisualization:ContextMenu:ClearRelatedFilter"], Icons.Material.Filled.Clear, ClearRelatedFilterAsync);
            }
            else
            {
                builder.AddItem(L["ProjectUnitVisualization:ContextMenu:ShowOtherRelatedNodes"], Icons.Material.Filled.AccountTree, ShowRelatedNodesAsync);
            }
        }
        else
        {
            builder.AddItem(L["ProjectUnitVisualization:ContextMenu:ShowRelatedNodes"], Icons.Material.Filled.AccountTree, ShowRelatedNodesAsync);
        }

        builder
            .AddItem(L["ProjectUnitVisualization:ContextMenu:ClearAllFilters"], Icons.Material.Filled.ClearAll, ClearAllFiltersAsync)
            .AddDivider()
            .AddItem(L["ProjectUnitVisualization:ContextMenu:CopyFullName"], Icons.Material.Filled.ContentCopy, CopyFullNameAsync);

        return builder.Build();
    }

    private Task OnContextMenuItemClick(ContextMenuItem<DtoProjectUnit> item)
    {
        _contextMenuOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ShowContextDetailsAsync(DtoProjectUnit? unit)
    {
        _selectedUnit = unit ?? _contextMenuUnit;
        _detailDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task FocusOnNodeAsync(DtoProjectUnit? unit)
    {
        var targetUnit = unit ?? _contextMenuUnit;
        if (_jsModule is not null && targetUnit is not null)
        {
            await _jsModule.InvokeVoidAsync("focusOnNode", targetUnit.Key);
        }
    }

    private Task OnLayoutChanged(LayoutType layoutType)
    {
        return SetLayout(layoutType);
    }

    private async Task FilterByTypeAsync(DtoProjectUnit? unit)
    {
        var targetUnit = unit ?? _contextMenuUnit;
        if (targetUnit is null)
        {
            return;
        }

        _selectedUnitTypes = new HashSet<EProjectUnitType> { targetUnit.UnitType };
        _showFilterPanel = true;
        await ApplyFilters();
    }

    private async Task ClearAllFiltersAsync(DtoProjectUnit? unit)
    {
        _filterText = string.Empty;
        _selectedUnitTypes = new HashSet<EProjectUnitType>(
            Enum.GetValues<EProjectUnitType>().Where(static type => type != EProjectUnitType.None));
        _showOnlyWithDependencies = false;
        _showOnlyWithAlerts = false;
        _relatedToNodeId = null;
        await ApplyFilters();
    }

    private async Task ShowRelatedNodesAsync(DtoProjectUnit? unit)
    {
        var targetUnit = unit ?? _contextMenuUnit;
        if (targetUnit is null)
        {
            return;
        }

        _relatedToNodeId = targetUnit.Key;
        _showFilterPanel = true;
        await ApplyFilters();
        Snackbar.Add(L["ProjectUnitVisualization:Messages:ShowingRelatedNodes", targetUnit.Title], Severity.Info);
    }

    private Task ClearRelatedFilterAsync(DtoProjectUnit? unit)
    {
        _relatedToNodeId = null;
        return ApplyFilters();
    }

    private Task ClearRelatedFilterClick()
    {
        _relatedToNodeId = null;
        return ApplyFilters();
    }

    private async Task CopyFullNameAsync(DtoProjectUnit? unit)
    {
        var targetUnit = unit ?? _contextMenuUnit;
        if (targetUnit is null)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", targetUnit.Key);
        Snackbar.Add(L["ProjectUnitVisualization:Messages:CopiedToClipboard"], Severity.Success);
    }

    private HashSet<string> GetAllRelatedNodes(string nodeId)
    {
        var related = new HashSet<string>();
        var queue = new Queue<string>();

        queue.Enqueue(nodeId);
        related.Add(nodeId);

        while (queue.Count > 0)
        {
            var currentId = queue.Dequeue();
            var currentUnit = _allProjectUnits.FirstOrDefault(unit => unit.Key == currentId);

            if (currentUnit is not null)
            {
                foreach (var dependency in currentUnit.DependencyUnits)
                {
                    if (related.Add(dependency.Key))
                    {
                        queue.Enqueue(dependency.Key);
                    }
                }
            }

            var dependents = _allProjectUnits.Where(unit =>
                unit.DependencyUnits.Any(dependency => dependency.Key == currentId));

            foreach (var dependent in dependents)
            {
                if (related.Add(dependent.Key))
                {
                    queue.Enqueue(dependent.Key);
                }
            }
        }

        return related;
    }

    private async Task HandleNodeFocusFromDialog(string nodeKey)
    {
        if (_jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("focusOnNode", nodeKey);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("dispose");
            await _jsModule.DisposeAsync();
        }
    }
}
