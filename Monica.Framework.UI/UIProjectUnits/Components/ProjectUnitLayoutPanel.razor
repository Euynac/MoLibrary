@inject IStringLocalizer<ProjectUnitsResource> L

<MudPaper Class="pa-4 mb-4 project-units-control-panel" Elevation="0" Outlined="true">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["ProjectUnitLayoutPanel:Sections:LayoutType"]</MudText>
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
                <MudButton OnClick="@(() => SetLayout(LayoutType.Force))"
                           Variant="@(CurrentLayout == LayoutType.Force ? Variant.Filled : Variant.Outlined)">
                    @L["ProjectUnitLayoutPanel:Layouts:Force"]
                </MudButton>
                <MudButton OnClick="@(() => SetLayout(LayoutType.Hierarchy))"
                           Variant="@(CurrentLayout == LayoutType.Hierarchy ? Variant.Filled : Variant.Outlined)">
                    @L["ProjectUnitLayoutPanel:Layouts:Hierarchy"]
                </MudButton>
                <MudButton OnClick="@(() => SetLayout(LayoutType.Circular))"
                           Variant="@(CurrentLayout == LayoutType.Circular ? Variant.Filled : Variant.Outlined)">
                    @L["ProjectUnitLayoutPanel:Layouts:Circular"]
                </MudButton>
                <MudButton OnClick="@(() => SetLayout(LayoutType.MultiCircular))"
                           Variant="@(CurrentLayout == LayoutType.MultiCircular ? Variant.Filled : Variant.Outlined)">
                    @L["ProjectUnitLayoutPanel:Layouts:MultiCircular"]
                </MudButton>
            </MudButtonGroup>
        </MudItem>
        @if (CurrentLayout == LayoutType.Force)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["ProjectUnitLayoutPanel:Fields:ForceDistance", ForceDistance]</MudText>
                <MudSlider T="int" Value="@ForceDistance"
                           ValueChanged="@OnForceDistanceChanged"
                           Min="50" Max="2000" Step="10"
                           Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["ProjectUnitLayoutPanel:Fields:ForceStrength", ForceStrength]</MudText>
                <MudSlider T="int" Value="@ForceStrength"
                           ValueChanged="@OnForceStrengthChanged"
                           Min="-1000" Max="-100" Step="50"
                           Color="Color.Secondary" />
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public LayoutType CurrentLayout { get; set; } = LayoutType.Force;
    [Parameter] public EventCallback<LayoutType> CurrentLayoutChanged { get; set; }
    
    [Parameter] public int ForceDistance { get; set; } = 550;
    [Parameter] public EventCallback<int> ForceDistanceChanged { get; set; }
    
    [Parameter] public int ForceStrength { get; set; } = -300;
    [Parameter] public EventCallback<int> ForceStrengthChanged { get; set; }
    
    public enum LayoutType
    {
        Force,
        Hierarchy,
        Circular,
        MultiCircular
    }
    
    private async Task SetLayout(LayoutType layoutType)
    {
        CurrentLayout = layoutType;
        await CurrentLayoutChanged.InvokeAsync(layoutType);
    }
    
    private async Task OnForceDistanceChanged(int value)
    {
        ForceDistance = value;
        await ForceDistanceChanged.InvokeAsync(value);
    }
    
    private async Task OnForceStrengthChanged(int value)
    {
        ForceStrength = value;
        await ForceStrengthChanged.InvokeAsync(value);
    }
}
