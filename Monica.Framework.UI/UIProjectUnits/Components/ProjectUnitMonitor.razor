@using Monica.Framework.ProjectUnits.Facades
@using Monica.Core.Results;
@using Monica.Framework.ProjectUnits.Models
@inject ProjectUnitsFacade ProjectUnitsFacade
@inject ISnackbar Snackbar
@inject IStringLocalizer<ProjectUnitsResource> L

<div class="project-units-tab-section">
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="project-units-tab-section__header">
        <MudText Typo="Typo.h6">@L["ProjectUnitMonitor:Header:Title"]</MudText>
        <div class="project-units-tab-section__actions">
            <MudButton Variant="Variant.Filled"
                      Color="Color.Primary"
                      OnClick="LoadProjectUnitsAsync"
                      StartIcon="@Icons.Material.Filled.Refresh"
                      Disabled="@_loading">
                @L["Shared:Actions:Refresh"]
            </MudButton>
        </div>
    </MudStack>
    <div class="project-units-tab-section__body">
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        }
        else if (_projectUnits.Any())
        {
            <MudDataGrid T="DtoProjectUnit" Items="@_projectUnits" Filterable="true"
                        SortMode="SortMode.Multiple" Groupable="true" GroupExpanded="false"
                        Dense="true" Hover="true" ReadOnly="true">
                <Columns>
                    <PropertyColumn Property="x => x.Title" Title="@L["ProjectUnitMonitor:Columns:Name"]" />
                    <PropertyColumn Property="x => x.Key" Title="@L["ProjectUnitMonitor:Columns:FullName"]" />
                    <TemplateColumn Title="@L["ProjectUnitMonitor:Columns:Type"]">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@ProjectUnitVisualizationConfig.GetUnitTypeMudColor(context.Item.UnitType)">
                                @L.GetProjectUnitTypeText(context.Item.UnitType)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["ProjectUnitMonitor:Columns:Dependencies"]" Sortable="false">
                        <CellTemplate>
                            <MudChip T="int" Size="Size.Small" Color="Color.Info"
                                     Icon="@Icons.Material.Filled.Link">
                                @context.Item.DependencyUnits.Count
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["ProjectUnitMonitor:Columns:DependedBy"]" Sortable="false">
                        <CellTemplate>
                            <MudChip T="int" Size="Size.Small" Color="Color.Success"
                                     Icon="@Icons.Material.Filled.CallReceived">
                                @context.Item.DependedByCount
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["ProjectUnitMonitor:Columns:Actions"]" Sortable="false">
                        <CellTemplate>
                            <MudButton Size="Size.Small"
                                      Variant="Variant.Text"
                                      Color="Color.Primary"
                                      OnClick="@(() => ViewDetails(context.Item))">
                                @L["Shared:Actions:Details"]
                            </MudButton>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                @L["ProjectUnitMonitor:States:Empty"]
            </MudAlert>
        }
    </div>
</div>

<ProjectUnitDetailDialog @bind-Visible="_detailDialogVisible" 
                         SelectedUnit="_selectedUnit"
                         AllProjectUnits="_projectUnits" />

@code {
    private List<DtoProjectUnit> _projectUnits = [];
    private bool _loading;
    private bool _detailDialogVisible;
    private DtoProjectUnit? _selectedUnit;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadProjectUnitsAsync();
        }
    }

    private async Task LoadProjectUnitsAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await ProjectUnitsFacade.GetAllProjectUnitsAsync();
            if (result.IsFailed(out var error, out var data))
            {
                Snackbar.Add(L["Shared:Messages:LoadFailed", error], Severity.Error);
                return;
            }

            _projectUnits = data;
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Shared:Messages:LoadException", ex.Message], Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ViewDetails(DtoProjectUnit unit)
    {
        _selectedUnit = unit;
        _detailDialogVisible = true;
    }
}
