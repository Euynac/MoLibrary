@using System.Linq
@using Monica.ProjectUnits.Models
@inject IStringLocalizer<ProjectUnitsResource> L

<MudPaper Class="project-units-control-panel project-unit-filter-panel" Elevation="0" Outlined="true">
    <div class="project-unit-filter-panel__main">
        <div class="project-unit-filter-panel__search">
            <MudTextField @bind-Value="FilterText"
                          Label="@L["ProjectUnitFilterPanel:Fields:SearchLabel"]"
                          HelperText="@L["ProjectUnitFilterPanel:Fields:SearchHelper"]"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="OnFilterTextChanged" />
        </div>
        <section class="project-unit-filter-panel__types">
            <div class="project-unit-filter-panel__types-heading">
                <MudText Typo="Typo.subtitle2">@L["ProjectUnitFilterPanel:Sections:TypeFilter"]</MudText>
                <div class="project-unit-filter-panel__type-actions">
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               OnClick="SelectAllTypes">
                        @L["Shared:Actions:SelectAll"]
                    </MudButton>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Secondary"
                               OnClick="ClearAllTypes">
                        @L["Shared:Actions:Clear"]
                    </MudButton>
                </div>
            </div>
            <div class="project-unit-filter-panel__chips">
                <MudChipSet T="EProjectUnitType"
                            SelectionMode="SelectionMode.MultiSelection"
                            SelectedValues="SelectedUnitTypes"
                            SelectedValuesChanged="OnSelectedUnitTypesChanged">
                    @foreach (var option in _unitTypeOptions)
                    {
                        var isSelected = SelectedUnitTypes.Contains(option.UnitType);
                        <MudChip T="EProjectUnitType"
                                 Value="@option.UnitType"
                                 Icon="@ProjectUnitVisualizationConfig.GetUnitTypeIcon(option.UnitType)"
                                 Color="@ProjectUnitVisualizationConfig.GetUnitTypeMudColor(option.UnitType)"
                                 Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                 Size="Size.Small">
                            @L["ProjectUnitFilterPanel:Formats:TypeCount", L.GetProjectUnitTypeText(option.UnitType), option.Count]
                        </MudChip>
                    }
                </MudChipSet>
            </div>
        </section>
    </div>
    <div class="project-unit-filter-panel__toggles">
        <div class="project-unit-filter-panel__toggle" data-tone="info">
            <div class="project-unit-filter-panel__toggle-icon">
                <MudIcon Icon="@Icons.Material.Filled.Route" Size="Size.Small" />
            </div>
            <MudSwitch T="bool" Value="ShowOnlyWithDependencies"
                       ValueChanged="OnShowOnlyWithDependenciesChanged"
                       Label="@L["ProjectUnitFilterPanel:Switches:OnlyDependencies"]"
                       Color="Color.Primary" />
        </div>
        <div class="project-unit-filter-panel__toggle" data-tone="warning">
            <div class="project-unit-filter-panel__toggle-icon">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" />
            </div>
            <MudSwitch T="bool" Value="ShowOnlyWithAlerts"
                       ValueChanged="OnShowOnlyWithAlertsChanged"
                       Label="@L["ProjectUnitFilterPanel:Switches:OnlyAlerts"]"
                       Color="Color.Warning" />
        </div>
    </div>
</MudPaper>

@code {
    [Parameter] public IReadOnlyCollection<ProjectUnitSummary> Units { get; set; } = [];

    [Parameter] public string FilterText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> FilterTextChanged { get; set; }

    [Parameter] public IReadOnlyCollection<EProjectUnitType> SelectedUnitTypes { get; set; } = new HashSet<EProjectUnitType>();
    [Parameter] public EventCallback<IReadOnlyCollection<EProjectUnitType>> SelectedUnitTypesChanged { get; set; }

    [Parameter] public bool ShowOnlyWithDependencies { get; set; }
    [Parameter] public EventCallback<bool> ShowOnlyWithDependenciesChanged { get; set; }

    [Parameter] public bool ShowOnlyWithAlerts { get; set; }
    [Parameter] public EventCallback<bool> ShowOnlyWithAlertsChanged { get; set; }

    [Parameter] public EventCallback OnFiltersChanged { get; set; }

    private IReadOnlyList<UnitTypeOption> _unitTypeOptions = [];

    protected override void OnParametersSet()
    {
        _unitTypeOptions = Units
            .Where(static unit => unit.UnitType != EProjectUnitType.None)
            .GroupBy(static unit => unit.UnitType)
            .Select(static group => new UnitTypeOption(group.Key, group.Count()))
            .OrderByDescending(static option => option.Count)
            .ThenBy(static option => option.UnitType)
            .ToList();
    }

    private async Task OnFilterTextChanged()
    {
        await FilterTextChanged.InvokeAsync(FilterText);
        await OnFiltersChanged.InvokeAsync();
    }
    
    private async Task OnSelectedUnitTypesChanged(IReadOnlyCollection<EProjectUnitType> values)
    {
        SelectedUnitTypes = values;
        await SelectedUnitTypesChanged.InvokeAsync(values);
        await OnFiltersChanged.InvokeAsync();
    }
    
    private async Task SelectAllTypes()
    {
        await OnSelectedUnitTypesChanged(
            new HashSet<EProjectUnitType>(_unitTypeOptions.Select(static option => option.UnitType)));
    }
    
    private async Task ClearAllTypes()
    {
        await OnSelectedUnitTypesChanged(new HashSet<EProjectUnitType>());
    }
    
    private async Task OnShowOnlyWithDependenciesChanged(bool value)
    {
        ShowOnlyWithDependencies = value;
        await ShowOnlyWithDependenciesChanged.InvokeAsync(value);
        await OnFiltersChanged.InvokeAsync();
    }
    
    private async Task OnShowOnlyWithAlertsChanged(bool value)
    {
        ShowOnlyWithAlerts = value;
        await ShowOnlyWithAlertsChanged.InvokeAsync(value);
        await OnFiltersChanged.InvokeAsync();
    }

    private sealed record UnitTypeOption(EProjectUnitType UnitType, int Count);
}
