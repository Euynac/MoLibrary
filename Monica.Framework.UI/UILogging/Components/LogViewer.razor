@using System.Net
@using System.Text
@using Monica.Framework.UI.UILogging.Models
@using Monica.UI.Components.ContextMenu

@inject IDialogService DialogService
@inject ISnackbar Snackbar

@implements IAsyncDisposable

<div class="log-viewer-wrapper">
    <div class="log-viewer-header">
        <MudText Typo="Typo.subtitle1">实时日志</MudText>
        <MudChipSet T="string">
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">共 @_linesCount 行</MudChip>
            @if (Filter?.IsActive == true)
            {
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">筛选: @Filter.Keyword</MudChip>
            }
        </MudChipSet>
    </div>

    @* Load More Indicator *@
    @if (_isLoadingMore)
    {
        <div class="load-more-indicator">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="mt-1">
                正在加载更多日志...
            </MudText>
        </div>
    }

    @* Match Navigation Bar - Only shown when filter is active and OnlyCapture is false *@
    @if (Filter?.IsActive == true && !Filter.OnlyCapture && _totalMatches > 0)
    {
        <div class="match-navigation-bar">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" />
                        匹配: <strong>@(_currentMatchIndex + 1)</strong> / @_totalMatches
                    </MudText>
                </MudStack>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   OnClick="GoToPreviousMatch"
                                   Disabled="@(_totalMatches == 0)"
                                   title="上一个匹配项"
                                   aria-label="上一个匹配项" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   OnClick="GoToNextMatch"
                                   Disabled="@(_totalMatches == 0)"
                                   title="下一个匹配项"
                                   aria-label="下一个匹配项" />
                </MudStack>
            </MudStack>
        </div>
    }

    <div class="log-viewer-scroll" @ref="_scrollContainer">
        @if (CurrentLines.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">暂无日志内容</MudAlert>
        }
        else
        {
            @for (var i = 0; i < CurrentLines.Count; i++)
            {
                var line = CurrentLines[i];
                var lineIndex = i;
                var isCurrentMatch = line.IsMatch && _matchedLineIndices.Count > 0 &&
                                     _currentMatchIndex >= 0 && _currentMatchIndex < _matchedLineIndices.Count &&
                                     _matchedLineIndices[_currentMatchIndex] == lineIndex;

                <div @key="line.AbsoluteLineNumber ?? lineIndex"
                     class="log-entry @GetSeverityClass(line.Severity) @(line.IsContextTarget ? "context-target" : "") @(isCurrentMatch ? "current-match" : "") @(_selectedLineIndex == lineIndex ? "selected" : "")"
                     data-line-index="@lineIndex"
                     data-absolute-line-number="@line.AbsoluteLineNumber"
                     @onclick="() => HandleEntryClick(line, lineIndex)"
                     @oncontextmenu="e => OnContextMenu(e, line)"
                     @oncontextmenu:preventDefault="true">
                    <span class="log-entry__header">@line.Header</span>
                    <span class="log-entry__message">
                        @((MarkupString)BuildMessageMarkup(line))
                    </span>
                    @if (_selectedLineIndex == lineIndex && line.AbsoluteLineNumber.HasValue)
                    {
                        <span class="log-entry__line-badge">#@line.AbsoluteLineNumber.Value</span>
                    }
                </div>
            }
        }
    </div>
</div>

@* Context Menu *@
<MoContextMenu TItem="LogLineViewModel"
               Items="@_contextMenuItems"
               Visible="@_contextMenuVisible"
               InitialX="@_contextMenuX"
               InitialY="@_contextMenuY"
               ContextItem="@_selectedLine"
               OnItemClick="@OnContextMenuItemClickWrapper"
               OnClose="@CloseContextMenu" />

@code {
    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<LogLineViewModel>? Lines { get; set; }

    [Parameter]
    public long Version { get; set; }

    [Parameter]
    public bool AutoScroll { get; set; }

    [Parameter]
    public LogFilterState? Filter { get; set; }

    [Parameter]
    public EventCallback<LogLineViewModel> OnLineClicked { get; set; }

    [Parameter]
    public EventCallback<(LogLineViewModel line, int lineIndex)> OnShowContext { get; set; }

    [Parameter]
    public EventCallback<(LogLineViewModel line, string keyword)> OnApplyFilter { get; set; }

    [Parameter]
    public Func<int, Task<int>>? LoadMoreRequested { get; set; }

    private const string JsModulePath = "./_content/Monica.Framework.UI/js/logging-ui.js";
    private ElementReference _scrollContainer;
    private bool _isRendered;
    private long _lastVersion;
    private int _linesCount;
    private IJSObjectReference? _jsModule;
    private bool _pendingScrollToBottom;
    private long? _pendingScrollAnchorLineNumber;
    private long _pendingPreserveAfterVersion;
    private long? _lastFirstAbsoluteLineNumber;
    private long? _lastLastAbsoluteLineNumber;

    // Context menu state
    private bool _contextMenuVisible;
    private double _contextMenuX;
    private double _contextMenuY;
    private LogLineViewModel? _selectedLine;
    private List<ContextMenuItem<LogLineViewModel>> _contextMenuItems = new();

    // Match navigation state
    private int _currentMatchIndex = 0;
    private int _totalMatches = 0;
    private List<int> _matchedLineIndices = new();
    private LogFilterState? _lastFilter;

    // Load more state
    private bool _isLoadingMore = false;
    private DotNetObjectReference<LogViewer>? _dotNetRef;

    // Selected line state
    private int? _selectedLineIndex = null;

    private IReadOnlyList<LogLineViewModel> CurrentLines => Lines ?? Array.Empty<LogLineViewModel>();

    protected override void OnParametersSet()
    {
        var lines = CurrentLines;
        _linesCount = lines.Count;

        var filterChanged = !Equals(_lastFilter, Filter);
        if (filterChanged || Version != _lastVersion)
        {
            _lastFilter = Filter;
            UpdateMatchTracking();
        }

        var firstLine = _linesCount > 0 ? lines[0] : null;
        var lastLine = _linesCount > 0 ? lines[^1] : null;
        var currentFirstAbsoluteLineNumber = firstLine?.AbsoluteLineNumber;
        var currentLastAbsoluteLineNumber = lastLine?.AbsoluteLineNumber;

        if (Version != _lastVersion)
        {
            if (ShouldScrollToBottom(currentFirstAbsoluteLineNumber, currentLastAbsoluteLineNumber))
            {
                _pendingScrollToBottom = true;
            }

            _lastVersion = Version;
        }

        _lastFirstAbsoluteLineNumber = currentFirstAbsoluteLineNumber;
        _lastLastAbsoluteLineNumber = currentLastAbsoluteLineNumber;
    }

    private void UpdateMatchTracking()
    {
        _matchedLineIndices.Clear();
        var lines = CurrentLines;

        if (Filter?.IsActive == true && !Filter.OnlyCapture)
        {
            for (int i = 0; i < lines.Count; i++)
            {
                if (lines[i].IsMatch)
                {
                    _matchedLineIndices.Add(i);
                }
            }

            _totalMatches = _matchedLineIndices.Count;

            // Reset to first match if we have matches
            if (_totalMatches > 0)
            {
                _currentMatchIndex = 0;
            }
            else
            {
                _currentMatchIndex = 0;
            }
        }
        else
        {
            _totalMatches = 0;
            _currentMatchIndex = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isRendered = true;
            BuildContextMenu();
            await SetupScrollListenerAsync();

            if (AutoScroll && CurrentLines.Count > 0)
            {
                _pendingScrollToBottom = true;
            }
        }

        if (_pendingScrollAnchorLineNumber.HasValue && Version > _pendingPreserveAfterVersion)
        {
            var anchorLineNumber = _pendingScrollAnchorLineNumber.Value;
            _pendingScrollAnchorLineNumber = null;
            await PreserveScrollPositionAsync(anchorLineNumber);
        }

        if (_pendingScrollToBottom)
        {
            _pendingScrollToBottom = false;
            await ScrollToBottomAsync();
        }
    }

    private async Task SetupScrollListenerAsync()
    {
        try
        {
            _dotNetRef?.Dispose();
            _dotNetRef = DotNetObjectReference.Create(this);

            var jsModule = await GetJsModuleAsync();
            await jsModule.InvokeVoidAsync("addScrollTopListener",
                _scrollContainer,
                _dotNetRef,
                nameof(HandleScrollToTop),
                50);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to setup scroll listener: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task<bool> HandleScrollToTop()
    {
        if (_isLoadingMore || LoadMoreRequested is null)
        {
            return false;
        }

        try
        {
            _isLoadingMore = true;
            await InvokeAsync(StateHasChanged);

            var lines = CurrentLines;
            var anchorLineNumber = lines.Count > 0
                ? lines[0].AbsoluteLineNumber
                : null;
            var loadedCount = await LoadMoreRequested.Invoke(50);

            if (loadedCount > 0 && anchorLineNumber.HasValue)
            {
                _pendingScrollAnchorLineNumber = anchorLineNumber.Value;
                _pendingPreserveAfterVersion = Version;
            }

            return loadedCount > 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading more lines: {ex.Message}");
            Snackbar.Add($"加载更多日志失败: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _isLoadingMore = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool ShouldScrollToBottom(long? currentFirstAbsoluteLineNumber, long? currentLastAbsoluteLineNumber)
    {
        if (!_isRendered || !AutoScroll || !currentLastAbsoluteLineNumber.HasValue)
        {
            return false;
        }

        if (!_lastLastAbsoluteLineNumber.HasValue)
        {
            return true;
        }

        var isHistoryPrepend = currentFirstAbsoluteLineNumber.HasValue
            && _lastFirstAbsoluteLineNumber.HasValue
            && currentFirstAbsoluteLineNumber.Value < _lastFirstAbsoluteLineNumber.Value
            && currentLastAbsoluteLineNumber.Value == _lastLastAbsoluteLineNumber.Value;

        return !isHistoryPrepend;
    }

    private void BuildContextMenu()
    {
        _contextMenuItems = ContextMenuBuilder<LogLineViewModel>.Create()
            .AddItem("显示行位置信息", Icons.Material.Filled.Info, OnShowLineInfoAsync)
            .AddItem("按此日志级别筛选", Icons.Material.Filled.Label, OnFilterBySeverityAsync)
            .AddItem("查找选中的信息", Icons.Material.Filled.Search, OnFindSelectedTextAsync)
            .AddItem("显示上下文", Icons.Material.Filled.Article, line => OnShowContextClickedAsync(line, _selectedLineIndex))
            .AddDivider()
            .AddSubMenu("复制", Icons.Material.Filled.ContentCopy, builder => builder
                .AddItem("复制原始日志", Icons.Material.Filled.ContentCopy, item => CopyToClipboardAsync(item, LogCopyFormat.Raw))
                .AddItem("仅复制消息", Icons.Material.Filled.Subject, item => CopyToClipboardAsync(item, LogCopyFormat.MessageOnly))
                .AddItem("带时间戳复制", Icons.Material.Filled.AccessTime, item => CopyToClipboardAsync(item, LogCopyFormat.WithTimestamp))
                .AddItem("带行号复制", Icons.Material.Filled.Numbers, item => CopyToClipboardAsync(item, LogCopyFormat.WithLineNumber)))
            .AddSubMenu("导航", Icons.Material.Filled.Navigation, builder => builder
                .AddItem("跳转到顶部", Icons.Material.Filled.ArrowUpward, _ => ScrollToTopAsync())
                .AddItem("跳转到底部", Icons.Material.Filled.ArrowDownward, _ => ScrollToBottomAsync()))
            .Build();
    }

    private async Task HandleEntryClick(LogLineViewModel line, int lineIndex)
    {
        _selectedLineIndex = lineIndex;
        await OnLineClicked.InvokeAsync(line);
        StateHasChanged();
    }

    private void OnContextMenu(MouseEventArgs e, LogLineViewModel line)
    {
        _selectedLine = line;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _contextMenuVisible = true;
        StateHasChanged();
    }

    private void CloseContextMenu()
    {
        _contextMenuVisible = false;
        StateHasChanged();
    }

    private Task OnContextMenuItemClickWrapper(ContextMenuItem<LogLineViewModel> menuItem)
    {
        return Task.CompletedTask;
    }

    private async Task OnShowLineInfoAsync(LogLineViewModel? line)
    {
        if (line is null)
        {
            return;
        }

        var parameters = new DialogParameters<LogLineInfoDialog>
        {
            { x => x.Line, line }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        await DialogService.ShowAsync<LogLineInfoDialog>("日志行信息", parameters, options);
    }

    private async Task OnShowContextClickedAsync(LogLineViewModel? line, int? lineIndex)
    {
        if (line is not null && OnShowContext.HasDelegate && lineIndex.HasValue)
        {
            await OnShowContext.InvokeAsync((line, lineIndex.Value));
        }
    }

    private async Task CopyToClipboardAsync(LogLineViewModel? line, LogCopyFormat format)
    {
        if (line is null)
        {
            return;
        }

        var text = line.GetCopyText(format);
        var jsModule = await GetJsModuleAsync();
        var success = await jsModule.InvokeAsync<bool>("copyToClipboard", text);

        if (success)
        {
            Snackbar.Add($"已复制: {text[..Math.Min(50, text.Length)]}...");
        }
    }

    private async Task OnFilterBySeverityAsync(LogLineViewModel? line)
    {
        if (line is not null && OnApplyFilter.HasDelegate)
        {
            var keyword = line.LevelText;
            await OnApplyFilter.InvokeAsync((line, keyword));
        }
    }

    private async Task OnFindSelectedTextAsync(LogLineViewModel? line)
    {
        if (line is null || !OnApplyFilter.HasDelegate)
        {
            return;
        }

        try
        {
            var jsModule = await GetJsModuleAsync();
            var selectedText = await jsModule.InvokeAsync<string>("getSelectedText");

            if (string.IsNullOrWhiteSpace(selectedText))
            {
                Snackbar.Add("请先选中要查找的文本", Severity.Warning);
                return;
            }

            await OnApplyFilter.InvokeAsync((line, selectedText));
            Snackbar.Add($"已应用筛选条件：{selectedText}", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"获取选中文本失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task ScrollToTopAsync()
    {
        try
        {
            var jsModule = await GetJsModuleAsync();
            await jsModule.InvokeVoidAsync("scrollToTop", _scrollContainer);
        }
        catch (JSException)
        {
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            var jsModule = await GetJsModuleAsync();
            await jsModule.InvokeVoidAsync("scrollToBottom", _scrollContainer);
        }
        catch (JSException)
        {
        }
    }

    private async Task GoToNextMatch()
    {
        if (_totalMatches == 0 || _matchedLineIndices.Count == 0)
        {
            return;
        }

        _currentMatchIndex = (_currentMatchIndex + 1) % _totalMatches;

        await ScrollToCurrentMatch();
        StateHasChanged();
    }

    private async Task GoToPreviousMatch()
    {
        if (_totalMatches == 0 || _matchedLineIndices.Count == 0)
        {
            return;
        }

        _currentMatchIndex = (_currentMatchIndex - 1 + _totalMatches) % _totalMatches;

        await ScrollToCurrentMatch();
        StateHasChanged();
    }

    private async Task ScrollToCurrentMatch()
    {
        if (_currentMatchIndex < 0 || _currentMatchIndex >= _matchedLineIndices.Count)
        {
            return;
        }

        var lineIndex = _matchedLineIndices[_currentMatchIndex];

        try
        {
            var jsModule = await GetJsModuleAsync();
            await jsModule.InvokeVoidAsync("scrollToLineIndex", _scrollContainer, lineIndex);
        }
        catch (JSException)
        {
        }
    }

    public async Task ScrollToLineAsync(int lineIndex)
    {
        try
        {
            var jsModule = await GetJsModuleAsync();
            await jsModule.InvokeVoidAsync("scrollToLineIndex", _scrollContainer, lineIndex);
        }
        catch (JSException)
        {
        }
    }

    private async Task PreserveScrollPositionAsync(long absoluteLineNumber)
    {
        try
        {
            var jsModule = await GetJsModuleAsync();
            await jsModule.InvokeVoidAsync("preserveScrollPosition", _scrollContainer, absoluteLineNumber);
        }
        catch (JSException)
        {
        }
    }

    private async Task<IJSObjectReference> GetJsModuleAsync()
    {
        if (_jsModule is null)
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", JsModulePath);
        }

        return _jsModule;
    }

    private static string GetSeverityClass(LogSeverity severity) => severity switch
    {
        LogSeverity.Trace => "severity-trace",
        LogSeverity.Debug => "severity-debug",
        LogSeverity.Information => "severity-info",
        LogSeverity.Warning => "severity-warning",
        LogSeverity.Error => "severity-error",
        LogSeverity.Critical => "severity-critical",
        _ => "severity-unknown"
    };

    private static string BuildMessageMarkup(LogLineViewModel line)
    {
        var message = line.Message ?? string.Empty;
        if (line.MatchSegments is null || line.MatchSegments.Count == 0)
        {
            return WebUtility.HtmlEncode(message);
        }

        var builder = new StringBuilder(message.Length + 32);
        var cursor = 0;
        foreach (var segment in line.MatchSegments)
        {
            var safeStart = Math.Clamp(segment.Start, 0, message.Length);
            if (safeStart > cursor)
            {
                builder.Append(WebUtility.HtmlEncode(message[cursor..safeStart]));
            }

            var length = Math.Min(segment.Length, message.Length - safeStart);
            if (length <= 0)
            {
                continue;
            }

            builder.Append("<span class=\"match-chip\">");
            builder.Append(WebUtility.HtmlEncode(message.Substring(safeStart, length)));
            builder.Append("</span>");
            cursor = safeStart + length;
        }

        if (cursor < message.Length)
        {
            builder.Append(WebUtility.HtmlEncode(message[cursor..]));
        }

        return builder.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_jsModule is not null)
            {
                await _jsModule.InvokeVoidAsync("removeScrollListener", _scrollContainer);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception)
        {
        }

        _dotNetRef?.Dispose();
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
