@inject IStringLocalizer<LoggingResource> L

<div class="log-filter-shell">
<MudPaper Class="log-filter-panel pa-3" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudTextField T="string"
                      Value="@_keyword"
                      ValueChanged="OnKeywordChanged"
                      Placeholder="@L["Page:Components:Filter:Placeholder"]"
                      Immediate="false"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="HandleKeyDown"
                      Class="log-filter-panel__input" />

        <MudSwitch T="bool" Value="@_onlyCapture" ValueChanged="OnOnlyCaptureChanged" Color="Color.Primary">@L["Page:Components:Filter:OnlyMatches"]</MudSwitch>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@IsApplying"
                       OnClick="ApplyFilter">@L["Page:Components:Filter:Apply"]</MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Disabled="string.IsNullOrWhiteSpace(_keyword)"
                       OnClick="ClearFilter">@L["Page:Components:Filter:Clear"]</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>
</div>

@code {
    [Parameter]
    public string? Keyword { get; set; }

    [Parameter]
    public bool OnlyCapture { get; set; }

    [Parameter]
    public bool IsApplying { get; set; }

    [Parameter]
    public EventCallback<string?> KeywordChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnlyCaptureChanged { get; set; }

    [Parameter]
    public EventCallback ApplyRequested { get; set; }

    [Parameter]
    public EventCallback ClearRequested { get; set; }

    private string? _keyword;
    private bool _onlyCapture;

    protected override void OnParametersSet()
    {
        _keyword = Keyword;
        _onlyCapture = OnlyCapture;
    }

    private Task OnKeywordChanged(string? value)
    {
        var normalizedValue = string.IsNullOrEmpty(value) ? null : value;
        _keyword = normalizedValue;
        return KeywordChanged.InvokeAsync(normalizedValue);
    }

    private Task OnOnlyCaptureChanged(bool value)
    {
        _onlyCapture = value;
        return OnlyCaptureChanged.InvokeAsync(value);
    }

    private Task ApplyFilter() => ApplyRequested.InvokeAsync(null);

    private Task ClearFilter() => ClearRequested.InvokeAsync(null);

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ApplyFilter();
        }
    }
}
