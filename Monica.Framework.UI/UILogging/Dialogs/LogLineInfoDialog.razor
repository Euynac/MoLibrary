@using Monica.Framework.UI.UILogging.Models
@inject IStringLocalizer<LoggingResource> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <div class="log-line-info-dialog__surface">
                <MudText Typo="Typo.h6" Class="mb-3">@L["Page:Components:LineInfo:PositionTitle"]</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:Components:LineInfo:AbsoluteLine"]</MudText>
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                                @(Line?.AbsoluteLineNumber?.ToString() ?? L["Page:Components:LineInfo:NotAvailable"])
                            </MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:Components:LineInfo:BufferPosition"]</MudText>
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Text" Size="Size.Small">
                                @(Line?.BufferIndex?.ToString() ?? L["Page:Components:LineInfo:NotAvailable"])
                            </MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:Components:LineInfo:FilteredPosition"]</MudText>
                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text" Size="Size.Small">
                                @(Line?.FilteredIndex?.ToString() ?? L["Page:Components:LineInfo:NotAvailable"])
                            </MudChip>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </div>

            <div class="log-line-info-dialog__surface">
                <MudText Typo="Typo.h6" Class="mb-3">@L["Page:Components:LineInfo:DetailsTitle"]</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:Components:LineInfo:Timestamp"]</MudText>
                            <MudText Typo="Typo.body2">@(Line?.GetFormattedTimestamp() ?? L["Page:Components:LineInfo:NotAvailable"])</MudText>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:Components:LineInfo:Severity"]</MudText>
                            <MudChip T="string" Color="@GetSeverityColor(Line?.Severity ?? LogSeverity.Unknown)" Size="Size.Small">
                                @(Line?.LevelText ?? L["Page:Components:LineInfo:NotAvailable"])
                            </MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:Components:LineInfo:Thread"]</MudText>
                            <MudText Typo="Typo.body2">@(Line?.Thread ?? L["Page:Components:LineInfo:NotAvailable"])</MudText>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </div>

            @if (!string.IsNullOrWhiteSpace(Line?.Message))
            {
                <div class="log-line-info-dialog__surface">
                    <MudText Typo="Typo.h6" Class="mb-2">@L["Page:Components:LineInfo:MessageTitle"]</MudText>
                    <MudText Typo="Typo.body2" Class="log-line-info-dialog__message">@Line.Message</MudText>
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">@L["Page:Components:LineInfo:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public LogLineViewModel? Line { get; set; }

    private void Close()
    {
        MudDialog.Close();
    }

    private Color GetSeverityColor(LogSeverity severity)
    {
        return severity switch
        {
            LogSeverity.Trace => Color.Info,
            LogSeverity.Debug => Color.Primary,
            LogSeverity.Information => Color.Success,
            LogSeverity.Warning => Color.Warning,
            LogSeverity.Error => Color.Error,
            LogSeverity.Critical => Color.Error,
            _ => Color.Default
        };
    }
}
