@using Monica.SignalR.Models
@using MudBlazor

<!-- 已连接用户 -->
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">已连接用户 (@ConnectedUsers.Count)</MudText>
        <MudButton OnClick="OnRefreshClicked"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Variant="Variant.Outlined">
            刷新
        </MudButton>
    </div>

    @if (ConnectedUsers.Count == 0)
    {
        <MudAlert Severity="Severity.Info">当前没有已连接的用户</MudAlert>
    }
    else
    {
        <MudTable Items="@ConnectedUsers"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  T="SignalRConnectedUserInfo">
            <HeaderContent>
                <MudTh>连接ID</MudTh>
                <MudTh>用户名</MudTh>
                <MudTh>用户ID</MudTh>
                <MudTh>认证状态</MudTh>
                <MudTh>连接时间</MudTh>
                <MudTh>操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="连接ID">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">
                        @context.ConnectionId.Substring(0, Math.Min(8, context.ConnectionId.Length))...
                    </MudText>
                </MudTd>
                <MudTd DataLabel="用户名">
                    <MudText Typo="Typo.body2">
                        @(string.IsNullOrEmpty(context.UserName) ? "-" : context.UserName)
                    </MudText>
                </MudTd>
                <MudTd DataLabel="用户ID">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">
                        @(string.IsNullOrEmpty(context.UserId) ? "-" : context.UserId)
                    </MudText>
                </MudTd>
                <MudTd DataLabel="认证状态">
                    <MudChip Size="Size.Small"
                             Color="@(context.IsAuthenticated ? Color.Success : Color.Default)"
                             T="string">
                        @(context.IsAuthenticated ? "已认证" : "未认证")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="连接时间">
                    <MudText Typo="Typo.body2">
                        @context.ConnectionTime.ToString("HH:mm:ss")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="操作">
                    <MudIconButton Icon="@Icons.Material.Filled.Info"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => ShowUserDetails(context))"
                                   Title="查看详细信息" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<!-- 用户详情对话框 -->
<MudDialog @bind-Visible="@_dialogVisible" Options="@_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">用户详细信息</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedUser != null)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">基本信息</MudText>
                    <MudSimpleTable Dense="true" Hover="true" Class="mb-4">
                        <tbody>
                            <tr>
                                <td><strong>连接ID</strong></td>
                                <td style="font-family: monospace;">@_selectedUser.ConnectionId</td>
                            </tr>
                            <tr>
                                <td><strong>用户名</strong></td>
                                <td>@(string.IsNullOrEmpty(_selectedUser.UserName) ? "-" : _selectedUser.UserName)</td>
                            </tr>
                            <tr>
                                <td><strong>用户ID</strong></td>
                                <td style="font-family: monospace;">@(string.IsNullOrEmpty(_selectedUser.UserId) ? "-" : _selectedUser.UserId)</td>
                            </tr>
                            <tr>
                                <td><strong>认证状态</strong></td>
                                <td>
                                    <MudChip Size="Size.Small"
                                             Color="@(_selectedUser.IsAuthenticated ? Color.Success : Color.Default)"
                                             T="string">
                                        @(_selectedUser.IsAuthenticated ? "已认证" : "未认证")
                                    </MudChip>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>连接时间</strong></td>
                                <td>@_selectedUser.ConnectionTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">用户Claims (@_selectedUser.Claims.Count)</MudText>
                    @if (_selectedUser.Claims.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">该用户没有Claims信息</MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Style="max-height: 400px; overflow-y: auto;">
                            <thead>
                                <tr>
                                    <th>Claim Type</th>
                                    <th>Claim Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in _selectedUser.Claims)
                                {
                                    <tr>
                                        <td style="font-family: monospace; word-break: break-all;">@claim.Key</td>
                                        <td style="word-break: break-all;">@claim.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogVisible = false)" Color="Color.Primary">关闭</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// 已连接用户列表
    /// </summary>
    [Parameter] public IReadOnlyList<SignalRConnectedUserInfo> ConnectedUsers { get; set; } = new List<SignalRConnectedUserInfo>();

    /// <summary>
    /// 刷新按钮点击事件
    /// </summary>
    [Parameter] public EventCallback OnRefreshClicked { get; set; }

    private bool _dialogVisible = false;
    private SignalRConnectedUserInfo? _selectedUser = null;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    /// <summary>
    /// 显示用户详情
    /// </summary>
    /// <param name="user">用户信息</param>
    private void ShowUserDetails(SignalRConnectedUserInfo user)
    {
        _selectedUser = user;
        _dialogVisible = true;
    }
}
