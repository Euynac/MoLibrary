@using MoLibrary.Framework.UI.UILogging.Models
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-background-gray);">
                <MudText Typo="Typo.h6" Class="mb-3">位置信息</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">绝对行号</MudText>
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                                @(Line?.AbsoluteLineNumber?.ToString() ?? "N/A")
                            </MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">缓冲区位置</MudText>
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Text" Size="Size.Small">
                                @(Line?.BufferIndex?.ToString() ?? "N/A")
                            </MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">筛选位置</MudText>
                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text" Size="Size.Small">
                                @(Line?.FilteredIndex?.ToString() ?? "N/A")
                            </MudChip>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-background-gray);">
                <MudText Typo="Typo.h6" Class="mb-3">日志详情</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">时间戳</MudText>
                            <MudText Typo="Typo.body2">@(Line?.GetFormattedTimestamp() ?? "N/A")</MudText>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">日志级别</MudText>
                            <MudChip T="string" Color="@GetSeverityColor(Line?.Severity ?? LogSeverity.Unknown)" Size="Size.Small">
                                @(Line?.LevelText ?? "N/A")
                            </MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">线程</MudText>
                            <MudText Typo="Typo.body2">@(Line?.Thread ?? "N/A")</MudText>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(Line?.Message))
            {
                <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-background-gray);">
                    <MudText Typo="Typo.h6" Class="mb-2">消息内容</MudText>
                    <MudText Typo="Typo.body2" Style="word-break: break-word; white-space: pre-wrap;">@Line.Message</MudText>
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">关闭</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public LogLineViewModel? Line { get; set; }

    private void Close()
    {
        MudDialog.Close();
    }

    private Color GetSeverityColor(LogSeverity severity)
    {
        return severity switch
        {
            LogSeverity.Trace => Color.Info,
            LogSeverity.Debug => Color.Primary,
            LogSeverity.Information => Color.Success,
            LogSeverity.Warning => Color.Warning,
            LogSeverity.Error => Color.Error,
            LogSeverity.Critical => Color.Error,
            _ => Color.Default
        };
    }
}
