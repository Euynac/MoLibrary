@using MoLibrary.Framework.UI.UIEventBus.Models

<MudGrid>
    <MudItem xs="12">
        <div class="d-flex justify-space-between align-center mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" />
                <MudText Typo="Typo.h6">已注册的 EventBus Provider</MudText>
                @if (Providers.Any())
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@Providers.Count 个</MudChip>
                }
            </MudStack>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="OnRefresh"
                       Disabled="IsLoading">
                刷新
            </MudButton>
        </div>
    </MudItem>

    @if (IsLoading)
    {
        <MudItem xs="12">
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        </MudItem>
    }
    else if (!Providers.Any())
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info">
                未发现已注册的 EventBus Provider
            </MudAlert>
        </MudItem>
    }
    else
    {
        @foreach (var provider in Providers)
        {
            <MudItem xs="12" md="6" lg="4">
                <EventBusProviderCard Provider="provider"
                                     OnViewDetailsClicked="HandleViewDetails" />
            </MudItem>
        }
    }
</MudGrid>

<!-- Provider 详情对话框 -->
<EventBusProviderDetailDialog @bind-IsVisible="_showProviderDetail"
                              Provider="_selectedProvider"
                              Subscriptions="_providerSubscriptions" />

@code {
    [Parameter] public List<EventBusProviderInfo> Providers { get; set; } = [];
    [Parameter] public List<SubscriptionViewModel> AllSubscriptions { get; set; } = [];
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private bool _showProviderDetail;
    private EventBusProviderInfo? _selectedProvider;
    private List<SubscriptionViewModel> _providerSubscriptions = [];

    private void HandleViewDetails(EventBusProviderInfo provider)
    {
        _selectedProvider = provider;

        // 过滤出该 Provider 的订阅
        _providerSubscriptions = AllSubscriptions.Where(s =>
        {
            var keyMatches = s.ServiceKey == provider.ServiceKey;
            var scopeMatches = provider.IsDistributed
                ? s.Scope == MoLibrary.EventBus.Models.SubscriptionScope.Distributed
                : s.Scope == MoLibrary.EventBus.Models.SubscriptionScope.Local;
            return keyMatches && scopeMatches;
        }).ToList();

        _showProviderDetail = true;
    }
}
