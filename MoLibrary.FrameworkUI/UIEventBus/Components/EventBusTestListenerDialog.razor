@using MoLibrary.FrameworkUI.UIEventBus.Services
@using MoLibrary.FrameworkUI.UIEventBus.Models
@using MoLibrary.Tool.MoResponse
@using System.Timers
@implements IDisposable
@inject EventBusTestService TestService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" />
            <MudText Typo="Typo.h6">实时消息监听</MudText>
            <MudChip T="string" Color="Color.Info" Size="Size.Small">@TopicName</MudChip>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <!-- 控制按钮栏 -->
            <MudPaper Class="pa-3" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (_isListening)
                        {
                            <MudProgressCircular Color="Color.Info" Size="Size.Small" Indeterminate="true" />
                            <MudText Typo="Typo.body2" Color="Color.Info">
                                <strong>正在监听...</strong>
                            </MudText>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Stop" Color="Color.Default" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Color="Color.Default">
                                已停止
                            </MudText>
                        }
                    </MudStack>

                    <MudStack Row="true" Spacing="2">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                            已接收: @_messages.Count 条
                        </MudChip>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="ClearMessages"
                                   Disabled="@(_messages.Count == 0)">
                            清空消息
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Stop"
                                   OnClick="StopListeningAsync">
                            停止监听
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <!-- 消息列表 -->
            <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                @if (_messages.Count == 0)
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" />
                        <MudText Typo="Typo.body1" Color="Color.Default">
                            暂无接收到的消息
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            消息将实时显示在这里（每500ms刷新）
                        </MudText>
                    </MudStack>
                }
                else
                {
                    <MudStack Spacing="2" Class="pa-3" Style="max-height: 500px; overflow-y: auto;">
                        @foreach (var msg in _messages.OrderByDescending(m => m.ReceivedAt))
                        {
                            <MudCard Elevation="2">
                                <MudCardContent>
                                    <MudStack Spacing="2">
                                        <!-- 消息头部 -->
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="@Icons.Material.Filled.Message" Color="Color.Info" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2">
                                                    消息 ID: @msg.EventData.MessageId
                                                </MudText>
                                            </MudStack>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                                @msg.ReceivedAt.ToString("HH:mm:ss.fff")
                                            </MudChip>
                                        </MudStack>

                                        <MudDivider />

                                        <!-- 消息内容 -->
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                消息内容:
                                            </MudText>
                                            <MudPaper Class="pa-2" Elevation="0" Style="background-color: var(--mud-palette-background-grey); border-radius: 4px;">
                                                <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-word;">
                                                    @msg.EventData.Message
                                                </MudText>
                                            </MudPaper>
                                        </MudStack>

                                        <!-- 消息元数据 -->
                                        <MudStack Row="true" Spacing="3">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Secondary" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    创建时间: @msg.EventData.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                                </MudText>
                                            </MudStack>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Secondary" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    接收时间: @msg.ReceivedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                                </MudText>
                                            </MudStack>
                                        </MudStack>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        }
                    </MudStack>
                }
            </MudPaper>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseDialog" Color="Color.Primary">关闭</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string TopicName { get; set; } = string.Empty;

    private Timer? _refreshTimer;
    private List<ReceivedTestMessage> _messages = new();
    private bool _isListening = true;

    protected override void OnInitialized()
    {
        StartRefreshTimer();
        RefreshMessages();
    }

    private void StartRefreshTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = new Timer(500); // 每500ms刷新一次
        _refreshTimer.Elapsed += async (sender, e) =>
        {
            await InvokeAsync(() =>
            {
                RefreshMessages();
                StateHasChanged();
            });
        };
        _refreshTimer.Start();
    }

    private void StopRefreshTimer()
    {
        _refreshTimer?.Stop();
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    private void RefreshMessages()
    {
        _messages = TestService.GetReceivedMessages();
    }

    private void ClearMessages()
    {
        TestService.ClearReceivedMessages();
        _messages.Clear();
        Snackbar.Add("已清空所有消息", Severity.Info);
        StateHasChanged();
    }

    private async Task StopListeningAsync()
    {
        _isListening = false;
        StopRefreshTimer();

        var result = await TestService.UnsubscribeFromTestTopicAsync();

        if (result.IsFailed(out var error))
        {
            Snackbar.Add($"停止监听失败: {error.Message}", Severity.Warning);
        }
        else
        {
            Snackbar.Add("已停止监听", Severity.Info);
        }

        MudDialog.Close();
    }

    private void CloseDialog()
    {
        MudDialog.Close();
    }

    public void Dispose()
    {
        StopRefreshTimer();

        // 如果还在监听，自动取消订阅
        if (_isListening)
        {
            _ = TestService.UnsubscribeFromTestTopicAsync();
        }
    }
}
