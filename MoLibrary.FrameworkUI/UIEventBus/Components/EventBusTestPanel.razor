@using MoLibrary.FrameworkUI.UIEventBus.Services
@using MoLibrary.FrameworkUI.UIEventBus.Models
@using MoLibrary.Tool.MoResponse
@inject EventBusTestService TestService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="test-panel-wrapper">
    <MudStack Spacing="4">
        <!-- 发布测试消息 -->
        <MudPaper Class="pa-4 publish-section" Elevation="2">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Send" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">发布测试消息</MudText>
                </MudStack>

                <MudDivider />

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_publishTopicName"
                                      T="string"
                                      Label="主题名称"
                                      Variant="Variant.Outlined"
                                      HelperText="默认使用事件类型的完整名称"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_publishMessage"
                                      T="string"
                                      Label="消息内容"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Placeholder="输入要发送的测试消息..."
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   OnClick="PublishMessageAsync"
                                   Disabled="@_isPublishing">
                            @if (_isPublishing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <text>发送中...</text>
                            }
                            else
                            {
                                <text>发送消息</text>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>

        <!-- 订阅测试消息 -->
        <MudPaper Class="pa-4 subscribe-section" Elevation="2">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" />
                    <MudText Typo="Typo.h6">订阅测试消息</MudText>
                </MudStack>

                <MudDivider />

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_subscribeTopicName"
                                      T="string"
                                      Label="监听主题"
                                      Variant="Variant.Outlined"
                                      HelperText="默认使用事件类型的完整名称"
                                      Immediate="true"
                                      Disabled="@TestService.IsSubscribed" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton Color="Color.Info"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   OnClick="OpenListenerDialogAsync"
                                   Disabled="@TestService.IsSubscribed">
                            开始监听
                        </MudButton>
                    </MudItem>
                </MudGrid>

                <!-- 订阅状态指示器 -->
                <MudPaper Class="@GetStatusClass()" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (TestService.IsSubscribed)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Color="Color.Success">
                                <strong>已订阅</strong> - 主题: @TestService.CurrentTopicName
                            </MudText>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Default" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Color="Color.Default">
                                未订阅
                            </MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudPaper>

        <!-- 使用说明 -->
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            <MudText Typo="Typo.body2">
                <strong>使用说明：</strong>
            </MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">1. 发布消息：填写主题名称和消息内容后点击"发送消息"</MudText>
                </MudListItem>
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">2. 订阅主题：填写监听主题后点击"开始监听"打开实时监听对话框</MudText>
                </MudListItem>
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">3. 主题名称默认为 <code>@_defaultTopicName</code></MudText>
                </MudListItem>
                <MudListItem T="string">
                    <MudText Typo="Typo.body2">4. 可以在多个浏览器标签页测试发布/订阅</MudText>
                </MudListItem>
            </MudList>
        </MudAlert>
    </MudStack>
</div>

@code {
    private readonly string _defaultTopicName = typeof(TestEventMessage).FullName!;

    private string _publishTopicName = string.Empty;
    private string _publishMessage = string.Empty;
    private string _subscribeTopicName = string.Empty;

    private bool _isPublishing;

    protected override void OnInitialized()
    {
        _publishTopicName = _defaultTopicName;
        _subscribeTopicName = _defaultTopicName;
    }

    private async Task PublishMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_publishMessage))
        {
            Snackbar.Add("请输入消息内容", Severity.Warning);
            return;
        }

        _isPublishing = true;
        StateHasChanged();

        try
        {
            var result = await TestService.PublishTestMessageAsync(_publishMessage, _publishTopicName);

            if (result.IsFailed(out var error))
            {
                Snackbar.Add($"发布失败: {error.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add("消息发布成功", Severity.Success);
                _publishMessage = string.Empty; // 清空输入
            }
        }
        finally
        {
            _isPublishing = false;
            StateHasChanged();
        }
    }

    private async Task OpenListenerDialogAsync()
    {
        if (string.IsNullOrWhiteSpace(_subscribeTopicName))
        {
            Snackbar.Add("请输入监听主题", Severity.Warning);
            return;
        }

        // 订阅主题
        var subscribeResult = await TestService.SubscribeToTestTopicAsync(_subscribeTopicName);

        if (subscribeResult.IsFailed(out var error, out var subscription))
        {
            Snackbar.Add($"订阅失败: {error}", Severity.Error);
            return;
        }

        Snackbar.Add("订阅成功，正在打开监听窗口...", Severity.Success);

        // 打开监听对话框
        var parameters = new DialogParameters
        {
            ["TopicName"] = _subscribeTopicName
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<EventBusTestListenerDialog>(
            $"实时消息监听 - {_subscribeTopicName}",
            parameters,
            options);

        // 对话框关闭后刷新状态
        StateHasChanged();
    }

    private string GetStatusClass()
    {
        return TestService.IsSubscribed ? "status-indicator subscribed" : "status-indicator unsubscribed";
    }
}
