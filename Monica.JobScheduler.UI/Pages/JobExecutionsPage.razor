@attribute [Route(PAGE_URL)]

@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.State
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.Support

<PageTitle>@L["Executions:PageTitle"]</PageTitle>

<SchedulerWorkspace Title="@L["Workspace:Pages:Executions:Title"]"
                    Description="@L["Workspace:Pages:Executions:Description"]"
                    ActivePanelIndex="2">
    <SchedulerAccessBoundary AccessChecked="@PageState.AccessChecked" IsAuthorized="@PageState.IsAuthorized">
        <div class="executions-page">
            <section class="executions-page__filter-shell" aria-label="@L["Executions:Filters:AriaLabel"]">
                <MudPaper Outlined="true" Class="executions-page__filters pa-4">
                    <div class="executions-page__filter-grid">
                        <MudTextField T="string"
                                      @bind-Value="PageState.SearchText"
                                      Label="@L["Executions:Filters:Search"]"
                                      Placeholder="@L["Executions:Filters:SearchPlaceholder"]"
                                      Clearable="true"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnKeyDown="HandleSearchKeyDownAsync" />

                        <MudSelect T="ExecutionTimeRange"
                                   @bind-Value="PageState.TimeRange"
                                   ToStringFunc="FormatTimeRange"
                                   Label="@L["Executions:Filters:TimeRange"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var range in Enum.GetValues<ExecutionTimeRange>())
                            {
                                <MudSelectItem T="ExecutionTimeRange" Value="@range">
                                    @L[$"Executions:TimeRanges:{range}"]
                                </MudSelectItem>
                            }
                        </MudSelect>

                        @if (PageState.TimeRange == ExecutionTimeRange.Custom)
                        {
                            <MudDatePicker @bind-Date="PageState.CustomStartDate"
                                           Label="@L["Executions:Filters:StartDate"]"
                                           Editable="true"
                                           Clearable="true"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                            <MudDatePicker @bind-Date="PageState.CustomEndDate"
                                           Label="@L["Executions:Filters:EndDate"]"
                                           Editable="true"
                                           Clearable="true"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        }
                    </div>

                    <div class="executions-page__state-filter">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["Executions:Filters:States"]
                        </MudText>
                        <div class="executions-page__state-chips">
                            <MudChip T="string"
                                     Label="true"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="@(PageState.SelectedStates.Count == 0 ? Color.Primary : Color.Default)"
                                     Icon="@Icons.Material.Filled.SelectAll"
                                     Disabled="@PageState.IsLoading"
                                     OnClick="ClearStateSelectionAsync">
                                @L["Executions:Filters:AnyState"]
                            </MudChip>
                            <MudChipSet T="JobExecutionState"
                                        SelectionMode="SelectionMode.MultiSelection"
                                        SelectedValues="@PageState.SelectedStates"
                                        SelectedValuesChanged="HandleStateSelectionAsync"
                                        CheckMark="true"
                                        Size="Size.Small"
                                        Variant="Variant.Outlined"
                                        Disabled="@PageState.IsLoading">
                                @foreach (var state in Enum.GetValues<JobExecutionState>())
                                {
                                    <MudChip T="JobExecutionState"
                                             Value="@state"
                                             Label="true"
                                             Color="@JobSchedulerUiPresentation.GetStateColor(state)"
                                             SelectedColor="@JobSchedulerUiPresentation.GetStateColor(state)"
                                             Icon="@GetStateIcon(state)">
                                        @L[$"ExecutionStates:{state}"]
                                    </MudChip>
                                }
                            </MudChipSet>
                        </div>
                    </div>

                    <div class="executions-page__filter-actions">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.FilterAltOff"
                                   Disabled="@PageState.IsLoading"
                                   OnClick="ResetFiltersAsync">
                            @L["Executions:Actions:Reset"]
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   Disabled="@(PageState.IsLoading || PageState.HasInvalidCustomRange)"
                                   OnClick="ApplyFiltersAsync">
                            @L["Executions:Actions:Apply"]
                        </MudButton>
                    </div>
                </MudPaper>
            </section>

            @if (PageState.HasInvalidCustomRange)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    @L["Executions:Filters:InvalidRange"]
                </MudAlert>
            }

            @if (PageState.Error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@PageState.Error</MudAlert>
            }

            <section class="executions-page__ledger-shell" aria-labelledby="execution-ledger-title">
                <MudPaper Outlined="true" Class="executions-page__ledger pa-0">
                    <header class="executions-page__heading">
                        <div>
                            <MudText id="execution-ledger-title" Typo="Typo.h6" HtmlTag="h2">
                                @L["Executions:Title"]
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @L["Executions:Count", PageState.TotalCount]
                            </MudText>
                            @if (PageState.ObservedAtUtc.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["Executions:LastRefreshed", TimePresentation.FormatTimestamp(PageState.ObservedAtUtc)]
                                </MudText>
                            }
                        </div>
                        <MudTooltip Text="@L["Common:Refresh"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                           Color="Color.Primary"
                                           Disabled="@PageState.IsLoading"
                                           OnClick="RefreshTableAsync"
                                           aria-label="@L["Common:Refresh"]" />
                        </MudTooltip>
                    </header>

                    <div class="executions-page__table">
                        <MudTable @ref="_executionTable"
                                  T="JobExecutionInstance"
                                  ServerData="LoadExecutionsAsync"
                                  RowsPerPage="@PageState.PageSize"
                                  Dense="true"
                                  Hover="true"
                                  Breakpoint="Breakpoint.None"
                                  HorizontalScrollbar="true"
                                  Elevation="0"
                                  AllowUnsorted="false">
                            <HeaderContent>
                                <MudTh>@L["Executions:Columns:Definition"]</MudTh>
                                <MudTh>@L["Executions:Columns:State"]</MudTh>
                                <MudTh>
                                    <MudTableSortLabel T="JobExecutionInstance"
                                                       SortLabel="@nameof(JobExecutionSortField.CreatedAtUtc)"
                                                       InitialDirection="SortDirection.Descending">
                                        @L["Executions:Columns:Created"]
                                    </MudTableSortLabel>
                                </MudTh>
                                <MudTh>@L["Executions:Columns:Duration"]</MudTh>
                                <MudTh>@L["Executions:Columns:Attempts"]</MudTh>
                                <MudTh>@L["Executions:Columns:Worker"]</MudTh>
                                <MudTh Class="executions-page__actions-heading">@L["Executions:Columns:Actions"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["Executions:Columns:Definition"]">
                                    <div class="execution-table__identity">
                                        <strong title="@JobSchedulerUiPresentation.GetJobDisplayName(context.Template)">
                                            @JobSchedulerUiPresentation.GetJobDisplayName(context.Template)
                                        </strong>
                                        <code title="@context.Template.Revision.JobKey">@context.Template.Revision.JobKey</code>
                                        <span title="@context.Template.Revision.OwnerKey">@context.Template.Revision.OwnerKey</span>
                                        <code title="@context.InstanceId">@context.InstanceId</code>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="@L["Executions:Columns:State"]">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Label="true"
                                             Variant="Variant.Outlined"
                                             Icon="@GetStateIcon(context.State)"
                                             Color="@JobSchedulerUiPresentation.GetStateColor(context.State)">
                                        @L[$"ExecutionStates:{context.State}"]
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="@L["Executions:Columns:Created"]">
                                    <code class="execution-table__time">@TimePresentation.FormatTimestamp(context.CreatedAtUtc)</code>
                                </MudTd>
                                <MudTd DataLabel="@L["Executions:Columns:Duration"]">
                                    <strong class="execution-table__duration">
                                        @TimePresentation.FormatExecutionDuration(context, PageState.ObservedAtUtc ?? TimeProvider.GetUtcNow())
                                    </strong>
                                </MudTd>
                                <MudTd DataLabel="@L["Executions:Columns:Attempts"]">
                                    <span class="execution-table__attempts">@context.ExecutionAttempt / @context.RetryAttempt</span>
                                </MudTd>
                                <MudTd DataLabel="@L["Executions:Columns:Worker"]">
                                    <code class="execution-table__worker" title="@context.RunningWorkerInstanceId">
                                        @(context.RunningWorkerInstanceId ?? "—")
                                    </code>
                                </MudTd>
                                <MudTd DataLabel="@L["Executions:Columns:Actions"]">
                                    <div class="execution-table__actions" @onclick:stopPropagation="true">
                                        @if (!context.IsTerminal)
                                        {
                                            <MudTooltip Text="@L["Executions:Actions:Cancel"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.StopCircle"
                                                               Color="Color.Warning"
                                                               Size="Size.Small"
                                                               Disabled="@PageState.IsMutating"
                                                               OnClick="@(() => CancelAsync(context))"
                                                               aria-label="@L["Executions:Actions:Cancel"]" />
                                            </MudTooltip>
                                        }
                                        <MudTooltip Text="@L["Executions:Actions:Details"]">
                                            <MudIconButton Icon="@Icons.Material.Outlined.Info"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => OpenDetailsAsync(context.InstanceId))"
                                                           aria-label="@L["Executions:Actions:Details"]" />
                                        </MudTooltip>
                                    </div>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="executions-page__empty">
                                    <MudIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Secondary" Size="Size.Large" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Executions:Empty"]</MudText>
                                </div>
                            </NoRecordsContent>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="@PageState.PageSizeOptions"
                                               RowsPerPageString="@L["Executions:Filters:PageSize"]" />
                            </PagerContent>
                        </MudTable>
                    </div>
                </MudPaper>
            </section>
        </div>
    </SchedulerAccessBoundary>
</SchedulerWorkspace>
