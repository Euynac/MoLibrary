@attribute [Route(PAGE_URL)]

@using Monica.JobScheduler.UI.Localization

@inject JobSchedulerFacade Facade
@inject IJobSchedulerUiAccess Access
@inject IOptions<ModuleJobSchedulerUIOption> UiOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<JobSchedulerResource> L

@implements IAsyncDisposable

<PageTitle>@L["Executions:PageTitle"]</PageTitle>

<SchedulerWorkspace Title="@L["Workspace:Pages:Executions:Title"]"
                    Description="@L["Workspace:Pages:Executions:Description"]">
    <SchedulerAccessBoundary AccessChecked="@_accessChecked" IsAuthorized="@_isAuthorized">
    <div class="executions-page">
        <MudPaper Outlined="true" Class="executions-page__filters pa-4">
            <MudTextField T="string"
                          @bind-Value="_searchText"
                          Label="@L["Executions:Filters:Search"]"
                          Placeholder="@L["Executions:Filters:SearchPlaceholder"]"
                          Clearable="true"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudSelect T="JobExecutionState?"
                       @bind-Value="_state"
                       Label="@L["Executions:Filters:State"]"
                       Clearable="true">
                <MudSelectItem T="JobExecutionState?" Value="@(null)">@L["Executions:Filters:AnyState"]</MudSelectItem>
                @foreach (var state in Enum.GetValues<JobExecutionState>())
                {
                    <MudSelectItem T="JobExecutionState?" Value="@state">@L[$"ExecutionStates:{state}"]</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="SearchAsync">
                @L["Common:Search"]
            </MudButton>
        </MudPaper>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
        }

        <MudPaper Outlined="true" Class="executions-page__table pa-0">
            <div class="executions-page__heading">
                <div>
                    <MudText Typo="Typo.h6">@L["Executions:Title"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Executions:Count", _totalCount]</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Disabled="@_isLoading"
                               OnClick="LoadAsync"
                               aria-label="@L["Common:Refresh"]" />
            </div>

            @if (_isLoading && _executions.Count == 0)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }

            <MudTable T="JobExecutionInstance"
                      Items="@_executions"
                      Dense="true"
                      Hover="true"
                      Breakpoint="Breakpoint.None"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>@L["Executions:Columns:Instance"]</MudTh>
                    <MudTh>@L["Executions:Columns:Job"]</MudTh>
                    <MudTh>@L["Executions:Columns:State"]</MudTh>
                    <MudTh>@L["Executions:Columns:Available"]</MudTh>
                    <MudTh>@L["Executions:Columns:Created"]</MudTh>
                    <MudTh>@L["Executions:Columns:Attempts"]</MudTh>
                    <MudTh>@L["Executions:Columns:Worker"]</MudTh>
                    <MudTh Class="executions-page__actions">@L["Executions:Columns:Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Executions:Columns:Instance"]" Class="executions-page__mono" title="@context.InstanceId">
                        @JobSchedulerUiPresentation.ShortIdentity(context.InstanceId)
                    </MudTd>
                    <MudTd DataLabel="@L["Executions:Columns:Job"]">
                        <div class="executions-page__job" title="@context.Template.Revision.JobKey">
                            <strong>@JobSchedulerUiPresentation.GetJobKeyLabel(context.Template.Revision.JobKey)</strong>
                            <span>@context.Template.Revision.OwnerKey</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="@L["Executions:Columns:State"]">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@JobSchedulerUiPresentation.GetStateColor(context.State)">
                            @L[$"ExecutionStates:{context.State}"]
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["Executions:Columns:Available"]">@context.AvailableAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="@L["Executions:Columns:Created"]">@context.CreatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="@L["Executions:Columns:Attempts"]">@context.ExecutionAttempt / @context.RetryAttempt</MudTd>
                    <MudTd DataLabel="@L["Executions:Columns:Worker"]" title="@context.RunningWorkerInstanceId">
                        @JobSchedulerUiPresentation.ShortIdentity(context.RunningWorkerInstanceId)
                    </MudTd>
                    <MudTd DataLabel="@L["Executions:Columns:Actions"]" Class="executions-page__actions">
                        <MudTooltip Text="@L["Executions:Actions:Details"]">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" OnClick="@(() => OpenDetailsAsync(context.InstanceId))" />
                        </MudTooltip>
                        @if (context.State is JobExecutionState.Queued or JobExecutionState.Running)
                        {
                            <MudTooltip Text="@L["Executions:Actions:Cancel"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                               Color="Color.Warning"
                                               OnClick="@(() => CancelAsync(context))" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-6" Color="Color.Secondary">@L["Executions:Empty"]</MudText>
                </NoRecordsContent>
            </MudTable>

            @if (_pageCount > 1)
            {
                <div class="executions-page__pagination">
                    <MudPagination Count="@_pageCount" Selected="@_pageNumber" SelectedChanged="PageChangedAsync" />
                </div>
            }
        </MudPaper>
    </div>
    </SchedulerAccessBoundary>
</SchedulerWorkspace>

@code {
    public const string PAGE_URL = "/job-scheduler/executions";

    private readonly CancellationTokenSource _lifetime = new();
    private List<JobExecutionInstance> _executions = [];
    private string? _searchText;
    private JobExecutionState? _state;
    private bool _accessChecked;
    private bool _isAuthorized;
    private bool _isLoading;
    private string? _error;
    private int _pageNumber = 1;
    private int _pageCount;
    private int _totalCount;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SearchAsync()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task PageChangedAsync(int page)
    {
        _pageNumber = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_isLoading || _lifetime.IsCancellationRequested)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _isAuthorized = await Access.IsAuthorizedAsync(_lifetime.Token);
            _accessChecked = true;
            if (!_isAuthorized)
            {
                _executions = [];
                _totalCount = 0;
                _pageCount = 1;
                _error = null;
                return;
            }

            var pageSize = Math.Max(1, UiOptions.Value.DefaultPageSize);
            var result = await Facade.QueryExecutionsAsync(new JobExecutionQuery
            {
                SchedulerScopeKey = string.Empty,
                SearchText = _searchText,
                States = _state is null ? null : [_state.Value],
                PageNumber = _pageNumber,
                PageSize = pageSize,
                SortField = JobExecutionSortField.CreatedAtUtc,
                SortDescending = true
            }, _lifetime.Token);
            if (result.IsFailed(out var error, out var page))
            {
                _error = error.Message;
                return;
            }

            _executions = page.Items;
            _totalCount = page.TotalCount;
            _pageCount = Math.Max(1, (int)Math.Ceiling((double)_totalCount / pageSize));
            _error = null;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenDetailsAsync(string instanceId)
    {
        if (!await RefreshAccessAsync())
        {
            return;
        }

        var parameters = new DialogParameters<ExecutionDetailDialog> { { dialog => dialog.InstanceId, instanceId } };
        await DialogService.ShowAsync<ExecutionDetailDialog>(L["ExecutionDetail:Title"], parameters, new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Large
        });
    }

    private async Task CancelAsync(JobExecutionInstance execution)
    {
        if (!await RefreshAccessAsync())
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["Executions:Cancel:Title"],
            L["Executions:Cancel:Message", execution.InstanceId],
            yesText: L["Executions:Actions:Cancel"],
            cancelText: L["Common:Keep"]);
        if (confirmed != true)
        {
            return;
        }

        var result = await Facade.CancelExecutionAsync(execution.InstanceId, cancellationToken: _lifetime.Token);
        if (result.IsFailed(out var error, out _))
        {
            Snackbar.Add(error.Message ?? L["Executions:Cancel:Failed"], Severity.Error);
            return;
        }

        Snackbar.Add(L["Executions:Cancel:Requested"], Severity.Success);
        await LoadAsync();
    }

    private async Task<bool> RefreshAccessAsync()
    {
        _isAuthorized = await Access.IsAuthorizedAsync(_lifetime.Token);
        _accessChecked = true;
        if (!_isAuthorized)
        {
            _executions = [];
            _error = null;
        }

        return _isAuthorized;
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        _lifetime.Dispose();
    }
}
