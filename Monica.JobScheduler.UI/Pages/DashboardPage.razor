@attribute [Route(PAGE_URL)]
@attribute [Route(DASHBOARD_URL)]

@using Monica.JobScheduler.UI.Components.Dashboard
@using Monica.JobScheduler.UI.Localization

@inject JobSchedulerDashboardFacade DashboardFacade
@inject IOptions<ModuleJobSchedulerUIOption> UiOptions
@inject ISnackbar Snackbar
@inject IStringLocalizer<JobSchedulerResource> L

@implements IAsyncDisposable

<PageTitle>@L["Dashboard:Title"]</PageTitle>

<div class="dashboard-page">
    @if (_isLoading)
    {
        <div class="loading-container">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Common:Status:Loading"]</MudText>
        </div>
    }
    else if (_loadError != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_loadError
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => LoadDataAsync())">@L["Common:Actions:Retry"]</MudButton>
        </MudAlert>
    }
    else if (_summary != null)
    {
        @* System Health Banner *@
        <SystemHealthBanner Status="_summary.HealthStatus" Message="@_summary.HealthMessage" />

        @* Metrics Summary Cards *@
        <MetricsSummaryCards TotalJobs="_summary.TotalJobs"
                              RecurringJobCount="_summary.RecurringJobCount"
                              TriggeredJobCount="_summary.TriggeredJobCount"
                              DisabledJobCount="_summary.DisabledJobCount"
                              RunningNow="_summary.RunningNow"
                              SuccessRate="_summary.SuccessRate"
                              ThroughputPerHour="_summary.ThroughputPerHour"
                              TimeWindowText="@GetTimeWindowText()" />

        @* Main Content Grid *@
        <MudGrid Spacing="3" Class="dashboard-overview-grid">
            <MudItem xs="12" md="6" Class="dashboard-overview-column">
                <div class="dashboard-left-stack">
                    <JobStateDistributionChart StateDistribution="_summary.StateDistribution"
                                               TimeWindowText="@GetTimeWindowText()" />

                    <ProblemJobsPanel Problems="_problemJobs" />
                </div>
            </MudItem>

            <MudItem xs="12" md="6" Class="dashboard-overview-column dashboard-activity-column">
                <RecentActivityTimeline Activities="_recentActivities" />
            </MudItem>
        </MudGrid>

        @* Auto Refresh Indicator *@
        @if (_autoRefreshEnabled)
        {
            <div class="refresh-indicator">
                <MudTooltip Text="@L["Dashboard:AutoRefresh:Enabled", _autoRefreshInterval]">
                    <MudIcon Icon="@Icons.Material.Filled.Autorenew"
                             Size="Size.Small"
                             Class="@(_isRefreshing ? "rotating" : "")" />
                </MudTooltip>
            </div>
        }
    }
</div>

@code {
    public const string PAGE_URL = "/job-scheduler";
    public const string DASHBOARD_URL = "/job-scheduler/dashboard";

    private bool _isLoading = true;
    private bool _isRefreshing;
    private string? _loadError;

    private DashboardSummary? _summary;
    private List<RecentActivity> _recentActivities = [];
    private ProblemJobs? _problemJobs;

    private bool _autoRefreshEnabled = true;
    private int _autoRefreshInterval = 30; // seconds
    private System.Timers.Timer? _refreshTimer;
    private CancellationTokenSource? _cts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _cts = new CancellationTokenSource();
            await LoadDataAsync();

            if (_autoRefreshEnabled)
            {
                StartAutoRefresh();
            }
        }
    }

    private async Task LoadDataAsync(bool showLoading = true)
    {
        try
        {
            if (showLoading)
            {
                _isLoading = true;
                _loadError = null;
                StateHasChanged();
            }

            var token = _cts?.Token ?? CancellationToken.None;

            var snapshotResult = await DashboardFacade.GetDashboardAsync(
                UiOptions.Value.HealthMetricsWindow,
                15,
                token);

            if (snapshotResult.IsFailed(out var error, out var snapshot))
            {
                _loadError = error.Message;
            }
            else
            {
                _summary = snapshot!.Summary;
                _recentActivities = snapshot.RecentActivities.ToList();
                _problemJobs = snapshot.Problems;
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore cancellation
        }
        catch (Exception ex)
        {
            _loadError = $"{L["Common:Messages:LoadFailed"]}: {ex.Message}";
        }
        finally
        {
            if (showLoading)
            {
                _isLoading = false;
            }
            StateHasChanged();
        }
    }

    private async Task RefreshDataAsync()
    {
        if (_isRefreshing) return;

        try
        {
            _isRefreshing = true;
            StateHasChanged();

            // Do not display the loading indicator during automatic refresh and update silently
            await LoadDataAsync(showLoading: false);
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private void StartAutoRefresh()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = new System.Timers.Timer(_autoRefreshInterval * 1000);
        _refreshTimer.Elapsed += async (_, _) =>
        {
            await InvokeAsync(RefreshDataAsync);
        };
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();
    }

    private void StopAutoRefresh()
    {
        _refreshTimer?.Stop();
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    private string GetTimeWindowText()
    {
        if (_summary == null) return "";

        var window = _summary.MetricsEndTime - _summary.MetricsStartTime;
        if (window.TotalDays >= 30)
            return L["Dashboard:TimeRange:LastDays", (int)window.TotalDays];
        if (window.TotalDays >= 7)
            return L["Dashboard:TimeRange:LastDays", (int)window.TotalDays];
        if (window.TotalHours >= 24)
            return L["Dashboard:TimeRange:LastDays", (int)window.TotalDays];
        return L["Dashboard:TimeRange:LastHours", (int)window.TotalHours];
    }

    public async ValueTask DisposeAsync()
    {
        StopAutoRefresh();
        await _cts.SafeCancelAndDisposeAsync();

        await ValueTask.CompletedTask;
    }
}
