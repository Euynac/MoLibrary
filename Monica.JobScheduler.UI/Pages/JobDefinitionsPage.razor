@attribute [Route(PAGE_URL)]
@inject JobSchedulerUIService UIService
@inject JobStateColorService ColorService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IMoBrowserStorage BrowserStorage
@inject IStringLocalizer<JobSchedulerResource> L
@using Monica.JobScheduler.UI.Localization

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@L["JobDefinitions:Title"]</MudText>

    <!-- 筛选器 -->
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4">
                <MudTextField T="string"
                              @bind-Value="_filterFromProject"
                              Label="@L["JobDefinitions:Filters:SourceProject"]"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true"
                              OnClearButtonClick="HandleFilterChanged" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField T="string"
                              @bind-Value="_filterJobKey"
                              Label="@L["JobDefinitions:Filters:JobKey"]"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true"
                              OnClearButtonClick="HandleFilterChanged" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField T="string"
                              @bind-Value="_filterJobName"
                              Label="@L["JobDefinitions:Filters:JobName"]"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true"
                              OnClearButtonClick="HandleFilterChanged" />
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="HandleFilterChanged"
                           StartIcon="@Icons.Material.Filled.Search">
                    @L["Common:Actions:Search"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           OnClick="HandleResetFilters"
                           StartIcon="@Icons.Material.Filled.Clear"
                           Class="ml-2">
                    @L["Common:Actions:Reset"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- 批量操作工具栏（仅在 RecurringJob 选项卡且有选择时显示） -->
    @if (_selectedRecurringJobs.Any() && _activeTabIndex == 0)
    {
        <MudPaper Class="pa-3 mb-3 batch-toolbar" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" />
                    <MudText Typo="Typo.body1">
                        @L["JobDefinitions:BatchOperation:Selected", _selectedRecurringJobs.Count]
                    </MudText>
                </MudStack>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Pause"
                               OnClick="BatchPauseJobsAsync"
                               Disabled="_isProcessingBatch">
                        @L["JobDefinitions:Actions:BatchPause"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="BatchResumeJobsAsync"
                               Disabled="_isProcessingBatch">
                        @L["JobDefinitions:Actions:BatchResume"]
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ClearSelection">
                        @L["Common:Actions:ClearSelection"]
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }

    <!-- Tabs -->
    @if (_stateLoaded)
    {
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex"
                 Elevation="2"
                 Rounded="true"
                 ApplyEffectsToContainer="true">
            <MudTabPanel Text="@L["JobDefinitions:Tabs:RecurringJob"]" Icon="@Icons.Material.Filled.Schedule" PanelClass="pa-6">
            <MudTable @ref="_recurringTable"
                      T="JobDefinitionWithLastExecution"
                      ServerData="LoadRecurringJobsAsync"
                      RowsPerPage="@_recurringPageSize"
                      MultiSelection="true"
                      @bind-SelectedItems="_selectedRecurringJobs"
                      SelectOnRowClick="false"
                      Hover="true"
                      Striped="true"
                      Elevation="0">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@L["JobDefinitions:Tabs:RecurringJob"]</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Primary"
                                   OnClick="RefreshRecurringJobsAsync" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortLabel="FromProject" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:SourceProject"]</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="JobKey" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:JobKey"]</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="JobName" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:JobName"]</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="CronExpression" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:CronExpression"]</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="NextExecutionTime" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:NextExecutionTime"]</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="LastExecution" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:LastExecutionTime"]</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="IsDisabled" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:Status"]</MudTableSortLabel></MudTh>
                    <MudTh>@L["JobDefinitions:Columns:Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:SourceProject"]">@context.Definition.FromProject</MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:JobKey"]">@context.Definition.JobKey</MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:JobName"]">@context.Definition.JobName</MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:CronExpression"]">
                        <CronExpressionDisplay Expression="@context.Definition.CronExpression"
                                               DisplayMode="CronDisplayMode.Compact" />
                    </MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:NextExecutionTime"]">
                        @if (context.NextExecutionTime.HasValue)
                        {
                            <MudText Typo="Typo.body2">@context.NextExecutionTime.Value.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:LastExecutionTime"]">
                        @if (context.LastExecution != null)
                        {
                            <div class="last-execution-wrapper">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@ColorService.GetStateColor(context.LastExecution.State)"
                                         OnClick="@(async () => await OpenInstanceDetailDialog(context.LastExecution.InstanceId))"
                                         Class="clickable-execution-time">
                                    @context.LastExecution.CreatedAt.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")
                                </MudChip>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:Status"]">
                        <MudChip T="string" Size="Size.Small" Color="@GetDisabledStateColor(context.Definition.IsDisabled)">
                            @(context.Definition.IsDisabled ? L["JobDefinitions:Status:Disabled"] : L["JobDefinitions:Status:Enabled"])
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:Actions"]">
                        <MudStack Row="true" Spacing="1">
                            @if (context.Definition.IsDisabled)
                            {
                                <MudTooltip Text="@L["JobDefinitions:Actions:Resume"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   OnClick="() => ResumeJobAsync(context.Definition.JobKey)" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="@L["JobDefinitions:Actions:Pause"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Pause"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   OnClick="() => PauseJobAsync(context.Definition.JobKey)" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="@L["JobDefinitions:Actions:ViewDetails"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Info"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="() => NavigateToDetail(context.Definition.JobKey)" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>@L["JobDefinitions:Messages:NoRecurringJobs"]</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudProgressCircular Indeterminate="true" />
                </LoadingContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@L["JobDefinitions:Tabs:TriggerJob"]" Icon="@Icons.Material.Filled.TouchApp" PanelClass="pa-6">
            <MudTable @ref="_triggerTable"
                      T="JobDefinitionWithLastExecution"
                      ServerData="LoadTriggerJobsAsync"
                      RowsPerPage="@_triggerPageSize"
                      Hover="true"
                      Striped="true"
                      Elevation="0">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@L["JobDefinitions:Tabs:TriggerJob"]</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Primary"
                                   OnClick="RefreshTriggerJobsAsync" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortLabel="FromProject" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:SourceProject"]</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="JobKey" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:JobKey"]</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="JobName" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:JobName"]</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="LastExecution" T="JobDefinitionWithLastExecution">@L["JobDefinitions:Columns:LastExecutionTime"]</MudTableSortLabel></MudTh>
                    <MudTh>@L["JobDefinitions:Columns:Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:SourceProject"]">@context.Definition.FromProject</MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:JobKey"]">@context.Definition.JobKey</MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:JobName"]">@context.Definition.JobName</MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:LastExecutionTime"]">
                        @if (context.LastExecution != null)
                        {
                            <div class="last-execution-wrapper">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@ColorService.GetStateColor(context.LastExecution.State)"
                                         OnClick="@(async () => await OpenInstanceDetailDialog(context.LastExecution.InstanceId))"
                                         Class="clickable-execution-time">
                                    @context.LastExecution.CreatedAt.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")
                                </MudChip>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["JobDefinitions:Columns:Actions"]">
                        <MudStack Row="true" Spacing="1">
                            <MudTooltip Text="@L["JobDefinitions:Actions:Execute"]">
                                <MudIconButton Icon="@Icons.Material.Filled.PlayCircle"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="() => ExecuteJobAsync(context.Definition.JobKey)" />
                            </MudTooltip>
                            <MudTooltip Text="@L["JobDefinitions:Actions:ViewDetails"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Info"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="() => NavigateToDetail(context.Definition.JobKey)" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>@L["JobDefinitions:Messages:NoTriggerJobs"]</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudProgressCircular Indeterminate="true" />
                </LoadingContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
                </PagerContent>
            </MudTable>
            </MudTabPanel>
        </MudTabs>
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="2">
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                <MudProgressCircular Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@L["Common:Status:Loading"]</MudText>
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    public const string PAGE_URL = "/job-scheduler/definitions";

    private MudTable<JobDefinitionWithLastExecution>? _recurringTable;
    private MudTable<JobDefinitionWithLastExecution>? _triggerTable;
    private int _activeTabIndex = 0;

    private string? _filterFromProject;
    private string? _filterJobKey;
    private string? _filterJobName;

    // Batch operation state
    private HashSet<JobDefinitionWithLastExecution> _selectedRecurringJobs = [];
    private bool _isProcessingBatch = false;

    // RecurringJob table state
    private string? _recurringSortBy;
    private bool _recurringSortDescending;
    private int _recurringPageSize = 10;

    // TriggerJob table state
    private string? _triggerSortBy;
    private bool _triggerSortDescending;
    private int _triggerPageSize = 10;

    // State loading flag - controls conditional rendering of MudTabs
    private bool _stateLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var recurringState = await BrowserStorage.GetTableStateAsync("job-definitions-recurring");
            if (!string.IsNullOrEmpty(recurringState.SortBy))
            {
                _recurringSortBy = recurringState.SortBy;
                _recurringSortDescending = recurringState.SortDescending;
            }
            _recurringPageSize = recurringState.PageSize;

            var triggerState = await BrowserStorage.GetTableStateAsync("job-definitions-trigger");
            if (!string.IsNullOrEmpty(triggerState.SortBy))
            {
                _triggerSortBy = triggerState.SortBy;
                _triggerSortDescending = triggerState.SortDescending;
            }
            _triggerPageSize = triggerState.PageSize;

            _stateLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<TableData<JobDefinitionWithLastExecution>> LoadRecurringJobsAsync(TableState state, CancellationToken cancellationToken)
    {
        // Extract sorting from TableState
        string? sortBy = null;
        bool sortDescending = false;

        if (!string.IsNullOrEmpty(state.SortLabel))
        {
            sortBy = MapSortLabelToField(state.SortLabel);
            sortDescending = state.SortDirection == SortDirection.Descending;

            // Save sort state
            _recurringSortBy = state.SortLabel;
            _recurringSortDescending = sortDescending;
        }

        _recurringPageSize = state.PageSize;
        // Save state to localStorage
        await SaveRecurringTableStateAsync();
        var filter = new JobDefinitionFilterRequest
        {
            FromProject = _filterFromProject,
            JobKey = _filterJobKey,
            JobName = _filterJobName,
            JobType = JobType.Recurring,
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SortBy = sortBy,
            SortDescending = sortDescending
        };

        var result = await UIService.GetJobDefinitionsWithLastExecutionAsync(filter, cancellationToken);

        if (result.IsFailed(out var error, out var data))
        {
            Snackbar.Add($"{L["Common:Messages:LoadFailed"]}: {error.Message}", Severity.Error);
            return new TableData<JobDefinitionWithLastExecution> { Items = Array.Empty<JobDefinitionWithLastExecution>(), TotalItems = 0 };
        }

        // Apply client-side sorting for computed fields
        var items = data.Items ?? Array.Empty<JobDefinitionWithLastExecution>();
        if (!string.IsNullOrEmpty(state.SortLabel))
        {
            items = ApplyClientSideSorting(items, state.SortLabel, sortDescending).ToArray();
        }

       

        return new TableData<JobDefinitionWithLastExecution>
        {
            Items = items,
            TotalItems = data.Sum ?? 0
        };
    }

    private async Task<TableData<JobDefinitionWithLastExecution>> LoadTriggerJobsAsync(TableState state, CancellationToken cancellationToken)
    {
        // Extract sorting from TableState
        string? sortBy = null;
        bool sortDescending = false;

        if (!string.IsNullOrEmpty(state.SortLabel))
        {
            sortBy = MapSortLabelToField(state.SortLabel);
            sortDescending = state.SortDirection == SortDirection.Descending;

            // Save sort state
            _triggerSortBy = state.SortLabel;
            _triggerSortDescending = sortDescending;
        }

        _triggerPageSize = state.PageSize;
        
        // Save state to localStorage
        await SaveTriggerTableStateAsync();

        var filter = new JobDefinitionFilterRequest
        {
            FromProject = _filterFromProject,
            JobKey = _filterJobKey,
            JobName = _filterJobName,
            JobType = JobType.Triggered,
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SortBy = sortBy,
            SortDescending = sortDescending
        };

        var result = await UIService.GetJobDefinitionsWithLastExecutionAsync(filter, cancellationToken);

        if (result.IsFailed(out var error, out var data))
        {
            Snackbar.Add($"{L["Common:Messages:LoadFailed"]}: {error.Message}", Severity.Error);
            return new TableData<JobDefinitionWithLastExecution> { Items = Array.Empty<JobDefinitionWithLastExecution>(), TotalItems = 0 };
        }

        // Apply client-side sorting for computed fields
        var items = data.Items ?? Array.Empty<JobDefinitionWithLastExecution>();
        if (!string.IsNullOrEmpty(state.SortLabel))
        {
            items = ApplyClientSideSorting(items, state.SortLabel, sortDescending).ToArray();
        }

       

        return new TableData<JobDefinitionWithLastExecution>
        {
            Items = items,
            TotalItems = data.Sum ?? 0
        };
    }

    private async Task HandleFilterChanged()
    {
        if (_activeTabIndex == 0)
        {
            if (_recurringTable != null)
            {
                await _recurringTable.ReloadServerData();
            }
        }
        else
        {
            if (_triggerTable != null)
            {
                await _triggerTable.ReloadServerData();
            }
        }
    }

    private void HandleResetFilters()
    {
        _filterFromProject = null;
        _filterJobKey = null;
        _filterJobName = null;
        _ = HandleFilterChanged();
    }

    private async Task RefreshRecurringJobsAsync()
    {
        if (_recurringTable != null)
        {
            await _recurringTable.ReloadServerData();
        }
    }

    private async Task RefreshTriggerJobsAsync()
    {
        if (_triggerTable != null)
        {
            await _triggerTable.ReloadServerData();
        }
    }

    private async Task PauseJobAsync(string jobKey)
    {
        var result = await UIService.PauseJobAsync(jobKey);
        if (result.IsFailed(out var error))
        {
            Snackbar.Add($"{L["JobDefinitions:Messages:PauseFailed"]}: {error.Message}", Severity.Error);
        }
        else
        {
            Snackbar.Add(L["JobDefinitions:Messages:PauseSuccess", jobKey], Severity.Success);
            await RefreshRecurringJobsAsync();
        }
    }

    private async Task ResumeJobAsync(string jobKey)
    {
        var result = await UIService.ResumeJobAsync(jobKey);
        if (result.IsFailed(out var error))
        {
            Snackbar.Add($"{L["JobDefinitions:Messages:ResumeFailed"]}: {error.Message}", Severity.Error);
        }
        else
        {
            Snackbar.Add(L["JobDefinitions:Messages:ResumeSuccess", jobKey], Severity.Success);
            await RefreshRecurringJobsAsync();
        }
    }

    private async Task ExecuteJobAsync(string jobKey)
    {
        // 获取 JobDefinition
        var defResult = await UIService.GetJobDefinitionAsync(jobKey);
        if (defResult.IsFailed(out var error, out var definition))
        {
            Snackbar.Add($"{L["JobDetail:Messages:GetDefinitionFailed"]}: {error.Message}", Severity.Error);
            return;
        }

        if (definition == null)
        {
            Snackbar.Add(L["JobDetail:Messages:DefinitionNotFound"], Severity.Error);
            return;
        }

        // 显示执行确认对话框
        var parameters = new DialogParameters<JobExecuteDialog>
        {
            { x => x.JobDefinition, definition }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<JobExecuteDialog>(L["Dialogs:JobExecute:Title"], parameters, options);
        var dialogResult = await dialog.Result;

        // 执行结果已在对话框中处理，刷新列表
        if (dialogResult is { Canceled: false })
        {
            await RefreshTriggerJobsAsync();
        }
    }

    private void NavigateToDetail(string jobKey)
    {
        NavigationManager.NavigateTo($"/job-scheduler/definitions/{Uri.EscapeDataString(jobKey)}");
    }

    private async Task OpenInstanceDetailDialog(string instanceId)
    {
        var parameters = new DialogParameters<JobInstanceDetailDialog>
        {
            { x => x.InstanceId, instanceId },
            { x => x.ShowJobDefinitionButton, true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false,
            Position = DialogPosition.Center
        };

        await DialogService.ShowAsync<JobInstanceDetailDialog>(L["Dialogs:JobInstanceDetail:Title"], parameters, options);
    }

    private Color GetDisabledStateColor(bool isDisabled)
    {
        return isDisabled ? Color.Warning : Color.Success;
    }

    // Helper methods for sorting and state management

    /// <summary>
    /// Maps MudTable SortLabel to API field name
    /// </summary>
    private static string? MapSortLabelToField(string sortLabel)
    {
        return sortLabel switch
        {
            "FromProject" => "FromProject",
            "JobKey" => "JobKey",
            "JobName" => "JobName",
            "CronExpression" => "CronExpression",
            "IsDisabled" => "IsDisabled",
            // NextExecutionTime and LastExecution are client-side sorted
            "NextExecutionTime" => null,
            "LastExecution" => null,
            _ => null
        };
    }

    /// <summary>
    /// Applies client-side sorting for computed fields
    /// </summary>
    private static IEnumerable<JobDefinitionWithLastExecution> ApplyClientSideSorting(
        IEnumerable<JobDefinitionWithLastExecution> items,
        string sortLabel,
        bool descending)
    {
        IOrderedEnumerable<JobDefinitionWithLastExecution>? sorted = sortLabel switch
        {
            "NextExecutionTime" => descending
                ? items.OrderByDescending(x => x.NextExecutionTime ?? DateTime.MinValue)
                : items.OrderBy(x => x.NextExecutionTime ?? DateTime.MinValue),
            "LastExecution" => descending
                ? items.OrderByDescending(x => x.LastExecution?.CreatedAt ?? DateTime.MinValue)
                : items.OrderBy(x => x.LastExecution?.CreatedAt ?? DateTime.MinValue),
            _ => null
        };

        return sorted ?? items;
    }

    /// <summary>
    /// Saves RecurringJob table state to localStorage
    /// </summary>
    private async Task SaveRecurringTableStateAsync()
    {
        await BrowserStorage.SaveTableStateAsync("job-definitions-recurring", new TablePersistenceState(
            SortBy: _recurringSortBy,
            SortDescending: _recurringSortDescending,
            PageSize: _recurringPageSize
        ));
    }

    /// <summary>
    /// Saves TriggerJob table state to localStorage
    /// </summary>
    private async Task SaveTriggerTableStateAsync()
    {
        await BrowserStorage.SaveTableStateAsync("job-definitions-trigger", new TablePersistenceState(
            SortBy: _triggerSortBy,
            SortDescending: _triggerSortDescending,
            PageSize: _triggerPageSize
        ));
    }

    // Batch operation methods

    private async Task BatchPauseJobsAsync()
    {
        await ExecuteBatchOperationAsync(BatchOperationType.Pause);
    }

    private async Task BatchResumeJobsAsync()
    {
        await ExecuteBatchOperationAsync(BatchOperationType.Resume);
    }

    private async Task ExecuteBatchOperationAsync(BatchOperationType operationType)
    {
        var jobKeys = _selectedRecurringJobs
            .Select(j => j.Definition.JobKey)
            .ToList();

        // Show confirmation dialog
        var confirmParams = new DialogParameters<BatchOperationConfirmDialog>
        {
            { x => x.JobKeys, jobKeys },
            { x => x.OperationType, operationType }
        };

        var confirmOptions = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false
        };

        var confirmDialog = await DialogService.ShowAsync<BatchOperationConfirmDialog>(
            L["JobDefinitions:BatchOperation:ConfirmTitle"], confirmParams, confirmOptions);

        var confirmResult = await confirmDialog.Result;

        if (confirmResult is not { Canceled: false })
            return;

        // Execute batch operation
        _isProcessingBatch = true;
        StateHasChanged();

        try
        {
            Res<BatchJobOperationResult> result = operationType == BatchOperationType.Pause
                ? await UIService.BatchPauseJobsAsync(jobKeys)
                : await UIService.BatchResumeJobsAsync(jobKeys);

            if (result.IsFailed(out var error, out var data))
            {
                Snackbar.Add($"{L["Common:Messages:LoadFailed"]}: {error.Message}", Severity.Error);
                return;
            }

            // Show result dialog
            var resultParams = new DialogParameters<BatchOperationResultDialog>
            {
                { x => x.Result, data }
            };

            var resultOptions = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true
            };

            await DialogService.ShowAsync<BatchOperationResultDialog>(
                L["JobDefinitions:BatchOperation:ResultTitle"], resultParams, resultOptions);

            // Show summary snackbar
            if (data.FailedCount == 0)
            {
                Snackbar.Add(L["JobDefinitions:BatchOperation:Success", data.SuccessCount], Severity.Success);
            }
            else if (data.SuccessCount > 0)
            {
                Snackbar.Add(
                    L["JobDefinitions:BatchOperation:PartialSuccess", data.SuccessCount, data.FailedCount],
                    Severity.Warning);
            }
            else
            {
                Snackbar.Add(L["JobDefinitions:BatchOperation:AllFailed"], Severity.Error);
            }

            // Clear selection and refresh
            _selectedRecurringJobs.Clear();
            await RefreshRecurringJobsAsync();
        }
        finally
        {
            _isProcessingBatch = false;
            StateHasChanged();
        }
    }

    private void ClearSelection()
    {
        _selectedRecurringJobs.Clear();
    }
}
