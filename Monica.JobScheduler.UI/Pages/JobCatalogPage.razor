@attribute [Route(PAGE_URL)]

@using Monica.JobScheduler.UI.Localization

@inject JobSchedulerFacade Facade
@inject IJobSchedulerUiAccess Access
@inject IOptions<ModuleJobSchedulerUIOption> UiOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<JobSchedulerResource> L

@implements IAsyncDisposable

<PageTitle>@L["Catalog:PageTitle"]</PageTitle>

<SchedulerWorkspace Title="@L["Workspace:Pages:Catalog:Title"]"
                    Description="@L["Workspace:Pages:Catalog:Description"]">
    <SchedulerAccessBoundary AccessChecked="@_accessChecked" IsAuthorized="@_isAuthorized">
    <div class="catalog-page">
        <MudPaper Outlined="true" Class="catalog-page__filters pa-4">
            <MudTextField T="string"
                          @bind-Value="_searchText"
                          Label="@L["Catalog:Filters:Search"]"
                          Placeholder="@L["Catalog:Filters:SearchPlaceholder"]"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudTextField T="string"
                          @bind-Value="_ownerId"
                          Label="@L["Catalog:Filters:Owner"]"
                          Clearable="true" />
            <MudSelect T="JobType?"
                       @bind-Value="_jobType"
                       Label="@L["Catalog:Filters:Type"]"
                       Clearable="true">
                <MudSelectItem T="JobType?" Value="@(null)">@L["Catalog:Filters:AnyType"]</MudSelectItem>
                @foreach (var type in Enum.GetValues<JobType>())
                {
                    <MudSelectItem T="JobType?" Value="@type">@L[$"JobTypes:{type}"]</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="bool?"
                       @bind-Value="_isDisabled"
                       Label="@L["Catalog:Filters:State"]"
                       Clearable="true">
                <MudSelectItem T="bool?" Value="@(null)">@L["Catalog:Filters:AnyState"]</MudSelectItem>
                <MudSelectItem T="bool?" Value="@(false)">@L["Catalog:Enabled"]</MudSelectItem>
                <MudSelectItem T="bool?" Value="@(true)">@L["Catalog:Disabled"]</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="SearchAsync">
                @L["Common:Search"]
            </MudButton>
        </MudPaper>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
        }

        <MudPaper Outlined="true" Class="catalog-page__table pa-0">
            <div class="catalog-page__heading">
                <div>
                    <MudText Typo="Typo.h6">@L["Catalog:Title"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Catalog:Count", _totalCount]</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Disabled="@_isLoading"
                               OnClick="LoadAsync"
                               aria-label="@L["Common:Refresh"]" />
            </div>

            @if (_isLoading && _definitions.Count == 0)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }

            <MudTable T="ActiveJobDefinition"
                      Items="@_definitions"
                      Dense="true"
                      Hover="true"
                      Breakpoint="Breakpoint.None"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>@L["Catalog:Columns:Definition"]</MudTh>
                    <MudTh>@L["Catalog:Columns:Owner"]</MudTh>
                    <MudTh>@L["Catalog:Columns:Type"]</MudTh>
                    <MudTh>@L["Catalog:Columns:Schedule"]</MudTh>
                    <MudTh>@L["Catalog:Columns:Concurrency"]</MudTh>
                    <MudTh>@L["Catalog:Columns:Policy"]</MudTh>
                    <MudTh>@L["Catalog:Columns:Revision"]</MudTh>
                    <MudTh Class="catalog-page__actions">@L["Catalog:Columns:Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Catalog:Columns:Definition"]">
                        <div class="catalog-page__definition">
                            <strong>@context.Declaration.JobName</strong>
                            <span title="@context.Declaration.JobKey">@context.Declaration.JobKey</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="@L["Catalog:Columns:Owner"]">@context.OwnerId</MudTd>
                    <MudTd DataLabel="@L["Catalog:Columns:Type"]">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @L[$"JobTypes:{context.Declaration.JobType}"]
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["Catalog:Columns:Schedule"]">
                        <div class="catalog-page__schedule">@GetSchedule(context.Declaration)</div>
                    </MudTd>
                    <MudTd DataLabel="@L["Catalog:Columns:Concurrency"]">@context.Declaration.MaxConcurrency</MudTd>
                    <MudTd DataLabel="@L["Catalog:Columns:Policy"]">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Color="@(context.IsDisabled ? Color.Warning : Color.Success)">
                            @(context.IsDisabled ? L["Catalog:Disabled"] : L["Catalog:Enabled"])
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["Catalog:Columns:Revision"]" Class="catalog-page__mono" title="@context.JobRevisionId">
                        @JobSchedulerUiPresentation.ShortIdentity(context.JobRevisionId)
                    </MudTd>
                    <MudTd DataLabel="@L["Catalog:Columns:Actions"]" Class="catalog-page__actions">
                        @if (context.Declaration.JobType == JobType.Triggered)
                        {
                            <MudTooltip Text="@L["Catalog:Actions:Trigger"]">
                                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                               Color="Color.Primary"
                                               Disabled="@context.IsDisabled"
                                               OnClick="@(() => OpenTriggerAsync(context))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="@L["Catalog:Actions:Policy"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Policy"
                                           OnClick="@(() => OpenPolicyAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-6" Color="Color.Secondary">@L["Catalog:Empty"]</MudText>
                </NoRecordsContent>
            </MudTable>

            @if (_pageCount > 1)
            {
                <div class="catalog-page__pagination">
                    <MudPagination Count="@_pageCount" Selected="@_pageNumber" SelectedChanged="PageChangedAsync" />
                </div>
            }
        </MudPaper>
    </div>
    </SchedulerAccessBoundary>
</SchedulerWorkspace>

@code {
    public const string PAGE_URL = "/job-scheduler/catalog";

    private readonly CancellationTokenSource _lifetime = new();
    private List<ActiveJobDefinition> _definitions = [];
    private string? _searchText;
    private string? _ownerId;
    private JobType? _jobType;
    private bool? _isDisabled;
    private bool _accessChecked;
    private bool _isAuthorized;
    private bool _isLoading;
    private string? _error;
    private int _pageNumber = 1;
    private int _pageCount;
    private int _totalCount;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SearchAsync()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task PageChangedAsync(int page)
    {
        _pageNumber = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_isLoading || _lifetime.IsCancellationRequested)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _isAuthorized = await Access.IsAuthorizedAsync(_lifetime.Token);
            _accessChecked = true;
            if (!_isAuthorized)
            {
                _definitions = [];
                _totalCount = 0;
                _pageCount = 1;
                _error = null;
                return;
            }

            var pageSize = Math.Max(1, UiOptions.Value.DefaultPageSize);
            var result = await Facade.QueryDefinitionsAsync(new JobCatalogQuery
            {
                SearchText = _searchText,
                OwnerId = _ownerId,
                JobType = _jobType,
                IsDisabled = _isDisabled,
                PageNumber = _pageNumber,
                PageSize = pageSize
            }, _lifetime.Token);
            if (result.IsFailed(out var error, out var page))
            {
                _error = error.Message;
                return;
            }

            _definitions = page.Items;
            _totalCount = page.TotalCount;
            _pageCount = Math.Max(1, (int)Math.Ceiling((double)_totalCount / pageSize));
            _error = null;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenPolicyAsync(ActiveJobDefinition definition)
    {
        if (!await RefreshAccessAsync())
        {
            return;
        }

        var parameters = new DialogParameters<JobPolicyDialog> { { dialog => dialog.Definition, definition } };
        var dialog = await DialogService.ShowAsync<JobPolicyDialog>(L["Policy:Title"], parameters, DialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: JobPolicy policy })
        {
            var index = _definitions.FindIndex(item => item.Declaration.JobKey == definition.Declaration.JobKey);
            if (index >= 0)
            {
                _definitions[index] = definition with { Policy = policy };
            }
            Snackbar.Add(L["Policy:Saved"], Severity.Success);
        }
    }

    private async Task OpenTriggerAsync(ActiveJobDefinition definition)
    {
        if (!await RefreshAccessAsync())
        {
            return;
        }

        var parameters = new DialogParameters<JobTriggerDialog> { { dialog => dialog.Definition, definition } };
        var dialog = await DialogService.ShowAsync<JobTriggerDialog>(L["Trigger:Title"], parameters, DialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: JobExecutionInstance execution })
        {
            Snackbar.Add(L["Trigger:Queued", execution.InstanceId], Severity.Success);
        }
    }

    private string GetSchedule(JobDeclaration declaration) => declaration.JobType == JobType.Recurring
        ? $"{declaration.CronExpression} · {declaration.TimeZoneId}"
        : L["Catalog:OnDemand"];

    private static DialogOptions DialogOptions { get; } = new()
    {
        CloseButton = true,
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Small
    };

    private async Task<bool> RefreshAccessAsync()
    {
        _isAuthorized = await Access.IsAuthorizedAsync(_lifetime.Token);
        _accessChecked = true;
        if (!_isAuthorized)
        {
            _definitions = [];
            _error = null;
        }

        return _isAuthorized;
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        _lifetime.Dispose();
    }
}
