@attribute [Route(PAGE_URL)]
@inject JobSchedulerUIService UIService
@inject JobStateColorService ColorService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IMoBrowserStorage BrowserStorage
@inject IStringLocalizer<JobSchedulerResource> L
@using Monica.JobScheduler.UI.Localization

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@L["JobInstances:Title"]</MudText>

    <!-- 筛选器 -->
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              @bind-Value="_filterJobKey"
                              Label="@L["JobInstances:Filters:JobKey"]"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true"
                              OnClearButtonClick="HandleFilterChanged" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              @bind-Value="_filterInstanceId"
                              Label="@L["JobInstances:Filters:InstanceId"]"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true"
                              OnClearButtonClick="HandleFilterChanged" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="JobState?"
                           @bind-Value="_filterState"
                           Label="@L["JobInstances:Filters:State"]"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           OnClearButtonClick="HandleFilterChanged">
                    <MudSelectItem T="JobState?" Value="@((JobState?)null)">@L["JobInstances:Filters:AllStates"]</MudSelectItem>
                    <MudSelectItem T="JobState?" Value="@JobState.Scheduled">Scheduled</MudSelectItem>
                    <MudSelectItem T="JobState?" Value="@JobState.Enqueued">Enqueued</MudSelectItem>
                    <MudSelectItem T="JobState?" Value="@JobState.Processing">Processing</MudSelectItem>
                    <MudSelectItem T="JobState?" Value="@JobState.Succeeded">Succeeded</MudSelectItem>
                    <MudSelectItem T="JobState?" Value="@JobState.Failed">Failed</MudSelectItem>
                    <MudSelectItem T="JobState?" Value="@JobState.Cancelled">Cancelled</MudSelectItem>
                    <MudSelectItem T="JobState?" Value="@JobState.Terminated">Terminated</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           @bind-Value="_timeRangePreset"
                           Label="@L["JobInstances:Filters:TimeRange"]"
                           Variant="Variant.Outlined"
                           OnClearButtonClick="HandleTimeRangePresetChanged">
                    <MudSelectItem T="string" Value="@string.Empty">@L["JobInstances:Filters:Custom"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("last_hour")">@L["JobInstances:Filters:LastHour"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("last_24_hours")">@L["JobInstances:Filters:Last24Hours"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("last_7_days")">@L["JobInstances:Filters:Last7Days"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("last_30_days")">@L["JobInstances:Filters:Last30Days"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="@L["JobInstances:Filters:StartTime"]"
                               Date="_filterStartDate"
                               DateChanged="HandleStartDateChanged"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Disabled="@(!string.IsNullOrEmpty(_timeRangePreset))" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="@L["JobInstances:Filters:EndTime"]"
                               Date="_filterEndDate"
                               DateChanged="HandleEndDateChanged"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Disabled="@(!string.IsNullOrEmpty(_timeRangePreset))" />
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="HandleFilterChanged"
                           StartIcon="@Icons.Material.Filled.Search">
                    @L["Common:Actions:Search"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           OnClick="HandleResetFilters"
                           StartIcon="@Icons.Material.Filled.Clear"
                           Class="ml-2">
                    @L["Common:Actions:Reset"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- 数据表格 with deferred rendering -->
    @if (_stateLoaded)
    {
        <MudTable @ref="_table"
                  T="JobInstance"
                  ServerData="LoadDataAsync"
                  RowsPerPage="@_pageSize"
                  Hover="true"
                  Striped="true"
                  Elevation="2">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@L["JobInstances:TableHeader:InstanceList"]</MudText>
                <MudSpacer />
                <MudTooltip Text="@L["JobInstances:Actions:CleanupHistory"]">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                                   Color="Color.Warning"
                                   OnClick="HandleCleanupHistoryAsync"
                                   Disabled="@_isCleaningUp" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               OnClick="RefreshAsync" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="InstanceId" T="JobInstance">@L["JobInstances:Columns:InstanceId"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="JobKey" T="JobInstance">@L["JobInstances:Columns:JobKey"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="State" T="JobInstance">@L["JobInstances:Columns:State"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="CreatedAt" T="JobInstance" InitialDirection="SortDirection.Descending">@L["JobInstances:Columns:CreatedTime"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="StartedAt" T="JobInstance">@L["JobInstances:Columns:StartTime"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="CompletedAt" T="JobInstance">@L["JobInstances:Columns:EndTime"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Duration" T="JobInstance">@L["JobInstances:Columns:Duration"]</MudTableSortLabel></MudTh>
                <MudTh>@L["JobInstances:Columns:Actions"]</MudTh>
            </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["JobInstances:Columns:InstanceId"]">
                <MudText Typo="Typo.body2" Style="font-family: monospace;">
                    @context.InstanceId.Substring(0, Math.Min(8, context.InstanceId.Length))...
                </MudText>
            </MudTd>
            <MudTd DataLabel="@L["JobInstances:Columns:JobKey"]">@context.JobKey</MudTd>
            <MudTd DataLabel="@L["JobInstances:Columns:State"]">
                <MudChip T="string" Size="Size.Small" Color="@ColorService.GetStateColor(context.State)">
                    @context.State
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["JobInstances:Columns:CreatedTime"]">
                @context.CreatedAt.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")
            </MudTd>
            <MudTd DataLabel="@L["JobInstances:Columns:StartTime"]">
                @(context.StartedAt?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")
            </MudTd>
            <MudTd DataLabel="@L["JobInstances:Columns:EndTime"]">
                @(context.CompletedAt?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")
            </MudTd>
            <MudTd DataLabel="@L["JobInstances:Columns:Duration"]">
                @if (context.StartedAt.HasValue && context.CompletedAt.HasValue)
                {
                    var duration = context.CompletedAt.Value - context.StartedAt.Value;
                    <text>@FormatDuration(duration)</text>
                }
                else if (context.StartedAt.HasValue)
                {
                    var duration = DateTime.UtcNow.FromUtcToLocal() - context.StartedAt.Value.FromUtcToLocal();
                    <text>@FormatDuration(duration) (@L["JobInstances:Messages:Running"])</text>
                }
                else
                {
                    <text>-</text>
                }
            </MudTd>
            <MudTd DataLabel="@L["JobInstances:Columns:Actions"]">
                <MudTooltip Text="@L["JobInstances:Actions:ViewDetails"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Info"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenInstanceDetailDialog(context.InstanceId))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["JobInstances:Messages:NoInstances"]</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressCircular Indeterminate="true" />
        </LoadingContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
            </PagerContent>
        </MudTable>
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="2">
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                <MudProgressCircular Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@L["Common:Status:Loading"]</MudText>
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    public const string PAGE_URL = "/job-scheduler/instances";

    [SupplyParameterFromQuery(Name = "jobKey")]
    public string? InitialJobKey { get; set; }

    [SupplyParameterFromQuery(Name = "state")]
    public string? InitialState { get; set; }

    private MudTable<JobInstance>? _table;

    private string? _filterJobKey;
    private string? _filterInstanceId;
    private JobState? _filterState;
    private DateTime? _filterStartDate;
    private DateTime? _filterEndDate;
    private string _timeRangePreset = string.Empty;

    // Table state persistence
    private string? _sortBy = "CreatedAt";
    private bool _sortDescending = true;
    private int _pageSize = 10;
    private bool _stateLoaded = false;
    private bool _isCleaningUp = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var state = await BrowserStorage.GetTableStateAsync("job-instances");
            if (!string.IsNullOrEmpty(state.SortBy))
            {
                _sortBy = state.SortBy;
                _sortDescending = state.SortDescending;
            }
            _pageSize = state.PageSize;
            _stateLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnInitialized()
    {
        _filterJobKey = InitialJobKey;

        if (!string.IsNullOrEmpty(InitialState))
        {
            var states = InitialState.Split(',');
            if (states.Length > 0 && Enum.TryParse<JobState>(states[0], out var state))
            {
                _filterState = state;
            }
        }
    }

    private async Task<TableData<JobInstance>> LoadDataAsync(TableState state, CancellationToken cancellationToken)
    {
        // Extract sorting from TableState
        string? sortBy = null;
        bool sortDescending = false;

        if (!string.IsNullOrEmpty(state.SortLabel))
        {
            sortBy = MapSortLabelToField(state.SortLabel);
            sortDescending = state.SortDirection == SortDirection.Descending;

            _sortBy = state.SortLabel;
            _sortDescending = sortDescending;
        }

        _pageSize = state.PageSize;
        await SaveTableStateAsync();

        var (startTime, endTime) = GetTimeRange();

        var filter = new JobInstanceFilterRequest
        {
            JobKey = _filterJobKey,
            InstanceId = _filterInstanceId,
            State = _filterState,
            StartTime = startTime,
            EndTime = endTime,
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SortBy = sortBy,
            SortDescending = sortDescending
        };

        var result = await UIService.GetJobInstancesAsync(filter, cancellationToken);

        if (result.IsFailed(out var error, out var data))
        {
            Snackbar.Add($"{L["JobInstances:Messages:LoadFailed"]}: {error.Message}", Severity.Error);
            return new TableData<JobInstance> { Items = Array.Empty<JobInstance>(), TotalItems = 0 };
        }

        // No client-side sorting needed - all sorting is done server-side
        var items = data.Items ?? Array.Empty<JobInstance>();

       

        return new TableData<JobInstance>
        {
            Items = items,
            TotalItems = data.Sum ?? 0
        };
    }

    private (DateTime?, DateTime?) GetTimeRange()
    {
        if (!string.IsNullOrEmpty(_timeRangePreset))
        {
            var now = DateTime.UtcNow;
            return _timeRangePreset switch
            {
                "last_hour" => (now.AddHours(-1), now),
                "last_24_hours" => (now.AddDays(-1), now),
                "last_7_days" => (now.AddDays(-7), now),
                "last_30_days" => (now.AddDays(-30), now),
                _ => (null, null)
            };
        }

        return (_filterStartDate, _filterEndDate);
    }

    private async Task HandleFilterChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task HandleTimeRangePresetChanged()
    {
        if (!string.IsNullOrEmpty(_timeRangePreset))
        {
            _filterStartDate = null;
            _filterEndDate = null;
        }
        await HandleFilterChanged();
    }

    private async Task HandleStartDateChanged(DateTime? newDate)
    {
        _filterStartDate = newDate;
        await HandleFilterChanged();
    }

    private async Task HandleEndDateChanged(DateTime? newDate)
    {
        _filterEndDate = newDate;
        await HandleFilterChanged();
    }

    private void HandleResetFilters()
    {
        _filterJobKey = null;
        _filterInstanceId = null;
        _filterState = null;
        _filterStartDate = null;
        _filterEndDate = null;
        _timeRangePreset = string.Empty;
        _ = HandleFilterChanged();
    }

    private async Task RefreshAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task HandleCleanupHistoryAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["JobInstances:Messages:CleanupConfirmTitle"],
            L["JobInstances:Messages:CleanupConfirm"],
            yesText: L["Common:Actions:Confirm"],
            cancelText: L["Common:Actions:Cancel"]);

        if (confirmed != true)
        {
            return;
        }

        _isCleaningUp = true;
        StateHasChanged();

        try
        {
            var result = await UIService.TriggerHistoryCleanupAsync();

            if (result.IsFailed(out var error, out var data))
            {
                Snackbar.Add($"{L["JobInstances:Messages:CleanupFailed"]}: {error.Message}", Severity.Error);
            }
            else
            {
                if (data.DeletedCount == 0)
                {
                    Snackbar.Add(L["JobInstances:Messages:CleanupNoRecords"], Severity.Info);
                }
                else
                {
                    Snackbar.Add(L["JobInstances:Messages:CleanupSuccess", data.DeletedCount.ToString(), data.DurationSeconds.ToString("F2")], Severity.Success);
                    await RefreshAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["JobInstances:Messages:CleanupFailed"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCleaningUp = false;
            StateHasChanged();
        }
    }

    private async Task OpenInstanceDetailDialog(string instanceId)
    {
        var parameters = new DialogParameters<JobInstanceDetailDialog>
        {
            { x => x.InstanceId, instanceId },
            { x => x.ShowJobDefinitionButton, true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false,
            Position = DialogPosition.Center
        };

        await DialogService.ShowAsync<JobInstanceDetailDialog>(L["Dialogs:JobInstanceDetail:Title"], parameters, options);
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return $"{duration.TotalHours:F2}h";
        if (duration.TotalMinutes >= 1)
            return $"{duration.TotalMinutes:F2}m";
        if (duration.TotalSeconds >= 1)
            return $"{duration.TotalSeconds:F2}s";
        return $"{duration.TotalMilliseconds:F0}ms";
    }

    private static string? MapSortLabelToField(string sortLabel)
    {
        return sortLabel switch
        {
            "InstanceId" => "InstanceId",
            "JobKey" => "JobKey",
            "State" => "State",
            "CreatedAt" => "CreatedAt",
            "StartedAt" => "StartedAt",
            "CompletedAt" => "CompletedAt",
            "Duration" => "Duration",
            _ => null
        };
    }

    private async Task SaveTableStateAsync()
    {
        await BrowserStorage.SaveTableStateAsync("job-instances", new TablePersistenceState(
            SortBy: _sortBy,
            SortDescending: _sortDescending,
            PageSize: _pageSize
        ));
    }
}
