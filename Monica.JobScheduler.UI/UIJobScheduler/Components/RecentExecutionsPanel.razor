@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L
@inject TimeProvider TimeProvider

<section class="recent-panel">
    <header class="recent-panel__heading">
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h2">@L["Overview:Recent:Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Overview:Recent:Description"]</MudText>
        </div>
        <MudTooltip Text="@L["Common:Refresh"]">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary"
                           Disabled="@IsRefreshing"
                           OnClick="OnRefresh"
                           aria-label="@L["Common:Refresh"]" />
        </MudTooltip>
    </header>

    <div class="recent-panel__table-scroll">
        <MudTable T="JobExecutionInstance"
                  Items="@Executions"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.None"
                  Elevation="0">
            <HeaderContent>
                <MudTh>@L["Overview:Recent:Job"]</MudTh>
                <MudTh>@L["Overview:Recent:State"]</MudTh>
                <MudTh>@L["Overview:Recent:Created"]</MudTh>
                <MudTh>@L["Overview:Recent:Duration"]</MudTh>
                <MudTh Class="recent-panel__action-cell">@L["Catalog:Columns:Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Overview:Recent:Job"]">
                    <MudTooltip Text="@context.Template.Revision.JobKey">
                        <span class="recent-panel__job">@context.Template.Revision.JobKey</span>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="@L["Overview:Recent:State"]">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@JobSchedulerUiPresentation.GetStateColor(context.State)">
                        @L[$"ExecutionStates:{context.State}"]
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@L["Overview:Recent:Created"]">
                    <span class="recent-panel__time">@context.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                </MudTd>
                <MudTd DataLabel="@L["Overview:Recent:Duration"]">
                    @JobSchedulerUiPresentation.FormatExecutionDuration(context, TimeProvider.GetUtcNow(), L)
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Actions"]" Class="recent-panel__action-cell">
                    <MudTooltip Text="@L["Executions:Actions:Details"]">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                       Href="@GetExecutionHref(context.InstanceId)"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       aria-label="@L["Executions:Actions:Details"]" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4" Color="Color.Secondary">@L["Overview:Recent:Empty"]</MudText>
            </NoRecordsContent>
        </MudTable>
    </div>
</section>

@code {
    /// <summary>
    /// Gets the bounded newest-first execution summaries.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<JobExecutionInstance> Executions { get; set; } = [];

    /// <summary>
    /// Gets whether the owning overview is refreshing.
    /// </summary>
    [Parameter]
    public bool IsRefreshing { get; set; }

    /// <summary>
    /// Gets the refresh callback.
    /// </summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private static string GetExecutionHref(string instanceId) =>
        $"/job-scheduler/executions?instanceId={Uri.EscapeDataString(instanceId)}";
}
