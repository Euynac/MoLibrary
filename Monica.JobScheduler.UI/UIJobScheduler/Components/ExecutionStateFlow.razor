@using System.Globalization
@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

@{
    var total = States.Sum(state => Counts.GetValueOrDefault(state));
    var offset = 0d;
}

<section class="execution-flow" aria-labelledby="execution-flow-title">
    <header class="execution-flow__heading">
        <div>
            <MudText id="execution-flow-title" Typo="Typo.h6" HtmlTag="h2">@L["Overview:Queue:Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Overview:Queue:Description"]</MudText>
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@total</MudChip>
    </header>

    <div class="execution-flow__body">
        <div class="execution-flow__chart-column">
            <div class="execution-flow__chart"
                 role="group"
                 aria-label="@L["Overview:Queue:AriaLabel"]"
                 aria-describedby="execution-flow-hover-hint">
                <svg viewBox="0 0 100 100" focusable="false">
                    <circle class="execution-flow__track" cx="50" cy="50" r="38" pathLength="100" />
                    @if (total > 0)
                    {
                        @foreach (var state in States)
                        {
                            var count = Counts.GetValueOrDefault(state);
                            var length = count * 100d / total;
                            if (length > 0)
                            {
                                <circle class="@GetSegmentClass(state)"
                                        cx="50"
                                        cy="50"
                                        r="38"
                                        pathLength="100"
                                        stroke-dasharray="@FormatSegment(length)"
                                        stroke-dashoffset="@FormatOffset(offset)"
                                        tabindex="0"
                                        role="img"
                                        aria-label="@GetSegmentTooltip(state, count, total)"
                                        @onmouseenter="@(() => SetActiveState(state))"
                                        @onmouseleave="ClearActiveState"
                                        @onfocus="@(() => SetActiveState(state))"
                                        @onblur="ClearActiveState">
                                    <title>@GetSegmentTooltip(state, count, total)</title>
                                </circle>
                                offset += length;
                            }
                        }
                    }
                </svg>
                @if (_activeState is { } activeState)
                {
                    var activeCount = Counts.GetValueOrDefault(activeState);
                    <div class="execution-flow__total execution-flow__total--detail"
                         data-state="@activeState.ToString().ToLowerInvariant()"
                         aria-live="polite">
                        <span class="execution-flow__total-state">
                            <span class="execution-flow__state-dot" aria-hidden="true"></span>
                            @L[$"ExecutionStates:{activeState}"]
                        </span>
                        <strong>@activeCount</strong>
                        <span class="execution-flow__total-share">@FormatShare(activeCount, total)</span>
                    </div>
                }
                else
                {
                    <div class="execution-flow__total">
                        <strong>@total</strong>
                        <span>@L["Overview:Queue:Total"]</span>
                    </div>
                }
            </div>
            <p id="execution-flow-hover-hint" class="execution-flow__hint">
                @L["Overview:Queue:HoverHint"]
            </p>
        </div>

        <div class="execution-flow__legend">
            @foreach (var state in States)
            {
                var count = Counts.GetValueOrDefault(state);
                <a class="@GetLegendClass(state)"
                   data-state="@state.ToString().ToLowerInvariant()"
                   href="@GetExecutionHref(state)"
                   @onmouseenter="@(() => SetActiveState(state))"
                   @onmouseleave="ClearActiveState"
                   @onfocus="@(() => SetActiveState(state))"
                   @onblur="ClearActiveState">
                    <span class="execution-flow__state-dot" aria-hidden="true"></span>
                    <span>@L[$"ExecutionStates:{state}"]</span>
                    <strong>@count</strong>
                    <em>@FormatShare(count, total)</em>
                </a>
            }
        </div>
    </div>
</section>

@code {
    private static readonly JobExecutionState[] States = Enum.GetValues<JobExecutionState>();

    /// <summary>
    /// Gets the current durable execution counts by state.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<JobExecutionState, int> Counts { get; set; } =
        new Dictionary<JobExecutionState, int>();

    private JobExecutionState? _activeState;

    private static string GetExecutionHref(JobExecutionState state) =>
        $"/job-scheduler/executions?states={Uri.EscapeDataString(state.ToString())}";

    private static string FormatShare(int count, int total) => total == 0
        ? "—"
        // The custom "0%" pattern keeps the percent sign glued to the digits in every
        // culture; the standard "P0" pattern inserts a locale gap under invariant culture.
        : (count / (double)total).ToString("0%", CultureInfo.InvariantCulture);

    private string GetSegmentTooltip(JobExecutionState state, int count, int total) => L[
        "Overview:Queue:SegmentTooltip",
        L[$"ExecutionStates:{state}"],
        count,
        FormatShare(count, total)];

    private string GetSegmentClass(JobExecutionState state)
    {
        var stateClass = $"execution-flow__segment execution-flow__segment--{state.ToString().ToLowerInvariant()}";
        return _activeState is null
            ? stateClass
            : $"{stateClass} {(_activeState == state
                ? "execution-flow__segment--active"
                : "execution-flow__segment--dimmed")}";
    }

    private string GetLegendClass(JobExecutionState state) =>
        _activeState == state
            ? "execution-flow__state execution-flow__state--active"
            : "execution-flow__state";

    private void SetActiveState(JobExecutionState state) => _activeState = state;

    private void ClearActiveState() => _activeState = null;

    private static string FormatSegment(double length)
        => $"{length.ToString("0.###", CultureInfo.InvariantCulture)} {(100 - length).ToString("0.###", CultureInfo.InvariantCulture)}";

    private static string FormatOffset(double offset) => offset == 0
        ? "0"
        : (-offset).ToString("0.###", CultureInfo.InvariantCulture);
}
