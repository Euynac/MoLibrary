@using System.Globalization
@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

@{
    var presentDefinitions = Overview.Definitions.Where(static definition => definition.IsPresent).ToArray();
    var recurringCount = presentDefinitions.Count(static definition => definition.Declaration.JobType == JobType.Recurring);
    var triggeredCount = presentDefinitions.Length - recurringCount;
    var runningCount = Overview.ExecutionStateCounts.GetValueOrDefault(JobExecutionState.Running);
    var disabledCount = presentDefinitions.Count(static definition => definition.IsDisabled);
    var succeededCount = Overview.ExecutionStateCounts.GetValueOrDefault(JobExecutionState.Succeeded);
    var failedCount = Overview.ExecutionStateCounts.GetValueOrDefault(JobExecutionState.Failed);
    var completedCount = succeededCount + failedCount;
}

<section class="workload-summary" aria-label="@L["Overview:Workload:AriaLabel"]">
    <article class="workload-summary__metric" data-tone="primary">
        <span class="workload-summary__icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Workspaces" Size="Size.Small" />
        </span>
        <div>
            <span>@L["Overview:Workload:TotalJobs"]</span>
            <strong>@presentDefinitions.Length</strong>
            <small>@L["Overview:Workload:TypeBreakdown", recurringCount, triggeredCount]</small>
        </div>
    </article>
    <article class="workload-summary__metric" data-tone="info">
        <span class="workload-summary__icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" />
        </span>
        <div>
            <span>@L["Overview:Workload:RunningJobs"]</span>
            <strong>@runningCount</strong>
            <small>@L["Overview:Workload:DisabledCount", disabledCount]</small>
        </div>
    </article>
    <article class="workload-summary__metric" data-tone="success">
        <span class="workload-summary__icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
        </span>
        <div>
            <span>@L["Overview:Workload:SuccessRate"]</span>
            <strong>@FormatSuccessRate(succeededCount, completedCount)</strong>
            <small>@L["Overview:Workload:CompletedSample", completedCount]</small>
        </div>
    </article>
    <article class="workload-summary__metric" data-tone="warning">
        <span class="workload-summary__icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" />
        </span>
        <div>
            <span>@L["Overview:Workload:Throughput"]</span>
            <strong>@FormatThroughput(Overview.ExecutionsPerHourLast24h)</strong>
            <small>@L["Overview:Workload:ThroughputDescription"]</small>
        </div>
    </article>
</section>

@code {
    /// <summary>
    /// Gets the current bounded scheduler workload snapshot.
    /// </summary>
    [Parameter, EditorRequired]
    public JobSchedulerOverview Overview { get; set; } = null!;

    private static string FormatSuccessRate(int succeededCount, int completedCount) => completedCount == 0
        ? "—"
        : (succeededCount / (double)completedCount).ToString("P1", CultureInfo.CurrentCulture);

    private static string FormatThroughput(double executionsPerHour) =>
        executionsPerHour.ToString("0.#", CultureInfo.CurrentCulture);
}
