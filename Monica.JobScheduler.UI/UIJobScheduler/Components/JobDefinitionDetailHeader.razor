@using Monica.JobScheduler.Models
@using Monica.JobScheduler.Models.Catalog
@using Monica.JobScheduler.Models.Operations
@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

<header class="job-detail-header">
    <div class="job-detail-header__main">
        <div class="job-detail-header__identity">
            <div class="job-detail-header__chips">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                    @L[$"JobTypes:{Definition.Declaration.JobType}"]
                </MudChip>
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="@(Definition.IsDisabled ? Color.Warning : Color.Success)">
                    @(Definition.IsDisabled ? L["Catalog:Disabled"] : L["Catalog:Enabled"])
                </MudChip>
                @if (!Summary.HasCompatibleWorker)
                {
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Color="Color.Error"
                             Icon="@Icons.Material.Filled.PortableWifiOff">
                        @L["JobDetail:Header:NoCompatibleWorker"]
                    </MudChip>
                }
            </div>

            <MudText Typo="Typo.h5" HtmlTag="h2">@Definition.Declaration.JobName</MudText>
            @if (!string.IsNullOrWhiteSpace(Definition.Declaration.Description))
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="job-detail-header__description">
                    @Definition.Declaration.Description
                </MudText>
            }
            <code title="@Definition.Declaration.JobKey">@Definition.Declaration.JobKey</code>
        </div>

        <div class="job-detail-header__actions">
            @if (Definition.Declaration.JobType == JobType.Triggered)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@(Definition.IsDisabled || IsMutating)"
                           OnClick="OnTrigger">
                    @L["Catalog:Actions:Trigger"]
                </MudButton>
            }
            @if (Definition.Declaration.JobType == JobType.Recurring)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="@(Definition.IsDisabled ? Color.Success : Color.Warning)"
                           StartIcon="@(Definition.IsDisabled ? Icons.Material.Filled.PlayCircle : Icons.Material.Filled.PauseCircle)"
                           Disabled="@IsMutating"
                           OnClick="OnToggleDisabled">
                    @(Definition.IsDisabled ? L["Catalog:Actions:Resume"] : L["Catalog:Actions:Pause"])
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.EventRepeat"
                           OnClick="OnInspectSchedule">
                    @L["JobDetail:Actions:InspectSchedule"]
                </MudButton>
            }
            <MudTooltip Text="@L["Catalog:Actions:Policy"]">
                <MudIconButton Icon="@Icons.Material.Filled.Tune"
                               Variant="Variant.Outlined"
                               Disabled="@IsMutating"
                               OnClick="OnEditPolicy"
                               aria-label="@L["Catalog:Actions:Policy"]" />
            </MudTooltip>
            <MudTooltip Text="@L["Common:Refresh"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Variant="Variant.Outlined"
                               Disabled="@IsRefreshing"
                               OnClick="OnRefresh"
                               aria-label="@L["Common:Refresh"]" />
            </MudTooltip>
        </div>
    </div>

    <dl class="job-detail-header__evidence" aria-label="@L["JobDetail:Header:EvidenceAriaLabel"]">
        <div class="@GetWorkerMetricClass()">
            <dt>@L["JobDetail:Header:CompatibleWorkers"]</dt>
            <dd>@Summary.CompatibleWorkerCount</dd>
        </div>
        <div>
            <dt>@L["JobDetail:Header:ActiveExecutions"]</dt>
            <dd>@Summary.ActiveExecutionCount</dd>
        </div>
        <div>
            <dt>@L["JobDetail:Header:QueuedExecutions"]</dt>
            <dd>@Summary.QueuedExecutionCount</dd>
        </div>
        <div>
            <dt>@L["JobDetail:Header:RunningExecutions"]</dt>
            <dd>@Summary.RunningExecutionCount</dd>
        </div>
    </dl>
</header>

@code {
    /// <summary>
    /// Gets the operational snapshot rendered by this header.
    /// </summary>
    [Parameter, EditorRequired]
    public JobOperationalSummary Summary { get; set; } = null!;

    /// <summary>
    /// Gets whether the owning detail page is refreshing.
    /// </summary>
    [Parameter]
    public bool IsRefreshing { get; set; }

    /// <summary>
    /// Gets whether an operator mutation is being persisted.
    /// </summary>
    [Parameter]
    public bool IsMutating { get; set; }

    /// <summary>
    /// Gets the callback that refreshes the owning operational snapshot.
    /// </summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    /// <summary>
    /// Gets the callback that opens the recurring schedule inspector.
    /// </summary>
    [Parameter]
    public EventCallback OnInspectSchedule { get; set; }

    /// <summary>
    /// Gets the callback that opens the operator policy editor.
    /// </summary>
    [Parameter]
    public EventCallback OnEditPolicy { get; set; }

    /// <summary>
    /// Gets the callback that toggles recurring materialization.
    /// </summary>
    [Parameter]
    public EventCallback OnToggleDisabled { get; set; }

    /// <summary>
    /// Gets the callback that opens triggered execution admission.
    /// </summary>
    [Parameter]
    public EventCallback OnTrigger { get; set; }

    private ActiveJobDefinition Definition => Summary.Definition;

    private string GetWorkerMetricClass() => Summary.HasCompatibleWorker
        ? "job-detail-header__metric"
        : "job-detail-header__metric job-detail-header__metric--attention";
}
