@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

@{
    var version = Overview.CatalogPublication.Version;
    var tone = Overview.IsConverged ? "success" : version.IsTransitionInProgress ? "warning" : "info";
}

<section class="release-band" data-tone="@tone" aria-label="@L["Overview:Release:AriaLabel"]">
    <div class="release-band__headline">
        <div class="release-band__identity">
            <MudText Typo="Typo.overline" Color="Color.Secondary">@L["Overview:Release:Desired"]</MudText>
            <MudTooltip Text="@(version.DesiredReleaseId ?? L["Common:NotAvailable"])" Placement="Placement.Bottom">
                <MudText Typo="Typo.h5" HtmlTag="h2" Class="release-band__release-id">
                    @(version.DesiredReleaseId ?? "—")
                </MudText>
            </MudTooltip>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["Overview:Release:ReadinessDescription"]
            </MudText>
        </div>
        <MudChip T="string"
                 Color="@GetConvergenceColor()"
                 Variant="Variant.Filled"
                 Icon="@GetConvergenceIcon()">
            @GetConvergenceText()
        </MudChip>
    </div>

    <div class="release-band__seam" aria-label="@L["Overview:Release:EpochAriaLabel"]">
        <div>
            <span>@L["Overview:Release:Active"]</span>
            <MudTooltip Text="@(version.ActiveReleaseId ?? L["Common:NotAvailable"])" Placement="Placement.Bottom">
                <strong class="release-band__mono">@(version.ActiveReleaseId ?? "—")</strong>
            </MudTooltip>
        </div>
        <div>
            <span>@L["Overview:Release:Generation"]</span>
            <strong>@version.LastSeenDeploymentGeneration</strong>
        </div>
        <div>
            <span>@L["Overview:Release:Intent"]</span>
            <strong>@version.ActiveIntentEpoch <small>/ @version.DesiredIntentEpoch</small></strong>
        </div>
        <div>
            <span>@L["Overview:Release:Activation"]</span>
            <strong>@version.ActivationEpoch</strong>
        </div>
        <div>
            <span>@L["Overview:Release:Change"]</span>
            <strong>@version.ChangeEpoch</strong>
        </div>
        <div>
            <span>@L["Overview:Release:Publication"]</span>
            <strong>@version.PublicationEpoch</strong>
        </div>
    </div>

    @if (version.IsTransitionInProgress)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Icon="@Icons.Material.Filled.SyncLock">
            @L["Overview:Release:TransitionMessage"]
        </MudAlert>
    }
</section>

@code {
    /// <summary>
    /// Gets the bounded scheduler overview to present.
    /// </summary>
    [Parameter, EditorRequired]
    public JobSchedulerOverview Overview { get; set; } = null!;

    private string GetConvergenceText() => Overview.IsConverged
        ? L["Overview:Release:Converged"]
        : Overview.CatalogPublication.Version.IsTransitionInProgress
            ? L["Overview:Release:Transitioning"]
            : L["Overview:Release:WaitingWorkers"];

    private Color GetConvergenceColor() => Overview.IsConverged
        ? Color.Success
        : Overview.CatalogPublication.Version.IsTransitionInProgress
            ? Color.Warning
            : Color.Info;

    private string GetConvergenceIcon() => Overview.IsConverged
        ? Icons.Material.Filled.Verified
        : Overview.CatalogPublication.Version.IsTransitionInProgress
            ? Icons.Material.Filled.Sync
            : Icons.Material.Filled.HourglassTop;
}
