@using System.Globalization
@using Cronos
@using Monica.JobScheduler.Models.Catalog
@using Monica.JobScheduler.Models.Operations
@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.Utils

@inject IStringLocalizer<JobSchedulerResource> L
@inject TimeProvider TimeProvider
@inject SchedulerTimePresentation TimePresentation

<MudDialog>
    <TitleContent>
        <div class="cron-inspector__title">
            <MudIcon Icon="@Icons.Material.Filled.EventRepeat" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6" HtmlTag="h2">@L["CronInspector:Title"]</MudText>
                <code title="@Definition.Declaration.JobKey">
                    @Definition.Declaration.JobKey
                </code>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="cron-inspector">
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined"
                      Dense="true"
                      Icon="@Icons.Material.Filled.Lock">
                @L["CronInspector:ImmutableNotice"]
            </MudAlert>

            <section class="cron-inspector__expression" aria-labelledby="cron-expression-heading">
                <div class="cron-inspector__section-heading">
                    <div>
                        <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="cron-expression-heading">
                            @L["CronInspector:Expression:Title"]
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["CronInspector:Expression:Description"]
                        </MudText>
                    </div>
                    @if (OperationalSummary is { } operationalSummary)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Color="@JobSchedulerUiPresentation.GetRecurringScheduleStatusColor(operationalSummary.RecurringScheduleStatus)">
                            @L[$"RecurringScheduleStatuses:{operationalSummary.RecurringScheduleStatus}"]
                        </MudChip>
                    }
                </div>

                <MudTextField T="string"
                              Value="@_draftCronExpression"
                              ValueChanged="SetCronExpression"
                              Label="@L["CronInspector:Expression:Draft"]"
                              HelperText="@L["CronInspector:Expression:DraftHelp"]"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="cron-inspector__cron-input" />

                <div class="cron-inspector__fields" aria-label="@L["CronInspector:Fields:AriaLabel"]">
                    @foreach (var field in _cronFields)
                    {
                        <div class="cron-inspector__field">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@field.Label</MudText>
                            <code>@field.Value</code>
                        </div>
                    }
                </div>
            </section>

            <div class="cron-inspector__facts">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CronInspector:TimeZone"]</MudText>
                    <MudTextField T="string"
                                  Value="@_draftTimeZoneId"
                                  ValueChanged="SetTimeZoneId"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  aria-label="@L["CronInspector:TimeZone"]" />
                </div>
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CronInspector:StartBoundary"]</MudText>
                    <strong>@TimePresentation.FormatTimestamp(Declaration.StartTimeUtc)</strong>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CronInspector:EndBoundary"]</MudText>
                    <strong>@TimePresentation.FormatTimestamp(Declaration.EndTimeUtc)</strong>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CronInspector:OperationalNext"]</MudText>
                    <strong>@TimePresentation.FormatTimestamp(OperationalSummary?.NextOccurrenceUtc)</strong>
                </div>
            </div>

            <section class="cron-inspector__preview" aria-labelledby="cron-preview-heading">
                <div class="cron-inspector__section-heading">
                    <div>
                        <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="cron-preview-heading">
                            @L["CronInspector:Preview:Title"]
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["CronInspector:Preview:Description", TimePresentation.FormatTimestamp(_previewReferenceUtc)]
                        </MudText>
                    </div>
                </div>

                @if (_previewUnavailable)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        @L["CronInspector:Preview:Unavailable"]
                    </MudAlert>
                }
                else if (_preview.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        @L["CronInspector:Preview:Empty"]
                    </MudAlert>
                }
                else
                {
                    <div class="cron-inspector__preview-scroll">
                        <table aria-label="@L["CronInspector:Preview:AriaLabel"]">
                            <thead>
                                <tr>
                                    <th scope="col">@L["CronInspector:Preview:Sequence"]</th>
                                    <th scope="col">@L["CronInspector:Preview:ScheduleTime"]</th>
                                    <th scope="col">@L["CronInspector:Preview:SchedulerTime"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var index = 0; index < _preview.Count; index++)
                                {
                                    var occurrence = _preview[index];
                                    <tr>
                                        <td><span class="cron-inspector__sequence">@(index + 1)</span></td>
                                        <td><code>@FormatScheduleTime(occurrence)</code></td>
                                        <td><code>@TimePresentation.FormatTimestamp(occurrence)</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="ResetDraft">
            @L["CronInspector:ResetDraft"]
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">
            @L["Common:Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int PREVIEW_COUNT = 5;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// Gets the immutable active definition to inspect.
    /// </summary>
    [Parameter, EditorRequired]
    public ActiveJobDefinition Definition { get; set; } = null!;

    /// <summary>
    /// Gets the optional authoritative runtime projection when the caller already owns one.
    /// </summary>
    [Parameter]
    public JobOperationalSummary? OperationalSummary { get; set; }

    /// <summary>
    /// Gets the UTC instant from which declaration occurrences are previewed.
    /// </summary>
    [Parameter]
    public DateTimeOffset? ObservedAtUtc { get; set; }

    private IReadOnlyList<CronField> _cronFields = [];
    private IReadOnlyList<DateTimeOffset> _preview = [];
    private TimeZoneInfo? _timeZone;
    private string? _draftCronExpression;
    private string? _draftTimeZoneId;
    private string? _initializedJobRevisionId;
    private DateTimeOffset _previewReferenceUtc;
    private bool _previewUnavailable;

    private JobDeclaration Declaration => Definition.Declaration;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_initializedJobRevisionId, Definition.JobRevisionId, StringComparison.Ordinal))
        {
            _initializedJobRevisionId = Definition.JobRevisionId;
            _draftCronExpression = Declaration.CronExpression;
            _draftTimeZoneId = Declaration.TimeZoneId;
        }

        RebuildPreview();
    }

    private void RebuildPreview()
    {
        _previewReferenceUtc = ObservedAtUtc ?? TimeProvider.GetUtcNow();
        _cronFields = ParseFields(_draftCronExpression);
        (_preview, _timeZone, _previewUnavailable) = BuildPreview(
            _draftCronExpression,
            _draftTimeZoneId,
            Declaration.StartTimeUtc,
            Declaration.EndTimeUtc,
            _previewReferenceUtc);
    }

    private IReadOnlyList<CronField> ParseFields(string? cronExpression)
    {
        var values = cronExpression?.Split(' ', StringSplitOptions.RemoveEmptyEntries) ?? [];
        var labels = values.Length == 6
            ? new[]
            {
                L["CronInspector:Fields:Second"].Value,
                L["CronInspector:Fields:Minute"].Value,
                L["CronInspector:Fields:Hour"].Value,
                L["CronInspector:Fields:Day"].Value,
                L["CronInspector:Fields:Month"].Value,
                L["CronInspector:Fields:Weekday"].Value
            }
            : new[]
            {
                L["CronInspector:Fields:Minute"].Value,
                L["CronInspector:Fields:Hour"].Value,
                L["CronInspector:Fields:Day"].Value,
                L["CronInspector:Fields:Month"].Value,
                L["CronInspector:Fields:Weekday"].Value
            };

        return values.Length == labels.Length
            ? values.Select((value, index) => new CronField(labels[index], value)).ToArray()
            : [];
    }

    private static (IReadOnlyList<DateTimeOffset> Occurrences, TimeZoneInfo? TimeZone, bool IsUnavailable)
        BuildPreview(
            string? cronExpression,
            string? timeZoneId,
            DateTimeOffset? startTimeUtc,
            DateTimeOffset? endTimeUtc,
            DateTimeOffset observedAtUtc)
    {
        if (string.IsNullOrWhiteSpace(cronExpression)
            || string.IsNullOrWhiteSpace(timeZoneId))
        {
            return ([], null, true);
        }

        try
        {
            var timeZone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId!);
            var cron = CronHelper.Parse(cronExpression!);
            var searchFrom = observedAtUtc.ToUniversalTime();
            if (startTimeUtc is { } startBoundary && searchFrom < startBoundary)
            {
                searchFrom = startBoundary.AddTicks(-1);
            }

            var occurrences = new List<DateTimeOffset>(PREVIEW_COUNT);
            while (occurrences.Count < PREVIEW_COUNT)
            {
                var occurrence = cron.GetNextOccurrence(searchFrom, timeZone);
                if (occurrence is null)
                {
                    break;
                }

                var occurrenceUtc = occurrence.Value.ToUniversalTime();
                if (endTimeUtc is { } endBoundary && occurrenceUtc > endBoundary)
                {
                    break;
                }

                occurrences.Add(occurrenceUtc);
                searchFrom = occurrenceUtc;
            }

            return (occurrences, timeZone, false);
        }
        catch (Exception exception) when (exception is CronFormatException
                                          or ArgumentException
                                          or TimeZoneNotFoundException
                                          or InvalidTimeZoneException)
        {
            return ([], null, true);
        }
    }

    private string FormatScheduleTime(DateTimeOffset value) => _timeZone is null
        ? TimePresentation.FormatTimestamp(value)
        : TimeZoneInfo.ConvertTime(value, _timeZone)
            .ToString("yyyy-MM-dd HH:mm:ss.fff", CultureInfo.CurrentCulture);

    private void SetCronExpression(string? value)
    {
        _draftCronExpression = value;
        RebuildPreview();
    }

    private void SetTimeZoneId(string? value)
    {
        _draftTimeZoneId = value;
        RebuildPreview();
    }

    private void ResetDraft()
    {
        _draftCronExpression = Declaration.CronExpression;
        _draftTimeZoneId = Declaration.TimeZoneId;
        RebuildPreview();
    }

    private void Close() => MudDialog.Close();

    private sealed record CronField(string Label, string Value);
}
