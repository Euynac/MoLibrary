@using Monica.JobScheduler.UI.Localization

<section class="catalog-table" aria-labelledby="catalog-table-title">
    <header class="catalog-table__heading">
        <div>
            <MudText id="catalog-table-title" Typo="Typo.h6" HtmlTag="h2">@L["Catalog:Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Catalog:Count", TotalCount]</MudText>
        </div>
        <div class="catalog-table__heading-actions">
            @if (_visibleSummaries.Any(IsRecurring))
            {
                <MudCheckBox T="bool"
                             Value="@AreAllRecurringSelected"
                             ValueChanged="AllRecurringSelectionChanged"
                             Dense="true"
                             Color="Color.Primary"
                             Label="@L["Catalog:Selection:SelectPage"]"
                             aria-label="@L["Catalog:Selection:SelectAll"]" />
            }
            <MudTooltip Text="@L["Common:Refresh"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               OnClick="ReloadAsync"
                               aria-label="@L["Common:Refresh"]" />
            </MudTooltip>
        </div>
    </header>

    <div class="catalog-table__scroll">
        <MudTable @ref="_table"
                  T="JobOperationalSummary"
                  ServerData="LoadServerDataAsync"
                  RowsPerPage="@PageSize"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.None"
                  HorizontalScrollbar="true"
                  Elevation="0"
                  AllowUnsorted="false">
            <HeaderContent>
                <MudTh Class="catalog-table__selection-heading">
                    <span class="visually-hidden">@L["Catalog:Selection:SelectAll"]</span>
                </MudTh>
                <MudTh Class="catalog-table__definition-heading">
                    <MudTableSortLabel T="JobOperationalSummary"
                                       SortLabel="@nameof(JobDefinitionSortField.JobName)"
                                       InitialDirection="SortDirection.Ascending">
                        @L["Catalog:Columns:Definition"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="JobOperationalSummary"
                                       SortLabel="@nameof(JobDefinitionSortField.OwnerKey)">
                        @L["Catalog:Filters:Owner"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>@L["Catalog:Columns:Lifecycle"]</MudTh>
                <MudTh>@L["Catalog:Columns:Schedule"]</MudTh>
                <MudTh>@L["Catalog:Columns:NextRun"]</MudTh>
                <MudTh>@L["Catalog:Columns:LastRun"]</MudTh>
                <MudTh Class="catalog-table__actions-heading">@L["Catalog:Columns:Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var definition = context.Definition;
                    var declaration = definition.Declaration;
                    var effective = definition.EffectiveConfiguration;
                }
                <MudTd DataLabel="@L["Catalog:Selection:SelectAll"]">
                    <div class="catalog-table__selection" @onclick:stopPropagation="true">
                        @if (IsRecurring(context))
                        {
                            <MudCheckBox T="bool"
                                         Value="@SelectedJobIds.Contains(definition.Id)"
                                         ValueChanged="@(_ => SelectionToggled.InvokeAsync(context))"
                                         Dense="true"
                                         Color="Color.Primary"
                                         aria-label="@L["Catalog:Selection:SelectJob", effective.JobName]" />
                        }
                        else
                        {
                            <span class="catalog-table__type-icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                            </span>
                        }
                    </div>
                </MudTd>
                <MudTd Class="catalog-table__definition-cell" DataLabel="@L["Catalog:Columns:Definition"]">
                    <div class="catalog-table__identity" title="@declaration.JobKey">
                        <strong>@effective.JobName</strong>
                        @if (!string.IsNullOrWhiteSpace(effective.Description))
                        {
                            <span>@effective.Description</span>
                        }
                        <code>@declaration.JobKey</code>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Filters:Owner"]">
                    <div class="catalog-table__owner" title="@definition.OwnerKey">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                        <span>@definition.OwnerKey</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Lifecycle"]">
                    <MudTooltip Text="@GetLifecycleDescription(context)" Placement="Placement.Top" Arrow="true">
                        <MudChip T="string"
                                 Label="true"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Icon="@GetLifecycleIcon(context)"
                                 Color="@GetLifecycleColor(context)">
                            @GetLifecycleLabel(context)
                        </MudChip>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Schedule"]">
                    @if (IsRecurring(context))
                    {
                        <div class="catalog-table__schedule">
                            <span class="catalog-table__cron">
                                <CronDescriptionBadge Expression="@effective.Schedule!.CronExpression"
                                                      Description="@GetCronDescription(context)" />
                            </span>
                            <span class="catalog-table__timezone"
                                  title="@L["Catalog:Cron:ConfiguredTimeZone"]"
                                  aria-label="@L["Catalog:Cron:ConfiguredTimeZone"]">
                                <MudIcon Icon="@Icons.Material.Filled.LockClock" Size="Size.Small" />
                                <code>@effective.Schedule.TimeZoneId</code>
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="catalog-table__schedule">
                            <span class="catalog-table__on-demand">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                                @L["Catalog:OnDemand"]
                            </span>
                            <strong>@L["Catalog:Triggered:Ready"]</strong>
                            <small>@(declaration.JobArgsKey ?? L["Catalog:Triggered:NoArguments"])</small>
                        </div>
                    }
                </MudTd>
                <MudTd Class="catalog-table__next-run-cell" DataLabel="@L["Catalog:Columns:NextRun"]">
                    @if (context.RecurringScheduleStatus == JobRecurringScheduleStatus.Scheduled
                         && context.NextOccurrenceUtc is { } nextOccurrenceUtc)
                    {
                        <MudTooltip Text="@GetNextRunTooltip(nextOccurrenceUtc)" Placement="Placement.Top" Arrow="true">
                            <time class="catalog-table__next-run"
                                  datetime="@nextOccurrenceUtc.ToString("O")">
                                @TimePresentation.FormatTimestamp(nextOccurrenceUtc)
                            </time>
                        </MudTooltip>
                    }
                    else
                    {
                        <span class="catalog-table__next-run-status">@GetNextRunStatusLabel(context)</span>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:LastRun"]">
                    @if (context.LatestExecution is { } latest)
                    {
                        <div class="catalog-table__latest">
                            <span class="catalog-table__latest-state" data-state="@latest.State.ToString().ToLowerInvariant()">
                                <MudIcon Icon="@GetStateIcon(latest.State)" Size="Size.Small" />
                                @L[$"ExecutionStates:{latest.State}"]
                            </span>
                            <strong>@TimePresentation.FormatTimestamp(latest.CreatedAtUtc)</strong>
                            <small>@TimePresentation.FormatExecutionDuration(latest, TimeProvider.GetUtcNow())</small>
                        </div>
                    }
                    else
                    {
                        <span class="catalog-table__never-run">@L["Catalog:History:NeverRun"]</span>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Actions"]">
                    <div class="catalog-table__actions" @onclick:stopPropagation="true">
                        @if (IsRecurring(context))
                        {
                            <MudTooltip Text="@GetToggleDisabledTooltip(context)">
                                <MudIconButton Icon="@(IsOperatorPaused(context) ? Icons.Material.Filled.PlayCircleOutline : Icons.Material.Filled.PauseCircleOutline)"
                                               Color="@(IsOperatorPaused(context) ? Color.Success : Color.Warning)"
                                               Size="Size.Small"
                                               Disabled="@IsMutating"
                                               OnClick="@(() => DisabledStateToggled.InvokeAsync(context))"
                                               aria-label="@GetToggleDisabledLabel(context)" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="@L["Catalog:Actions:Run"]">
                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@(IsMutating || (!IsRecurring(context) && definition.IsDisabled))"
                                           OnClick="@(() => RunRequested.InvokeAsync(context))"
                                           aria-label="@L["Catalog:Actions:Run"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Catalog:Actions:Details"]">
                            <MudIconButton Icon="@Icons.Material.Outlined.Info"
                                           Href="@GetDetailHref(context)"
                                           Size="Size.Small"
                                           aria-label="@L["Catalog:Actions:Details"]" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="catalog-table__empty">
                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Catalog:Empty"]</MudText>
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@PageSizeOptions"
                               RowsPerPageString="@L["Catalog:Filters:PageSize"]" />
            </PagerContent>
        </MudTable>
    </div>
</section>
