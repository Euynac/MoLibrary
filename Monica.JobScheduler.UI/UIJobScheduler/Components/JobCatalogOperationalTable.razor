@using Microsoft.AspNetCore.Components.Web
@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider

<section class="catalog-list" aria-labelledby="catalog-list-title">
    <header class="catalog-list__heading">
        <div>
            <MudText id="catalog-list-title" Typo="Typo.h6" HtmlTag="h2">@L["Catalog:Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Catalog:Count", TotalCount]</MudText>
        </div>
        <div class="catalog-list__heading-actions">
            @if (Summaries.Any(IsRecurring))
            {
                <MudCheckBox T="bool"
                             Value="@AreAllRecurringSelected"
                             ValueChanged="AllRecurringSelectionChanged"
                             Dense="true"
                             Color="Color.Primary"
                             Label="@L["Catalog:Selection:SelectPage"]"
                             aria-label="@L["Catalog:Selection:SelectAll"]" />
            }
            <MudTooltip Text="@L["Common:Refresh"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Disabled="@IsLoading"
                               OnClick="RefreshRequested"
                               aria-label="@L["Common:Refresh"]" />
            </MudTooltip>
        </div>
    </header>

    @if (IsLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    @if (Summaries.Count == 0 && !IsLoading)
    {
        <div class="catalog-list__empty">
            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Catalog:Empty"]</MudText>
        </div>
    }
    else
    {
        <div class="catalog-list__items">
            @foreach (var summary in Summaries)
            {
                var definition = summary.Definition;
                var declaration = definition.Declaration;
                <article class="catalog-item"
                         data-type="@declaration.JobType.ToString().ToLowerInvariant()"
                         data-disabled="@definition.IsDisabled.ToString().ToLowerInvariant()"
                         role="link"
                         tabindex="0"
                         aria-label="@L["Catalog:Actions:OpenJob", declaration.JobName]"
                         @onclick="@(() => OpenDetail(summary))"
                         @onkeydown="@(args => HandleItemKeyDown(args, summary))">
                    <div class="catalog-item__selection" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        @if (IsRecurring(summary))
                        {
                            <MudCheckBox T="bool"
                                         Value="@SelectedJobKeys.Contains(declaration.JobKey)"
                                         ValueChanged="@(_ => SelectionToggled.InvokeAsync(summary))"
                                         Dense="true"
                                         Color="Color.Primary"
                                         aria-label="@L["Catalog:Selection:SelectJob", declaration.JobName]" />
                        }
                        else
                        {
                            <span class="catalog-item__type-icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                            </span>
                        }
                    </div>

                    <div class="catalog-item__identity">
                        <div class="catalog-item__title-line">
                            <strong>@declaration.JobName</strong>
                            <span class="catalog-item__policy" data-disabled="@definition.IsDisabled.ToString().ToLowerInvariant()">
                                @(definition.IsDisabled ? L["Catalog:Disabled"] : L["Catalog:Enabled"])
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(declaration.Description))
                        {
                            <p>@declaration.Description</p>
                        }
                        <div class="catalog-item__identity-meta">
                            <code title="@declaration.JobKey">@declaration.JobKey</code>
                            <span title="@definition.OwnerId">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                                @definition.OwnerId
                            </span>
                        </div>
                    </div>

                    <div class="catalog-item__schedule">
                        @if (IsRecurring(summary))
                        {
                            <div class="catalog-item__schedule-label">
                                <span>@L["Catalog:Columns:Schedule"]</span>
                                <span class="catalog-item__cron">
                                    <code>@declaration.CronExpression</code>
                                    <MudTooltip Text="@GetCronTooltip(summary)" Placement="Placement.Top">
                                        <MudIcon Icon="@Icons.Material.Outlined.Info"
                                                 Size="Size.Small"
                                                 tabindex="0"
                                                 aria-label="@GetCronTooltip(summary)" />
                                    </MudTooltip>
                                </span>
                            </div>
                            <strong>@JobSchedulerUiPresentation.DescribeCron(declaration.CronExpression, L)</strong>
                            <small>@declaration.TimeZoneId · @GetNextRunLabel(summary)</small>
                        }
                        else
                        {
                            <div class="catalog-item__schedule-label">
                                <span>@L["Catalog:Columns:Schedule"]</span>
                                <span class="catalog-item__on-demand">
                                    <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                                    @L["Catalog:OnDemand"]
                                </span>
                            </div>
                            <strong>@L["Catalog:Triggered:Ready"]</strong>
                            <small>@(declaration.JobArgsKey ?? L["Catalog:Triggered:NoArguments"])</small>
                        }
                    </div>

                    <div class="catalog-item__pulse">
                        @if (summary.LatestExecution is { } latest)
                        {
                            <div class="catalog-item__last-state" data-state="@latest.State.ToString().ToLowerInvariant()">
                                <MudIcon Icon="@GetStateIcon(latest.State)" Size="Size.Small" />
                                <span>@L[$"ExecutionStates:{latest.State}"]</span>
                            </div>
                            <strong>@latest.CreatedAtUtc.ToLocalTime().ToString("g")</strong>
                            <small>@JobSchedulerUiPresentation.FormatExecutionDuration(latest, TimeProvider.GetUtcNow(), L)</small>
                        }
                        else
                        {
                            <span class="catalog-item__eyebrow">@L["Catalog:Columns:LastRun"]</span>
                            <strong>@L["Catalog:History:NeverRun"]</strong>
                        }
                        <div class="catalog-item__activity">
                            <span>@L["Catalog:Activity:QueuedRunning", summary.QueuedExecutionCount, summary.RunningExecutionCount]</span>
                            <span data-ready="@summary.HasCompatibleWorker.ToString().ToLowerInvariant()">
                                <MudIcon Icon="@(summary.HasCompatibleWorker ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
                                         Size="Size.Small" />
                                @(summary.HasCompatibleWorker
                                    ? L["Catalog:Readiness:Workers", summary.CompatibleWorkerCount]
                                    : L["Catalog:Readiness:NoWorker"])
                            </span>
                        </div>
                    </div>

                    <div class="catalog-item__actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        @if (IsRecurring(summary))
                        {
                            <MudTooltip Text="@(definition.IsDisabled ? L["Catalog:Actions:Resume"] : L["Catalog:Actions:Pause"])">
                                <MudIconButton Icon="@(definition.IsDisabled ? Icons.Material.Filled.PlayCircleOutline : Icons.Material.Filled.PauseCircleOutline)"
                                               Color="@(definition.IsDisabled ? Color.Success : Color.Warning)"
                                               Size="Size.Small"
                                               Disabled="@IsMutating"
                                               OnClick="@(() => DisabledStateToggled.InvokeAsync(summary))"
                                               aria-label="@(definition.IsDisabled ? L["Catalog:Actions:Resume"] : L["Catalog:Actions:Pause"])" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="@L["Catalog:Actions:Run"]">
                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@(IsMutating || (!IsRecurring(summary) && definition.IsDisabled))"
                                           OnClick="@(() => RunRequested.InvokeAsync(summary))"
                                           aria-label="@L["Catalog:Actions:Run"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Catalog:Actions:Details"]">
                            <MudIconButton Icon="@Icons.Material.Outlined.Info"
                                           Href="@GetDetailHref(summary)"
                                           Size="Size.Small"
                                           aria-label="@L["Catalog:Actions:Details"]" />
                        </MudTooltip>
                    </div>
                </article>
            }
        </div>
    }

    @if (PageCount > 1)
    {
        <div class="catalog-list__pagination">
            <MudPagination Count="@PageCount" Selected="@PageNumber" SelectedChanged="PageChanged" />
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<JobOperationalSummary> Summaries { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlySet<string> SelectedJobKeys { get; set; } = new HashSet<string>(StringComparer.Ordinal);

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public int PageNumber { get; set; } = 1;

    [Parameter]
    public int PageCount { get; set; } = 1;

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsMutating { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    [Parameter]
    public EventCallback<bool> AllRecurringSelectionChanged { get; set; }

    [Parameter]
    public EventCallback<JobOperationalSummary> SelectionToggled { get; set; }

    [Parameter]
    public EventCallback<JobOperationalSummary> DisabledStateToggled { get; set; }

    [Parameter]
    public EventCallback<JobOperationalSummary> RunRequested { get; set; }

    private bool AreAllRecurringSelected
    {
        get
        {
            var recurring = Summaries.Where(IsRecurring).ToArray();
            return recurring.Length > 0
                   && recurring.All(summary => SelectedJobKeys.Contains(summary.Definition.Declaration.JobKey));
        }
    }

    private static bool IsRecurring(JobOperationalSummary summary) =>
        summary.Definition.Declaration.JobType == JobType.Recurring;

    private string GetCronTooltip(JobOperationalSummary summary)
    {
        var declaration = summary.Definition.Declaration;
        return L["Catalog:Cron:Tooltip",
            JobSchedulerUiPresentation.DescribeCron(declaration.CronExpression, L),
            declaration.TimeZoneId ?? "—",
            GetNextRunLabel(summary)];
    }

    private string GetNextRunLabel(JobOperationalSummary summary) => summary.RecurringScheduleStatus switch
    {
        JobRecurringScheduleStatus.Scheduled when summary.NextOccurrenceUtc is { } next =>
            next.ToLocalTime().ToString("g"),
        JobRecurringScheduleStatus.AwaitingSynchronization => L["Catalog:ScheduleStatus:Awaiting"],
        JobRecurringScheduleStatus.Suspended => L["Catalog:ScheduleStatus:Suspended"],
        JobRecurringScheduleStatus.Exhausted => L["Catalog:ScheduleStatus:Exhausted"],
        _ => L["Catalog:OnDemand"]
    };

    private void OpenDetail(JobOperationalSummary summary) => Navigation.NavigateTo(GetDetailHref(summary));

    private void HandleItemKeyDown(KeyboardEventArgs args, JobOperationalSummary summary)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenDetail(summary);
        }
    }

    private static string GetStateIcon(JobExecutionState state) => state switch
    {
        JobExecutionState.Queued => Icons.Material.Filled.Schedule,
        JobExecutionState.Running => Icons.Material.Filled.PlayCircle,
        JobExecutionState.Succeeded => Icons.Material.Filled.CheckCircle,
        JobExecutionState.Failed => Icons.Material.Filled.Error,
        JobExecutionState.Cancelled => Icons.Material.Filled.Cancel,
        JobExecutionState.Skipped => Icons.Material.Filled.SkipNext,
        _ => Icons.Material.Filled.Circle
    };

    private static string GetDetailHref(JobOperationalSummary summary) =>
        $"/job-scheduler/catalog/{Uri.EscapeDataString(summary.Definition.Declaration.JobKey)}";
}
