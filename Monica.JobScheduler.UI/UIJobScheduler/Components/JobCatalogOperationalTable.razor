@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L
@inject TimeProvider TimeProvider

<section class="catalog-table" aria-labelledby="catalog-table-title">
    <header class="catalog-table__heading">
        <div>
            <MudText id="catalog-table-title" Typo="Typo.h6" HtmlTag="h2">@L["Catalog:Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Catalog:Count", TotalCount]</MudText>
        </div>
        <MudTooltip Text="@L["Common:Refresh"]">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary"
                           Disabled="@IsLoading"
                           OnClick="RefreshRequested"
                           aria-label="@L["Common:Refresh"]" />
        </MudTooltip>
    </header>

    @if (IsLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    <div class="catalog-table__scroll">
        <MudTable T="JobOperationalSummary"
                  Items="@Summaries"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.None"
                  Elevation="0">
            <HeaderContent>
                <MudTh Class="catalog-table__select-cell">
                    <MudCheckBox T="bool"
                                 Value="@AreAllRecurringSelected"
                                 ValueChanged="AllRecurringSelectionChanged"
                                 Disabled="@(!Summaries.Any(IsRecurring))"
                                 Dense="true"
                                 Color="Color.Primary"
                                 aria-label="@L["Catalog:Selection:SelectAll"]" />
                </MudTh>
                <MudTh>@L["Catalog:Columns:Definition"]</MudTh>
                <MudTh>@L["Catalog:Columns:Readiness"]</MudTh>
                <MudTh>@L["Catalog:Columns:Schedule"]</MudTh>
                <MudTh>@L["Catalog:Columns:NextRun"]</MudTh>
                <MudTh>@L["Catalog:Columns:LastRun"]</MudTh>
                <MudTh>@L["Catalog:Columns:Activity"]</MudTh>
                <MudTh>@L["Catalog:Columns:Policy"]</MudTh>
                <MudTh Class="catalog-table__actions">@L["Catalog:Columns:Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Catalog:Selection:Select"]" Class="catalog-table__select-cell">
                    @if (IsRecurring(context))
                    {
                        <MudCheckBox T="bool"
                                     Value="@SelectedJobKeys.Contains(context.Definition.Declaration.JobKey)"
                                     ValueChanged="@(_ => SelectionToggled.InvokeAsync(context))"
                                     Dense="true"
                                     Color="Color.Primary"
                                     aria-label="@L["Catalog:Selection:SelectJob", context.Definition.Declaration.JobName]" />
                    }
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Definition"]">
                    <div class="catalog-table__definition">
                        <MudLink Href="@GetDetailHref(context)" Typo="Typo.subtitle2">
                            @context.Definition.Declaration.JobName
                        </MudLink>
                        <MudTooltip Text="@context.Definition.Declaration.JobKey">
                            <code>@context.Definition.Declaration.JobKey</code>
                        </MudTooltip>
                        <span>@context.Definition.OwnerId</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Readiness"]">
                    <div class="catalog-table__readiness">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Text"
                                 Color="@(context.HasCompatibleWorker ? Color.Success : Color.Warning)"
                                 Icon="@(context.HasCompatibleWorker ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ReportProblem)">
                            @(context.HasCompatibleWorker
                                ? L["Catalog:Readiness:Workers", context.CompatibleWorkerCount]
                                : L["Catalog:Readiness:NoWorker"])
                        </MudChip>
                        <MudTooltip Text="@context.Definition.WorkerRevisionId">
                            <code>@JobSchedulerUiPresentation.ShortIdentity(context.Definition.WorkerRevisionId)</code>
                        </MudTooltip>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Schedule"]">
                    @if (IsRecurring(context))
                    {
                        <div class="catalog-table__schedule">
                            <MudTooltip Text="@context.Definition.Declaration.CronExpression">
                                <code>@context.Definition.Declaration.CronExpression</code>
                            </MudTooltip>
                            <span>@context.Definition.Declaration.TimeZoneId</span>
                        </div>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @L["Catalog:OnDemand"]
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:NextRun"]">
                    <div class="catalog-table__next">
                        <MudIcon Icon="@GetScheduleStatusIcon(context)"
                                 Color="@GetScheduleStatusColor(context)"
                                 Size="Size.Small" />
                        <span title="@GetNextRunTitle(context)">@GetNextRunLabel(context)</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:LastRun"]">
                    @if (context.LatestExecution is { } latest)
                    {
                        <div class="catalog-table__last-run">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Text"
                                     Color="@JobSchedulerUiPresentation.GetStateColor(latest.State)">
                                @L[$"ExecutionStates:{latest.State}"]
                            </MudChip>
                            <MudLink Href="@GetExecutionHref(latest.InstanceId)" Typo="Typo.caption">
                                @latest.CreatedAtUtc.ToLocalTime().ToString("g")
                            </MudLink>
                            <span>@JobSchedulerUiPresentation.FormatExecutionDuration(latest, TimeProvider.GetUtcNow(), L)</span>
                        </div>
                    }
                    else
                    {
                        <span class="catalog-table__muted">@L["Catalog:History:NeverRun"]</span>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Activity"]">
                    <div class="catalog-table__activity">
                        <strong>@context.ActiveExecutionCount / @context.Definition.Declaration.MaxConcurrency</strong>
                        <span>@L["Catalog:Activity:QueuedRunning", context.QueuedExecutionCount, context.RunningExecutionCount]</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Policy"]">
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Color="@(context.Definition.IsDisabled ? Color.Warning : Color.Success)">
                        @(context.Definition.IsDisabled ? L["Catalog:Disabled"] : L["Catalog:Enabled"])
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@L["Catalog:Columns:Actions"]" Class="catalog-table__actions">
                    <MudTooltip Text="@L["Catalog:Actions:Details"]">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                       Href="@GetDetailHref(context)"
                                       Size="Size.Small"
                                       aria-label="@L["Catalog:Actions:Details"]" />
                    </MudTooltip>
                    @if (IsRecurring(context))
                    {
                        <MudTooltip Text="@L["Catalog:Actions:InspectSchedule"]">
                            <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth"
                                           Size="Size.Small"
                                           OnClick="@(() => ScheduleRequested.InvokeAsync(context))"
                                           aria-label="@L["Catalog:Actions:InspectSchedule"]" />
                        </MudTooltip>
                        <MudTooltip Text="@(context.Definition.IsDisabled ? L["Catalog:Actions:Resume"] : L["Catalog:Actions:Pause"])">
                            <MudIconButton Icon="@(context.Definition.IsDisabled ? Icons.Material.Filled.PlayCircle : Icons.Material.Filled.PauseCircle)"
                                           Color="@(context.Definition.IsDisabled ? Color.Success : Color.Warning)"
                                           Size="Size.Small"
                                           Disabled="@IsMutating"
                                           OnClick="@(() => DisabledStateToggled.InvokeAsync(context))"
                                           aria-label="@(context.Definition.IsDisabled ? L["Catalog:Actions:Resume"] : L["Catalog:Actions:Pause"])" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="@L["Catalog:Actions:Trigger"]">
                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@(context.Definition.IsDisabled || IsMutating)"
                                           OnClick="@(() => TriggerRequested.InvokeAsync(context))"
                                           aria-label="@L["Catalog:Actions:Trigger"]" />
                        </MudTooltip>
                    }
                    <MudTooltip Text="@L["Catalog:Actions:Policy"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                       Size="Size.Small"
                                       Disabled="@IsMutating"
                                       OnClick="@(() => PolicyRequested.InvokeAsync(context))"
                                       aria-label="@L["Catalog:Actions:Policy"]" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-6" Color="Color.Secondary">@L["Catalog:Empty"]</MudText>
            </NoRecordsContent>
        </MudTable>
    </div>

    @if (PageCount > 1)
    {
        <div class="catalog-table__pagination">
            <MudPagination Count="@PageCount" Selected="@PageNumber" SelectedChanged="PageChanged" />
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<JobOperationalSummary> Summaries { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlySet<string> SelectedJobKeys { get; set; } = new HashSet<string>(StringComparer.Ordinal);

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public int PageNumber { get; set; } = 1;

    [Parameter]
    public int PageCount { get; set; } = 1;

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsMutating { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    [Parameter]
    public EventCallback<bool> AllRecurringSelectionChanged { get; set; }

    [Parameter]
    public EventCallback<JobOperationalSummary> SelectionToggled { get; set; }

    [Parameter]
    public EventCallback<JobOperationalSummary> DisabledStateToggled { get; set; }

    [Parameter]
    public EventCallback<JobOperationalSummary> ScheduleRequested { get; set; }

    [Parameter]
    public EventCallback<JobOperationalSummary> TriggerRequested { get; set; }

    [Parameter]
    public EventCallback<JobOperationalSummary> PolicyRequested { get; set; }

    private bool AreAllRecurringSelected
    {
        get
        {
            var recurring = Summaries.Where(IsRecurring).ToArray();
            return recurring.Length > 0
                   && recurring.All(summary => SelectedJobKeys.Contains(summary.Definition.Declaration.JobKey));
        }
    }

    private static bool IsRecurring(JobOperationalSummary summary) =>
        summary.Definition.Declaration.JobType == JobType.Recurring;

    private string GetNextRunLabel(JobOperationalSummary summary) => summary.RecurringScheduleStatus switch
    {
        JobRecurringScheduleStatus.Scheduled when summary.NextOccurrenceUtc is { } next =>
            next.ToLocalTime().ToString("g"),
        JobRecurringScheduleStatus.AwaitingSynchronization => L["Catalog:ScheduleStatus:Awaiting"],
        JobRecurringScheduleStatus.Suspended => L["Catalog:ScheduleStatus:Suspended"],
        JobRecurringScheduleStatus.Exhausted => L["Catalog:ScheduleStatus:Exhausted"],
        _ => L["Catalog:OnDemand"]
    };

    private string GetNextRunTitle(JobOperationalSummary summary) => summary.NextOccurrenceUtc?.ToString("O")
        ?? GetNextRunLabel(summary);

    private static string GetScheduleStatusIcon(JobOperationalSummary summary) => summary.RecurringScheduleStatus switch
    {
        JobRecurringScheduleStatus.Scheduled => Icons.Material.Filled.EventAvailable,
        JobRecurringScheduleStatus.AwaitingSynchronization => Icons.Material.Filled.Sync,
        JobRecurringScheduleStatus.Suspended => Icons.Material.Filled.PauseCircle,
        JobRecurringScheduleStatus.Exhausted => Icons.Material.Filled.EventBusy,
        _ => Icons.Material.Filled.Bolt
    };

    private static Color GetScheduleStatusColor(JobOperationalSummary summary) => summary.RecurringScheduleStatus switch
    {
        JobRecurringScheduleStatus.Scheduled => Color.Info,
        JobRecurringScheduleStatus.AwaitingSynchronization => Color.Warning,
        JobRecurringScheduleStatus.Suspended => Color.Warning,
        JobRecurringScheduleStatus.Exhausted => Color.Default,
        _ => Color.Primary
    };

    private static string GetDetailHref(JobOperationalSummary summary) =>
        $"/job-scheduler/catalog/{Uri.EscapeDataString(summary.Definition.Declaration.JobKey)}";

    private static string GetExecutionHref(string instanceId) =>
        $"/job-scheduler/executions?instanceId={Uri.EscapeDataString(instanceId)}";
}
