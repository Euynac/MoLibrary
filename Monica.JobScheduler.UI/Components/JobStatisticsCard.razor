@using Monica.JobScheduler.UI.Localization
@using MudBlazor
@inject JobSchedulerUIService UIService
@inject JobStateColorService ColorService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IStringLocalizer<JobSchedulerResource> L

<MudCard Elevation="2">
    <MudCardHeader>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@L["JobDetail:Statistics:Title"]</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           OnClick="RefreshAsync"
                           Size="Size.Small"
                           Color="Color.Primary" />
        </MudStack>
    </MudCardHeader>
    <MudCardContent>
        @if (_statistics != null)
        {
            <MudStack Spacing="2">
                <!-- 执行次数 -->
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">@L["JobDetail:Statistics:TotalExecutions"]</MudText>
                    <MudLink OnClick="NavigateToAllInstances" Typo="Typo.body2">
                        @_statistics.TotalExecutions
                    </MudLink>
                </MudStack>

                <!-- 失败次数 -->
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">@L["JobDetail:Statistics:FailedExecutions"]</MudText>
                    <MudLink OnClick="NavigateToFailedInstances" Typo="Typo.body2" Color="Color.Error">
                        @_statistics.FailedExecutions
                    </MudLink>
                </MudStack>

                <MudDivider />

                <!-- 平均执行时间 -->
                @if (_statistics.AverageExecutionTime.HasValue)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["JobDetail:Statistics:AverageExecutionTime"]</MudText>
                        <MudText Typo="Typo.body2">@FormatTimeSpan(_statistics.AverageExecutionTime.Value)</MudText>
                    </MudStack>
                }

                <!-- 最快执行时间 -->
                @if (_statistics.FastestExecutionTime.HasValue && _statistics.FastestInstanceId != null)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["JobDetail:Statistics:FastestExecutionTime"]</MudText>
                        <MudLink OnClick="@(async () => await OpenInstanceDetailDialog(_statistics.FastestInstanceId))" Typo="Typo.body2" Color="Color.Success">
                            @FormatTimeSpan(_statistics.FastestExecutionTime.Value)
                        </MudLink>
                    </MudStack>
                }

                <!-- 最慢执行时间 -->
                @if (_statistics.SlowestExecutionTime.HasValue && _statistics.SlowestInstanceId != null)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["JobDetail:Statistics:SlowestExecutionTime"]</MudText>
                        <MudLink OnClick="@(async () => await OpenInstanceDetailDialog(_statistics.SlowestInstanceId))" Typo="Typo.body2" Color="Color.Warning">
                            @FormatTimeSpan(_statistics.SlowestExecutionTime.Value)
                        </MudLink>
                    </MudStack>
                }

                @if (_statistics.LastExecutionTime.HasValue)
                {
                    <MudDivider />

                    <!-- 最后执行时间 -->
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["JobDetail:Statistics:LastExecutionTime"]</MudText>
                        <MudText Typo="Typo.body2">@_statistics.LastExecutionTime.Value.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                    </MudStack>

                    <!-- 最后执行状态 -->
                    @if (_statistics.LastExecutionState.HasValue)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">@L["JobDetail:Statistics:LastExecutionState"]</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@ColorService.GetStateColor(_statistics.LastExecutionState.Value)">
                                @_statistics.LastExecutionState.Value
                            </MudChip>
                        </MudStack>
                    }
                }
            </MudStack>
        }
        else if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.caption">@L["Common:Status:Loading"]</MudText>
            </MudStack>
        }
        else if (_error != null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string JobKey { get; set; } = null!;

    private JobStatistics? _statistics;
    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (string.IsNullOrEmpty(JobKey))
            return;

        _isLoading = true;
        _error = null;

        try
        {
            var result = await UIService.GetStatisticsAsync(JobKey);
            if (result.IsFailed(out var error, out var data))
            {
                _error = $"{L["Common:Messages:LoadFailed"]}: {error.Message}";
            }
            else
            {
                _statistics = data;
            }
        }
        catch (Exception ex)
        {
            _error = $"{L["Common:Messages:LoadFailed"]}: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }

        StateHasChanged();
    }

    private string FormatTimeSpan(TimeSpan timeSpan)
    {
        if (timeSpan.TotalHours >= 1)
            return $"{timeSpan.TotalHours:F2}h";
        if (timeSpan.TotalMinutes >= 1)
            return $"{timeSpan.TotalMinutes:F2}m";
        if (timeSpan.TotalSeconds >= 1)
            return $"{timeSpan.TotalSeconds:F2}s";
        return $"{timeSpan.TotalMilliseconds:F0}ms";
    }

    private void NavigateToAllInstances()
    {
        if (string.IsNullOrEmpty(JobKey))
            return;
        NavigationManager.NavigateTo($"/job-scheduler/instances?jobKey={Uri.EscapeDataString(JobKey)}");
    }

    private void NavigateToFailedInstances()
    {
        if (string.IsNullOrEmpty(JobKey))
            return;
        NavigationManager.NavigateTo($"/job-scheduler/instances?jobKey={Uri.EscapeDataString(JobKey)}&state=Failed,Terminated");
    }

    private async Task OpenInstanceDetailDialog(string instanceId)
    {
        var parameters = new DialogParameters<JobInstanceDetailDialog>
        {
            { x => x.InstanceId, instanceId },
            { x => x.ShowJobDefinitionButton, true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false,
            Position = DialogPosition.Center
        };

        await DialogService.ShowAsync<JobInstanceDetailDialog>(L["JobDetail:HealthMetrics:InstanceDetailTitle"], parameters, options);
    }
}
