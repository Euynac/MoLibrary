@using Monica.JobScheduler.UI.Localization

@inject JobStateColorService StateColorService
@inject IStringLocalizer<JobSchedulerResource> L

<div class="state-distribution-wrapper">
    <MudPaper Class="state-distribution-card" Elevation="0">
        <div class="card-header">
            <MudText Typo="Typo.h6">@L["Dashboard:StateDistribution:Title"]</MudText>
            <MudText Typo="Typo.caption" Class="time-range">@TimeWindowText</MudText>
        </div>

        @if (HasData)
        {
            <div class="chart-content">
                <div class="chart-container">
                    <MudChart T="double"
                              ChartType="ChartType.Donut"
                              ChartSeries="@DonutSeries"
                              ChartLabels="@ChartLabels"
                              Width="@ChartSize"
                              Height="@ChartSize"
                              ChartOptions="@ChartOptionsWithPalette" />
                    <div class="chart-total">
                        <MudText Typo="Typo.caption" Class="chart-total-label">@L["Dashboard:StateDistribution:Total"]</MudText>
                        <MudText Typo="Typo.h4" Class="chart-total-value">@TotalCount</MudText>
                    </div>
                </div>
                <div class="legend-container">
                    @foreach (var state in VisibleStates)
                    {
                        <div class="legend-item">
                            <div class="legend-color" style="background-color: @state.ColorHex"></div>
                            <div class="legend-label">@state.Label</div>
                            <div class="legend-value">@state.Count</div>
                            <div class="legend-percent">@GetPercentage(state.Count)%</div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.PieChart" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard:StateDistribution:NoData"]</MudText>
            </div>
        }
    </MudPaper>
</div>

@code {
    [Parameter]
    public Dictionary<JobState, int> StateDistribution { get; set; } = new();

    [Parameter]
    public string TimeWindowText { get; set; } = string.Empty;

    private ChartOptions ChartOptionsWithPalette => new()
    {
        ShowLegend = false,
        ChartPalette = VisibleStates
            .Select(state => state.ColorHex)
            .ToArray()
    };

    private bool HasData => TotalCount > 0;
    private int TotalCount => StateDistribution.Values.Sum();
    private const string ChartSize = "313px";

    private List<ChartSeries<double>> DonutSeries =>
    [
        new ChartSeries<double>(VisibleStates.Select(state => (double)state.Count).ToArray())
    ];

    private string[] ChartLabels => VisibleStates
        .Select(state => state.Label)
        .ToArray();

    private IReadOnlyList<StateSlice> VisibleStates => OrderedStates
        .Select(state => new StateSlice(
            Label: GetStateLabel(state),
            ColorHex: StateColorService.GetStateColorHex(state),
            Count: StateDistribution.GetValueOrDefault(state, 0)))
        .Where(state => state.Count > 0)
        .ToArray();

    // Order states by typical importance
    private static readonly JobState[] OrderedStates =
    [
        JobState.Succeeded,
        JobState.Failed,
        JobState.Terminated,
        JobState.Processing,
        JobState.Enqueued,
        JobState.Scheduled,
        JobState.Skipped,
        JobState.Cancelled
    ];

    private string GetStateLabel(JobState state)
    {
        return state switch
        {
            JobState.Succeeded => L["JobStates:Succeeded"],
            JobState.Failed => L["JobStates:Failed"],
            JobState.Terminated => L["JobStates:Terminated"],
            JobState.Processing => L["JobStates:Processing"],
            JobState.Enqueued => L["JobStates:Enqueued"],
            JobState.Scheduled => L["JobStates:Scheduled"],
            JobState.Skipped => L["JobStates:Skipped"],
            JobState.Cancelled => L["JobStates:Cancelled"],
            _ => state.ToString()
        };
    }

    private string GetPercentage(int count)
    {
        if (TotalCount == 0) return "0";
        return ((double)count / TotalCount * 100).ToString("F1");
    }

    private sealed record StateSlice(string Label, string ColorHex, int Count);
}
