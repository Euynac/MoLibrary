@using Monica.JobScheduler.UI.Localization

@inject JobStateColorService StateColorService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IStringLocalizer<JobSchedulerResource> L

<div class="activity-timeline-wrapper">
    <MudPaper Class="activity-card" Elevation="0">
        <div class="card-header">
            <MudText Typo="Typo.h6">@L["Dashboard:RecentActivity:Title"]</MudText>
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@ViewAllInstances">
                @L["Common:Actions:ViewAll"]
            </MudButton>
        </div>

        @if (Activities.Count > 0)
        {
            <div class="timeline-container">
                @foreach (var activity in Activities)
                {
                    <div class="timeline-item" @onclick="() => ViewInstanceAsync(activity.InstanceId)">
                        <div class="timeline-indicator">
                            <div class="state-dot @GetStateDotClass(activity.State)"></div>
                            <div class="timeline-line"></div>
                        </div>
                        <div class="timeline-content">
                            <div class="activity-header">
                                <span class="job-name" title="@activity.JobKey">@activity.JobName</span>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@StateColorService.GetStateColor(activity.State)"
                                         Variant="Variant.Outlined">
                                    @GetStateLabel(activity.State)
                                </MudChip>
                            </div>
                            <div class="activity-details">
                                <span class="timestamp">@FormatTimestamp(activity.Timestamp)</span>
                                @if (activity.Duration.HasValue)
                                {
                                    <span class="separator">·</span>
                                    <span class="duration">@FormatDuration(activity.Duration.Value)</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard:RecentActivity:NoActivity"]</MudText>
            </div>
        }
    </MudPaper>
</div>

@code {
    [Parameter]
    public List<RecentActivity> Activities { get; set; } = [];

    private void ViewAllInstances()
    {
        NavigationManager.NavigateTo("/job-scheduler/instances");
    }

    private async Task ViewInstanceAsync(string instanceId)
    {
        var parameters = new DialogParameters<JobInstanceDetailDialog>
        {
            { x => x.InstanceId, instanceId },
            { x => x.ShowJobDefinitionButton, true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false,
            Position = DialogPosition.Center
        };

        await DialogService.ShowAsync<JobInstanceDetailDialog>(L["Dialogs:JobInstanceDetail:Title"], parameters, options);
    }

    private string GetStateDotClass(JobState state)
    {
        return state switch
        {
            JobState.Succeeded => "dot-success",
            JobState.Failed or JobState.Terminated => "dot-error",
            JobState.Processing => "dot-processing",
            JobState.Cancelled => "dot-warning",
            JobState.Skipped => "dot-skip",
            _ => "dot-default"
        };
    }

    private string GetStateLabel(JobState state)
    {
        return state switch
        {
            JobState.Succeeded => L["JobStates:Succeeded"],
            JobState.Failed => L["JobStates:Failed"],
            JobState.Terminated => L["JobStates:Terminated"],
            JobState.Processing => L["JobStates:Processing"],
            JobState.Enqueued => L["JobStates:Enqueued"],
            JobState.Scheduled => L["JobStates:Scheduled"],
            JobState.Skipped => L["JobStates:Skipped"],
            JobState.Cancelled => L["JobStates:Cancelled"],
            _ => state.ToString()
        };
    }

    private string FormatTimestamp(DateTime timestamp)
    {
        var local = timestamp.FromUtcToLocal();
        var now = DateTime.Now;

        if (local.Date == now.Date)
            return local.ToString("HH:mm:ss");

        if (local.Date == now.Date.AddDays(-1))
            return $"{L["Dashboard:RecentActivity:Yesterday"]} {local:HH:mm}";

        return local.ToString("MM-dd HH:mm");
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalDays >= 1)
            return $"{duration.TotalDays:F1}{L["Common:Time:Days"]}";
        if (duration.TotalHours >= 1)
            return $"{duration.TotalHours:F1}{L["Common:Time:Hours"]}";
        if (duration.TotalMinutes >= 1)
            return $"{duration.TotalMinutes:F1}{L["Common:Time:Minutes"]}";
        if (duration.TotalSeconds >= 1)
            return $"{duration.TotalSeconds:F1}{L["Common:Time:Seconds"]}";
        return $"{duration.TotalMilliseconds:F0}{L["Common:Time:Milliseconds"]}";
    }
}
