@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Shared.Support
@using Monica.UI.UIStackTrace.Support
@inject JobStateColorResolver ColorService
@inject StackTraceParser StackTraceParser
@inject IStringLocalizer<JobSchedulerResource> L

<MudCard Elevation="2">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@L["Dialogs:StateHistory:Title"]</MudText>
    </MudCardHeader>
    <MudCardContent>
        @if (_historyRecords?.Any() == true)
        {
            <MudTimeline TimelineOrientation="TimelineOrientation.Vertical">
                @foreach (var record in _historyRecords)
                {
                    <MudTimelineItem Color="@ColorService.GetStateColor(record.NewState)"
                                     Icon="@GetStateIcon(record.NewState)"
                                     Size="Size.Small">
                        <ItemContent>
                            <MudStack Spacing="1">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@ColorService.GetStateColor(record.NewState)">
                                        @record.PreviousStateLabel → @record.NewState
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @record.Timestamp.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss.fff")
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(record.SourceClientId))
                                    {
                                        <MudTooltip Text="@L["Dialogs:StateHistory:SourceClientTooltip", record.SourceClientId!]">
                                            <MudIcon Icon="@Icons.Material.Filled.Info"
                                                     Size="Size.Small"
                                                     Color="Color.Info" />
                                        </MudTooltip>
                                    }
                                </MudStack>

                                @if (!string.IsNullOrEmpty(record.Message))
                                {
                                    @if (IsStackTrace(record.Message))
                                    {
                                        <!-- Render stack trace details with the dedicated viewer. -->
                                        <StackTraceViewer Message="@record.Message" />
                                    }
                                    else
                                    {
                                        <!-- Render regular history messages inline. -->
                                        <div class="normal-message-wrapper">
                                            <MudPaper Elevation="0"
                                                      Class="normal-message">
                                                <MudText Typo="Typo.body2" Class="normal-message__text">
                                                    @record.Message
                                                </MudText>
                                            </MudPaper>
                                        </div>
                                    }
                                }
                            </MudStack>
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dialogs:StateHistory:NoHistory"]</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public JobInstance? Instance { get; set; }

    private List<JobInstance.StateHistoryRecord>? _historyRecords;

    protected override void OnParametersSet()
    {
        _historyRecords = Instance?.GetStateHistoryRecords();
    }

    /// <summary>
    /// Determines whether the message is a stack trace.
    /// </summary>
    private bool IsStackTrace(string message)
    {
        return StackTraceParser.IsLikelyStackTrace(message);
    }

    private string GetStateIcon(JobState state)
    {
        return state switch
        {
            JobState.Succeeded => Icons.Material.Filled.CheckCircle,
            JobState.Failed => Icons.Material.Filled.Error,
            JobState.Terminated => Icons.Material.Filled.Cancel,
            JobState.Cancelled => Icons.Material.Filled.Warning,
            JobState.Processing => Icons.Material.Filled.PlayArrow,
            JobState.Enqueued => Icons.Material.Filled.Queue,
            JobState.Scheduled => Icons.Material.Filled.Schedule,
            JobState.Skipped => Icons.Material.Filled.SkipNext,
            _ => Icons.Material.Filled.Circle
        };
    }
}
