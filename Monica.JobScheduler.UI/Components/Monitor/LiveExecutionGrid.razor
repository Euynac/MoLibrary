@using Monica.JobScheduler.UI.Localization

@inject JobStateColorService StateColorService
@inject IDialogService DialogService
@inject IStringLocalizer<JobSchedulerResource> L

<div class="live-grid-wrapper">
    <MudPaper Class="live-grid-card" Elevation="0">
        <div class="card-header">
            <div class="header-title">
                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Monitor:LiveExecution:Title"]</MudText>
            </div>
            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                @L["Monitor:LiveExecution:ActiveCount", Executions.Count]
            </MudChip>
        </div>

        @if (Executions.Count > 0)
        {
            <div class="table-container">
                <MudTable Items="@Executions"
                          Dense="true"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          RowClass="execution-row"
                          T="LiveExecution">
                    <HeaderContent>
                        <MudTh>@L["Monitor:LiveExecution:Columns:Job"]</MudTh>
                        <MudTh>@L["Monitor:LiveExecution:Columns:State"]</MudTh>
                        <MudTh>@L["Monitor:LiveExecution:Columns:ElapsedTime"]</MudTh>
                        <MudTh Style="width: 150px;">@L["Monitor:LiveExecution:Columns:TimeoutProgress"]</MudTh>
                        <MudTh>@L["Monitor:LiveExecution:Columns:Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["Monitor:LiveExecution:Columns:Job"]">
                            <div class="job-info">
                                <span class="job-name" title="@context.JobKey">@context.JobName</span>
                                <span class="instance-id">@context.InstanceId[..8]...</span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="@L["Monitor:LiveExecution:Columns:State"]">
                            <MudChip T="string"
                                     Color="@StateColorService.GetStateColor(context.State)"
                                     Size="Size.Small"
                                     Variant="Variant.Filled">
                                @GetStateIcon(context.State) @GetStateLabel(context.State)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="@L["Monitor:LiveExecution:Columns:ElapsedTime"]">
                            @if (context.ElapsedTime.HasValue)
                            {
                                <span class="elapsed-time">@FormatDuration(context.ElapsedTime.Value)</span>
                            }
                            else
                            {
                                <span class="waiting">@L["Monitor:LiveExecution:Messages:Waiting"]</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["Monitor:LiveExecution:Columns:TimeoutProgress"]">
                            @if (context.State == JobState.Processing)
                            {
                                <div class="timeout-progress">
                                    <MudProgressLinear Value="@context.TimeoutProgress"
                                                       Max="100"
                                                       Color="@GetTimeoutColor(context.TimeoutProgress)"
                                                       Size="Size.Small" />
                                    <span class="progress-text">@context.TimeoutProgress.ToString("F0")%</span>
                                </div>
                            }
                            else
                            {
                                <span class="na">-</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["Monitor:LiveExecution:Columns:Actions"]">
                            <MudTooltip Text="@L["Monitor:LiveExecution:Actions:ViewDetails"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Small"
                                               OnClick="@(() => ViewInstance(context.InstanceId))" />
                            </MudTooltip>
                            @if (context.State == JobState.Processing)
                            {
                                <MudTooltip Text="@L["Monitor:LiveExecution:Actions:Cancel"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => OnCancelRequested.InvokeAsync(context.InstanceId))" />
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }
        else
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Monitor:LiveExecution:Messages:NoExecutions"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Tertiary">@L["Monitor:LiveExecution:Messages:AllCompleted"]</MudText>
            </div>
        }
    </MudPaper>
</div>

@code {
    [Parameter]
    public List<LiveExecution> Executions { get; set; } = [];

    [Parameter]
    public EventCallback<string> OnCancelRequested { get; set; }

    private async Task ViewInstance(string instanceId)
    {
        var parameters = new DialogParameters<JobInstanceDetailDialog>
        {
            { x => x.InstanceId, instanceId },
            { x => x.ShowJobDefinitionButton, true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<JobInstanceDetailDialog>(L["Dialogs:JobInstanceDetail:Title"], parameters, options);
    }

    private static string GetStateIcon(JobState state)
    {
        return state switch
        {
            JobState.Processing => "⏳",
            JobState.Enqueued => "📋",
            JobState.Scheduled => "🕐",
            _ => ""
        };
    }

    private string GetStateLabel(JobState state)
    {
        return state switch
        {
            JobState.Processing => L["JobStates:Processing"],
            JobState.Enqueued => L["JobStates:Enqueued"],
            JobState.Scheduled => L["JobStates:Scheduled"],
            _ => state.ToString()
        };
    }

    private static Color GetTimeoutColor(double percentage)
    {
        if (percentage >= 90) return Color.Error;
        if (percentage >= 70) return Color.Warning;
        if (percentage >= 50) return Color.Info;
        return Color.Success;
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return duration.ToString(@"h\:mm\:ss");
        return duration.ToString(@"mm\:ss");
    }
}
