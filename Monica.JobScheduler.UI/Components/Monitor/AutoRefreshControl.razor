@using Monica.JobScheduler.UI.Models
@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

<div class="refresh-control-wrapper">
    <MudPaper Class="refresh-control" Elevation="0">
        <div class="control-item">
            <MudSwitch T="bool"
                       Value="@IsEnabled"
                       ValueChanged="@OnEnabledChanged"
                       Color="Color.Primary"
                       Label="@L["Monitor:AutoRefresh:Enable"]" />
        </div>

        <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />

        <div class="control-item">
            <MudSelect T="RefreshInterval"
                       Value="@Interval"
                       ValueChanged="@OnIntervalChanged"
                       Label="@L["Monitor:AutoRefresh:Interval"]"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Disabled="@(!IsEnabled)"
                       Style="min-width: 120px;">
                <MudSelectItem T="RefreshInterval" Value="RefreshInterval.ThreeSeconds">@L["Monitor:AutoRefresh:Intervals:ThreeSeconds"]</MudSelectItem>
                <MudSelectItem T="RefreshInterval" Value="RefreshInterval.FiveSeconds">@L["Monitor:AutoRefresh:Intervals:FiveSeconds"]</MudSelectItem>
                <MudSelectItem T="RefreshInterval" Value="RefreshInterval.TenSeconds">@L["Monitor:AutoRefresh:Intervals:TenSeconds"]</MudSelectItem>
                <MudSelectItem T="RefreshInterval" Value="RefreshInterval.ThirtySeconds">@L["Monitor:AutoRefresh:Intervals:ThirtySeconds"]</MudSelectItem>
            </MudSelect>
        </div>

        <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />

        <div class="control-item">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="@OnManualRefresh"
                       Disabled="@IsRefreshing">
                @if (IsRefreshing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>@L["Monitor:AutoRefresh:Refreshing"]</span>
                }
                else
                {
                    <span>@L["Monitor:AutoRefresh:ManualRefresh"]</span>
                }
            </MudButton>
        </div>

        @if (LastRefreshTime.HasValue)
        {
            <div class="last-refresh">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["Monitor:AutoRefresh:LastRefresh"]: @FormatLastRefresh(LastRefreshTime.Value)
                </MudText>
            </div>
        }
    </MudPaper>
</div>

@code {
    [Parameter]
    public bool IsEnabled { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IsEnabledChanged { get; set; }

    [Parameter]
    public RefreshInterval Interval { get; set; } = RefreshInterval.FiveSeconds;

    [Parameter]
    public EventCallback<RefreshInterval> IntervalChanged { get; set; }

    [Parameter]
    public bool IsRefreshing { get; set; }

    [Parameter]
    public DateTime? LastRefreshTime { get; set; }

    [Parameter]
    public EventCallback OnRefreshRequested { get; set; }

    private async Task OnEnabledChanged(bool value)
    {
        await IsEnabledChanged.InvokeAsync(value);
    }

    private async Task OnIntervalChanged(RefreshInterval value)
    {
        await IntervalChanged.InvokeAsync(value);
    }

    private async Task OnManualRefresh()
    {
        await OnRefreshRequested.InvokeAsync();
    }

    private string FormatLastRefresh(DateTime time)
    {
        var local = time.FromUtcToLocal();
        var diff = DateTime.Now - local;

        if (diff.TotalSeconds < 10)
            return L["Common:Time:JustNow"];
        if (diff.TotalSeconds < 60)
            return L["Common:Time:SecondsAgo", (int)diff.TotalSeconds];
        if (diff.TotalMinutes < 60)
            return L["Common:Time:MinutesAgo", (int)diff.TotalMinutes];

        return local.ToString("HH:mm:ss");
    }
}
