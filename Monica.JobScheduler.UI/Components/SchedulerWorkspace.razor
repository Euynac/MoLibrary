@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

<div class="scheduler-workspace mo-page-shell mo-page-shell--full-width">
    <header class="scheduler-workspace__header">
        <div class="scheduler-workspace__identity">
            <MudText Typo="Typo.overline" Color="Color.Primary">@L["Workspace:Eyebrow"]</MudText>
            <MudText Typo="Typo.h3" HtmlTag="h1" Class="scheduler-workspace__title">@Title</MudText>
            <MudText Typo="Typo.body1" Class="scheduler-workspace__description">@Description</MudText>
        </div>
        <div class="scheduler-workspace__contract">
            <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Medium" />
            <div>
                <span>@L["Workspace:ContractLabel"]</span>
                <strong>@L["Workspace:ContractValue"]</strong>
            </div>
        </div>
    </header>

    <nav class="scheduler-workspace__nav" aria-label="@L["Workspace:NavigationLabel"]">
        <NavLink href="/job-scheduler" Match="NavLinkMatch.All" class="scheduler-workspace__nav-item">
            <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Size="Size.Small" />
            <span>@L["Workspace:Navigation:Overview"]</span>
        </NavLink>
        <NavLink href="/job-scheduler/catalog" Match="NavLinkMatch.All" class="scheduler-workspace__nav-item">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
            <span>@L["Workspace:Navigation:Catalog"]</span>
        </NavLink>
        <NavLink href="/job-scheduler/executions" Match="NavLinkMatch.All" class="scheduler-workspace__nav-item">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
            <span>@L["Workspace:Navigation:Executions"]</span>
        </NavLink>
    </nav>

    <main class="scheduler-workspace__content">
        @ChildContent
    </main>
</div>

@code {
    /// <summary>
    /// Gets or sets the route-specific workspace heading.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the route-specific operational description.
    /// </summary>
    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the route body.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
