@using Monica.JobScheduler.UI.Localization
@using Monica.Core.Results
@inject JobSchedulerUIService UIService
@inject ISnackbar Snackbar
@inject IStringLocalizer<JobSchedulerResource> L

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudProgressCircular Indeterminate="true" />
                <MudText>@L["Common:Status:Saving"]</MudText>
            </MudStack>
        }
        else
        {
            <CronExpressionEditor @bind-Value="@_cronExpression"
                                  InitialFormat="@_format" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common:Actions:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@_isLoading">
            @L["Common:Actions:Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public JobDefinition JobDefinition { get; set; } = null!;

    private string _cronExpression = string.Empty;
    private CronFormat _format = CronFormat.Quartz;
    private bool _isLoading = false;

    protected override void OnInitialized()
    {
        _cronExpression = JobDefinition?.CronExpression ?? string.Empty;

        // Determine the format based on the number of expression segments
        var parts = _cronExpression.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        _format = parts.Length == 6 ? CronFormat.Quartz : CronFormat.Standard;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_cronExpression))
        {
            Snackbar.Add(L["Dialogs:CronEditor:EmptyExpression"], Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            // Update job definition
            JobDefinition.CronExpression = _cronExpression;
            var result = await UIService.UpdateJobConfigAsync(JobDefinition);

            if (result.IsFailed(out var error))
            {
                Snackbar.Add($"{L["Common:Messages:SaveFailed"]}: {error.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add(L["Dialogs:CronEditor:SaveSuccess"], Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Common:Messages:SaveFailed"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
