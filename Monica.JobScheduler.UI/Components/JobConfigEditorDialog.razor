@using Monica.JobScheduler.UI.Localization
@inject JobSchedulerFacade UIService
@inject ISnackbar Snackbar
@inject IStringLocalizer<JobSchedulerResource> L

<MudDialog>
    <DialogContent>
        <div class="job-config-editor">
        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                <MudProgressCircular Indeterminate="true" />
                <MudText>@L["Common:Status:Saving"]</MudText>
            </MudStack>
        }
        else
        {
            <MudForm @ref="_form" @bind-IsValid="@_success">
                <MudStack Spacing="3">
                    <!-- JobName -->
                    <MudTextField @bind-Value="@_jobName"
                                  T="string"
                                  Label="@L["Dialogs:JobConfigEditor:JobName"]"
                                  Variant="Variant.Outlined"
                                  HelperText="@L["Dialogs:JobConfigEditor:JobNameHelper"]"
                                  Required="true"
                                  RequiredError="@L["Dialogs:JobConfigEditor:JobNameRequired"]" />

                    <!-- Description -->
                    <MudTextField @bind-Value="@_description"
                                  T="string"
                                  Label="@L["Dialogs:JobConfigEditor:Description"]"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  HelperText="@L["Dialogs:JobConfigEditor:DescriptionHelper"]" />

                    <!-- MaxConcurrency -->
                    <MudNumericField @bind-Value="@_maxConcurrency"
                                     T="int"
                                     Label="@L["Dialogs:JobConfigEditor:MaxConcurrency"]"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Required="true"
                                     RequiredError="@L["Dialogs:JobConfigEditor:MaxConcurrencyRequired"]"
                                     HelperText="@L["Dialogs:JobConfigEditor:MaxConcurrencyHelper"]" />

                    <!-- RetryCount -->
                    <MudNumericField @bind-Value="@_retryCount"
                                     T="int"
                                     Label="@L["Dialogs:JobConfigEditor:RetryCount"]"
                                     Variant="Variant.Outlined"
                                     Min="0"
                                     Required="true"
                                     RequiredError="@L["Dialogs:JobConfigEditor:RetryCountRequired"]"
                                     HelperText="@L["Dialogs:JobConfigEditor:RetryCountHelper"]" />

                    <!-- MaxExecutionTimeout -->
                    <MudStack Row="true" Spacing="2">
                        <MudNumericField @bind-Value="@_timeoutHours"
                                         T="int"
                                         Label="@L["Dialogs:JobConfigEditor:TimeoutHours"]"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Class="job-config-editor__timeout-field"
                                         Required="true"
                                         RequiredError="@L["Dialogs:JobConfigEditor:TimeoutRequired"]" />
                        <MudNumericField @bind-Value="@_timeoutMinutes"
                                         T="int"
                                         Label="@L["Dialogs:JobConfigEditor:TimeoutMinutes"]"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Max="59"
                                         Class="job-config-editor__timeout-field" />
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["Dialogs:JobConfigEditor:CurrentTimeout", _timeoutHours, _timeoutMinutes]
                    </MudText>

                    <!-- History Retention Section -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Dialogs:JobConfigEditor:HistoryRetentionPolicy"]</MudText>
                        <MudTooltip Text="@L["Dialogs:JobConfigEditor:HistoryRetentionTooltip"]">
                            <MudIcon Icon="@Icons.Material.Filled.Info"
                                     Size="Size.Small"
                                     Color="Color.Info"
                                     Class="job-config-editor__info-icon" />
                        </MudTooltip>
                    </MudStack>

                    <!-- MaxRetainedHistoryRecords -->
                    <MudNumericField @bind-Value="@_maxRetainedHistoryRecords"
                                     T="int"
                                     Label="@L["Dialogs:JobConfigEditor:MaxRetainedHistoryRecords"]"
                                     Variant="Variant.Outlined"
                                     Min="0"
                                     Required="true"
                                     RequiredError="@L["Dialogs:JobConfigEditor:MaxRetainedHistoryRecordsRequired"]"
                                     HelperText="@L["Dialogs:JobConfigEditor:MaxRetainedHistoryRecordsHelper"]" />

                    <!-- MaxRetentionDays -->
                    <MudNumericField @bind-Value="@_maxRetentionDays"
                                     T="int?"
                                     Label="@L["Dialogs:JobConfigEditor:MaxRetentionDays"]"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Clearable="true"
                                     HelperText="@L["Dialogs:JobConfigEditor:MaxRetentionDaysHelper"]" />

                    <!-- Recurring Job Specific Fields -->
                    @if (JobDefinition?.JobType == JobType.Recurring)
                    {
                        <!-- StartTime -->
                        <MudDatePicker @bind-Date="@_startDate"
                                       Label="@L["Dialogs:JobConfigEditor:StartTime"]"
                                       Variant="Variant.Outlined"
                                       HelperText="@L["Dialogs:JobConfigEditor:StartTimeHelper"]" />
                        @if (_startDate.HasValue)
                        {
                            <MudTimePicker @bind-Time="@_startTime"
                                           Label="@L["Dialogs:JobConfigEditor:StartTime"]"
                                           Variant="Variant.Outlined" />
                        }

                        <!-- EndTime -->
                        <MudDatePicker @bind-Date="@_endDate"
                                       Label="@L["Dialogs:JobConfigEditor:EndTime"]"
                                       Variant="Variant.Outlined"
                                       HelperText="@L["Dialogs:JobConfigEditor:EndTimeHelper"]" />
                        @if (_endDate.HasValue)
                        {
                            <MudTimePicker @bind-Time="@_endTime"
                                           Label="@L["Dialogs:JobConfigEditor:EndTime"]"
                                           Variant="Variant.Outlined" />
                        }
                    }
                </MudStack>
            </MudForm>
        }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common:Actions:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@(!_success || _isLoading)">
            @L["Common:Actions:Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public JobDefinition JobDefinition { get; set; } = null!;

    private MudForm _form = null!;
    private bool _success;

    private string _jobName = string.Empty;
    private string _description = string.Empty;
    private int _maxConcurrency = 1;
    private int _retryCount = 0;
    private int _timeoutHours = 1;
    private int _timeoutMinutes = 0;
    private int _maxRetainedHistoryRecords = 100;
    private int? _maxRetentionDays;
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;

    private bool _isLoading = false;

    protected override void OnInitialized()
    {
        if (JobDefinition == null) return;

        _jobName = JobDefinition.JobName ?? string.Empty;
        _description = JobDefinition.Description ?? string.Empty;
        _maxConcurrency = JobDefinition.MaxConcurrency;
        _retryCount = JobDefinition.RetryCount;

        // Convert timeout to hours and minutes
        var totalMinutes = (int)JobDefinition.MaxExecutionTimeout.TotalMinutes;
        _timeoutHours = totalMinutes / 60;
        _timeoutMinutes = totalMinutes % 60;

        // Initialize retention fields
        _maxRetainedHistoryRecords = JobDefinition.MaxRetainedHistoryRecords;
        _maxRetentionDays = JobDefinition.MaxRetentionDays;

        // Set StartTime and EndTime for Recurring jobs
        if (JobDefinition.JobType == JobType.Recurring)
        {
            if (JobDefinition.StartTime.HasValue)
            {
                var startDateTime = JobDefinition.StartTime.Value.FromUtcToLocal();
                _startDate = startDateTime.Date;
                _startTime = startDateTime.TimeOfDay;
            }

            if (JobDefinition.EndTime.HasValue)
            {
                var endDateTime = JobDefinition.EndTime.Value.FromUtcToLocal();
                _endDate = endDateTime.Date;
                _endTime = endDateTime.TimeOfDay;
            }
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Save()
    {
        await _form.Validate();
        if (!_success) return;

        // Validation
        if (string.IsNullOrWhiteSpace(_jobName))
        {
            Snackbar.Add(L["Dialogs:JobConfigEditor:ValidationJobNameEmpty"], Severity.Warning);
            return;
        }

        if (_maxConcurrency < 1)
        {
            Snackbar.Add(L["Dialogs:JobConfigEditor:ValidationMaxConcurrency"], Severity.Warning);
            return;
        }

        if (_timeoutHours == 0 && _timeoutMinutes == 0)
        {
            Snackbar.Add(L["Dialogs:JobConfigEditor:ValidationTimeout"], Severity.Warning);
            return;
        }

        // Validation for retention fields
        if (_maxRetentionDays.HasValue && _maxRetentionDays.Value < 1)
        {
            Snackbar.Add(L["Dialogs:JobConfigEditor:ValidationRetentionDays"], Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            // Update job definition
            JobDefinition.JobName = _jobName;
            JobDefinition.Description = _description;
            JobDefinition.MaxConcurrency = _maxConcurrency;
            JobDefinition.RetryCount = _retryCount;

            // Update retention fields
            JobDefinition.MaxRetainedHistoryRecords = _maxRetainedHistoryRecords;
            JobDefinition.MaxRetentionDays = _maxRetentionDays;

            // Convert hours and minutes back to TimeSpan
            JobDefinition.MaxExecutionTimeout = new TimeSpan(_timeoutHours, _timeoutMinutes, 0);

            // Update StartTime and EndTime for Recurring jobs
            if (JobDefinition.JobType == JobType.Recurring)
            {
                if (_startDate.HasValue && _startTime.HasValue)
                {
                    var startDateTime = _startDate.Value.Add(_startTime.Value);
                    JobDefinition.StartTime = startDateTime.ToUniversalTime();
                }
                else
                {
                    JobDefinition.StartTime = null;
                }

                if (_endDate.HasValue && _endTime.HasValue)
                {
                    var endDateTime = _endDate.Value.Add(_endTime.Value);
                    JobDefinition.EndTime = endDateTime.ToUniversalTime();
                }
                else
                {
                    JobDefinition.EndTime = null;
                }
            }

            var result = await UIService.UpdateJobConfigAsync(JobDefinition);

            if (result.IsFailed(out var error))
            {
                Snackbar.Add($"{L["Dialogs:JobConfigEditor:SaveFailed"]}: {error.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add(L["Dialogs:JobConfigEditor:SaveSuccess"], Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Dialogs:JobConfigEditor:SaveFailed"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
