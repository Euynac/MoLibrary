@using Monica.JobScheduler.UI.Localization
@inject IStringLocalizer<JobSchedulerResource> L

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
            <MudAlert Severity="@GetSeverity()" Class="mb-3">
                <MudText>
                    @L["Dialogs:BatchOperationConfirm:Message", JobKeys.Count, L[$"Dialogs:BatchOperationConfirm:Operation{OperationType}"]]
                </MudText>
            </MudAlert>

            <div class="job-list-wrapper">
                <MudCard Outlined="true" Class="mb-3">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">@L["JobDefinitions:Columns:JobKey"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true" Class="batch-job-list">
                        @foreach (var jobKey in JobKeys.Take(10))
                        {
                            <MudListItem T="string">
                                <MudText Typo="Typo.body2">@jobKey</MudText>
                            </MudListItem>
                        }
                        @if (JobKeys.Count > 10)
                        {
                            <MudListItem T="string">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    ... @L["Common:Messages:AndMore", JobKeys.Count - 10]
                                </MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudCardContent>
            </MudCard>
            </div>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">
            @L["Common:Actions:Cancel"]
        </MudButton>
        <MudButton OnClick="Confirm"
                  Variant="Variant.Filled"
                  Color="@GetColor()"
                  StartIcon="@GetIcon()">
            @L["Common:Actions:Confirm"]@L[$"Dialogs:BatchOperationConfirm:Operation{OperationType}"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<string> JobKeys { get; set; } = [];
    [Parameter] public BatchOperationType OperationType { get; set; }

    private void Cancel() => MudDialog?.Cancel();
    private void Confirm() => MudDialog?.Close(DialogResult.Ok(true));

    private Severity GetSeverity() => OperationType == BatchOperationType.Pause
        ? Severity.Warning : Severity.Info;

    private Color GetColor() => OperationType == BatchOperationType.Pause
        ? Color.Warning : Color.Success;

    private string GetIcon() => OperationType == BatchOperationType.Pause
        ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow;
}
