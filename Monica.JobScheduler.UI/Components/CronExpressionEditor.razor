@using Monica.JobScheduler.UI.Localization
@using Microsoft.JSInterop
@inject CronExpressionService CronService
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject IStringLocalizer<JobSchedulerResource> L

<!-- 引入 cronstrue 库 -->
@if (!_cronstrueLoaded)
{
    <script src="_content/Monica.JobScheduler.UI/lib/cronstrue/cronstrue-i18n.min.js"></script>
}

<MudPaper Elevation="2" Class="pa-4">
    <MudStack Spacing="3">
        <!-- 标题和格式切换 -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">Cron 表达式编辑器</MudText>
            <MudChipSet T="CronFormat" @bind-SelectedValue="_format" @bind-SelectedValue:after="OnFormatChangedAsync" CheckMark SelectionMode="SelectionMode.SingleSelection">
                <MudChip T="CronFormat" Value="@CronFormat.Standard" Size="Size.Small">
                    Standard (5段)
                </MudChip>
                <MudChip T="CronFormat" Value="@CronFormat.Quartz" Size="Size.Small">
                    Quartz (6段)
                </MudChip>
            </MudChipSet>
        </MudStack>

        <!-- 表达式输入 -->
        <MudTextField @bind-Value="@Value"
                      T="string"
                      Label="Cron 表达式"
                      Placeholder="@GetPlaceholder()"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      OnBlur="OnExpressionChanged"
                      HelperText="@_helperText"
                      Error="@_hasError"
                      ErrorText="@_errorText" />

        <!-- 文字解析 -->
        @if (_isLoadingDescription)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <strong>解析中...</strong>
                </MudText>
            </MudAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_description))
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>解析：</strong>@_description
                </MudText>
            </MudAlert>
        }

        <!-- 近5次执行时间 -->
        @if (_nextOccurrences.Count > 0)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">
                    <strong>近5次执行时间</strong>
                </MudText>
                <MudStack Spacing="1">
                    @foreach (var (time, index) in _nextOccurrences.Select((t, i) => (t, i)))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(index + 1). @time.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")
                        </MudText>
                    }
                </MudStack>
            </MudPaper>
        }

        <!-- 操作按钮 -->
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Settings"
                       OnClick="@(() => _showSimpleSettings = !_showSimpleSettings)">
                @(_showSimpleSettings ? "隐藏" : "显示")简易设置
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Help"
                       OnClick="@(() => _showSyntaxGuide = !_showSyntaxGuide)">
                @(_showSyntaxGuide ? "隐藏" : "显示")语法说明
            </MudButton>
        </MudStack>

        <!-- 简易设置 -->
        @if (_showSimpleSettings)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle2" Class="mb-3">
                    <strong>简易设置</strong>
                </MudText>
                <MudStack Spacing="2">
                    <MudSelect @bind-Value="@_simpleSettings.Type"
                               T="SimpleSettingsType"
                               Label="类型"
                               Variant="Variant.Outlined"
                               Dense="true">
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryMinute">每分钟</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryHour">每小时</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryDay">每天</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryWeek">每周</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryMonth">每月</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.Custom">自定义</MudSelectItem>
                    </MudSelect>

                    @if (_simpleSettings.Type == SimpleSettingsType.Custom || _simpleSettings.Type == SimpleSettingsType.EveryDay || _simpleSettings.Type == SimpleSettingsType.EveryWeek || _simpleSettings.Type == SimpleSettingsType.EveryMonth)
                    {
                        <MudGrid Spacing="2">
                            @if (_format == CronFormat.Quartz && _simpleSettings.Type == SimpleSettingsType.Custom)
                            {
                                <MudItem xs="6" sm="4">
                                    <MudNumericField @bind-Value="@_simpleSettings.Second"
                                                     T="int"
                                                     Label="秒"
                                                     Min="0"
                                                     Max="59"
                                                     Variant="Variant.Outlined"
                                                     Dense="true" />
                                </MudItem>
                            }
                            <MudItem xs="6" sm="4">
                                <MudNumericField @bind-Value="@_simpleSettings.Minute"
                                                 T="int"
                                                 Label="分"
                                                 Min="0"
                                                 Max="59"
                                                 Variant="Variant.Outlined"
                                                 Dense="true" />
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudNumericField @bind-Value="@_simpleSettings.Hour"
                                                 T="int"
                                                 Label="时"
                                                 Min="0"
                                                 Max="23"
                                                 Variant="Variant.Outlined"
                                                 Dense="true" />
                            </MudItem>
                            @if (_simpleSettings.Type == SimpleSettingsType.EveryWeek)
                            {
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.DayOfWeek"
                                                  T="string"
                                                  Label="星期"
                                                  HelperText="0-6 (0=周日)"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                            }
                            @if (_simpleSettings.Type == SimpleSettingsType.EveryMonth)
                            {
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.DayOfMonth"
                                                  T="string"
                                                  Label="日期"
                                                  HelperText="1-31"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                            }
                            @if (_simpleSettings.Type == SimpleSettingsType.Custom)
                            {
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.DayOfMonth"
                                                  T="string"
                                                  Label="日"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.Month"
                                                  T="string"
                                                  Label="月"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.DayOfWeek"
                                                  T="string"
                                                  Label="周"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                            }
                        </MudGrid>
                    }

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="ApplySimpleSettings"
                               FullWidth="true">
                        应用设置
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <!-- 语法说明 -->
        @if (_showSyntaxGuide)
        {
            <MudPaper Outlined="true" Class="pa-3 syntax-guide">
                <MudText Typo="Typo.subtitle2" Class="mb-3">
                    <strong>Cron 表达式语法说明</strong>
                </MudText>

                @if (_format == CronFormat.Quartz)
                {
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Quartz 格式（6段）：</strong>秒 分 时 日 月 周
                    </MudText>
                    <MudTable T="CronFieldInfo" Items="@_quartzFields" Hover="false" Dense="true" Breakpoint="Breakpoint.None" Elevation="0">
                        <HeaderContent>
                            <MudTh>字段</MudTh>
                            <MudTh>允许值</MudTh>
                            <MudTh>特殊字符</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="字段">@context.Field</MudTd>
                            <MudTd DataLabel="允许值">@context.AllowedValues</MudTd>
                            <MudTd DataLabel="特殊字符">@context.SpecialChars</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Standard 格式（5段）：</strong>分 时 日 月 周
                    </MudText>
                    <MudTable T="CronFieldInfo" Items="@_standardFields" Hover="false" Dense="true" Breakpoint="Breakpoint.None" Elevation="0">
                        <HeaderContent>
                            <MudTh>字段</MudTh>
                            <MudTh>允许值</MudTh>
                            <MudTh>特殊字符</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="字段">@context.Field</MudTd>
                            <MudTd DataLabel="允许值">@context.AllowedValues</MudTd>
                            <MudTd DataLabel="特殊字符">@context.SpecialChars</MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.body2" Class="mb-2">
                    <strong>特殊字符说明：</strong>
                </MudText>
                <MudList T="string" Dense="true" DisablePadding="true">
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>*</code> - 所有值
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>?</code> - 不指定值（仅用于日和周字段）
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>-</code> - 范围，例如：10-12
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>,</code> - 列表，例如：1,3,5
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>/</code> - 增量，例如：*/5 表示每5个单位
                        </MudText>
                    </MudListItem>
                </MudList>

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.body2" Class="mb-2">
                    <strong>示例：</strong>
                </MudText>
                <MudList T="string" Dense="true" DisablePadding="true">
                    @if (_format == CronFormat.Quartz)
                    {
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0/5 * * * ?</code> - 每5分钟执行一次
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0 12 * * ?</code> - 每天12:00执行
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0 9 ? * MON-FRI</code> - 工作日09:00执行
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0 0 1 * ?</code> - 每月1号00:00执行
                            </MudText>
                        </MudListItem>
                    }
                    else
                    {
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>*/5 * * * *</code> - 每5分钟执行一次
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 12 * * *</code> - 每天12:00执行
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 9 * * 1-5</code> - 工作日09:00执行
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0 1 * *</code> - 每月1号00:00执行
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@implements IAsyncDisposable

@code {
    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public CronFormat InitialFormat { get; set; } = CronFormat.Quartz;

    private CronFormat _format;
    private bool _showSimpleSettings = false;
    private bool _showSyntaxGuide = false;
    private bool _hasError = false;
    private string _errorText = string.Empty;
    private string _helperText = string.Empty;
    private string _description = string.Empty;
    private List<DateTime> _nextOccurrences = new();
    private SimpleSettings _simpleSettings = new();
    private bool _cronstrueLoaded = false;
    private bool _isLoadingDescription = false;
    private IJSObjectReference? _jsModule;

    private List<CronFieldInfo> _quartzFields = new()
    {
        new CronFieldInfo { Field = "秒", AllowedValues = "0-59", SpecialChars = "* , - /" },
        new CronFieldInfo { Field = "分", AllowedValues = "0-59", SpecialChars = "* , - /" },
        new CronFieldInfo { Field = "时", AllowedValues = "0-23", SpecialChars = "* , - /" },
        new CronFieldInfo { Field = "日", AllowedValues = "1-31", SpecialChars = "* , - / ? L W" },
        new CronFieldInfo { Field = "月", AllowedValues = "1-12 或 JAN-DEC", SpecialChars = "* , - /" },
        new CronFieldInfo { Field = "周", AllowedValues = "0-6 或 SUN-SAT", SpecialChars = "* , - / ? L #" }
    };

    private List<CronFieldInfo> _standardFields = new()
    {
        new CronFieldInfo { Field = "分", AllowedValues = "0-59", SpecialChars = "* , - /" },
        new CronFieldInfo { Field = "时", AllowedValues = "0-23", SpecialChars = "* , - /" },
        new CronFieldInfo { Field = "日", AllowedValues = "1-31", SpecialChars = "* , - /" },
        new CronFieldInfo { Field = "月", AllowedValues = "1-12", SpecialChars = "* , - /" },
        new CronFieldInfo { Field = "周", AllowedValues = "0-7 (0或7=周日)", SpecialChars = "* , - /" }
    };

    protected override void OnInitialized()
    {
        _format = InitialFormat;
        _helperText = _format == CronFormat.Quartz ? "格式：秒 分 时 日 月 周" : "格式：分 时 日 月 周";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // 加载 JavaScript 模块
                _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/Monica.JobScheduler.UI/js/cron-helper.js");

                _cronstrueLoaded = true;

                if (!string.IsNullOrWhiteSpace(Value))
                {
                    await UpdatePreview();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                // JS 模块加载失败，记录错误但不阻止组件渲染
                _cronstrueLoaded = false;
                Snackbar.Add($"{L["Common:Messages:LoadFailed"]}: {ex.Message}", Severity.Warning);
            }
        }
    }

    private string GetPlaceholder()
    {
        return _format == CronFormat.Quartz ? "0 0/5 * * * ?" : "*/5 * * * *";
    }

    private async Task OnFormatChangedAsync()
    {
        // _format 已由双向绑定自动更新

        // 尝试转换现有表达式（如果有的话）
        if (!string.IsNullOrWhiteSpace(Value))
        {
            // 根据当前格式推断原格式
            var parts = Value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var oldFormat = parts.Length == 6 ? CronFormat.Quartz : CronFormat.Standard;

            // 只有格式真的不同时才转换
            if (oldFormat != _format)
            {
                var result = CronService.ConvertFormat(Value, oldFormat, _format);
                if (result.IsFailed(out var error, out var convertedExpr))
                {
                    Snackbar.Add($"格式转换失败: {error.Message}", Severity.Error);
                }
                else
                {
                    Value = convertedExpr;
                    await ValueChanged.InvokeAsync(Value);
                }
            }
        }

        _helperText = _format == CronFormat.Quartz ? "格式：秒 分 时 日 月 周" : "格式：分 时 日 月 周";
        await UpdatePreview();
    }

    private async Task OnExpressionChanged()
    {
        await UpdatePreview();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task UpdatePreview()
    {
        if (string.IsNullOrWhiteSpace(Value))
        {
            _hasError = false;
            _errorText = string.Empty;
            _description = string.Empty;
            _nextOccurrences.Clear();
            return;
        }

        // 验证表达式（同步验证）
        var validation = CronService.ValidateExpression(Value, _format);
        if (validation.IsFailed(out var error))
        {
            _hasError = true;
            _errorText = error.Message ?? string.Empty;
            _description = string.Empty;
            _nextOccurrences.Clear();
            return;
        }

        _hasError = false;
        _errorText = string.Empty;

        // 异步获取文字描述（仅在 JS 模块已加载时）
        if (_jsModule != null)
        {
            _isLoadingDescription = true;
            StateHasChanged(); // 立即更新 UI 显示加载状态

            try
            {
                var descResult = await CronService.ParseToDescriptionAsync(_jsModule, Value, _format);
                if (descResult.IsFailed(out var descError, out var description))
                {
                    _description = string.Empty;
                    Snackbar.Add($"解析描述失败: {descError.Message}", Severity.Warning);
                }
                else
                {
                    _description = description;
                }
            }
            finally
            {
                _isLoadingDescription = false;
            }
        }
        else
        {
            _description = string.Empty;
        }

        // 获取执行时间（同步）
        var occurrences = CronService.GetNextOccurrences(Value, _format, 5);
        if (occurrences.IsFailed(out var occError, out var occurrenceList))
        {
            _nextOccurrences = new List<DateTime>();
            Snackbar.Add($"计算执行时间失败: {occError.Message}", Severity.Warning);
        }
        else
        {
            _nextOccurrences = occurrenceList;
        }
    }

    private async Task ApplySimpleSettings()
    {
        var result = CronService.BuildFromSimpleSettings(_simpleSettings, _format);
        if (result.IsFailed(out var error, out var expression))
        {
            _hasError = true;
            _errorText = error.Message ?? "生成表达式失败";
            Snackbar.Add($"生成表达式失败: {_errorText}", Severity.Error);
            StateHasChanged();
        }
        else
        {
            Value = expression;
            await ValueChanged.InvokeAsync(Value);
            await UpdatePreview();
            StateHasChanged();
        }
    }

    private class CronFieldInfo
    {
        public string Field { get; set; } = string.Empty;
        public string AllowedValues { get; set; } = string.Empty;
        public string SpecialChars { get; set; } = string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            await _jsModule.DisposeAsync();
        }
    }
}
