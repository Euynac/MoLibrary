@using Monica.JobScheduler.UI.Localization
@using Microsoft.JSInterop
@using Monica.JobScheduler.UI.UIJobScheduler.Shared.Support
@inject CronExpressionSupport CronService
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject IStringLocalizer<JobSchedulerResource> L

<!-- Introduce cronstrue library -->
@if (!_cronstrueLoaded)
{
    <script src="_content/Monica.JobScheduler.UI/lib/cronstrue/cronstrue-i18n.min.js"></script>
}

<MudPaper Elevation="2" Class="pa-4">
    <MudStack Spacing="3">
        <!-- Title and format switching -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@L["Components:CronExpressionEditor:Title"]</MudText>
            <MudChipSet T="CronFormat" @bind-SelectedValue="_format" @bind-SelectedValue:after="OnFormatChangedAsync" CheckMark SelectionMode="SelectionMode.SingleSelection">
                <MudChip T="CronFormat" Value="@CronFormat.Standard" Size="Size.Small">
                    @L["Components:CronExpressionEditor:FormatStandard"]
                </MudChip>
                <MudChip T="CronFormat" Value="@CronFormat.Quartz" Size="Size.Small">
                    @L["Components:CronExpressionEditor:FormatQuartz"]
                </MudChip>
            </MudChipSet>
        </MudStack>

        <!-- expression input -->
        <MudTextField @bind-Value="@Value"
                      T="string"
                      Label="@L["Components:CronExpressionEditor:ExpressionLabel"]"
                      Placeholder="@GetPlaceholder()"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      OnBlur="OnExpressionChanged"
                      HelperText="@_helperText"
                      Error="@_hasError"
                      ErrorText="@_errorText" />

        <!-- Text analysis -->
        @if (_isLoadingDescription)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <strong>@L["Components:CronExpressionEditor:Parsing"]</strong>
                </MudText>
            </MudAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_description))
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>@L["Components:CronExpressionEditor:DescriptionPrefix"]</strong>@_description
                </MudText>
            </MudAlert>
        }

        <!-- Last 5 execution times -->
        @if (_nextOccurrences.Count > 0)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">
                    <strong>@L["Components:CronExpressionEditor:NextOccurrencesTitle"]</strong>
                </MudText>
                <MudStack Spacing="1">
                    @foreach (var (time, index) in _nextOccurrences.Select((t, i) => (t, i)))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(index + 1). @time.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")
                        </MudText>
                    }
                </MudStack>
            </MudPaper>
        }

        <!-- Action button -->
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Settings"
                       OnClick="@(() => _showSimpleSettings = !_showSimpleSettings)">
                @GetToggleText(_showSimpleSettings, L["Components:CronExpressionEditor:SimpleSettingsToggleTarget"].Value)
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Help"
                       OnClick="@(() => _showSyntaxGuide = !_showSyntaxGuide)">
                @GetToggleText(_showSyntaxGuide, L["Components:CronExpressionEditor:SyntaxGuideToggleTarget"].Value)
            </MudButton>
        </MudStack>

        <!-- Easy setup -->
        @if (_showSimpleSettings)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle2" Class="mb-3">
                    <strong>@L["Components:CronExpressionEditor:SimpleSettingsTitle"]</strong>
                </MudText>
                <MudStack Spacing="2">
                    <MudSelect @bind-Value="@_simpleSettings.Type"
                               T="SimpleSettingsType"
                               Label="@L["Components:CronExpressionEditor:TypeLabel"]"
                               Variant="Variant.Outlined"
                               Dense="true">
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryMinute">@L["Components:CronExpressionEditor:SimpleTypeEveryMinute"]</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryHour">@L["Components:CronExpressionEditor:SimpleTypeEveryHour"]</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryDay">@L["Components:CronExpressionEditor:SimpleTypeEveryDay"]</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryWeek">@L["Components:CronExpressionEditor:SimpleTypeEveryWeek"]</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.EveryMonth">@L["Components:CronExpressionEditor:SimpleTypeEveryMonth"]</MudSelectItem>
                        <MudSelectItem T="SimpleSettingsType" Value="SimpleSettingsType.Custom">@L["Components:CronExpressionEditor:SimpleTypeCustom"]</MudSelectItem>
                    </MudSelect>

                    @if (_simpleSettings.Type == SimpleSettingsType.Custom || _simpleSettings.Type == SimpleSettingsType.EveryDay || _simpleSettings.Type == SimpleSettingsType.EveryWeek || _simpleSettings.Type == SimpleSettingsType.EveryMonth)
                    {
                        <MudGrid Spacing="2">
                            @if (_format == CronFormat.Quartz && _simpleSettings.Type == SimpleSettingsType.Custom)
                            {
                                <MudItem xs="6" sm="4">
                                    <MudNumericField @bind-Value="@_simpleSettings.Second"
                                                     T="int"
                                                     Label="@L["Components:CronExpressionEditor:FieldSecond"]"
                                                     Min="0"
                                                     Max="59"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense" />
                                </MudItem>
                            }
                            <MudItem xs="6" sm="4">
                                <MudNumericField @bind-Value="@_simpleSettings.Minute"
                                                 T="int"
                                                 Label="@L["Components:CronExpressionEditor:FieldMinute"]"
                                                 Min="0"
                                                 Max="59"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudNumericField @bind-Value="@_simpleSettings.Hour"
                                                 T="int"
                                                 Label="@L["Components:CronExpressionEditor:FieldHour"]"
                                                 Min="0"
                                                 Max="23"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>
                            @if (_simpleSettings.Type == SimpleSettingsType.EveryWeek)
                            {
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.DayOfWeek"
                                                  T="string"
                                                  Label="@L["Components:CronExpressionEditor:FieldWeekday"]"
                                                  HelperText="@L["Components:CronExpressionEditor:WeekdayHelper"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            }
                            @if (_simpleSettings.Type == SimpleSettingsType.EveryMonth)
                            {
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.DayOfMonth"
                                                  T="string"
                                                  Label="@L["Components:CronExpressionEditor:FieldDate"]"
                                                  HelperText="@L["Components:CronExpressionEditor:DayOfMonthHelper"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            }
                            @if (_simpleSettings.Type == SimpleSettingsType.Custom)
                            {
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.DayOfMonth"
                                                  T="string"
                                                  Label="@L["Components:CronExpressionEditor:FieldDay"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.Month"
                                                  T="string"
                                                  Label="@L["Components:CronExpressionEditor:FieldMonth"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="@_simpleSettings.DayOfWeek"
                                                  T="string"
                                                  Label="@L["Components:CronExpressionEditor:FieldWeek"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            }
                        </MudGrid>
                    }

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="ApplySimpleSettings"
                               FullWidth="true">
                        @L["Components:CronExpressionEditor:ApplySettings"]
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <!-- Grammar instructions -->
        @if (_showSyntaxGuide)
        {
            <MudPaper Outlined="true" Class="pa-3 syntax-guide">
                <MudText Typo="Typo.subtitle2" Class="mb-3">
                    <strong>@L["Components:CronExpressionEditor:SyntaxGuideTitle"]</strong>
                </MudText>

                @if (_format == CronFormat.Quartz)
                {
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>@L["Components:CronExpressionEditor:QuartzSyntaxPrefix"]</strong>@L["Components:CronExpressionEditor:QuartzSyntaxFields"]
                    </MudText>
                    <MudTable T="CronFieldInfo" Items="@GetQuartzFields()" Hover="false" Dense="true" Breakpoint="Breakpoint.None" Elevation="0">
                        <HeaderContent>
                            <MudTh>@L["Components:CronExpressionEditor:FieldColumn"]</MudTh>
                            <MudTh>@L["Components:CronExpressionEditor:AllowedValuesColumn"]</MudTh>
                            <MudTh>@L["Components:CronExpressionEditor:SpecialCharsColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["Components:CronExpressionEditor:FieldColumn"]">@context.Field</MudTd>
                            <MudTd DataLabel="@L["Components:CronExpressionEditor:AllowedValuesColumn"]">@context.AllowedValues</MudTd>
                            <MudTd DataLabel="@L["Components:CronExpressionEditor:SpecialCharsColumn"]">@context.SpecialChars</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>@L["Components:CronExpressionEditor:StandardSyntaxPrefix"]</strong>@L["Components:CronExpressionEditor:StandardSyntaxFields"]
                    </MudText>
                    <MudTable T="CronFieldInfo" Items="@GetStandardFields()" Hover="false" Dense="true" Breakpoint="Breakpoint.None" Elevation="0">
                        <HeaderContent>
                            <MudTh>@L["Components:CronExpressionEditor:FieldColumn"]</MudTh>
                            <MudTh>@L["Components:CronExpressionEditor:AllowedValuesColumn"]</MudTh>
                            <MudTh>@L["Components:CronExpressionEditor:SpecialCharsColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["Components:CronExpressionEditor:FieldColumn"]">@context.Field</MudTd>
                            <MudTd DataLabel="@L["Components:CronExpressionEditor:AllowedValuesColumn"]">@context.AllowedValues</MudTd>
                            <MudTd DataLabel="@L["Components:CronExpressionEditor:SpecialCharsColumn"]">@context.SpecialChars</MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.body2" Class="mb-2">
                    <strong>@L["Components:CronExpressionEditor:SpecialCharsTitle"]</strong>
                </MudText>
                <MudList T="string" Dense="true" Padding="false">
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>*</code> - @L["Components:CronExpressionEditor:SpecialCharAll"]
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>?</code> - @L["Components:CronExpressionEditor:SpecialCharNoSpecificValue"]
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>-</code> - @L["Components:CronExpressionEditor:SpecialCharRange"]
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>,</code> - @L["Components:CronExpressionEditor:SpecialCharList"]
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">
                            <code>/</code> - @L["Components:CronExpressionEditor:SpecialCharIncrement"]
                        </MudText>
                    </MudListItem>
                </MudList>

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.body2" Class="mb-2">
                    <strong>@L["Components:CronExpressionEditor:ExamplesTitle"]</strong>
                </MudText>
                <MudList T="string" Dense="true" Padding="false">
                    @if (_format == CronFormat.Quartz)
                    {
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0/5 * * * ?</code> - @L["Components:CronExpressionEditor:ExampleEveryFiveMinutes"]
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0 12 * * ?</code> - @L["Components:CronExpressionEditor:ExampleEveryDayNoon"]
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0 9 ? * MON-FRI</code> - @L["Components:CronExpressionEditor:ExampleWeekdaysNine"]
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0 0 1 * ?</code> - @L["Components:CronExpressionEditor:ExampleMonthlyFirst"]
                            </MudText>
                        </MudListItem>
                    }
                    else
                    {
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>*/5 * * * *</code> - @L["Components:CronExpressionEditor:ExampleEveryFiveMinutes"]
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 12 * * *</code> - @L["Components:CronExpressionEditor:ExampleEveryDayNoon"]
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 9 * * 1-5</code> - @L["Components:CronExpressionEditor:ExampleWeekdaysNine"]
                            </MudText>
                        </MudListItem>
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <code>0 0 1 * *</code> - @L["Components:CronExpressionEditor:ExampleMonthlyFirst"]
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@implements IAsyncDisposable

@code {
    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public CronFormat InitialFormat { get; set; } = CronFormat.Quartz;

    private CronFormat _format;
    private bool _showSimpleSettings = false;
    private bool _showSyntaxGuide = false;
    private bool _hasError = false;
    private string _errorText = string.Empty;
    private string _helperText = string.Empty;
    private string _description = string.Empty;
    private List<DateTime> _nextOccurrences = new();
    private SimpleSettings _simpleSettings = new();
    private bool _cronstrueLoaded = false;
    private bool _isLoadingDescription = false;
    private IJSObjectReference? _jsModule;

    protected override void OnInitialized()
    {
        _format = InitialFormat;
        SetFormatHelperText();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Load JavaScript module
                _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/Monica.JobScheduler.UI/js/cron-helper.js");

                _cronstrueLoaded = true;

                if (!string.IsNullOrWhiteSpace(Value))
                {
                    await UpdatePreview();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                // JS module loading fails, logging errors but not preventing component rendering
                _cronstrueLoaded = false;
                Snackbar.Add($"{L["Common:Messages:LoadFailed"]}: {ex.Message}", Severity.Warning);
            }
        }
    }

    private string GetPlaceholder()
    {
        return _format == CronFormat.Quartz ? "0 0/5 * * * ?" : "*/5 * * * *";
    }

    private async Task OnFormatChangedAsync()
    {
        // _format has been automatically updated by two-way binding

        // Attempts to convert existing expressions (if any)
        if (!string.IsNullOrWhiteSpace(Value))
        {
            // Infer the original format from the current format
            var parts = Value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var oldFormat = parts.Length == 6 ? CronFormat.Quartz : CronFormat.Standard;

            // Only convert if the format is really different
            if (oldFormat != _format)
            {
                var result = CronService.ConvertFormat(Value, oldFormat, _format);
                if (result.IsFailed(out var error, out var convertedExpr))
                {
                    Snackbar.Add(L["Components:CronExpressionEditor:FormatConversionFailed", error.Message ?? string.Empty], Severity.Error);
                }
                else
                {
                    Value = convertedExpr;
                    await ValueChanged.InvokeAsync(Value);
                }
            }
        }

        SetFormatHelperText();
        await UpdatePreview();
    }

    private async Task OnExpressionChanged()
    {
        await UpdatePreview();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task UpdatePreview()
    {
        if (string.IsNullOrWhiteSpace(Value))
        {
            _hasError = false;
            _errorText = string.Empty;
            _description = string.Empty;
            _nextOccurrences.Clear();
            return;
        }

        // Validate expressions (synchronous validation)
        var validation = CronService.ValidateExpression(Value, _format);
        if (validation.IsFailed(out var error))
        {
            _hasError = true;
            _errorText = error.Message ?? string.Empty;
            _description = string.Empty;
            _nextOccurrences.Clear();
            return;
        }

        _hasError = false;
        _errorText = string.Empty;

        // Get text description asynchronously (only when JS module is loaded)
        if (_jsModule != null)
        {
            _isLoadingDescription = true;
            StateHasChanged(); // Refresh immediately so the loading state is visible.

            try
            {
                var descResult = await CronService.ParseToDescriptionAsync(_jsModule, Value, _format);
                if (descResult.IsFailed(out var descError, out var description))
                {
                    _description = string.Empty;
                    Snackbar.Add(L["Components:CronExpressionEditor:DescriptionParseFailed", descError.Message ?? string.Empty], Severity.Warning);
                }
                else
                {
                    _description = description;
                }
            }
            finally
            {
                _isLoadingDescription = false;
            }
        }
        else
        {
            _description = string.Empty;
        }

        // Get execution time (synchronous)
        var occurrences = CronService.GetNextOccurrences(Value, _format, 5);
        if (occurrences.IsFailed(out var occError, out var occurrenceList))
        {
            _nextOccurrences = new List<DateTime>();
            Snackbar.Add(L["Components:CronExpressionEditor:CalculateOccurrencesFailed", occError.Message ?? string.Empty], Severity.Warning);
        }
        else
        {
            _nextOccurrences = occurrenceList;
        }
    }

    private async Task ApplySimpleSettings()
    {
        var result = CronService.BuildFromSimpleSettings(_simpleSettings, _format);
        if (result.IsFailed(out var error, out var expression))
        {
            _hasError = true;
            _errorText = error.Message ?? L["Components:CronExpressionEditor:BuildExpressionFailed"].Value;
            Snackbar.Add(L["Components:CronExpressionEditor:BuildExpressionFailedWithMessage", _errorText], Severity.Error);
            StateHasChanged();
        }
        else
        {
            Value = expression;
            await ValueChanged.InvokeAsync(Value);
            await UpdatePreview();
            StateHasChanged();
        }
    }

    private class CronFieldInfo
    {
        public string Field { get; set; } = string.Empty;
        public string AllowedValues { get; set; } = string.Empty;
        public string SpecialChars { get; set; } = string.Empty;
    }

    private void SetFormatHelperText()
    {
        _helperText = _format == CronFormat.Quartz
            ? L["Components:CronExpressionEditor:QuartzFormatHelper"].Value
            : L["Components:CronExpressionEditor:StandardFormatHelper"].Value;
    }

    private string GetToggleText(bool isVisible, string target)
    {
        return isVisible
            ? L["Components:CronExpressionEditor:HideToggle", target].Value
            : L["Components:CronExpressionEditor:ShowToggle", target].Value;
    }

    private List<CronFieldInfo> GetQuartzFields()
    {
        return new List<CronFieldInfo>
        {
            new() { Field = L["Components:CronExpressionEditor:FieldSecond"].Value, AllowedValues = "0-59", SpecialChars = "* , - /" },
            new() { Field = L["Components:CronExpressionEditor:FieldMinute"].Value, AllowedValues = "0-59", SpecialChars = "* , - /" },
            new() { Field = L["Components:CronExpressionEditor:FieldHour"].Value, AllowedValues = "0-23", SpecialChars = "* , - /" },
            new() { Field = L["Components:CronExpressionEditor:FieldDay"].Value, AllowedValues = "1-31", SpecialChars = "* , - / ? L W" },
            new() { Field = L["Components:CronExpressionEditor:FieldMonth"].Value, AllowedValues = L["Components:CronExpressionEditor:QuartzMonthAllowedValues"].Value, SpecialChars = "* , - /" },
            new() { Field = L["Components:CronExpressionEditor:FieldWeek"].Value, AllowedValues = L["Components:CronExpressionEditor:QuartzWeekAllowedValues"].Value, SpecialChars = "* , - / ? L #" }
        };
    }

    private List<CronFieldInfo> GetStandardFields()
    {
        return new List<CronFieldInfo>
        {
            new() { Field = L["Components:CronExpressionEditor:FieldMinute"].Value, AllowedValues = "0-59", SpecialChars = "* , - /" },
            new() { Field = L["Components:CronExpressionEditor:FieldHour"].Value, AllowedValues = "0-23", SpecialChars = "* , - /" },
            new() { Field = L["Components:CronExpressionEditor:FieldDay"].Value, AllowedValues = "1-31", SpecialChars = "* , - /" },
            new() { Field = L["Components:CronExpressionEditor:FieldMonth"].Value, AllowedValues = "1-12", SpecialChars = "* , - /" },
            new() { Field = L["Components:CronExpressionEditor:FieldWeek"].Value, AllowedValues = L["Components:CronExpressionEditor:StandardWeekAllowedValues"].Value, SpecialChars = "* , - /" }
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            await _jsModule.DisposeAsync();
        }
    }
}
