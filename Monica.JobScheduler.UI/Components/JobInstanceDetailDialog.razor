@using System.Text.Encodings.Web
@using System.Text.Json
@inject JobSchedulerUIService UIService
@inject JobStateColorService ColorService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.h6">加载中...</MudText>
            </MudStack>
        }
        else if (_error != null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        else if (_jobInstance != null)
        {
            <!-- 操作按钮 -->
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudStack Row="true" Spacing="2">
                    @if (ShowJobDefinitionButton)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Description"
                                   OnClick="@NavigateToJobDefinition">
                            查看作业定义
                        </MudButton>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Primary"
                                   OnClick="RefreshAsync" />
                    @if (IsCancellable())
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="_isCancelling"
                                   OnClick="CancelInstanceAsync">
                            @if (_isCancelling)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            取消作业
                        </MudButton>
                    }
                </MudStack>
            </MudStack>

            <!-- 基本信息 -->
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">基本信息</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">实例ID</MudText>
                        <MudText Typo="Typo.body1" Style="font-family: monospace;">@_jobInstance.InstanceId</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">作业键</MudText>
                        <MudText Typo="Typo.body1">@_jobInstance.JobKey</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">运行客户端</MudText>
                        <MudText Typo="Typo.body1" Style="font-family: monospace;">@(_jobInstance.RunningClientId ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">状态</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@ColorService.GetStateColor(_jobInstance.State)">
                            @_jobInstance.State
                        </MudChip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">重试次数</MudText>
                        <MudText Typo="Typo.body1" Color="@(_jobInstance.RetryAttempt > 0 ? Color.Warning : Color.Default)">@_jobInstance.RetryAttempt</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">创建时间</MudText>
                        <MudText Typo="Typo.body1">@_jobInstance.CreatedAt.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">计划执行时间</MudText>
                        <MudText Typo="Typo.body1">@(_jobInstance.ScheduledExecutionTime?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss.fff") ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">开始时间</MudText>
                        <MudText Typo="Typo.body1">@(_jobInstance.StartedAt?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss.fff") ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">结束时间</MudText>
                        <MudText Typo="Typo.body1">@(_jobInstance.CompletedAt?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss.fff") ?? "-")</MudText>
                    </MudItem>
                    @if (_jobInstance.StartedAt.HasValue)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">执行时长</MudText>
                            <MudText Typo="Typo.body1">
                                @if (_jobInstance.CompletedAt.HasValue)
                                {
                                    var duration = _jobInstance.CompletedAt.Value - _jobInstance.StartedAt.Value;
                                    @FormatDuration(duration)
                                }
                                else
                                {
                                    var duration = DateTime.UtcNow.FromUtcToLocal() - _jobInstance.StartedAt.Value.FromUtcToLocal();
                                    <text>@FormatDuration(duration) (运行中)</text>
                                }
                            </MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            <!-- 作业参数 -->
            @if (!string.IsNullOrEmpty(_jobInstance.JobArgs))
            {
                <MudPaper Class="pa-4 mb-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-3">作业参数</MudText>
                    <MudTextField T="string"
                                  Value="@FormatJobArgs(_jobInstance.JobArgs)"
                                  ReadOnly="true"
                                  Variant="Variant.Outlined"
                                  Lines="10"
                                  AutoGrow="true"
                                  Style="font-family: monospace;" />
                </MudPaper>
            }

            <!-- 状态历史 -->
            <StateHistoryViewer Instance="@_jobInstance" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">关闭</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string InstanceId { get; set; } = string.Empty;

    [Parameter]
    public bool ShowJobDefinitionButton { get; set; } = false;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private JobInstance? _jobInstance;
    private bool _isLoading = true;
    private bool _isCancelling;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadJobInstanceAsync();
    }

    private async Task LoadJobInstanceAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var result = await UIService.GetJobInstanceAsync(InstanceId);
            if (result.IsFailed(out var error, out var data))
            {
                _error = $"加载失败: {error.Message}";
            }
            else
            {
                _jobInstance = data;
            }
        }
        catch (Exception ex)
        {
            _error = $"加载失败: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        await LoadJobInstanceAsync();
        StateHasChanged();
    }

    private void NavigateToJobDefinition()
    {
        if (_jobInstance != null)
        {
            MudDialog.Close();
            NavigationManager.NavigateTo($"/job-scheduler/definitions/{Uri.EscapeDataString(_jobInstance.JobKey)}");
        }
    }

    private void Close()
    {
        MudDialog.Close();
    }

    private bool IsCancellable() =>
        _jobInstance?.State is JobState.Scheduled or JobState.Enqueued or JobState.Processing;

    private async Task CancelInstanceAsync()
    {
        if (_jobInstance == null) return;

        var confirmed = await DialogService.ShowMessageBox(
            "确认取消",
            $"确定要取消作业实例 {_jobInstance.InstanceId} 吗？",
            yesText: "确定",
            cancelText: "取消");

        if (confirmed != true) return;

        _isCancelling = true;
        StateHasChanged();

        try
        {
            var result = await UIService.CancelInstanceAsync(_jobInstance.InstanceId);
            if (result.IsFailed(out var error))
            {
                Snackbar.Add($"取消失败: {error.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add("作业已取消", Severity.Success);
                await LoadJobInstanceAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"取消失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCancelling = false;
            StateHasChanged();
        }
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return $"{duration.TotalHours:F2}h";
        if (duration.TotalMinutes >= 1)
            return $"{duration.TotalMinutes:F2}m";
        if (duration.TotalSeconds >= 1)
            return $"{duration.TotalSeconds:F2}s";
        return $"{duration.TotalMilliseconds:F0}ms";
    }

    private static string FormatJobArgs(string? jobArgs)
    {
        if (string.IsNullOrEmpty(jobArgs)) return string.Empty;
        try
        {
            using var doc = JsonDocument.Parse(jobArgs);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
        }
        catch
        {
            return jobArgs;
        }
    }
}
