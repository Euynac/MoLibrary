@using Microsoft.JSInterop
@using System.Text.Encodings.Web
@using System.Text.Json
@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Shared.Support
@inject JobSchedulerFacade UIService
@inject JobSchedulerQueryFacade QueryService
@inject JobStateColorResolver ColorService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<JobSchedulerResource> L

<MudDialog>
    <DialogContent>
        <div class="job-instance-detail">
        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.h6">@L["Common:Status:Loading"]</MudText>
            </MudStack>
        }
        else if (_error != null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        else if (_jobInstance != null)
        {
            <!-- Action buttons -->
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudStack Row="true" Spacing="2">
                    @if (ShowJobDefinitionButton)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Description"
                                   OnClick="@NavigateToJobDefinition">
                            @L["Dialogs:JobInstanceDetail:ViewJobDefinition"]
                        </MudButton>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Primary"
                                   OnClick="RefreshAsync" />
                    @if (IsCancellable())
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="_isCancelling"
                                   OnClick="CancelInstanceAsync">
                            @if (_isCancelling)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            @L["Dialogs:JobInstanceDetail:CancelJob"]
                        </MudButton>
                    }
                </MudStack>
            </MudStack>

            <!-- Basic information -->
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">@L["Dialogs:JobInstanceDetail:BasicInfo"]</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="4">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:InstanceId"]</MudText>
                            <MudTooltip Text="@_jobInstance.InstanceId">
                                <MudLink Typo="Typo.body1"
                                         Class="job-instance-detail__instance-link"
                                         OnClick="CopyInstanceIdAsync">
                                    @_jobInstance.InstanceId
                                </MudLink>
                            </MudTooltip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:JobKey"]</MudText>
                        <MudText Typo="Typo.body1" Class="job-instance-detail__breakable" title="@_jobInstance.JobKey">@_jobInstance.JobKey</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:RunningClient"]</MudText>
                        <MudText Typo="Typo.body1" Class="job-instance-detail__breakable job-instance-detail__mono" title="@_jobInstance.RunningClientId">@(_jobInstance.RunningClientId ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudStack Spacing="1" AlignItems="AlignItems.Start">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:State"]</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@ColorService.GetStateColor(_jobInstance.State)">
                                @_jobInstance.State
                            </MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:RetryCount"]</MudText>
                        <MudText Typo="Typo.body1" Color="@(_jobInstance.RetryAttempt > 0 ? Color.Warning : Color.Default)">@_jobInstance.RetryAttempt</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:CreatedTime"]</MudText>
                        <MudText Typo="Typo.body1">@_jobInstance.CreatedAt.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:ScheduledExecutionTime"]</MudText>
                        <MudText Typo="Typo.body1">@(_jobInstance.ScheduledExecutionTime?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss.fff") ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:StartTime"]</MudText>
                        <MudText Typo="Typo.body1">@(_jobInstance.StartedAt?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss.fff") ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:EndTime"]</MudText>
                        <MudText Typo="Typo.body1">@(_jobInstance.CompletedAt?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss.fff") ?? "-")</MudText>
                    </MudItem>
                    @if (_jobInstance.StartedAt.HasValue)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:JobInstanceDetail:Duration"]</MudText>
                            <MudText Typo="Typo.body1">
                                @if (_jobInstance.CompletedAt.HasValue)
                                {
                                    var duration = _jobInstance.CompletedAt.Value - _jobInstance.StartedAt.Value;
                                    @FormatDuration(duration)
                                }
                                else
                                {
                                    var duration = DateTime.UtcNow.FromUtcToLocal() - _jobInstance.StartedAt.Value.FromUtcToLocal();
                                    <text>@FormatDuration(duration) (@L["JobInstances:Messages:Running"])</text>
                                }
                            </MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            <!-- Job arguments -->
            @if (!string.IsNullOrEmpty(_jobInstance.JobArgs))
            {
                <MudPaper Class="pa-4 mb-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-3">@L["Dialogs:JobInstanceDetail:JobArgs"]</MudText>
                    <MudTextField T="string"
                                  Value="@FormatJobArgs(_jobInstance.JobArgs)"
                                  ReadOnly="true"
                                  Variant="Variant.Outlined"
                                  Lines="10"
                                  Sizing="InputSizing.Auto"
                                  Class="job-instance-detail__args" />
                </MudPaper>
            }

            <!-- State history -->
            <StateHistoryViewer Instance="@_jobInstance" />
        }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Common:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string InstanceId { get; set; } = string.Empty;

    [Parameter]
    public bool ShowJobDefinitionButton { get; set; } = false;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private JobInstance? _jobInstance;
    private bool _isLoading = true;
    private bool _isCancelling;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadJobInstanceAsync();
    }

    private async Task LoadJobInstanceAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var result = await QueryService.GetJobInstanceAsync(InstanceId);
            if (result.IsFailed(out var error, out var data))
            {
                _error = $"{L["Dialogs:JobInstanceDetail:LoadFailed"]}: {error.Message}";
            }
            else
            {
                _jobInstance = data;
            }
        }
        catch (Exception ex)
        {
            _error = $"{L["Dialogs:JobInstanceDetail:LoadFailed"]}: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        await LoadJobInstanceAsync();
        StateHasChanged();
    }

    private async Task CopyInstanceIdAsync()
    {
        if (_jobInstance == null)
        {
            return;
        }

        await JSRuntime.InvokeAsync<bool>("MoClipboard.copyText", _jobInstance.InstanceId);
        Snackbar.Add(L["Dialogs:JobInstanceDetail:InstanceIdCopied"], Severity.Success);
    }

    private void NavigateToJobDefinition()
    {
        if (_jobInstance != null)
        {
            MudDialog.Close();
            NavigationManager.NavigateTo($"/job-scheduler/definitions/{Uri.EscapeDataString(_jobInstance.JobKey)}");
        }
    }

    private void Close()
    {
        MudDialog.Close();
    }

    private bool IsCancellable() =>
        _jobInstance?.State is JobState.Scheduled or JobState.Enqueued or JobState.Processing;

    private async Task CancelInstanceAsync()
    {
        if (_jobInstance == null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["Dialogs:JobInstanceDetail:CancelConfirmTitle"],
            L["Dialogs:JobInstanceDetail:CancelConfirmMessage", _jobInstance.InstanceId],
            yesText: L["Common:Actions:Confirm"],
            cancelText: L["Common:Actions:Cancel"]);

        if (confirmed != true) return;

        _isCancelling = true;
        StateHasChanged();

        try
        {
            var result = await UIService.CancelInstanceAsync(_jobInstance.InstanceId);
            if (result.IsFailed(out var error))
            {
                Snackbar.Add($"{L["Dialogs:JobInstanceDetail:CancelFailed"]}: {error.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add(L["Dialogs:JobInstanceDetail:CancelSuccess"], Severity.Success);
                await LoadJobInstanceAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Dialogs:JobInstanceDetail:CancelFailed"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCancelling = false;
            StateHasChanged();
        }
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return $"{duration.TotalHours:F2}h";
        if (duration.TotalMinutes >= 1)
            return $"{duration.TotalMinutes:F2}m";
        if (duration.TotalSeconds >= 1)
            return $"{duration.TotalSeconds:F2}s";
        return $"{duration.TotalMilliseconds:F0}ms";
    }

    private static string FormatJobArgs(string? jobArgs)
    {
        if (string.IsNullOrEmpty(jobArgs)) return string.Empty;
        try
        {
            using var doc = JsonDocument.Parse(jobArgs);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
        }
        catch
        {
            return jobArgs;
        }
    }
}
