@using Monica.JobScheduler.UI.Localization
@using Microsoft.JSInterop
@using Monica.JobScheduler.UI.UIJobScheduler.Shared.Support
@inject CronExpressionSupport CronService
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<JobSchedulerResource> L
@implements IAsyncDisposable

@if (string.IsNullOrWhiteSpace(Expression))
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
}
else if (DisplayMode == CronDisplayMode.Compact)
{
    <!-- Compact Mode: Tooltip on hover -->
    <div class="cron-compact-wrapper">
        <MudTooltip Text="@GetTooltipText()" Placement="Placement.Top" Delay="200" Arrow="true">
            <MudChip T="string"
                     Size="@ChipSize"
                     Color="@ChipColor"
                     OnClick="@HandleClick">
                @Expression
                @if (!string.IsNullOrEmpty(_description))
                {
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                }
            </MudChip>
        </MudTooltip>
    </div>
}
else
{
    <!-- Full Mode: Visible description -->
    <div class="cron-full-wrapper">
        <MudChip T="string"
                 Color="@ChipColor"
                 OnClick="@HandleClick">
            @Expression
        </MudChip>
        @if (_isLoading)
        {
            <div class="loading-text">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Components:CronExpressionDisplay:Parsing"]</MudText>
            </div>
        }
        else if (!string.IsNullOrEmpty(_description))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @_description
            </MudText>
        }
    </div>
}

@code {
    /// <summary>
    /// Cron expression
    /// </summary>
    [Parameter]
    public string? Expression { get; set; }

    /// <summary>
    /// display mode
    /// </summary>
    [Parameter]
    public CronDisplayMode DisplayMode { get; set; } = CronDisplayMode.Compact;

    /// <summary>
    /// click event
    /// </summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// chip color
    /// </summary>
    [Parameter]
    public Color ChipColor { get; set; } = Color.Info;

    /// <summary>
    /// Chip size
    /// </summary>
    [Parameter]
    public Size ChipSize { get; set; } = Size.Small;

    private string? _description;
    private bool _isLoading;
    private CronInteropSession? _cronInterop;
    private string? _lastExpression;
    private int _loadVersion;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _cronInterop = new CronInteropSession(JsRuntime);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDescriptionAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Expression changed, reload description
        if (_lastExpression != Expression && _cronInterop != null && !_disposed)
        {
            await LoadDescriptionAsync();
        }
    }

    private async Task LoadDescriptionAsync()
    {
        var loadVersion = ++_loadVersion;
        if (string.IsNullOrWhiteSpace(Expression))
        {
            _description = null;
            return;
        }

        _lastExpression = Expression;
        _isLoading = true;
        StateHasChanged();

        try
        {
            var cronInterop = _cronInterop;
            if (cronInterop is null || _disposed)
            {
                return;
            }

            // Detect format based on segment count
            var format = DetectFormat(Expression);

            // Parse to description
            var result = await CronService.ParseToDescriptionAsync(cronInterop, Expression, format);
            if (!_disposed && loadVersion == _loadVersion)
            {
                _description = result.IsOk(out var desc) ? desc : null;
            }
        }
        catch
        {
            if (!_disposed && loadVersion == _loadVersion)
            {
                _description = null;
            }
        }
        finally
        {
            if (!_disposed && loadVersion == _loadVersion)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private static CronFormat DetectFormat(string expression)
    {
        var parts = expression.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 6 ? CronFormat.Quartz : CronFormat.Standard;
    }

    private string GetTooltipText()
    {
        if (_isLoading) return L["Components:CronExpressionDisplay:Parsing"].Value;
        return _description ?? Expression ?? "";
    }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loadVersion++;
        var cronInterop = _cronInterop;
        _cronInterop = null;
        if (cronInterop != null)
        {
            await cronInterop.DisposeAsync();
        }
    }
}
