@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.Support

@inject IStringLocalizer<JobSchedulerResource> L

<section class="execution-history" aria-labelledby="execution-history-heading">
    <div class="execution-history__heading">
        <MudText Typo="Typo.subtitle1" id="execution-history-heading">@L["ExecutionDetail:History"]</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ExecutionDetail:HistoryCount", Entries.Count]</MudText>
    </div>
    <div class="execution-history__scroll">
        <MudTable T="JobExecutionHistoryEntry"
                  Items="@Entries.OrderByDescending(entry => entry.TimestampUtc)"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.None"
                  Elevation="0"
                  Class="execution-history__table">
            <HeaderContent>
                <MudTh>@L["ExecutionDetail:HistoryTime"]</MudTh>
                <MudTh>@L["ExecutionDetail:HistoryKind"]</MudTh>
                <MudTh>@L["ExecutionDetail:HistoryLogLevel"]</MudTh>
                <MudTh>@L["ExecutionDetail:HistoryTransition"]</MudTh>
                <MudTh>@L["ExecutionDetail:HistoryWorker"]</MudTh>
                <MudTh>@L["ExecutionDetail:HistoryMessage"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["ExecutionDetail:HistoryTime"]" Class="execution-history__time">
                    <time>@ExecutionUiPresentation.FormatDateTime(context.TimestampUtc)</time>
                </MudTd>
                <MudTd DataLabel="@L["ExecutionDetail:HistoryKind"]">
                    @L[$"ExecutionHistoryKinds:{context.Kind}"]
                </MudTd>
                <MudTd DataLabel="@L["ExecutionDetail:HistoryLogLevel"]">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@ExecutionUiPresentation.GetLogLevelColor(context.LogLevel)">
                        @L[$"LogLevels:{context.LogLevel}"]
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@L["ExecutionDetail:HistoryTransition"]" Class="execution-history__transition">
                    @GetTransition(context)
                </MudTd>
                <MudTd DataLabel="@L["ExecutionDetail:HistoryWorker"]">
                    <code class="execution-history__identity" title="@context.WorkerInstanceId">@(context.WorkerInstanceId ?? "—")</code>
                </MudTd>
                <MudTd DataLabel="@L["ExecutionDetail:HistoryMessage"]">
                    <div class="execution-history__message">@context.Message</div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4" Color="Color.Secondary">@L["ExecutionDetail:EmptyHistory"]</MudText>
            </NoRecordsContent>
        </MudTable>
    </div>
</section>

@code {
    /// <summary>
    /// Gets or sets the complete retained append-only history to render.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<JobExecutionHistoryEntry> Entries { get; set; } = [];

    private string GetTransition(JobExecutionHistoryEntry entry)
    {
        if (entry.PreviousState is null && entry.NewState is null)
        {
            return "—";
        }

        var previous = entry.PreviousState.HasValue
            ? L[$"ExecutionStates:{entry.PreviousState.Value}"].Value
            : "∅";
        var next = entry.NewState.HasValue
            ? L[$"ExecutionStates:{entry.NewState.Value}"].Value
            : "∅";
        return $"{previous} → {next}";
    }
}
