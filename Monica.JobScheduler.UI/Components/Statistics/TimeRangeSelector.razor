@using Monica.JobScheduler.UI.Models
@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

<div class="time-range-wrapper">
    <MudPaper Class="time-range-card" Elevation="0">
        <div class="preset-buttons">
            <MudButtonGroup OverrideStyles="false" Variant="Variant.Outlined">
                <MudButton Color="@GetPresetColor(TimeRangePreset.Today)"
                           OnClick="@(() => SelectPreset(TimeRangePreset.Today))">
                    @L["Statistics:TimeRange:Today"]
                </MudButton>
                <MudButton Color="@GetPresetColor(TimeRangePreset.Last24Hours)"
                           OnClick="@(() => SelectPreset(TimeRangePreset.Last24Hours))">
                    @L["Statistics:TimeRange:Last24Hours"]
                </MudButton>
                <MudButton Color="@GetPresetColor(TimeRangePreset.Last7Days)"
                           OnClick="@(() => SelectPreset(TimeRangePreset.Last7Days))">
                    @L["Statistics:TimeRange:Last7Days"]
                </MudButton>
                <MudButton Color="@GetPresetColor(TimeRangePreset.Last30Days)"
                           OnClick="@(() => SelectPreset(TimeRangePreset.Last30Days))">
                    @L["Statistics:TimeRange:Last30Days"]
                </MudButton>
                <MudButton Color="@GetPresetColor(TimeRangePreset.Custom)"
                           OnClick="@ToggleCustomRange">
                    @L["Statistics:TimeRange:Custom"]
                </MudButton>
            </MudButtonGroup>
        </div>

        @if (_showCustomRange)
        {
            <div class="custom-range">
                <MudDateRangePicker Label="@L["Statistics:TimeRange:Label"]"
                                     @bind-DateRange="_dateRange"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Editable="true"
                                     DateFormat="yyyy-MM-dd" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="@ApplyCustomRange">
                    @L["Common:Actions:Apply"]
                </MudButton>
            </div>
        }

        <div class="current-range">
            <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Small" Color="Color.Default" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @GetRangeDisplayText()
            </MudText>
        </div>
    </MudPaper>
</div>

@code {
    [Parameter]
    public TimeRangePreset Preset { get; set; } = TimeRangePreset.Today;

    [Parameter]
    public EventCallback<TimeRangePreset> PresetChanged { get; set; }

    [Parameter]
    public DateTime? CustomStartTime { get; set; }

    [Parameter]
    public EventCallback<DateTime?> CustomStartTimeChanged { get; set; }

    [Parameter]
    public DateTime? CustomEndTime { get; set; }

    [Parameter]
    public EventCallback<DateTime?> CustomEndTimeChanged { get; set; }

    [Parameter]
    public EventCallback OnRangeChanged { get; set; }

    private bool _showCustomRange;
    private DateRange? _dateRange;

    protected override void OnInitialized()
    {
        if (Preset == TimeRangePreset.Custom && CustomStartTime.HasValue && CustomEndTime.HasValue)
        {
            _dateRange = new DateRange(CustomStartTime.Value, CustomEndTime.Value);
            _showCustomRange = true;
        }
    }

    private async Task SelectPreset(TimeRangePreset preset)
    {
        if (preset == TimeRangePreset.Custom)
        {
            _showCustomRange = true;
            return;
        }

        _showCustomRange = false;
        Preset = preset;
        await PresetChanged.InvokeAsync(preset);
        await OnRangeChanged.InvokeAsync();
    }

    private void ToggleCustomRange()
    {
        _showCustomRange = !_showCustomRange;
        if (_showCustomRange && _dateRange == null)
        {
            var now = DateTime.Now;
            _dateRange = new DateRange(now.AddDays(-7), now);
        }
    }

    private async Task ApplyCustomRange()
    {
        if (_dateRange?.Start == null || _dateRange.End == null)
            return;

        Preset = TimeRangePreset.Custom;
        CustomStartTime = _dateRange.Start;
        CustomEndTime = _dateRange.End;

        await PresetChanged.InvokeAsync(TimeRangePreset.Custom);
        await CustomStartTimeChanged.InvokeAsync(_dateRange.Start);
        await CustomEndTimeChanged.InvokeAsync(_dateRange.End);
        await OnRangeChanged.InvokeAsync();
    }

    private Color GetPresetColor(TimeRangePreset preset)
    {
        return Preset == preset ? Color.Primary : Color.Default;
    }

    private string GetRangeDisplayText()
    {
        var (start, end) = GetEffectiveRange();
        return $"{start:yyyy-MM-dd HH:mm} - {end:yyyy-MM-dd HH:mm}";
    }

    private (DateTime start, DateTime end) GetEffectiveRange()
    {
        if (Preset == TimeRangePreset.Custom && CustomStartTime.HasValue && CustomEndTime.HasValue)
        {
            return (CustomStartTime.Value, CustomEndTime.Value);
        }

        var now = DateTime.Now;
        return Preset switch
        {
            TimeRangePreset.Today => (now.Date, now),
            TimeRangePreset.Last24Hours => (now.AddHours(-24), now),
            TimeRangePreset.Last7Days => (now.AddDays(-7), now),
            TimeRangePreset.Last30Days => (now.AddDays(-30), now),
            _ => (now.Date, now)
        };
    }
}
