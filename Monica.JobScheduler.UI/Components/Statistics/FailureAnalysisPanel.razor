@using Monica.JobScheduler.UI.Models

@inject NavigationManager NavigationManager

<div class="failure-analysis-wrapper">
    <MudPaper Class="failure-card" Elevation="0">
        <div class="card-header">
            <div class="header-title">
                <MudIcon Icon="@Icons.Material.Filled.BugReport" Size="Size.Small" Color="Color.Error" />
                <MudText Typo="Typo.h6">失败分析</MudText>
            </div>
        </div>

        @if (Analysis != null && (Analysis.TotalFailures > 0 || Analysis.TotalTerminated > 0))
        {
            <div class="summary-cards">
                <div class="summary-card failed">
                    <div class="summary-value">@Analysis.TotalFailures</div>
                    <div class="summary-label">失败次数</div>
                </div>
                <div class="summary-card terminated">
                    <div class="summary-value">@Analysis.TotalTerminated</div>
                    <div class="summary-label">终止次数</div>
                </div>
                <div class="summary-card retry">
                    <div class="summary-value">@Analysis.RetrySuccessRate.ToString("F1")%</div>
                    <div class="summary-label">重试成功率</div>
                </div>
            </div>

            @if (Analysis.ByJob.Count > 0)
            {
                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">按任务分布</MudText>

                <div class="job-failures">
                    @foreach (var job in Analysis.ByJob.Take(5))
                    {
                        <div class="failure-item" @onclick="() => ViewJob(job.JobKey)">
                            <div class="job-info">
                                <span class="job-name" title="@job.JobKey">@job.JobName</span>
                                <MudProgressLinear Value="@job.FailureRate"
                                                   Max="100"
                                                   Color="Color.Error"
                                                   Size="Size.Small" />
                            </div>
                            <div class="failure-stats">
                                <span class="count">@job.TotalFailureCount 次失败</span>
                                <span class="rate">@job.FailureRate.ToString("F1")%</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="no-failures">
                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Large" Color="Color.Success" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">该时间段内无失败记录</MudText>
                <MudText Typo="Typo.body2" Color="Color.Tertiary">所有任务执行正常</MudText>
            </div>
        }
    </MudPaper>
</div>

@code {
    [Parameter]
    public FailureAnalysis? Analysis { get; set; }

    private void ViewJob(string jobKey)
    {
        NavigationManager.NavigateTo($"/job-scheduler/definitions/{Uri.EscapeDataString(jobKey)}");
    }
}
