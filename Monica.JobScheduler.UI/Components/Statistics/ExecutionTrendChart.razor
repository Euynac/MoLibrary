@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Shared.Support

@inject JobStateColorResolver StateColorService
@inject IStringLocalizer<JobSchedulerResource> L

<div class="trend-chart-wrapper">
    <MudPaper Class="trend-card" Elevation="0">
        <div class="card-header">
            <MudText Typo="Typo.h6">@L["Statistics:ExecutionTrend:Title"]</MudText>
            <div class="legend">
                <div class="legend-item">
                    <div class="legend-dot success"></div>
                    <span>@L["Statistics:ExecutionTrend:Legend:Success"]</span>
                </div>
                <div class="legend-item">
                    <div class="legend-dot failed"></div>
                    <span>@L["Statistics:ExecutionTrend:Legend:Failed"]</span>
                </div>
                <div class="legend-item">
                    <div class="legend-dot skipped"></div>
                    <span>@L["Statistics:ExecutionTrend:Legend:Skipped"]</span>
                </div>
            </div>
        </div>

        @if (TrendData.Count > 0)
        {
            <div class="chart-container">
                <MudChart ChartType="ChartType.Line"
                          ChartSeries="@GetChartSeries()"
                          ChartLabels="@GetXAxisLabels()"
                          Width="100%"
                          Height="50vh"
                          ChartOptions="@ChartOptionsWithPalette" />
            </div>

            <div class="summary-row">
                <div class="summary-item">
                    <span class="label">@L["Statistics:ExecutionTrend:Summary:TotalExecutions"]</span>
                    <span class="value">@TrendData.Sum(d => d.TotalCount)</span>
                </div>
                <div class="summary-item success">
                    <span class="label">@L["Statistics:ExecutionTrend:Summary:Success"]</span>
                    <span class="value">@TrendData.Sum(d => d.SucceededCount)</span>
                </div>
                <div class="summary-item failed">
                    <span class="label">@L["Statistics:ExecutionTrend:Summary:Failed"]</span>
                    <span class="value">@TrendData.Sum(d => d.FailedCount)</span>
                </div>
                <div class="summary-item skipped">
                    <span class="label">@L["Statistics:ExecutionTrend:Summary:Skipped"]</span>
                    <span class="value">@TrendData.Sum(d => d.SkippedCount)</span>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Statistics:ExecutionTrend:NoData"]</MudText>
            </div>
        }
    </MudPaper>
</div>

@code {
    [Parameter]
    public List<ExecutionTrendPoint> TrendData { get; set; } = [];

    [Parameter]
    public TimeGranularity Granularity { get; set; } = TimeGranularity.Hourly;

    private ChartOptions ChartOptionsWithPalette => new()
    {
        ShowLegend = false,
        ChartPalette =
        [
            StateColorService.GetStateColorHex(JobState.Succeeded),
            StateColorService.GetStateColorHex(JobState.Failed),
            StateColorService.GetStateColorHex(JobState.Skipped)
        ]
    };

    private List<ChartSeries<double>> GetChartSeries()
    {
        return
        [
            new ChartSeries<double>
            {
                Name = L["Statistics:ExecutionTrend:Legend:Success"],
                Data = TrendData.Select(d => (double)d.SucceededCount).ToArray()
            },
            new ChartSeries<double>
            {
                Name = L["Statistics:ExecutionTrend:Legend:Failed"],
                Data = TrendData.Select(d => (double)d.FailedCount).ToArray()
            },
            new ChartSeries<double>
            {
                Name = L["Statistics:ExecutionTrend:Legend:Skipped"],
                Data = TrendData.Select(d => (double)d.SkippedCount).ToArray()
            }
        ];
    }

    private string[] GetXAxisLabels()
    {
        return TrendData.Select(d => FormatTimestamp(d.Timestamp)).ToArray();
    }

    private string FormatTimestamp(DateTime timestamp)
    {
        var local = timestamp.FromUtcToLocal();
        return Granularity switch
        {
            TimeGranularity.Hourly => local.ToString("HH:mm"),
            TimeGranularity.Daily => local.ToString("MM-dd"),
            TimeGranularity.Weekly => local.ToString("MM-dd"),
            _ => local.ToString("HH:mm")
        };
    }
}
