@using Monica.JobScheduler.UI.Localization

@inject NavigationManager NavigationManager
@inject IStringLocalizer<JobSchedulerResource> L

<div class="ranking-wrapper">
    <MudPaper Class="ranking-card mo-self-painted" Elevation="0">
        <div class="card-header">
            <MudText Typo="Typo.h6">@Title</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                @L["Statistics:TopJobs:TopN", Rankings.Count]
            </MudChip>
        </div>

        @if (Rankings.Count > 0)
        {
            <div class="ranking-list">
                @foreach (var item in Rankings)
                {
                    <button type="button" class="ranking-item" @onclick="() => ViewJob(item.JobKey)">
                        <div class="rank-badge @GetRankClass(item.Rank)">@item.Rank</div>
                        <div class="job-info">
                            <span class="job-name" title="@item.JobKey">@item.JobName</span>
                            <MudProgressLinear Value="@item.Percentage"
                                               Max="100"
                                               Color="@GetRankColor(item.Rank)"
                                               Size="Size.Small"
                                               Class="rank-progress" />
                        </div>
                        <div class="rank-value">
                            <span class="value">@(item.FormattedValue ?? item.Value.ToString("N0"))</span>
                            <span class="percent">@item.Percentage.ToString("F1")%</span>
                        </div>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Leaderboard" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Statistics:TopJobs:NoData"]</MudText>
            </div>
        }
    </MudPaper>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "任务排行";

    [Parameter]
    public List<JobRanking> Rankings { get; set; } = [];

    private void ViewJob(string jobKey)
    {
        NavigationManager.NavigateTo($"/job-scheduler/definitions/{Uri.EscapeDataString(jobKey)}");
    }

    private static string GetRankClass(int rank)
    {
        return rank switch
        {
            1 => "gold",
            2 => "silver",
            3 => "bronze",
            _ => ""
        };
    }

    private static Color GetRankColor(int rank)
    {
        return rank switch
        {
            1 => Color.Warning,
            2 => Color.Default,
            3 => Color.Tertiary,
            _ => Color.Default
        };
    }
}
