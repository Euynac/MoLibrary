@using Monica.JobScheduler.UI.Localization

@inject IDialogService DialogService
@inject IStringLocalizer<JobSchedulerResource> L

<div class="percentiles-wrapper">
    <MudPaper Class="percentiles-card" Elevation="0">
        <div class="card-header">
            <MudText Typo="Typo.h6">@L["Statistics:DurationPercentiles:Title"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Statistics:DurationPercentiles:Sample"]: @Percentiles.SampleCount</MudText>
        </div>

        @if (Percentiles.SampleCount > 0)
        {
            <div class="percentiles-grid">
                <div class="percentile-item">
                    <div class="percentile-label">@L["Statistics:DurationPercentiles:P50"]</div>
                    <div class="percentile-value">@FormatDuration(Percentiles.P50)</div>
                    <div class="percentile-desc">@L["Statistics:DurationPercentiles:P50Desc"]</div>
                </div>
                <div class="percentile-item">
                    <div class="percentile-label">@L["Statistics:DurationPercentiles:P90"]</div>
                    <div class="percentile-value">@FormatDuration(Percentiles.P90)</div>
                    <div class="percentile-desc">@L["Statistics:DurationPercentiles:P90Desc"]</div>
                </div>
                <div class="percentile-item">
                    <div class="percentile-label">@L["Statistics:DurationPercentiles:P95"]</div>
                    <div class="percentile-value">@FormatDuration(Percentiles.P95)</div>
                    <div class="percentile-desc">@L["Statistics:DurationPercentiles:P95Desc"]</div>
                </div>
                <div class="percentile-item highlight">
                    <div class="percentile-label">@L["Statistics:DurationPercentiles:P99"]</div>
                    <div class="percentile-value">@FormatDuration(Percentiles.P99)</div>
                    <div class="percentile-desc">@L["Statistics:DurationPercentiles:P99Desc"]</div>
                </div>
            </div>

            <MudDivider Class="my-3" />

            <div class="stats-row">
                <div class="stat-item">
                    <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Color="Color.Default" />
                    <span class="stat-label">@L["Statistics:DurationPercentiles:Average"]:</span>
                    <span class="stat-value">@FormatDuration(Percentiles.Average)</span>
                </div>
                <div class="stat-item">
                    <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Color="Color.Success" />
                    <span class="stat-label">@L["Statistics:DurationPercentiles:Fastest"]:</span>
                    <span class="stat-value">@FormatDuration(Percentiles.Min)</span>
                </div>
                <div class="stat-item">
                    <MudIcon Icon="@Icons.Material.Filled.Timelapse" Size="Size.Small" Color="Color.Warning" />
                    <span class="stat-label">@L["Statistics:DurationPercentiles:Slowest"]:</span>
                    <span class="stat-value">@FormatDuration(Percentiles.Max)</span>
                </div>
            </div>

            @if (SlowestInstances.Count > 0)
            {
                <MudDivider Class="my-3" />

                <div class="slowest-section">
                    <div class="slowest-header">
                        <MudText Typo="Typo.subtitle2">@L["Statistics:DurationPercentiles:SlowestInstances", SlowestInstances.Count]</MudText>
                        <MudTooltip Text="@L["Statistics:DurationPercentiles:SlowestTooltip"]">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Default" />
                        </MudTooltip>
                    </div>
                    <div class="slowest-list">
                        @foreach (var instance in SlowestInstances)
                        {
                            <div class="slowest-item" @onclick="() => ShowInstanceDetail(instance.InstanceId)">
                                <div class="slowest-job-name" title="@instance.JobKey">@instance.JobName</div>
                                <div class="slowest-duration">@FormatDuration(instance.Duration)</div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Statistics:DurationPercentiles:NoData"]</MudText>
            </div>
        }
    </MudPaper>
</div>

@code {
    [Parameter]
    public DurationPercentiles Percentiles { get; set; } = new();

    [Parameter]
    public List<SlowestInstance> SlowestInstances { get; set; } = [];

    private async Task ShowInstanceDetail(string instanceId)
    {
        var parameters = new DialogParameters<JobInstanceDetailDialog>
        {
            { x => x.InstanceId, instanceId },
            { x => x.ShowJobDefinitionButton, true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false
        };

        await DialogService.ShowAsync<JobInstanceDetailDialog>(L["Dialogs:JobInstanceDetail:Title"], parameters, options);
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalDays >= 1)
            return $"{duration.TotalDays:F1}{L["Common:Time:Days"]}";
        if (duration.TotalHours >= 1)
            return $"{duration.TotalHours:F1}{L["Common:Time:Hours"]}";
        if (duration.TotalMinutes >= 1)
            return $"{duration.TotalMinutes:F1}{L["Common:Time:Minutes"]}";
        if (duration.TotalSeconds >= 1)
            return $"{duration.TotalSeconds:F2}{L["Common:Time:Seconds"]}";
        return $"{duration.TotalMilliseconds:F0}{L["Common:Time:Milliseconds"]}";
    }
}
