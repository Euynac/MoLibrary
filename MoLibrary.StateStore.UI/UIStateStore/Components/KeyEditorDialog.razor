@using MoLibrary.StateStore.UI.Services
@using MoLibrary.StateStore.UI.Models
@using MoLibrary.Tool.MoResponse
@inject StateStoreUIService StateStoreService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @* Key 名称 *@
            <MudTextField Value="@KeyInfo.Key"
                          Label="Key 名称"
                          Variant="Variant.Outlined"
                          ReadOnly="true"
                          Style="font-family: monospace;" />

            @* ETag *@
            @if (!string.IsNullOrEmpty(KeyInfo.ETag))
            {
                <MudTextField Value="@KeyInfo.ETag"
                              Label="ETag"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              Style="font-family: monospace;" />
            }

            @* TTL (仅编辑模式) *@
            @if (!ReadOnly)
            {
                <MudNumericField @bind-Value="ttlSeconds"
                                 Label="TTL (秒, 0 表示永久)"
                                 Variant="Variant.Outlined"
                                 Min="0"
                                 Adornment="Adornment.End"
                                 AdornmentText="秒" />
            }

            @* JSON 值编辑器 *@
            <MudTextField @bind-Value="editedValue"
                          Label="JSON 值"
                          Variant="Variant.Outlined"
                          Lines="15"
                          ReadOnly="@ReadOnly"
                          Style="font-family: monospace;"
                          HelperText="@(ReadOnly ? "" : "输入有效的 JSON 值")" />

            @if (!ReadOnly)
            {
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FormatIndentIncrease"
                               OnClick="FormatJson"
                               Size="Size.Small">
                        格式化 JSON
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Compress"
                               OnClick="MinifyJson"
                               Size="Size.Small">
                        压缩 JSON
                    </MudButton>
                </div>
            }

            @if (errorMessage != null)
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        @if (!ReadOnly)
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="SaveAsync"
                       Disabled="isSaving">
                @if (isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                保存
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public StateStoreKeyInfo KeyInfo { get; set; } = null!;
    [Parameter] public string? ServiceKey { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<StateStoreKeyInfo> OnSaved { get; set; }

    private string editedValue = "";
    private int ttlSeconds = 0;
    private bool isSaving = false;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        editedValue = KeyInfo.RawValue ?? "";
    }

    private void FormatJson()
    {
        try
        {
            var obj = System.Text.Json.JsonSerializer.Deserialize<object>(editedValue);
            editedValue = System.Text.Json.JsonSerializer.Serialize(obj, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"JSON 格式化失败: {ex.Message}";
        }
    }

    private void MinifyJson()
    {
        try
        {
            var obj = System.Text.Json.JsonSerializer.Deserialize<object>(editedValue);
            editedValue = System.Text.Json.JsonSerializer.Serialize(obj);
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"JSON 压缩失败: {ex.Message}";
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var request = new StateStoreKeyUpdateRequest
            {
                Key = KeyInfo.Key,
                Value = editedValue,
                ETag = KeyInfo.ETag,
                TTL = ttlSeconds > 0 ? TimeSpan.FromSeconds(ttlSeconds) : null
            };

            var result = await StateStoreService.SaveKeyAsync(ServiceKey, request);

            if (result.IsFailed(out var error))
            {
                errorMessage = error.Message;
            }
            else
            {
                KeyInfo.RawValue = editedValue;
                await OnSaved.InvokeAsync(KeyInfo);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
