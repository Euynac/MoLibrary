@using MoLibrary.StateStore.Providers
@using MoLibrary.StateStore.UI.Models
@using MoLibrary.UI.UIModuleSystem.Components

<MudDialog @bind-Visible="IsVisible" Options="DialogOptions">
    <DialogContent>
        @if (Provider != null)
        {
            <div class="provider-detail-header mb-4">
                <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2">
                    <MudAvatar Color="@GetProviderColor()" Size="Size.Medium" Class="mr-2">
                        <MudIcon Icon="@GetProviderIcon()" />
                    </MudAvatar>
                    @Provider.DisplayName
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                    @Provider.ImplementationType
                </MudText>
            </div>

            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="Provider 信息" Icon="@Icons.Material.Filled.Info">
                    <div class="tab-content pa-4">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">Provider 类型</MudText>
                                    </div>
                                    <MudChip T="string" Color="@GetProviderColor()" Size="Size.Small">
                                        @Provider.ProviderTypeName
                                    </MudChip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Key" Color="Color.Info" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">服务键</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @(Provider.ServiceKey ?? "默认 (无键)")
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@(Provider.IsDistributed ? Icons.Material.Filled.Cloud : Icons.Material.Filled.Memory)"
                                                 Color="@(Provider.IsDistributed ? Color.Info : Color.Success)"
                                                 Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">存储模式</MudText>
                                    </div>
                                    <MudChip T="string"
                                             Color="@(Provider.IsDistributed ? Color.Info : Color.Success)"
                                             Size="Size.Small">
                                        @(Provider.IsDistributed ? "分布式" : "本地内存")
                                    </MudChip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Secondary" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">实现类型</MudText>
                                    </div>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                                        @Provider.ImplementationType
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <div class="d-flex align-center mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Extension" Color="Color.Tertiary" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">支持的能力</MudText>
                                    </div>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @if (Provider.SupportsKeyScanning)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" />
                                                Key 扫描
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Small" Class="mr-1" />
                                                不支持扫描
                                            </MudChip>
                                        }
                                        @if (Provider.Capabilities.HasFlag(EStateStoreCapabilities.RawStringRetrieval))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.TextFields" Size="Size.Small" Class="mr-1" />
                                                原始字符串检索
                                            </MudChip>
                                        }
                                        @if (Provider.Capabilities.HasFlag(EStateStoreCapabilities.QueryState))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Small" Class="mr-1" />
                                                查询状态
                                            </MudChip>
                                        }
                                        @if (Provider.Capabilities.HasFlag(EStateStoreCapabilities.BulkOperations))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.DynamicFeed" Size="Size.Small" Class="mr-1" />
                                                批量操作
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="配置选项" Icon="@Icons.Material.Filled.Settings">
                    <div class="tab-content pa-4">
                        <ModuleOptionDisplay OptionType="@Provider.OptionType"
                                           OptionInstance="@Provider.OptionInstance" />
                    </div>
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="OnClose" StartIcon="@Icons.Material.Filled.Close">
            关闭
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// 是否显示对话框
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>
    /// 是否显示对话框改变事件
    /// </summary>
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>
    /// Provider 信息
    /// </summary>
    [Parameter] public StateStoreProviderInfo? Provider { get; set; }

    /// <summary>
    /// 对话框选项
    /// </summary>
    private DialogOptions DialogOptions = new()
    {
        CloseButton = true,
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Large
    };

    /// <summary>
    /// 关闭对话框
    /// </summary>
    private async Task OnClose()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(IsVisible);
    }

    private string GetProviderIcon() => Provider?.ProviderType switch
    {
        EStateStoreProviderType.Redis => Icons.Material.Filled.Storage,
        EStateStoreProviderType.Dapr => Icons.Material.Filled.Cloud,
        EStateStoreProviderType.Memory => Icons.Material.Filled.Memory,
        _ => Icons.Material.Filled.Help
    };

    private Color GetProviderColor() => Provider?.ProviderType switch
    {
        EStateStoreProviderType.Redis => Color.Error,
        EStateStoreProviderType.Dapr => Color.Info,
        EStateStoreProviderType.Memory => Color.Success,
        _ => Color.Default
    };
}
