@namespace Monica.ServiceDiscovery.Pages
@attribute [Route(SERVICE_DISCOVERY_DEBUG_URL)]
@using Monica.ServiceDiscovery.UIServiceDiscovery.Components
@using Monica.ServiceDiscovery.Facades
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Dialogs
@using Monica.ServiceDiscovery.UIServiceDiscovery.State
@using Monica.Core.Results;
@using CurrentInstanceInfo = Monica.ServiceDiscovery.UIServiceDiscovery.Components.CurrentInstanceInfo
@inject ServiceDiscoveryPageState PageState
@inject ServiceDiscoveryFacade ServiceDiscoveryFacade
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<ServiceDiscoveryResource> L
@implements IDisposable

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<div class="service-discovery-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="service-discovery-page__outer-container">
        <div class="service-discovery-page__container">
            <header class="service-discovery-page__header">
                <div class="service-discovery-page__eyebrow">
                    <span class="service-discovery-page__eyebrow-line" aria-hidden="true"></span>
                    <span>@L["Page:Header:Eyebrow"]</span>
                </div>
                <div class="service-discovery-page__heading-row">
                    <div class="service-discovery-page__heading-copy">
                        <MudText Typo="Typo.h3" HtmlTag="h1" Class="service-discovery-page__title">
                            @L["Page:Header:Title"]
                        </MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="service-discovery-page__description">
                            @L["Page:Header:Description"]
                        </MudText>
                    </div>
                    <div class="service-discovery-page__header-actions">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Color="@(PageState.AutoRefreshEnabled ? Color.Success : Color.Default)"
                                 Icon="@(PageState.AutoRefreshEnabled ? Icons.Material.Filled.Sync : Icons.Material.Filled.SyncDisabled)">
                            @(PageState.AutoRefreshEnabled ? L["Page:Header:Live"] : L["Page:Header:Paused"])
                        </MudChip>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="@(() => RefreshServicesAsync())"
                                   Disabled="@PageState.IsLoading">
                            @L["Shared:Actions:Refresh"]
                        </MudButton>
                    </div>
                </div>
            </header>

            <section class="service-discovery-page__pulse" aria-label="@L["Page:Metrics:AriaLabel"]">
                <article class="service-discovery-pulse-card service-discovery-pulse-card--primary">
                    <span class="service-discovery-pulse-card__icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.CloudQueue" />
                    </span>
                    <span class="service-discovery-pulse-card__copy">
                        <span class="service-discovery-pulse-card__label">@L["Page:Metrics:Services"]</span>
                        <strong>@PageState.Services.Count</strong>
                    </span>
                </article>
                <article class="service-discovery-pulse-card service-discovery-pulse-card--success">
                    <span class="service-discovery-pulse-card__icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    </span>
                    <span class="service-discovery-pulse-card__copy">
                        <span class="service-discovery-pulse-card__label">@L["Page:Metrics:Running"]</span>
                        <strong>@RunningServiceCount</strong>
                    </span>
                </article>
                <article class="service-discovery-pulse-card service-discovery-pulse-card--info">
                    <span class="service-discovery-pulse-card__icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Domain" />
                    </span>
                    <span class="service-discovery-pulse-card__copy">
                        <span class="service-discovery-pulse-card__label">@L["Page:Metrics:Domains"]</span>
                        <strong>@DomainCount</strong>
                    </span>
                </article>
                <article class="service-discovery-pulse-card service-discovery-pulse-card--tertiary">
                    <span class="service-discovery-pulse-card__icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Dns" />
                    </span>
                    <span class="service-discovery-pulse-card__copy">
                        <span class="service-discovery-pulse-card__label">@L["Page:Metrics:Instances"]</span>
                        <strong>@RunningInstanceCount</strong>
                    </span>
                </article>
            </section>

            <MudTabs @bind-ActivePanelIndex="PageState.ActiveTabIndex"
                     Elevation="0"
                     Rounded="false"
                     Class="service-discovery-tabs">
            <MudTabPanel Text="@L["Page:Tabs:ServiceList"]" Icon="@Icons.Material.Filled.List">
                <div class="tab-content-panel">
                    <section class="service-discovery-section">
                        <header class="service-discovery-section__header">
                            <div class="service-discovery-section__identity">
                                <span class="service-discovery-section__icon" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.ListAlt" />
                                </span>
                                <div>
                                    <MudText Typo="Typo.h6">@L["Page:ServiceList:Title"]</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @L["Page:ServiceList:Description"]
                                    </MudText>
                                </div>
                            </div>
                            <div class="service-discovery-section__controls">
                                <MudSwitch T="bool"
                                           @bind-Value="PageState.AutoRefreshEnabled"
                                           @bind-Value:after="OnAutoRefreshToggled"
                                           Color="Color.Success"
                                           Label="@L["Shared:Labels:AutoRefresh"]" />
                                <MudNumericField T="int"
                                                 @bind-Value="PageState.RefreshInterval"
                                                 @bind-Value:after="OnRefreshIntervalChanged"
                                                 Label="@L["Shared:Labels:RefreshIntervalSeconds"]"
                                                 Min="1"
                                                 Max="60"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Class="service-discovery-section__interval"
                                                 Disabled="!PageState.AutoRefreshEnabled"
                                                 Immediate="true" />
                            </div>
                        </header>

                        <div class="service-discovery-section__body">
                            <ServiceFilterPanel
                                AllServices="@PageState.Services"
                                FilterText="@PageState.FilterText"
                                FilterTextChanged="@OnFilterTextChanged"
                                SelectedStatuses="@PageState.SelectedStatuses"
                                SelectedStatusesChanged="@OnSelectedStatusesChanged"
                                SelectedDomains="@PageState.SelectedDomains"
                                SelectedDomainsChanged="@OnSelectedDomainsChanged"
                                ShowOnlyWithInstances="@PageState.ShowOnlyWithInstances"
                                ShowOnlyWithInstancesChanged="@OnShowOnlyWithInstancesChanged"
                                OnFiltersChanged="@ApplyFilters" />

                            <ServiceDiscoveryServiceList Services="PageState.FilteredServices" OnRefresh="@(() => RefreshServicesAsync())" IsLoading="PageState.IsLoading" />

                            @if (!PageState.IsLoading && !PageState.Services.Any())
                            {
                                <MudPaper Class="service-discovery-page__empty-state" Elevation="0" Outlined="true">
                                    <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">
                                        @L["Page:States:NoServices"]
                                    </MudText>
                                </MudPaper>
                            }
                        </div>
                    </section>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["Page:Tabs:ServiceGraph"]" Icon="@Icons.Material.Filled.AccountTree">
                <div class="tab-content-panel">
                    <ServiceVisualization OnServiceClick="OnServiceClickFromVisualization" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["Page:Tabs:DomainDependencyGraph"]" Icon="@Icons.Material.Filled.Hub">
                <div class="tab-content-panel">
                    <DomainDependencyVisualization OnDomainClick="OnDomainClickFromVisualization" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["Page:Tabs:DomainManagement"]" Icon="@Icons.Material.Filled.Domain">
                <div class="tab-content-panel">
                    @if (PageState.SelectedDomain == null)
                    {
                        <DomainList OnDomainSelected="OnDomainSelected" />
                    }
                    else
                    {
                        <DomainDetail DomainName="@PageState.SelectedDomain.Name" OnBackClick="OnBackToDomainList" OnServiceDetailClick="OnServiceDetailFromDomain" />
                    }
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["Page:Tabs:CurrentInstance"]" Icon="@Icons.Material.Filled.Computer">
                <div class="tab-content-panel">
                    <CurrentInstanceInfo />
                </div>
            </MudTabPanel>
            </MudTabs>
        </div>
    </MudContainer>
</div>

@code {
    public const string SERVICE_DISCOVERY_DEBUG_URL = "/service-discovery-manage";
    private const int DomainManagementTabIndex = 3;
    private bool _disposed;

    private int RunningServiceCount => PageState.Services.Count(service => service.OverallStatus == ServiceStatus.Running);

    private int DomainCount => PageState.Services
        .Select(service => service.DomainName ?? L["Shared:Values:Unknown"].Value)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private int RunningInstanceCount => PageState.Services.Sum(service => service.RunningInstanceCount);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        PageState.Initialize(
            L["Shared:Values:Unknown"].Value,
            () => _disposed ? Task.CompletedTask : InvokeAsync(() => RefreshServicesAsync(false, false)));

        await RefreshServicesAsync(showNotification: false);
    }

    private void OnAutoRefreshToggled()
    {
        PageState.UpdateAutoRefresh();
    }

    private void OnRefreshIntervalChanged()
    {
        PageState.UpdateAutoRefresh();
    }

    private async Task RefreshServicesAsync(bool showNotification = true, bool showLoading = true)
    {
        if (_disposed)
        {
            return;
        }

        var result = await PageState.RefreshServicesAsync(showLoading);
        if (result.IsFailed(out var error, out _))
        {
            if (showNotification)
            {
                Snackbar.Add(L["Page:Messages:LoadServicesFailed", error.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Error);
            }
        }
        else if (showNotification)
        {
            Snackbar.Add(L["Page:Messages:ServiceListRefreshed"].Value, Severity.Success);
        }

        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private Task OnFilterTextChanged(string text)
    {
        PageState.SetFilterText(text);
        return Task.CompletedTask;
    }

    private Task OnSelectedStatusesChanged(IReadOnlyCollection<ServiceStatus> statuses)
    {
        PageState.SetSelectedStatuses(statuses);
        return Task.CompletedTask;
    }

    private Task OnSelectedDomainsChanged(IReadOnlyCollection<string> domains)
    {
        PageState.SetSelectedDomains(domains);
        return Task.CompletedTask;
    }

    private Task OnShowOnlyWithInstancesChanged(bool value)
    {
        PageState.SetShowOnlyWithInstances(value);
        return Task.CompletedTask;
    }

    private Task OnServiceClickFromVisualization(RegisteredServiceStatus service)
        => OpenServiceDetailAsync(service);

    private Task OnServiceDetailFromDomain(RegisteredServiceStatus service)
        => OpenServiceDetailAsync(service);

    private async Task OpenServiceDetailAsync(RegisteredServiceStatus service)
    {
        var parameters = new DialogParameters
        {
            ["Service"] = service
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        await DialogService.ShowAsync<ServiceDiscoveryServiceDetailDialog>(L["Page:Dialogs:ServiceDetailTitle", service.AppName].Value, parameters, options);
    }

    private Task OnDomainSelected(DomainInfo domain)
    {
        PageState.SelectDomain(domain);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnBackToDomainList()
    {
        PageState.ClearSelectedDomain();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnDomainClickFromVisualization(string domainName)
    {
        if (!(await ServiceDiscoveryFacade.GetDomainsAsync()).IsFailed(out var error, out var domains))
        {
            var domain = domains?.FirstOrDefault(d => d.Name == domainName);
            if (domain != null)
            {
                PageState.OpenDomainManagement(domain, DomainManagementTabIndex);
                StateHasChanged();
                Snackbar.Add(L["Page:Messages:SwitchedToDomainDetail", domain.DisplayName ?? domain.Name].Value, Severity.Info);
            }
            else
            {
                Snackbar.Add(L["Page:Messages:DomainNotFound", domainName].Value, Severity.Warning);
            }
        }
        else
        {
            Snackbar.Add(L["Page:Messages:LoadDomainsFailed", error.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Error);
        }
        await Task.CompletedTask;
    }

    private Task ApplyFilters()
    {
        PageState.ApplyFilters();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _disposed = true;
        PageState.Dispose();
    }
}
