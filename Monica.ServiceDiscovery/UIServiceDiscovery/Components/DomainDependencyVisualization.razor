@using Monica.ServiceDiscovery.Facades
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Support
@using Monica.Core.Results;
@using Monica.UI.Shared.Components.ContextMenu
@inject ServiceDiscoveryFacade ServiceDiscoveryFacade
@inject ServiceDiscoveryDomainColorResolver DomainColorResolver
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<ServiceDiscoveryResource> L
@implements IAsyncDisposable

<section class="domain-discovery-visual">
    <header class="domain-discovery-visual__header">
        <div class="domain-discovery-visual__identity">
            <span class="domain-discovery-visual__icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Hub" />
            </span>
            <div>
                <MudText Typo="Typo.h6">@L["DomainGraph:Title"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["DomainGraph:Description"]</MudText>
            </div>
        </div>
        <div class="domain-discovery-visual__actions">
            <MudTooltip Text="@L["DomainGraph:Tooltips:RefreshData"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               OnClick="LoadDomainDataAsync"
                               Disabled="@_loading" />
            </MudTooltip>
            <MudTooltip Text="@L["DomainGraph:Tooltips:ResetView"]">
                <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                               Color="Color.Secondary"
                               OnClick="ResetView"
                               Disabled="@_loading" />
            </MudTooltip>
            <MudTooltip Text="@L["DomainGraph:Tooltips:LayoutSettings"]">
                <MudIconButton Icon="@Icons.Material.Filled.Dashboard"
                               Color="Color.Info"
                               OnClick="ToggleLayoutPanel" />
            </MudTooltip>
            <MudTooltip Text="@L["DomainGraph:Tooltips:FilterSettings"]">
                <MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
                               Color="Color.Tertiary"
                               OnClick="ToggleFilterPanel" />
            </MudTooltip>
        </div>
    </header>
    <div class="domain-discovery-visual__body">
        @if (_showLayoutPanel)
        {
            <DomainLayoutPanel CurrentLayout="_currentLayout"
                               ForceDistance="_forceDistance"
                               ForceStrength="_forceStrength"
                               CurrentLayoutChanged="OnLayoutChanged"
                               ForceDistanceChanged="OnForceDistanceChanged"
                               ForceStrengthChanged="OnForceStrengthChanged" />
        }
        
        @if (_showFilterPanel)
        {
            <DomainFilterPanel @bind-FilterText="_filterText"
                               @bind-SelectedDomains="_selectedDomainsFilter"
                               @bind-ShowOnlyWithServices="_showOnlyWithServices"
                               @bind-ShowOnlyWithDependencies="_showOnlyWithDependencies"
                               OnFiltersChanged="ApplyFilters"
                               AllDomains="_domains" />
        }

        <MudPaper Class="visualization-container" Elevation="0" Outlined="true">
            @if (_loading)
            {
                <MudOverlay Visible="true" DarkBackground="false" Absolute="true">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </MudOverlay>
            }
            <div id="@_graphContainerId" class="domain-discovery-visual__canvas" @onclick="OnBackgroundClick" @oncontextmenu:preventDefault="true"></div>
        </MudPaper>

        <MudPaper Class="domain-discovery-visual__legend" Elevation="0" Outlined="true">
            <MudGrid>
                <MudItem xs="12" sm="8">
                    <MudText Typo="Typo.caption">
                        @L["DomainGraph:Summary:ShowingDomainsAndDependencies", _filteredDomains.Count, _domains.Count, _filteredDependencies.Count, _dependencies.Count]
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="4" Class="domain-discovery-visual__legend-items">
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Circle" Color="Color.Info">@L["DomainGraph:Summary:NodeLegend"]</MudChip>
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary">@L["DomainGraph:Summary:ArrowLegend"]</MudChip>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </div>
</section>

@* Context menu *@
<MoContextMenu TItem="string" 
               Items="@_contextMenuItems" 
               Visible="@_contextMenuOpen"
               InitialX="@_contextMenuX" 
               InitialY="@_contextMenuY"
               ContextItem="@_contextMenuDomainName"
               OnItemClick="@OnContextMenuItemClick"
               OnClose="@CloseContextMenu" />

@code {
    [Parameter] public EventCallback<string> OnDomainClick { get; set; }

    private const string JS_MODULE_PATH = "./_content/Monica.ServiceDiscovery/UIServiceDiscovery/domainDependencyGraph.js";
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly SemaphoreSlim _interopGate = new(1, 1);
    private readonly object _disposeSync = new();
    private readonly string _graphContainerId = $"domain-dependency-graph-{Guid.NewGuid():N}";
    private IJSObjectReference? _graphController;
    private DotNetObjectReference<DomainDependencyVisualization>? _dotNetReference;
    private Task? _disposeTask;
    private List<DomainInfo> _domains = [];
    private List<DomainInfo> _filteredDomains = [];
    private List<DomainDependency> _dependencies = [];
    private List<DomainDependency> _filteredDependencies = [];
    private Dictionary<string, List<RegisteredServiceStatus>> _domainServicesMap = new();
    private bool _loading = false;
    
    // Filter-related fields
    private bool _showFilterPanel = false;
    private bool _showLayoutPanel = false;
    private string _filterText = string.Empty;
    private IReadOnlyCollection<string> _selectedDomainsFilter = new HashSet<string>();
    private bool _showOnlyWithServices = false;
    private bool _showOnlyWithDependencies = false;
    
    // Layout-related fields
    private DomainLayoutType _currentLayout = DomainLayoutType.Force;
    private int _forceDistance = 200;
    private int _forceStrength = -800;
    
    // Context-menu-related fields
    private bool _contextMenuOpen = false;
    private double _contextMenuX = 0;
    private double _contextMenuY = 0;
    private string? _contextMenuDomainName;
    private List<ContextMenuItem<string>> _contextMenuItems = new();
    private volatile bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await InitializeGraphAsync();
            if (!_disposed)
            {
                await LoadDomainDataAsync();
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
    }

    private async Task InitializeGraphAsync()
    {
        await _interopGate.WaitAsync(_lifetimeCancellation.Token);

        IJSObjectReference? module = null;
        IJSObjectReference? graphController = null;
        DotNetObjectReference<DomainDependencyVisualization>? dotNetReference = null;
        try
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                JS_MODULE_PATH);

            if (_disposed)
            {
                return;
            }

            var isDarkMode = await JSRuntime.InvokeAsync<bool>(
                "eval",
                _lifetimeCancellation.Token,
                "document.documentElement.classList.contains('dark')");

            dotNetReference = DotNetObjectReference.Create(this);
            graphController = await module.InvokeAsync<IJSObjectReference>(
                "createGraph",
                _graphContainerId,
                isDarkMode,
                dotNetReference,
                GetGraphTexts());

            if (_disposed)
            {
                return;
            }

            _graphController = graphController;
            _dotNetReference = dotNetReference;
            graphController = null;
            dotNetReference = null;
        }
        finally
        {
            await DisposeGraphControllerAsync(graphController);
            dotNetReference?.Dispose();
            await ReleaseModuleReferenceAsync(module);

            _interopGate.Release();
        }
    }

    private async Task LoadDomainDataAsync()
    {
        _loading = true;
        if (!_disposed)
        {
            StateHasChanged();
        }

        try
        {
            // Load domains first so the shared resolver can assign a stable color map.
            if (!(await ServiceDiscoveryFacade.GetDomainsAsync()).IsFailed(out var error, out var domains))
            {
                _domains = domains ?? [];
                DomainColorResolver.AssignColors(_domains);

                // Get merged service statuses to build dependencies
                if (!(await ServiceDiscoveryFacade.GetMergedServicesStatusAsync()).IsFailed(out var servicesError, out var services))
                {
                    BuildDomainDependencies(services ?? []);
                    BuildDomainServicesMap(services ?? []);
                }
                else
                {
                    Snackbar.Add(L["DomainGraph:Messages:GetServicesFailed", servicesError.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Warning);
                }

                // Initialize filters
                InitializeFilters();
                
                // Apply filters
                await ApplyFilters();
            }
            else
            {
                Snackbar.Add(L["DomainGraph:Messages:GetDomainsFailed", error.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Error);
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["DomainGraph:Messages:LoadFailed", ex.Message].Value, Severity.Error);
        }
        finally
        {
            _loading = false;
            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private void BuildDomainDependencies(List<RegisteredServiceStatus> services)
    {
        _dependencies.Clear();
        var dependencySet = new HashSet<(string, string)>();

        foreach (var service in services)
        {
            if (service.DependentSubDomains?.Any() == true)
            {
                var sourceDomain = GetServiceDomainName(service);
                
                foreach (var dependentDomain in service.DependentSubDomains)
                {
                    if (sourceDomain != dependentDomain && 
                        dependencySet.Add((sourceDomain, dependentDomain)))
                    {
                        _dependencies.Add(new DomainDependency
                        {
                            SourceDomain = sourceDomain,
                            TargetDomain = dependentDomain,
                            ServiceCount = services.Count(s => 
                                GetServiceDomainName(s) == sourceDomain && 
                                s.DependentSubDomains?.Contains(dependentDomain) == true)
                        });
                    }
                }
            }
        }
    }

    private void BuildDomainServicesMap(List<RegisteredServiceStatus> services)
    {
        _domainServicesMap.Clear();
        
        foreach (var service in services)
        {
            var domainName = GetServiceDomainName(service);
            if (!_domainServicesMap.ContainsKey(domainName))
            {
                _domainServicesMap[domainName] = new List<RegisteredServiceStatus>();
            }
            _domainServicesMap[domainName].Add(service);
        }
    }

    [JSInvokable]
    public async Task OnDomainClickFromJS(string domainName)
    {
        if (_disposed)
        {
            return;
        }

        if (OnDomainClick.HasDelegate)
        {
            await OnDomainClick.InvokeAsync(domainName);
        }
    }
    
    [JSInvokable]
    public void OnDomainRightClick(string domainName, double x, double y)
    {
        if (_disposed)
        {
            return;
        }

        _contextMenuDomainName = domainName;
        _contextMenuX = x;
        _contextMenuY = y;
        _contextMenuItems = BuildContextMenuItems(domainName);
        _contextMenuOpen = true;
        StateHasChanged();
    }
    
    private void OnBackgroundClick()
    {
        if (_contextMenuOpen)
        {
            _contextMenuOpen = false;
            StateHasChanged();
        }
    }
    
    [JSInvokable]
    public void OnSvgBackgroundClick()
    {
        if (_disposed)
        {
            return;
        }

        if (_contextMenuOpen)
        {
            _contextMenuOpen = false;
            StateHasChanged();
        }
    }
    
    private void CloseContextMenu()
    {
        _contextMenuOpen = false;
    }
    
    private List<ContextMenuItem<string>> BuildContextMenuItems(string domainName)
    {
        var domain = _domains.FirstOrDefault(d => d.Name == domainName);
        var hasServices = _domainServicesMap.ContainsKey(domainName) && _domainServicesMap[domainName].Any();
        var hasDependencies = _dependencies.Any(d => d.SourceDomain == domainName || d.TargetDomain == domainName);
        
        var builder = ContextMenuBuilder<string>.Create()
            .AddItem(L["DomainGraph:ContextMenu:ViewDomainDetails"].Value, Icons.Material.Filled.Info, ViewDomainDetailsAsync)
            .AddItem(L["DomainGraph:ContextMenu:FocusDomain"].Value, Icons.Material.Filled.CenterFocusStrong, FocusOnDomainAsync)
            .AddDivider()
            .AddItemIf(hasServices, L["DomainGraph:ContextMenu:FilterDomainServices"].Value, Icons.Material.Filled.FilterAlt, FilterByDomainAsync)
            .AddItemIf(hasDependencies, L["DomainGraph:ContextMenu:ShowDependencies"].Value, Icons.Material.Filled.AccountTree, ShowDependenciesAsync)
            .AddItem(L["DomainGraph:ContextMenu:ClearFilters"].Value, Icons.Material.Filled.ClearAll, ClearAllFiltersAsync)
            .AddDivider()
            .AddItem(L["DomainGraph:ContextMenu:CopyDomainName"].Value, Icons.Material.Filled.ContentCopy, CopyDomainNameAsync);
        
        return builder.Build();
    }
    
    private Task OnContextMenuItemClick(ContextMenuItem<string> item)
    {
        _contextMenuOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private Task ViewDomainDetailsAsync(string? domainName)
    {
        var domain = _domains.FirstOrDefault(d => d.Name == domainName);
        if (domain != null)
        {
            var serviceCount = _domainServicesMap.GetValueOrDefault(domainName ?? "", new List<RegisteredServiceStatus>()).Count;
            var dependencyCount = _dependencies.Count(d => d.SourceDomain == domainName || d.TargetDomain == domainName);
            
            Snackbar.Add(L["DomainGraph:Messages:DomainSummary", domain.DisplayName ?? domain.Name, serviceCount, dependencyCount].Value, Severity.Info);
        }

        return Task.CompletedTask;
    }
    
    private async Task FocusOnDomainAsync(string? domainName)
    {
        if (!string.IsNullOrEmpty(domainName))
        {
            await InvokeGraphAsync("focusOnNode", domainName);
        }
    }
    
    private async Task FilterByDomainAsync(string? domainName)
    {
        if (!string.IsNullOrEmpty(domainName))
        {
            _selectedDomainsFilter = new HashSet<string> { domainName };
            _showFilterPanel = true;
            await ApplyFilters();
            Snackbar.Add(L["DomainGraph:Messages:FilteredDomain", domainName].Value, Severity.Info);
        }
    }
    
    private async Task ShowDependenciesAsync(string? domainName)
    {
        if (!string.IsNullOrEmpty(domainName))
        {
            var relatedDomains = new HashSet<string> { domainName };
            var domainDeps = _dependencies.Where(d => d.SourceDomain == domainName || d.TargetDomain == domainName);
            
            foreach (var dep in domainDeps)
            {
                relatedDomains.Add(dep.SourceDomain);
                relatedDomains.Add(dep.TargetDomain);
            }
            
            _selectedDomainsFilter = relatedDomains;
            _showOnlyWithDependencies = true;
            _showFilterPanel = true;
            await ApplyFilters();
            Snackbar.Add(L["DomainGraph:Messages:ShowingDependencies", domainName].Value, Severity.Info);
        }
    }
    
    private async Task ClearAllFiltersAsync(string? domainName)
    {
        _filterText = string.Empty;
        _selectedDomainsFilter = new HashSet<string>(_domains.Select(d => d.Name));
        _showOnlyWithServices = false;
        _showOnlyWithDependencies = false;
        await ApplyFilters();
        Snackbar.Add(L["DomainGraph:Messages:ClearedFilters"].Value, Severity.Info);
    }
    
    private async Task CopyDomainNameAsync(string? domainName)
    {
        if (!string.IsNullOrEmpty(domainName))
        {
            await CopyToClipboardAsync(domainName);
            Snackbar.Add(L["DomainGraph:Messages:CopiedDomainName"].Value, Severity.Success);
        }
    }

    private void InitializeFilters()
    {
        // Initialize selected domains
        if (!_selectedDomainsFilter.Any())
        {
            var allDomainNames = _domains.Select(d => d.Name).ToList();
            _selectedDomainsFilter = new HashSet<string>(allDomainNames);
        }
    }
    
    private void ToggleFilterPanel()
    {
        _showFilterPanel = !_showFilterPanel;
        if (_showFilterPanel) _showLayoutPanel = false;
    }
    
    private void ToggleLayoutPanel()
    {
        _showLayoutPanel = !_showLayoutPanel;
        if (_showLayoutPanel) _showFilterPanel = false;
    }

    private string GetServiceDomainName(RegisteredServiceStatus service)
        => service.DomainName ?? L["Shared:Values:Unknown"].Value;

    private async Task ApplyFilters()
    {
        _filteredDomains = _domains.Where(domain =>
        {
            // Domain-name filter
            if (!_selectedDomainsFilter.Contains(domain.Name))
                return false;
                
            // Text filter
            if (!string.IsNullOrWhiteSpace(_filterText))
            {
                var matchesText = domain.Name.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ||
                                  (!string.IsNullOrEmpty(domain.DisplayName) && domain.DisplayName.Contains(_filterText, StringComparison.OrdinalIgnoreCase)) ||
                                  (!string.IsNullOrEmpty(domain.Description) && domain.Description.Contains(_filterText, StringComparison.OrdinalIgnoreCase));
                
                if (!matchesText)
                    return false;
            }
            
            // Show only domains that have services
            if (_showOnlyWithServices)
            {
                var hasServices = _domainServicesMap.ContainsKey(domain.Name) && _domainServicesMap[domain.Name].Any();
                if (!hasServices)
                    return false;
            }
            
            return true;
        }).ToList();
        
        // Filter dependencies: keep only dependencies whose source and target both exist in the filtered domain list.
        _filteredDependencies = _dependencies.Where(dep =>
        {
            var hasSource = _filteredDomains.Any(d => d.Name == dep.SourceDomain);
            var hasTarget = _filteredDomains.Any(d => d.Name == dep.TargetDomain);
            
            // If showing only domains with dependencies, both ends of the dependency must exist.
            if (_showOnlyWithDependencies)
            {
                return hasSource && hasTarget;
            }
            
            return hasSource && hasTarget;
        }).ToList();
        
        // If showing only domains with dependencies, further filter the domain list.
        if (_showOnlyWithDependencies)
        {
            var domainsWithDependencies = new HashSet<string>();
            foreach (var dep in _filteredDependencies)
            {
                domainsWithDependencies.Add(dep.SourceDomain);
                domainsWithDependencies.Add(dep.TargetDomain);
            }
            
            _filteredDomains = _filteredDomains.Where(d => domainsWithDependencies.Contains(d.Name)).ToList();
        }
        
        await UpdateGraph();
    }

    private async Task UpdateGraph()
    {
        await InvokeGraphAsync("updateGraph", PrepareGraphData());

        // Apply current layout settings
        await SetLayout(_currentLayout);
        if (_currentLayout == DomainLayoutType.Force)
        {
            await InvokeGraphAsync("setForceDistance", _forceDistance);
            await InvokeGraphAsync("setForceStrength", _forceStrength);
        }
    }
    
    private async Task SetLayout(DomainLayoutType layoutType)
    {
        _currentLayout = layoutType;
        var layoutName = layoutType switch
        {
            DomainLayoutType.Force => "force",
            DomainLayoutType.Hierarchy => "hierarchy",
            DomainLayoutType.Circular => "circular",
            DomainLayoutType.RadialTree => "radial_tree",
            _ => "force"
        };
        await InvokeGraphAsync("setLayout", layoutName);
    }
    
    private Task OnLayoutChanged(DomainLayoutType layoutType) => SetLayout(layoutType);
    
    private async Task OnForceDistanceChanged(int value)
    {
        _forceDistance = value;
        await InvokeGraphAsync("setForceDistance", value);
    }
    
    private async Task OnForceStrengthChanged(int value)
    {
        _forceStrength = value;
        await InvokeGraphAsync("setForceStrength", value);
    }

    private object PrepareGraphData()
    {
        var nodes = _filteredDomains.Select(domain => new
        {
            id = domain.Name,
            name = domain.DisplayName ?? domain.Name,
            description = domain.Description,
            colorRole = DomainColorResolver.GetDomainColorRole(domain.Name),
            services = _domainServicesMap.GetValueOrDefault(domain.Name, new List<RegisteredServiceStatus>())
                .Select(s => new
                {
                    name = s.AppName,
                    appName = s.AppName,
                    status = s.OverallStatus.ToString(),
                    overallStatus = s.OverallStatus.ToString()
                }).ToList()
        }).ToList();

        var links = _filteredDependencies.Select(dep => new
        {
            source = dep.SourceDomain,
            target = dep.TargetDomain,
            serviceCount = dep.ServiceCount,
            colorRole = DomainColorResolver.GetDomainColorRole(dep.SourceDomain)
        }).ToList();

        return new { nodes, links };
    }

    private async Task ResetView()
    {
        await InvokeGraphAsync("resetView");
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync)
        {
            return new ValueTask(_disposeTask ??= DisposeCoreAsync());
        }
    }

    private async Task DisposeCoreAsync()
    {
        _disposed = true;
        await _lifetimeCancellation.CancelAsync();

        await _interopGate.WaitAsync();
        try
        {
            var graphController = Interlocked.Exchange(ref _graphController, null);
            var dotNetReference = Interlocked.Exchange(ref _dotNetReference, null);

            await DisposeGraphControllerAsync(graphController);
            dotNetReference?.Dispose();
        }
        finally
        {
            _interopGate.Release();
        }

        // A caller may have observed the pre-disposal state immediately before teardown began and still be
        // approaching the gate. Keep these lightweight primitives alive so cancellation settles that admission
        // race without turning an expected lifetime transition into ObjectDisposedException.
    }

    private async Task InvokeGraphAsync(string identifier, params object?[] arguments)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await _interopGate.WaitAsync(_lifetimeCancellation.Token);
            try
            {
                if (!_disposed && _graphController is not null)
                {
                    await _graphController.InvokeVoidAsync(identifier, _lifetimeCancellation.Token, arguments);
                }
            }
            finally
            {
                _interopGate.Release();
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
    }

    private async Task CopyToClipboardAsync(string value)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                _lifetimeCancellation.Token,
                value);
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
    }

    private static async ValueTask DisposeGraphControllerAsync(IJSObjectReference? graphController)
    {
        if (graphController is null)
        {
            return;
        }

        try
        {
            await graphController.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        try
        {
            await graphController.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private static async ValueTask ReleaseModuleReferenceAsync(IJSObjectReference? module)
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private class DomainDependency
    {
        public required string SourceDomain { get; set; }
        public required string TargetDomain { get; set; }
        public int ServiceCount { get; set; }
    }

    private object GetGraphTexts() => new
    {
        labels = new
        {
            serviceCount = L["DomainGraph:Graph:Labels:ServiceCount"].Value,
            relatedServices = L["DomainGraph:Graph:Labels:RelatedServices"].Value,
            statusCount = L["DomainGraph:Graph:Labels:StatusCount"].Value,
            andMore = L["DomainGraph:Graph:Labels:AndMore"].Value,
            noRelatedServices = L["DomainGraph:Graph:Labels:NoRelatedServices"].Value,
            clickToViewDetails = L["DomainGraph:Graph:Labels:ClickToViewDetails"].Value,
            dependencyServiceCount = L["DomainGraph:Graph:Labels:DependencyServiceCount"].Value
        },
        statuses = new
        {
            running = L["Shared:ServiceStatuses:Running"].Value,
            updating = L["Shared:ServiceStatuses:Updating"].Value,
            offline = L["Shared:ServiceStatuses:Offline"].Value,
            error = L["Shared:ServiceStatuses:Error"].Value,
            unknown = L["Shared:ServiceStatuses:Unknown"].Value
        }
    };
}
