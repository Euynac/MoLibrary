@using Microsoft.Extensions.Options
@using Monica.Modules
@using Monica.ServiceDiscovery.Abstractions
@using Monica.ServiceDiscovery.Facades
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Support
@using Monica.Tool.Extensions
@using Monica.Core.Results;
@inject IOptions<ModuleServiceDiscoveryOption> ServiceDiscoveryOptions
@inject ILeaderElectionService LeaderElectionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ServiceDiscoveryFacade ServiceDiscoveryFacade
@inject IStringLocalizer<ServiceDiscoveryResource> L

@if (Service != null)
{
    <MudTabs Elevation="0" Rounded="true" Centered="false" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
        <MudTabPanel Text="@L["ServiceDetail:Tabs:Overview"]">
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string"
                                              Label="@L["ServiceDetail:Overview:Fields:AppId"]"
                                              Value="@Service.AppId"
                                              ReadOnly="true"
                                              Sizing="InputSizing.Auto"
                                              MaxLines="3" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string"
                                              Label="@L["ServiceDetail:Overview:Fields:ServiceName"]"
                                              Value="@Service.AppName"
                                              ReadOnly="true"
                                              Sizing="InputSizing.Auto"
                                              MaxLines="3" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string"
                                              Label="@L["ServiceDetail:Overview:Fields:ProjectName"]"
                                              Value="@Service.ProjectName"
                                              ReadOnly="true"
                                              Sizing="InputSizing.Auto"
                                              MaxLines="3" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string"
                                              Label="@L["ServiceDetail:Overview:Fields:DomainName"]"
                                              Value="@Service.DomainName"
                                              ReadOnly="true"
                                              Sizing="InputSizing.Auto"
                                              MaxLines="3" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-3">@L["ServiceDetail:Status:Title"]</MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="4">
                                <MudChip T="string" Color="@Service.OverallStatus.GetColor()" Icon="@Service.OverallStatus.GetIcon()" Size="Size.Large">
                                    @Service.OverallStatus.GetText(L)
                                </MudChip>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.body1">@L["ServiceDetail:Status:RunningInstances", Service.RunningInstanceCount]</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.body1">@L["ServiceDetail:Status:TotalInstances", Service.TotalInstanceCount]</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        
        <MudTabPanel Text="@L["ServiceDetail:Tabs:Instances", Service.TotalInstanceCount + Service.EvictedInstances.Count]">
            <MudDataGrid T="InstanceDisplayItem" Items="@GetAllInstancesForDisplay()" Hover="true" Dense="true">
                <Columns>
                    <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:InstanceId"]">
                        <CellTemplate>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudTooltip Text="@context.Item.Instance.InstanceId">
                                    <MudText Typo="Typo.body2" Class="text-truncate" Style="@($"max-width: 200px; {(context.Item.IsEvicted ? "opacity: 0.6;" : "")}")">
                                        @context.Item.Instance.InstanceId
                                    </MudText>
                                </MudTooltip>
                                @if (context.Item.Instance.IsLeader)
                                {
                                    <MudTooltip Text="@L["ServiceDetail:Instances:Values:LeaderInstance"]">
                                        <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium"
                                                 Color="Color.Warning"
                                                 Size="Size.Small" />
                                    </MudTooltip>
                                }
                                @if (context.Item.IsEvicted)
                                {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                                        @L["ServiceDetail:Instances:Values:Evicted"]
                                    </MudChip>
                                }
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:Status"]">
                        <CellTemplate>
                            <MudChip T="string"
                                     Color="@context.Item.Instance.Status.GetColor()"
                                     Size="Size.Small"
                                     Icon="@context.Item.Instance.Status.GetIcon()"
                                     Style="@(context.Item.IsEvicted ? "opacity: 0.6;" : "")">
                                @context.Item.Instance.Status.GetText(L)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:Role"]">
                        <CellTemplate>
                            @if (context.Item.Instance.IsLeader)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Star" Style="@(context.Item.IsEvicted ? "opacity: 0.6;" : "")">
                                    @L["Shared:LeaderStatuses:Leader"]
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Circle" Variant="Variant.Outlined" Style="@(context.Item.IsEvicted ? "opacity: 0.6;" : "")">
                                    @L["Shared:LeaderStatuses:Follower"]
                                </MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Instance.AssemblyVersion" Title="@L["ServiceDetail:Instances:Columns:AssemblyVersion"]" />
                    <PropertyColumn Property="x => x.Instance.ReleaseVersion" Title="@L["ServiceDetail:Instances:Columns:ReleaseVersion"]" />
                    <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:BuildTime"]">
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Style="@(context.Item.IsEvicted ? "opacity: 0.6;" : "")">
                                @context.Item.Instance.BuildTime.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:LastHeartbeat"]">
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Style="@(context.Item.IsEvicted ? "opacity: 0.6;" : "")">
                                @context.Item.Instance.LastHeartbeatTime.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:RegistrationTime"]">
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Style="@(context.Item.IsEvicted ? "opacity: 0.6;" : "")">
                                @context.Item.Instance.RegistrationTime.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    @if (HasEvictedInstances())
                    {
                        <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:EvictionTime"]">
                            <CellTemplate>
                                @if (context.Item.IsEvicted)
                                {
                                    <MudText Typo="Typo.body2">
                                        @context.Item.EvictionTime?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss")
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Shared:Values:NotAvailable"]</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    }
                    <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:HeartbeatHealth"]">
                        <CellTemplate>
                            @{
                                var timeSinceHeartbeat = DateTime.Now - context.Item.Instance.LastHeartbeatTime.FromUtcToLocal();
                                var healthText = GetHeartbeatHealthText(timeSinceHeartbeat);
                                var healthColor = GetHeartbeatHealthColor(timeSinceHeartbeat);
                            }
                            <MudText Typo="Typo.body2" Color="@healthColor" Style="@(context.Item.IsEvicted ? "opacity: 0.6;" : "")">@healthText</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudTabPanel>
        
        <MudTabPanel Text="@L["ServiceDetail:Tabs:Configuration"]">
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-3">@L["ServiceDetail:Configuration:Sections:ElectionConfig"]</MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="3">
                                <MudTextField T="int" Label="@L["ServiceDetail:Configuration:Fields:HeartbeatPeriodSeconds"]"
                                            Value="@ServiceDiscoveryOptions.Value.Election.HeartbeatPeriodSeconds"
                                            ReadOnly="true"
                                            HelperText="@L["ServiceDetail:Configuration:Fields:HeartbeatPeriodHelper"]" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="int" Label="@L["ServiceDetail:Configuration:Fields:HeartbeatJitterMilliseconds"]"
                                            Value="@ServiceDiscoveryOptions.Value.Election.HeartbeatJitterMilliseconds"
                                            ReadOnly="true"
                                            HelperText="@L["ServiceDetail:Configuration:Fields:HeartbeatJitterHelper"]" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-3">@L["ServiceDetail:Configuration:Sections:TtlConfig"]</MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-3" Elevation="1">
                                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["ServiceDetail:Configuration:Fields:InstanceTtl"]</MudText>
                                    <MudGrid>
                                        <MudItem xs="4">
                                            <MudTextField T="double" Label="@L["ServiceDetail:Configuration:Fields:Multiplier"]"
                                                        Value="@ServiceDiscoveryOptions.Value.Election.RegistrationOfflineTTLMultiplier"
                                                        ReadOnly="true" />
                                        </MudItem>
                                        <MudItem xs="4">
                                            <MudTextField T="int" Label="@L["ServiceDetail:Configuration:Fields:AdditionalSeconds"]"
                                                        Value="@ServiceDiscoveryOptions.Value.Election.RegistrationOfflineTTLAdditionalSeconds"
                                                        ReadOnly="true" />
                                        </MudItem>
                                        <MudItem xs="4">
                                            <MudTextField T="string" Label="@L["ServiceDetail:Configuration:Fields:CalculatedValue"]"
                                                        Value="@L["Shared:Formats:SecondsValue", ServiceDiscoveryOptions.Value.Election.RegistrationTTL.TotalSeconds]"
                                                        ReadOnly="true" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="pa-3" Elevation="1">
                                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["ServiceDetail:Configuration:Fields:LeaderTtl"]</MudText>
                                    <MudGrid>
                                        <MudItem xs="4">
                                            <MudTextField T="double" Label="@L["ServiceDetail:Configuration:Fields:Multiplier"]"
                                                        Value="@ServiceDiscoveryOptions.Value.Election.LeaderOfflineTTLMultiplier"
                                                        ReadOnly="true" />
                                        </MudItem>
                                        <MudItem xs="4">
                                            <MudTextField T="int" Label="@L["ServiceDetail:Configuration:Fields:AdditionalSeconds"]"
                                                        Value="@ServiceDiscoveryOptions.Value.Election.LeaderOfflineTTLAdditionalSeconds"
                                                        ReadOnly="true" />
                                        </MudItem>
                                        <MudItem xs="4">
                                            <MudTextField T="string" Label="@L["ServiceDetail:Configuration:Fields:CalculatedValue"]"
                                                        Value="@L["Shared:Formats:SecondsValue", ServiceDiscoveryOptions.Value.Election.LeaderTTL.TotalSeconds]"
                                                        ReadOnly="true" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-3">@L["ServiceDetail:Configuration:Sections:RuntimeMode"]</MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" Label="@L["ServiceDetail:Configuration:Fields:StateStoreMode"]"
                                            Value="@GetStorageModeText()"
                                            ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" Label="@L["ServiceDetail:Configuration:Fields:IsolationHandlingMode"]"
                                            Value="@GetIsolationHandlingModeText()"
                                            ReadOnly="true"
                                            HelperText="@L["ServiceDetail:Configuration:Fields:IsolationHandlingHelper"]" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" Label="@L["ServiceDetail:Configuration:Fields:HostRole"]"
                                            Value="@GetHostRoleText()"
                                            ReadOnly="true" />
                            </MudItem>
                        </MudGrid>
                        <MudDivider Class="my-4" />
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                            <MudText Typo="Typo.body2">
                                @L["ServiceDetail:Configuration:Messages:StateTransition"]
                            </MudText>
                        </MudAlert>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="@L["ServiceDetail:Tabs:ElectionStatus"]">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-3">@L["ServiceDetail:ElectionStatus:Sections:CurrentStatus"]</MudText>
                        <MudStack Spacing="3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.subtitle1">@L["ServiceDetail:ElectionStatus:Fields:Status"]</MudText>
                                <MudChip T="string" Color="@LeaderElectionService.CurrentStatus.GetColor()" Size="Size.Medium" Icon="@LeaderElectionService.CurrentStatus.GetIcon()">
                                    @LeaderElectionService.CurrentStatus.GetText(L)
                                </MudChip>
                            </MudStack>
                            @if (LeaderElectionService.IsLeader)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.subtitle1">@L["ServiceDetail:ElectionStatus:Fields:BecameLeaderAt"]</MudText>
                                    <MudText Typo="Typo.body1">@(LeaderElectionService.LeaderBecomeTime?.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss") ?? L["Shared:Values:NotAvailable"].Value)</MudText>
                                </MudStack>
                            }
                            @if (!string.IsNullOrEmpty(LeaderElectionService.CurrentETag))
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.subtitle1">@L["ServiceDetail:ElectionStatus:Fields:CurrentETag"]</MudText>
                                    <MudTooltip Text="@L["ServiceDetail:ElectionStatus:Tooltips:CurrentETag"]">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @LeaderElectionService.CurrentETag
                                        </MudChip>
                                    </MudTooltip>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-3">@L["ServiceDetail:ElectionStatus:Sections:Description"]</MudText>
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Star">
                                    @L["Shared:LeaderStatuses:Leader"]
                                </MudChip>
                                <MudText Typo="Typo.body2">@L["ServiceDetail:ElectionStatus:Descriptions:Leader"]</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Circle">
                                    @L["Shared:LeaderStatuses:Follower"]
                                </MudChip>
                                <MudText Typo="Typo.body2">@L["ServiceDetail:ElectionStatus:Descriptions:Follower"]</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Search">
                                    @L["Shared:LeaderStatuses:Looking"]
                                </MudChip>
                                <MudText Typo="Typo.body2">@L["ServiceDetail:ElectionStatus:Descriptions:Looking"]</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-4" />
            <MudPaper Class="pa-4" Elevation="0">
                <MudText Typo="Typo.h6" Class="mb-3">@L["ServiceDetail:ElectionStatus:Sections:Management"]</MudText>
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    @L["ServiceDetail:ElectionStatus:Warnings:ForceDeleteLeader"]
                </MudAlert>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           OnClick="OnForceDeleteLeaderClicked"
                           Disabled="@(!HasLeader)">
                    @L["ServiceDetail:ElectionStatus:Actions:ForceDeleteLeader"]
                </MudButton>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="@L["ServiceDetail:Tabs:Metadata"]">
            <MudGrid>
                @foreach (var instance in Service.Instances.Values)
                {
                    <MudItem xs="12">
                        <MudPaper Class="pa-4" Elevation="0">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <MudText Typo="Typo.h6">
                                    @L["ServiceDetail:Metadata:InstanceTitle", instance.InstanceId]
                                </MudText>
                                <MudChip T="string" Color="@instance.Status.GetColor()" Size="Size.Small" Icon="@instance.Status.GetIcon()">
                                    @instance.Status.GetText(L)
                                </MudChip>
                                @if (instance.IsLeader)
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Star">
                                        @L["Shared:LeaderStatuses:Leader"]
                                    </MudChip>
                                }
                            </MudStack>
                            @if (instance.Metadata.Any())
                            {
                                <MudDataGrid T="KeyValuePair<string, string>" Items="@instance.Metadata" Dense="true" Hover="true">
                                    <Columns>
                                        <PropertyColumn Property="x => x.Key" Title="@L["ServiceDetail:Metadata:Columns:Key"]" />
                                        <TemplateColumn Title="@L["ServiceDetail:Metadata:Columns:Value"]">
                                            <CellTemplate>
                                                <MetadataValueDisplay Value="@context.Item.Value" />
                                            </CellTemplate>
                                        </TemplateColumn>
                                    </Columns>
                                </MudDataGrid>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info">@L["ServiceDetail:Metadata:States:NoMetadata"]</MudAlert>
                            }
                        </MudPaper>
                    </MudItem>
                }
                @if (!Service.Instances.Any())
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning">@L["ServiceDetail:Metadata:States:NoInstances"]</MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public RegisteredServiceStatus Service { get; set; } = null!;

    private bool HasLeader => Service?.Instances.Values.Any(i => i.IsLeader) ?? false;

    private class InstanceDisplayItem
    {
        public required InstanceState Instance { get; set; }
        public bool IsEvicted { get; set; }
        public DateTime? EvictionTime { get; set; }
    }

    private List<InstanceDisplayItem> GetAllInstancesForDisplay()
    {
        var items = new List<InstanceDisplayItem>();

        // Add active instances
        foreach (var instance in Service.Instances.Values)
        {
            items.Add(new InstanceDisplayItem
            {
                Instance = instance,
                IsEvicted = false
            });
        }

        // Add evicted instances - convert to InstanceState for display
        foreach (var evicted in Service.EvictedInstances)
        {
            items.Add(new InstanceDisplayItem
            {
                Instance = evicted.ToInstanceState(),
                IsEvicted = true,
                EvictionTime = evicted.EvictionTime
            });
        }

        // Sort: active first, then by eviction time (most recent first)
        return items.OrderBy(x => x.IsEvicted)
                    .ThenByDescending(x => x.EvictionTime ?? DateTime.MinValue)
                    .ToList();
    }

    private bool HasEvictedInstances() => Service.EvictedInstances.Any();

    private async Task OnForceDeleteLeaderClicked()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            L["ServiceDetail:Dialogs:ConfirmActionTitle"].Value,
            L["ServiceDetail:Dialogs:ForceDeleteLeaderMessage", Service.AppName].Value,
            yesText: L["ServiceDetail:Dialogs:ConfirmDelete"].Value,
            cancelText: L["Shared:Actions:Cancel"].Value);

        if (result != true) return;

        var res = await ServiceDiscoveryFacade.ForceDeleteLeaderAsync(Service.AppId);

        if (res.IsFailed(out var error))
            Snackbar.Add(L["ServiceDetail:Messages:DeleteLeaderFailed", error].Value, Severity.Error);
        else
            Snackbar.Add(L["ServiceDetail:Messages:DeleteLeaderSucceeded"].Value, Severity.Success);
    }

    private string GetHeartbeatHealthText(TimeSpan timeSinceHeartbeat)
    {
        // Use new TTL-based thresholds from Election config
        var election = ServiceDiscoveryOptions.Value.Election;
        var unhealthyThreshold = election.HeartbeatPeriodSeconds * 1.5; // 1.5x heartbeat period
        var offlineThreshold = election.RegistrationTTL.TotalSeconds;

        if (timeSinceHeartbeat.TotalSeconds < unhealthyThreshold)
            return L["Shared:HeartbeatHealth:Healthy"].Value;
        else if (timeSinceHeartbeat.TotalSeconds < offlineThreshold)
            return L["Shared:HeartbeatHealth:Unhealthy"].Value;
        else
            return L["Shared:HeartbeatHealth:Offline"].Value;
    }

    private Color GetHeartbeatHealthColor(TimeSpan timeSinceHeartbeat)
    {
        // Use new TTL-based thresholds from Election config
        var election = ServiceDiscoveryOptions.Value.Election;
        var unhealthyThreshold = election.HeartbeatPeriodSeconds * 1.5; // 1.5x heartbeat period
        var offlineThreshold = election.RegistrationTTL.TotalSeconds;

        if (timeSinceHeartbeat.TotalSeconds < unhealthyThreshold)
            return Color.Success;
        else if (timeSinceHeartbeat.TotalSeconds < offlineThreshold)
            return Color.Warning;
        else
            return Color.Default;
    }

    private string GetIsolationHandlingModeText()
    {
        return ServiceDiscoveryOptions.Value.IsolationHandlingMode switch
        {
            EIsolationHandlingMode.ContinueRunning => L["ServiceDetail:Configuration:Values:ContinueRunning"].Value,
            EIsolationHandlingMode.FastShutdown => L["ServiceDetail:Configuration:Values:FastShutdown"].Value,
            _ => L["Shared:Values:Unknown"].Value
        };
    }

    private string GetStorageModeText()
    {
        return ServiceDiscoveryOptions.Value.StorageMode switch
        {
            ServiceDiscoveryStorageMode.Memory => L["ServiceDetail:Configuration:Values:MemoryStorage"].Value,
            ServiceDiscoveryStorageMode.Distributed => L["ServiceDetail:Configuration:Values:DistributedStorage"].Value,
            ServiceDiscoveryStorageMode.ExternalKeyed => L["ServiceDetail:Configuration:Values:ExternalKeyedStorage"].Value,
            _ => L["Shared:Values:Unknown"].Value
        };
    }

    private string GetHostRoleText()
    {
        return ServiceDiscoveryOptions.Value.Role switch
        {
            ServiceDiscoveryRole.Worker => L["ServiceDetail:Configuration:Values:WorkerRole"].Value,
            ServiceDiscoveryRole.Registry => L["ServiceDetail:Configuration:Values:RegistryRole"].Value,
            ServiceDiscoveryRole.Standalone => L["ServiceDetail:Configuration:Values:StandaloneRole"].Value,
            _ => L["Shared:Values:Unknown"].Value
        };
    }
}
