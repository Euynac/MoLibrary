@using Monica.ServiceDiscovery.Facades
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Support
@using Monica.Core.Results;
@using Monica.UI.Shared.Components.ContextMenu
@inject ServiceDiscoveryFacade ServiceDiscoveryFacade
@inject ServiceDiscoveryDomainColorResolver DomainColorResolver
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<ServiceDiscoveryResource> L
@implements IAsyncDisposable

<section class="service-discovery-visual">
    <header class="service-discovery-visual__header">
        <div class="service-discovery-visual__identity">
            <span class="service-discovery-visual__icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
            </span>
            <div>
                <MudText Typo="Typo.h6">@L["ServiceGraph:Title"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ServiceGraph:Description"]</MudText>
            </div>
        </div>
        <div class="service-discovery-visual__actions">
            <MudTooltip Text="@L["ServiceGraph:Tooltips:RefreshData"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               OnClick="LoadServiceDataAsync"
                               Disabled="@_loading" />
            </MudTooltip>
            <MudTooltip Text="@L["ServiceGraph:Tooltips:ResetView"]">
                <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                               Color="Color.Secondary"
                               OnClick="ResetView"
                               Disabled="@_loading" />
            </MudTooltip>
            <MudTooltip Text="@L["ServiceGraph:Tooltips:LayoutSettings"]">
                <MudIconButton Icon="@Icons.Material.Filled.Dashboard"
                               Color="Color.Info"
                               OnClick="ToggleLayoutPanel" />
            </MudTooltip>
            <MudTooltip Text="@L["ServiceGraph:Tooltips:FilterSettings"]">
                <MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
                               Color="Color.Tertiary"
                               OnClick="ToggleFilterPanel" />
            </MudTooltip>
        </div>
    </header>
    <div class="service-discovery-visual__body">
        @if (_showLayoutPanel)
        {
            <ServiceLayoutPanel CurrentLayout="_currentLayout"
                                ForceDistance="_forceDistance"
                                ForceStrength="_forceStrength"
                                CurrentLayoutChanged="OnLayoutChanged"
                                ForceDistanceChanged="OnForceDistanceChanged"
                                ForceStrengthChanged="OnForceStrengthChanged" />
        }
        
        @if (_showFilterPanel)
        {
            <ServiceFilterPanel @bind-FilterText="_filterText"
                                @bind-SelectedStatuses="_selectedStatuses"
                                @bind-SelectedDomains="_selectedDomains"
                                @bind-ShowOnlyWithInstances="_showOnlyWithInstances"
                                OnFiltersChanged="ApplyFilters"
                                AllServices="_allServices" />
        }

        <MudPaper Class="visualization-container" Elevation="0" Outlined="true">
            @if (_loading)
            {
                <MudOverlay Visible="true" DarkBackground="false" Absolute="true">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </MudOverlay>
            }
            <div id="@_graphContainerId" class="service-discovery-visual__canvas" @onclick="OnBackgroundClick" @oncontextmenu:preventDefault="true"></div>
        </MudPaper>

        <MudPaper Class="service-discovery-visual__legend" Elevation="0" Outlined="true">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption">
                        @L["ServiceGraph:Summary:ShowingServices", _filteredServices.Count, _allServices.Count]
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6" Class="service-discovery-visual__legend-items">
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle" 
                             Color="Color.Success" Class="mr-1 mb-1">@L["Shared:ServiceStatuses:Running"]</MudChip>
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Update" 
                             Color="Color.Info" Class="mr-1 mb-1">@L["Shared:ServiceStatuses:Updating"]</MudChip>
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.CloudOff" 
                             Color="Color.Default" Class="mr-1 mb-1">@L["Shared:ServiceStatuses:Offline"]</MudChip>
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Error" 
                             Color="Color.Error" Class="mr-1 mb-1">@L["Shared:ServiceStatuses:Error"]</MudChip>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </div>
</section>

@* Context menu *@
<MoContextMenu TItem="RegisteredServiceStatus" 
               Items="@_contextMenuItems" 
               Visible="@_contextMenuOpen"
               InitialX="@_contextMenuX" 
               InitialY="@_contextMenuY"
               ContextItem="@_contextMenuService"
               OnItemClick="@OnContextMenuItemClick"
               OnClose="@CloseContextMenu" />

@code {
    [Parameter] public EventCallback<RegisteredServiceStatus> OnServiceClick { get; set; }

    private const string JS_MODULE_PATH = "./_content/Monica.ServiceDiscovery/UIServiceDiscovery/serviceGraph.js";
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly SemaphoreSlim _interopGate = new(1, 1);
    private readonly object _disposeSync = new();
    private readonly string _graphContainerId = $"service-graph-{Guid.NewGuid():N}";
    private IJSObjectReference? _graphController;
    private DotNetObjectReference<ServiceVisualization>? _dotNetReference;
    private Task? _disposeTask;
    private List<RegisteredServiceStatus> _allServices = new();
    private List<RegisteredServiceStatus> _filteredServices = new();
    private bool _loading = false;
    private bool _showOfflineServices = true;
    
    // Filter-related fields
    private bool _showFilterPanel = false;
    private bool _showLayoutPanel = false;
    private string _filterText = string.Empty;
    private IReadOnlyCollection<ServiceStatus> _selectedStatuses = new HashSet<ServiceStatus>();
    private IReadOnlyCollection<string> _selectedDomains = new HashSet<string>();
    private bool _showOnlyWithInstances = false;
    
    // Layout-related fields
    private ServiceLayoutType _currentLayout = ServiceLayoutType.Force;
    private int _forceDistance = 150;
    private int _forceStrength = -500;
    
    // Context-menu-related fields
    private bool _contextMenuOpen = false;
    private double _contextMenuX = 0;
    private double _contextMenuY = 0;
    private RegisteredServiceStatus? _contextMenuService;
    private List<ContextMenuItem<RegisteredServiceStatus>> _contextMenuItems = new();
    private volatile bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await InitializeGraphAsync();
            if (!_disposed)
            {
                await LoadServiceDataAsync();
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
    }

    private async Task InitializeGraphAsync()
    {
        await _interopGate.WaitAsync(_lifetimeCancellation.Token);

        IJSObjectReference? module = null;
        IJSObjectReference? graphController = null;
        DotNetObjectReference<ServiceVisualization>? dotNetReference = null;
        try
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                JS_MODULE_PATH);

            if (_disposed)
            {
                return;
            }

            var isDarkMode = await JSRuntime.InvokeAsync<bool>(
                "eval",
                _lifetimeCancellation.Token,
                "document.documentElement.classList.contains('dark')");

            dotNetReference = DotNetObjectReference.Create(this);
            graphController = await module.InvokeAsync<IJSObjectReference>(
                "createGraph",
                _graphContainerId,
                isDarkMode,
                dotNetReference,
                GetGraphTexts());

            if (_disposed)
            {
                return;
            }

            _graphController = graphController;
            _dotNetReference = dotNetReference;
            graphController = null;
            dotNetReference = null;
        }
        finally
        {
            await DisposeGraphControllerAsync(graphController);
            dotNetReference?.Dispose();
            await ReleaseModuleReferenceAsync(module);

            _interopGate.Release();
        }
    }

    private async Task LoadServiceDataAsync()
    {
        _loading = true;
        if (!_disposed)
        {
            StateHasChanged();
        }

        try
        {
            // Get merged service statuses
            if (!(await ServiceDiscoveryFacade.GetMergedServicesStatusAsync()).IsFailed(out var error, out var services))
            {
                _allServices = services ?? new List<RegisteredServiceStatus>();
                
                // Initialize filter state
                InitializeFilters();
                
                // Load domain info and assign colors
                await AssignDomainColors();
                
                // Apply filters
                await ApplyFilters();
            }
            else
            {
                Snackbar.Add(L["ServiceGraph:Messages:LoadFailed", error.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Error);
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["ServiceGraph:Messages:LoadException", ex.Message].Value, Severity.Error);
        }
        finally
        {
            _loading = false;
            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private async Task AssignDomainColors()
    {
        try
        {
            // Load domains first so the shared resolver can assign a stable color map.
            if (!(await ServiceDiscoveryFacade.GetDomainsAsync()).IsFailed(out var error, out var domains))
            {
                DomainColorResolver.AssignColors(domains ?? []);
            }
            else
            {
                Snackbar.Add(L["ServiceGraph:Messages:GetDomainColorsFailed", error.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["ServiceGraph:Messages:GetDomainColorsException", ex.Message].Value, Severity.Warning);
        }
    }

    private void InitializeFilters()
    {
        // Initialize selected statuses
        if (!_selectedStatuses.Any())
        {
            _selectedStatuses = new HashSet<ServiceStatus>(
                Enum.GetValues<ServiceStatus>()
            );
        }
        
        // Initialize selected domains
        if (!_selectedDomains.Any())
        {
            var allDomains = _allServices.Select(GetServiceDomainName).Distinct().ToList();
            _selectedDomains = new HashSet<string>(allDomains);
        }
    }
    
    private void ToggleFilterPanel()
    {
        _showFilterPanel = !_showFilterPanel;
        if (_showFilterPanel) _showLayoutPanel = false;
    }
    
    private void ToggleLayoutPanel()
    {
        _showLayoutPanel = !_showLayoutPanel;
        if (_showLayoutPanel) _showFilterPanel = false;
    }

    private async Task ApplyFilters()
    {
        _filteredServices = _allServices.Where(service =>
        {
            // Status filter
            if (!_selectedStatuses.Contains(service.OverallStatus))
                return false;
                
            // Domain filter
            var serviceDomain = GetServiceDomainName(service);
            if (!_selectedDomains.Contains(serviceDomain))
                return false;
                
            // Text filter
            if (!string.IsNullOrWhiteSpace(_filterText))
            {
                var matchesText = service.AppName.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ||
                                  service.AppId.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ||
                                  (!string.IsNullOrEmpty(service.ProjectName) && service.ProjectName.Contains(_filterText, StringComparison.OrdinalIgnoreCase)) ||
                                  serviceDomain.Contains(_filterText, StringComparison.OrdinalIgnoreCase);
                
                if (!matchesText)
                    return false;
            }
            
            // Instance filter
            if (_showOnlyWithInstances && service.TotalInstanceCount == 0)
                return false;
            
            // Keep compatibility with the legacy offline-service filter
            if (!_showOfflineServices && service.OverallStatus == ServiceStatus.Offline)
                return false;
            
            return true;
        }).ToList();
        
        await UpdateGraph();
    }

    private async Task UpdateGraph()
    {
        await InvokeGraphAsync("updateGraph", PrepareGraphData());

        // Apply current layout settings
        await SetLayout(_currentLayout);
        if (_currentLayout == ServiceLayoutType.Force)
        {
            await InvokeGraphAsync("setForceDistance", _forceDistance);
            await InvokeGraphAsync("setForceStrength", _forceStrength);
        }
    }
    
    private async Task SetLayout(ServiceLayoutType layoutType)
    {
        _currentLayout = layoutType;
        var layoutName = layoutType switch
        {
            ServiceLayoutType.Force => "force",
            ServiceLayoutType.Hierarchy => "hierarchy",
            ServiceLayoutType.Circular => "circular",
            ServiceLayoutType.Grid => "grid",
            _ => "force"
        };
        await InvokeGraphAsync("setLayout", layoutName);
    }
    
    private Task OnLayoutChanged(ServiceLayoutType layoutType) => SetLayout(layoutType);
    
    private async Task OnForceDistanceChanged(int value)
    {
        _forceDistance = value;
        await InvokeGraphAsync("setForceDistance", value);
    }
    
    private async Task OnForceStrengthChanged(int value)
    {
        _forceStrength = value;
        await InvokeGraphAsync("setForceStrength", value);
    }

    private object PrepareGraphData()
    {
        var nodes = _filteredServices.Select(service => new
        {
            id = service.AppId,
            name = service.AppName,
            domain = GetServiceDomainName(service),
            project = service.ProjectName,
            status = service.OverallStatus.ToString(),
            runningInstances = service.RunningInstanceCount,
            totalInstances = service.TotalInstanceCount,
            colorRole = DomainColorResolver.GetDomainColorRole(GetServiceDomainName(service)),
            instanceInfo = service.GetValidInstanceInfo()
        }).ToList();

        // Do not build inter-service dependencies yet, because the current model does not contain this information.
        var links = new List<object>();

        return new { nodes, links };
    }

    [JSInvokable]
    public async Task OnNodeClick(string nodeId)
    {
        if (_disposed)
        {
            return;
        }

        var service = _allServices.FirstOrDefault(s => s.AppId == nodeId);
        if (service != null && OnServiceClick.HasDelegate)
        {
            await OnServiceClick.InvokeAsync(service);
        }
    }
    
    [JSInvokable]
    public void OnNodeRightClick(string nodeId, double x, double y)
    {
        if (_disposed)
        {
            return;
        }

        _contextMenuService = _allServices.FirstOrDefault(s => s.AppId == nodeId);
        if (_contextMenuService != null)
        {
            _contextMenuX = x;
            _contextMenuY = y;
            _contextMenuItems = BuildContextMenuItems(_contextMenuService);
            _contextMenuOpen = true;
            StateHasChanged();
        }
    }
    
    private void OnBackgroundClick()
    {
        if (_contextMenuOpen)
        {
            _contextMenuOpen = false;
            StateHasChanged();
        }
    }
    
    [JSInvokable]
    public void OnSvgBackgroundClick()
    {
        if (_disposed)
        {
            return;
        }

        if (_contextMenuOpen)
        {
            _contextMenuOpen = false;
            StateHasChanged();
        }
    }
    
    private void CloseContextMenu()
    {
        _contextMenuOpen = false;
    }
    
    private List<ContextMenuItem<RegisteredServiceStatus>> BuildContextMenuItems(RegisteredServiceStatus service)
    {
        var builder = ContextMenuBuilder<RegisteredServiceStatus>.Create()
            .AddItem(L["ServiceGraph:ContextMenu:ViewServiceDetails"].Value, Icons.Material.Filled.Info, ViewServiceDetailsAsync)
            .AddItem(L["ServiceGraph:ContextMenu:FocusService"].Value, Icons.Material.Filled.CenterFocusStrong, FocusOnServiceAsync)
            .AddDivider()
            .AddItem(L["ServiceGraph:ContextMenu:FilterSameStatus"].Value, Icons.Material.Filled.FilterAlt, FilterByStatusAsync)
            .AddItem(L["ServiceGraph:ContextMenu:FilterSameDomain"].Value, Icons.Material.Filled.Domain, FilterByDomainAsync)
            .AddItemIf(!string.IsNullOrEmpty(service.ProjectName), L["ServiceGraph:ContextMenu:FilterSameProject"].Value, Icons.Material.Filled.Folder, FilterByProjectAsync)
            .AddItem(L["ServiceGraph:ContextMenu:ClearFilters"].Value, Icons.Material.Filled.ClearAll, ClearAllFiltersAsync)
            .AddDivider()
            .AddItem(L["ServiceGraph:ContextMenu:CopyServiceId"].Value, Icons.Material.Filled.ContentCopy, CopyServiceIdAsync)
            .AddItem(L["ServiceGraph:ContextMenu:CopyServiceName"].Value, Icons.Material.Filled.ContentCopy, CopyServiceNameAsync);
        
        return builder.Build();
    }
    
    private Task OnContextMenuItemClick(ContextMenuItem<RegisteredServiceStatus> item)
    {
        _contextMenuOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private async Task ViewServiceDetailsAsync(RegisteredServiceStatus? service)
    {
        if (service != null && OnServiceClick.HasDelegate)
        {
            await OnServiceClick.InvokeAsync(service);
        }
    }
    
    private async Task FocusOnServiceAsync(RegisteredServiceStatus? service)
    {
        if (service != null)
        {
            await InvokeGraphAsync("focusOnNode", service.AppId);
        }
    }
    
    private async Task FilterByStatusAsync(RegisteredServiceStatus? service)
    {
        if (service != null)
        {
            _selectedStatuses = new HashSet<ServiceStatus> { service.OverallStatus };
            _showFilterPanel = true;
            await ApplyFilters();
            Snackbar.Add(L["ServiceGraph:Messages:FilteredStatus", service.OverallStatus.GetText(L)].Value, Severity.Info);
        }
    }
    
    private async Task FilterByDomainAsync(RegisteredServiceStatus? service)
    {
        if (service != null)
        {
            var domainName = GetServiceDomainName(service);
            _selectedDomains = new HashSet<string> { domainName };
            _showFilterPanel = true;
            await ApplyFilters();
            Snackbar.Add(L["ServiceGraph:Messages:FilteredDomain", domainName].Value, Severity.Info);
        }
    }
    
    private async Task FilterByProjectAsync(RegisteredServiceStatus? service)
    {
        if (service != null && !string.IsNullOrEmpty(service.ProjectName))
        {
            _filterText = service.ProjectName;
            _showFilterPanel = true;
            await ApplyFilters();
            Snackbar.Add(L["ServiceGraph:Messages:FilteredProject", service.ProjectName].Value, Severity.Info);
        }
    }
    
    private async Task ClearAllFiltersAsync(RegisteredServiceStatus? service)
    {
        _filterText = string.Empty;
        _selectedStatuses = new HashSet<ServiceStatus>(Enum.GetValues<ServiceStatus>());
        var allDomains = _allServices.Select(GetServiceDomainName).Distinct().ToList();
        _selectedDomains = new HashSet<string>(allDomains);
        _showOnlyWithInstances = false;
        await ApplyFilters();
        Snackbar.Add(L["ServiceGraph:Messages:ClearedFilters"].Value, Severity.Info);
    }
    
    private async Task CopyServiceIdAsync(RegisteredServiceStatus? service)
    {
        if (service != null)
        {
            await CopyToClipboardAsync(service.AppId);
            Snackbar.Add(L["ServiceGraph:Messages:CopiedServiceId"].Value, Severity.Success);
        }
    }
    
    private async Task CopyServiceNameAsync(RegisteredServiceStatus? service)
    {
        if (service != null)
        {
            await CopyToClipboardAsync(service.AppName);
            Snackbar.Add(L["ServiceGraph:Messages:CopiedServiceName"].Value, Severity.Success);
        }
    }

    private string GetServiceDomainName(RegisteredServiceStatus service)
        => service.DomainName ?? L["Shared:Values:Unknown"].Value;

    private object GetGraphTexts() => new
    {
        labels = new
        {
            appId = L["ServiceGraph:Graph:Labels:AppId"].Value,
            domain = L["ServiceGraph:Graph:Labels:Domain"].Value,
            project = L["ServiceGraph:Graph:Labels:Project"].Value,
            status = L["ServiceGraph:Graph:Labels:Status"].Value,
            instances = L["ServiceGraph:Graph:Labels:Instances"].Value,
            version = L["ServiceGraph:Graph:Labels:Version"].Value,
            notAvailable = L["Shared:Values:NotAvailable"].Value,
            unknown = L["Shared:Values:Unknown"].Value
        },
        statuses = new
        {
            running = L["Shared:ServiceStatuses:Running"].Value,
            updating = L["Shared:ServiceStatuses:Updating"].Value,
            offline = L["Shared:ServiceStatuses:Offline"].Value,
            error = L["Shared:ServiceStatuses:Error"].Value,
            unknown = L["Shared:ServiceStatuses:Unknown"].Value
        }
    };

    private async Task ResetView()
    {
        await InvokeGraphAsync("resetView");
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync)
        {
            return new ValueTask(_disposeTask ??= DisposeCoreAsync());
        }
    }

    private async Task DisposeCoreAsync()
    {
        _disposed = true;
        await _lifetimeCancellation.CancelAsync();

        await _interopGate.WaitAsync();
        try
        {
            var graphController = Interlocked.Exchange(ref _graphController, null);
            var dotNetReference = Interlocked.Exchange(ref _dotNetReference, null);

            await DisposeGraphControllerAsync(graphController);
            dotNetReference?.Dispose();
        }
        finally
        {
            _interopGate.Release();
        }

        // A caller may have observed the pre-disposal state immediately before teardown began and still be
        // approaching the gate. Keep these lightweight primitives alive so cancellation settles that admission
        // race without turning an expected lifetime transition into ObjectDisposedException.
    }

    private async Task InvokeGraphAsync(string identifier, params object?[] arguments)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await _interopGate.WaitAsync(_lifetimeCancellation.Token);
            try
            {
                if (!_disposed && _graphController is not null)
                {
                    await _graphController.InvokeVoidAsync(identifier, _lifetimeCancellation.Token, arguments);
                }
            }
            finally
            {
                _interopGate.Release();
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
    }

    private async Task CopyToClipboardAsync(string value)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                _lifetimeCancellation.Token,
                value);
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
    }

    private static async ValueTask DisposeGraphControllerAsync(IJSObjectReference? graphController)
    {
        if (graphController is null)
        {
            return;
        }

        try
        {
            await graphController.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        try
        {
            await graphController.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private static async ValueTask ReleaseModuleReferenceAsync(IJSObjectReference? module)
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}
