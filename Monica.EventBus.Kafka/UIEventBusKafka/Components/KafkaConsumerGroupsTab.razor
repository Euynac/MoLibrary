@using Monica.EventBus.Kafka.UIEventBusKafka.Support
@using Monica.EventBus.Kafka.UIEventBusKafka.State
@inject IStringLocalizer<EventBusKafkaResource> L

<MudStack Spacing="3">
    <KafkaWorkspaceHeader Icon="@Icons.Material.Filled.Groups"
                          Title="@L["ConsumerGroups:Title"]"
                          Subtitle="@L["ConsumerGroups:Summary", State.ConsumerGroups.Count]" />

    @if (!State.CanAdminSelectedCluster)
    {
        <KafkaWorkspaceState Icon="@Icons.Material.Filled.Lock"
                             Title="@L["ConsumerGroups:Title"]"
                             Description="@L["ConsumerGroups:Unavailable"]"
                             AccentColor="Color.Warning" />
    }
    else if (State.ConsumerGroups.Count == 0)
    {
        <KafkaWorkspaceState Icon="@Icons.Material.Filled.GroupOff"
                             Title="@L["ConsumerGroups:Title"]"
                             Description="@L["ConsumerGroups:Empty"]"
                             AccentColor="Color.Info" />
    }
    else
    {
        <KafkaTableSurface AriaLabel="@L["ConsumerGroups:Title"]"
                           AccentColor="Color.Secondary"
                           Size="KafkaTableSurfaceSize.Compact">
            <MudTable T="KafkaConsumerGroupSummary"
                      Items="@State.ConsumerGroups"
                      RowsPerPage="25"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>@L["ConsumerGroups:Columns:GroupId"]</MudTh>
                    <MudTh>@L["ConsumerGroups:Columns:State"]</MudTh>
                    <MudTh>@L["ConsumerGroups:Columns:Members"]</MudTh>
                    <MudTh>@L["ConsumerGroups:Columns:Lag"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["ConsumerGroups:Columns:GroupId"]">
                        <span class="consumer-group-id">@context.GroupId</span>
                    </MudTd>
                    <MudTd DataLabel="@L["ConsumerGroups:Columns:State"]">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Color="@KafkaConsumerGroupStateDisplay.GetColor(context.State)">
                            @KafkaConsumerGroupStateDisplay.GetText(context.State, L)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["ConsumerGroups:Columns:Members"]">
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Groups"
                                   aria-label="@L["ConsumerGroups:Actions:ViewMembers", context.GroupId]"
                                   OnClick="@(() => OnViewMembers.InvokeAsync(context))">
                            @context.MemberCount
                        </MudButton>
                    </MudTd>
                    <MudTd DataLabel="@L["ConsumerGroups:Columns:Lag"]">
                        <span class="consumer-group-lag">
                            @KafkaMetricDisplayFormatter.FormatOptionalInt64(context.TotalLag, L["ConsumerGroups:Values:LagUnknown"])
                        </span>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@KafkaTablePageSizes.Standard" />
                </PagerContent>
            </MudTable>
        </KafkaTableSurface>
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public EventBusKafkaPageState State { get; set; } = default!;

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public EventCallback<KafkaConsumerGroupSummary> OnViewMembers { get; set; }

}
