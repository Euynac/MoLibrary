@using Monica.EventBus.Kafka.UIEventBusKafka.State
@inject IStringLocalizer<EventBusKafkaResource> L

<MudStack Spacing="3">
    <KafkaWorkspaceHeader Icon="@Icons.Material.Filled.MonitorHeart"
                          Title="@L["Performance:Title"]"
                          Subtitle="@LiveStatus">
        <Actions>
            <div class="performance-controls">
                <MudSwitch T="bool"
                           Value="@State.IsPerformanceAutoRefreshEnabled"
                           ValueChanged="SetAutoRefreshAsync"
                           Color="Color.Primary"
                           Disabled="@(!State.CanAdminSelectedCluster)"
                           Label="@L["Performance:Live:AutoRefresh"]" />
                <div class="performance-interval-control">
                    <MudTooltip Text="@L["Performance:Live:IntervalHint", KafkaPerformancePollingState.MinimumRefreshIntervalSeconds, KafkaPerformancePollingState.MaximumRefreshIntervalSeconds]">
                        <MudNumericField T="int"
                                         Value="@State.PerformanceRefreshIntervalSeconds"
                                         ValueChanged="SetRefreshIntervalAsync"
                                         Label="@L["Performance:Live:IntervalSeconds"]"
                                         Min="@KafkaPerformancePollingState.MinimumRefreshIntervalSeconds"
                                         Max="@KafkaPerformancePollingState.MaximumRefreshIntervalSeconds"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Disabled="@(!State.CanAdminSelectedCluster || !State.IsPerformanceAutoRefreshEnabled)" />
                    </MudTooltip>
                </div>
                <div class="performance-metrics-filter">
                    <MudTextField T="string"
                                  @bind-Value="_metricsFilter"
                                  Immediate="true"
                                  DebounceInterval="200"
                                  Label="@L["Performance:MetricsFilter:Label"]"
                                  Placeholder="@L["Performance:MetricsFilter:Placeholder"]"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.FilterAlt"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true" />
                </div>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@State.IsBusy"
                           OnClick="OnRefresh">
                    @L["Common:Actions:Refresh"]
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.MonitorHeart"
                           Disabled="@(State.IsBusy || State.IsPerformanceSampling || !State.CanAdminSelectedCluster)"
                           OnClick="OnCapture">
                    @if (State.IsPerformanceSampling)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @L["Performance:Actions:Capture"]
                </MudButton>
            </div>
        </Actions>
    </KafkaWorkspaceHeader>

    @if (!string.IsNullOrWhiteSpace(State.PerformanceSamplingError))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            @State.PerformanceSamplingError
        </MudAlert>
    }

    @if (State.LatestPerformance is { } latest)
    {
        <div class="performance-metrics">
            <KafkaMetricCard Icon="@Icons.Material.Filled.MarkEmailUnread"
                             Label="@L["Performance:Columns:RetainedMessages"]"
                             Value="@KafkaMetricDisplayFormatter.FormatOptionalInt64(State.TotalRetainedMessageCount, L["Performance:Values:RetainedMessagesUnknown"])"
                             AccentColor="@GetRetainedMessageAccentColor(State.TotalRetainedMessageCount)" />
            <KafkaMetricCard Icon="@Icons.Material.Filled.NorthEast"
                             Label="@L["Performance:Columns:WriteRate"]"
                             Value="@KafkaMetricDisplayFormatter.FormatRate(latest.MessageWriteRatePerSecond, L)"
                             AccentColor="@GetRateAccentColor(latest.MessageWriteRatePerSecond)" />
            <KafkaMetricCard Icon="@Icons.Material.Filled.SouthWest"
                             Label="@L["Performance:Columns:ConsumeRate"]"
                             Value="@KafkaMetricDisplayFormatter.FormatRate(latest.MessageConsumeRatePerSecond, L)"
                             AccentColor="@GetRateAccentColor(latest.MessageConsumeRatePerSecond)" />
            <KafkaMetricCard Icon="@Icons.Material.Filled.HourglassBottom"
                             Label="@L["Performance:Columns:Lag"]"
                             Value="@KafkaMetricDisplayFormatter.FormatOptionalInt64(latest.TotalLag, L["Performance:Values:LagUnknown"])"
                             AccentColor="@GetLagAccentColor(latest.TotalLag)" />
        </div>
    }

    @if (!State.CanAdminSelectedCluster)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            @L["Performance:Unavailable"]
        </MudAlert>
    }
    else if (State.LatestPerformance is null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            @L["Performance:Empty"]
        </MudAlert>
    }
    else if (State.LatestPerformance.ConsumerGroupMetrics.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            @L["Performance:NoConsumerGroupMetrics"]
        </MudAlert>
    }
    else if (FilteredConsumerGroupMetrics.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            @L["Performance:MetricsFilter:NoMatches"]
        </MudAlert>
    }
    else
    {
        <div class="performance-table">
            <MudTable T="KafkaConsumerGroupTopicMetrics"
                      Items="@FilteredConsumerGroupMetrics"
                      @bind-RowsPerPage="_rowsPerPage"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>@L["Performance:Columns:CapturedAt"]</MudTh>
                    <MudTh>@L["Performance:Columns:Topic"]</MudTh>
                    <MudTh>@L["Performance:Columns:ConsumerGroup"]</MudTh>
                    <MudTh>@L["Performance:Columns:RetainedMessages"]</MudTh>
                    <MudTh>@L["Performance:Columns:WriteRate"]</MudTh>
                    <MudTh>@L["Performance:Columns:ConsumeRate"]</MudTh>
                    <MudTh>@L["Performance:Columns:Lag"]</MudTh>
                    <MudTh>@L["Common:Columns:Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Performance:Columns:CapturedAt"]">@context.CapturedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:Topic"]">@context.TopicName</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:ConsumerGroup"]">@context.GroupId</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:RetainedMessages"]">
                        @KafkaMetricDisplayFormatter.FormatOptionalInt64(context.TotalRetainedMessageCount, L["Performance:Values:RetainedMessagesUnknown"])
                    </MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:WriteRate"]">
                        @KafkaMetricDisplayFormatter.FormatRate(context.WriteRatePerSecond, L)
                    </MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:ConsumeRate"]">
                        @KafkaMetricDisplayFormatter.FormatRate(context.ConsumeRatePerSecond, L)
                    </MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:Lag"]">
                        @KafkaMetricDisplayFormatter.FormatOptionalInt64(context.TotalLag, L["Performance:Values:LagUnknown"])
                    </MudTd>
                    <MudTd DataLabel="@L["Common:Columns:Actions"]">
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Analytics"
                                   OnClick="@(() => OnViewDetails.InvokeAsync(context))">
                            @L["Performance:Actions:Details"]
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@PageSizeOptions" />
                </PagerContent>
            </MudTable>
        </div>
    }
</MudStack>

@code {
    private static readonly int[] PageSizeOptions = [10, 20, 50, 100];

    private string _metricsFilter = string.Empty;
    private int _rowsPerPage = 20;

    [Parameter, EditorRequired] public EventBusKafkaPageState State { get; set; } = default!;

    [Parameter] public EventCallback OnRefresh { get; set; }

    [Parameter] public EventCallback OnCapture { get; set; }

    [Parameter] public EventCallback<KafkaConsumerGroupTopicMetrics> OnViewDetails { get; set; }

    private IReadOnlyList<KafkaConsumerGroupTopicMetrics> FilteredConsumerGroupMetrics
    {
        get
        {
            var metricsFilter = _metricsFilter.Trim();
            return State.LatestPerformance?.ConsumerGroupMetrics
                .Where(metric => !string.IsNullOrWhiteSpace(metric.TopicName) &&
                                 !metric.TopicName.StartsWith("__", StringComparison.Ordinal))
                .Where(metric => metricsFilter.Length == 0 ||
                                 metric.TopicName.Contains(metricsFilter, StringComparison.OrdinalIgnoreCase) ||
                                 metric.GroupId.Contains(metricsFilter, StringComparison.OrdinalIgnoreCase))
                .OrderBy(metric => metric.TopicName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(metric => metric.GroupId, StringComparer.OrdinalIgnoreCase)
                .ToList() ?? [];
        }
    }

    private string LiveStatus => State.IsPerformanceSampling
        ? L["Performance:Live:Sampling"]
        : State.LastPerformanceCapturedAt is { } capturedAt
            ? L["Performance:Live:LastCapturedAt", capturedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")]
            : State.IsPerformanceAutoRefreshEnabled
                ? L["Performance:Live:WaitingForFirstSample"]
                : L["Performance:Live:Paused"];

    private Task SetAutoRefreshAsync(bool enabled)
    {
        return State.SetPerformanceAutoRefreshAsync(enabled);
    }

    private Task SetRefreshIntervalAsync(int seconds)
    {
        return State.SetPerformanceRefreshIntervalAsync(seconds);
    }

    private static Color GetRetainedMessageAccentColor(long? retainedMessageCount)
    {
        return retainedMessageCount.HasValue ? Color.Info : Color.Warning;
    }

    private static Color GetRateAccentColor(double? rate)
    {
        return rate.HasValue ? Color.Success : Color.Warning;
    }

    private static Color GetLagAccentColor(long? lag)
    {
        return lag.HasValue ? Color.Secondary : Color.Warning;
    }
}
