@using Monica.EventBus.Kafka.UIEventBusKafka.State
@inject IStringLocalizer<EventBusKafkaResource> L

<MudStack Spacing="3">
    <div class="performance-toolbar">
        <div class="performance-heading">
            <MudText Typo="Typo.h6">@L["Performance:Title"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@LiveStatus</MudText>
        </div>

        <div class="performance-controls">
            <MudSwitch T="bool"
                       Value="@State.IsPerformanceAutoRefreshEnabled"
                       ValueChanged="SetAutoRefreshAsync"
                       Color="Color.Primary"
                       Disabled="@(!State.CanAdminSelectedCluster)"
                       Label="@L["Performance:Live:AutoRefresh"]" />
            <MudNumericField T="int"
                             Value="@State.PerformanceRefreshIntervalSeconds"
                             ValueChanged="SetRefreshIntervalAsync"
                             Label="@L["Performance:Live:IntervalSeconds"]"
                             Min="@KafkaPerformancePollingState.MinimumRefreshIntervalSeconds"
                             Max="@KafkaPerformancePollingState.MaximumRefreshIntervalSeconds"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             HelperText="@L["Performance:Live:IntervalHint", KafkaPerformancePollingState.MinimumRefreshIntervalSeconds, KafkaPerformancePollingState.MaximumRefreshIntervalSeconds]"
                             Disabled="@(!State.CanAdminSelectedCluster || !State.IsPerformanceAutoRefreshEnabled)" />
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@State.IsBusy"
                       OnClick="OnRefresh">
                @L["Common:Actions:Refresh"]
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.MonitorHeart"
                       Disabled="@(State.IsBusy || State.IsPerformanceSampling || !State.CanAdminSelectedCluster)"
                       OnClick="OnCapture">
                @if (State.IsPerformanceSampling)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @L["Performance:Actions:Capture"]
            </MudButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(State.PerformanceSamplingError))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            @State.PerformanceSamplingError
        </MudAlert>
    }

    @if (State.LatestPerformance is { } latest)
    {
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" lg="3">
                <div class="metric-card">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.overline">@L["Performance:Columns:AvailableMessages"]</MudText>
                        <MudText Typo="Typo.h5">@FormatAvailableMessages(latest.TotalAvailableMessageCount)</MudText>
                    </MudPaper>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <div class="metric-card">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.overline">@L["Performance:Columns:WriteRate"]</MudText>
                        <MudText Typo="Typo.h5">@FormatRate(latest.MessageWriteRatePerSecond)</MudText>
                    </MudPaper>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <div class="metric-card">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.overline">@L["Performance:Columns:ConsumeRate"]</MudText>
                        <MudText Typo="Typo.h5">@FormatRate(latest.MessageConsumeRatePerSecond)</MudText>
                    </MudPaper>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <div class="metric-card">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.overline">@L["Performance:Columns:Lag"]</MudText>
                        <MudText Typo="Typo.h5">@FormatLag(latest.TotalLag)</MudText>
                    </MudPaper>
                </div>
            </MudItem>
        </MudGrid>
    }

    @if (!State.CanAdminSelectedCluster)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            @L["Performance:Unavailable"]
        </MudAlert>
    }
    else if (State.PerformanceSnapshots.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            @L["Performance:Empty"]
        </MudAlert>
    }
    else
    {
        <div class="performance-table">
            <MudTable T="KafkaPerformanceSnapshot"
                      Items="@State.PerformanceSnapshots.OrderByDescending(snapshot => snapshot.CapturedAt)"
                      RowsPerPage="20"
                      Dense="true"
                      Hover="true">
                <HeaderContent>
                    <MudTh>@L["Performance:Columns:CapturedAt"]</MudTh>
                    <MudTh>@L["Performance:Columns:Brokers"]</MudTh>
                    <MudTh>@L["Performance:Columns:Topics"]</MudTh>
                    <MudTh>@L["Performance:Columns:Groups"]</MudTh>
                    <MudTh>@L["Performance:Columns:AvailableMessages"]</MudTh>
                    <MudTh>@L["Performance:Columns:WriteRate"]</MudTh>
                    <MudTh>@L["Performance:Columns:ConsumeRate"]</MudTh>
                    <MudTh>@L["Performance:Columns:Lag"]</MudTh>
                    <MudTh>@L["Performance:Columns:Message"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Performance:Columns:CapturedAt"]">@context.CapturedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:Brokers"]">@context.BrokerCount</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:Topics"]">@context.TopicCount</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:Groups"]">@context.ConsumerGroupCount</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:AvailableMessages"]">@FormatAvailableMessages(context.TotalAvailableMessageCount)</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:WriteRate"]">@FormatRate(context.MessageWriteRatePerSecond)</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:ConsumeRate"]">@FormatRate(context.MessageConsumeRatePerSecond)</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:Lag"]">@FormatLag(context.TotalLag)</MudTd>
                    <MudTd DataLabel="@L["Performance:Columns:Message"]">@FormatMessage(context.Message)</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@(new[] { 10, 20, 50, 100 })" />
                </PagerContent>
            </MudTable>
        </div>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public EventBusKafkaPageState State { get; set; } = default!;

    [Parameter] public EventCallback OnRefresh { get; set; }

    [Parameter] public EventCallback OnCapture { get; set; }

    private string LiveStatus => State.IsPerformanceSampling
        ? L["Performance:Live:Sampling"]
        : State.LastPerformanceCapturedAt is { } capturedAt
            ? L["Performance:Live:LastCapturedAt", capturedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")]
            : State.IsPerformanceAutoRefreshEnabled
                ? L["Performance:Live:WaitingForFirstSample"]
                : L["Performance:Live:Paused"];

    private Task SetAutoRefreshAsync(bool enabled)
    {
        return State.SetPerformanceAutoRefreshAsync(enabled);
    }

    private Task SetRefreshIntervalAsync(int seconds)
    {
        return State.SetPerformanceRefreshIntervalAsync(seconds);
    }

    private string FormatLag(long? lag)
    {
        return lag?.ToString() ?? L["Performance:Values:LagUnknown"];
    }

    private string FormatAvailableMessages(long? availableMessageCount)
    {
        return availableMessageCount?.ToString() ?? L["Performance:Values:AvailableMessagesUnknown"];
    }

    private string FormatRate(double? rate)
    {
        return rate.HasValue
            ? L["Performance:Values:RatePerSecond", rate.Value.ToString("0.##")]
            : L["Performance:Values:RateUnknown"];
    }

    private string FormatMessage(string? message)
    {
        return string.IsNullOrWhiteSpace(message) ? L["Performance:Values:NoMessage"] : message;
    }
}
