@inject IStringLocalizer<EventBusKafkaResource> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                @L["Topics:BacklogDialog:Summary", Snapshot.TotalRetainedMessageCount, FormatCapturedAt()]
            </MudAlert>

            @if (Snapshot.Partitions.Count == 0)
            {
                <KafkaWorkspaceState Icon="@Icons.Material.Filled.TableRows"
                                     Title="@L["Topics:Actions:Backlog"]"
                                     Description="@L["Topics:BacklogDialog:Empty"]"
                                     AccentColor="Color.Warning" />
            }
            else
            {
                <KafkaTableSurface AriaLabel="@L["Topics:Actions:Backlog"]"
                                   AccentColor="Color.Info"
                                   Size="KafkaTableSurfaceSize.Compact">
                    <MudTable T="KafkaTopicPartitionBacklog"
                              Items="Snapshot.Partitions"
                              Dense="true"
                              Hover="true"
                              Striped="true"
                              Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh>@L["Topics:BacklogDialog:Columns:Partition"]</MudTh>
                            <MudTh>@L["Topics:BacklogDialog:Columns:EarliestOffset"]</MudTh>
                            <MudTh>@L["Topics:BacklogDialog:Columns:LatestOffset"]</MudTh>
                            <MudTh>@L["Topics:BacklogDialog:Columns:RetainedMessages"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["Topics:BacklogDialog:Columns:Partition"]">@context.Partition</MudTd>
                            <MudTd DataLabel="@L["Topics:BacklogDialog:Columns:EarliestOffset"]">@context.EarliestOffset</MudTd>
                            <MudTd DataLabel="@L["Topics:BacklogDialog:Columns:LatestOffset"]">@context.LatestOffset</MudTd>
                            <MudTd DataLabel="@L["Topics:BacklogDialog:Columns:RetainedMessages"]">@context.RetainedMessageCount</MudTd>
                        </RowTemplate>
                    </MudTable>
                </KafkaTableSurface>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">
            @L["Common:Actions:Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public KafkaTopicBacklogSnapshot Snapshot { get; set; } = new();

    private string FormatCapturedAt()
    {
        return Snapshot.CapturedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz");
    }

    private void Close()
    {
        MudDialog?.Close();
    }
}
