@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@using Monica.Markdown.UIMarkdown.Components
@using Monica.Markdown.UIMarkdown.Models
@using Monica.Markdown.UIMarkdown.State
@implements IAsyncDisposable

@inject MarkdownViewerPageStateFactory PageStateFactory
@inject IStringLocalizer<MarkdownResource> L

<PageTitle>@L["Pages:MarkdownDocuments:Title"]</PageTitle>

<div @ref="_viewerRoot" class="doc-layout">
    @if (PageState.IsLoading)
    {
        <div class="doc-center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudProgressCircular Color="Color.Primary"
                                     Size="Size.Large"
                                     Indeterminate="true" />
                <MudText Typo="Typo.h6" Color="Color.Primary">
                    @L["MarkdownViewer:States:LoadingDocuments"]
                </MudText>
            </MudStack>
        </div>
    }
    else if (PageState.Groups is null || PageState.Groups.Count == 0)
    {
        <div class="doc-center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.FolderOff"
                         Size="Size.Large"
                         Color="Color.Default"
                         Class="empty-state-icon" />
                <MudText Typo="Typo.h6" Class="empty-state-copy">
                    @L["MarkdownViewer:States:NoKnowledgeBasesRegistered"]
                </MudText>
            </MudStack>
        </div>
    }
    else
    {
        <div class="@PageState.WorkspaceClass">
            @if (PageState.ShowSidebar)
            {
                <aside class="doc-sidebar-rail">
                    <DocumentSidebar CurrentGroup="PageState.CurrentGroup"
                                     CurrentTree="PageState.CurrentTree"
                                     CurrentCulture="PageState.SelectedCulture"
                                     SelectedDocument="PageState.SelectedDocument"
                                     SelectedDocumentChanged="PageState.OnDocumentSelectedAsync"
                                     OnCollapseRequested="PageState.ToggleSidebar"
                                     OnOpenGroupSwitcher="PageState.OpenGroupSwitcherAsync" />
                </aside>
            }

            <div class="@PageState.MainStageClass">
                <main class="doc-reader-card">
                    <DocumentContentViewer CurrentGroup="PageState.CurrentGroup"
                                           Document="PageState.SelectedDocument"
                                           Content="@PageState.DocumentContent"
                                           CurrentAnchorId="@PageState.CurrentAnchorId"
                                           CurrentCulture="PageState.SelectedCulture"
                                           CurrentLanguage="PageState.CurrentLanguage"
                                           Languages="PageState.CurrentLanguages"
                                           ShowLanguageSwitcher="PageState.ShowLanguageSwitcher"
                                           MissingTranslation="PageState.MissingTranslation"
                                           IsLoading="PageState.IsContentLoading"
                                           ShowSidebarToggle="!PageState.ShowSidebar"
                                           IsTableOfContentsVisible="PageState.ShowTableOfContents"
                                           OnToggleSidebar="PageState.ToggleSidebar"
                                           OnOpenDocumentSearch="PageState.OpenDocumentSearchAsync"
                                           OnLanguageChanged="PageState.OnLanguageSelectedAsync"
                                           OnToggleTableOfContents="PageState.ToggleTableOfContents"
                                           HeadingsChanged="PageState.OnDocumentHeadingsChangedAsync" />
                </main>

                @if (PageState.ShowTableOfContents)
                {
                    <aside class="doc-toc-rail">
                        <DocumentTableOfContentsPanel Document="PageState.SelectedDocument"
                                                      Headings="PageState.DocumentHeadings"
                                                      CurrentAnchorId="@PageState.CurrentAnchorId"
                                                      OnHeadingSelected="PageState.OnHeadingSelectedAsync" />
                    </aside>
                }
            </div>

            @if (PageState.ShowSidebar)
            {
                <button type="button"
                        class="doc-sidebar-backdrop"
                        @onclick="PageState.ToggleSidebar"
                        aria-label="@L["MarkdownViewer:Navbar:HideSidebar"]"></button>
            }
        </div>
    }
</div>

@code {
    public const string PAGE_URL = MarkdownViewerLocation.PAGE_URL;

    private ElementReference _viewerRoot;
    private MarkdownViewerPageState PageState { get; set; } = null!;
    private int _disposeRequested;

    protected override void OnInitialized()
    {
        PageState = PageStateFactory.Create(RequestRenderAsync);
    }

    protected override Task OnInitializedAsync()
    {
        return PageState.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await PageState.HandleAfterRenderAsync(_viewerRoot, firstRender);
    }

    public async ValueTask DisposeAsync()
    {
        Interlocked.Exchange(ref _disposeRequested, 1);
        await PageState.DisposeAsync();
    }

    private Task RequestRenderAsync()
    {
        return Volatile.Read(ref _disposeRequested) != 0
            ? Task.CompletedTask
            : InvokeAsync(StateHasChanged);
    }
}
