@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using System.Net
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@using Monica.Markdown.UIMarkdown.Components
@using Monica.Markdown.UIMarkdown.Models
@using Monica.Markdown.UIMarkdown.Services
@using Monica.UI.Components.Markdown
@using Monica.Tool.Algorithm.Tree
@using Monica.Tool.MoResponse
@implements IAsyncDisposable

@inject MarkdownUIService MarkdownService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<MarkdownResource> L

<PageTitle>@L["Pages:MarkdownDocuments:Title"]</PageTitle>

<div class="doc-layout">
    @if (_loading)
    {
        <div class="doc-center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudProgressCircular Color="Color.Primary"
                                     Size="Size.Large"
                                     Indeterminate="true" />
                <MudText Typo="Typo.h6" Color="Color.Primary">
                    @L["MarkdownViewer:States:LoadingDocuments"]
                </MudText>
            </MudStack>
        </div>
    }
    else if (_groups is null || _groups.Count == 0)
    {
        <div class="doc-center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.FolderOff"
                         Size="Size.Large"
                         Color="Color.Default"
                         Style="opacity: 0.3; font-size: 4rem;" />
                <MudText Typo="Typo.h6" Style="opacity: 0.5;">
                    @L["MarkdownViewer:States:NoKnowledgeBasesRegistered"]
                </MudText>
            </MudStack>
        </div>
    }
    else
    {
        <div class="@GetWorkspaceClass()">
            @if (_showSidebar)
            {
                <aside class="doc-sidebar-rail">
                    <DocumentSidebar CurrentGroup="GetCurrentGroup()"
                                     CurrentTree="_currentTree"
                                     SelectedDocument="_selectedDocument"
                                     SelectedDocumentChanged="OnDocumentSelected"
                                     OnCollapseRequested="ToggleSidebar"
                                     OnOpenGroupSwitcher="OpenGroupSwitcherAsync" />
                </aside>
            }

            <div class="@GetMainStageClass()">
                <main class="doc-reader-card">
                    <DocumentContentViewer CurrentGroup="GetCurrentGroup()"
                                           Document="_selectedDocument"
                                           Content="@_documentContent"
                                           CurrentAnchorId="@_currentAnchorId"
                                           IsLoading="_contentLoading"
                                           ShowSidebarToggle="!_showSidebar"
                                           IsTableOfContentsVisible="_showTableOfContents"
                                           OnToggleSidebar="ToggleSidebar"
                                           OnToggleTableOfContents="ToggleTableOfContents"
                                           HeadingsChanged="OnDocumentHeadingsChanged" />
                </main>

                @if (_showTableOfContents)
                {
                    <aside class="doc-toc-rail">
                        <DocumentTableOfContentsPanel Document="_selectedDocument"
                                                      Headings="_documentHeadings"
                                                      CurrentAnchorId="@_currentAnchorId"
                                                      OnHeadingSelected="OnHeadingSelectedAsync" />
                    </aside>
                }
            </div>

            @if (_showSidebar)
            {
                <button type="button"
                        class="doc-sidebar-backdrop"
                        @onclick="ToggleSidebar"
                        aria-label="@L["MarkdownViewer:Navbar:HideSidebar"]"></button>
            }
        </div>
    }
</div>

@code {
    public const string PAGE_URL = MarkdownViewerLocation.PageUrl;

    private readonly DialogOptions _groupSwitcherDialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true,
        CloseOnEscapeKey = true
    };

    private bool _loading = true;
    private bool _contentLoading;
    private bool _showSidebar;
    private bool _showTableOfContents = true;
    private List<MarkdownDocumentGroup>? _groups;
    private string? _selectedGroupKey;
    private TreeNode<MarkdownDocumentNodeData>? _currentTree;
    private MarkdownDocument? _selectedDocument;
    private string? _documentContent;
    private IReadOnlyList<MoMarkdownHeading> _documentHeadings = [];
    private string? _currentAnchorId;
    private IJSObjectReference? _hashObserverModule;
    private IJSObjectReference? _layoutModule;
    private DotNetObjectReference<UIMarkdownPage>? _hashObserverReference;
    private bool _pendingHeadingTrackerRefresh;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _layoutModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Monica.Markdown/js/markdown-layout.js");
            _showSidebar = await _layoutModule.InvokeAsync<bool>("shouldShowSidebarByDefault");

            await LoadGroupsAsync();

            _hashObserverModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Monica.UI/js/mo-url-hash-observer.js");
            _hashObserverReference = DotNetObjectReference.Create(this);
            await _hashObserverModule.InvokeVoidAsync("observeHash", _hashObserverReference);
        }

        if (_pendingHeadingTrackerRefresh)
        {
            await RefreshHeadingTrackerAsync();
        }
    }

    private MarkdownDocumentGroup? GetCurrentGroup() =>
        _groups?.FirstOrDefault(g => g.Key == _selectedGroupKey);

    private async Task LoadGroupsAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            if ((await MarkdownService.GetAllDocumentGroupsAsync())
                .IsFailed(out var error, out var groups))
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _groups = groups;
            await ApplyLocationAsync(MarkdownViewerLocation.FromAbsoluteUri(NavigationManager.Uri));
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["MarkdownViewer:Messages:LoadDataFailed", ex.Message], Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenGroupSwitcherAsync()
    {
        if (_groups is not { Count: > 0 } groups)
        {
            return;
        }

        var parameters = new DialogParameters<DocumentGroupSwitcherDialog>
        {
            { x => x.Groups, groups },
            { x => x.SelectedGroupKey, _selectedGroupKey }
        };

        var dialog = await DialogService.ShowAsync<DocumentGroupSwitcherDialog>(
            L["MarkdownViewer:Dialogs:SwitchKnowledgeBaseTitle"],
            parameters,
            _groupSwitcherDialogOptions);

        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: string selectedGroupKey }
            || string.Equals(selectedGroupKey, _selectedGroupKey, StringComparison.Ordinal))
        {
            return;
        }

        await OnGroupSelected(selectedGroupKey);
    }

    private async Task OnGroupSelected(string groupKey)
    {
        _currentAnchorId = null;
        _documentHeadings = [];
        _pendingHeadingTrackerRefresh = true;
        await LoadGroupTreeAsync(groupKey);
        NavigateToLocation(new MarkdownViewerLocation(groupKey));
    }

    private async Task OnDocumentSelected(MarkdownDocument? document)
    {
        _currentAnchorId = null;
        _documentHeadings = [];
        _pendingHeadingTrackerRefresh = true;
        await LoadDocumentAsync(document);
        NavigateToLocation(new MarkdownViewerLocation(_selectedGroupKey, document?.RelativePath));
    }

    private void ToggleSidebar()
    {
        _showSidebar = !_showSidebar;
    }

    private void ToggleTableOfContents()
    {
        _showTableOfContents = !_showTableOfContents;
    }

    private Task OnDocumentHeadingsChanged(IReadOnlyList<MoMarkdownHeading> headings)
    {
        var normalizedHeadings = headings
            .Where(static heading => heading.Level <= 3)
            .ToArray();

        if (_documentHeadings.SequenceEqual(normalizedHeadings))
        {
            return Task.CompletedTask;
        }

        _documentHeadings = normalizedHeadings;
        _currentAnchorId = ResolveCurrentAnchorId(_currentAnchorId);
        _pendingHeadingTrackerRefresh = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnHeadingSelectedAsync(string anchorId)
    {
        if (_selectedDocument is null || string.IsNullOrWhiteSpace(anchorId))
        {
            return Task.CompletedTask;
        }

        _currentAnchorId = anchorId;
        NavigateToLocation(new MarkdownViewerLocation(_selectedGroupKey, _selectedDocument.RelativePath, anchorId));
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnHashChangedAsync(string? anchorId)
    {
        var normalizedAnchorId = ResolveCurrentAnchorId(anchorId);
        if (string.Equals(_currentAnchorId, normalizedAnchorId, StringComparison.Ordinal))
        {
            return InvokeAsync(StateHasChanged);
        }

        _currentAnchorId = normalizedAnchorId;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ApplyLocationAsync(MarkdownViewerLocation location)
    {
        var requestedAnchorId = ResolveCurrentAnchorId(location.AnchorId);
        _currentAnchorId = requestedAnchorId;

        if (_groups is not { Count: > 0 })
        {
            return;
        }

        var targetGroup = ResolveTargetGroup(location.GroupKey);
        if (targetGroup is null)
        {
            ClearDocumentSelection();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.Equals(_selectedGroupKey, targetGroup.Key, StringComparison.Ordinal)
            || (_currentTree is null && targetGroup.IsValid))
        {
            await LoadGroupTreeAsync(targetGroup.Key, requestedAnchorId);
        }

        if (string.IsNullOrWhiteSpace(location.DocumentRelativePath))
        {
            ClearDocumentSelection();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var targetDocument = FindDocumentByRelativePath(_currentTree, location.DocumentRelativePath);
        if (targetDocument is null)
        {
            ClearDocumentSelection();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var isCurrentDocument = _selectedDocument is not null
                                && string.Equals(
                                    _selectedDocument.RelativePath,
                                    targetDocument.RelativePath,
                                    StringComparison.OrdinalIgnoreCase);

        if (!isCurrentDocument || _documentContent is null)
        {
            _documentHeadings = [];
            await LoadDocumentAsync(targetDocument, requestedAnchorId);
            return;
        }

        _currentAnchorId = requestedAnchorId;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadGroupTreeAsync(string groupKey, string? requestedAnchorId = null)
    {
        _selectedGroupKey = groupKey;
        ClearDocumentSelection();
        _currentAnchorId = requestedAnchorId;
        _currentTree = null;

        var group = GetCurrentGroup();
        if (group is null || !group.IsValid)
        {
            StateHasChanged();
            return;
        }

        if ((await MarkdownService.GetDocumentTreeAsync(groupKey))
            .IsFailed(out var error, out var tree))
        {
            Snackbar.Add(error, Severity.Error);
            return;
        }

        _currentTree = tree;
        StateHasChanged();
    }

    private async Task LoadDocumentAsync(MarkdownDocument? document, string? requestedAnchorId = null)
    {
        _selectedDocument = document;
        _documentContent = null;
        _currentAnchorId = requestedAnchorId;

        if (document is null)
        {
            _contentLoading = false;
            StateHasChanged();
            return;
        }

        _contentLoading = true;
        StateHasChanged();

        try
        {
            if ((await MarkdownService.GetDocumentContentAsync(document))
                .IsFailed(out var error, out var content))
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _documentContent = content;
        }
        finally
        {
            _contentLoading = false;
            StateHasChanged();
        }
    }

    private MarkdownDocumentGroup? ResolveTargetGroup(string? groupKey)
    {
        if (_groups is not { Count: > 0 })
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(groupKey))
        {
            var matchedGroup = _groups.FirstOrDefault(g => string.Equals(g.Key, groupKey, StringComparison.Ordinal));
            if (matchedGroup is not null)
            {
                return matchedGroup;
            }
        }

        if (!string.IsNullOrWhiteSpace(_selectedGroupKey))
        {
            var currentGroup = GetCurrentGroup();
            if (currentGroup is not null)
            {
                return currentGroup;
            }
        }

        return _groups.FirstOrDefault(g => g.IsValid) ?? _groups[0];
    }

    private static MarkdownDocument? FindDocumentByRelativePath(
        TreeNode<MarkdownDocumentNodeData>? node,
        string? relativePath)
    {
        if (node is null || string.IsNullOrWhiteSpace(relativePath))
        {
            return null;
        }

        foreach (var child in node.Children)
        {
            if (child.Data.Document is not null
                && string.Equals(
                    child.Data.Document.RelativePath,
                    relativePath,
                    StringComparison.OrdinalIgnoreCase))
            {
                return child.Data.Document;
            }

            var nestedDocument = FindDocumentByRelativePath(child, relativePath);
            if (nestedDocument is not null)
            {
                return nestedDocument;
            }
        }

        return null;
    }

    private void ClearDocumentSelection()
    {
        _selectedDocument = null;
        _documentContent = null;
        _contentLoading = false;
        _currentAnchorId = null;
        _documentHeadings = [];
        _pendingHeadingTrackerRefresh = true;
    }

    private async Task RefreshHeadingTrackerAsync()
    {
        if (_layoutModule is null)
        {
            return;
        }

        _pendingHeadingTrackerRefresh = false;

        if (_selectedDocument is null || _documentHeadings.Count == 0)
        {
            await _layoutModule.InvokeVoidAsync("disposeActiveHeadingTracker");
            return;
        }

        await _layoutModule.InvokeVoidAsync(
            "observeActiveHeading",
            _documentHeadings.Select(static heading => heading.Id).ToArray(),
            _currentAnchorId,
            _hashObserverReference);
    }

    private string? ResolveCurrentAnchorId(string? anchorId)
    {
        var normalizedAnchorId = NormalizeAnchorId(anchorId);
        if (normalizedAnchorId is null || _documentHeadings.Count == 0)
        {
            return normalizedAnchorId;
        }

        foreach (var candidate in GetAnchorCandidates(normalizedAnchorId))
        {
            var matchedHeading = _documentHeadings.FirstOrDefault(
                heading => string.Equals(heading.Id, candidate, StringComparison.Ordinal));
            if (matchedHeading is not null)
            {
                return matchedHeading.Id;
            }
        }

        return normalizedAnchorId;
    }

    private static IEnumerable<string> GetAnchorCandidates(string anchorId)
    {
        yield return anchorId;

        string? decodedAnchorId = null;
        try
        {
            decodedAnchorId = Uri.UnescapeDataString(anchorId);
        }
        catch (UriFormatException)
        {
        }

        if (!string.IsNullOrEmpty(decodedAnchorId)
            && !string.Equals(decodedAnchorId, anchorId, StringComparison.Ordinal))
        {
            yield return decodedAnchorId;

            var encodedDecodedAnchorId = WebUtility.UrlEncode(decodedAnchorId);
            if (!string.Equals(encodedDecodedAnchorId, anchorId, StringComparison.Ordinal))
            {
                yield return encodedDecodedAnchorId;
            }
        }
    }

    private static string? NormalizeAnchorId(string? anchorId)
    {
        if (string.IsNullOrWhiteSpace(anchorId))
        {
            return null;
        }

        var normalizedAnchorId = anchorId.Trim();
        if (normalizedAnchorId.StartsWith('#'))
        {
            normalizedAnchorId = normalizedAnchorId[1..];
        }

        return string.IsNullOrWhiteSpace(normalizedAnchorId) ? null : normalizedAnchorId;
    }

    private void NavigateToLocation(MarkdownViewerLocation location)
    {
        var targetUri = location.ToRelativeUri();
        var currentUri = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        if (string.Equals(targetUri, currentUri, StringComparison.Ordinal))
        {
            return;
        }

        NavigationManager.NavigateTo(targetUri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() => ApplyLocationAsync(MarkdownViewerLocation.FromAbsoluteUri(e.Location)));
    }

    private string GetWorkspaceClass() =>
        _showSidebar ? "doc-workspace" : "doc-workspace sidebar-hidden";

    private string GetMainStageClass() =>
        _showTableOfContents ? "doc-main-stage" : "doc-main-stage toc-hidden";

    public async ValueTask DisposeAsync()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;

        if (_hashObserverModule is not null && _hashObserverReference is not null)
        {
            try
            {
                await _hashObserverModule.InvokeVoidAsync("unobserveHash", _hashObserverReference);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _hashObserverReference?.Dispose();

        if (_hashObserverModule is not null)
        {
            try
            {
                await _hashObserverModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_layoutModule is not null)
        {
            try
            {
                await _layoutModule.InvokeVoidAsync("disposeActiveHeadingTracker");
            }
            catch (JSDisconnectedException)
            {
            }

            try
            {
                await _layoutModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
