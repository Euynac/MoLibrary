@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@using Monica.Markdown.UIMarkdown.Components
@using Monica.Markdown.UIMarkdown.Services
@using Monica.Tool.Algorithm.Tree
@using Monica.Tool.MoResponse

@inject MarkdownUIService MarkdownService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<MarkdownResource> L

<PageTitle>@L["Pages:MarkdownDocuments:Title"]</PageTitle>

<div class="doc-layout">
    @if (_loading)
    {
        <div class="doc-center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudProgressCircular Color="Color.Primary"
                                     Size="Size.Large"
                                     Indeterminate="true" />
                <MudText Typo="Typo.h6" Color="Color.Primary">
                    @L["MarkdownViewer:States:LoadingDocuments"]
                </MudText>
            </MudStack>
        </div>
    }
    else if (_groups is null || _groups.Count == 0)
    {
        <div class="doc-center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.FolderOff"
                         Size="Size.Large"
                         Color="Color.Default"
                         Style="opacity: 0.3; font-size: 4rem;" />
                <MudText Typo="Typo.h6" Style="opacity: 0.5;">
                    @L["MarkdownViewer:States:NoKnowledgeBasesRegistered"]
                </MudText>
            </MudStack>
        </div>
    }
    else
    {
        @if (_showSidebar)
        {
            <div class="doc-sidebar">
                <DocumentSidebar CurrentGroup="GetCurrentGroup()"
                                 CurrentTree="_currentTree"
                                 SelectedDocument="_selectedDocument"
                                 SelectedDocumentChanged="OnDocumentSelected"
                                 OnCollapseRequested="ToggleSidebar"
                                 OnOpenGroupSwitcher="OpenGroupSwitcherAsync" />
            </div>
        }

        <div class="doc-main">
            <DocumentContentViewer CurrentGroup="GetCurrentGroup()"
                                   Document="_selectedDocument"
                                   Content="@_documentContent"
                                   IsLoading="_contentLoading"
                                   ShowSidebarToggle="!_showSidebar"
                                   OnToggleSidebar="ToggleSidebar" />
        </div>
    }
</div>

@code {
    public const string PAGE_URL = "/markdown-docs";

    private readonly DialogOptions _groupSwitcherDialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true,
        CloseOnEscapeKey = true
    };

    private bool _loading = true;
    private bool _contentLoading;
    private bool _showSidebar = true;
    private List<MarkdownDocumentGroup>? _groups;
    private string? _selectedGroupKey;
    private TreeNode<MarkdownDocumentNodeData>? _currentTree;
    private MarkdownDocument? _selectedDocument;
    private string? _documentContent;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadGroupsAsync();
        }
    }

    private MarkdownDocumentGroup? GetCurrentGroup() =>
        _groups?.FirstOrDefault(g => g.Key == _selectedGroupKey);

    private async Task LoadGroupsAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            if ((await MarkdownService.GetAllDocumentGroupsAsync())
                .IsFailed(out var error, out var groups))
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _groups = groups;

            if (_groups.Count > 0)
            {
                var firstValid = _groups.FirstOrDefault(g => g.IsValid) ?? _groups[0];
                await OnGroupSelected(firstValid.Key);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["MarkdownViewer:Messages:LoadDataFailed", ex.Message], Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenGroupSwitcherAsync()
    {
        if (_groups is not { Count: > 0 } groups)
        {
            return;
        }

        var parameters = new DialogParameters<DocumentGroupSwitcherDialog>
        {
            { x => x.Groups, groups },
            { x => x.SelectedGroupKey, _selectedGroupKey }
        };

        var dialog = await DialogService.ShowAsync<DocumentGroupSwitcherDialog>(
            L["MarkdownViewer:Dialogs:SwitchKnowledgeBaseTitle"],
            parameters,
            _groupSwitcherDialogOptions);

        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: string selectedGroupKey }
            || string.Equals(selectedGroupKey, _selectedGroupKey, StringComparison.Ordinal))
        {
            return;
        }

        await OnGroupSelected(selectedGroupKey);
    }

    private async Task OnGroupSelected(string groupKey)
    {
        _selectedGroupKey = groupKey;
        _selectedDocument = null;
        _documentContent = null;
        _currentTree = null;

        var group = GetCurrentGroup();
        if (group is null || !group.IsValid)
        {
            StateHasChanged();
            return;
        }

        if ((await MarkdownService.GetDocumentTreeAsync(groupKey))
            .IsFailed(out var error, out var tree))
        {
            Snackbar.Add(error, Severity.Error);
            return;
        }

        _currentTree = tree;
        StateHasChanged();
    }

    private async Task OnDocumentSelected(MarkdownDocument? document)
    {
        _selectedDocument = document;
        _documentContent = null;

        if (document is null)
        {
            return;
        }

        _contentLoading = true;
        StateHasChanged();

        try
        {
            if ((await MarkdownService.GetDocumentContentAsync(document))
                .IsFailed(out var error, out var content))
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _documentContent = content;
        }
        finally
        {
            _contentLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleSidebar()
    {
        _showSidebar = !_showSidebar;
    }
}
