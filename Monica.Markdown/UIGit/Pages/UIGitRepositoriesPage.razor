@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Localization
@using Monica.Markdown.Git.Models
@using Monica.Markdown.Localization
@using Monica.Markdown.UIGit.Services
@using Monica.Tool.MoResponse

@inject GitUIService GitService
@inject ISnackbar Snackbar
@inject IStringLocalizer<MarkdownResource> L

<PageTitle>@L["GitDashboard:PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">@L["GitDashboard:Title"]</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadAsync"
                       Disabled="@_isLoading">
                @L["GitDashboard:Actions:Refresh"]
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Sync"
                       OnClick="SyncAllAsync"
                       Disabled="@(_isLoading || _repositories.Count == 0)">
                @L["GitDashboard:Actions:SyncAll"]
            </MudButton>
        </MudStack>
    </MudStack>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L["GitDashboard:Sections:Repositories"]</MudText>

                <MudTable T="GitRepositoryStatus" Items="@_repositories" Dense="true" Hover="true" Loading="@_isLoading">
                    <HeaderContent>
                        <MudTh>@L["GitDashboard:Columns:Id"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Provider"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Branch"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:State"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Commit"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Updated"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Id"])">@context.Id</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Provider"])">@GetDisplay(context.Provider)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Branch"])">@GetDisplay(context.ResolvedBranch ?? context.ConfiguredBranch)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:State"])">
                            <MudChip T="string" Color="@GetStateColor(context.State)" Variant="Variant.Outlined" Label="true">
                                @GetStateText(context.State)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Commit"])">@ShortSha(context.CurrentCommit)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Updated"])">@FormatDate(context.LastSyncAtUtc)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Actions"])">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SelectRepository(context.Id))">
                                    @L["GitDashboard:Actions:Select"]
                                </MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SyncRepositoryAsync(context.Id))" Disabled="@_isLoading">
                                    @L["GitDashboard:Actions:Sync"]
                                </MudButton>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">@L["GitDashboard:Messages:NoRepositories"]</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L["GitDashboard:Sections:Details"]</MudText>

                @if (_selectedRepository is null)
                {
                    <MudAlert Severity="Severity.Info">@L["GitDashboard:Messages:NoSelection"]</MudAlert>
                }
                else
                {
                    <MudStack Spacing="2">
                        <MudText><strong>@L["GitDashboard:Labels:RemoteUrl"]:</strong> @_selectedRepository.RemoteUrl</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:LocalPath"]:</strong> @_selectedRepository.LocalPath</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:ResolvedLocalPath"]:</strong> @_selectedRepository.ResolvedLocalPath</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:ConfiguredBranch"]:</strong> @GetDisplay(_selectedRepository.ConfiguredBranch)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:ResolvedBranch"]:</strong> @GetDisplay(_selectedRepository.ResolvedBranch)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:Credential"]:</strong> @GetDisplay(_selectedRepository.CredentialId)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:Available"]:</strong> @BoolText(_selectedRepository.IsAvailable)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:Dirty"]:</strong> @BoolText(_selectedRepository.IsDirty)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:CurrentCommit"]:</strong> @GetDisplay(_selectedRepository.CurrentCommit)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:LastSync"]:</strong> @FormatDate(_selectedRepository.LastSyncAtUtc)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:BoundGroups"]:</strong> @JoinOrNone(_selectedRepository.BoundDocumentGroupKeys)</MudText>
                        <MudText><strong>@L["GitDashboard:Labels:MissingGroups"]:</strong> @JoinOrNone(_selectedRepository.MissingDocumentGroupKeys)</MudText>

                        @if (!string.IsNullOrWhiteSpace(_selectedRepository.LastSyncMessage))
                        {
                            <MudAlert Severity="Severity.Info">
                                <strong>@L["GitDashboard:Labels:LastMessage"]:</strong> @_selectedRepository.LastSyncMessage
                            </MudAlert>
                        }

                        @if (!string.IsNullOrWhiteSpace(_selectedRepository.LastError))
                        {
                            <MudAlert Severity="Severity.Error">
                                <strong>@L["GitDashboard:Labels:LastError"]:</strong> @_selectedRepository.LastError
                            </MudAlert>
                        }
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L["GitDashboard:Sections:Credentials"]</MudText>

                <MudTable T="GitCredentialInfo" Items="@_credentials" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>@L["GitDashboard:Columns:CredentialId"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Type"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:UserName"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:HasSecret"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:CredentialId"])">@context.Id</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Type"])">@context.AuthenticationType</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:UserName"])">@GetDisplay(context.UserName)</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:HasSecret"])">@BoolText(context.HasSecret)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">@L["GitDashboard:Messages:NoCredentials"]</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L["GitDashboard:Sections:Resolvers"]</MudText>

                <MudTable T="GitCredentialResolverInfo" Items="@_resolvers" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>@L["GitDashboard:Columns:Resolver"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Type"]</MudTh>
                        <MudTh>@L["GitDashboard:Columns:Order"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Resolver"])">@context.DisplayName</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Type"])">@context.ImplementationType</MudTd>
                        <MudTd DataLabel="@(L["GitDashboard:Columns:Order"])">@context.Order</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">@L["GitDashboard:Messages:NoResolvers"]</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    public const string PAGE_URL = "/git-repositories";

    private bool _isLoading;
    private List<GitRepositoryStatus> _repositories = [];
    private List<GitCredentialInfo> _credentials = [];
    private List<GitCredentialResolverInfo> _resolvers = [];
    private GitRepositoryStatus? _selectedRepository;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            if ((await GitService.GetRepositoriesAsync()).IsFailed(out var repoError, out var repositories))
            {
                Snackbar.Add(L["GitDashboard:Messages:LoadFailed", repoError], Severity.Error);
                return;
            }

            if ((await GitService.GetCredentialsAsync()).IsFailed(out var credentialError, out var credentials))
            {
                Snackbar.Add(L["GitDashboard:Messages:LoadFailed", credentialError], Severity.Error);
                return;
            }

            if ((await GitService.GetCredentialResolversAsync()).IsFailed(out var resolverError, out var resolvers))
            {
                Snackbar.Add(L["GitDashboard:Messages:LoadFailed", resolverError], Severity.Error);
                return;
            }

            _repositories = repositories.ToList();
            _credentials = credentials.ToList();
            _resolvers = resolvers.ToList();

            if (_selectedRepository is null)
            {
                _selectedRepository = _repositories.FirstOrDefault();
            }
            else
            {
                _selectedRepository = _repositories.FirstOrDefault(x => x.Id == _selectedRepository.Id)
                    ?? _repositories.FirstOrDefault();
            }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void SelectRepository(string repositoryId)
    {
        _selectedRepository = _repositories.FirstOrDefault(x => x.Id == repositoryId);
    }

    private async Task SyncRepositoryAsync(string repositoryId)
    {
        if ((await GitService.SyncRepositoryAsync(repositoryId)).IsFailed(out var error, out var result))
        {
            Snackbar.Add(L["GitDashboard:Messages:OperationFailed", error], Severity.Error);
            return;
        }

        Snackbar.Add(
            result.Success
                ? L["GitDashboard:Messages:SyncRepositorySuccess", repositoryId]
                : L["GitDashboard:Messages:OperationFailed", result.Message],
            result.Success ? Severity.Success : Severity.Error);

        await LoadAsync();
    }

    private async Task SyncAllAsync()
    {
        if ((await GitService.SyncAllAsync()).IsFailed(out var error, out var results))
        {
            Snackbar.Add(L["GitDashboard:Messages:OperationFailed", error], Severity.Error);
            return;
        }

        var failures = results.Where(x => !x.Success).ToList();
        Snackbar.Add(
            failures.Count == 0
                ? L["GitDashboard:Messages:SyncAllSuccess"]
                : L["GitDashboard:Messages:OperationFailed", string.Join("; ", failures.Select(x => x.Message))],
            failures.Count == 0 ? Severity.Success : Severity.Warning);

        await LoadAsync();
    }

    private string GetStateText(GitRepositorySyncState state)
    {
        return state switch
        {
            GitRepositorySyncState.NotReady => L["GitDashboard:States:NotReady"],
            GitRepositorySyncState.Syncing => L["GitDashboard:States:Syncing"],
            GitRepositorySyncState.Ready => L["GitDashboard:States:Ready"],
            GitRepositorySyncState.Failed => L["GitDashboard:States:Failed"],
            _ => state.ToString()
        };
    }

    private static Color GetStateColor(GitRepositorySyncState state)
    {
        return state switch
        {
            GitRepositorySyncState.Ready => Color.Success,
            GitRepositorySyncState.Syncing => Color.Info,
            GitRepositorySyncState.Failed => Color.Error,
            _ => Color.Default
        };
    }

    private string BoolText(bool value)
    {
        return value ? L["GitDashboard:States:Yes"] : L["GitDashboard:States:No"];
    }

    private string GetDisplay(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? L["GitDashboard:States:None"] : value;
    }

    private string JoinOrNone(IReadOnlyList<string> values)
    {
        return values.Count == 0 ? L["GitDashboard:States:None"] : string.Join(", ", values);
    }

    private static string ShortSha(string? sha)
    {
        return string.IsNullOrWhiteSpace(sha)
            ? string.Empty
            : sha.Length <= 8
                ? sha
                : sha[..8];
    }

    private static string FormatDate(DateTimeOffset? dateTimeOffset)
    {
        return dateTimeOffset?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? string.Empty;
    }
}
