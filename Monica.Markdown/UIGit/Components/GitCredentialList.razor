@using Monica.Markdown.Git.Models
@using Monica.Markdown.UIGit.Services

@inject GitUIService GitService
@inject ISnackbar Snackbar

<MudDataGrid T="GitCredential"
             Items="_credentials"
             Dense="true"
             Hover="true"
             Loading="_loading"
             Striped="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Git Credentials</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadCredentialsAsync"
                       Title="Refresh" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" />
        <PropertyColumn Property="x => x.DisplayName" Title="Display Name" />
        <TemplateColumn Title="Type">
            <CellTemplate>
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(context.Item.Type == EGitCredentialType.Token ? Color.Primary : Color.Secondary)">
                    @context.Item.Type
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Value">
            <CellTemplate>
                @if (context.Item.Type == EGitCredentialType.Token)
                {
                    <span style="font-family: monospace;">@(context.Item.Token ?? "—")</span>
                }
                else
                {
                    <span>@(context.Item.Username ?? "—") / <span style="font-family: monospace;">@(context.Item.Password ?? "—")</span></span>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private IReadOnlyList<GitCredential>? _credentials;
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCredentialsAsync();
        }
    }

    private async Task LoadCredentialsAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            if ((await GitService.GetAllCredentialsAsync()).IsFailed(out var error, out var creds))
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _credentials = creds;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}
