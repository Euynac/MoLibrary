@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@using Monica.Markdown.UIMarkdown.Models
@using Monica.Markdown.UIMarkdown.Support
@using Monica.UI.Shared.Components.Markdown
@inject IStringLocalizer<MarkdownResource> L

<div class="content-container">
    <div class="content-toolbar">
        <div class="toolbar-leading">
            @if (ShowSidebarToggle)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Size="Size.Small"
                               OnClick="OnToggleSidebar"
                               title="@L["MarkdownViewer:Navbar:ShowSidebar"]"
                               Class="sidebar-toggle-btn" />
            }

            <button type="button"
                    class="search-trigger"
                    @onclick="OpenDocumentSearchAsync"
                    title="@L["MarkdownViewer:Toolbar:SearchPlaceholder"]">
                <span class="search-trigger-leading">
                    <MudIcon Icon="@Icons.Material.Filled.Search"
                             Size="Size.Small"
                             Class="search-trigger-icon" />
                    <span class="search-trigger-label">@L["MarkdownViewer:Toolbar:SearchPlaceholder"]</span>
                </span>
            </button>
        </div>

        <div class="toolbar-trailing">
            <button type="button"
                    class="@GetOutlineToggleClass()"
                    @onclick="ToggleTableOfContentsAsync"
                    title="@GetOutlineToggleText()">
                <MudIcon Icon="@Icons.Material.Filled.Toc"
                         Size="Size.Small"
                         Class="outline-toggle-icon" />
                <span>@GetOutlineToggleText()</span>
            </button>

            @if (Document is not null)
            {
                <span class="last-edited">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule"
                             Size="Size.Small"
                             Class="last-edited-icon" />
                    @L["MarkdownViewer:Navbar:LastEdited", FormatLastEditedText(Document.LastModifiedUtc)]
                </span>
            }
        </div>
    </div>

    <div class="content-breadcrumb-bar">
        @if (_breadcrumbs.Count > 0)
        {
            <MudBreadcrumbs Items="_breadcrumbs" Class="content-breadcrumbs">
                <ItemTemplate Context="item">
                    @if (ShouldRenderBreadcrumbLink(item))
                    {
                        <a href="@item.Href">
                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                            }

                            @item.Text
                        </a>
                    }
                    else
                    {
                        <span class="content-breadcrumb-label">
                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                            }

                            @item.Text
                        </span>
                    }
                </ItemTemplate>
            </MudBreadcrumbs>
        }
    </div>

    @if (CurrentGroup is { IsValid: false } invalidGroup)
    {
        <div class="center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.Warning"
                         Size="Size.Large"
                         Color="Color.Warning"
                         Class="state-icon state-icon-warning" />
                <MudText Typo="Typo.h6" Color="Color.Warning">
                    @L["MarkdownViewer:States:GroupUnavailable"]
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="state-copy">
                    @L["MarkdownViewer:States:GroupUnavailableDescription"]
                </MudText>
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                    <MudText Typo="Typo.body2" Class="state-path">
                        @invalidGroup.BasePath
                    </MudText>
                </MudAlert>
            </MudStack>
        </div>
    }
    else if (IsLoading)
    {
        <div class="center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudProgressCircular Color="Color.Primary"
                                     Size="Size.Large"
                                     Indeterminate="true" />
                <MudText Typo="Typo.body1" Color="Color.Primary">
                    @L["MarkdownViewer:States:LoadingDocument"]
                </MudText>
            </MudStack>
        </div>
    }
    else if (Document is null)
    {
        <div class="center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.Article"
                         Size="Size.Large"
                         Color="Color.Default"
                         Class="state-icon state-icon-muted" />
                <MudText Typo="Typo.h6" Color="Color.Default" Class="state-copy state-copy-muted">
                    @L["MarkdownViewer:States:NoDocumentSelected"]
                </MudText>
            </MudStack>
        </div>
    }
    else
    {
        <div class="content-scroll" data-markdown-scroll-root="true">
            <div class="content-body" data-markdown-content-root="true">
                <h1 class="doc-title">@Document.Title</h1>

                @if (Document.FrontMatter is not null)
                {
                    <DocumentMetadataPanel FrontMatter="Document.FrontMatter"
                                           FileSize="Document.FileSize" />
                }

                <MudDivider Class="my-4" />

                <div class="markdown-body" data-markdown-body="true">
                    <MoMarkdown Value="@_strippedContent"
                                ScopeKey="@Document.GroupKey"
                                DocumentRelativePath="@Document.RelativePath"
                                HasTableOfContents="false"
                                HeadingsChanged="OnHeadingsChanged" />
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public MarkdownDocumentGroup? CurrentGroup { get; set; }

    [Parameter]
    public MarkdownDocument? Document { get; set; }

    [Parameter]
    public string? Content { get; set; }

    [Parameter]
    public string? CurrentAnchorId { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool ShowSidebarToggle { get; set; }

    [Parameter]
    public bool IsTableOfContentsVisible { get; set; }

    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    [Parameter]
    public EventCallback OnToggleTableOfContents { get; set; }

    [Parameter]
    public EventCallback OnOpenDocumentSearch { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<MoMarkdownHeading>> HeadingsChanged { get; set; }

    private List<BreadcrumbItem> _breadcrumbs = [];
    private IReadOnlyList<MoMarkdownHeading> _headings = [];
    private string? _strippedContent;
    private string? _lastDocumentRelativePath;
    private string? _lastStrippedContent;

    protected override void OnParametersSet()
    {
        _strippedContent = RewriteHtmlDocumentLinks(StripFrontMatterAndLeadingTitle(Content));
        ResetHeadingsIfDocumentChanged();
        BuildBreadcrumbs();
    }

    private void BuildBreadcrumbs()
    {
        _breadcrumbs = [];

        var currentGroup = CurrentGroup;
        if (!string.IsNullOrWhiteSpace(currentGroup?.Title))
        {
            var groupHref = string.IsNullOrWhiteSpace(currentGroup.Key)
                ? null
                : new MarkdownViewerLocation(currentGroup.Key).ToRelativeUri();

            _breadcrumbs.Add(CreateBreadcrumbItem(currentGroup.Title, groupHref, disabled: Document is null));
        }

        if (Document is null)
        {
            return;
        }

        var segments = Document.RelativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < segments.Length - 1; i++)
        {
            _breadcrumbs.Add(CreateBreadcrumbItem(segments[i]));
        }

        var headingTrail = ResolveHeadingTrail();
        _breadcrumbs.Add(CreateBreadcrumbItem(
            Document.Title,
            BuildDocumentHref(),
            disabled: headingTrail.Count == 0));

        foreach (var heading in headingTrail)
        {
            _breadcrumbs.Add(CreateBreadcrumbItem(
                heading.Title,
                BuildDocumentHref(heading.Id),
                disabled: string.Equals(heading.Id, CurrentAnchorId, StringComparison.Ordinal)));
        }
    }

    private string FormatLastEditedText(DateTime utcTime)
    {
        var elapsed = DateTime.UtcNow - utcTime;

        return elapsed switch
        {
            { TotalMinutes: < 1 } => L["MarkdownViewer:Time:JustNow"].Value,
            { TotalMinutes: < 60 } => L["MarkdownViewer:Time:MinutesAgo", (int)elapsed.TotalMinutes].Value,
            { TotalHours: < 24 } => L["MarkdownViewer:Time:HoursAgo", (int)elapsed.TotalHours].Value,
            { TotalDays: < 30 } => L["MarkdownViewer:Time:DaysAgo", (int)elapsed.TotalDays].Value,
            _ => utcTime.ToLocalTime().ToString("yyyy-MM-dd")
        };
    }

    private static string? StripFrontMatterAndLeadingTitle(string? content)
    {
        return StripLeadingTitle(StripFrontMatter(content));
    }

    private static string? StripFrontMatter(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return content;
        }

        var span = content.AsSpan().TrimStart();
        if (!span.StartsWith("---"))
        {
            return content;
        }

        var firstLineEnd = span.IndexOfAny('\r', '\n');
        if (firstLineEnd < 0)
        {
            return content;
        }

        var afterFirstLine = firstLineEnd;
        while (afterFirstLine < span.Length && (span[afterFirstLine] is '\r' or '\n'))
        {
            afterFirstLine++;
        }

        var remaining = span[afterFirstLine..];
        var closingIndex = FindFrontMatterClosingDelimiter(remaining);
        if (closingIndex < 0)
        {
            return content;
        }

        var afterClosing = closingIndex;
        while (afterClosing < remaining.Length && remaining[afterClosing] is not '\r' and not '\n')
        {
            afterClosing++;
        }

        while (afterClosing < remaining.Length && (remaining[afterClosing] is '\r' or '\n'))
        {
            afterClosing++;
        }

        return remaining[afterClosing..].ToString();
    }

    private static int FindFrontMatterClosingDelimiter(ReadOnlySpan<char> content)
    {
        var position = 0;
        while (position < content.Length)
        {
            var lineStart = position;
            var lineLength = content[position..].IndexOfAny('\r', '\n');
            if (lineLength < 0)
            {
                lineLength = content.Length - position;
            }

            var line = content.Slice(position, lineLength).Trim();
            if (line is "---" or "...")
            {
                return lineStart;
            }

            position += lineLength;
            while (position < content.Length && (content[position] is '\r' or '\n'))
            {
                position++;
            }
        }

        return -1;
    }

    private static string? StripLeadingTitle(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return content;
        }

        var trimmed = content.TrimStart();
        if (!trimmed.StartsWith("# "))
        {
            return content;
        }

        var newlineIndex = trimmed.IndexOf('\n');
        return newlineIndex >= 0 ? trimmed[(newlineIndex + 1)..].TrimStart() : string.Empty;
    }

    private string? RewriteHtmlDocumentLinks(string? content)
    {
        // Raw HTML anchors bypass the markdown link override pipeline, so they need a source-level rewrite.
        return MarkdownHtmlDocumentLinkRewriter.Rewrite(
            content,
            Document?.GroupKey,
            Document?.RelativePath);
    }

    private Task OnHeadingsChanged(IReadOnlyList<MoMarkdownHeading> headings)
    {
        if (_headings.SequenceEqual(headings))
        {
            return Task.CompletedTask;
        }

        _headings = headings.ToArray();
        BuildBreadcrumbs();
        _ = HeadingsChanged.InvokeAsync(_headings);
        return InvokeAsync(StateHasChanged);
    }

    private void ResetHeadingsIfDocumentChanged()
    {
        var currentRelativePath = Document?.RelativePath;

        if (string.Equals(_lastDocumentRelativePath, currentRelativePath, StringComparison.OrdinalIgnoreCase)
            && string.Equals(_lastStrippedContent, _strippedContent, StringComparison.Ordinal))
        {
            return;
        }

        _lastDocumentRelativePath = currentRelativePath;
        _lastStrippedContent = _strippedContent;
        _headings = [];
        _ = HeadingsChanged.InvokeAsync(_headings);
    }

    private List<MoMarkdownHeading> ResolveHeadingTrail()
    {
        if (string.IsNullOrWhiteSpace(CurrentAnchorId) || _headings.Count == 0)
        {
            return [];
        }

        var trail = new List<MoMarkdownHeading>();
        foreach (var heading in _headings)
        {
            while (trail.Count > 0 && trail[^1].Level >= heading.Level)
            {
                trail.RemoveAt(trail.Count - 1);
            }

            trail.Add(heading);

            if (string.Equals(heading.Id, CurrentAnchorId, StringComparison.Ordinal))
            {
                return trail.ToList();
            }
        }

        return [];
    }

    private string? BuildDocumentHref(string? anchorId = null)
    {
        if (Document is null)
        {
            return null;
        }

        return new MarkdownViewerLocation(Document.GroupKey, Document.RelativePath, anchorId).ToRelativeUri();
    }

    private static BreadcrumbItem CreateBreadcrumbItem(
        string text,
        string? href = null,
        bool disabled = false,
        string? icon = null)
    {
        return new BreadcrumbItem(text, href, disabled || string.IsNullOrWhiteSpace(href), icon);
    }

    private static bool ShouldRenderBreadcrumbLink(BreadcrumbItem item) =>
        !item.Disabled && !string.IsNullOrWhiteSpace(item.Href);

    private string GetOutlineToggleClass() =>
        IsTableOfContentsVisible ? "outline-toggle is-active" : "outline-toggle";

    private string GetOutlineToggleText() =>
        IsTableOfContentsVisible
            ? L["MarkdownViewer:Toolbar:HideOutline"].Value
            : L["MarkdownViewer:Toolbar:ShowOutline"].Value;

    private Task ToggleTableOfContentsAsync()
    {
        return OnToggleTableOfContents.InvokeAsync();
    }

    private Task OpenDocumentSearchAsync()
    {
        return OnOpenDocumentSearch.InvokeAsync();
    }
}
