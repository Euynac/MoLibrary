@using Monica.Markdown.Models

@if (IsGroupInvalid)
{
    <div class="content-container center-state">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <MudIcon Icon="@Icons.Material.Filled.Warning"
                     Size="Size.Large"
                     Color="Color.Warning"
                     Style="font-size: 4rem;" />
            <MudText Typo="Typo.h6" Color="Color.Warning">
                Document group unavailable
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center"
                     Style="opacity: 0.7;">
                The configured path does not exist or is not accessible.
            </MudText>
            @if (InvalidGroupPath is not null)
            {
                <MudAlert Severity="Severity.Warning"
                          Variant="Variant.Outlined" Dense="true">
                    <MudText Typo="Typo.body2"
                             Style="font-family: monospace;">
                        @InvalidGroupPath
                    </MudText>
                </MudAlert>
            }
        </MudStack>
    </div>
}
else if (IsLoading)
{
    <div class="content-container center-state">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <MudProgressCircular Color="Color.Primary"
                                 Size="Size.Large"
                                 Indeterminate="true" />
            <MudText Typo="Typo.body1" Color="Color.Primary">
                Loading document...
            </MudText>
        </MudStack>
    </div>
}
else if (Document is null)
{
    <div class="content-container center-state">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <MudIcon Icon="@Icons.Material.Filled.Article"
                     Size="Size.Large"
                     Color="Color.Default"
                     Style="opacity: 0.3; font-size: 4rem;" />
            <MudText Typo="Typo.h6" Color="Color.Default"
                     Style="opacity: 0.5;">
                Select a document to view
            </MudText>
        </MudStack>
    </div>
}
else
{
    <div class="content-container">
        <!-- Top Navbar -->
        <div class="content-navbar">
            <MudBreadcrumbs Items="_breadcrumbs" Class="content-breadcrumbs" />
            <span class="last-edited">
                <MudIcon Icon="@Icons.Material.Filled.Schedule"
                         Size="Size.Small" Class="last-edited-icon" />
                Last edited @FormatLastEdited(Document.LastModifiedUtc)
            </span>
        </div>

        <!-- Scrollable Content -->
        <div class="content-scroll">
            <div class="content-body">
                <!-- Title Area -->
                <h1 class="doc-title">@Document.Title</h1>

                @if (Document.FrontMatter is not null)
                {
                    <DocumentMetadataPanel FrontMatter="Document.FrontMatter"
                                           FileSize="Document.FileSize" />
                }

                <MudDivider Class="my-4" />

                <!-- Markdown Body -->
                <div class="markdown-body">
                    <MoMarkdownThemeManager />
                    <MudMarkdown Value="@Content" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public MarkdownDocument? Document { get; set; }

    [Parameter]
    public string? Content { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? GroupTitle { get; set; }

    [Parameter]
    public bool IsGroupInvalid { get; set; }

    [Parameter]
    public string? InvalidGroupPath { get; set; }

    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override void OnParametersSet()
    {
        BuildBreadcrumbs();
    }

    private void BuildBreadcrumbs()
    {
        _breadcrumbs = [];

        if (Document is null) return;

        if (GroupTitle is not null)
        {
            _breadcrumbs.Add(new BreadcrumbItem(GroupTitle, null,
                icon: Icons.Material.Filled.Folder));
        }

        var segments = Document.RelativePath.Split('/');
        for (var i = 0; i < segments.Length - 1; i++)
        {
            _breadcrumbs.Add(new BreadcrumbItem(segments[i], null,
                icon: Icons.Material.Filled.FolderOpen));
        }

        _breadcrumbs.Add(new BreadcrumbItem(Document.Title, null,
            disabled: true,
            icon: Icons.Custom.FileFormats.FileDocument));
    }

    private static string FormatLastEdited(DateTime utcTime)
    {
        var elapsed = DateTime.UtcNow - utcTime;

        return elapsed switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)elapsed.TotalMinutes}m ago",
            { TotalHours: < 24 } => $"{(int)elapsed.TotalHours}h ago",
            { TotalDays: < 30 } => $"{(int)elapsed.TotalDays}d ago",
            _ => utcTime.ToLocalTime().ToString("MMM dd, yyyy")
        };
    }
}