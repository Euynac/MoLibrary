@using Monica.Markdown.Models
@using Monica.Tool.Algorithm.Tree

<div class="tree-container">
    <!-- Section Label -->
    <div class="tree-section-label">DOCUMENTS</div>

    <!-- Search -->
    <div class="tree-header">
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Search files (Cmd+K)"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Class="tree-search" />
    </div>

    <!-- Tree View -->
    <div class="tree-content">
        @if (_treeItems is null || _treeItems.Count == 0)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4 empty-state">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                         Size="Size.Large"
                         Color="Color.Default"
                         Style="opacity: 0.3;" />
                <MudText Typo="Typo.body2" Color="Color.Default" Style="opacity: 0.5;">
                    No documents found
                </MudText>
            </MudStack>
        }
        else
        {
            <MudTreeView T="MarkdownDocumentNodeData"
                         Items="_treeItems"
                         SelectedValueChanged="OnItemSelected"
                         Hover="true"
                         Dense="true">
                <ItemTemplate>
                    <MudTreeViewItem T="MarkdownDocumentNodeData"
                                     Items="@context.Children"
                                     Value="@context.Value"
                                     Text="@context.Text"
                                     Icon="@GetIcon(context.Value)"
                                     IconColor="@GetIconColor(context.Value)"
                                     Expanded="IsExpanded(context.Value)" />
                </ItemTemplate>
            </MudTreeView>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TreeNode<MarkdownDocumentNodeData>? TreeRoot { get; set; }

    [Parameter]
    public MarkdownDocument? SelectedDocument { get; set; }

    [Parameter]
    public EventCallback<MarkdownDocument?> SelectedDocumentChanged { get; set; }

    [Parameter]
    public EventCallback OnCollapseRequested { get; set; }

    private string? _searchText;
    private List<DocumentTreeItem>? _treeItems;

    protected override void OnParametersSet()
    {
        _treeItems = BuildTreeItems(TreeRoot);
    }

    private List<DocumentTreeItem>? BuildTreeItems(
        TreeNode<MarkdownDocumentNodeData>? node)
    {
        if (node is null) return null;

        var items = new List<DocumentTreeItem>();
        foreach (var child in node.Children)
        {
            if (!MatchesSearch(child)) continue;

            var childItems = BuildTreeItems(child);
            var item = new DocumentTreeItem(
                child.Data,
                child.Data.Name,
                childItems);
            items.Add(item);
        }
        return items.Count > 0 ? items : null;
    }

    private bool MatchesSearch(TreeNode<MarkdownDocumentNodeData> node)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return true;

        if (node.Data.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            return true;

        return node.Children.Any(MatchesSearch);
    }

    private async Task OnItemSelected(MarkdownDocumentNodeData? data)
    {
        if (data?.IsDocument == true && data.Document is not null)
        {
            await SelectedDocumentChanged.InvokeAsync(data.Document);
        }
    }

    private static string GetIcon(MarkdownDocumentNodeData? data) =>
        data?.IsDocument == true
            ? Icons.Custom.FileFormats.FileDocument
            : Icons.Custom.Uncategorized.Folder;

    private static Color GetIconColor(MarkdownDocumentNodeData? data) =>
        data?.IsDocument == true ? Color.Info : Color.Warning;

    private bool IsExpanded(MarkdownDocumentNodeData? data) =>
        !string.IsNullOrWhiteSpace(_searchText) || data?.IsDocument != true;

    /// <summary>
    /// Custom tree item implementation for MudBlazor v9 TreeView.
    /// Implements ITreeItemData to provide tree structure for MarkdownDocumentNodeData.
    /// </summary>
    private sealed class DocumentTreeItem : MudBlazor.ITreeItemData<MarkdownDocumentNodeData>
    {
        public DocumentTreeItem(
            MarkdownDocumentNodeData value,
            string text,
            List<DocumentTreeItem>? children)
        {
            Value = value;
            Text = text;
            Children = children;
            Icon = string.Empty;
            Expanded = false;
            Expandable = true;
            Selected = false;
            Visible = true;
        }

        public MarkdownDocumentNodeData Value { get; }
        public string? Text { get; set; }
        public string? Icon { get; set; }
        public bool Expanded { get; set; }
        public bool Expandable { get; set; }
        public bool Selected { get; set; }
        public bool Visible { get; set; }
        public IReadOnlyCollection<MudBlazor.ITreeItemData<MarkdownDocumentNodeData>>? Children { get; set; }
        public bool HasChildren => Children?.Count > 0;
    }
}
