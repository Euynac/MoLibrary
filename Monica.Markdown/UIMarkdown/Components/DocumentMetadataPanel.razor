@using Monica.Markdown.Models

<div class="metadata-row">
    @if (FrontMatter.Tags.Count > 0)
    {
        @foreach (var tag in FrontMatter.Tags)
        {
            <span class="meta-tag">@tag</span>
        }
    }

    @if (!string.IsNullOrWhiteSpace(AuthorDisplay))
    {
        <span class="meta-text">
            <MudIcon Icon="@Icons.Material.Filled.Person"
                     Size="Size.Small" Class="meta-icon" />
            By @AuthorDisplay
        </span>
    }

    @if (ReadTimeMinutes > 0)
    {
        <span class="meta-separator">·</span>
        <span class="meta-text">@ReadTimeMinutes min read</span>
    }

    @foreach (var kv in GetCustomMetadata())
    {
        <MudTooltip Text="@kv.Key">
            <span class="meta-text meta-custom">@kv.Key: @kv.Value</span>
        </MudTooltip>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public MarkdownFrontMatter FrontMatter { get; set; } = null!;

    [Parameter]
    public long FileSize { get; set; }

    private string? AuthorDisplay =>
        FrontMatter.RawMetadata.TryGetValue("author", out var author)
            ? author?.ToString()
            : null;

    private int ReadTimeMinutes =>
        FileSize > 0 ? Math.Max(1, (int)Math.Ceiling(FileSize / 5.0 / 200.0)) : 0;

    private static readonly HashSet<string> ReservedKeys =
        new(StringComparer.OrdinalIgnoreCase) { "title", "date", "tags", "author" };

    private IEnumerable<KeyValuePair<string, string>> GetCustomMetadata()
    {
        return FrontMatter.RawMetadata
            .Where(kv => !ReservedKeys.Contains(kv.Key) && kv.Value is not null)
            .Select(kv => new KeyValuePair<string, string>(kv.Key, kv.Value?.ToString() ?? ""));
    }
}
