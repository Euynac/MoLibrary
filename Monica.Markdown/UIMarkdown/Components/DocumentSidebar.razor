@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@using Monica.Tool.Algorithm.Tree
@inject IStringLocalizer<MarkdownResource> L

<div class="sidebar">
    <div class="sidebar-header">
        <button type="button"
                class="knowledge-base-switcher"
                @onclick="OpenGroupSwitcher"
                title="@GetCurrentGroupHint()">
            <span class="knowledge-base-switcher-icon-shell">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook"
                         Size="Size.Small"
                         Class="knowledge-base-switcher-icon" />
            </span>

            <span class="knowledge-base-switcher-label">@GetCurrentGroupTitle()</span>

            @if (CurrentGroup is { IsValid: false })
            {
                <MudIcon Icon="@Icons.Material.Filled.Warning"
                         Size="Size.Small"
                         Color="Color.Warning"
                         Class="knowledge-base-switcher-warning" />
            }

            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown"
                     Size="Size.Small"
                     Class="knowledge-base-switcher-chevron" />
        </button>

    </div>

    @if (CurrentTree is not null)
    {
        <div class="sidebar-tree">
            <DocumentTreePanel TreeRoot="CurrentTree"
                               SelectedDocument="SelectedDocument"
                               SelectedDocumentChanged="SelectedDocumentChanged" />
        </div>
    }

    <div class="sidebar-footer">
        <span class="footer-text">Monica Markdown</span>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                       Size="Size.Small"
                       OnClick="OnCollapseRequested"
                       title="@L["MarkdownViewer:Navbar:HideSidebar"]"
                       Class="sidebar-collapse-button" />
    </div>
</div>

@code {
    [Parameter]
    public MarkdownDocumentGroup? CurrentGroup { get; set; }

    [Parameter]
    public TreeNode<MarkdownDocumentNodeData>? CurrentTree { get; set; }

    [Parameter]
    public MarkdownDocument? SelectedDocument { get; set; }

    [Parameter]
    public EventCallback<MarkdownDocument?> SelectedDocumentChanged { get; set; }

    [Parameter]
    public EventCallback OnCollapseRequested { get; set; }

    [Parameter]
    public EventCallback OnOpenGroupSwitcher { get; set; }

    private Task OpenGroupSwitcher()
    {
        return OnOpenGroupSwitcher.InvokeAsync();
    }

    private string GetCurrentGroupTitle() =>
        CurrentGroup?.Title ?? L["MarkdownViewer:Navbar:UnknownKnowledgeBase"].Value;

    private string GetCurrentGroupHint() =>
        CurrentGroup?.Description
        ?? CurrentGroup?.BasePath
        ?? L["MarkdownViewer:Navbar:OpenKnowledgeBaseSwitcher"].Value;
}
