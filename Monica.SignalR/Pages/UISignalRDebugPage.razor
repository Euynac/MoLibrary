@attribute [Route(PAGE_URL)]
@using Monica.SignalR.UISignalR.Components
@using Monica.SignalR.UISignalR.Models
@using Monica.SignalR.UISignalR.State
@inject ISnackbar SnackBar
@inject NavigationManager NavigationManager
@inject SignalRDebugPageStateFactory PageStateFactory
@inject IStringLocalizer<SignalRResource> L
@implements IAsyncDisposable

<PageTitle>@L["Pages:SignalRDebug:Title"]</PageTitle>

<div class="signalr-debug-page">
    <header class="signalr-lab-header">
        <div class="signalr-lab-header__identity">
            <span class="signalr-lab-header__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Hub" /></span>
            <div class="signalr-lab-header__copy">
                <MudText Typo="Typo.overline" Class="signalr-eyebrow">@L["Pages:SignalRDebug:Eyebrow"]</MudText>
                <MudText Typo="Typo.h4">@L["Pages:SignalRDebug:Heading"]</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Pages:SignalRDebug:Subtitle"]</MudText>
            </div>
        </div>

        <div class="signalr-lab-header__evidence" aria-label="@L["Pages:SignalRDebug:Summary:AriaLabel"]">
            <MudChip T="string" Size="Size.Small" Color="@GetConnectionStatusColor()" Icon="@GetConnectionStatusIcon()">@GetConnectionStatusText()</MudChip>
            <span><strong>@PageState.AvailableHubs.Count</strong>@L["Pages:SignalRDebug:Summary:Hubs"]</span>
            <span><strong>@PageState.ConnectedUsers.Count</strong>@L["Pages:SignalRDebug:Summary:Users"]</span>
            <span><strong>@PageState.ConnectionState.TotalReceivedMessages</strong>@L["Pages:SignalRDebug:Summary:Received"]</span>
        </div>
    </header>

    <main class="signalr-lab-workspace">
        <section class="signalr-connection-deck" aria-label="@L["Pages:SignalRDebug:Sections:Connection"]">
            <div class="signalr-panel signalr-panel--connection">
                <SignalRConnectionConfig AccessToken="@PageState.AccessToken"
                                         AccessTokenChanged="@((string value) => PageState.AccessToken = value)"
                                         SelectedHubRoute="@PageState.SelectedHubRoute"
                                         SelectedHubRouteChanged="@((string value) => PageState.SelectedHubRoute = value)"
                                         AvailableHubs="@PageState.AvailableHubs"
                                         IsConnecting="@PageState.ConnectionState.IsConnecting"
                                         IsConnected="@PageState.ConnectionState.IsConnected"
                                         CanGenerateTestToken="@PageState.CanGenerateTestToken"
                                         OnConnect="ConnectAsync"
                                         OnTestUserConnect="TestUserConnectAsync"
                                         OnDisconnect="DisconnectAsync"
                                         OnRefreshHubs="LoadHubsAsync" />
            </div>

            <aside class="signalr-status-rail">
                <div class="signalr-panel signalr-panel--status">
                    <SignalRConnectionStatus ConnectionState="@PageState.ConnectionState" SelectedHubRoute="@PageState.SelectedHubRoute" IsServerSideAnonymous="@PageState.IsServerSideAnonymous" />
                </div>

                <MudPaper Class="signalr-settings" Elevation="0">
                    <div class="signalr-settings__identity">
                        <MudIcon Icon="@Icons.Material.Outlined.Tune" Color="Color.Primary" />
                        <div><MudText Typo="Typo.overline" Class="signalr-eyebrow">@L["Pages:SignalRDebug:Settings:Eyebrow"]</MudText><MudText Typo="Typo.subtitle1">@L["Pages:SignalRDebug:Settings:Title"]</MudText></div>
                    </div>
                    <MudSwitch T="bool" @bind-Value="PageState.VerboseLogging" Label="@L["Pages:SignalRDebug:Settings:VerboseLogging"]" Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Pages:SignalRDebug:Settings:VerboseLoggingHelper"]</MudText>
                </MudPaper>
            </aside>
        </section>

        <section class="signalr-grid signalr-grid--telemetry" aria-label="@L["Pages:SignalRDebug:Sections:Telemetry"]">
            <div class="signalr-panel"><SignalRConnectedUsers ConnectedUsers="@PageState.ConnectedUsers" OnRefreshClicked="LoadConnectedUsersAsync" /></div>
            <div class="signalr-panel"><SignalRSendDiagnostics Snapshot="@PageState.SendDiagnostics" OnRefreshClicked="LoadSendDiagnosticsAsync" /></div>
        </section>

        <section class="signalr-grid signalr-grid--methods" aria-label="@L["Pages:SignalRDebug:Sections:Methods"]">
            <div class="signalr-panel">
                <SignalRMethodListener HubMethods="@PageState.HubMethods" IsConnected="@PageState.ConnectionState.IsConnected" OnToggleMethodListener="ToggleMethodListenerAsync" OnEnableAllListeners="EnableAllListenersAsync" OnDisableAllListeners="DisableAllListenersAsync" />
            </div>
            <div class="signalr-panel">
                <SignalRMethodInvoker HubMethods="@PageState.HubMethods" IsConnected="@PageState.ConnectionState.IsConnected" SelectedMethodName="@PageState.SelectedMethodName" SelectedMethodNameChanged="PageState.SelectMethod" MethodParameters="@PageState.MethodParameters" OnInvokeMethod="InvokeMethodAsync" />
            </div>
        </section>

        <section class="signalr-grid signalr-grid--messages" aria-label="@L["Pages:SignalRDebug:Sections:Messages"]">
            <div class="signalr-panel">
                <SignalRMessageSender UserName="@PageState.UserName" UserNameChanged="@((string value) => PageState.UserName = value)" Message="@PageState.Message" MessageChanged="@((string value) => PageState.Message = value)" IsConnected="@PageState.ConnectionState.IsConnected" OnSendMessage="SendMessageAsync" />
            </div>
            <div class="signalr-panel"><SignalRMessageLog Messages="@PageState.Messages" OnClearMessages="ClearMessages" /></div>
        </section>
    </main>
</div>

@code {
    /// <summary>
    /// The route used by the SignalR debug page.
    /// </summary>
    public const string PAGE_URL = "/signalr-debug";
    private SignalRDebugPageState PageState { get; set; } = null!;
    private bool _disposed;

    /// <inheritdoc />
    protected override void OnInitialized() => PageState = PageStateFactory.Create();

    /// <summary>
    /// Initializes the page state after the first render.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        PageState.StateChanged += OnStateChanged;
        await PageState.InitializeAsync();
    }

    /// <summary>
    /// Loads hub metadata for the debug page.
    /// </summary>
    private async Task LoadHubsAsync()
    {
        var success = await PageState.LoadHubsAsync();
        if (!success)
        {
            SnackBar.Add(L["Pages:SignalRDebug:Notifications:LoadHubsFailed"].Value, Severity.Error);
        }
    }

    /// <summary>
    /// Loads connected user information for the debug page.
    /// </summary>
    private async Task LoadConnectedUsersAsync()
    {
        var success = await PageState.LoadConnectedUsersAsync();
        SnackBar.Add(
            success
                ? L["Pages:SignalRDebug:Notifications:LoadConnectedUsersSuccess"].Value
                : L["Pages:SignalRDebug:Notifications:LoadConnectedUsersFailed"].Value,
            success ? Severity.Success : Severity.Error);
    }

    /// <summary>
    /// Loads SignalR send diagnostics for the debug page.
    /// </summary>
    private async Task LoadSendDiagnosticsAsync()
    {
        var success = await PageState.LoadSendDiagnosticsAsync();
        SnackBar.Add(
            success
                ? L["Pages:SignalRDebug:Notifications:LoadSendDiagnosticsSuccess"].Value
                : L["Pages:SignalRDebug:Notifications:LoadSendDiagnosticsFailed"].Value,
            success ? Severity.Success : Severity.Error);
    }

    /// <summary>
    /// Connects the browser debug client to the selected hub.
    /// </summary>
    private async Task ConnectAsync()
    {
        var success = await PageState.ConnectAsync(NavigationManager.BaseUri);
        SnackBar.Add(
            success
                ? L["Pages:SignalRDebug:Notifications:ConnectSuccess"].Value
                : L["Pages:SignalRDebug:Notifications:ConnectFailed"].Value,
            success ? Severity.Success : Severity.Error);
    }

    /// <summary>
    /// Mints a random test-user token, fills the token field, and connects with it.
    /// </summary>
    private async Task TestUserConnectAsync()
    {
        if (!PageState.CanGenerateTestToken)
        {
            SnackBar.Add(L["Pages:SignalRDebug:Notifications:TestTokenUnavailable"].Value, Severity.Warning);
            return;
        }

        var success = await PageState.TestUserConnectAsync(NavigationManager.BaseUri);
        SnackBar.Add(
            success
                ? L["Pages:SignalRDebug:Notifications:TestUserConnectSuccess", PageState.LastTestUserName ?? string.Empty].Value
                : L["Pages:SignalRDebug:Notifications:ConnectFailed"].Value,
            success ? Severity.Success : Severity.Error);
    }

    /// <summary>
    /// Disconnects the browser debug client.
    /// </summary>
    private async Task DisconnectAsync()
    {
        var success = await PageState.DisconnectAsync();
        SnackBar.Add(
            success
                ? L["Pages:SignalRDebug:Notifications:DisconnectSuccess"].Value
                : L["Pages:SignalRDebug:Notifications:DisconnectFailed"].Value,
            success ? Severity.Info : Severity.Error);
    }

    /// <summary>
    /// Sends the quick message entered on the page.
    /// </summary>
    private async Task SendMessageAsync((string userName, string message) _)
    {
        var success = await PageState.SendMessageAsync();
        if (!success)
        {
            SnackBar.Add(L["Pages:SignalRDebug:Notifications:SendMessageFailed"].Value, Severity.Error);
        }
    }

    /// <summary>
    /// Invokes the currently selected hub method.
    /// </summary>
    private async Task InvokeMethodAsync((string methodName, List<MethodCallParameter> parameters) _)
    {
        var success = await PageState.InvokeSelectedMethodAsync();
        SnackBar.Add(
            success
                ? L["Pages:SignalRDebug:Notifications:InvokeMethodSuccess", PageState.SelectedMethodName].Value
                : L["Pages:SignalRDebug:Notifications:InvokeMethodFailed", PageState.SelectedMethodName].Value,
            success ? Severity.Success : Severity.Error);
    }

    /// <summary>
    /// Toggles a method listener.
    /// </summary>
    private async Task ToggleMethodListenerAsync((HubMethodInfo method, bool isListening) data)
    {
        var success = await PageState.ToggleMethodListenerAsync(data.method, data.isListening);
        if (!success)
        {
            data.method.IsListening = !data.isListening;
            SnackBar.Add(L["Pages:SignalRDebug:Notifications:ToggleListenerFailed"].Value, Severity.Error);
        }
    }

    /// <summary>
    /// Enables all method listeners.
    /// </summary>
    private async Task EnableAllListenersAsync()
    {
        var successCount = await PageState.EnableAllListenersAsync();
        SnackBar.Add(L["Pages:SignalRDebug:Notifications:EnableListenersSuccess", successCount].Value, Severity.Success);
    }

    /// <summary>
    /// Disables all method listeners.
    /// </summary>
    private async Task DisableAllListenersAsync()
    {
        var successCount = await PageState.DisableAllListenersAsync();
        SnackBar.Add(L["Pages:SignalRDebug:Notifications:DisableListenersSuccess", successCount].Value, Severity.Success);
    }

    /// <summary>
    /// Clears the page log.
    /// </summary>
    private void ClearMessages()
    {
        PageState.ClearMessages();
    }

    private Color GetConnectionStatusColor() => PageState.ConnectionState.Status switch
    {
        "Connected" => Color.Success,
        "Connecting" or "Reconnecting" => Color.Warning,
        "Disconnected" => Color.Default,
        _ => Color.Error
    };

    private string GetConnectionStatusIcon() => PageState.ConnectionState.Status switch
    {
        "Connected" => Icons.Material.Filled.Wifi,
        "Connecting" or "Reconnecting" => Icons.Material.Filled.Sync,
        _ => Icons.Material.Filled.WifiOff
    };

    private string GetConnectionStatusText() => PageState.ConnectionState.Status switch
    {
        "Connected" => L["UISignalR:Common:Status:Connected"],
        "Connecting" => L["UISignalR:Common:Status:Connecting"],
        "Reconnecting" => L["UISignalR:Common:Status:Reconnecting"],
        "Disconnecting" => L["UISignalR:Common:Status:Disconnecting"],
        "Disconnected" => L["UISignalR:Common:Status:Disconnected"],
        _ => L["UISignalR:Common:Status:Unknown"]
    };

    /// <summary>
    /// Re-renders the page when the state object changes.
    /// </summary>
    private void OnStateChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Releases page subscriptions and browser interop resources.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        PageState.StateChanged -= OnStateChanged;
        await PageState.DisposeAsync();
    }
}
