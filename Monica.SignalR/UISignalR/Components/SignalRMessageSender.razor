@inject IStringLocalizer<SignalRResource> L

<MudPaper Class="signalr-message-sender" Elevation="0">
    <div class="signalr-component-heading"><MudIcon Icon="@Icons.Material.Outlined.Send" Color="Color.Success" /><MudText Typo="Typo.h6">@L["UISignalR:MessageSender:Title"]</MudText></div>
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField Value="@UserName"
                        ValueChanged="@((string value) => OnUserNameChangedInternal(value))"
                        Label="@L["UISignalR:MessageSender:UserNameLabel"]" 
                        Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField Value="@Message"
                        ValueChanged="@((string value) => OnMessageChangedInternal(value))"
                        Label="@L["UISignalR:MessageSender:MessageLabel"]" 
                        Variant="Variant.Outlined"
                        OnKeyDown="OnMessageKeyDown" />
        </MudItem>
        <MudItem xs="12">
            <MudStack Row Spacing="2">
                <MudButton Variant="Variant.Filled" 
                         Color="Color.Success" 
                         OnClick="SendMessageAsync"
                         Disabled="!IsConnected || string.IsNullOrWhiteSpace(Message)">
                    <MudIcon Icon="@Icons.Material.Filled.Send" />
                    <MudText Class="ms-2">@L["UISignalR:MessageSender:Send"]</MudText>
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                         Color="Color.Secondary" 
                         OnClick="ClearMessageAsync"
                         Disabled="string.IsNullOrWhiteSpace(Message)">
                    <MudIcon Icon="@Icons.Material.Filled.Clear" />
                    <MudText Class="ms-2">@L["UISignalR:MessageSender:Clear"]</MudText>
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    /// <summary>
    /// username
    /// </summary>
    [Parameter] public string UserName { get; set; } = "";

    /// <summary>
    /// Username change callback
    /// </summary>
    [Parameter] public EventCallback<string> UserNameChanged { get; set; }

    /// <summary>
    /// Message content
    /// </summary>
    [Parameter] public string Message { get; set; } = "";

    /// <summary>
    /// Message content change callback
    /// </summary>
    [Parameter] public EventCallback<string> MessageChanged { get; set; }

    /// <summary>
    /// Is it connected?
    /// </summary>
    [Parameter] public bool IsConnected { get; set; }

    /// <summary>
    /// Send message callback
    /// </summary>
    [Parameter] public EventCallback<(string userName, string message)> OnSendMessage { get; set; }

    /// <summary>
    /// Message input box keyboard event
    /// </summary>
    /// <param name="e">Keyboard event parameters</param>
    private async Task OnMessageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    /// <summary>
    /// Send message
    /// </summary>
    private async Task SendMessageAsync()
    {
        if (!IsConnected || string.IsNullOrWhiteSpace(Message))
            return;

        await OnSendMessage.InvokeAsync((UserName, Message));
        
        // After successful sending, the input box will not be cleared and the content entered by the user will be retained.
        // If the user needs to clear it, they can click the "Clear" button
    }

    /// <summary>
    /// Clear the message input box
    /// </summary>
    private async Task ClearMessageAsync()
    {
        Message = "";
        await MessageChanged.InvokeAsync(Message);
        StateHasChanged();
    }

    private void OnUserNameChangedInternal(string value)
    {
        UserName = value;
        UserNameChanged.InvokeAsync(value);
    }

    private void OnMessageChangedInternal(string value)
    {
        Message = value;
        MessageChanged.InvokeAsync(value);
    }
}
