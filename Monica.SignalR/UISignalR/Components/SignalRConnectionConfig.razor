@using Monica.SignalR.Models
@inject IStringLocalizer<SignalRResource> L

<MudPaper Class="signalr-connection-config" Elevation="0">
    <div class="signalr-component-heading">
        <MudIcon Icon="@Icons.Material.Outlined.Cable" Color="Color.Primary" />
        <MudText Typo="Typo.h6">@L["UISignalR:ConnectionConfig:Title"]</MudText>
    </div>
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField T="string"
                        Value="@AccessToken"
                        ValueChanged="@((string value) => OnAccessTokenChangedInternal(value))"
                        Label="@L["UISignalR:ConnectionConfig:AccessTokenLabel"]"
                        Variant="Variant.Outlined"
                        HelperText="@L["UISignalR:ConnectionConfig:AccessTokenHelper"]" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="string"
                     Value="@SelectedHubRoute"
                     ValueChanged="@((string value) => OnSelectedHubRouteChangedInternal(value))"
                     Label="@L["UISignalR:ConnectionConfig:HubUrlLabel"]"
                     Variant="Variant.Outlined"
                     HelperText="@L["UISignalR:ConnectionConfig:HubUrlHelper"]">
                @foreach (var hub in AvailableHubs)
                {
                    <MudSelectItem Value="@hub.Route">@hub.HubName (@hub.Route)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" Class="signalr-connection-actions">
            <MudButton Variant="Variant.Filled"
                     Color="Color.Primary"
                     OnClick="ConnectAsync"
                     Disabled="IsConnecting || string.IsNullOrEmpty(SelectedHubRoute)">
                @if (IsConnecting)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">@L["UISignalR:ConnectionConfig:Connecting"]</MudText>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Cable" />
                    <MudText Class="ms-2">
                        @(IsConnected
                            ? L["UISignalR:ConnectionConfig:Reconnect"]
                            : L["UISignalR:ConnectionConfig:Connect"])
                    </MudText>
                }
            </MudButton>
            @if (CanGenerateTestToken)
            {
                <MudTooltip Text="@L["UISignalR:ConnectionConfig:TestUserConnectHelper"]">
                    <MudButton Variant="Variant.Outlined"
                             Color="Color.Tertiary"
                             OnClick="TestUserConnectAsync"
                             Disabled="IsConnecting || string.IsNullOrEmpty(SelectedHubRoute)"
                             Class="ms-2">
                        <MudIcon Icon="@Icons.Material.Filled.Science" />
                        <MudText Class="ms-2">@L["UISignalR:ConnectionConfig:TestUserConnect"]</MudText>
                    </MudButton>
                </MudTooltip>
            }
            <MudButton Variant="Variant.Outlined"
                     Color="Color.Secondary"
                     OnClick="DisconnectAsync"
                     Disabled="!IsConnected"
                     Class="ms-2">
                <MudIcon Icon="@Icons.Material.Filled.PowerOff" />
                <MudText Class="ms-2">@L["UISignalR:ConnectionConfig:Disconnect"]</MudText>
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                     Color="Color.Info"
                     OnClick="RefreshHubsAsync"
                     Class="ms-2">
                <MudIcon Icon="@Icons.Material.Filled.Refresh" />
                <MudText Class="ms-2">@L["UISignalR:ConnectionConfig:RefreshHubInfo"]</MudText>
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    /// <summary>
    /// access token
    /// </summary>
    [Parameter] public string AccessToken { get; set; } = "";

    /// <summary>
    /// Access token change callback
    /// </summary>
    [Parameter] public EventCallback<string> AccessTokenChanged { get; set; }

    /// <summary>
    /// Selected Hub route
    /// </summary>
    [Parameter] public string SelectedHubRoute { get; set; } = "";

    /// <summary>
    /// Selected Hub routing change callback
    /// </summary>
    [Parameter] public EventCallback<string> SelectedHubRouteChanged { get; set; }

    /// <summary>
    /// Available Hub List
    /// </summary>
    [Parameter] public List<SignalRHubInfo> AvailableHubs { get; set; } = [];

    /// <summary>
    /// Is connecting
    /// </summary>
    [Parameter] public bool IsConnecting { get; set; }

    /// <summary>
    /// Is it connected?
    /// </summary>
    [Parameter] public bool IsConnected { get; set; }

    /// <summary>
    /// Whether the host allows generating a random test-user token for local debugging.
    /// </summary>
    [Parameter] public bool CanGenerateTestToken { get; set; }

    /// <summary>
    /// Connection callback
    /// </summary>
    [Parameter] public EventCallback OnConnect { get; set; }

    /// <summary>
    /// Test-user connection callback that generates a random token first and then connects
    /// </summary>
    [Parameter] public EventCallback OnTestUserConnect { get; set; }

    /// <summary>
    /// Disconnect callback
    /// </summary>
    [Parameter] public EventCallback OnDisconnect { get; set; }

    /// <summary>
    /// Refresh Hub information callback
    /// </summary>
    [Parameter] public EventCallback OnRefreshHubs { get; set; }

    /// <summary>
    /// Connection asynchronous
    /// </summary>
    private async Task ConnectAsync()
    {
        await OnConnect.InvokeAsync();
    }

    /// <summary>
    /// Generates a random test-user token, fills the token field, and connects.
    /// </summary>
    private async Task TestUserConnectAsync()
    {
        await OnTestUserConnect.InvokeAsync();
    }

    /// <summary>
    /// Disconnect async
    /// </summary>
    private async Task DisconnectAsync()
    {
        await OnDisconnect.InvokeAsync();
    }

    /// <summary>
    /// Refresh Hub information asynchronously
    /// </summary>
    private async Task RefreshHubsAsync()
    {
        await OnRefreshHubs.InvokeAsync();
    }

    private void OnAccessTokenChangedInternal(string value)
    {
        AccessToken = value;
        AccessTokenChanged.InvokeAsync(value);
    }

    private void OnSelectedHubRouteChangedInternal(string value)
    {
        SelectedHubRoute = value;
        SelectedHubRouteChanged.InvokeAsync(value);
    }
}
