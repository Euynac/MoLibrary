@using Monica.SignalR.Models
@inject IStringLocalizer<SignalRResource> L

<MudPaper Class="signalr-send-diagnostics" Elevation="0">
    <div class="signalr-component-header">
        <div class="signalr-component-heading"><MudIcon Icon="@Icons.Material.Outlined.MonitorHeart" Color="Color.Success" /><MudText Typo="Typo.h6">@L["UISignalR:SendDiagnostics:Title"]</MudText></div>
        <MudButton OnClick="OnRefreshClicked"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Variant="Variant.Outlined">
            @L["UISignalR:SendDiagnostics:Refresh"]
        </MudButton>
    </div>

    @if (Snapshot is null)
    {
        <MudAlert Severity="Severity.Info">@L["UISignalR:SendDiagnostics:NotLoaded"]</MudAlert>
    }
    else if (!Snapshot.IsEnabled)
    {
        <MudAlert Severity="Severity.Warning">@L["UISignalR:SendDiagnostics:Disabled"]</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="d-block mb-3 mud-text-secondary">
            @Snapshot.Description
        </MudText>

        <MudGrid Class="mb-3">
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption">@L["UISignalR:SendDiagnostics:Summary:Pending"]</MudText>
                <MudText Typo="Typo.h6">@Snapshot.PendingSendCount</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption">@L["UISignalR:SendDiagnostics:Summary:Started"]</MudText>
                <MudText Typo="Typo.h6">@Snapshot.TotalStartedCount</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption">@L["UISignalR:SendDiagnostics:Summary:Completed"]</MudText>
                <MudText Typo="Typo.h6">@Snapshot.TotalCompletedCount</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption">@L["UISignalR:SendDiagnostics:Summary:Failed"]</MudText>
                <MudText Typo="Typo.h6">@Snapshot.TotalFailedCount</MudText>
            </MudItem>
        </MudGrid>

        @if (TopMethodMetrics.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L["UISignalR:SendDiagnostics:Empty"]</MudAlert>
        }
        else
        {
            <MudTable Items="@TopMethodMetrics"
                      Dense="true"
                      Hover="true"
                      Breakpoint="Breakpoint.Sm"
                      T="SignalRSendMethodMetricInfo">
                <HeaderContent>
                    <MudTh>@L["UISignalR:SendDiagnostics:Columns:Method"]</MudTh>
                    <MudTh>@L["UISignalR:SendDiagnostics:Columns:TargetBreakdown"]</MudTh>
                    <MudTh>@L["UISignalR:SendDiagnostics:Columns:Pending"]</MudTh>
                    <MudTh>@L["UISignalR:SendDiagnostics:Columns:Started"]</MudTh>
                    <MudTh>@L["UISignalR:SendDiagnostics:Columns:Failed"]</MudTh>
                    <MudTh>@L["UISignalR:SendDiagnostics:Columns:LastDuration"]</MudTh>
                    <MudTh>@L["UISignalR:SendDiagnostics:Columns:MaxDuration"]</MudTh>
                    <MudTh>@L["UISignalR:SendDiagnostics:Columns:AverageDuration"]</MudTh>
                </HeaderContent>
                <RowTemplate Context="methodMetric">
                    <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Method"]">
                        <MudText Typo="Typo.body2">@FormatMethod(methodMetric)</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:TargetBreakdown"]">
                        <div class="d-flex align-center">
                            <MudTooltip Text="@GetDetailsToggleLabel(methodMetric)">
                                <MudIconButton Icon="@GetDetailsToggleIcon(methodMetric)"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => ToggleMethodDetails(methodMetric))" />
                            </MudTooltip>
                            <MudText Typo="Typo.body2">@methodMetric.TargetMetricCount</MudText>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Pending"]">
                        <MudText Typo="Typo.body2">@methodMetric.PendingSendCount</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Started"]">
                        <MudText Typo="Typo.body2">@methodMetric.StartedCount</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Failed"]">
                        <MudText Typo="Typo.body2">@methodMetric.FailedCount</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:LastDuration"]">
                        <MudText Typo="Typo.body2">@FormatDuration(methodMetric.LastDurationMilliseconds)</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:MaxDuration"]">
                        <MudText Typo="Typo.body2">@FormatDuration(methodMetric.MaxDurationMilliseconds)</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:AverageDuration"]">
                        <MudText Typo="Typo.body2">@FormatDuration(methodMetric.AverageDurationMilliseconds)</MudText>
                    </MudTd>
                </RowTemplate>
                <ChildRowContent Context="methodMetric">
                    @if (IsMethodExpanded(methodMetric) && methodMetric.TargetMetrics.Count > 0)
                    {
                        <MudTr>
                            <td colspan="8" class="mud-table-cell">
                                <MudTable Items="@methodMetric.TargetMetrics"
                                          Dense="true"
                                          Hover="true"
                                          Breakpoint="Breakpoint.Sm"
                                          T="SignalRSendMetricInfo">
                                    <HeaderContent>
                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:Target"]</MudTh>
                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:Pending"]</MudTh>
                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:Started"]</MudTh>
                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:Failed"]</MudTh>
                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:LastDuration"]</MudTh>
                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:MaxDuration"]</MudTh>
                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:AverageDuration"]</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="targetMetric">
                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Target"]">
                                            @if (IsUserIdentifierTarget(targetMetric))
                                            {
                                                <span class="signalr-target-users">
                                                    @GetUserTargetLabel(targetMetric)
                                                    @for (var index = 0; index < targetMetric.TargetIdentifiers.Count; index++)
                                                    {
                                                        var identifier = targetMetric.TargetIdentifiers[index];
                                                        var displayName = targetMetric.TargetIdentifierDisplayNames.ElementAtOrDefault(index);
                                                        if (index > 0)
                                                        {
                                                            <text>, </text>
                                                        }
                                                        if (string.IsNullOrEmpty(displayName))
                                                        {
                                                            <span class="signalr-target-identifier">@identifier</span>
                                                        }
                                                        else
                                                        {
                                                            <MudTooltip Text="@identifier">
                                                                <span class="signalr-target-username">@displayName</span>
                                                            </MudTooltip>
                                                        }
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2">@FormatTarget(targetMetric)</MudText>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Pending"]">
                                            <MudText Typo="Typo.body2">@targetMetric.PendingSendCount</MudText>
                                        </MudTd>
                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Started"]">
                                            <MudText Typo="Typo.body2">@targetMetric.StartedCount</MudText>
                                        </MudTd>
                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Failed"]">
                                            <MudText Typo="Typo.body2">@targetMetric.FailedCount</MudText>
                                        </MudTd>
                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:LastDuration"]">
                                            <MudText Typo="Typo.body2">@FormatDuration(targetMetric.LastDurationMilliseconds)</MudText>
                                        </MudTd>
                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:MaxDuration"]">
                                            <MudText Typo="Typo.body2">@FormatDuration(targetMetric.MaxDurationMilliseconds)</MudText>
                                        </MudTd>
                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:AverageDuration"]">
                                            <MudText Typo="Typo.body2">@FormatDuration(targetMetric.AverageDurationMilliseconds)</MudText>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        }
    }
</MudPaper>

@code {
    /// <summary>
    /// Gets or sets the latest SignalR send diagnostics snapshot.
    /// </summary>
    [Parameter] public SignalRSendDiagnosticsSnapshot? Snapshot { get; set; }

    /// <summary>
    /// Gets or sets the refresh callback.
    /// </summary>
    [Parameter] public EventCallback OnRefreshClicked { get; set; }

    private readonly HashSet<string> _expandedMethodKeys = new(StringComparer.Ordinal);

    private IReadOnlyList<SignalRSendMethodMetricInfo> TopMethodMetrics => Snapshot?.MethodMetrics
        .OrderByDescending(metric => metric.PendingSendCount)
        .ThenByDescending(metric => metric.MaxDurationMilliseconds)
        .Take(10)
        .ToList() ?? [];

    private static string FormatDuration(double milliseconds)
    {
        return $"{milliseconds:0.###} ms";
    }

    private static string FormatMethod(SignalRSendMethodMetricInfo metric)
    {
        return $"{metric.HubName}.{metric.MethodName}";
    }

    private string GetDetailsToggleIcon(SignalRSendMethodMetricInfo metric)
    {
        return IsMethodExpanded(metric)
            ? Icons.Material.Filled.ExpandLess
            : Icons.Material.Filled.ExpandMore;
    }

    private string GetDetailsToggleLabel(SignalRSendMethodMetricInfo metric)
    {
        return IsMethodExpanded(metric)
            ? L["UISignalR:SendDiagnostics:Details:Collapse"].Value
            : L["UISignalR:SendDiagnostics:Details:Expand"].Value;
    }

    private bool IsMethodExpanded(SignalRSendMethodMetricInfo metric)
    {
        return _expandedMethodKeys.Contains(CreateMethodKey(metric));
    }

    private void ToggleMethodDetails(SignalRSendMethodMetricInfo metric)
    {
        var key = CreateMethodKey(metric);
        if (!_expandedMethodKeys.Add(key))
        {
            _expandedMethodKeys.Remove(key);
        }
    }

    private static string CreateMethodKey(SignalRSendMethodMetricInfo metric)
    {
        return $"{metric.HubName}\u001f{metric.MethodName}";
    }

    private string FormatTarget(SignalRSendMetricInfo metric)
    {
        return metric.TargetKind switch
        {
            SignalRSendTargetKind.All => L["UISignalR:SendDiagnostics:Targets:AllClients"].Value,
            SignalRSendTargetKind.AllExcept => FormatIdentifierTarget(
                "UISignalR:SendDiagnostics:Targets:AllExceptIdentifiers",
                "UISignalR:SendDiagnostics:Targets:AllExceptCount",
                metric),
            SignalRSendTargetKind.Client => FormatIdentifierTarget(
                "UISignalR:SendDiagnostics:Targets:ClientIdentifiers",
                "UISignalR:SendDiagnostics:Targets:ClientCount",
                metric),
            SignalRSendTargetKind.Clients => FormatIdentifierTarget(
                "UISignalR:SendDiagnostics:Targets:ClientsIdentifiers",
                "UISignalR:SendDiagnostics:Targets:ClientsCount",
                metric),
            SignalRSendTargetKind.Group => FormatIdentifierTarget(
                "UISignalR:SendDiagnostics:Targets:GroupIdentifiers",
                "UISignalR:SendDiagnostics:Targets:GroupCount",
                metric),
            SignalRSendTargetKind.Groups => FormatIdentifierTarget(
                "UISignalR:SendDiagnostics:Targets:GroupsIdentifiers",
                "UISignalR:SendDiagnostics:Targets:GroupsCount",
                metric),
            SignalRSendTargetKind.GroupExcept => FormatIdentifierTarget(
                "UISignalR:SendDiagnostics:Targets:GroupExceptIdentifiers",
                "UISignalR:SendDiagnostics:Targets:GroupExceptCount",
                metric),
            // User targets with captured identifiers render through the username-first tooltip markup instead.
            SignalRSendTargetKind.User => L["UISignalR:SendDiagnostics:Targets:UserCount", metric.TargetCount].Value,
            SignalRSendTargetKind.Users => L["UISignalR:SendDiagnostics:Targets:UsersCount", metric.TargetCount].Value,
            _ => FormatIdentifierTarget(
                "UISignalR:SendDiagnostics:Targets:UnknownIdentifiers",
                "UISignalR:SendDiagnostics:Targets:UnknownCount",
                metric)
        };
    }

    /// <summary>
    /// Whether the metric is a user target with captured identifiers that can render username-first.
    /// </summary>
    private static bool IsUserIdentifierTarget(SignalRSendMetricInfo metric)
    {
        return metric.TargetKind is SignalRSendTargetKind.User or SignalRSendTargetKind.Users
               && metric.TargetIdentifiers.Count > 0;
    }

    private string GetUserTargetLabel(SignalRSendMetricInfo metric)
    {
        return metric.TargetKind == SignalRSendTargetKind.User
            ? L["UISignalR:SendDiagnostics:Targets:UserTargetLabel"].Value
            : L["UISignalR:SendDiagnostics:Targets:UsersTargetLabel"].Value;
    }

    private string FormatIdentifierTarget(
        string identifiersKey,
        string countKey,
        SignalRSendMetricInfo metric)
    {
        if (metric.TargetIdentifiers.Count > 0)
        {
            return L[identifiersKey, string.Join(", ", metric.TargetIdentifiers)].Value;
        }

        return L[countKey, metric.TargetCount].Value;
    }
}
