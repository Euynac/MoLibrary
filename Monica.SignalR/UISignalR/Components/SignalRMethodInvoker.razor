@using Monica.SignalR.UISignalR.Models
@inject IStringLocalizer<SignalRResource> L

<!-- method call -->
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h5" Class="mb-3">@L["UISignalR:MethodInvoker:Title"]</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudSelect Value="@SelectedMethodName"
                     ValueChanged="@((string value) => OnSelectedMethodNameChangedInternal(value))"
                     Label="@L["UISignalR:MethodInvoker:MethodLabel"]" 
                     Variant="Variant.Outlined"
                     T="string">
                @foreach (var method in HubMethods)
                {
                    <MudSelectItem Value="@method.Name">@method.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12">
            @if (SelectedMethod != null && SelectedMethod.Args.Any())
            {
                <MudText Typo="Typo.h6" Class="mb-2">@L["UISignalR:MethodInvoker:ParametersTitle"]</MudText>
                @foreach (var arg in SelectedMethod.Args)
                {
                    var value = GetParameterValue(arg.Name);
                    var isValid = ValidateParameterValue(value, arg.TypeName);
                    
                    <MudTextField Value="@value" 
                                Label="@L["UISignalR:MethodInvoker:ParameterLabel", arg.Name, GetDisplayType(arg.TypeName)]" 
                                Variant="Variant.Outlined"
                                Class="mb-2"
                                HelperText="@GetParameterHelperText(arg.TypeName)"
                                Error="@(!isValid && !string.IsNullOrEmpty(value))"
                                ErrorText="@(isValid ? "" : GetParameterErrorText(value, arg.TypeName))"
                                ValueChanged="@((string newValue) => SetParameterValue(arg.Name, newValue))" />
                }
            }
            else if (SelectedMethod != null)
            {
                <MudAlert Severity="Severity.Info">@L["UISignalR:MethodInvoker:NoParameters"]</MudAlert>
            }
        </MudItem>
        <MudItem xs="12">
            <MudStack Row Spacing="2">
                <MudButton Variant="Variant.Filled" 
                         Color="Color.Primary" 
                         OnClick="InvokeMethodAsync"
                         Disabled="!IsConnected || string.IsNullOrWhiteSpace(SelectedMethodName) || !AreParametersValid()">
                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                    <MudText Class="ms-2">@L["UISignalR:MethodInvoker:Invoke"]</MudText>
                </MudButton>
                @if (SelectedMethod != null && SelectedMethod.Args.Any())
                {
                    <MudButton Variant="Variant.Outlined" 
                             Color="Color.Secondary" 
                             OnClick="ClearParametersAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Clear" />
                        <MudText Class="ms-2">@L["UISignalR:MethodInvoker:ClearParameters"]</MudText>
                    </MudButton>
                }
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    /// <summary>
    /// Hub method list
    /// </summary>
    [Parameter] public List<HubMethodInfo> HubMethods { get; set; } = [];

    /// <summary>
    /// Is it connected?
    /// </summary>
    [Parameter] public bool IsConnected { get; set; }

    /// <summary>
    /// Selected method name
    /// </summary>
    [Parameter] public string SelectedMethodName { get; set; } = "";

    /// <summary>
    /// Selected method name change callback
    /// </summary>
    [Parameter] public EventCallback<string> SelectedMethodNameChanged { get; set; }

    /// <summary>
    /// method parameters
    /// </summary>
    [Parameter] public Dictionary<string, string> MethodParameters { get; set; } = new();

    /// <summary>
    /// Call method callback
    /// </summary>
    [Parameter] public EventCallback<(string methodName, List<MethodCallParameter> parameters)> OnInvokeMethod { get; set; }

    /// <summary>
    /// Currently selected method
    /// </summary>
    private HubMethodInfo? SelectedMethod => HubMethods.FirstOrDefault(m => m.Name == SelectedMethodName);

    /// <summary>
    /// Safely obtain parameter values
    /// </summary>
    /// <param name="parameterName">Parameter name</param>
    /// <returns>Parameter values</returns>
    private string GetParameterValue(string parameterName)
    {
        return MethodParameters?.GetValueOrDefault(parameterName, "") ?? "";
    }

    /// <summary>
    /// Security setting parameter value
    /// </summary>
    /// <param name="parameterName">Parameter name</param>
    /// <param name="value">Parameter value</param>
    private void SetParameterValue(string parameterName, string value)
    {
        if (MethodParameters != null)
        {
            MethodParameters[parameterName] = value ?? "";
        }
    }

    /// <summary>
    /// Parameter setting change processing
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Make sure the MethodParameters dictionary is not null
        MethodParameters ??= new Dictionary<string, string>();
        
        if (SelectedMethod != null)
        {
            // Make sure the parameter dictionary contains all required parameters
            foreach (var arg in SelectedMethod.Args)
            {
                if (!MethodParameters.ContainsKey(arg.Name))
                {
                    MethodParameters[arg.Name] = "";
                }
            }
        }
        await base.OnParametersSetAsync();
    }

    /// <summary>
    /// Get display type name
    /// </summary>
    /// <param name="type">Parameter type</param>
    /// <returns>Display type name</returns>
    private string GetDisplayType(string type)
    {
        var normalizedType = type.ToLower().Replace("system.", "");
        
        return normalizedType switch
        {
            "string" => "string",
            "int" or "int32" => "int",
            "long" or "int64" => "long",
            "double" => "double",
            "float" or "single" => "float",
            "bool" or "boolean" => "bool",
            "datetime" => "DateTime",
            "guid" => "Guid",
            _ => type
        };
    }

    /// <summary>
    /// Get parameter help text
    /// </summary>
    /// <param name="type">Parameter type</param>
    /// <returns>Help text</returns>
    private string GetParameterHelperText(string type)
    {
        var normalizedType = type.ToLower().Replace("system.", "");
        
        return normalizedType switch
        {
            "string" => L["UISignalR:MethodInvoker:HelperText:String"].Value,
            "int" or "int32" => L["UISignalR:MethodInvoker:HelperText:Int"].Value,
            "long" or "int64" => L["UISignalR:MethodInvoker:HelperText:Long"].Value,
            "double" => L["UISignalR:MethodInvoker:HelperText:Double"].Value,
            "float" or "single" => L["UISignalR:MethodInvoker:HelperText:Float"].Value,
            "bool" or "boolean" => L["UISignalR:MethodInvoker:HelperText:Bool"].Value,
            "datetime" => L["UISignalR:MethodInvoker:HelperText:DateTime"].Value,
            "guid" => L["UISignalR:MethodInvoker:HelperText:Guid"].Value,
            _ when normalizedType.Contains("[]") => L["UISignalR:MethodInvoker:HelperText:Array"].Value,
            _ when normalizedType.Contains("list") => L["UISignalR:MethodInvoker:HelperText:List"].Value,
            _ => L["UISignalR:MethodInvoker:HelperText:Complex", type].Value
        };
    }

    /// <summary>
    /// Get parameter error text
    /// </summary>
    /// <param name="value">Parameter value</param>
    /// <param name="type">Parameter type</param>
    /// <returns>Error text</returns>
    private string GetParameterErrorText(string value, string type)
    {
        if (string.IsNullOrEmpty(value))
        {
            return "";
        }

        var normalizedType = type.ToLower().Replace("system.", "");
        
        return normalizedType switch
        {
            "int" or "int32" => L["UISignalR:MethodInvoker:ErrorText:Int"].Value,
            "long" or "int64" => L["UISignalR:MethodInvoker:ErrorText:Long"].Value,
            "double" => L["UISignalR:MethodInvoker:ErrorText:Double"].Value,
            "float" or "single" => L["UISignalR:MethodInvoker:ErrorText:Float"].Value,
            "bool" or "boolean" => L["UISignalR:MethodInvoker:ErrorText:Bool"].Value,
            "datetime" => L["UISignalR:MethodInvoker:ErrorText:DateTime"].Value,
            "guid" => L["UISignalR:MethodInvoker:ErrorText:Guid"].Value,
            _ => L["UISignalR:MethodInvoker:ErrorText:Invalid"].Value
        };
    }

    /// <summary>
    /// Validate parameter values
    /// </summary>
    /// <param name="value">Parameter value</param>
    /// <param name="type">Parameter type</param>
    /// <returns>Is it valid?</returns>
    private bool ValidateParameterValue(string value, string type)
    {
        if (string.IsNullOrEmpty(value))
        {
            return true; // Allow empty values so the server can apply default handling.
        }

        var normalizedType = type.ToLower().Replace("system.", "");
        
        try
        {
            switch (normalizedType)
            {
                case "string":
                    return true; // String input is always valid.
                case "int" or "int32":
                    return int.TryParse(value, out _);
                case "long" or "int64":
                    return long.TryParse(value, out _);
                case "double":
                    return double.TryParse(value, out _);
                case "float" or "single":
                    return float.TryParse(value, out _);
                case "bool" or "boolean":
                    var trimmed = value.ToLower().Trim();
                    return trimmed == "true" || trimmed == "false" || 
                           trimmed == "1" || trimmed == "0" || 
                           trimmed == "yes" || trimmed == "no" || 
                           trimmed == "y" || trimmed == "n";
                case "datetime":
                    return DateTime.TryParse(value, out _);
                case "guid":
                    return Guid.TryParse(value, out _);
                default:
                    // For complex types, treat JSON-shaped input as structured data.
                    if (value.Trim().StartsWith("{") || value.Trim().StartsWith("["))
                    {
                        try
                        {
                            System.Text.Json.JsonDocument.Parse(value);
                            return true;
                        }
                        catch
                        {
                            return false;
                        }
                    }
                    return true; // Otherwise keep the raw text and let the server validate it.
            }
        }
        catch
        {
            return false;
        }
    }

    /// <summary>
    /// ArgumentGuard if all parameters are valid
    /// </summary>
    /// <returns>Are all parameters valid</returns>
    private bool AreParametersValid()
    {
        if (SelectedMethod == null) return true;

        return SelectedMethod.Args.All(arg => 
        {
            var value = GetParameterValue(arg.Name);
            return ValidateParameterValue(value, arg.TypeName);
        });
    }

    /// <summary>
    /// Clear all parameters
    /// </summary>
    private Task ClearParametersAsync()
    {
        if (SelectedMethod != null)
        {
            foreach (var arg in SelectedMethod.Args)
            {
                MethodParameters[arg.Name] = "";
            }
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// call method
    /// </summary>
    private async Task InvokeMethodAsync()
    {
        if (SelectedMethod == null || !AreParametersValid()) return;

        var parameters = new List<MethodCallParameter>();
        
        foreach (var arg in SelectedMethod.Args)
        {
            var value = GetParameterValue(arg.Name);
            parameters.Add(new MethodCallParameter
            {
                Name = arg.Name,
                Value = value,
                Type = arg.TypeName
            });
        }

        await OnInvokeMethod.InvokeAsync((SelectedMethodName, parameters));
    }

    /// <summary>
    /// Handling method name changes
    /// </summary>
    private async Task OnSelectedMethodNameChangedInternal(string value)
    {
        SelectedMethodName = value;
        await SelectedMethodNameChanged.InvokeAsync(value);
    }
} 
