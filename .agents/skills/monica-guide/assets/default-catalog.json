  "profileClosurePolicy": {
    "traverseSkillDependencies": ["required"],
    "recommendations": "profile-explicit",
    "conditional": "selected-capabilities-only"
  },
  "sourcePolicies": {
    "channels": ["stable", "preview", "source"],
    "versionResolutionOrder": [
      "ProjectReference",
      "project.assets.json",
      "packages.lock.json",
      "Directory.Packages.props",
      "PackageReference"
    ],
    "immutableBinding": {
      "resolverSkill": "inspect-dependency-source",
      "command": "resolve Tairitsua/Monica --ref <immutable-ref> --json",
      "storedFields": ["ref", "commit", "provenance", "access", "sourcePath"]
    },
    "failClosedOn": [
      "mixed versions",
      "unresolved version ranges",
      "missing immutable releases",
      "unidentifiable dirty local source",
      "unverified cached artifacts"
    ],
    "offline": "Use only verified cached catalogs and exact cached sources; never substitute another release or a default branch."
  },
