  "managedInstructions": {
    "version": 1,
    "markers": {
      "start": "<!-- monica-guide:managed:start -->",
      "end": "<!-- monica-guide:managed:end -->"
    },
    "templates": {
      "application": {
        "skills": ["monica-guide", "monica-application"],
        "rules": [
          "Use $monica-guide for Monica setup, configuration, source binding, updates, and diagnostics.",
          "Use $monica-application to route ordinary Monica application development work."
        ]
      },
      "extension-author": {
        "skills": ["monica-guide", "monica-framework", "monica-third-party-module-development"],
        "rules": [
          "Use $monica-guide for Monica setup, configuration, source binding, updates, and diagnostics.",
          "Use $monica-framework and $monica-third-party-module-development for extension implementation.",
          "Keep generated extension projects on immutable Monica NuGet packages; never replace them with local Monica project references."
        ]
      },
      "framework-contributor": {
        "skills": ["monica-guide", "monica-framework", "monica-unit-testing"],
        "rules": [
          "Use $monica-guide for Monica setup, configuration, source binding, updates, and diagnostics.",
          "Use $monica-framework to route framework implementation and $monica-unit-testing for framework tests."
        ]
      },
      "docs-contributor": {
        "skills": ["monica-guide", "monica-docs-authoring", "monica-application"],
        "rules": [
          "Use $monica-guide for Monica setup, configuration, source binding, updates, and diagnostics.",
          "Use $monica-docs-authoring for bilingual documentation and $monica-application for Monica.Docs application code.",
          "Treat Monica source as read-only unless the current session separately grants write access for a cross-repository fix."
        ]
      }
    }
  },
  "prompts": {
    "bootstrapAsset": "skills/monica-guide/assets/bootstrap-prompts.json"
  },
  "distribution": {
    "repository": "Tairitsua/Monica",
